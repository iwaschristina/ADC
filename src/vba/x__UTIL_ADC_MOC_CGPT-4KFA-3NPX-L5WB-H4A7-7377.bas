    If isNewRow Then
        rs.AddNew
        rs.fields(FIELD_CATEGORY_CODE).value = categoryCode
        rs.fields(FIELD_CATEGORY_NAME).value = categoryName
        rs.fields(FIELD_DESCRIPTION).value = descriptionText
        rs.fields(FIELD_OBJECT_CATEGORY_STATUS).value = ADCAT_STATUS_ACTIVE
