Private Function CatalogFastPathValueText(ByVal value As Variant) As String
    If IsNull(value) Then
        CatalogFastPathValueText = "<Null>"
    ElseIf IsDate(value) Then
        CatalogFastPathValueText = Format$(CDate(value), "yyyy-mm-dd hh:nn:ss")
    ElseIf VarType(value) = vbBoolean Then
        CatalogFastPathValueText = IIf(CBool(value), "True", "False")
    Else
        CatalogFastPathValueText = CStr(value)
    End If
End Function

Private Sub CatalogHashInitialize(ByRef state As CatalogHashState)
    state.hashValue = 5381#
    state.textLength = 0
End Sub

Private Function CatalogHashModuloPrime(ByVal rawValue As Double) As Double
    CatalogHashModuloPrime = rawValue - Int(rawValue / CATALOG_HASH_MODULUS) * CATALOG_HASH_MODULUS
End Function

Private Sub CatalogHashAppendText(ByRef state As CatalogHashState, ByVal valueText As String)
    Dim byteIndex As Long
    Dim lastBlockStart As Long
    Dim upperByteIndex As Long
    Dim valueBytes() As Byte
    Dim chValue As Long
    Dim blockValue As Double
    If Len(valueText) = 0 Then Exit Sub
    valueBytes = valueText
    upperByteIndex = UBound(valueBytes)
    lastBlockStart = upperByteIndex - 7
    byteIndex = 0
    Do While byteIndex <= lastBlockStart
        blockValue = CDbl(CLng(valueBytes(byteIndex)) + CLng(valueBytes(byteIndex + 1)) * 256&) * CATALOG_HASH_BLOCK4_WEIGHT1
        blockValue = blockValue + CDbl(CLng(valueBytes(byteIndex + 2)) + CLng(valueBytes(byteIndex + 3)) * 256&) * CATALOG_HASH_BLOCK4_WEIGHT2
        blockValue = blockValue + CDbl(CLng(valueBytes(byteIndex + 4)) + CLng(valueBytes(byteIndex + 5)) * 256&) * CATALOG_HASH_BLOCK4_WEIGHT3
        blockValue = blockValue + CDbl(CLng(valueBytes(byteIndex + 6)) + CLng(valueBytes(byteIndex + 7)) * 256&)
        state.hashValue = CatalogHashModuloPrime(state.hashValue * CATALOG_HASH_BLOCK4_MULTIPLIER + blockValue)
        byteIndex = byteIndex + 8
        If byteIndex Mod CATALOG_HASH_PUMP_BYTE_INTERVAL = 0 Then PumpSetupResponsiveness
    Loop
    Do While byteIndex <= upperByteIndex
        chValue = CLng(valueBytes(byteIndex)) + CLng(valueBytes(byteIndex + 1)) * 256&
        state.hashValue = CatalogHashModuloPrime(state.hashValue * 33# + chValue)
        byteIndex = byteIndex + 2
    Loop
    state.textLength = state.textLength + Len(valueText)
End Sub

Private Sub CatalogHashAppendTextPair(ByRef firstState As CatalogHashState, ByRef secondState As CatalogHashState, ByVal valueText As String)
    Dim byteIndex As Long
    Dim lastBlockStart As Long
    Dim upperByteIndex As Long
    Dim valueBytes() As Byte
    Dim chValue As Long
    Dim blockValue As Double
    If Len(valueText) = 0 Then Exit Sub
    valueBytes = valueText
    upperByteIndex = UBound(valueBytes)
    lastBlockStart = upperByteIndex - 7
    byteIndex = 0
    Do While byteIndex <= lastBlockStart
        blockValue = CDbl(CLng(valueBytes(byteIndex)) + CLng(valueBytes(byteIndex + 1)) * 256&) * CATALOG_HASH_BLOCK4_WEIGHT1
        blockValue = blockValue + CDbl(CLng(valueBytes(byteIndex + 2)) + CLng(valueBytes(byteIndex + 3)) * 256&) * CATALOG_HASH_BLOCK4_WEIGHT2
        blockValue = blockValue + CDbl(CLng(valueBytes(byteIndex + 4)) + CLng(valueBytes(byteIndex + 5)) * 256&) * CATALOG_HASH_BLOCK4_WEIGHT3
        blockValue = blockValue + CDbl(CLng(valueBytes(byteIndex + 6)) + CLng(valueBytes(byteIndex + 7)) * 256&)
        firstState.hashValue = CatalogHashModuloPrime(firstState.hashValue * CATALOG_HASH_BLOCK4_MULTIPLIER + blockValue)
        secondState.hashValue = CatalogHashModuloPrime(secondState.hashValue * CATALOG_HASH_BLOCK4_MULTIPLIER + blockValue)
        byteIndex = byteIndex + 8
        If byteIndex Mod CATALOG_HASH_PUMP_BYTE_INTERVAL = 0 Then PumpSetupResponsiveness
    Loop
    Do While byteIndex <= upperByteIndex
        chValue = CLng(valueBytes(byteIndex)) + CLng(valueBytes(byteIndex + 1)) * 256&
        firstState.hashValue = CatalogHashModuloPrime(firstState.hashValue * 33# + chValue)
        secondState.hashValue = CatalogHashModuloPrime(secondState.hashValue * 33# + chValue)
        byteIndex = byteIndex + 2
    Loop
    firstState.textLength = firstState.textLength + Len(valueText)
    secondState.textLength = secondState.textLength + Len(valueText)
End Sub

Private Sub CatalogHashAppendTableData(ByVal db As DAO.Database, ByVal tableName As String, ByVal domainName As String, ByRef state As CatalogHashState, ByRef failureDetail As String)
    On Error GoTo ErrHandler
    Dim tdf As DAO.tableDef
    Dim fld As DAO.Field
    Dim rs As DAO.Recordset
    Dim sqlText As String
    Dim orderFieldName As String
    Dim rowText As String
    Dim rowCount As Long
    If SharedDao_TableExists(db, tableName) = False Then
        failureDetail = "Required managed-catalog data table is missing: " & tableName
        Exit Sub
    End If
    Set tdf = db.TableDefs(tableName)
    tdf.fields.Refresh
    If SharedDao_TableDefFieldExistsSafe(tdf, FIELD_ID) Then
        orderFieldName = FIELD_ID
    ElseIf tdf.fields.count > 0 Then
        orderFieldName = tdf.fields(0).Name
    End If
    sqlText = "SELECT * FROM " & SharedDao_BracketName(tableName)
    If Len(orderFieldName) > 0 Then sqlText = sqlText & " ORDER BY " & SharedDao_BracketName(orderFieldName)
    Set rs = db.OpenRecordset(sqlText, dbOpenSnapshot)
    CatalogHashAppendText state, FingerprintTokenPart("DATA:" & domainName & ":" & tableName)
    Do While rs.EOF = False
        PumpSetupResponsiveness
        rowText = vbNullString
        For Each fld In rs.fields
            If CatalogFastPathFieldIncluded(domainName, fld.Name) Then
                rowText = rowText & FingerprintTokenPart(fld.Name)
                rowText = rowText & FingerprintTokenPart(CatalogFastPathValueText(fld.value))
            End If
        Next fld
        CatalogHashAppendText state, rowText & vbLf
        rowCount = rowCount + 1
        PumpSetupResponsiveness
        If rowCount Mod 100 = 0 Then PulseCatalogSetupPart7 "streamed " & CStr(rowCount) & " rows from " & tableName & "."
        rs.MoveNext
    Loop
    If rowCount > 0 Then PulseCatalogSetupPart7 "completed " & tableName & " (" & CStr(rowCount) & " rows)."
    rs.Close
    Set rs = Nothing
    Exit Sub
ErrHandler:
    failureDetail = "Could not fingerprint managed-catalog domain [" & domainName & "] table [" & tableName & "]. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
End Sub

Private Sub CatalogHashAppendDefaultsTableData(ByVal db As DAO.Database, ByVal tableName As String, ByRef defaultsState As CatalogHashState, ByRef nonHelpDefaultsState As CatalogHashState, ByRef helpDocumentsState As CatalogHashState, ByRef failureDetail As String)
    'Streams each authoritative Defaults table once while contributing the identical canonical row representation to the complete Defaults hash and exactly one scoped partition hash.
    On Error GoTo ErrHandler
    Dim tdf As DAO.tableDef
    Dim fld As DAO.Field
    Dim rs As DAO.Recordset
    Dim sqlText As String
    Dim orderFieldName As String
    Dim rowText As String
    Dim rowCount As Long
    Dim isHelpDocuments As Boolean
    Dim tokenText As String
    If SharedDao_TableExists(db, tableName) = False Then
        failureDetail = "Required managed-catalog data table is missing: " & tableName
        Exit Sub
    End If
    isHelpDocuments = (StrComp(tableName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HelpDocuments"), vbTextCompare) = 0)
    Set tdf = db.TableDefs(tableName)
    tdf.fields.Refresh
    If SharedDao_TableDefFieldExistsSafe(tdf, FIELD_ID) Then
        orderFieldName = FIELD_ID
    ElseIf tdf.fields.count > 0 Then
        orderFieldName = tdf.fields(0).Name
    End If
    sqlText = "SELECT * FROM " & SharedDao_BracketName(tableName)
    If Len(orderFieldName) > 0 Then sqlText = sqlText & " ORDER BY " & SharedDao_BracketName(orderFieldName)
    Set rs = db.OpenRecordset(sqlText, dbOpenSnapshot)
    tokenText = FingerprintTokenPart("DATA:Defaults:" & tableName)
    If isHelpDocuments Then
        CatalogHashAppendTextPair defaultsState, helpDocumentsState, tokenText
    Else
        CatalogHashAppendTextPair defaultsState, nonHelpDefaultsState, tokenText
    End If
    Do While rs.EOF = False
        PumpSetupResponsiveness
        rowText = vbNullString
        For Each fld In rs.fields
            If CatalogFastPathFieldIncluded("Defaults", fld.Name) Then
                rowText = rowText & FingerprintTokenPart(fld.Name)
                rowText = rowText & FingerprintTokenPart(CatalogFastPathValueText(fld.value))
            End If
        Next fld
        tokenText = rowText & vbLf
        If isHelpDocuments Then
            CatalogHashAppendTextPair defaultsState, helpDocumentsState, tokenText
        Else
            CatalogHashAppendTextPair defaultsState, nonHelpDefaultsState, tokenText
        End If
        rowCount = rowCount + 1
        PumpSetupResponsiveness
        If rowCount Mod 100 = 0 Then PulseCatalogSetupPart7 "streamed " & CStr(rowCount) & " rows from " & tableName & "."
        rs.MoveNext
    Loop
    If rowCount > 0 Then PulseCatalogSetupPart7 "completed " & tableName & " (" & CStr(rowCount) & " rows)."
    rs.Close
    Set rs = Nothing
    Exit Sub
ErrHandler:
    failureDetail = "Could not fingerprint managed-catalog Defaults table [" & tableName & "] and its scoped partition. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
End Sub

Private Sub CatalogHashAppendManagedPayloads(ByVal db As DAO.Database, ByRef allState As CatalogHashState, ByRef coreState As CatalogHashState, ByRef formsState As CatalogHashState, ByRef uiState As CatalogHashState, ByRef macroState As CatalogHashState, ByRef failureDetail As String)
    On Error GoTo ErrHandler
    Dim domainByManagedObjectID As Object
    Dim managedRs As DAO.Recordset
    Dim payloadRs As DAO.Recordset
    Dim fld As DAO.Field
    Dim managedObjectID As Long
    Dim rowDomain As String
    Dim rowText As String
    Dim managedRowCount As Long
    Dim payloadRowCount As Long
    ' INTENTIONAL KEYED LOOKUP: domainByManagedObjectID provides keyed membership/lookup over source rows or state already read by CatalogHashAppendManagedPayloads; it is a derived access path, not a second
    ' authority.
    Set domainByManagedObjectID = CreateObject("Scripting.Dictionary")
    domainByManagedObjectID.CompareMode = vbBinaryCompare
    Set managedRs = db.OpenRecordset("SELECT " & SQL_FIELD_ID & "," & SQL_FIELD_OBJECT_TYPE & ",[" & FIELD_CATEGORY_CODE & "]," & SQL_FIELD_OBJECT_NAME & " FROM " & SharedDao_BracketName(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID)) & " ORDER BY " & SQL_FIELD_ID, dbOpenSnapshot)
    Do While managedRs.EOF = False
        PumpSetupResponsiveness
        managedObjectID = CLng(Nz(managedRs.fields(FIELD_ID).value, 0))
        If managedObjectID > 0 Then domainByManagedObjectID(CStr(managedObjectID)) = CatalogManagedObjectInventoryDomain(CStr(Nz(managedRs.fields(FIELD_OBJECT_TYPE).value, vbNullString)), CStr(Nz(managedRs.fields(FIELD_CATEGORY_CODE).value, vbNullString)), CStr(Nz(managedRs.fields(FIELD_OBJECT_NAME).value, vbNullString)))
        managedRowCount = managedRowCount + 1
        PumpSetupResponsiveness
        If managedRowCount Mod 100 = 0 Then PulseCatalogSetupPart7 "mapped " & CStr(managedRowCount) & " managed objects for payload domains."
        managedRs.MoveNext
    Loop
    PulseCatalogSetupPart7 "completed payload-domain map (" & CStr(managedRowCount) & " managed objects)."
    managedRs.Close
    Set managedRs = Nothing
    CatalogHashAppendText allState, FingerprintTokenPart("DATA:Payloads:" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads"))
    CatalogHashAppendText coreState, FingerprintTokenPart("DATA:PayloadsCore:" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads"))
    CatalogHashAppendText formsState, FingerprintTokenPart("DATA:PayloadsForms:" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads"))
    CatalogHashAppendText uiState, FingerprintTokenPart("DATA:PayloadsUI:" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads"))
    CatalogHashAppendText macroState, FingerprintTokenPart("DATA:PayloadsMacros:" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads"))
    Set payloadRs = db.OpenRecordset("SELECT * FROM " & SharedDao_BracketName(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads")) & " ORDER BY " & SQL_FIELD_ID, dbOpenSnapshot)
    Do While payloadRs.EOF = False
        PumpSetupResponsiveness
        rowText = vbNullString
        For Each fld In payloadRs.fields
            If CatalogFastPathFieldIncluded("Payloads", fld.Name) Then rowText = rowText & FingerprintTokenPart(fld.Name) & FingerprintTokenPart(CatalogFastPathValueText(fld.value))
        Next fld
        rowText = rowText & vbLf
        CatalogHashAppendText allState, rowText
        managedObjectID = CLng(Nz(payloadRs.fields(FIELD_MANAGED_OBJECT_ID).value, 0))
        rowDomain = vbNullString
        If domainByManagedObjectID.Exists(CStr(managedObjectID)) Then rowDomain = CStr(domainByManagedObjectID(CStr(managedObjectID)))
        Select Case UCase$(rowDomain)
            Case "CORE": CatalogHashAppendText coreState, rowText
            Case "FORMS": CatalogHashAppendText formsState, rowText
            Case "UI": CatalogHashAppendText uiState, rowText
            Case "MACROS": CatalogHashAppendText macroState, rowText
        End Select
        payloadRowCount = payloadRowCount + 1
        PumpSetupResponsiveness
        If payloadRowCount Mod 100 = 0 Then PulseCatalogSetupPart7 "streamed " & CStr(payloadRowCount) & " managed action-payload rows."
        payloadRs.MoveNext
    Loop
    PulseCatalogSetupPart7 "completed managed action payloads (" & CStr(payloadRowCount) & " rows)."
    payloadRs.Close
    Set payloadRs = Nothing
    Set domainByManagedObjectID = Nothing
    Exit Sub
ErrHandler:
    failureDetail = "Could not fingerprint managed-object action-payload domains in one streaming pass. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
    On Error Resume Next
    If Not managedRs Is Nothing Then managedRs.Close
    If Not payloadRs Is Nothing Then payloadRs.Close
    On Error GoTo 0
End Sub

Private Function CatalogFastPathTableDefinitionText(ByVal db As DAO.Database, ByVal tableName As String, ByRef failureDetail As String) As String
    On Error GoTo ErrHandler
    Dim tdf As DAO.tableDef
    Dim fld As DAO.Field
    Dim idx As DAO.index
    Dim idxField As DAO.Field
    Dim resultText As String
    If SharedDao_TableExists(db, tableName) = False Then
        failureDetail = "Required managed-catalog table is missing: " & tableName
        Exit Function
    End If
    Set tdf = db.TableDefs(tableName)
    tdf.fields.Refresh
    tdf.Indexes.Refresh
    resultText = FingerprintTokenPart("TABLE:" & tableName)
    For Each fld In tdf.fields
        PumpSetupResponsiveness
        resultText = resultText & FingerprintTokenPart(fld.Name)
        resultText = resultText & FingerprintTokenPart(CStr(fld.Type))
        resultText = resultText & FingerprintTokenPart(CStr(fld.Size))
        resultText = resultText & FingerprintTokenPart(CStr(fld.Attributes))
        resultText = resultText & FingerprintTokenPart(DaoObjectPropertyFingerprintText(fld, "Required"))
        resultText = resultText & FingerprintTokenPart(DaoObjectPropertyFingerprintText(fld, "AllowZeroLength"))
        resultText = resultText & FingerprintTokenPart(DaoObjectPropertyFingerprintText(fld, "DefaultValue"))
        resultText = resultText & FingerprintTokenPart(DaoObjectPropertyFingerprintText(fld, "ValidationRule"))
        resultText = resultText & FingerprintTokenPart(DaoObjectPropertyFingerprintText(fld, "ValidationText"))
        resultText = resultText & FingerprintTokenPart(DaoObjectPropertyFingerprintText(fld, DAO_DESCRIPTION_PROPERTY_NAME))
        resultText = resultText & FingerprintTokenPart(DaoObjectPropertyFingerprintText(fld, "Caption"))
        resultText = resultText & FingerprintTokenPart(DaoObjectPropertyFingerprintText(fld, "Expression"))
        resultText = resultText & FingerprintTokenPart(DaoObjectPropertyFingerprintText(fld, "DisplayControl"))
        resultText = resultText & FingerprintTokenPart(DaoObjectPropertyFingerprintText(fld, "RowSourceType"))
        resultText = resultText & FingerprintTokenPart(DaoObjectPropertyFingerprintText(fld, "RowSource"))
        resultText = resultText & FingerprintTokenPart(DaoObjectPropertyFingerprintText(fld, "BoundColumn"))
        resultText = resultText & FingerprintTokenPart(DaoObjectPropertyFingerprintText(fld, "ColumnCount"))
        resultText = resultText & FingerprintTokenPart(DaoObjectPropertyFingerprintText(fld, "ColumnWidths"))
        resultText = resultText & FingerprintTokenPart(DaoObjectPropertyFingerprintText(fld, "LimitToList"))
        PumpSetupResponsiveness
    Next fld
    For Each idx In tdf.Indexes
        PumpSetupResponsiveness
        resultText = resultText & FingerprintTokenPart(idx.Name)
        resultText = resultText & FingerprintTokenPart(CStr(idx.Primary))
        resultText = resultText & FingerprintTokenPart(CStr(idx.Unique))
        resultText = resultText & FingerprintTokenPart(CStr(idx.Required))
        resultText = resultText & FingerprintTokenPart(CStr(idx.IgnoreNulls))
        For Each idxField In idx.fields
            PumpSetupResponsiveness
            resultText = resultText & FingerprintTokenPart(idxField.Name)
        Next idxField
        PumpSetupResponsiveness
    Next idx
    CatalogFastPathTableDefinitionText = resultText
    Exit Function
ErrHandler:
    failureDetail = "Could not inspect managed-catalog table [" & tableName & "]. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
End Function

Private Function CatalogOperationalHistoryField(ByVal fieldName As String) As Boolean
    Select Case LCase$(Trim$(fieldName))
        Case LCase$(FIELD_LAST_VALIDATED_ON), LCase$(FIELD_LAST_VALIDATION_RESULT), LCase$(FIELD_LAST_SETUP_ACTION_ON), LCase$(FIELD_LAST_SETUP_RESULT), LCase$(FIELD_DEFAULTED_ON), LCase$(FIELD_LAST_DEFAULTED_ON), LCase$(FIELD_LAST_DEFAULT_REPAIR_ON), "installedon", "lastinstalledon", LCase$(FIELD_LAST_VERIFIED_ON), LCase$(FIELD_LAST_VERIFICATION_RESULT), _
             LCase$(FIELD_VERIFICATION_RESULT), "lastfastskipon", LCase$(FIELD_LAST_GENERATED_ON), LCase$(FIELD_LAST_GENERATED_RESULT), LCase$(FIELD_MANAGED_OBJECT_FIELD_DOCUMENTATION_UPDATED_ON), LCase$(FIELD_MANAGED_OBJECT_FIELD_SCHEMA_VERIFIED_ON), "lastscantimestamp", LCase$(FIELD_LAST_SCANNED_ON), LCase$(FIELD_LAST_SOURCE_SCANNED_ON), _
             LCase$(FIELD_DISCOVERED_ON), LCase$(FIELD_CONFIGURED_ON), LCase$(FIELD_ACCEPTED_ON), LCase$(FIELD_REJECTED_ON), "appliedon", "completedon", LCase$(FIELD_REVIEWED_ON), LCase$(FIELD_REVIEW_RUN_ON), "auditrunon", LCase$(FIELD_TRACE_ON), LCase$(FIELD_UPDATED_ON), LCase$(FIELD_LAST_UPDATED_ON), LCase$(FIELD_UPDATED_AT), LCase$(FIELD_CREATED_ON), _
             "modifiedon", "lastmodifiedon", "generatedon", LCase$(FIELD_LAST_REFRESHED_ON), LCase$(FIELD_RECORDED_ON), LCase$(FIELD_CAPTURED_ON)
            CatalogOperationalHistoryField = True
    End Select
End Function

Private Function CatalogDiagnosticHistoryField(ByVal fieldName As String) As Boolean
    Select Case LCase$(Trim$(fieldName))
        Case LCase$(FIELD_LAST_VALIDATION_NOTES), LCase$(FIELD_LAST_SETUP_MESSAGE), LCase$(FIELD_LAST_GENERATED_NOTES), "lastfastskipreason", LCase$(FIELD_MANUAL_REVIEW_NOTES), LCase$(FIELD_REVIEW_RUN_ID), "auditrunid", LCase$(FIELD_TRACE_RUN_ID), LCase$(FIELD_VERIFICATION_RUN_ID), LCase$(FIELD_LAST_SCAN_BATCH_ID), "installbatchid", LCase$(FIELD_CATALOG_REVIEW_MESSAGE), LCase$(FIELD_MODULE_HEADER_SCAN_NOTES), LCase$(FIELD_IS_CURRENT_RUN)
            CatalogDiagnosticHistoryField = True
    End Select
End Function

Private Function CatalogFastPathUiField(ByVal fieldName As String) As Boolean
    Select Case LCase$(Trim$(fieldName))
        Case LCase$(FIELD_OBJECT_NAME), LCase$(FIELD_OBJECT_DISPLAY_NAME), LCase$(FIELD_RIBBON_TITLE), LCase$(FIELD_OBJECT_DESCRIPTION), LCase$(FIELD_RIBBON_TOOLTIP), LCase$(FIELD_NAV_PANE_VISIBILITY_POLICY_OVERRIDE), LCase$(FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY), LCase$(FIELD_RIBBON_TAB_KEY), LCase$(FIELD_RIBBON_TAB_LABEL), LCase$(FIELD_RIBBON_GROUP_LABEL), LCase$(FIELD_RIBBON_GROUP_SORT_ORDER), LCase$(FIELD_SETTING_KEY), "groupname", "groupdisplayname", LCase$(FIELD_NAVIGATION_PANE_GROUP_KEY), LCase$(FIELD_NAVIGATION_PANE_GROUP_NAME), LCase$(FIELD_RIBBON_NAME), LCase$(FIELD_RIBBON_TAB_KEY), LCase$(FIELD_RIBBON_TAB_LABEL), LCase$(FIELD_RIBBON_GROUP_LABEL), LCase$(FIELD_RIBBON_GROUP_SORT_ORDER), LCase$(FIELD_SHOW_ON_RIBBON), LCase$(FIELD_RIBBON_GROUP_VISIBLE)
            CatalogFastPathUiField = True
    End Select
End Function

Private Function CatalogFastPathFieldIncluded(ByVal domainName As String, ByVal fieldName As String) As Boolean
    If CatalogOperationalHistoryField(fieldName) Then Exit Function
    If CatalogDiagnosticHistoryField(fieldName) Then Exit Function
    Select Case LCase$(domainName)
        Case "ui"
            CatalogFastPathFieldIncluded = CatalogFastPathUiField(fieldName)
        Case "inventory"
            If CatalogFastPathUiField(fieldName) Then Exit Function
            Select Case LCase$(fieldName)
                Case LCase$(FIELD_MANUAL_REVIEW_NOTES), LCase$(FIELD_MANAGED_OBJECT_DEPENDENCY_NOTES)
                    Exit Function
            End Select
            CatalogFastPathFieldIncluded = True
        Case Else
            CatalogFastPathFieldIncluded = True
    End Select
End Function

Private Function CatalogFastPathQueryDefinitionText(ByVal db As DAO.Database, ByVal queryName As String, ByRef failureDetail As String) As String
    On Error GoTo ErrHandler
    Dim qdf As DAO.queryDef
    Dim prm As DAO.Parameter
    Dim resultText As String
    If SharedDao_QueryExists(db, queryName) = False Then
        failureDetail = "Required managed-catalog support query is missing: " & queryName
        Exit Function
    End If
    Set qdf = db.QueryDefs(queryName)
    resultText = FingerprintTokenPart(queryName)
    resultText = resultText & FingerprintTokenPart(CStr(qdf.Type))
    resultText = resultText & FingerprintTokenPart(qdf.sql)
    For Each prm In qdf.parameters
        PumpSetupResponsiveness
        resultText = resultText & FingerprintTokenPart(prm.Name)
        resultText = resultText & FingerprintTokenPart(CStr(prm.Type))
    Next prm
    CatalogFastPathQueryDefinitionText = resultText
    Exit Function
ErrHandler:
    failureDetail = "Could not inspect managed-catalog support query [" & queryName & "]. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
End Function

Private Function CatalogFastPathRelationshipText(ByVal db As DAO.Database, ByVal trackedTables As Collection) As String
    On Error GoTo ErrHandler
    Dim rel As DAO.Relation
    Dim relField As DAO.Field
    Dim resultText As String
    For Each rel In db.Relations
        PumpSetupResponsiveness
        If CatalogFastPathCollectionContains(trackedTables, rel.Table) Or CatalogFastPathCollectionContains(trackedTables, rel.foreignTable) Then
            resultText = resultText & FingerprintTokenPart(rel.Name)
            resultText = resultText & FingerprintTokenPart(rel.Table)
            resultText = resultText & FingerprintTokenPart(rel.foreignTable)
            resultText = resultText & FingerprintTokenPart(CStr(rel.Attributes))
            For Each relField In rel.fields
                PumpSetupResponsiveness
                resultText = resultText & FingerprintTokenPart(relField.Name)
                resultText = resultText & FingerprintTokenPart(relField.ForeignName)
            Next relField
        End If
        PumpSetupResponsiveness
    Next rel
    CatalogFastPathRelationshipText = resultText
    Exit Function
ErrHandler:
    Err.Raise Err.Number, "CatalogFastPathRelationshipText", "Could not inspect managed-catalog relationships. " & Err.Description
End Function

