Private Sub MarkPart14PhysicalVerificationEvidence()
    Dim keyValue As Variant
    Dim deltaData As Variant
    Dim definitionData As Variant
    Dim rowID As Long
    Dim physicalStatus As String
    mPart14PhysicalVerificationCount = 0
    mPart14PhysicalVerificationList = vbNullString
    For Each keyValue In mManagedDefinitionObjectDelta.keys
        deltaData = mManagedDefinitionObjectDelta(CStr(keyValue))
        definitionData = mManagedDefinitionObjectPlan(CStr(keyValue))
        rowID = CLng(deltaData(2))
        physicalStatus = MANAGED_DEFINITION_STATUS_REQUIRES_PHYSICAL_VERIFICATION
        mManagedDefinitionObjectDelta(CStr(keyValue)) = Array(CStr(deltaData(0)), CStr(deltaData(1)), rowID, physicalStatus)
        If StrComp(physicalStatus, MANAGED_DEFINITION_STATUS_REQUIRES_PHYSICAL_VERIFICATION, vbBinaryCompare) = 0 Then
            mPart14PhysicalVerificationCount = mPart14PhysicalVerificationCount + 1
            mPart14PhysicalVerificationList = SharedText_AppendNonBlankLine(mPart14PhysicalVerificationList, CStr(definitionData(MANAGED_DEFINITION_OBJECT_TYPE)) & " " & CStr(definitionData(MANAGED_DEFINITION_OBJECT_NAME)))
        End If
    Next keyValue
End Sub

Private Sub PreparePart14AuthoritativeSource(ByVal allowRepair As Boolean, ByVal defaultCatalog As Collection, ByVal synchronizationScope As HelpDocumentSynchronizationScope)
    'Setup B4 owns MC_Sys plus its Help scope; operational Build/Repair Help Document Macros owns only active Help_Docs and must not repair or reconcile unrelated MC_Sys source state.
    Dim stageTimer As Single
    Dim sourceRepairRequired As Boolean
    Dim sourceDetail As String
    stageTimer = Timer
    Select Case synchronizationScope
        Case HelpDocumentScopeSetupSystemAndAllActive, HelpDocumentScopeSetupSystemOnly
            sourceRepairRequired = (DefaultSystemMacroSourceCurrent(sourceDetail, defaultCatalog) = False)
            If sourceRepairRequired Then
                If allowRepair = False Then Err.Raise vbObjectError + 9531, "PreparePart14AuthoritativeSource", "The B4 [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & "] source is not current. This isolated mode does not mutate the authoritative source." & vbCrLf & sourceDetail
                RepairSystemMacroSourceRowsForSetup defaultCatalog
                If DefaultSystemMacroSourceCurrent(sourceDetail, defaultCatalog) = False Then Err.Raise vbObjectError + 9531, "PreparePart14AuthoritativeSource", "The B4 [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & "] source is still not current after repair." & vbCrLf & sourceDetail
            End If
            If SystemMacroCatalogTableCanOpen() = False Then Err.Raise vbObjectError + 9532, "PreparePart14AuthoritativeSource", "The B4 source table [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & "] is unavailable after source preparation."
        Case HelpDocumentScopeAllActive
            'Operational Build/Repair Help Document Macros intentionally leaves built-in MC_Sys source ownership untouched.
        Case Else
            Err.Raise vbObjectError + 9542, "PreparePart14AuthoritativeSource", "Unsupported Help Document synchronization scope: " & CStr(synchronizationScope)
    End Select
    If synchronizationScope <> HelpDocumentScopeSetupSystemOnly Then
        If TableCanOpen(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HelpDocuments")) = False Then Err.Raise vbObjectError + 9533, "PreparePart14AuthoritativeSource", "The B4 source table [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HelpDocuments") & "] is unavailable."
    End If
    mPart14SourcePreparationElapsedSeconds = ElapsedSecondsFromTimer(stageTimer)
End Sub

Private Sub BuildPart14ManagedDefinitionPlan(ByVal defaultCatalog As Collection, ByVal systemMacroGroupKeyIndex As Object, ByVal synchronizationScope As HelpDocumentSynchronizationScope)
    On Error GoTo ErrHandler
    Dim stageTimer As Single
    mPart14MutationElapsedSeconds = 0
    mPart14PostconditionElapsedSeconds = 0
    mPart14ActualMutationCount = 0
    stageTimer = Timer
    RefreshManagedDefinitionBatchIndexes False
    BeginManagedDefinitionPlanCapture
    DefaultSystemHelpMacroManagedObjectRows False, defaultCatalog, systemMacroGroupKeyIndex, synchronizationScope
    EndManagedDefinitionPlanCapture
    mPart14PlanElapsedSeconds = ElapsedSecondsFromTimer(stageTimer)
    If mManagedDefinitionObjectPlan.count = 0 And (synchronizationScope = HelpDocumentScopeSetupSystemAndAllActive Or synchronizationScope = HelpDocumentScopeSetupSystemOnly) Then Err.Raise vbObjectError + 9534, "BuildPart14ManagedDefinitionPlan", "The authoritative Setup B4 managed-object definition set is empty."
    If mManagedDefinitionObjectPlan.count <> mManagedDefinitionPayloadPlan.count Then Err.Raise vbObjectError + 9535, "BuildPart14ManagedDefinitionPlan", "Every B4 managed object must have exactly one authoritative action payload." & vbCrLf & "Managed objects: " & CStr(mManagedDefinitionObjectPlan.count) & vbCrLf & "Payloads: " & CStr(mManagedDefinitionPayloadPlan.count)
    stageTimer = Timer
    BuildManagedDefinitionDelta True
    MarkPart14PhysicalVerificationEvidence
    mPart14DeltaElapsedSeconds = ElapsedSecondsFromTimer(stageTimer)
    mPart14InitialObjectMatchedCount = mManagedDefinitionObjectMatchedCount
    mPart14InitialObjectInsertCount = mManagedDefinitionObjectInsertCount
    mPart14InitialObjectUpdateCount = mManagedDefinitionObjectUpdateCount
    mPart14InitialObjectConflictCount = mManagedDefinitionObjectConflictCount
    mPart14InitialPayloadMatchedCount = mManagedDefinitionPayloadMatchedCount
    mPart14InitialPayloadInsertCount = mManagedDefinitionPayloadInsertCount
    mPart14InitialPayloadUpdateCount = mManagedDefinitionPayloadUpdateCount
    mPart14InitialPayloadConflictCount = mManagedDefinitionPayloadConflictCount
    mPart14InitialPhysicalVerificationCount = mPart14PhysicalVerificationCount
    mPart14LastPlanSignature = mManagedDefinitionPlanSignature
    mPart14LastDeltaSummary = Part14DeltaSummaryText()
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    EndManagedDefinitionPlanCapture
    Err.Raise savedErrNumber, "BuildPart14ManagedDefinitionPlan", "Could not build the authoritative B4 managed-definition plan and delta." & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Sub

Private Sub ApplyPart14PayloadDelta()
    Dim keyValue As Variant
    Dim definitionData As Variant
    Dim deltaData As Variant
    Dim dirtyCount As Long
    Dim dirtyIndex As Long
    dirtyCount = mManagedDefinitionPayloadInsertCount + mManagedDefinitionPayloadUpdateCount
    For Each keyValue In mManagedDefinitionPayloadOrder
        deltaData = mManagedDefinitionPayloadDelta(CStr(keyValue))
        If StrComp(CStr(deltaData(0)), MANAGED_DEFINITION_STATUS_MATCHED, vbBinaryCompare) <> 0 Then
            dirtyIndex = dirtyIndex + 1
            definitionData = mManagedDefinitionPayloadPlan(CStr(keyValue))
            PulseProgressEvery dirtyIndex, 10, "B4 applying dirty action payload " & CStr(dirtyIndex) & " of " & CStr(dirtyCount) & ": [" & CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_OBJECT_NAME)) & "].", dirtyCount, "CatalogPart14PayloadDelta", "Catalog"
            DefaultActionPayloadForObject CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_OBJECT_NAME)), CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_KIND)), CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_ACTION)), CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_WRAPPER)), CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_DESCRIPTION)), CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_VERSION)), CLng(definitionData(MANAGED_DEFINITION_PAYLOAD_SORT_ORDER)), True
        End If
    Next keyValue
End Sub

Private Function Part14StaleHelpDocumentManagedRowIDs(ByRef staleNames As String, ByVal synchronizationScope As HelpDocumentSynchronizationScope) As Object
    'Returns active ADC-owned Help Document managed rows that are obsolete inside the current synchronization scope.
    Dim helpManagedObjectIDs As Object
    Dim staleIDs As Object
    Dim rs As DAO.Recordset
    Dim managedObjectID As Long
    Dim objectName As String
    Dim objectTypeCode As String
    Dim categoryCode As String
    Dim objectStatus As String
    Dim catalogOwner As String
    Dim payloadKind As String
    Dim runCodeWrapperName As String
    Dim planKey As String
    Dim definitionData As Variant
    Dim plannedAsHelpDocument As Boolean
    If mManagedDefinitionBatchActive = False Then Err.Raise vbObjectError + 9537, "Part14StaleHelpDocumentManagedRowIDs", "The managed-definition batch must be active before stale Help Document managed rows can be identified."
    Set staleIDs = CreateObject("Scripting.Dictionary")
    staleIDs.CompareMode = vbTextCompare
    If synchronizationScope = HelpDocumentScopeSetupSystemOnly Then
        Set Part14StaleHelpDocumentManagedRowIDs = staleIDs
        Exit Function
    End If
    ' INTENTIONAL KEYED LOOKUP: helpManagedObjectIDs indexes the retained Help RunCode identity by ManagedObjectID and staleIDs is the operation-scoped retirement plan; neither is a Help Document authority.
    Set helpManagedObjectIDs = CreateObject("Scripting.Dictionary")
    helpManagedObjectIDs.CompareMode = vbTextCompare
    Set rs = mManagedDefinitionBatchPayloadRs
    If Not (rs.BOF And rs.EOF) Then rs.MoveFirst
    Do While rs.EOF = False
        managedObjectID = CLng(Nz(rs.fields(FIELD_MANAGED_OBJECT_ID).value, 0))
        payloadKind = Trim$(CStr(Nz(rs.fields(FIELD_PAYLOAD_KIND).value, vbNullString)))
        runCodeWrapperName = Trim$(CStr(Nz(rs.fields(FIELD_RUN_CODE_WRAPPER_NAME).value, vbNullString)))
        If managedObjectID > 0 And StrComp(payloadKind, ADCAT_PAYLOAD_ACCESS_MACRO_RUNCODE, vbTextCompare) = 0 Then
            If StrComp(Left$(runCodeWrapperName, Len("Run_OpenHelpDocument(")), "Run_OpenHelpDocument(", vbTextCompare) = 0 Then
                If helpManagedObjectIDs.Exists(CStr(managedObjectID)) = False Then helpManagedObjectIDs.Add CStr(managedObjectID), runCodeWrapperName
            End If
        End If
        rs.MoveNext
    Loop
    Set rs = mManagedDefinitionBatchManagedRs
    If Not (rs.BOF And rs.EOF) Then rs.MoveFirst
    Do While rs.EOF = False
        managedObjectID = CLng(Nz(rs.fields(FIELD_ID).value, 0))
        If managedObjectID > 0 Then
            If helpManagedObjectIDs.Exists(CStr(managedObjectID)) Then
                runCodeWrapperName = CStr(helpManagedObjectIDs(CStr(managedObjectID)))
                If HelpDocumentRunCodeInSynchronizationScope(runCodeWrapperName, synchronizationScope) Then
                    objectName = Trim$(CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString)))
                    objectTypeCode = Trim$(CStr(Nz(rs.fields(FIELD_OBJECT_TYPE).value, vbNullString)))
                    categoryCode = Trim$(CStr(Nz(rs.fields(FIELD_CATEGORY_CODE).value, vbNullString)))
                    objectStatus = Trim$(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_STATUS).value, ADCAT_STATUS_ACTIVE)))
                    catalogOwner = Trim$(CStr(Nz(rs.fields(FIELD_CATALOG_OWNER).value, vbNullString)))
                    If StrComp(objectTypeCode, ADCAT_OBJECT_TYPE_MACRO, vbTextCompare) = 0 And StrComp(categoryCode, ADCAT_CATEGORY_SYSTEM_MACRO, vbTextCompare) = 0 And StrComp(objectStatus, ADCAT_STATUS_ACTIVE, vbTextCompare) = 0 And StrComp(catalogOwner, ADCAT_OWNER_SYSTEM_DEFAULT, vbTextCompare) = 0 Then
                        plannedAsHelpDocument = False
                        If Not mManagedDefinitionObjectPhysicalIndex Is Nothing Then
                            If mManagedDefinitionObjectPhysicalIndex.Exists(objectName) Then
                                planKey = CStr(mManagedDefinitionObjectPhysicalIndex(objectName))
                                definitionData = mManagedDefinitionObjectPlan(planKey)
                                plannedAsHelpDocument = (StrComp(CStr(definitionData(MANAGED_DEFINITION_OBJECT_FAMILY)), MANAGED_DEFINITION_FAMILY_HELP_DOCUMENTS, vbBinaryCompare) = 0)
                            End If
                        End If
                        If plannedAsHelpDocument = False Then
                            staleIDs.Add CStr(managedObjectID), objectName
                            staleNames = SharedText_AppendNonBlankLine(staleNames, objectName)
                        End If
                    End If
                End If
            End If
        End If
        rs.MoveNext
    Loop
    Set Part14StaleHelpDocumentManagedRowIDs = staleIDs
End Function

Private Function RetirePart14StaleHelpDocumentManagedRows(ByVal staleIDs As Object) As Long
    'Retires only active SystemDefault-owned Help Document managed rows proven obsolete by their retained Run_OpenHelpDocument payload identity.
    Dim keyValue As Variant
    Dim rs As DAO.Recordset
    Dim managedObjectID As Long
    If staleIDs Is Nothing Then Exit Function
    If staleIDs.count = 0 Then Exit Function
    Set rs = mManagedDefinitionBatchManagedRs
    For Each keyValue In staleIDs.keys
        managedObjectID = CLng(keyValue)
        If mManagedDefinitionManagedBookmarksByID.Exists(CStr(managedObjectID)) = False Then Err.Raise vbObjectError + 9538, "RetirePart14StaleHelpDocumentManagedRows", "A stale Help Document managed row lost its batch bookmark." & vbCrLf & "ManagedObjectID: " & CStr(managedObjectID)
        rs.Bookmark = mManagedDefinitionManagedBookmarksByID(CStr(managedObjectID))
        If SetupRollbackTrackingActive() Then
            If TrackSetupManagedObjectRowRollback(managedObjectID, True, ManagedObjectRollbackSql(rs)) Then mManagedDefinitionRollbackRegistrationCount = mManagedDefinitionRollbackRegistrationCount + 1
        End If
        rs.Edit
        rs.fields(FIELD_MANAGED_OBJECT_STATUS).value = ADCAT_STATUS_INACTIVE
        If SharedDao_RecordsetHasFieldSafe(rs, FIELD_LAST_DEFAULT_REPAIR_ON) Then rs.fields(FIELD_LAST_DEFAULT_REPAIR_ON).value = Now()
        rs.Update
        RetirePart14StaleHelpDocumentManagedRows = RetirePart14StaleHelpDocumentManagedRows + 1
        mManagedDefinitionBatchManagedUpdated = mManagedDefinitionBatchManagedUpdated + 1
        MarkManagedDefinitionMutation CATALOG_DIRTY_INVENTORY Or CATALOG_DIRTY_UI
    Next keyValue
End Function

Private Sub ReconcileSystemHelpMacroDefinitionsCore(ByVal allowSourceRepair As Boolean, ByVal synchronizationScope As HelpDocumentSynchronizationScope, ByRef executionDetail As String)
    'Single Catalog-owned implementation used by Setup B4 and Build/Repair Help Document Macros; explicit scope distinguishes Setup System Macro and Help Document Macro ownership, Setup System Macro-only ownership,
    'and operational Help Document Macro-only ownership.
    Dim navigationPaneDefinitions As Collection
    Dim systemMacroGroupDefinitions As Collection
    Dim systemMacroGroupKeyIndex As Object
    Dim defaultCatalog As Collection
    Dim stageTimer As Single
    Dim stageElapsedSeconds As Double
    If synchronizationScope = HelpDocumentScopeSetupSystemAndAllActive Or synchronizationScope = HelpDocumentScopeSetupSystemOnly Then
        Set navigationPaneDefinitions = NavigationPaneGroupDefinitions()
        Set systemMacroGroupDefinitions = SystemMacroNavigationPaneGroupDefinitions(navigationPaneDefinitions)
        Set systemMacroGroupKeyIndex = SystemMacroNavigationPaneGroupKeyIndex(systemMacroGroupDefinitions)
        Set defaultCatalog = BuildSystemMacroDefaultCatalog(systemMacroGroupKeyIndex)
    ElseIf synchronizationScope = HelpDocumentScopeAllActive Then
        Set systemMacroGroupKeyIndex = CreateObject("Scripting.Dictionary")
        systemMacroGroupKeyIndex.CompareMode = vbTextCompare
        Set defaultCatalog = New Collection
    Else
        Err.Raise vbObjectError + 9542, "ReconcileSystemHelpMacroDefinitionsCore", "Unsupported Help Document synchronization scope: " & CStr(synchronizationScope)
    End If
    CorePulseProgress "Preparing authoritative System Macro and Help Document Macro source..."
    LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "ReconcileSystemHelpMacroDefinitionsCore", "PreparePart14AuthoritativeSource starting.", "Stage: authoritative source preparation", "System Macro and Help Document Macro managed definitions", 0, vbNullString, vbNullString, vbNullString, "ManagedObjectDefinitionsMacros", "CodeDb", "Performance"
    stageTimer = Timer
    PreparePart14AuthoritativeSource allowSourceRepair, defaultCatalog, synchronizationScope
    stageElapsedSeconds = ElapsedSecondsFromTimer(stageTimer)
    LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "ReconcileSystemHelpMacroDefinitionsCore", "PreparePart14AuthoritativeSource completed.", "Elapsed: " & FormattedElapsedSeconds(stageElapsedSeconds), "System Macro and Help Document Macro managed definitions", 0, vbNullString, vbNullString, vbNullString, "ManagedObjectDefinitionsMacros", "CodeDb", "Performance"
    CorePulseProgress "Building managed-definition plan..."
    LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "ReconcileSystemHelpMacroDefinitionsCore", "BuildPart14ManagedDefinitionPlan starting.", "Stage: managed-definition plan construction", "System Macro and Help Document Macro managed definitions", 0, vbNullString, vbNullString, vbNullString, "ManagedObjectDefinitionsMacros", "CodeDb", "Performance"
    stageTimer = Timer
    BuildPart14ManagedDefinitionPlan defaultCatalog, systemMacroGroupKeyIndex, synchronizationScope
    stageElapsedSeconds = ElapsedSecondsFromTimer(stageTimer)
    LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "ReconcileSystemHelpMacroDefinitionsCore", "BuildPart14ManagedDefinitionPlan completed.", "Elapsed: " & FormattedElapsedSeconds(stageElapsedSeconds), "System Macro and Help Document Macro managed definitions", 0, vbNullString, vbNullString, vbNullString, "ManagedObjectDefinitionsMacros", "CodeDb", "Performance"
    CorePulseProgress "Applying managed-definition changes..."
    LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "ReconcileSystemHelpMacroDefinitionsCore", "ExecutePart14ManagedDefinitionDelta starting.", "Stage: managed-definition delta execution", "System Macro and Help Document Macro managed definitions", 0, vbNullString, vbNullString, vbNullString, "ManagedObjectDefinitionsMacros", "CodeDb", "Performance"
    stageTimer = Timer
    ExecutePart14ManagedDefinitionDelta executionDetail, synchronizationScope, False
    stageElapsedSeconds = ElapsedSecondsFromTimer(stageTimer)
    LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "ReconcileSystemHelpMacroDefinitionsCore", "ExecutePart14ManagedDefinitionDelta completed.", "Elapsed: " & FormattedElapsedSeconds(stageElapsedSeconds), "System Macro and Help Document Macro managed definitions", 0, vbNullString, vbNullString, vbNullString, "ManagedObjectDefinitionsMacros", "CodeDb", "Performance"
End Sub

Private Sub ExecutePart14ManagedDefinitionDelta(ByRef executionDetail As String, ByVal synchronizationScope As HelpDocumentSynchronizationScope, Optional ByVal rollbackAfterVerification As Boolean = False)
    On Error GoTo ErrHandler
    Dim ws As DAO.workspace
    Dim transactionStarted As Boolean
    Dim stageTimer As Single
    Dim mutationCountBefore As Long
    Dim initialMutationDeltaCount As Long
    Dim initialDirtyMask As Long
    Dim initialManagedInserted As Long
    Dim initialManagedUpdated As Long
    Dim initialPayloadInserted As Long
    Dim initialPayloadUpdated As Long
    Dim staleIDs As Object
    Dim staleNames As String
    Dim remainingStaleIDs As Object
    Dim remainingStaleNames As String
    Set staleIDs = Part14StaleHelpDocumentManagedRowIDs(staleNames, synchronizationScope)
    mPart14InitialStaleHelpDocumentCount = staleIDs.count
    mPart14StaleHelpDocumentRetiredCount = 0
    initialMutationDeltaCount = ManagedDefinitionCoreDirtyCount() + mPart14InitialStaleHelpDocumentCount
    If initialMutationDeltaCount = 0 Then
        mPart14ActualMutationCount = 0
        executionDetail = "B4 delta is empty; no per-object defaulting loop, stale Help Document retirement, write transaction, authoritative row update, or payload rewrite was performed."
        mPart14LastDeltaSummary = Part14DeltaSummaryText()
        Exit Sub
    End If
    initialDirtyMask = mManagedDefinitionBatchDirtyMask
    initialManagedInserted = mManagedDefinitionBatchManagedInserted
    initialManagedUpdated = mManagedDefinitionBatchManagedUpdated
    initialPayloadInserted = mManagedDefinitionBatchPayloadInserted
    initialPayloadUpdated = mManagedDefinitionBatchPayloadUpdated
    Set ws = DBEngine.Workspaces(0)
    ws.BeginTrans
    transactionStarted = True
    mutationCountBefore = ManagedDefinitionBatchMutationCount()
    stageTimer = Timer
    mManagedDefinitionDeltaExecutionActive = True
    ApplyPart14ManagedObjectDelta
    ApplyPart14PayloadDelta
    mPart14StaleHelpDocumentRetiredCount = RetirePart14StaleHelpDocumentManagedRows(staleIDs)
    mManagedDefinitionDeltaExecutionActive = False
    mPart14MutationElapsedSeconds = ElapsedSecondsFromTimer(stageTimer)
    stageTimer = Timer
    RefreshManagedDefinitionBatchIndexes False
    BuildManagedDefinitionDelta False
    If mManagedDefinitionObjectInsertCount + mManagedDefinitionObjectUpdateCount + mManagedDefinitionPayloadInsertCount + mManagedDefinitionPayloadUpdateCount <> 0 Then Err.Raise vbObjectError + 9536, "ExecutePart14ManagedDefinitionDelta", "B4 postcondition verification still found authoritative catalog mutations after applying the delta." & vbCrLf & mManagedDefinitionDirtyObjectList & vbCrLf & mManagedDefinitionDirtyPayloadList
    Set remainingStaleIDs = Part14StaleHelpDocumentManagedRowIDs(remainingStaleNames, synchronizationScope)
    If remainingStaleIDs.count <> 0 Then Err.Raise vbObjectError + 9539, "ExecutePart14ManagedDefinitionDelta", "B4 postcondition verification still found active obsolete Help Document managed rows." & vbCrLf & remainingStaleNames
    mPart14PostconditionElapsedSeconds = ElapsedSecondsFromTimer(stageTimer)
    mPart14ActualMutationCount = ManagedDefinitionBatchMutationCount() - mutationCountBefore
    If rollbackAfterVerification Then
        ws.Rollback
        transactionStarted = False
        mManagedDefinitionBatchDirtyMask = initialDirtyMask
        mManagedDefinitionBatchManagedInserted = initialManagedInserted
        mManagedDefinitionBatchManagedUpdated = initialManagedUpdated
        mManagedDefinitionBatchPayloadInserted = initialPayloadInserted
        mManagedDefinitionBatchPayloadUpdated = initialPayloadUpdated
        RefreshManagedDefinitionBatchIndexes False, True
        executionDetail = "B4 production mutation path completed and passed postcondition verification, then the isolated transactional test rolled back all changes."
    Else
        ws.CommitTrans
        transactionStarted = False
        executionDetail = "B4 applied only the planned object/payload delta plus obsolete ADC-owned Help Document retirement and verified every changed row before commit."
    End If
    executionDetail = executionDetail & vbCrLf & "Initial mutation delta: " & CStr(initialMutationDeltaCount) & vbCrLf & "Obsolete Help Document managed rows retired: " & CStr(mPart14StaleHelpDocumentRetiredCount) & vbCrLf & "Actual affected rows: " & CStr(mPart14ActualMutationCount) & vbCrLf & "Rolled back after verification: " & CStr(rollbackAfterVerification)
    If Len(staleNames) > 0 Then executionDetail = executionDetail & vbCrLf & "Retired Help Document managed rows:" & vbCrLf & staleNames
    mPart14LastDeltaSummary = Part14DeltaSummaryText()
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    mManagedDefinitionDeltaExecutionActive = False
    On Error Resume Next
    If transactionStarted Then ws.Rollback
    On Error GoTo 0
    Err.Raise savedErrNumber, "ExecutePart14ManagedDefinitionDelta", "Could not execute the B4 managed-definition delta." & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Sub

Private Function ManagedDefinitionManagedBookmarkKey(ByVal objectName As String, ByVal objectTypeCode As String) As String
    Dim canonicalIdentityKey As String
    Dim separatorPosition As Long
    canonicalIdentityKey = ManagedObjectDefinitionIdentityKey(objectName, objectTypeCode)
    separatorPosition = InStr(1, canonicalIdentityKey, "|", vbBinaryCompare)
    If separatorPosition > 0 Then
        ManagedDefinitionManagedBookmarkKey = Left$(canonicalIdentityKey, separatorPosition - 1) & Chr$(30) & Mid$(canonicalIdentityKey, separatorPosition + 1)
    Else
        ManagedDefinitionManagedBookmarkKey = canonicalIdentityKey
    End If
End Function

Private Function ManagedDefinitionExactManagedBookmarkKey(ByVal objectName As String, ByVal objectTypeCode As String) As String
    'Exact-name batch key for dynamically discovered physical forms. ObjectType remains canonicalized; ObjectName is preserved byte-for-byte.
    ManagedDefinitionExactManagedBookmarkKey = UCase$(Trim$(objectTypeCode)) & Chr$(30) & objectName
End Function

Private Function ManagedDefinitionPayloadBookmarkKey(ByVal managedObjectID As Long, ByVal payloadKind As String) As String
    ManagedDefinitionPayloadBookmarkKey = CStr(managedObjectID) & Chr$(30) & UCase$(Trim$(payloadKind))
End Function

Private Function LongCollectionList(ByVal values As Collection) As String
    Dim item As Variant
    Dim resultText As String
    For Each item In values
        PumpSetupResponsiveness
        If Len(resultText) > 0 Then resultText = resultText & ","
        resultText = resultText & CStr(CLng(item))
    Next item
    LongCollectionList = resultText
End Function

Private Function B2SharedFieldMetadataPlan() As Object
    Dim rows As Object
    Dim lookupNames As Variant
    Dim coreNames As Variant
    Dim macroNames As Variant
    Dim systemMacroNames As Variant
    Dim helpNames As Variant
    Dim families As Variant
    Dim familyNames As Variant
    Dim familyIndex As Long
    Dim structuralFamilyCount As Long
    Dim referenceInventoryNames As Collection
    Dim referenceLoadedVbaAnalysisNames As Collection
    Dim referenceCrosswalkNames As Collection
    Dim referenceQueryNames As Collection
    Dim referenceFamily As Variant
    Dim referenceTableName As Variant
    Dim tableName As Variant
    ' INTENTIONAL KEYED LOOKUP: rows provides keyed membership/lookup over source rows or state already read by B2SharedFieldMetadataPlan; it is a derived access path, not a second authority.
    Set rows = CreateObject("Scripting.Dictionary")
    rows.CompareMode = vbTextCompare
    B2AddMetadataPlanTable rows, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_SETTINGS_TABLE_LOGICAL_ID)
    B2AddMetadataPlanTable rows, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Config")
    B2AddMetadataPlanTable rows, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Candidates")
    B2AddMetadataPlanTable rows, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HealthReview")
    B2AddMetadataPlanTable rows, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_TERMINOLOGY_TABLE_LOGICAL_ID)
    ResolvePart8FamilyTableNames lookupNames, coreNames, macroNames, systemMacroNames, helpNames, structuralFamilyCount
    families = Array(lookupNames, coreNames, macroNames, systemMacroNames, helpNames)
    For familyIndex = LBound(families) To UBound(families)
        familyNames = families(familyIndex)
        If Part8ArrayCount(familyNames) > 0 Then
            For Each tableName In familyNames
                B2AddMetadataPlanTable rows, CStr(tableName)
            Next tableName
        End If
    Next familyIndex
    ResolveReferenceFamilies referenceInventoryNames, referenceLoadedVbaAnalysisNames, referenceCrosswalkNames, referenceQueryNames
    For Each referenceFamily In Array(referenceInventoryNames, referenceLoadedVbaAnalysisNames, referenceCrosswalkNames)
        For Each referenceTableName In referenceFamily
            B2AddMetadataPlanTable rows, CStr(referenceTableName)
        Next referenceTableName
    Next referenceFamily
    Set B2SharedFieldMetadataPlan = rows
End Function

Private Function B2SharedFieldMetadataInputToken(ByVal db As DAO.Database, ByVal planRows As Object, ByRef allInputsPresent As Boolean) As String
    Dim tableKeys As Variant
    Dim tableIndex As Long
    Dim tableName As String
    Dim tdf As DAO.tableDef
    Dim definitions As Collection
    Dim dependencyRows As Object
    Dim tableFieldsPresent As Boolean
    Dim allDependenciesPresent As Boolean
    Dim payloadText As String
    ' INTENTIONAL KEYED LOOKUP: dependencyRows provides keyed membership/lookup over source rows or state already read by B2SharedFieldMetadataInputToken; it is a derived access path, not a second authority.
    Set dependencyRows = CreateObject("Scripting.Dictionary")
    dependencyRows.CompareMode = vbTextCompare
    payloadText = FingerprintTokenPart(B2_SHARED_FIELD_METADATA_CONTRACT)
    allInputsPresent = True
    tableKeys = planRows.keys
    B2SortTextArray tableKeys
    For tableIndex = LBound(tableKeys) To UBound(tableKeys)
        tableName = CStr(tableKeys(tableIndex))
        Set definitions = planRows.item(tableName)
        payloadText = payloadText & B2MetadataDefinitionPayload(tableName, definitions, dependencyRows)
        If B2TryGetLocalTableDef(db, tableName, tdf) Then
            payloadText = payloadText & B2MetadataFieldStatePayload(tdf, definitions, tableFieldsPresent)
            If tableFieldsPresent = False Then allInputsPresent = False
            Set tdf = Nothing
        Else
            payloadText = payloadText & FingerprintTokenPart("<missing-table>")
            allInputsPresent = False
        End If
    Next tableIndex
    payloadText = payloadText & FingerprintTokenPart("ExactDependencies")
    payloadText = payloadText & B2MetadataDependencyPayload(db, dependencyRows, allDependenciesPresent)
    If allDependenciesPresent = False Then allInputsPresent = False
    B2SharedFieldMetadataInputToken = FingerprintFromPayload(payloadText)
End Function

Private Function B2SharedFieldMetadataProofMatches(ByVal db As DAO.Database, ByVal planRows As Object, ByRef currentToken As String) As Boolean
    Dim allInputsPresent As Boolean
    Dim propertyExists As Boolean
    Dim storedToken As String
    storedToken = DatabaseTextPropertyValue(db, B2_SHARED_FIELD_METADATA_PROOF_PROPERTY, propertyExists)
    If propertyExists = False Then Exit Function
    currentToken = B2SharedFieldMetadataInputToken(db, planRows, allInputsPresent)
    If allInputsPresent = False Then Exit Function
    B2SharedFieldMetadataProofMatches = (StrComp(storedToken, currentToken, vbBinaryCompare) = 0)
End Function

Private Sub PersistB2SharedFieldMetadataProofToken(ByVal db As DAO.Database, ByVal currentToken As String, ByVal allInputsPresent As Boolean)
    If allInputsPresent = False Then Err.Raise vbObjectError + 9508, "PersistB2SharedFieldMetadataProofToken", "The B2 shared field-metadata pass completed without every authoritative table, field, or exact RowSource dependency being present."
    EnsureDaoPropertyValue db, B2_SHARED_FIELD_METADATA_PROOF_PROPERTY, dbText, currentToken, "PersistB2SharedFieldMetadataProofToken"
End Sub

Private Function B2ReferenceFamilyTable(ByVal tableName As String) As Boolean
    Dim inventoryNames As Collection
    Dim loadedVbaAnalysisNames As Collection
    Dim crosswalkNames As Collection
    Dim queryNames As Collection
    Dim familyRows As Variant
    Dim item As Variant
    ResolveReferenceFamilies inventoryNames, loadedVbaAnalysisNames, crosswalkNames, queryNames
    For Each familyRows In Array(inventoryNames, loadedVbaAnalysisNames, crosswalkNames)
        For Each item In familyRows
            If StrComp(CStr(item), tableName, vbTextCompare) = 0 Then B2ReferenceFamilyTable = True: Exit Function
        Next item
    Next familyRows
End Function

Private Sub ClearUnexpectedB2LookupMetadataFromTableDef(ByVal tdf As DAO.tableDef, ByVal definitions As Collection, ByVal referenceFamilyTable As Boolean)
    'Negative lookup proof: canonical B2-owned fields not designated by any current lookup definition must not retain stale Access lookup metadata.
    Dim expected As Object
    Dim Definition As Variant
    Dim canonicalOrderText As String
    Dim canonicalFields As Variant
    Dim fieldName As Variant
    Dim directDefinition As Variant
    If referenceFamilyTable Then Exit Sub 'A4 owns the equivalent negative proof for Reference-family canonical fields.
    canonicalOrderText = CanonicalTableFieldOrderText(tdf.Name)
    If Len(canonicalOrderText) = 0 Then Exit Sub
    Set expected = CreateObject("Scripting.Dictionary")
    expected.CompareMode = vbTextCompare
    For Each Definition In definitions
        Select Case UCase$(CStr(Definition(0)))
            Case UCase$(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_TABLE), UCase$(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_VALUE_LIST), UCase$(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_LIVE)
                expected(CStr(Definition(1))) = True
        End Select
    Next Definition
    canonicalFields = Split(canonicalOrderText, "|")
    For Each fieldName In canonicalFields
        If Len(fieldName) > 0 And SharedDao_TableDefFieldExistsSafe(tdf, CStr(fieldName)) Then
            If expected.Exists(CStr(fieldName)) = False Then
                directDefinition = FieldTableLookupDefinition(tdf.Name, CStr(fieldName))
                If IsArray(directDefinition) = False And Len(TableFieldLookupValueList(tdf.Name, CStr(fieldName))) = 0 Then ClearFieldLookupPresentationProperties tdf, CStr(fieldName)
            End If
        End If
    Next fieldName
End Sub

Private Function ApplyB2SharedFieldMetadataDefinitionCollectionToTableDef(ByVal tdf As DAO.tableDef, ByVal definitions As Collection, ByRef warningCount As Long, Optional ByVal failOnWarning As Boolean = False) As Long
    Dim Definition As Variant
    Dim definitionKind As String
    Dim fieldName As String
    Dim lookupResult As Long
    Dim changed As Boolean
    Dim referenceFamilyTable As Boolean
    tdf.fields.Refresh
    referenceFamilyTable = B2ReferenceFamilyTable(tdf.Name)
    ClearUnexpectedB2LookupMetadataFromTableDef tdf, definitions, referenceFamilyTable
    For Each Definition In definitions
        fieldName = CStr(Definition(1))
        If SharedDao_TableDefFieldExistsSafe(tdf, fieldName) = False Then Err.Raise vbObjectError + 9511, "ApplyB2SharedFieldMetadataDefinitionCollectionToTableDef", "An authoritative B2 metadata field is missing." & vbCrLf & "Table: " & tdf.Name & vbCrLf & "Field: " & fieldName
        definitionKind = UCase$(CStr(Definition(0)))
        Select Case definitionKind
            Case UCase$(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_VALUE_LIST)
                ApplyB2SharedFieldMetadataDefinitionCollectionToTableDef = ApplyB2SharedFieldMetadataDefinitionCollectionToTableDef + EnsureFieldValueListLookup(tdf, fieldName, CStr(Definition(2)), CLng(Definition(7)), CBool(Definition(5)))
            Case UCase$(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_TABLE)
                If referenceFamilyTable Then
                    VerifyReferenceTableLookupDefinition tdf, Definition
                Else
                    If EnsureCatalogLookupField(tdf, fieldName, CStr(Definition(2)), CStr(Definition(3)), CStr(Definition(4)), CBool(Definition(5)), CStr(Definition(8))) = False Then Err.Raise vbObjectError + 9512, "ApplyB2SharedFieldMetadataDefinitionCollectionToTableDef", "An authoritative B2 table lookup could not be applied and verified." & vbCrLf & "Table: " & tdf.Name & vbCrLf & "Field: " & fieldName
                End If
            Case UCase$(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_LIVE)
                lookupResult = EnsureLiveObjectLookupField(tdf, fieldName, CStr(Definition(2)), CBool(Definition(5)), CLng(Definition(6)), CLng(Definition(7)), CStr(Definition(8)))
                If lookupResult < 0 Then
                    warningCount = warningCount + 1
                    If failOnWarning Then Err.Raise vbObjectError + 9518, "ApplyB2SharedFieldMetadataDefinitionCollectionToTableDef", "Access rejected an authoritative B2 live lookup update, so B2 will not persist a metadata proof." & vbCrLf & "Table: " & tdf.Name & vbCrLf & "Field: " & fieldName
                Else
                    ApplyB2SharedFieldMetadataDefinitionCollectionToTableDef = ApplyB2SharedFieldMetadataDefinitionCollectionToTableDef + lookupResult
                End If
            Case "CAPTION"
                changed = EnsureDaoPropertyValue(tdf.fields(fieldName), "Caption", dbText, CStr(Definition(2)), "ApplyB2SharedFieldMetadataDefinitionCollectionToTableDef")
                If changed Then ApplyB2SharedFieldMetadataDefinitionCollectionToTableDef = ApplyB2SharedFieldMetadataDefinitionCollectionToTableDef + 1
            Case Else
                Err.Raise vbObjectError + 9513, "ApplyB2SharedFieldMetadataDefinitionCollectionToTableDef", "Unknown authoritative B2 metadata definition kind." & vbCrLf & "Table: " & tdf.Name & vbCrLf & "Field: " & fieldName & vbCrLf & "Kind: " & definitionKind
        End Select
    Next Definition
End Function

' Purpose: Applies B2 shared field metadata definitions to table def for tdf, warning count.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   tdf (Input; DAO.tableDef): DAO.TableDef representing the table whose fields, indexes, properties, or metadata are being inspected or modified.
'   warningCount (Input/output; Long): Carries the caller's existing B2 metadata warning count and is incremented for each live-lookup update Access rejects without making the operation fatal.
' Returns: Long: Returns the number/result code produced while applying the requested field/lookup metadata; callers use it to detect whether physical metadata required creation or repair.
Public Function ApplyB2SharedFieldMetadataDefinitionsToTableDef(ByVal tdf As DAO.tableDef, ByRef warningCount As Long) As Long
    'Standalone/cross-module wrapper; B2 Setup reuses the definition collection already stored in its plan. Runtime/manual use remains allowed, but numbered Setup mutation belongs only to B2.
    If SetupDomainMutationWritesAllowedForCurrentPart(SETUP_DOMAIN_B2_CATALOG_REFERENCE_DEFAULTS) = False Then Err.Raise vbObjectError + 9627, "ApplyB2SharedFieldMetadataDefinitionsToTableDef", "Shared B2 lookup/caption metadata mutation was requested outside the B2 numbered Setup ownership boundary." & vbCrLf & "Table: " & tdf.Name
    Dim definitions As Collection
    Set definitions = B2SharedFieldMetadataDefinitions(tdf.Name)
    ApplyB2SharedFieldMetadataDefinitionsToTableDef = ApplyB2SharedFieldMetadataDefinitionCollectionToTableDef(tdf, definitions, warningCount)
End Function

Private Function D4LookupEditorRequiredPhysicalForm(ByVal policyCode As String) As Boolean
    D4LookupEditorRequiredPhysicalForm = (StrComp(policyCode, LOOKUP_EDITOR_POLICY_NONE, vbTextCompare) <> 0)
End Function

Private Sub D4ExpectedLookupEditorState(ByVal db As DAO.Database, ByVal Definition As Variant, ByRef expectedEnabled As Boolean, ByRef expectedEditorForm As String, ByRef policyCode As String, ByRef editorExists As Boolean, ByRef requiredEditorMissing As Boolean)
    Dim definitionKind As String
    expectedEnabled = False
    expectedEditorForm = vbNullString
    policyCode = LOOKUP_EDITOR_POLICY_NONE
    editorExists = False
    requiredEditorMissing = False
    definitionKind = UCase$(CStr(Definition(0)))
    If definitionKind <> UCase$(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_TABLE) Then Exit Sub
    expectedEditorForm = LookupEditorPhysicalFormNameForSource(CStr(Definition(2)), policyCode)
    If StrComp(policyCode, LOOKUP_EDITOR_POLICY_NONE, vbTextCompare) = 0 Then Exit Sub
    If StrComp(policyCode, LOOKUP_EDITOR_POLICY_GENERATED, vbTextCompare) <> 0 And StrComp(policyCode, LOOKUP_EDITOR_POLICY_EXISTING_MANAGED_FRM, vbTextCompare) <> 0 Then
        requiredEditorMissing = True
        Exit Sub
    End If
    If Len(Trim$(expectedEditorForm)) = 0 Then
        requiredEditorMissing = True
        Exit Sub
    End If
    editorExists = SharedDao_AccessObjectExists(db, acForm, expectedEditorForm)
    requiredEditorMissing = D4LookupEditorRequiredPhysicalForm(policyCode) And (editorExists = False)
    expectedEnabled = editorExists
End Sub

Private Function D4LookupEditorBindingStateToken(ByVal db As DAO.Database, ByVal planRows As Object, ByRef allStateCurrent As Boolean, ByRef detailText As String) As String
    On Error GoTo ErrHandler
    Dim tableKeys As Variant
    Dim tableIndex As Long
    Dim tableName As String
    Dim definitions As Collection
    Dim Definition As Variant
    Dim definitionKind As String
    Dim fieldName As String
    Dim tdf As DAO.tableDef
    Dim fld As DAO.Field
    Dim expected As Object
    Dim canonicalOrderText As String
    Dim canonicalFields As Variant
    Dim canonicalField As Variant
    Dim directDefinition As Variant
    Dim expectedEnabled As Boolean
    Dim expectedEditorForm As String
    Dim policyCode As String
    Dim editorExists As Boolean
    Dim requiredEditorMissing As Boolean
    Dim actualAllowText As String
    Dim actualEditorForm As String
    Dim payloadText As String
    allStateCurrent = True
    detailText = vbNullString
    payloadText = FingerprintTokenPart(D4_LOOKUP_EDITOR_BINDING_CONTRACT)
    tableKeys = planRows.keys
    B2SortTextArray tableKeys
    For tableIndex = LBound(tableKeys) To UBound(tableKeys)
        tableName = CStr(tableKeys(tableIndex))
        payloadText = payloadText & FingerprintTokenPart("Table=" & UCase$(tableName))
        If B2TryGetLocalTableDef(db, tableName, tdf) = False Then
            payloadText = payloadText & FingerprintTokenPart("<missing-table>")
            allStateCurrent = False
            If Len(detailText) = 0 Then detailText = "D4 lookup-editor binding proof found a missing authoritative table." & vbCrLf & "Table: " & tableName
        Else
            Set definitions = planRows.item(tableName)
            Set expected = CreateObject("Scripting.Dictionary")
            expected.CompareMode = vbTextCompare
            For Each Definition In definitions
                definitionKind = UCase$(CStr(Definition(0)))
                If definitionKind = UCase$(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_TABLE) Or definitionKind = UCase$(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_VALUE_LIST) Or definitionKind = UCase$(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_LIVE) Then
                    fieldName = CStr(Definition(1))
                    expected(fieldName) = True
                    payloadText = payloadText & FingerprintTokenPart(definitionKind) & FingerprintTokenPart(fieldName)
                    If SharedDao_TableDefFieldExistsSafe(tdf, fieldName) = False Then
                        payloadText = payloadText & FingerprintTokenPart("<missing-field>")
                        allStateCurrent = False
                        If Len(detailText) = 0 Then detailText = "D4 lookup-editor binding proof found a missing authoritative lookup field." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName
                    Else
                        Set fld = tdf.fields(fieldName)
                        D4ExpectedLookupEditorState db, Definition, expectedEnabled, expectedEditorForm, policyCode, editorExists, requiredEditorMissing
                        payloadText = payloadText & FingerprintTokenPart("Policy=" & LookupEditorPolicyFingerprintForPhysicalSource(IIf(definitionKind = UCase$(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_TABLE), CStr(Definition(2)), vbNullString)))
                        payloadText = payloadText & FingerprintTokenPart("ExpectedEditor=" & expectedEditorForm)
                        payloadText = payloadText & FingerprintTokenPart("EditorFormExists=" & CStr(editorExists))
                        actualAllowText = DaoObjectPropertyFingerprintText(fld, "AllowValueListEdits")
                        actualEditorForm = DaoObjectPropertyFingerprintText(fld, "ListItemsEditForm")
                        payloadText = payloadText & FingerprintTokenPart("AllowValueListEdits=" & actualAllowText)
                        payloadText = payloadText & FingerprintTokenPart("ListItemsEditForm=" & actualEditorForm)
                        If requiredEditorMissing Then
                            allStateCurrent = False
                            If Len(detailText) = 0 Then detailText = "D4 lookup-editor binding proof found a required D3-owned ADC Support Form editor missing." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName & vbCrLf & "Policy: " & policyCode & vbCrLf & "Expected editor: " & expectedEditorForm
                        ElseIf expectedEnabled Then
                            If StrComp(actualAllowText, "True", vbTextCompare) <> 0 Or StrComp(actualEditorForm, expectedEditorForm, vbTextCompare) <> 0 Then
                                allStateCurrent = False
                                If Len(detailText) = 0 Then detailText = "D4 lookup-editor binding is stale." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName & vbCrLf & "Expected AllowValueListEdits: True" & vbCrLf & "Expected ListItemsEditForm: " & expectedEditorForm & vbCrLf & "Actual AllowValueListEdits: " & actualAllowText & vbCrLf & "Actual ListItemsEditForm: " & actualEditorForm
                            End If
                        Else
                            If StrComp(actualAllowText, "False", vbTextCompare) <> 0 Or StrComp(actualEditorForm, "<missing>", vbTextCompare) <> 0 Then
                                allStateCurrent = False
                                If Len(detailText) = 0 Then detailText = "D4 no-editor binding state is stale." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName & vbCrLf & "Expected AllowValueListEdits: False" & vbCrLf & "Expected ListItemsEditForm: <missing>" & vbCrLf & "Actual AllowValueListEdits: " & actualAllowText & vbCrLf & "Actual ListItemsEditForm: " & actualEditorForm
                            End If
                        End If
                    End If
                End If
            Next Definition
            canonicalOrderText = CanonicalTableFieldOrderText(tableName)
            If Len(canonicalOrderText) > 0 Then
                canonicalFields = Split(canonicalOrderText, "|")
                For Each canonicalField In canonicalFields
                    fieldName = CStr(canonicalField)
                    If Len(fieldName) > 0 And expected.Exists(fieldName) = False And SharedDao_TableDefFieldExistsSafe(tdf, fieldName) Then
                        directDefinition = FieldTableLookupDefinition(tableName, fieldName)
                        If IsArray(directDefinition) = False And Len(TableFieldLookupValueList(tableName, fieldName)) = 0 Then
                            Set fld = tdf.fields(fieldName)
                            actualAllowText = DaoObjectPropertyFingerprintText(fld, "AllowValueListEdits")
                            actualEditorForm = DaoObjectPropertyFingerprintText(fld, "ListItemsEditForm")
                            payloadText = payloadText & FingerprintTokenPart("NOEDITOR") & FingerprintTokenPart(fieldName) & FingerprintTokenPart(actualAllowText) & FingerprintTokenPart(actualEditorForm)
                            If StrComp(actualAllowText, "False", vbTextCompare) <> 0 Or StrComp(actualEditorForm, "<missing>", vbTextCompare) <> 0 Then
                                allStateCurrent = False
                                If Len(detailText) = 0 Then detailText = "D4 found stale editor-binding metadata on a canonical field with no authoritative editor intent." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName & vbCrLf & "Actual AllowValueListEdits: " & actualAllowText & vbCrLf & "Actual ListItemsEditForm: " & actualEditorForm
                            End If
                        End If
                    End If
                Next canonicalField
            End If
            Set tdf = Nothing
        End If
    Next tableIndex
    D4LookupEditorBindingStateToken = FingerprintFromPayload(payloadText)
    Exit Function
ErrHandler:
    detailText = "Could not calculate the D4 lookup-editor binding proof. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description & IIf(Len(tableName) > 0, vbCrLf & "Table: " & tableName, vbNullString) & IIf(Len(fieldName) > 0, vbCrLf & "Field: " & fieldName, vbNullString)
    allStateCurrent = False
End Function

' Purpose: Reconciles lookup editor bindings for setup.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   detailText (Output; String): Receives diagnostic detail text used to explain validation, lookup, recovery, or failure results to the caller.
' Returns: Boolean: True on the function's affirmative/success branch for reconcile lookup editor bindings for setup; False on its explicit negative, unavailable, rejected, or handled-failure branch.
'   not-applicable path.
Public Function ReconcileLookupEditorBindingsForSetup(ByRef detailText As String) As Boolean
    RequireSetupDomainMutationAllowed SETUP_DOMAIN_D4_LOOKUP_EDITOR_BINDING, "ReconcileLookupEditorBindingsForSetup"
    'D4 physical integration: derive the expected binding directly from persistent B2 policy/definitions after D2 form reconciliation, then apply and read back exactly the two D4-owned field properties.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim planRows As Object
    Dim tableKeys As Variant
    Dim tableIndex As Long
    Dim tableName As String
    Dim definitions As Collection
    Dim Definition As Variant
    Dim definitionKind As String
    Dim fieldName As String
    Dim tdf As DAO.tableDef
    Dim fld As DAO.Field
    Dim expected As Object
    Dim canonicalOrderText As String
    Dim canonicalFields As Variant
    Dim canonicalField As Variant
    Dim directDefinition As Variant
    Dim expectedEnabled As Boolean
    Dim expectedEditorForm As String
    Dim policyCode As String
    Dim editorExists As Boolean
    Dim requiredEditorMissing As Boolean
    Dim allStateCurrent As Boolean
    Dim currentToken As String
    Dim bindingCount As Long
    Dim disabledCount As Long
    detailText = vbNullString
    Set db = ResolveCatalogDb()
    Set planRows = B2SharedFieldMetadataPlan()
    tableKeys = planRows.keys
    B2SortTextArray tableKeys
    For tableIndex = LBound(tableKeys) To UBound(tableKeys)
        tableName = CStr(tableKeys(tableIndex))
        If B2TryGetLocalTableDef(db, tableName, tdf) = False Then Err.Raise vbObjectError + 9616, "ReconcileLookupEditorBindingsForSetup", "D4 cannot bind lookup editors because an authoritative B2 table is missing." & vbCrLf & "Table: " & tableName
        Set definitions = planRows.item(tableName)
        Set expected = CreateObject("Scripting.Dictionary")
        expected.CompareMode = vbTextCompare
        For Each Definition In definitions
            definitionKind = UCase$(CStr(Definition(0)))
            If definitionKind = UCase$(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_TABLE) Or definitionKind = UCase$(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_VALUE_LIST) Or definitionKind = UCase$(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_LIVE) Then
                fieldName = CStr(Definition(1))
                expected(fieldName) = True
                If SharedDao_TableDefFieldExistsSafe(tdf, fieldName) = False Then Err.Raise vbObjectError + 9617, "ReconcileLookupEditorBindingsForSetup", "D4 cannot bind a missing authoritative B2 lookup field." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName
                Set fld = tdf.fields(fieldName)
                D4ExpectedLookupEditorState db, Definition, expectedEnabled, expectedEditorForm, policyCode, editorExists, requiredEditorMissing
                If requiredEditorMissing Then Err.Raise vbObjectError + 9618, "ReconcileLookupEditorBindingsForSetup", "D4 requires a D3-owned ADC Support Form lookup editor that is physically unavailable; integration will not be deferred." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName & vbCrLf & "Policy: " & policyCode & vbCrLf & "Expected editor: " & expectedEditorForm
                If expectedEnabled Then
                    ApplyLookupEditorMetadataToField fld, CStr(Definition(2)), tableName, fieldName
                    bindingCount = bindingCount + 1
                Else
                    ClearLookupEditorMetadataFromField fld, tableName, fieldName
                    disabledCount = disabledCount + 1
                End If
            End If
        Next Definition
        canonicalOrderText = CanonicalTableFieldOrderText(tableName)
        If Len(canonicalOrderText) > 0 Then
            canonicalFields = Split(canonicalOrderText, "|")
            For Each canonicalField In canonicalFields
                fieldName = CStr(canonicalField)
                If Len(fieldName) > 0 And expected.Exists(fieldName) = False And SharedDao_TableDefFieldExistsSafe(tdf, fieldName) Then
                    directDefinition = FieldTableLookupDefinition(tableName, fieldName)
                    If IsArray(directDefinition) = False And Len(TableFieldLookupValueList(tableName, fieldName)) = 0 Then
                        ClearLookupEditorMetadataFromField tdf.fields(fieldName), tableName, fieldName
                        disabledCount = disabledCount + 1
                    End If
                End If
            Next canonicalField
        End If
        Set tdf = Nothing
    Next tableIndex
    currentToken = D4LookupEditorBindingStateToken(db, planRows, allStateCurrent, detailText)
    If allStateCurrent = False Or Len(currentToken) = 0 Then Err.Raise vbObjectError + 9619, "ReconcileLookupEditorBindingsForSetup", "D4 lookup-editor bindings did not read back as the exact expected physical state." & IIf(Len(detailText) > 0, vbCrLf & detailText, vbNullString)
    Call EnsureDaoPropertyValue(db, D4_LOOKUP_EDITOR_BINDING_PROOF_PROPERTY, dbText, currentToken, "ReconcileLookupEditorBindingsForSetup")
    detailText = "D4 lookup-editor field binding is exact. Editor-backed fields=" & CStr(bindingCount) & "; explicit no-editor/stale-cleanup fields=" & CStr(disabledCount) & "; proof token=" & currentToken & "."
    ReconcileLookupEditorBindingsForSetup = True
    Exit Function
ErrHandler:
    detailText = "Could not reconcile D4 lookup-editor field bindings. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description & IIf(Len(tableName) > 0, vbCrLf & "Table: " & tableName, vbNullString) & IIf(Len(fieldName) > 0, vbCrLf & "Field: " & fieldName, vbNullString)
End Function

' Purpose: Checks whether d4 lookup editor binding already satisfies the exact state required by the current Setup run so the owning phase can determine whether repair is necessary.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   detailText (Input/output; String): Receives or supplies diagnostic detail text used to explain validation, lookup, recovery, or failure results to the caller.
'   currentToken (Output Optional; Variant): When supplied, receives the exact D4 lookup-editor binding state token computed during this currentness check.
' Returns: Boolean: True when d4 lookup editor binding matches the exact state required by the current Setup contract; False when the owning phase still needs repair, refresh, or reconciliation.
Public Function D4LookupEditorBindingCurrentForSetup(ByRef detailText As String, Optional ByRef currentToken As Variant) As Boolean
    'Standalone-safe read-only currentness proof. It reconstructs expected D4 state from persisted B2 policy/definitions and current physical forms/field properties; no transient Setup trace state is required.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim planRows As Object
    Dim allStateCurrent As Boolean
    Dim tokenText As String
    Dim storedToken As String
    Dim propertyExists As Boolean
    Set db = ResolveCatalogDb()
    Set planRows = B2SharedFieldMetadataPlan()
    tokenText = D4LookupEditorBindingStateToken(db, planRows, allStateCurrent, detailText)
    If isMissing(currentToken) = False Then currentToken = tokenText
    If allStateCurrent = False Or Len(tokenText) = 0 Then Exit Function
    storedToken = DatabaseTextPropertyValue(db, D4_LOOKUP_EDITOR_BINDING_PROOF_PROPERTY, propertyExists)
    If propertyExists = False Or Len(storedToken) = 0 Then
        detailText = "Persisted D4 lookup-editor binding proof is missing."
        Exit Function
    End If
    If StrComp(storedToken, tokenText, vbBinaryCompare) <> 0 Then
        detailText = "Persisted D4 lookup-editor binding proof is stale." & vbCrLf & "Persisted token: " & storedToken & vbCrLf & "Current token: " & tokenText
        Exit Function
    End If
    detailText = "D4 lookup-editor field binding proof is current. Token=" & tokenText & "."
    D4LookupEditorBindingCurrentForSetup = True
    Exit Function
ErrHandler:
    detailText = "Could not verify D4 lookup-editor binding currentness. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
End Function

Private Function J1LookupEditorRecordSourceReachesTable(ByVal db As DAO.Database, ByVal recordSourceText As String, ByVal targetTableName As String, ByVal visitedQueries As Object, ByRef detailText As String) As Boolean
    On Error GoTo ErrHandler
    Dim sqlText As String
    Dim sourceName As String
    Dim dependencyRows As Object
    Dim dependencyKey As Variant
    Dim dependencyData As Variant
    Dim dependencyType As String
    Dim dependencyName As String
    detailText = vbNullString
    sourceName = Trim$(recordSourceText)
    If Len(sourceName) = 0 Or Len(targetTableName) = 0 Then Exit Function
    If StrComp(sourceName, targetTableName, vbTextCompare) = 0 Then
        J1LookupEditorRecordSourceReachesTable = True
        Exit Function
    End If
    If UCase$(Left$(sourceName, 7)) = "SELECT " Or UCase$(Left$(sourceName, 10)) = "TRANSFORM " Then
        sqlText = sourceName
    ElseIf SharedDao_QueryExists(db, sourceName) Then
        If visitedQueries.Exists(sourceName) Then Exit Function
        visitedQueries.Add sourceName, True
        sqlText = CStr(db.QueryDefs(sourceName).sql)
    ElseIf SharedDao_TableExists(db, sourceName) Then
        detailText = "The editor RecordSource resolves to a different table." & vbCrLf & "RecordSource: " & sourceName & vbCrLf & "Expected lookup table: " & targetTableName
        Exit Function
    Else
        detailText = "The editor RecordSource is neither SQL nor an existing saved table/query." & vbCrLf & "RecordSource: " & sourceName
        Exit Function
    End If
    Set dependencyRows = CreateObject("Scripting.Dictionary")
    dependencyRows.CompareMode = vbTextCompare
    B2CollectSqlSourceNames sqlText, dependencyRows
    For Each dependencyKey In dependencyRows.keys
        dependencyData = dependencyRows.item(CStr(dependencyKey))
        dependencyType = CStr(dependencyData(0))
        dependencyName = CStr(dependencyData(1))
        If StrComp(dependencyType, ADCAT_OBJECT_TYPE_TABLE, vbTextCompare) = 0 Then
            If StrComp(dependencyName, targetTableName, vbTextCompare) = 0 Then
                J1LookupEditorRecordSourceReachesTable = True
                Exit Function
            End If
        ElseIf StrComp(dependencyType, ADCAT_OBJECT_TYPE_QUERY, vbTextCompare) = 0 Then
            If J1LookupEditorRecordSourceReachesTable(db, dependencyName, targetTableName, visitedQueries, detailText) Then
                J1LookupEditorRecordSourceReachesTable = True
                Exit Function
            End If
        End If
    Next dependencyKey
    If Len(detailText) = 0 Then detailText = "The editor RecordSource does not resolve through its saved-query dependency chain to the expected lookup table." & vbCrLf & "RecordSource: " & sourceName & vbCrLf & "Expected lookup table: " & targetTableName
    Exit Function
ErrHandler:
    detailText = "Could not prove the editor RecordSource dependency chain. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description & vbCrLf & "RecordSource: " & sourceName & vbCrLf & "Expected lookup table: " & targetTableName
End Function

Private Sub J1LookupEditorFieldSourceMetadata(ByVal fld As DAO.Field, ByRef sourceTableName As String, ByRef sourceFieldName As String)
    sourceTableName = vbNullString
    sourceFieldName = vbNullString
    On Error Resume Next
    sourceTableName = CStr(fld.properties("SourceTable").value)
    sourceFieldName = Trim$(CStr(fld.properties("SourceField").value))
    On Error GoTo 0
End Sub

Private Function J1LookupEditorQueryFieldReachesTableField(ByVal db As DAO.Database, ByVal sourceObjectName As String, ByVal outputFieldName As String, ByVal targetTableName As String, ByVal targetFieldName As String, ByVal visitedFields As Object) As Boolean
    On Error GoTo ErrHandler
    Dim lineageKey As String
    Dim qdf As DAO.queryDef
    Dim fld As DAO.Field
    Dim sourceTableName As String
    Dim sourceFieldName As String
    outputFieldName = Trim$(outputFieldName)
    If Len(sourceObjectName) = 0 Or Len(outputFieldName) = 0 Or Len(targetTableName) = 0 Or Len(targetFieldName) = 0 Then Exit Function
    If StrComp(sourceObjectName, targetTableName, vbTextCompare) = 0 Then
        J1LookupEditorQueryFieldReachesTableField = (StrComp(outputFieldName, targetFieldName, vbTextCompare) = 0)
        Exit Function
    End If
    If SharedDao_QueryExists(db, sourceObjectName) = False Then Exit Function
    lineageKey = UCase$(sourceObjectName & "|" & outputFieldName)
    If visitedFields.Exists(lineageKey) Then Exit Function
    visitedFields.Add lineageKey, True
    Set qdf = db.QueryDefs(sourceObjectName)
    On Error Resume Next
    Set fld = qdf.fields(outputFieldName)
    On Error GoTo ErrHandler
    If fld Is Nothing Then Exit Function
    J1LookupEditorFieldSourceMetadata fld, sourceTableName, sourceFieldName
    If Len(sourceFieldName) = 0 Then sourceFieldName = fld.Name
    If StrComp(sourceTableName, targetTableName, vbTextCompare) = 0 And StrComp(sourceFieldName, targetFieldName, vbTextCompare) = 0 Then
        J1LookupEditorQueryFieldReachesTableField = True
        Exit Function
    End If
    If Len(sourceTableName) > 0 Then J1LookupEditorQueryFieldReachesTableField = J1LookupEditorQueryFieldReachesTableField(db, sourceTableName, sourceFieldName, targetTableName, targetFieldName, visitedFields)
    Exit Function
ErrHandler:
    J1LookupEditorQueryFieldReachesTableField = False
End Function

Private Function J1LookupEditorRecordSourceExposesTableField(ByVal db As DAO.Database, ByVal rs As DAO.Recordset, ByVal recordSourceText As String, ByVal targetTableName As String, ByVal targetFieldName As String, ByRef exposedFieldName As String) As Boolean
    On Error GoTo ErrHandler
    Dim fld As DAO.Field
    Dim sourceTableName As String
    Dim sourceFieldName As String
    Dim visitedFields As Object
    exposedFieldName = vbNullString
    recordSourceText = Trim$(recordSourceText)
    targetFieldName = Trim$(targetFieldName)
    If Len(targetTableName) = 0 Or Len(targetFieldName) = 0 Then Exit Function
    If StrComp(recordSourceText, targetTableName, vbTextCompare) = 0 Then
        If SharedDao_RecordsetFieldExists(rs, targetFieldName) Then
            exposedFieldName = targetFieldName
            J1LookupEditorRecordSourceExposesTableField = True
            Exit Function
        End If
    End If
    Set visitedFields = CreateObject("Scripting.Dictionary")
    visitedFields.CompareMode = vbTextCompare
    For Each fld In rs.fields
        J1LookupEditorFieldSourceMetadata fld, sourceTableName, sourceFieldName
        If Len(sourceFieldName) = 0 Then sourceFieldName = fld.Name
        If StrComp(sourceTableName, targetTableName, vbTextCompare) = 0 And StrComp(sourceFieldName, targetFieldName, vbTextCompare) = 0 Then
            exposedFieldName = fld.Name
            J1LookupEditorRecordSourceExposesTableField = True
            Exit Function
        End If
        If Len(sourceTableName) > 0 Then
            If J1LookupEditorQueryFieldReachesTableField(db, sourceTableName, sourceFieldName, targetTableName, targetFieldName, visitedFields) Then
                exposedFieldName = fld.Name
                J1LookupEditorRecordSourceExposesTableField = True
                Exit Function
            End If
        ElseIf SharedDao_QueryExists(db, recordSourceText) Then
            If J1LookupEditorQueryFieldReachesTableField(db, recordSourceText, fld.Name, targetTableName, targetFieldName, visitedFields) Then
                exposedFieldName = fld.Name
                J1LookupEditorRecordSourceExposesTableField = True
                Exit Function
            End If
        End If
    Next fld
    Exit Function
ErrHandler:
    J1LookupEditorRecordSourceExposesTableField = False
End Function

Private Function J1LookupEditorQueryFieldReachesTable(ByVal db As DAO.Database, ByVal sourceObjectName As String, ByVal outputFieldName As String, ByVal targetTableName As String, ByVal visitedFields As Object) As Boolean
    On Error GoTo ErrHandler
    Dim lineageKey As String
    Dim qdf As DAO.queryDef
    Dim fld As DAO.Field
    Dim sourceTableName As String
    Dim sourceFieldName As String
    outputFieldName = Trim$(outputFieldName)
    If Len(sourceObjectName) = 0 Or Len(outputFieldName) = 0 Or Len(targetTableName) = 0 Then Exit Function
    If StrComp(sourceObjectName, targetTableName, vbTextCompare) = 0 Then
        J1LookupEditorQueryFieldReachesTable = True
        Exit Function
    End If
    If SharedDao_QueryExists(db, sourceObjectName) = False Then Exit Function
    lineageKey = UCase$(sourceObjectName & "|" & outputFieldName)
    If visitedFields.Exists(lineageKey) Then Exit Function
    visitedFields.Add lineageKey, True
    Set qdf = db.QueryDefs(sourceObjectName)
    On Error Resume Next
    Set fld = qdf.fields(outputFieldName)
    On Error GoTo ErrHandler
    If fld Is Nothing Then Exit Function
    J1LookupEditorFieldSourceMetadata fld, sourceTableName, sourceFieldName
    If Len(sourceFieldName) = 0 Then sourceFieldName = fld.Name
    If StrComp(sourceTableName, targetTableName, vbTextCompare) = 0 Then
        J1LookupEditorQueryFieldReachesTable = True
        Exit Function
    End If
    If Len(sourceTableName) > 0 Then J1LookupEditorQueryFieldReachesTable = J1LookupEditorQueryFieldReachesTable(db, sourceTableName, sourceFieldName, targetTableName, visitedFields)
    Exit Function
ErrHandler:
    J1LookupEditorQueryFieldReachesTable = False
End Function

Private Function J1LookupEditorRecordSourceHasDataUpdatableFieldFromTable(ByVal db As DAO.Database, ByVal rs As DAO.Recordset, ByVal recordSourceText As String, ByVal targetTableName As String, ByRef updatableFieldName As String) As Boolean
    On Error GoTo ErrHandler
    Dim fld As DAO.Field
    Dim fieldIsDataUpdatable As Boolean
    Dim sourceTableName As String
    Dim sourceFieldName As String
    Dim visitedFields As Object
    updatableFieldName = vbNullString
    recordSourceText = Trim$(recordSourceText)
    If Len(recordSourceText) = 0 Or Len(targetTableName) = 0 Then Exit Function
    For Each fld In rs.fields
        fieldIsDataUpdatable = False
        On Error Resume Next
        fieldIsDataUpdatable = CBool(fld.DataUpdatable)
        On Error GoTo ErrHandler
        If fieldIsDataUpdatable Then
            If StrComp(recordSourceText, targetTableName, vbTextCompare) = 0 Then
                updatableFieldName = fld.Name
                J1LookupEditorRecordSourceHasDataUpdatableFieldFromTable = True
                Exit Function
            End If
            J1LookupEditorFieldSourceMetadata fld, sourceTableName, sourceFieldName
            If Len(sourceFieldName) = 0 Then sourceFieldName = fld.Name
            If StrComp(sourceTableName, targetTableName, vbTextCompare) = 0 Then
                updatableFieldName = fld.Name
                J1LookupEditorRecordSourceHasDataUpdatableFieldFromTable = True
                Exit Function
            End If
            Set visitedFields = CreateObject("Scripting.Dictionary")
            visitedFields.CompareMode = vbTextCompare
            If Len(sourceTableName) > 0 Then
                If J1LookupEditorQueryFieldReachesTable(db, sourceTableName, sourceFieldName, targetTableName, visitedFields) Then
                    updatableFieldName = fld.Name
                    J1LookupEditorRecordSourceHasDataUpdatableFieldFromTable = True
                    Exit Function
                End If
            ElseIf SharedDao_QueryExists(db, recordSourceText) Then
                If J1LookupEditorQueryFieldReachesTable(db, recordSourceText, fld.Name, targetTableName, visitedFields) Then
                    updatableFieldName = fld.Name
                    J1LookupEditorRecordSourceHasDataUpdatableFieldFromTable = True
                    Exit Function
                End If
            End If
        End If
    Next fld
    Exit Function
ErrHandler:
    J1LookupEditorRecordSourceHasDataUpdatableFieldFromTable = False
End Function

Private Function J1ExistingManagedLookupEditorProof(ByVal db As DAO.Database, ByVal editorFormName As String, ByVal lookupSourcePhysicalName As String, ByVal codeFieldName As String, ByRef detailText As String) As Boolean
    On Error GoTo ErrHandler
    Dim actualRecordSource As String
    Dim visitedQueries As Object
    Dim rs As DAO.Recordset
    Dim sourceTdf As DAO.tableDef
    Dim exposedFieldName As String
    Dim dataUpdatableSourceFieldName As String
    detailText = vbNullString
    actualRecordSource = x__UTIL_ADC_UI_FORMS.GeneratedFormRecordSourceForLookupEditorProof(editorFormName)
    If Len(actualRecordSource) = 0 Then
        detailText = "The existing managed lookup editor has a blank physical RecordSource." & vbCrLf & "Editor form: " & editorFormName & vbCrLf & "Expected lookup table: " & lookupSourcePhysicalName
        Exit Function
    End If
    Set visitedQueries = CreateObject("Scripting.Dictionary")
    visitedQueries.CompareMode = vbTextCompare
    If J1LookupEditorRecordSourceReachesTable(db, actualRecordSource, lookupSourcePhysicalName, visitedQueries, detailText) = False Then
        detailText = "The existing managed lookup editor does not edit the expected lookup source." & vbCrLf & "Editor form: " & editorFormName & vbCrLf & "Expected lookup table: " & lookupSourcePhysicalName & vbCrLf & detailText
        Exit Function
    End If
    Set rs = db.OpenRecordset(actualRecordSource, dbOpenDynaset)
    If rs.Updatable = False Then
        detailText = "The existing managed lookup editor RecordSource is not updateable as a DAO dynaset." & vbCrLf & "Editor form: " & editorFormName & vbCrLf & "Expected lookup table: " & lookupSourcePhysicalName & vbCrLf & "RecordSource: " & actualRecordSource
        rs.Close
        Exit Function
    End If
    If J1LookupEditorRecordSourceHasDataUpdatableFieldFromTable(db, rs, actualRecordSource, lookupSourcePhysicalName, dataUpdatableSourceFieldName) = False Then
        detailText = "The existing managed lookup editor RecordSource does not expose any DataUpdatable field whose DAO source lineage reaches the expected lookup table." & vbCrLf & "Editor form: " & editorFormName & vbCrLf & "Expected lookup table: " & lookupSourcePhysicalName & vbCrLf & "RecordSource: " & actualRecordSource
        rs.Close
        Exit Function
    End If
    If Len(Trim$(codeFieldName)) > 0 Then
        If B2TryGetLocalTableDef(db, lookupSourcePhysicalName, sourceTdf) = False Then
            detailText = "The authoritative lookup source table could not be opened for key/code lineage proof." & vbCrLf & "Editor form: " & editorFormName & vbCrLf & "Expected lookup table: " & lookupSourcePhysicalName & vbCrLf & "Required source field: " & codeFieldName
            rs.Close
            Exit Function
        End If
        If SharedDao_TableDefFieldExistsSafe(sourceTdf, codeFieldName) = False Then
            detailText = "The authoritative lookup source table does not contain its configured key/code field." & vbCrLf & "Editor form: " & editorFormName & vbCrLf & "Expected lookup table: " & lookupSourcePhysicalName & vbCrLf & "Required source field: " & codeFieldName
            rs.Close
            Exit Function
        End If
        If J1LookupEditorRecordSourceExposesTableField(db, rs, actualRecordSource, lookupSourcePhysicalName, codeFieldName, exposedFieldName) = False Then
            detailText = "The existing managed lookup editor RecordSource does not expose the authoritative lookup key/code field through DAO source lineage." & vbCrLf & "Editor form: " & editorFormName & vbCrLf & "Expected lookup table: " & lookupSourcePhysicalName & vbCrLf & "Required source field: " & codeFieldName & vbCrLf & "RecordSource: " & actualRecordSource
            rs.Close
            Exit Function
        End If
    End If
    rs.Close
    J1ExistingManagedLookupEditorProof = True
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    detailText = "Could not prove the existing managed lookup editor source/updateability. Error " & CStr(savedErrNumber) & " from " & savedErrSource & ": " & savedErrDescription & vbCrLf & "Editor form: " & editorFormName & vbCrLf & "Expected lookup table: " & lookupSourcePhysicalName
End Function

Private Function J1ValidateEveryExistingManagedLookupEditorPolicy(ByVal db As DAO.Database, ByVal existingManagedProofMap As Object, ByRef provenCount As Long, ByRef detailText As String) As Boolean
    On Error GoTo ErrHandler
    Dim policyDefinition As Variant
    Dim sourceLogicalID As String
    Dim sourcePhysicalName As String
    Dim editorLogicalID As String
    Dim editorPhysicalName As String
    Dim editorExists As Boolean
    Dim proofDetail As String
    detailText = vbNullString
    For Each policyDefinition In LookupEditorPolicyDefinitions()
        If StrComp(CStr(policyDefinition(LOOKUP_EDITOR_DEF_POLICY)), LOOKUP_EDITOR_POLICY_EXISTING_MANAGED_FRM, vbTextCompare) = 0 Then
            sourceLogicalID = CStr(policyDefinition(LOOKUP_EDITOR_DEF_SOURCE_LOGICAL_ID))
            editorLogicalID = CStr(policyDefinition(LOOKUP_EDITOR_DEF_EDITOR_LOGICAL_ID))
            If Len(sourceLogicalID) = 0 Or Len(editorLogicalID) = 0 Then
                detailText = "An ExistingManagedFrm policy is missing its source or editor logical identity." & vbCrLf & "Source logical identity: " & sourceLogicalID & vbCrLf & "Editor logical identity: " & editorLogicalID
                Exit Function
            End If
            sourcePhysicalName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, sourceLogicalID)
            editorPhysicalName = ManagedObjectPhysicalName(NAMING_CATEGORY_GENERATED_FORM, editorLogicalID)
            If SharedDao_TableExists(db, sourcePhysicalName) = False Then
                detailText = "An ExistingManagedFrm policy resolves to a missing authoritative lookup source table." & vbCrLf & "Source logical identity: " & sourceLogicalID & vbCrLf & "Expected lookup table: " & sourcePhysicalName & vbCrLf & "Editor form: " & editorPhysicalName
                Exit Function
            End If
            If IsArray(GeneratedFormCatalogDefinition(editorPhysicalName)) = False Then
                detailText = "An ExistingManagedFrm policy resolves to an editor with no authoritative generated-form definition." & vbCrLf & "Source logical identity: " & sourceLogicalID & vbCrLf & "Editor logical identity: " & editorLogicalID & vbCrLf & "Editor form: " & editorPhysicalName
                Exit Function
            End If
            editorExists = SharedDao_AccessObjectExists(db, acForm, editorPhysicalName)
            If editorExists Then
                If existingManagedProofMap.Exists(sourceLogicalID) = False Then
                    proofDetail = vbNullString
                    If J1ExistingManagedLookupEditorProof(db, editorPhysicalName, sourcePhysicalName, CStr(policyDefinition(LOOKUP_EDITOR_DEF_CODE_FIELD)), proofDetail) = False Then
                        detailText = "Lookup-editor J1 proof found an invalid ExistingManagedFrm mapping." & vbCrLf & "Source logical identity: " & sourceLogicalID & vbCrLf & "Editor logical identity: " & editorLogicalID & vbCrLf & "Editor form: " & editorPhysicalName & vbCrLf & proofDetail
                        Exit Function
                    End If
                    existingManagedProofMap.Add sourceLogicalID, editorPhysicalName
                    provenCount = provenCount + 1
                End If
            Else
                detailText = "An ExistingManagedFrm policy resolves to a missing required editor form." & vbCrLf & "Source logical identity: " & sourceLogicalID & vbCrLf & "Editor logical identity: " & editorLogicalID & vbCrLf & "Expected physical form: " & editorPhysicalName
                Exit Function
            End If
        End If
    Next policyDefinition
    J1ValidateEveryExistingManagedLookupEditorPolicy = True
    Exit Function
ErrHandler:
    detailText = "Could not validate every ExistingManagedFrm lookup-editor policy. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description & IIf(Len(sourceLogicalID) > 0, vbCrLf & "Source logical identity: " & sourceLogicalID, vbNullString) & IIf(Len(editorPhysicalName) > 0, vbCrLf & "Editor form: " & editorPhysicalName, vbNullString)
End Function

' Purpose: Validates lookup editor integration for J1.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   detailText (Output; String): Receives diagnostic detail text used to explain validation, lookup, recovery, or failure results to the caller.
' Returns: Boolean: True on the function's affirmative/success branch for validate lookup editor integration for J1; False on its explicit negative, unavailable, rejected, or handled-failure branch.
'   not-applicable path.
Public Function ValidateLookupEditorIntegrationForJ1(ByRef detailText As String) As Boolean
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim planRows As Object
    Dim sourceEditorMap As Object
    Dim existingManagedProofMap As Object
    Dim tableKeys As Variant
    Dim tableIndex As Long
    Dim tableName As String
    Dim definitions As Collection
    Dim Definition As Variant
    Dim definitionKind As String
    Dim fieldName As String
    Dim sourcePhysicalName As String
    Dim sourceLogicalID As String
    Dim policyDefinition As Variant
    Dim policyCode As String
    Dim editorLogicalID As String
    Dim expectedEditorForm As String
    Dim actualEditorForm As String
    Dim actualAllowText As String
    Dim editorExists As Boolean
    Dim expectedEnabled As Boolean
    Dim tdf As DAO.tableDef
    Dim fld As DAO.Field
    Dim checkedLookupCount As Long
    Dim editorLookupCount As Long
    Dim noEditorLookupCount As Long
    Dim existingManagedEditorProofCount As Long
    detailText = vbNullString
    Set db = ResolveCatalogDb()
    Set planRows = B2SharedFieldMetadataPlan()
    Set sourceEditorMap = CreateObject("Scripting.Dictionary")
    sourceEditorMap.CompareMode = vbTextCompare
    Set existingManagedProofMap = CreateObject("Scripting.Dictionary")
    existingManagedProofMap.CompareMode = vbTextCompare
    tableKeys = planRows.keys
    B2SortTextArray tableKeys
    For tableIndex = LBound(tableKeys) To UBound(tableKeys)
        PumpSetupResponsiveness
        tableName = CStr(tableKeys(tableIndex))
        If B2TryGetLocalTableDef(db, tableName, tdf) = False Then
            detailText = "Lookup-editor J1 proof could not open an authoritative B2 metadata table." & vbCrLf & "Table: " & tableName
            Exit Function
        End If
        Set definitions = planRows.item(tableName)
        For Each Definition In definitions
            definitionKind = UCase$(CStr(Definition(0)))
            If definitionKind = UCase$(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_TABLE) Or definitionKind = UCase$(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_VALUE_LIST) Or definitionKind = UCase$(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_LIVE) Then
                fieldName = CStr(Definition(1))
                If SharedDao_TableDefFieldExistsSafe(tdf, fieldName) = False Then
                    detailText = "Lookup-editor J1 proof found a missing authoritative B2 lookup field." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName
                    Exit Function
                End If
                Set fld = tdf.fields(fieldName)
                expectedEnabled = False
                expectedEditorForm = vbNullString
                policyCode = LOOKUP_EDITOR_POLICY_NONE
                sourceLogicalID = vbNullString
                editorLogicalID = vbNullString
                If definitionKind = UCase$(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_TABLE) Then
                    sourcePhysicalName = CStr(Definition(2))
                    policyDefinition = LookupEditorPolicyForPhysicalSource(sourcePhysicalName)
                    policyCode = CStr(policyDefinition(LOOKUP_EDITOR_DEF_POLICY))
                    sourceLogicalID = CStr(policyDefinition(LOOKUP_EDITOR_DEF_SOURCE_LOGICAL_ID))
                    editorLogicalID = CStr(policyDefinition(LOOKUP_EDITOR_DEF_EDITOR_LOGICAL_ID))
                    expectedEditorForm = LookupEditorPhysicalFormNameForSource(sourcePhysicalName, policyCode)
                    If StrComp(policyCode, LOOKUP_EDITOR_POLICY_NONE, vbTextCompare) <> 0 Then
                        If Len(editorLogicalID) = 0 Or Len(expectedEditorForm) = 0 Then
                            detailText = "Lookup-editor J1 proof found an incomplete authoritative editor policy." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName & vbCrLf & "Source logical identity: " & sourceLogicalID & vbCrLf & "Policy: " & policyCode
                            Exit Function
                        End If
                        editorExists = SharedDao_AccessObjectExists(db, acForm, expectedEditorForm)
                        If editorExists = False Then
                            detailText = "Lookup-editor J1 proof found a missing physical editor form required by current policy." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName & vbCrLf & "Source logical identity: " & sourceLogicalID & vbCrLf & "Policy: " & policyCode & vbCrLf & "Editor logical identity: " & editorLogicalID & vbCrLf & "Expected physical form: " & expectedEditorForm
                            Exit Function
                        End If
                        expectedEnabled = editorExists
                        If sourceEditorMap.Exists(sourceLogicalID) Then
                            If StrComp(CStr(sourceEditorMap(sourceLogicalID)), expectedEditorForm, vbTextCompare) <> 0 Then
                                detailText = "Lookup-editor J1 proof found inconsistent editor resolution for a shared lookup source." & vbCrLf & "Source logical identity: " & sourceLogicalID & vbCrLf & "First editor: " & CStr(sourceEditorMap(sourceLogicalID)) & vbCrLf & "Current editor: " & expectedEditorForm
                                Exit Function
                            End If
                        Else
                            sourceEditorMap.Add sourceLogicalID, expectedEditorForm
                        End If
                    End If
                End If
                actualAllowText = DaoObjectPropertyFingerprintText(fld, "AllowValueListEdits")
                actualEditorForm = DaoObjectPropertyFingerprintText(fld, "ListItemsEditForm")
                If StrComp(actualEditorForm, "<missing>", vbTextCompare) = 0 Then actualEditorForm = vbNullString
                If expectedEnabled Then
                    If StrComp(actualAllowText, "True", vbTextCompare) <> 0 Or StrComp(Trim$(actualEditorForm), expectedEditorForm, vbTextCompare) <> 0 Then
                        detailText = "Lookup-editor J1 proof found field/editor metadata disagreement." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName & vbCrLf & "Source logical identity: " & sourceLogicalID & vbCrLf & "Policy: " & policyCode & vbCrLf & "Expected physical form: " & expectedEditorForm & vbCrLf & "Actual AllowValueListEdits: " & actualAllowText & vbCrLf & "Actual ListItemsEditForm: " & actualEditorForm
                        Exit Function
                    End If
                    editorLookupCount = editorLookupCount + 1
                Else
                    If StrComp(actualAllowText, "True", vbTextCompare) = 0 Or Len(Trim$(actualEditorForm)) > 0 Then
                        detailText = "Lookup-editor J1 proof found inappropriate native Edit List Items metadata." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName & vbCrLf & "Lookup kind: " & definitionKind & vbCrLf & "Policy: " & policyCode & vbCrLf & "Actual AllowValueListEdits: " & actualAllowText & vbCrLf & "Actual ListItemsEditForm: " & actualEditorForm
                        Exit Function
                    End If
                    noEditorLookupCount = noEditorLookupCount + 1
                End If
                checkedLookupCount = checkedLookupCount + 1
            End If
        Next Definition
        Set tdf = Nothing
    Next tableIndex
    If J1ValidateEveryExistingManagedLookupEditorPolicy(db, existingManagedProofMap, existingManagedEditorProofCount, detailText) = False Then Exit Function
    detailText = "Lookup-editor cross-domain field proof is current. Lookups checked=" & CStr(checkedLookupCount) & "; editor-backed fields=" & CStr(editorLookupCount) & "; ExistingManagedFrm policies proven editable=" & CStr(existingManagedEditorProofCount) & "; no-editor lookups=" & CStr(noEditorLookupCount) & "; shared sources=" & CStr(sourceEditorMap.count) & "."
    ValidateLookupEditorIntegrationForJ1 = True
    Exit Function
ErrHandler:
    detailText = "Could not validate lookup-editor integration for J1. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description & IIf(Len(tableName) > 0, vbCrLf & "Table: " & tableName, vbNullString) & IIf(Len(fieldName) > 0, vbCrLf & "Field: " & fieldName, vbNullString)
End Function

Private Function B2LookupEditorPolicyStateToken(ByVal db As DAO.Database, ByRef allRequiredRowsPresent As Boolean) As String
    On Error GoTo ErrHandler
    Dim tableName As String
    Dim rs As DAO.Recordset
    Dim policyDefinition As Variant
    Dim logicalID As String
    Dim fieldNames As Variant
    Dim fieldName As Variant
    Dim payloadText As String
    allRequiredRowsPresent = True
    tableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_LookupDefinitions")
    payloadText = FingerprintTokenPart(B2_LOOKUP_EDITOR_POLICY_CONTRACT)
    If SharedDao_TableExists(db, tableName) = False Then
        allRequiredRowsPresent = False
        B2LookupEditorPolicyStateToken = FingerprintFromPayload(payloadText & FingerprintTokenPart("<missing-table>"))
        Exit Function
    End If
    fieldNames = Array(FIELD_LOOKUP_LOGICAL_ID, FIELD_LOOKUP_DISPLAY_NAME, FIELD_LOOKUP_TABLE_NAME, FIELD_LOOKUP_EDITOR_FORM_NAME, FIELD_EDITOR_MODE, FIELD_ALLOW_ADDITIONS, FIELD_ALLOW_DELETIONS, FIELD_ALLOW_CODE_EDITS, FIELD_ALLOW_DISPLAY_NAME_EDITS, FIELD_ALLOW_DESCRIPTION_EDITS, FIELD_ALLOW_SORT_ORDER_EDITS, FIELD_ALLOW_ACTIVE_EDITS, FIELD_FINALIZED_ON, FIELD_FINALIZED_BY, FIELD_MANAGED_OBJECT_DEPENDENCY_NOTES)
    Set rs = db.OpenRecordset(tableName, dbOpenSnapshot)
    For Each policyDefinition In LookupEditorPolicyDefinitions()
        logicalID = CStr(policyDefinition(LOOKUP_EDITOR_DEF_SOURCE_LOGICAL_ID))
        payloadText = payloadText & FingerprintTokenPart("LookupLogicalID=" & logicalID)
        rs.FindFirst SQL_FIELD_LOOKUP_LOGICAL_ID & "='" & Replace(logicalID, "'", "''") & "'"
        If rs.NoMatch Then
            allRequiredRowsPresent = False
            payloadText = payloadText & FingerprintTokenPart("<missing-row>")
        Else
            For Each fieldName In fieldNames
                payloadText = payloadText & FingerprintTokenPart(CStr(fieldName))
                payloadText = payloadText & FingerprintTokenPart(CatalogFastPathValueText(rs.fields(CStr(fieldName)).value))
            Next fieldName
        End If
    Next policyDefinition
    rs.Close
    B2LookupEditorPolicyStateToken = FingerprintFromPayload(payloadText)
    Exit Function
ErrHandler:
    allRequiredRowsPresent = False
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    B2LookupEditorPolicyStateToken = vbNullString
End Function

Private Function B2LookupEditorPolicyProofMatches(ByVal db As DAO.Database, ByRef currentToken As String) As Boolean
    Dim allRequiredRowsPresent As Boolean
    Dim storedToken As String
    Dim propertyExists As Boolean
    storedToken = DatabaseTextPropertyValue(db, B2_LOOKUP_EDITOR_POLICY_PROOF_PROPERTY, propertyExists)
    If propertyExists = False Or Len(storedToken) = 0 Then Exit Function
    currentToken = B2LookupEditorPolicyStateToken(db, allRequiredRowsPresent)
    If allRequiredRowsPresent = False Or Len(currentToken) = 0 Then Exit Function
    B2LookupEditorPolicyProofMatches = (StrComp(storedToken, currentToken, vbBinaryCompare) = 0)
End Function

Private Sub RepairLookupEditorPolicyRowsForSetup(ByRef detailsForMessage As String)
    'B2 owns persistent lookup-editor intent rows. A2 owns only the physical ADC_LookupDefinitions table schema and persists a pending-field handoff when it introduces B2-owned columns into an existing registry. B2
    'initializes those exact fields canonically even when Access exposes a non-Null physical default; other existing non-Null persisted policy choices remain authoritative.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim policyDefinition As Variant
    Dim requiredBooleanFieldName As Variant
    Dim tableName As String
    Dim logicalID As String
    Dim expectedDisplayName As String
    Dim expectedTableName As String
    Dim expectedEditorFormName As String
    Dim editorModeText As String
    Dim insertedCount As Long
    Dim backfilledRowCount As Long
    Dim backfilledFieldCount As Long
    Dim verifiedCount As Long
    Dim rowBackfillRequired As Boolean
    Dim currentProofToken As String
    Dim pendingAddedFieldNames As String
    Dim pendingAddedFieldPropertyExists As Boolean
    Dim allRequiredRowsPresent As Boolean
    RequireSetupDomainMutationAllowed SETUP_DOMAIN_B2_CATALOG_REFERENCE_DEFAULTS, "RepairLookupEditorPolicyRowsForSetup"
    Set db = ResolveCatalogDb()
    tableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_LookupDefinitions")
    If SharedDao_TableExists(db, tableName) = False Then Err.Raise vbObjectError + 10012, "RepairLookupEditorPolicyRowsForSetup", "B2 requires the A2-owned lookup-definition registry table and does not repair A2." & vbCrLf & "Table: " & tableName
    pendingAddedFieldNames = DatabaseTextPropertyValue(db, A2_B2_LOOKUP_DEFINITION_PENDING_FIELDS_PROPERTY, pendingAddedFieldPropertyExists)
    If pendingAddedFieldPropertyExists = False Then
        If B2LookupEditorPolicyProofMatches(db, currentProofToken) Then
            detailsForMessage = "B2 persistent lookup-editor intent rows fast path: exact persisted proof matched current authoritative policy state; duplicate row repair/validation was skipped. Proof token=" & currentProofToken & "."
            Exit Sub
        End If
    End If
    Set rs = db.OpenRecordset(tableName, dbOpenDynaset)
    For Each policyDefinition In LookupEditorPolicyDefinitions()
        logicalID = CStr(policyDefinition(LOOKUP_EDITOR_DEF_SOURCE_LOGICAL_ID))
        expectedDisplayName = CStr(policyDefinition(LOOKUP_EDITOR_DEF_DISPLAY_NAME))
        expectedTableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, logicalID)
        expectedEditorFormName = ManagedObjectPhysicalName(NAMING_CATEGORY_GENERATED_FORM, CStr(policyDefinition(LOOKUP_EDITOR_DEF_EDITOR_LOGICAL_ID)))
        rs.FindFirst SQL_FIELD_LOOKUP_LOGICAL_ID & "='" & Replace(logicalID, "'", "''") & "'"
        If rs.NoMatch Then
            rs.AddNew
            rs.fields(FIELD_LOOKUP_LOGICAL_ID).value = logicalID
            rs.fields(FIELD_LOOKUP_DISPLAY_NAME).value = expectedDisplayName
            rs.fields(FIELD_LOOKUP_TABLE_NAME).value = expectedTableName
            rs.fields(FIELD_LOOKUP_EDITOR_FORM_NAME).value = expectedEditorFormName
            rs.fields(FIELD_EDITOR_MODE).value = "Editable"
            rs.fields(FIELD_ALLOW_ADDITIONS).value = CBool(policyDefinition(LOOKUP_EDITOR_DEF_ALLOW_ADDITIONS))
            rs.fields(FIELD_ALLOW_DELETIONS).value = CBool(policyDefinition(LOOKUP_EDITOR_DEF_ALLOW_DELETIONS))
            rs.fields(FIELD_ALLOW_CODE_EDITS).value = CBool(policyDefinition(LOOKUP_EDITOR_DEF_ALLOW_CODE_EDIT))
            rs.fields(FIELD_ALLOW_DISPLAY_NAME_EDITS).value = True
            rs.fields(FIELD_ALLOW_DESCRIPTION_EDITS).value = True
            rs.fields(FIELD_ALLOW_SORT_ORDER_EDITS).value = True
            rs.fields(FIELD_ALLOW_ACTIVE_EDITS).value = True
            rs.Update
            insertedCount = insertedCount + 1
        Else
            rowBackfillRequired = _
                B2LookupDefinitionFieldNeedsInitialization(rs, pendingAddedFieldNames, FIELD_LOOKUP_DISPLAY_NAME) Or _
                B2LookupDefinitionFieldNeedsInitialization(rs, pendingAddedFieldNames, FIELD_LOOKUP_TABLE_NAME) Or _
                B2LookupDefinitionFieldNeedsInitialization(rs, pendingAddedFieldNames, FIELD_LOOKUP_EDITOR_FORM_NAME) Or _
                B2LookupDefinitionFieldNeedsInitialization(rs, pendingAddedFieldNames, FIELD_EDITOR_MODE) Or _
                B2LookupDefinitionFieldNeedsInitialization(rs, pendingAddedFieldNames, FIELD_ALLOW_ADDITIONS) Or _
                B2LookupDefinitionFieldNeedsInitialization(rs, pendingAddedFieldNames, FIELD_ALLOW_DELETIONS) Or _
                B2LookupDefinitionFieldNeedsInitialization(rs, pendingAddedFieldNames, FIELD_ALLOW_CODE_EDITS) Or _
                B2LookupDefinitionFieldNeedsInitialization(rs, pendingAddedFieldNames, FIELD_ALLOW_DISPLAY_NAME_EDITS) Or _
                B2LookupDefinitionFieldNeedsInitialization(rs, pendingAddedFieldNames, FIELD_ALLOW_DESCRIPTION_EDITS) Or _
                B2LookupDefinitionFieldNeedsInitialization(rs, pendingAddedFieldNames, FIELD_ALLOW_SORT_ORDER_EDITS) Or _
                B2LookupDefinitionFieldNeedsInitialization(rs, pendingAddedFieldNames, FIELD_ALLOW_ACTIVE_EDITS)
            If rowBackfillRequired Then
                rs.Edit
                If B2LookupDefinitionFieldNeedsInitialization(rs, pendingAddedFieldNames, FIELD_LOOKUP_DISPLAY_NAME) Then rs.fields(FIELD_LOOKUP_DISPLAY_NAME).value = expectedDisplayName: backfilledFieldCount = backfilledFieldCount + 1
                If B2LookupDefinitionFieldNeedsInitialization(rs, pendingAddedFieldNames, FIELD_LOOKUP_TABLE_NAME) Then rs.fields(FIELD_LOOKUP_TABLE_NAME).value = expectedTableName: backfilledFieldCount = backfilledFieldCount + 1
                If B2LookupDefinitionFieldNeedsInitialization(rs, pendingAddedFieldNames, FIELD_LOOKUP_EDITOR_FORM_NAME) Then rs.fields(FIELD_LOOKUP_EDITOR_FORM_NAME).value = expectedEditorFormName: backfilledFieldCount = backfilledFieldCount + 1
                If B2LookupDefinitionFieldNeedsInitialization(rs, pendingAddedFieldNames, FIELD_EDITOR_MODE) Then rs.fields(FIELD_EDITOR_MODE).value = "Editable": backfilledFieldCount = backfilledFieldCount + 1
                If B2LookupDefinitionFieldNeedsInitialization(rs, pendingAddedFieldNames, FIELD_ALLOW_ADDITIONS) Then rs.fields(FIELD_ALLOW_ADDITIONS).value = CBool(policyDefinition(LOOKUP_EDITOR_DEF_ALLOW_ADDITIONS)): backfilledFieldCount = backfilledFieldCount + 1
                If B2LookupDefinitionFieldNeedsInitialization(rs, pendingAddedFieldNames, FIELD_ALLOW_DELETIONS) Then rs.fields(FIELD_ALLOW_DELETIONS).value = CBool(policyDefinition(LOOKUP_EDITOR_DEF_ALLOW_DELETIONS)): backfilledFieldCount = backfilledFieldCount + 1
                If B2LookupDefinitionFieldNeedsInitialization(rs, pendingAddedFieldNames, FIELD_ALLOW_CODE_EDITS) Then rs.fields(FIELD_ALLOW_CODE_EDITS).value = CBool(policyDefinition(LOOKUP_EDITOR_DEF_ALLOW_CODE_EDIT)): backfilledFieldCount = backfilledFieldCount + 1
                If B2LookupDefinitionFieldNeedsInitialization(rs, pendingAddedFieldNames, FIELD_ALLOW_DISPLAY_NAME_EDITS) Then rs.fields(FIELD_ALLOW_DISPLAY_NAME_EDITS).value = True: backfilledFieldCount = backfilledFieldCount + 1
                If B2LookupDefinitionFieldNeedsInitialization(rs, pendingAddedFieldNames, FIELD_ALLOW_DESCRIPTION_EDITS) Then rs.fields(FIELD_ALLOW_DESCRIPTION_EDITS).value = True: backfilledFieldCount = backfilledFieldCount + 1
                If B2LookupDefinitionFieldNeedsInitialization(rs, pendingAddedFieldNames, FIELD_ALLOW_SORT_ORDER_EDITS) Then rs.fields(FIELD_ALLOW_SORT_ORDER_EDITS).value = True: backfilledFieldCount = backfilledFieldCount + 1
                If B2LookupDefinitionFieldNeedsInitialization(rs, pendingAddedFieldNames, FIELD_ALLOW_ACTIVE_EDITS) Then rs.fields(FIELD_ALLOW_ACTIVE_EDITS).value = True: backfilledFieldCount = backfilledFieldCount + 1
                rs.Update
                backfilledRowCount = backfilledRowCount + 1
            End If
        End If
        rs.FindFirst SQL_FIELD_LOOKUP_LOGICAL_ID & "='" & Replace(logicalID, "'", "''") & "'"
        If rs.NoMatch Then Err.Raise vbObjectError + 10013, "RepairLookupEditorPolicyRowsForSetup", "B2 could not establish a required lookup-editor policy row." & vbCrLf & "LookupLogicalID: " & logicalID
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_LOOKUP_DISPLAY_NAME).value, vbNullString)))) = 0 Then Err.Raise vbObjectError + 10026, "RepairLookupEditorPolicyRowsForSetup", "B2 lookup-editor policy validation found a missing required text value." & vbCrLf & "LookupLogicalID: " & logicalID & vbCrLf & "Field: LookupDisplayName"
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_LOOKUP_TABLE_NAME).value, vbNullString)))) = 0 Then Err.Raise vbObjectError + 10026, "RepairLookupEditorPolicyRowsForSetup", "B2 lookup-editor policy validation found a missing required text value." & vbCrLf & "LookupLogicalID: " & logicalID & vbCrLf & "Field: LookupTableName"
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_LOOKUP_EDITOR_FORM_NAME).value, vbNullString)))) = 0 Then Err.Raise vbObjectError + 10026, "RepairLookupEditorPolicyRowsForSetup", "B2 lookup-editor policy validation found a missing required text value." & vbCrLf & "LookupLogicalID: " & logicalID & vbCrLf & "Field: LookupEditorFormName"
        If IsNull(rs.fields(FIELD_EDITOR_MODE).value) Then Err.Raise vbObjectError + 10027, "RepairLookupEditorPolicyRowsForSetup", "B2 lookup-editor policy validation found a missing EditorMode." & vbCrLf & "LookupLogicalID: " & logicalID
        editorModeText = Trim$(CStr(rs.fields(FIELD_EDITOR_MODE).value))
        If StrComp(editorModeText, "Editable", vbTextCompare) <> 0 And StrComp(editorModeText, "ReadOnly", vbTextCompare) <> 0 Then Err.Raise vbObjectError + 10027, "RepairLookupEditorPolicyRowsForSetup", "B2 lookup-editor policy validation found an invalid EditorMode." & vbCrLf & "LookupLogicalID: " & logicalID & vbCrLf & "EditorMode: " & editorModeText
        For Each requiredBooleanFieldName In Array(FIELD_ALLOW_ADDITIONS, FIELD_ALLOW_DELETIONS, FIELD_ALLOW_CODE_EDITS, FIELD_ALLOW_DISPLAY_NAME_EDITS, FIELD_ALLOW_DESCRIPTION_EDITS, FIELD_ALLOW_SORT_ORDER_EDITS, FIELD_ALLOW_ACTIVE_EDITS)
            If IsNull(rs.fields(CStr(requiredBooleanFieldName)).value) Then Err.Raise vbObjectError + 10028, "RepairLookupEditorPolicyRowsForSetup", "B2 lookup-editor policy validation found a missing required Boolean value." & vbCrLf & "LookupLogicalID: " & logicalID & vbCrLf & "Field: " & CStr(requiredBooleanFieldName)
        Next requiredBooleanFieldName
        verifiedCount = verifiedCount + 1
    Next policyDefinition
    rs.Close
    Set rs = Nothing
    currentProofToken = B2LookupEditorPolicyStateToken(db, allRequiredRowsPresent)
    If allRequiredRowsPresent = False Or Len(currentProofToken) = 0 Then Err.Raise vbObjectError + 10025, "RepairLookupEditorPolicyRowsForSetup", "B2 could not prove the complete persistent lookup-editor policy state after repair."
    If pendingAddedFieldPropertyExists Then EnsureDatabasePropertyRemoved db, A2_B2_LOOKUP_DEFINITION_PENDING_FIELDS_PROPERTY, "RepairLookupEditorPolicyRowsForSetup"
    Call EnsureDaoPropertyValue(db, B2_LOOKUP_EDITOR_POLICY_PROOF_PROPERTY, dbText, currentProofToken, "RepairLookupEditorPolicyRowsForSetup")
    detailsForMessage = "B2 persistent lookup-editor intent rows: inserted=" & CStr(insertedCount) & "; existing rows backfilled=" & CStr(backfilledRowCount) & "; required fields initialized=" & CStr(backfilledFieldCount) & "; A2 pending fields consumed=" & IIf(pendingAddedFieldPropertyExists, IIf(Len(pendingAddedFieldNames) = 0, "(empty)", pendingAddedFieldNames), "none") & "; required rows validated=" & CStr(verifiedCount) & "; proof token=" & currentProofToken & ". Existing non-pending non-Null persisted policy values were preserved."
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    Err.Raise savedErrNumber, "RepairLookupEditorPolicyRowsForSetup", "Could not establish the B2-owned persistent lookup-editor policy rows." & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Sub

Private Function B2LookupDefinitionFieldPendingInitialization(ByVal pendingFieldNames As String, ByVal fieldName As String) As Boolean
    'Tests the exact persisted A2->B2 pending-field handoff; field names are delimited to prevent partial-name matches.
    If Len(fieldName) = 0 Or Len(pendingFieldNames) = 0 Then Exit Function
    B2LookupDefinitionFieldPendingInitialization = (InStr(1, "|" & pendingFieldNames & "|", "|" & fieldName & "|", vbTextCompare) > 0)
End Function

Private Function B2LookupDefinitionFieldNeedsInitialization(ByVal rs As DAO.Recordset, ByVal pendingFieldNames As String, ByVal fieldName As String) As Boolean
    'A pending A2 field must receive its canonical B2 value regardless of the physical default exposed by Access; a non-pending field is repaired only when its required persisted value is Null.
    B2LookupDefinitionFieldNeedsInitialization = B2LookupDefinitionFieldPendingInitialization(pendingFieldNames, fieldName) Or IsNull(rs.fields(fieldName).value)
End Function

Private Sub RepairSharedFieldMetadataForSetup(ByRef detailsForMessage As String)
    'B2 owns non-form-dependent lookup/caption metadata and persistent editor intent. D4 exclusively owns the physical field-to-editor binding; A4 retains its explicitly owned Reference-family lookup presentation
    'properties.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim planRows As Object
    Dim definitions As Collection
    Dim dependencyRows As Object
    Dim tableKeys As Variant
    Dim tableIndex As Long
    Dim currentTableName As String
    Dim tdf As DAO.tableDef
    Dim currentToken As String
    Dim payloadText As String
    Dim tableFieldsPresent As Boolean
    Dim allDependenciesPresent As Boolean
    Dim allInputsPresent As Boolean
    Dim tablesProcessed As Long
    Dim tablesMissing As Long
    Dim changedCount As Long
    Dim warningCount As Long
    detailsForMessage = vbNullString
    Set db = ResolveCatalogDb()
    db.TableDefs.Refresh
    Set planRows = B2SharedFieldMetadataPlan()
    If B2SharedFieldMetadataProofMatches(db, planRows, currentToken) Then
        detailsForMessage = "B2 shared field-metadata fast path: Used" & vbCrLf & "Planned tables: " & CStr(planRows.count) & vbCrLf & "Proof token: " & currentToken
        Exit Sub
    End If
    ' INTENTIONAL KEYED LOOKUP: dependencyRows provides keyed membership/lookup over source rows or state already read by RepairSharedFieldMetadataForSetup; it is a derived access path, not a second authority.
    Set dependencyRows = CreateObject("Scripting.Dictionary")
    dependencyRows.CompareMode = vbTextCompare
    payloadText = FingerprintTokenPart(B2_SHARED_FIELD_METADATA_CONTRACT)
    allInputsPresent = True
    tableKeys = planRows.keys
    B2SortTextArray tableKeys
    For tableIndex = LBound(tableKeys) To UBound(tableKeys)
        currentTableName = CStr(tableKeys(tableIndex))
        Set definitions = planRows.item(currentTableName)
        payloadText = payloadText & B2MetadataDefinitionPayload(currentTableName, definitions, dependencyRows)
        If B2TryGetLocalTableDef(db, currentTableName, tdf) Then
            changedCount = changedCount + ApplyB2SharedFieldMetadataDefinitionCollectionToTableDef(tdf, definitions, warningCount, True)
            payloadText = payloadText & B2MetadataFieldStatePayload(tdf, definitions, tableFieldsPresent)
            If tableFieldsPresent = False Then allInputsPresent = False
            tablesProcessed = tablesProcessed + 1
            Set tdf = Nothing
        Else
            payloadText = payloadText & FingerprintTokenPart("<missing-table>")
            tablesMissing = tablesMissing + 1
            allInputsPresent = False
        End If
    Next tableIndex
    payloadText = payloadText & FingerprintTokenPart("ExactDependencies")
    payloadText = payloadText & B2MetadataDependencyPayload(db, dependencyRows, allDependenciesPresent)
    If allDependenciesPresent = False Then allInputsPresent = False
    currentToken = FingerprintFromPayload(payloadText)
    PersistB2SharedFieldMetadataProofToken db, currentToken, allInputsPresent
    detailsForMessage = "B2 shared field-metadata path: Applied" & vbCrLf & "Planned tables: " & CStr(planRows.count) & vbCrLf & "Tables processed once: " & CStr(tablesProcessed) & vbCrLf & "B2-local TableDefs opened: " & CStr(tablesProcessed) & vbCrLf & "Lookup properties changed: " & CStr(changedCount) & vbCrLf & "Lookup warnings: " & CStr(warningCount) & vbCrLf & "Missing planned tables: " & CStr(tablesMissing) & vbCrLf & "Proof token: " & currentToken
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    Set tdf = Nothing
    On Error GoTo 0
    Err.Raise savedErrNumber, "RepairSharedFieldMetadataForSetup", "Could not apply the consolidated B2 field-metadata pass." & vbCrLf & "Table: " & IIf(Len(currentTableName) = 0, "(not opened)", currentTableName) & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Sub

Private Sub InitializeFieldDescriptionSameRunProofMap()
    Dim currentDatabase As String
    Dim currentTraceRunID As String
    currentDatabase = LCase$(Trim$(ResolveCatalogDb().Name))
    currentTraceRunID = CatalogSetupTraceIdentity()
    If Not mFieldDescriptionSameRunProofByTable Is Nothing Then
        If StrComp(currentDatabase, mFieldDescriptionSameRunProofDatabase, vbBinaryCompare) = 0 And StrComp(currentTraceRunID, mFieldDescriptionSameRunProofTraceRunID, vbBinaryCompare) = 0 Then Exit Sub
    End If
    Set mFieldDescriptionSameRunProofByTable = CreateObject("Scripting.Dictionary")
    mFieldDescriptionSameRunProofByTable.CompareMode = vbTextCompare
    mFieldDescriptionSameRunProofDatabase = currentDatabase
    mFieldDescriptionSameRunProofTraceRunID = currentTraceRunID
    mFieldDescriptionSameRunProofBypassCount = 0
    mFieldDescriptionSameRunFieldsBypassed = 0
End Sub

Private Sub PublishFieldDescriptionSameRunProof(ByVal tableName As String, ByVal completedProof As String, ByVal fieldCount As Long)
    Dim proofEntry As Variant
    InitializeFieldDescriptionSameRunProofMap
    proofEntry = Array(completedProof, fieldCount)
    mFieldDescriptionSameRunProofByTable(tableName) = proofEntry
End Sub

Private Function TryFieldDescriptionSameRunProof(ByVal tableName As String, ByRef completedProof As String, ByRef fieldCount As Long, Optional ByVal expectedProofHeader As String = vbNullString) As Boolean
    Dim proofEntry As Variant
    InitializeFieldDescriptionSameRunProofMap
    If mFieldDescriptionSameRunProofByTable.Exists(tableName) = False Then Exit Function
    proofEntry = mFieldDescriptionSameRunProofByTable(tableName)
    completedProof = CStr(proofEntry(0))
    fieldCount = CLng(proofEntry(1))
    If Len(completedProof) = 0 Or fieldCount < 0 Then Exit Function
    If Len(expectedProofHeader) > 0 Then
        If FieldDescriptionProofMatchesHeader(completedProof, expectedProofHeader) = False Then Exit Function
    End If
    mFieldDescriptionSameRunProofBypassCount = mFieldDescriptionSameRunProofBypassCount + 1
    mFieldDescriptionSameRunFieldsBypassed = mFieldDescriptionSameRunFieldsBypassed + fieldCount
    TryFieldDescriptionSameRunProof = True
End Function

Private Function FieldDescriptionProofPropertyName(ByVal tableName As String) As String
    FieldDescriptionProofPropertyName = FIELD_DESCRIPTION_PROOF_PROPERTY_PREFIX & Left$(StableTextHashHex(UCase$(tableName)), 16)
End Function

Private Sub InitializeFieldDescriptionProofCache()
    Dim traceID As String
    Dim db As DAO.Database
    Dim prp As DAO.Property
    traceID = CatalogSetupTraceIdentity()
    If Not mFieldDescriptionProofCache Is Nothing Then
        If StrComp(traceID, mFieldDescriptionProofTraceRunID, vbBinaryCompare) = 0 Then Exit Sub
    End If
    Set mFieldDescriptionProofCache = CreateObject("Scripting.Dictionary")
    mFieldDescriptionProofCache.CompareMode = vbTextCompare
    Set db = ResolveCatalogDb()
    For Each prp In db.properties
        If Left$(prp.Name, Len(FIELD_DESCRIPTION_PROOF_PROPERTY_PREFIX)) = FIELD_DESCRIPTION_PROOF_PROPERTY_PREFIX Then
            On Error Resume Next
            mFieldDescriptionProofCache(prp.Name) = CStr(prp.value)
            Err.Clear
            On Error GoTo 0
        End If
    Next prp
    mFieldDescriptionProofTraceRunID = traceID
End Sub

Private Function FieldDescriptionProofText(ByVal tdf As DAO.tableDef, ByVal descriptionShortIndex As Object, ByRef fieldCount As Long, ByRef canonicalFieldOrderText As String, Optional ByVal allowDefaultDescriptionFallback As Boolean = False) As String
    Dim schemaText As String
    Dim authorityText As String
    Dim descriptionText As String
    Dim fieldName As String
    Dim fieldNames As Variant
    Dim fieldNameValue As Variant
    Dim physicalFieldIndex As Long
    canonicalFieldOrderText = CanonicalTableFieldOrderText(tdf.Name)
    If Len(canonicalFieldOrderText) > 0 Then
        fieldNames = Split(canonicalFieldOrderText, "|")
        fieldCount = UBound(fieldNames) - LBound(fieldNames) + 1
        schemaText = UCase$(tdf.Name) & "|" & Format$(CDbl(tdf.LastUpdated), "0.000000000000000") & "|CANONICAL|" & UCase$(canonicalFieldOrderText) & "|" & CStr(fieldCount)
    Else
        fieldCount = tdf.fields.count
        ReDim fieldNames(0 To fieldCount - 1)
        For physicalFieldIndex = 0 To fieldCount - 1
            fieldNames(physicalFieldIndex) = tdf.fields(physicalFieldIndex).Name
        Next physicalFieldIndex
        schemaText = UCase$(tdf.Name) & "|" & Format$(CDbl(tdf.LastUpdated), "0.000000000000000") & "|PHYSICAL|" & CStr(fieldCount)
    End If
    For Each fieldNameValue In fieldNames
        fieldName = CStr(fieldNameValue)
        descriptionText = ResolveManagedTableFieldDescriptionShort(tdf.Name, fieldName, descriptionShortIndex, allowDefaultDescriptionFallback:=allowDefaultDescriptionFallback)
        authorityText = authorityText & LengthPrefixedVariant(fieldName) & LengthPrefixedVariant(descriptionText)
    Next fieldNameValue
    FieldDescriptionProofText = FIELD_DESCRIPTION_PROOF_VERSION & "|" & FingerprintFromPayload(schemaText) & "|" & FingerprintFromPayload(authorityText) & "|" & CStr(fieldCount)
End Function

Private Function FieldDescriptionProofResultTokenIsValid(ByVal resultToken As String) As Boolean
    Dim characterIndex As Long
    Dim separatorPosition As Long
    Dim expectedHashLength As Long
    Dim hashText As String
    Dim lengthText As String
    expectedHashLength = Len(StableTextHashHex(vbNullString))
    separatorPosition = InStr(1, resultToken, ":", vbBinaryCompare)
    If separatorPosition <> expectedHashLength + 1 Then Exit Function
    If InStr(separatorPosition + 1, resultToken, ":", vbBinaryCompare) > 0 Then Exit Function
    hashText = Left$(resultToken, separatorPosition - 1)
    lengthText = Mid$(resultToken, separatorPosition + 1)
    If Len(hashText) <> expectedHashLength Or Len(lengthText) = 0 Then Exit Function
    For characterIndex = 1 To Len(hashText)
        If InStr(1, "0123456789ABCDEF", Mid$(hashText, characterIndex, 1), vbBinaryCompare) = 0 Then Exit Function
    Next characterIndex
    For characterIndex = 1 To Len(lengthText)
        If InStr(1, "0123456789", Mid$(lengthText, characterIndex, 1), vbBinaryCompare) = 0 Then Exit Function
    Next characterIndex
    FieldDescriptionProofResultTokenIsValid = True
End Function

Private Function FieldDescriptionProofMatchesHeader(ByVal storedProof As String, ByVal proofHeader As String) As Boolean
    Dim requiredPrefix As String
    Dim resultToken As String
    requiredPrefix = proofHeader & "|"
    If Len(storedProof) <= Len(requiredPrefix) + Len("|Verified") Then Exit Function
    If StrComp(Left$(storedProof, Len(requiredPrefix)), requiredPrefix, vbBinaryCompare) <> 0 Then Exit Function
    If StrComp(Right$(storedProof, Len("|Verified")), "|Verified", vbBinaryCompare) <> 0 Then Exit Function
    resultToken = Mid$(storedProof, Len(requiredPrefix) + 1, Len(storedProof) - Len(requiredPrefix) - Len("|Verified"))
    FieldDescriptionProofMatchesHeader = FieldDescriptionProofResultTokenIsValid(resultToken)
End Function

Private Function CompletedFieldDescriptionProofText(ByVal proofHeader As String, ByVal physicalResultText As String) As String
    CompletedFieldDescriptionProofText = proofHeader & "|" & FingerprintFromPayload(physicalResultText) & "|Verified"
End Function

Private Sub ApplyDefaultsOwnedLookupDefinitionsToTableDef(ByVal tdf As DAO.tableDef)
    If SetupDomainMutationWritesAllowedForCurrentPart(SETUP_DOMAIN_B2_CATALOG_REFERENCE_DEFAULTS) = False Then Err.Raise vbObjectError + 9626, "ApplyDefaultsOwnedLookupDefinitionsToTableDef", "Shared lookup/caption metadata mutation is owned by B2 during numbered Setup." & vbCrLf & "Table: " & tdf.Name
    Dim definitions As Collection
    Dim Definition As Variant
    Dim definitionKind As String
    Set definitions = CatalogFieldLookupDefinitions(tdf.Name)
    For Each Definition In definitions
        If SharedDao_TableDefFieldExistsSafe(tdf, CStr(Definition(1))) Then
            definitionKind = UCase$(CStr(Definition(0)))
            Select Case definitionKind
                Case UCase$(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_VALUE_LIST)
                    Call EnsureFieldValueListLookup(tdf, CStr(Definition(1)), CStr(Definition(2)), CLng(Definition(7)), CBool(Definition(5)))
                Case UCase$(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_TABLE)
                    Call EnsureCatalogLookupField(tdf, CStr(Definition(1)), CStr(Definition(2)), CStr(Definition(3)), CStr(Definition(4)), CBool(Definition(5)), CStr(Definition(8)))
                Case UCase$(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_LIVE)
                    Call EnsureLiveObjectLookupField(tdf, CStr(Definition(1)), CStr(Definition(2)), CBool(Definition(5)), CLng(Definition(6)), CLng(Definition(7)), CStr(Definition(8)))
                Case Else
                    Err.Raise vbObjectError + 7352, "ApplyDefaultsOwnedLookupDefinitionsToTableDef", "Unknown " & DEFAULT_UTILITY_SHORT_NAME & " lookup-definition kind." & vbCrLf & "Table: " & tdf.Name & vbCrLf & "Kind: " & definitionKind
            End Select
        End If
    Next Definition
End Sub

Private Sub ApplyDefaultsOwnedLookupDefinitions(ByVal tableName As String)
    Dim db As DAO.Database
    Dim tdf As DAO.tableDef
    If mB1StructureOnly Then Exit Sub
    Set db = ResolveCatalogDb()
    Set tdf = db.TableDefs(tableName)
    Call ApplyDefaultsOwnedLookupDefinitionsToTableDef(tdf)
End Sub

Private Sub PersistManagedTableFieldDescriptionExactState(ByVal db As DAO.Database, ByVal catalogToken As String, ByVal exactToken As String)
    On Error GoTo OptionalStateUnavailable
    Call EnsureDaoPropertyValue(db, MANAGED_TABLE_FIELD_DESCRIPTION_CATALOG_TOKEN_PROPERTY, dbText, catalogToken, "PersistManagedTableFieldDescriptionExactState")
    Call EnsureDaoPropertyValue(db, MANAGED_TABLE_FIELD_DESCRIPTION_PHYSICAL_TOKEN_PROPERTY, dbText, MANAGED_TABLE_FIELD_DESCRIPTION_PROOF_AGGREGATE_VERSION & "|" & exactToken, "PersistManagedTableFieldDescriptionExactState")
    Call EnsureDaoPropertyValue(db, MANAGED_TABLE_FIELD_DESCRIPTION_EXACT_TOKEN_PROPERTY, dbText, exactToken, "PersistManagedTableFieldDescriptionExactState")
    Exit Sub
OptionalStateUnavailable:
    AddTraceNote "Optional managed-table field-description proof aggregate could not be persisted; later setup will use per-table proof verification. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
    Err.Clear
End Sub

' Purpose: Finalizes managed table field description proof after G1 description work.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   exactToken (Output; String): Receives the exact token returned by `CatalogHashToken` after this procedure completes its validation/resolution work.
'   detailText (Output; String): Receives diagnostic detail text used to explain validation, lookup, recovery, or failure results to the caller.
' Returns: Boolean: True on the function's affirmative/success branch for finalize managed table field description proof after G1 description work; False on its explicit negative, unavailable, rejected, or
'     handled-failure branch.
'   cancellation, rejection, or not-applicable path.
Public Function FinalizeManagedTableFieldDescriptionProofAfterG1DescriptionWork(ByRef exactToken As String, ByRef detailText As String) As Boolean
    ' MOC-owned G1 proof finalization: rebinds already-proven field-description results to the final post-description TableDef metadata without rescanning fields. Every present table must have a same-run G1
    ' field proof, and the field count must remain unchanged.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim tdf As DAO.tableDef
    Dim sqlText As String
    Dim tableName As String
    Dim optionalReason As String
    Dim priorProof As String
    Dim reboundProof As String
    Dim proofHeader As String
    Dim proofPropertyName As String
    Dim proofBody As String
    Dim resultToken As String
    Dim canonicalFieldOrderText As String
    Dim currentCatalogToken As String
    Dim activeTraceRunID As String
    Dim separatorPosition As Long
    Dim priorFieldCount As Long
    Dim currentFieldCount As Long
    Dim tableCount As Long
    Dim optionalAbsentCount As Long
    Dim reboundTableCount As Long
    Dim state As CatalogHashState
    Dim descriptionShortIndex As Object
    exactToken = vbNullString
    detailText = vbNullString
    Set db = ResolveCatalogDb()
    Set descriptionShortIndex = BuildManagedTableFieldDescriptionShortIndex(db)
    InitializeFieldDescriptionSameRunProofMap
    InitializeFieldDescriptionProofCache
    CatalogHashInitialize state
    CatalogHashAppendText state, MANAGED_TABLE_FIELD_DESCRIPTION_PROOF_AGGREGATE_VERSION & "|"
    sqlText = "SELECT DISTINCT " & SQL_FIELD_OBJECT_NAME & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] WHERE Nz([" & FIELD_MANAGED_OBJECT_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))='TABLE' ORDER BY " & SQL_FIELD_OBJECT_NAME & ";"
    Set rs = db.OpenRecordset(sqlText, dbOpenSnapshot)
    Do While rs.EOF = False
        tableName = CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString))
        If Len(Trim$(tableName)) > 0 Then
            tableCount = tableCount + 1
            If SharedDao_DatabaseTableExistsSafe(db, tableName) = False Then
                optionalReason = ManagedTableOptionalMissingReason(db, tableName)
                If Len(optionalReason) = 0 Then Err.Raise vbObjectError + 6791, "FinalizeManagedTableFieldDescriptionProofAfterG1DescriptionWork", "A required active managed table is missing during final G1 field-proof binding." & vbCrLf & "Table: " & tableName
                optionalAbsentCount = optionalAbsentCount + 1
                CatalogHashAppendText state, FingerprintTokenPart(tableName)
                CatalogHashAppendText state, FingerprintTokenPart("OptionalAbsent:" & optionalReason)
            Else
                priorProof = vbNullString
                priorFieldCount = 0
                If TryFieldDescriptionSameRunProof(tableName, priorProof, priorFieldCount) = False Then Err.Raise vbObjectError + 6792, "FinalizeManagedTableFieldDescriptionProofAfterG1DescriptionWork", "A present managed table does not have the required same-run G1 field-description proof." & vbCrLf & "Table: " & tableName
                Set tdf = db.TableDefs(tableName)
                currentFieldCount = 0
                canonicalFieldOrderText = vbNullString
                proofHeader = FieldDescriptionProofText(tdf, descriptionShortIndex, currentFieldCount, canonicalFieldOrderText)
                If currentFieldCount <> priorFieldCount Then Err.Raise vbObjectError + 6793, "FinalizeManagedTableFieldDescriptionProofAfterG1DescriptionWork", "A managed table field count changed after its same-run G1 field-description proof was established." & vbCrLf & "Table: " & tableName & vbCrLf & "Proven field count: " & CStr(priorFieldCount) & vbCrLf & "Current field count: " & CStr(currentFieldCount)
                If Len(priorProof) <= Len("|Verified") Then Err.Raise vbObjectError + 6794, "FinalizeManagedTableFieldDescriptionProofAfterG1DescriptionWork", "The same-run G1 field-description proof is too short to contain a valid completion suffix." & vbCrLf & "Table: " & tableName
                If StrComp(Right$(priorProof, Len("|Verified")), "|Verified", vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 6794, "FinalizeManagedTableFieldDescriptionProofAfterG1DescriptionWork", "The same-run G1 field-description proof has an invalid completion suffix." & vbCrLf & "Table: " & tableName
                proofBody = Left$(priorProof, Len(priorProof) - Len("|Verified"))
                separatorPosition = InStrRev(proofBody, "|", -1, vbBinaryCompare)
                If separatorPosition <= 0 Then Err.Raise vbObjectError + 6795, "FinalizeManagedTableFieldDescriptionProofAfterG1DescriptionWork", "The same-run G1 field-description proof does not contain a physical result token." & vbCrLf & "Table: " & tableName
                resultToken = Mid$(proofBody, separatorPosition + 1)
                If FieldDescriptionProofResultTokenIsValid(resultToken) = False Then Err.Raise vbObjectError + 6796, "FinalizeManagedTableFieldDescriptionProofAfterG1DescriptionWork", "The same-run G1 field-description physical result token is invalid." & vbCrLf & "Table: " & tableName
                reboundProof = proofHeader & "|" & resultToken & "|Verified"
                proofPropertyName = FieldDescriptionProofPropertyName(tdf.Name)
                If StrComp(priorProof, reboundProof, vbBinaryCompare) <> 0 Then
                    Call EnsureDaoPropertyValue(db, proofPropertyName, dbText, reboundProof, "FinalizeManagedTableFieldDescriptionProofAfterG1DescriptionWork")
                    reboundTableCount = reboundTableCount + 1
                End If
                mFieldDescriptionProofCache(proofPropertyName) = reboundProof
                PublishFieldDescriptionSameRunProof tdf.Name, reboundProof, currentFieldCount
                CatalogHashAppendText state, FingerprintTokenPart(tableName)
                CatalogHashAppendText state, FingerprintTokenPart(reboundProof)
            End If
        End If
        If tableCount = 1 Or tableCount Mod 25 = 0 Then RequireSafeWorkContinue "FinalizeManagedTableFieldDescriptionProofAfterG1DescriptionWork", "Table [" & tableName & "]"
        rs.MoveNext
    Loop
    rs.Close
    Set rs = Nothing
    tableName = DB_TABLE_USYS_RIBBONS
    tableCount = tableCount + 1
    priorProof = vbNullString
    priorFieldCount = 0
    If TryFieldDescriptionSameRunProof(tableName, priorProof, priorFieldCount) = False Then Err.Raise vbObjectError + 6792, "FinalizeManagedTableFieldDescriptionProofAfterG1DescriptionWork", "USysRibbons does not have the required same-run G1 field-description proof."
    Set tdf = db.TableDefs(tableName)
    currentFieldCount = 0
    canonicalFieldOrderText = vbNullString
    proofHeader = FieldDescriptionProofText(tdf, descriptionShortIndex, currentFieldCount, canonicalFieldOrderText)
    If currentFieldCount <> priorFieldCount Then Err.Raise vbObjectError + 6793, "FinalizeManagedTableFieldDescriptionProofAfterG1DescriptionWork", "USysRibbons field count changed after its same-run G1 field-description proof was established."
    If Len(priorProof) <= Len("|Verified") Then Err.Raise vbObjectError + 6794, "FinalizeManagedTableFieldDescriptionProofAfterG1DescriptionWork", "The same-run USysRibbons field-description proof is too short to contain a valid completion suffix."
    If StrComp(Right$(priorProof, Len("|Verified")), "|Verified", vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 6794, "FinalizeManagedTableFieldDescriptionProofAfterG1DescriptionWork", "The same-run USysRibbons field-description proof has an invalid completion suffix."
    proofBody = Left$(priorProof, Len(priorProof) - Len("|Verified"))
    separatorPosition = InStrRev(proofBody, "|", -1, vbBinaryCompare)
    If separatorPosition <= 0 Then Err.Raise vbObjectError + 6795, "FinalizeManagedTableFieldDescriptionProofAfterG1DescriptionWork", "The same-run USysRibbons field-description proof does not contain a physical result token."
    resultToken = Mid$(proofBody, separatorPosition + 1)
    If FieldDescriptionProofResultTokenIsValid(resultToken) = False Then Err.Raise vbObjectError + 6796, "FinalizeManagedTableFieldDescriptionProofAfterG1DescriptionWork", "The same-run USysRibbons field-description physical result token is invalid."
    reboundProof = proofHeader & "|" & resultToken & "|Verified"
    proofPropertyName = FieldDescriptionProofPropertyName(tdf.Name)
    If StrComp(priorProof, reboundProof, vbBinaryCompare) <> 0 Then
        Call EnsureDaoPropertyValue(db, proofPropertyName, dbText, reboundProof, "FinalizeManagedTableFieldDescriptionProofAfterG1DescriptionWork")
        reboundTableCount = reboundTableCount + 1
    End If
    mFieldDescriptionProofCache(proofPropertyName) = reboundProof
    PublishFieldDescriptionSameRunProof tdf.Name, reboundProof, currentFieldCount
    CatalogHashAppendText state, FingerprintTokenPart(tableName)
    CatalogHashAppendText state, FingerprintTokenPart(reboundProof)
    exactToken = CatalogHashToken(state)
    currentCatalogToken = CurrentCatalogValidationToken()
    If Len(currentCatalogToken) = 0 Then Err.Raise vbObjectError + 6797, "FinalizeManagedTableFieldDescriptionProofAfterG1DescriptionWork", "The final complete-catalog token is unavailable for G1 field-proof binding."
    Call EnsureDaoPropertyValue(db, MANAGED_TABLE_FIELD_DESCRIPTION_CATALOG_TOKEN_PROPERTY, dbText, currentCatalogToken, "FinalizeManagedTableFieldDescriptionProofAfterG1DescriptionWork")
    Call EnsureDaoPropertyValue(db, MANAGED_TABLE_FIELD_DESCRIPTION_PHYSICAL_TOKEN_PROPERTY, dbText, MANAGED_TABLE_FIELD_DESCRIPTION_PROOF_AGGREGATE_VERSION & "|" & exactToken, "FinalizeManagedTableFieldDescriptionProofAfterG1DescriptionWork")
    Call EnsureDaoPropertyValue(db, MANAGED_TABLE_FIELD_DESCRIPTION_EXACT_TOKEN_PROPERTY, dbText, exactToken, "FinalizeManagedTableFieldDescriptionProofAfterG1DescriptionWork")
    activeTraceRunID = GetActiveTraceRunID()
    mManagedTableFieldDescriptionToken = exactToken
    mManagedTableFieldDescriptionTokenTraceRunID = activeTraceRunID
    detailText = "Final G1 managed-table field-description proof bound to post-description table metadata; tables=" & CStr(tableCount) & "; optional absent=" & CStr(optionalAbsentCount) & "; proof headers rebound=" & CStr(reboundTableCount) & "; fields rescanned=0."
    FinalizeManagedTableFieldDescriptionProofAfterG1DescriptionWork = True
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    If IsCancellationError(savedErrNumber) Then Err.Raise savedErrNumber, savedErrSource, savedErrDescription
    exactToken = vbNullString
    detailText = "Could not finalize the G1 managed-table field-description proof against post-description table metadata. Error " & CStr(savedErrNumber) & " from " & savedErrSource & ": " & savedErrDescription
    FinalizeManagedTableFieldDescriptionProofAfterG1DescriptionWork = False
End Function

' Purpose: Performs managed table field descriptions persisted proof current by coordinating `ManagedTableFieldDescriptionsPersistedProofCurrentCore` and `End` while preserving this module's existing validation and
'     error semantics.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
