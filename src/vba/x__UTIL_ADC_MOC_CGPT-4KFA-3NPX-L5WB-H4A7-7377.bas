End Function


' Purpose: Resolves complete catalog unchanged except help documents for build repair from the supplied/current ADC state, using `ResolveCatalogDb` and `CatalogLoadPersistedSnapshot` where required by the lookup
'     path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   detailText (Output/in-out; String): Carries human-readable diagnostic detail for the operation; when passed ByRef, the routine can return or augment the text for the caller.
'   exactCurrentCatalogToken (Output/in-out Optional; String): Proof/state token representing the exact current catalog token prerequisite or resulting state; callers use it to prove that coordinated setup
'   work still refers to the same validated state. Default: vbNullString.
' Returns: String: Returns the complete catalog unchanged except help documents for build repair text value. `vbNullString` remains available where the existing routine uses an empty result to mean
'   unavailable, not applicable, or not resolved.
Public Function CompleteCatalogUnchangedExceptHelpDocumentsForBuildRepair(ByRef detailText As String, Optional ByRef exactCurrentCatalogToken As String = vbNullString) As String
    'Catalog-owned Build/Repair Help Document Macros predecessor proof: permits only Help_Docs row-content drift while requiring every unrelated complete D4 domain and the persisted D4 proof contract to remain
    'exact. When Help_Docs rows are also unchanged, returns the exact current persisted Catalog token so physical-Help-only recovery can reuse that authoritative evidence after C1-C3.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim currentSnapshot As CatalogDomainSnapshot
    Dim persistedSnapshot As CatalogDomainSnapshot
    Dim persistedAvailable As Boolean
    Dim persistedLoadDetail As String
    Dim storedValidationToken As String
    Dim validationExists As Boolean
    Dim compactDetail As String
    Dim timingDetail As String
    Dim schemaMatches As Boolean
    Dim defaultsMatches As Boolean
    Dim defaultsDifferenceAuthorized As Boolean
    Dim nonHelpDefaultsMatches As Boolean
    Dim helpDocumentsMatches As Boolean
    Dim inventoryMatches As Boolean
    Dim coreInventoryMatches As Boolean
    Dim formsInventoryMatches As Boolean
    Dim uiInventoryMatches As Boolean
    Dim macroInventoryMatches As Boolean
    Dim dependenciesMatch As Boolean
    Dim payloadsMatch As Boolean
    Dim corePayloadsMatch As Boolean
    Dim formsPayloadsMatch As Boolean
    Dim uiPayloadsMatch As Boolean
    Dim macroPayloadsMatch As Boolean
    Dim uiMatches As Boolean
    Dim formsMatch As Boolean
    Dim queriesMatch As Boolean
    Dim unchangedDomainsMatch As Boolean
    Dim proofPayload As String
    exactCurrentCatalogToken = vbNullString
    Set db = ResolveCatalogDb()
    mBuildRepairHelpDocumentMacrosCatalogPredecessorPersistedValidationToken = vbNullString
    mBuildRepairHelpDocumentMacrosCatalogScopedProofCurrent = False
    persistedAvailable = CatalogLoadPersistedSnapshot(db, persistedSnapshot, persistedLoadDetail)
    If persistedAvailable = False Then
        detailText = "Build/Repair Help Document Macros pre-mutation catalog proof failed because required persisted D4 domain evidence is missing." & vbCrLf & persistedLoadDetail
        GoTo ProofFailed
    End If
    storedValidationToken = DatabaseTextPropertyValue(db, CATALOG_VALIDATION_TOKEN_PROPERTY, validationExists)
    If validationExists = False Or Len(storedValidationToken) = 0 Then
        detailText = "Build/Repair Help Document Macros pre-mutation catalog proof failed because the persisted D4 complete-catalog validation token is missing."
        GoTo ProofFailed
    End If
    If StrComp(storedValidationToken, CatalogValidationToken(persistedSnapshot), vbBinaryCompare) <> 0 Then
        detailText = "Build/Repair Help Document Macros pre-mutation catalog proof failed because persisted D4 domain evidence is internally inconsistent with its complete-catalog validation token."
        GoTo ProofFailed
    End If
    If mBuildRepairHelpDocumentMacrosCatalogPredecessorScopeActive = False Then
        detailText = "Build/Repair Help Document Macros pre-mutation catalog proof failed because its Catalog predecessor proof scope is not active."
        GoTo ProofFailed
    End If
    If StrComp(mBuildRepairHelpDocumentMacrosCatalogPredecessorTraceRunID, CatalogSetupTraceIdentity(), vbBinaryCompare) <> 0 Then
        detailText = "Build/Repair Help Document Macros pre-mutation catalog proof failed because its Catalog predecessor evidence belongs to a different trace run."
        GoTo ProofFailed
    End If
    If mBuildRepairHelpDocumentMacrosCatalogPredecessorSnapshotAvailable = False Then
        detailText = "Build/Repair Help Document Macros pre-mutation catalog proof failed because the initial strict predecessor attempt did not produce reusable current Catalog evidence. The scoped fallback will not rescan the Defaults/catalog domains."
        GoTo ProofFailed
    End If
    CatalogCopyDomainSnapshot mBuildRepairHelpDocumentMacrosCatalogPredecessorSnapshot, currentSnapshot
    compactDetail = mBuildRepairHelpDocumentMacrosCatalogPredecessorSnapshotDetail
    timingDetail = mBuildRepairHelpDocumentMacrosCatalogPredecessorSnapshotTiming
    schemaMatches = (StrComp(persistedSnapshot.SchemaFingerprint, currentSnapshot.SchemaFingerprint, vbBinaryCompare) = 0)
    defaultsMatches = (StrComp(persistedSnapshot.DefaultsFingerprint, currentSnapshot.DefaultsFingerprint, vbBinaryCompare) = 0)
    nonHelpDefaultsMatches = (StrComp(persistedSnapshot.NonHelpDefaultsFingerprint, currentSnapshot.NonHelpDefaultsFingerprint, vbBinaryCompare) = 0)
    helpDocumentsMatches = (StrComp(persistedSnapshot.HelpDocumentsFingerprint, currentSnapshot.HelpDocumentsFingerprint, vbBinaryCompare) = 0)
    inventoryMatches = (StrComp(persistedSnapshot.InventoryFingerprint, currentSnapshot.InventoryFingerprint, vbBinaryCompare) = 0)
    coreInventoryMatches = (StrComp(persistedSnapshot.CoreInventoryFingerprint, currentSnapshot.CoreInventoryFingerprint, vbBinaryCompare) = 0)
    formsInventoryMatches = (StrComp(persistedSnapshot.FormsInventoryFingerprint, currentSnapshot.FormsInventoryFingerprint, vbBinaryCompare) = 0)
    uiInventoryMatches = (StrComp(persistedSnapshot.UiInventoryFingerprint, currentSnapshot.UiInventoryFingerprint, vbBinaryCompare) = 0)
    macroInventoryMatches = (StrComp(persistedSnapshot.MacroInventoryFingerprint, currentSnapshot.MacroInventoryFingerprint, vbBinaryCompare) = 0)
    dependenciesMatch = (StrComp(persistedSnapshot.DependencyFingerprint, currentSnapshot.DependencyFingerprint, vbBinaryCompare) = 0)
    payloadsMatch = (StrComp(persistedSnapshot.PayloadFingerprint, currentSnapshot.PayloadFingerprint, vbBinaryCompare) = 0)
    corePayloadsMatch = (StrComp(persistedSnapshot.CorePayloadFingerprint, currentSnapshot.CorePayloadFingerprint, vbBinaryCompare) = 0)
    formsPayloadsMatch = (StrComp(persistedSnapshot.FormsPayloadFingerprint, currentSnapshot.FormsPayloadFingerprint, vbBinaryCompare) = 0)
    uiPayloadsMatch = (StrComp(persistedSnapshot.UiPayloadFingerprint, currentSnapshot.UiPayloadFingerprint, vbBinaryCompare) = 0)
    macroPayloadsMatch = (StrComp(persistedSnapshot.MacroPayloadFingerprint, currentSnapshot.MacroPayloadFingerprint, vbBinaryCompare) = 0)
    uiMatches = (StrComp(persistedSnapshot.UiFingerprint, currentSnapshot.UiFingerprint, vbBinaryCompare) = 0)
    formsMatch = (StrComp(persistedSnapshot.FormsFingerprint, currentSnapshot.FormsFingerprint, vbBinaryCompare) = 0)
    queriesMatch = (StrComp(persistedSnapshot.QueryFingerprint, currentSnapshot.QueryFingerprint, vbBinaryCompare) = 0)
    defaultsDifferenceAuthorized = defaultsMatches Or (nonHelpDefaultsMatches And (helpDocumentsMatches = False))
    unchangedDomainsMatch = schemaMatches And defaultsDifferenceAuthorized And nonHelpDefaultsMatches And inventoryMatches And coreInventoryMatches And formsInventoryMatches And uiInventoryMatches And macroInventoryMatches And dependenciesMatch And payloadsMatch And corePayloadsMatch And formsPayloadsMatch And uiPayloadsMatch And macroPayloadsMatch And uiMatches And formsMatch And queriesMatch
    detailText = "Build/Repair Help Document Macros pre-mutation catalog proof:" & vbCrLf & _
                 "Schema=" & IIf(schemaMatches, "matched", "changed") & vbCrLf & _
                 "Defaults=" & IIf(defaultsMatches, "matched", IIf(defaultsDifferenceAuthorized, "changed (allowed only through Help_Docs partition)", "changed")) & vbCrLf & _
                 "NonHelpDefaults=" & IIf(nonHelpDefaultsMatches, "matched", "changed") & vbCrLf & _
                 "HelpDocumentsRows=" & IIf(helpDocumentsMatches, "matched", "changed (allowed)") & vbCrLf & _
                 "Inventory=" & IIf(inventoryMatches, "matched", "changed") & vbCrLf & _
                 "CoreInventory=" & IIf(coreInventoryMatches, "matched", "changed") & vbCrLf & _
                 "FormsInventory=" & IIf(formsInventoryMatches, "matched", "changed") & vbCrLf & _
                 "UiInventory=" & IIf(uiInventoryMatches, "matched", "changed") & vbCrLf & _
                 "MacroInventory=" & IIf(macroInventoryMatches, "matched", "changed") & vbCrLf & _
                 "Dependencies=" & IIf(dependenciesMatch, "matched", "changed") & vbCrLf & _
                 "Payloads=" & IIf(payloadsMatch, "matched", "changed") & vbCrLf & _
                 "CorePayloads=" & IIf(corePayloadsMatch, "matched", "changed") & vbCrLf & _
                 "FormsPayloads=" & IIf(formsPayloadsMatch, "matched", "changed") & vbCrLf & _
                 "UiPayloads=" & IIf(uiPayloadsMatch, "matched", "changed") & vbCrLf & _
                 "MacroPayloads=" & IIf(macroPayloadsMatch, "matched", "changed") & vbCrLf & _
                 "UI=" & IIf(uiMatches, "matched", "changed") & vbCrLf & _
                 "Forms=" & IIf(formsMatch, "matched", "changed") & vbCrLf & _
                 "Queries=" & IIf(queriesMatch, "matched", "changed")
    If Len(compactDetail) > 0 Then detailText = detailText & vbCrLf & compactDetail
    If Len(timingDetail) > 0 Then detailText = detailText & vbCrLf & timingDetail
    If unchangedDomainsMatch = False Then
        detailText = "Build/Repair Help Document Macros refused to continue because an unrelated catalog domain changed." & vbCrLf & detailText
        GoTo ProofFailed
    End If
    If helpDocumentsMatches Then
        exactCurrentCatalogToken = CatalogValidationToken(currentSnapshot)
        If Len(exactCurrentCatalogToken) = 0 Or StrComp(exactCurrentCatalogToken, storedValidationToken, vbBinaryCompare) <> 0 Then
            detailText = "Build/Repair Help Document Macros scoped catalog proof found unchanged Help_Docs rows but the exact current Catalog token does not match the persisted D4 validation token." & vbCrLf & detailText
            GoTo ProofFailed
        End If
        detailText = detailText & vbCrLf & "Exact current complete-catalog token reusable after physical-Help-only repair=True"
    End If
    mBuildRepairHelpDocumentMacrosCatalogPredecessorPersistedValidationToken = storedValidationToken
    mBuildRepairHelpDocumentMacrosCatalogScopedProofCurrent = True
    If helpDocumentsMatches = False Then
        'The scoped proof authorizes this input difference but does not persist it. Mark Defaults dirty so the post-reconciliation ordinary D4 path must recalculate and persist the strict aggregate and both
        'partition fingerprints together.
        CatalogMarkSetupDomainsDirty CATALOG_DIRTY_DEFAULTS
        detailText = detailText & vbCrLf & "Post-reconciliation strict D4 Defaults refresh=required"
    End If
    proofPayload = BUILD_REPAIR_HELP_DOCUMENT_MACROS_CATALOG_SCOPED_PROOF_VERSION
    proofPayload = proofPayload & FingerprintTokenPart(currentSnapshot.SchemaFingerprint)
    proofPayload = proofPayload & FingerprintTokenPart(currentSnapshot.NonHelpDefaultsFingerprint)
    proofPayload = proofPayload & FingerprintTokenPart(currentSnapshot.InventoryFingerprint)
    proofPayload = proofPayload & FingerprintTokenPart(currentSnapshot.CoreInventoryFingerprint)
    proofPayload = proofPayload & FingerprintTokenPart(currentSnapshot.FormsInventoryFingerprint)
    proofPayload = proofPayload & FingerprintTokenPart(currentSnapshot.UiInventoryFingerprint)
    proofPayload = proofPayload & FingerprintTokenPart(currentSnapshot.MacroInventoryFingerprint)
    proofPayload = proofPayload & FingerprintTokenPart(currentSnapshot.DependencyFingerprint)
    proofPayload = proofPayload & FingerprintTokenPart(currentSnapshot.PayloadFingerprint)
    proofPayload = proofPayload & FingerprintTokenPart(currentSnapshot.CorePayloadFingerprint)
    proofPayload = proofPayload & FingerprintTokenPart(currentSnapshot.FormsPayloadFingerprint)
    proofPayload = proofPayload & FingerprintTokenPart(currentSnapshot.UiPayloadFingerprint)
    proofPayload = proofPayload & FingerprintTokenPart(currentSnapshot.MacroPayloadFingerprint)
    proofPayload = proofPayload & FingerprintTokenPart(currentSnapshot.UiFingerprint)
    proofPayload = proofPayload & FingerprintTokenPart(currentSnapshot.FormsFingerprint)
    proofPayload = proofPayload & FingerprintTokenPart(currentSnapshot.QueryFingerprint)
    CompleteCatalogUnchangedExceptHelpDocumentsForBuildRepair = FingerprintFromPayload(proofPayload)
    LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "CompleteCatalogUnchangedExceptHelpDocumentsForBuildRepair", "Build/Repair Help Document Macros scoped catalog predecessor proof passed.", detailText, "Build/Repair Help Document Macros pre-mutation catalog proof", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogValidation", "CodeDb", "ManagedObjectCatalog"
    Exit Function
ProofFailed:
    exactCurrentCatalogToken = vbNullString
    LogTraceMessage TRACE_LEVEL_WARNING, "ManagedObjectCatalog", "CompleteCatalogUnchangedExceptHelpDocumentsForBuildRepair", "Build/Repair Help Document Macros scoped catalog predecessor proof failed.", detailText, "Build/Repair Help Document Macros pre-mutation catalog proof", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogValidation", "CodeDb", "ManagedObjectCatalog"
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    exactCurrentCatalogToken = vbNullString
    If IsCancellationError(savedErrNumber) Then Err.Raise savedErrNumber, savedErrSource, savedErrDescription
    detailText = "Build/Repair Help Document Macros scoped catalog predecessor proof failed. Error " & CStr(savedErrNumber) & " from " & savedErrSource & ": " & savedErrDescription
    On Error Resume Next
    LogTraceMessage TRACE_LEVEL_WARNING, "ManagedObjectCatalog", "CompleteCatalogUnchangedExceptHelpDocumentsForBuildRepair", "Build/Repair Help Document Macros scoped catalog predecessor proof failed.", detailText, "Build/Repair Help Document Macros pre-mutation catalog proof", savedErrNumber, savedErrSource, savedErrDescription, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogValidation", "CodeDb", "ManagedObjectCatalog"
    On Error GoTo 0
End Function

' Purpose: Resolves complete catalog state token for setup from the supplied/current ADC state, using `ResolveCatalogDb` and `DatabaseTextPropertyValue` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   detailText (Output/in-out; String): Carries human-readable diagnostic detail for the operation; when passed ByRef, the routine can return or augment the text for the caller.
' Returns: String: Returns the proof/state token produced by this routine. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not
'   resolved.
Public Function CompleteCatalogStateTokenForSetup(ByRef detailText As String) As String
    'Verifies the persisted complete logical Managed Object Catalog, including Forms, against the exact current catalog state. D4 establishes the first complete snapshot.
    'Later owner phases may refresh shared derived state without rewriting D4-owned proofs.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim currentToken As String
    Dim storedToken As String
    Dim propertyValue As String
    Dim propertyExists As Boolean
    Set db = ResolveCatalogDb()
    storedToken = DatabaseTextPropertyValue(db, CATALOG_VALIDATION_TOKEN_PROPERTY, propertyExists)
    If propertyExists = False Or Len(storedToken) = 0 Then detailText = "The persisted complete-catalog validation token is missing.": Exit Function
    propertyValue = DatabaseTextPropertyValue(db, CATALOG_FORMS_INVENTORY_FINGERPRINT_PROPERTY, propertyExists)
    If propertyExists = False Or Len(propertyValue) = 0 Then detailText = "The persisted complete-catalog FormsInventory state is missing.": Exit Function
    propertyValue = DatabaseTextPropertyValue(db, CATALOG_FORMS_PAYLOAD_FINGERPRINT_PROPERTY, propertyExists)
    If propertyExists = False Or Len(propertyValue) = 0 Then detailText = "The persisted complete-catalog FormsPayloads state is missing.": Exit Function
    propertyValue = DatabaseTextPropertyValue(db, CATALOG_FORMS_FINGERPRINT_PROPERTY, propertyExists)
    If propertyExists = False Or Len(propertyValue) = 0 Then detailText = "The persisted complete-catalog Forms state is missing.": Exit Function
    currentToken = CurrentCatalogValidationToken()
    If Len(currentToken) = 0 Then detailText = "The current complete catalog validation token could not be calculated.": Exit Function
    If StrComp(currentToken, storedToken, vbBinaryCompare) <> 0 Then detailText = "The persisted complete-catalog validation token does not match the current complete catalog state.": Exit Function
    detailText = "Complete logical Managed Object Catalog is current. D4-owned form proof is verified separately; later physical domains remain phase-owned."
    CompleteCatalogStateTokenForSetup = currentToken
    Exit Function
ErrHandler:
    detailText = "Could not verify the complete catalog state. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
End Function

' Purpose: Returns the shared same-run complete-catalog handoff used by Ribbon after validating that it still equals the current persisted catalog state.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   proofToken (Output; String): Receives the exact same-run complete-catalog handoff token.
'   proofTraceRunID (Output; String): Receives the trace-run ID that owns the handoff.
'   detailText (Output; String): Receives diagnostic detail for success or rejection.
'   sameRunCurrentCatalogToken (Input Optional; String): Exact current catalog token already validated in this trace run; blank requests the normal current-state check. Default: vbNullString.
'   sameRunCurrentCatalogTraceRunID (Input Optional; String): Trace-run ID for the supplied current catalog token. Default: vbNullString.
' Returns: Boolean: True only when the shared same-run handoff belongs to the active trace and exactly matches the current complete-catalog state.
Public Function CompleteCatalogSameRunProofForRibbon(ByRef proofToken As String, ByRef proofTraceRunID As String, ByRef detailText As String, Optional ByVal sameRunCurrentCatalogToken As String = vbNullString, Optional ByVal sameRunCurrentCatalogTraceRunID As String = vbNullString) As Boolean
    'This is shared derived handoff evidence, not a D4 ownership proof. D4 seeds it and G1 may refresh it after G1-owned Description mutations persist a new complete-catalog snapshot.
    On Error GoTo NotCurrent
    Dim currentToken As String
    Dim currentDetail As String
    proofToken = vbNullString
    proofTraceRunID = vbNullString
    detailText = vbNullString
    If Len(mCompleteCatalogSameRunRibbonHandoffToken) = 0 Or Len(mCompleteCatalogSameRunRibbonHandoffTraceRunID) = 0 Then
        detailText = "No same-run complete-catalog Ribbon handoff is retained."
        Exit Function
    End If
    If TraceRunActive() = False Then
        detailText = "The retained complete-catalog Ribbon handoff cannot be consumed because no trace run is active."
        Exit Function
    End If
    If StrComp(mCompleteCatalogSameRunRibbonHandoffTraceRunID, GetActiveOrLastTraceRunID(), vbBinaryCompare) <> 0 Then
        detailText = "The retained complete-catalog Ribbon handoff belongs to a different trace run."
        Exit Function
    End If
    If Len(Trim$(sameRunCurrentCatalogToken)) > 0 Then
        If Len(Trim$(sameRunCurrentCatalogTraceRunID)) = 0 Then detailText = "A same-run current catalog token was supplied without its trace identity.": Exit Function
        If StrComp(Trim$(sameRunCurrentCatalogTraceRunID), GetActiveOrLastTraceRunID(), vbBinaryCompare) <> 0 Then detailText = "The supplied same-run current catalog token belongs to a different trace run.": Exit Function
        currentToken = Trim$(sameRunCurrentCatalogToken)
        currentDetail = "Current catalog token reused from already-proven same-run current state; exhaustive token recalculation skipped."
    ElseIf Len(Trim$(sameRunCurrentCatalogTraceRunID)) > 0 Then
        detailText = "A same-run current catalog trace identity was supplied without its token."
        Exit Function
    Else
        currentToken = CompleteCatalogStateTokenForSetup(currentDetail)
        If Len(currentToken) = 0 Then
            detailText = "The retained complete-catalog Ribbon handoff is no longer current." & vbCrLf & currentDetail
            Exit Function
        End If
    End If
    If StrComp(currentToken, mCompleteCatalogSameRunRibbonHandoffToken, vbBinaryCompare) <> 0 Then
        detailText = "The retained complete-catalog Ribbon handoff no longer matches the exact current complete-catalog token."
        Exit Function
    End If
    proofToken = mCompleteCatalogSameRunRibbonHandoffToken
    proofTraceRunID = mCompleteCatalogSameRunRibbonHandoffTraceRunID
    detailText = "Catalog retained the exact current complete-catalog Ribbon handoff for this trace run." & vbCrLf & currentDetail
    CompleteCatalogSameRunProofForRibbon = True
    Exit Function
NotCurrent:
    If IsCancellationError(Err.Number) Then Err.Raise Err.Number, Err.Source, Err.Description
    detailText = "Could not verify the same-run complete-catalog Ribbon handoff. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
    Err.Clear
End Function

' Purpose: Finalizes complete catalog state for setup.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   showMessage (Input Optional; Boolean): Controls whether the routine displays its normal user-facing status, completion, warning, or error message; False suppresses that presentation while preserving the
'   underlying operation. Default: False.
'   detailsForMessage (Output Optional; String): Receives detail text formatted for inclusion in the caller's user-facing message. Default: vbNullString.
'   finalCatalogToken (Output Optional; String): Receives the resolved final catalog token produced from this procedure's validated inputs and current ADC state. Default: vbNullString.
' Returns: Boolean: True on the function's affirmative/success branch for finalize complete catalog state for setup; False on its explicit negative, unavailable, rejected, or handled-failure branch.
'   not-applicable path.
Public Function FinalizeCompleteCatalogStateForSetup(Optional ByVal showMessage As Boolean = False, Optional ByRef detailsForMessage As String = vbNullString, Optional ByRef finalCatalogToken As String = vbNullString) As Boolean
    RequireSetupDomainMutationAllowed SETUP_DOMAIN_D4_COMPLETE_CATALOG_FINALIZATION, "FinalizeCompleteCatalogStateForSetup"
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim snapshot As CatalogDomainSnapshot
    Dim persistedSnapshot As CatalogDomainSnapshot
    Dim resolverTiming As String
    Dim snapshotTiming As String
    Dim wrapperValidationDetail As String
    Dim phaseTimer As Single
    Dim stageTimer As Single
    Dim placementDefinitionElapsed As Double
    Dim placementResolverElapsed As Double
    Dim strictValidationElapsed As Double
    Dim wrapperValidationElapsed As Double
    Dim remainingStrictElapsed As Double
    Dim snapshotElapsed As Double
    Dim persistenceElapsed As Double
    Dim persistedSnapshotAvailable As Boolean
    Dim selectiveSnapshotUsed As Boolean
    Dim exhaustiveSnapshotFallbackUsed As Boolean
    Dim dirtyMask As Long
    Dim recalculatedDomainCount As Long
    Dim reusedDomainCount As Long
    Dim managedDefinitionSnapshotAcquired As Boolean
    finalCatalogToken = vbNullString
    mCompleteCatalogSameRunRibbonHandoffToken = vbNullString
    mCompleteCatalogSameRunRibbonHandoffTraceRunID = vbNullString
    phaseTimer = Timer
    BeginManagedObjectDefinitionSnapshot
    managedDefinitionSnapshotAcquired = True
    RequireCatalogMutationRecoveryReady "FinalizeCompleteCatalogStateForSetup"
    Set db = ResolveCatalogDb()
    dirtyMask = mCatalogSetupDirtyDomainMask
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "FinalizeCompleteCatalogStateForSetup", "Setup D4 entered.", "Trace run ID: " & CatalogSetupTraceIdentity() & vbCrLf & "Dirty-domain mask: " & CStr(dirtyMask) & " (" & CatalogDirtyDomainSummary(dirtyMask) & ")" & vbCrLf & "Persisted complete-catalog snapshot availability: deferred to the authoritative catalog-domain snapshot stage.", "D4 logical catalog validation", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogValidation", "CodeDb", "Performance"
    CorePulseProgress "Setup D4: validating complete form-inclusive placement metadata."
    stageTimer = Timer
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "FinalizeCompleteCatalogStateForSetup", "Setup D4 placement-definition validation starting.", "Include managed forms: True", "D4 placement-definition validation", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitions", "CodeDb", "Performance"
    ValidateManagedObjectPlacementDefinitionsForSetup True, True
    placementDefinitionElapsed = ElapsedSecondsFromTimer(stageTimer)
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "FinalizeCompleteCatalogStateForSetup", "Setup D4 placement-definition validation completed.", "Elapsed: " & FormattedElapsedSeconds(placementDefinitionElapsed), "D4 placement-definition validation", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitions", "CodeDb", "Performance"
    stageTimer = Timer
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "FinalizeCompleteCatalogStateForSetup", "Setup D4 placement-resolver validation starting.", "The existing D4 managed-placement snapshot is expected to be reused.", "D4 placement-resolver validation", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitions", "CodeDb", "Performance"
    ValidateManagedObjectPlacementResolverCoverageForSetup resolverTiming, True
    placementResolverElapsed = ElapsedSecondsFromTimer(stageTimer)
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "FinalizeCompleteCatalogStateForSetup", "Setup D4 placement-resolver validation completed.", "Elapsed: " & FormattedElapsedSeconds(placementResolverElapsed) & IIf(Len(resolverTiming) = 0, vbNullString, vbCrLf & resolverTiming), "D4 placement-resolver validation", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitions", "CodeDb", "Performance"
    CorePulseProgress "Setup D4: running strict complete Managed Object Catalog validation."
    stageTimer = Timer
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "FinalizeCompleteCatalogStateForSetup", "Setup D4 strict complete catalog validation starting.", "Placement validation enabled: True" & vbCrLf & "Reuse current placement snapshot: True", "D4 strict catalog validation", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogValidation", "CodeDb", "Performance"
    If ValidateManagedObjectCatalog(False, True, True, True) = False Then Err.Raise vbObjectError + 9585, "FinalizeCompleteCatalogStateForSetup", "Strict complete Managed Object Catalog validation returned False."
    wrapperValidationElapsed = mCatalogLastSystemMacroWrapperValidationElapsedSeconds
    wrapperValidationDetail = mCatalogLastSystemMacroWrapperValidationDetail
    strictValidationElapsed = ElapsedSecondsFromTimer(stageTimer)
    remainingStrictElapsed = strictValidationElapsed - wrapperValidationElapsed
    If remainingStrictElapsed < 0 Then remainingStrictElapsed = 0
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "FinalizeCompleteCatalogStateForSetup", "Setup D4 strict complete catalog validation completed.", "Elapsed: " & FormattedElapsedSeconds(strictValidationElapsed), "D4 strict catalog validation", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogValidation", "CodeDb", "Performance"
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "FinalizeCompleteCatalogStateForSetup", "Setup D4 System Macro wrapper/procedure validation timing", "Elapsed: " & FormattedElapsedSeconds(wrapperValidationElapsed) & IIf(Len(wrapperValidationDetail) = 0, vbNullString, vbCrLf & wrapperValidationDetail), "D4 System Macro wrapper validation", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros"), "CatalogValidation", "CodeDb", "Performance"
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "FinalizeCompleteCatalogStateForSetup", "Setup D4 remaining strict catalog validation timing", "Elapsed: " & FormattedElapsedSeconds(remainingStrictElapsed), "D4 remaining strict catalog validation", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogValidation", "CodeDb", "Performance"
    CorePulseProgress "Setup D4: composing and persisting authoritative complete logical catalog state."
    stageTimer = Timer
    dirtyMask = mCatalogSetupDirtyDomainMask
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "FinalizeCompleteCatalogStateForSetup", "Setup D4 catalog-domain snapshot processing starting.", "Dirty-domain mask: " & CStr(dirtyMask) & " (" & CatalogDirtyDomainSummary(dirtyMask) & ")", "D4 catalog-domain snapshot", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogValidation", "CodeDb", "Performance"
    persistedSnapshotAvailable = CatalogLoadPersistedSnapshot(db, persistedSnapshot)
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "FinalizeCompleteCatalogStateForSetup", "Setup D4 persisted complete-catalog snapshot lookup completed.", "Available: " & CStr(persistedSnapshotAvailable), "D4 catalog-domain snapshot", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogValidation", "CodeDb", "Performance"
    If persistedSnapshotAvailable Then
        selectiveSnapshotUsed = RefreshCatalogDirtyDomainSnapshot(persistedSnapshot, snapshot, snapshotTiming)
    End If
    If persistedSnapshotAvailable = False Or selectiveSnapshotUsed = False Then
        exhaustiveSnapshotFallbackUsed = True
        snapshotTiming = SharedText_AppendNonBlankLine(snapshotTiming, IIf(persistedSnapshotAvailable, "Selective dirty-domain refresh could not prove the exact state; using the authoritative exhaustive fallback.", "Persisted complete-catalog evidence is unavailable; using the authoritative exhaustive fallback."))
        If CalculateCatalogDomainSnapshot(snapshot, snapshotTiming) = False Then Err.Raise vbObjectError + 9586, "FinalizeCompleteCatalogStateForSetup", "Complete catalog validation passed, but the exact form-inclusive domain snapshot could not be calculated. " & snapshot.failureDetail
        recalculatedDomainCount = 8
        reusedDomainCount = 0
    Else
        recalculatedDomainCount = CatalogDirtyDomainCount(dirtyMask)
        reusedDomainCount = 8 - recalculatedDomainCount
    End If
    snapshotElapsed = ElapsedSecondsFromTimer(stageTimer)
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "FinalizeCompleteCatalogStateForSetup", "Setup D4 catalog-domain snapshot processing completed.", "Elapsed: " & FormattedElapsedSeconds(snapshotElapsed) & vbCrLf & "Catalog domains recalculated: " & CStr(recalculatedDomainCount) & vbCrLf & "Catalog domains reused from authoritative persisted evidence: " & CStr(reusedDomainCount) & vbCrLf & "Exhaustive snapshot fallback used: " & CStr(exhaustiveSnapshotFallbackUsed) & IIf(Len(snapshotTiming) = 0, vbNullString, vbCrLf & snapshotTiming), "D4 catalog-domain snapshot", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogValidation", "CodeDb", "Performance"
    stageTimer = Timer
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "FinalizeCompleteCatalogStateForSetup", "Setup D4 final persistence/proof starting.", vbNullString, "D4 final persistence/proof", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogValidation", "CodeDb", "Performance"
    PersistCompleteCatalogDomainSnapshotForSetup snapshot
    mCompleteCatalogSameRunRibbonHandoffToken = CatalogValidationToken(snapshot)
    If Len(mCompleteCatalogSameRunRibbonHandoffToken) = 0 Then Err.Raise vbObjectError + 9611, "FinalizeCompleteCatalogStateForSetup", "D4 persisted the complete catalog state without producing the shared Ribbon handoff token."
    finalCatalogToken = mCompleteCatalogSameRunRibbonHandoffToken
    mCompleteCatalogSameRunRibbonHandoffTraceRunID = CatalogSetupTraceIdentity()
    persistenceElapsed = ElapsedSecondsFromTimer(stageTimer)
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "FinalizeCompleteCatalogStateForSetup", "Setup D4 final persistence/proof completed.", "Elapsed: " & FormattedElapsedSeconds(persistenceElapsed), "D4 final persistence/proof", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogValidation", "CodeDb", "Performance"
    detailsForMessage = SharedText_AppendNonBlankLine(detailsForMessage, "Setup D4 complete logical catalog validation passed, including managed-report logical definitions while physical report proof remains Phase E-owned." & vbCrLf & "FormsInventory=" & snapshot.FormsInventoryFingerprint & vbCrLf & "FormsPayloads=" & snapshot.FormsPayloadFingerprint & vbCrLf & "Forms=" & snapshot.FormsFingerprint & vbCrLf & "CatalogValidation=" & CatalogValidationToken(snapshot))
    detailsForMessage = detailsForMessage & vbCrLf & "D4 performance stages:" & vbCrLf & _
        "Placement-definition validation: " & FormattedElapsedSeconds(placementDefinitionElapsed) & vbCrLf & _
        "Placement-resolver validation: " & FormattedElapsedSeconds(placementResolverElapsed) & vbCrLf & _
        "System Macro wrapper/procedure validation: " & FormattedElapsedSeconds(wrapperValidationElapsed) & vbCrLf & _
        "Remaining strict catalog validation: " & FormattedElapsedSeconds(remainingStrictElapsed) & vbCrLf & _
        "Catalog-domain snapshot calculation: " & FormattedElapsedSeconds(snapshotElapsed) & vbCrLf & _
        "Final persistence/proof: " & FormattedElapsedSeconds(persistenceElapsed) & vbCrLf & _
        "Catalog domains recalculated: " & CStr(recalculatedDomainCount) & vbCrLf & _
        "Catalog domains reused from authoritative persisted evidence: " & CStr(reusedDomainCount) & vbCrLf & _
        "Exhaustive snapshot fallback used: " & CStr(exhaustiveSnapshotFallbackUsed)
    If Len(wrapperValidationDetail) > 0 Then detailsForMessage = detailsForMessage & vbCrLf & wrapperValidationDetail
    If Len(resolverTiming) > 0 Then detailsForMessage = detailsForMessage & vbCrLf & resolverTiming
    If Len(snapshotTiming) > 0 Then detailsForMessage = detailsForMessage & vbCrLf & snapshotTiming
    detailsForMessage = detailsForMessage & vbCrLf & "Elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(phaseTimer))
    LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "FinalizeCompleteCatalogStateForSetup", "D4 complete logical catalog state validated and persisted; physical managed-report currentness remains Phase E-owned.", detailsForMessage, "D4 logical catalog validation", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogValidation", "CodeDb", "ManagedObjectCatalog"
    If showMessage Then CoreShowMessage detailsForMessage, vbInformation, "Managed Object Catalog", "ShowADCMessage", "Tables"
    FinalizeCompleteCatalogStateForSetup = True
    If managedDefinitionSnapshotAcquired Then EndManagedObjectDefinitionSnapshot
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    finalCatalogToken = vbNullString
    On Error Resume Next
    If managedDefinitionSnapshotAcquired Then EndManagedObjectDefinitionSnapshot
    On Error GoTo 0
    detailsForMessage = "Setup D4 complete logical catalog finalization failed." & vbCrLf & "Err.Number: " & CStr(savedErrNumber) & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
    LogTraceMessage TRACE_LEVEL_ERROR, "ManagedObjectCatalog", "FinalizeCompleteCatalogStateForSetup", "D4 complete logical catalog finalization failed.", detailsForMessage, "D4 logical catalog validation", savedErrNumber, savedErrSource, savedErrDescription, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogValidation", "CodeDb", "ManagedObjectCatalog"
    If showMessage Then CoreShowErrorMessage detailsForMessage, vbCritical, "Managed Object Catalog", "FinalizeCompleteCatalogStateForSetup", "Tables": Exit Function
    Err.Raise savedErrNumber, "FinalizeCompleteCatalogStateForSetup", detailsForMessage
End Function

Private Sub EnsureManagedTableFieldOrder(ByVal tableName As String, Optional ByVal catalogSchemaDefinitions As Variant)
    RequireCatalogMutationRecoveryReady "EnsureManagedTableFieldOrder"
    'Enforces the documented logical field order for a fixed-schema Access Development Console table.
    If B1ColdCreatedStructuralProofAvailable(tableName) Then
        RecordB1ColdCreateStructuralBypass tableName
        Exit Sub
    End If
    On Error GoTo ErrHandler
    Dim definitions As Collection
    Dim fieldDefinition As Variant
    Dim fieldOrderText As String
    If IsObject(catalogSchemaDefinitions) Then Set definitions = catalogSchemaDefinitions
    If definitions Is Nothing Then
        fieldOrderText = CanonicalTableFieldOrderText(tableName)
    Else
        For Each fieldDefinition In definitions
            If Len(fieldOrderText) > 0 Then fieldOrderText = fieldOrderText & "|"
            fieldOrderText = fieldOrderText & CStr(fieldDefinition(0))
        Next fieldDefinition
    End If
    If Len(fieldOrderText) = 0 Then Exit Sub
    EnsureTableFieldOrderFromText tableName, fieldOrderText
    Exit Sub
ErrHandler:
    Dim originalErrNumber As Long
    Dim originalErrDescription As String
    originalErrNumber = Err.Number
    originalErrDescription = Err.Description
    Err.Raise originalErrNumber, "EnsureManagedTableFieldOrder", "Unable to enforce " & DEFAULT_UTILITY_LONG_NAME & " table field order." & vbCrLf & "Table: " & tableName & vbCrLf & "Description: " & originalErrDescription
End Sub

Private Sub EnsureTableFieldOrderFromText(ByVal tableName As String, ByVal fieldOrderText As String)
    'Enforces field order for a CodeDb-owned table without recreating the table or moving data.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    If Len(fieldOrderText) = 0 Then Exit Sub
    Set db = ResolveCatalogDb()
    If SharedDao_TableExists(db, tableName) = False Then Exit Sub
    EnsureTableDefFieldOrderFromText db.TableDefs(tableName), fieldOrderText, mCatalogDesignBatchPrepared
    Exit Sub
ErrHandler:
    Dim originalErrNumber As Long
    Dim originalErrDescription As String
    originalErrNumber = Err.Number
    originalErrDescription = Err.Description
    Err.Raise originalErrNumber, "EnsureTableFieldOrderFromText", "Unable to enforce table field order." & vbCrLf & "Table: " & tableName & vbCrLf & "Description: " & originalErrDescription
End Sub

Private Sub CreateCanonicalTableCold(ByVal db As DAO.Database, ByVal tableName As String, ByRef fieldsCreated As Long, ByRef indexesCreated As Long, ByVal fieldDefinitions As Collection, ByVal indexDefinitions As Collection)
    On Error GoTo ErrHandler
    Dim tdf As DAO.tableDef
    Dim fld As DAO.Field
    Dim idx As DAO.index
    Dim fieldDefinition As Variant
    Dim indexDefinition As Variant
    Dim coldIndexFieldName As Variant
    Dim expectedColumnOrder As Long
    If fieldDefinitions Is Nothing Then Err.Raise vbObjectError + 9433, "CreateCanonicalTableCold", "The table has no canonical Catalog field schema."
    If indexDefinitions Is Nothing Then Err.Raise vbObjectError + 9434, "CreateCanonicalTableCold", "The table has no canonical Catalog index schema."
    If fieldDefinitions.count = 0 Then Err.Raise vbObjectError + 9433, "CreateCanonicalTableCold", "The table has no canonical Catalog field schema."
    If indexDefinitions.count = 0 Then Err.Raise vbObjectError + 9434, "CreateCanonicalTableCold", "The table has no canonical Catalog index schema."
    Set tdf = db.CreateTableDef(tableName)
    expectedColumnOrder = 1
    For Each fieldDefinition In fieldDefinitions
        If CLng(fieldDefinition(1)) = dbText And CLng(fieldDefinition(2)) > 0 Then
            Set fld = tdf.CreateField(CStr(fieldDefinition(0)), CLng(fieldDefinition(1)), CLng(fieldDefinition(2)))
        Else
            Set fld = tdf.CreateField(CStr(fieldDefinition(0)), CLng(fieldDefinition(1)))
        End If
        If CBool(fieldDefinition(3)) Then fld.Attributes = fld.Attributes Or dbAutoIncrField
        ApplyCatalogFieldContract fld, fieldDefinition, tableName
        PreseedB1ColdFieldProperties fld, expectedColumnOrder
        tdf.fields.Append fld
        fieldsCreated = fieldsCreated + 1
        expectedColumnOrder = expectedColumnOrder + 1
    Next fieldDefinition
    For Each indexDefinition In indexDefinitions
        Set idx = tdf.CreateIndex(CStr(indexDefinition(0)))
        For Each coldIndexFieldName In Split(CStr(indexDefinition(1)), "|")
            idx.fields.Append idx.CreateField(CStr(coldIndexFieldName))
        Next coldIndexFieldName
        idx.Unique = CBool(indexDefinition(2))
        idx.Primary = CBool(indexDefinition(3))
        If UBound(indexDefinition) >= 4 Then idx.IgnoreNulls = CBool(indexDefinition(4))
        tdf.Indexes.Append idx
        indexesCreated = indexesCreated + 1
    Next indexDefinition
    db.TableDefs.Append tdf
    TrackSetupCreatedTableRollback tableName
    CoreAddOperationNote "Cold-created complete managed object catalog table [" & tableName & "] with " & CStr(fieldDefinitions.count) & " fields and " & CStr(indexDefinitions.count) & " indexes before one batch TableDefs refresh."
    CoreAddOperationNote "Deferred Navigation Pane grouping for newly cold-created table [" & tableName & "] until the final catalog-driven grouping pass after MAC defaults exist."
    LogTraceMessage TRACE_LEVEL_DETAIL, "NavigationPane", "CreateCanonicalTableCold", "New catalog-table Navigation Pane grouping deferred until authoritative placement exists.", "Table: " & tableName & " | Deferred during the canonical B1 cold-create batch; authoritative placement is evaluated after MAC structure and defaults exist.", "Create managed object catalog table", 0, vbNullString, vbNullString, tableName, "Table", "CodeDb", "NavigationPaneGrouping"
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    Err.Raise savedErrNumber, "CreateCanonicalTableCold", "Could not cold-create the complete canonical Catalog table." & vbCrLf & "Table: " & tableName & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Sub

Private Sub EnsureFormsTable()
    'B1 owns only ADC_FormDefinitions structure here. A2 owns macro-classification structure; B2 owns shared lookup/caption metadata. Do not repair either predecessor/successor domain from this structural helper.
    Dim tableName As String
    Dim fieldDefinitions As Collection
    Dim indexDefinitions As Collection
    tableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_FormDefinitions")
    If B1ColdCreatedStructuralProofAvailable(tableName) Then
        RecordB1ColdCreateStructuralBypass tableName, 4
    Else
        Set fieldDefinitions = CatalogTableSchemaDefinitions(tableName)
        Set indexDefinitions = CatalogTableIndexDefinitions(tableName)
        EnsureCatalogTableExists tableName
        EnsureCatalogFieldsFromSchema tableName, fieldDefinitions
        EnsureManagedTableFieldOrder tableName, fieldDefinitions
        EnsureCatalogIndexesFromSchema tableName, indexDefinitions
    End If
    ApplyDefaultsOwnedLookupDefinitions tableName
End Sub

Private Sub EnsureSimpleLookupTable(ByVal tableName As String, ByVal codeFieldName As String, ByVal displayFieldName As String, Optional ByVal lookupDefinitionIndex As Variant)
    On Error GoTo ErrHandler
    Dim canonicalCodeFieldName As String
    Dim canonicalDisplayFieldName As String
    Dim canonicalFieldNamesResolved As Boolean
    Dim resolvedLookupDefinitionIndex As Object
    Dim fieldDefinitions As Collection
    Dim indexDefinitions As Collection
    If IsObject(lookupDefinitionIndex) Then Set resolvedLookupDefinitionIndex = lookupDefinitionIndex
    If resolvedLookupDefinitionIndex Is Nothing Then Set resolvedLookupDefinitionIndex = CatalogSimpleLookupDefinitionIndex()
    canonicalFieldNamesResolved = CatalogSimpleLookupFieldNames(tableName, canonicalCodeFieldName, canonicalDisplayFieldName, resolvedLookupDefinitionIndex)
    If canonicalFieldNamesResolved = False Then Err.Raise vbObjectError + 9435, "EnsureSimpleLookupTable", "No canonical simple lookup schema exists for the requested table." & vbCrLf & "Table: " & tableName
    If StrComp(canonicalCodeFieldName, codeFieldName, vbTextCompare) <> 0 Or StrComp(canonicalDisplayFieldName, displayFieldName, vbTextCompare) <> 0 Then Err.Raise vbObjectError + 9436, "EnsureSimpleLookupTable", "The requested lookup field names do not match the canonical lookup-table definition." & vbCrLf & "Table: " & tableName & vbCrLf & "Expected: " & canonicalCodeFieldName & " / " & canonicalDisplayFieldName & vbCrLf & "Requested: " & codeFieldName & " / " & displayFieldName
    If B1ColdCreatedStructuralProofAvailable(tableName) Then
        RecordB1ColdCreateStructuralBypass tableName, 4
        Exit Sub
    End If
    Set fieldDefinitions = CatalogTableSchemaDefinitions(tableName, resolvedLookupDefinitionIndex)
    Set indexDefinitions = CatalogTableIndexDefinitions(tableName, resolvedLookupDefinitionIndex)
    EnsureCatalogTableExists tableName
    EnsureCatalogFieldsFromSchema tableName, fieldDefinitions, resolvedLookupDefinitionIndex
    EnsureManagedTableFieldOrder tableName, fieldDefinitions
    EnsureCatalogIndexesFromSchema tableName, indexDefinitions, resolvedLookupDefinitionIndex
    Exit Sub
ErrHandler:
    Dim originalErrNumber As Long
    Dim originalErrDescription As String
    originalErrNumber = Err.Number
    originalErrDescription = Err.Description
    Err.Raise originalErrNumber, "EnsureSimpleLookupTable", "Unable to create or repair lookup table." & vbCrLf & "Table: " & tableName & vbCrLf & "Code field: " & codeFieldName & vbCrLf & "Description: " & originalErrDescription
End Sub

