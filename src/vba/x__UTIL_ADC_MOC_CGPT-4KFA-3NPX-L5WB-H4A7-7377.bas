Private Function Part8FamilyCurrentToken(ByVal db As DAO.Database, ByVal contractVersion As String, ByVal tableNames As Variant, ByVal includeRelationships As Boolean, ByRef allRequiredTablesPresent As Boolean, ByRef metrics As TPart8Metrics, Optional ByVal optionalTableNames As Variant) As String
    On Error GoTo ErrHandler
    Dim expectedNames As Object
    Dim relationRows As Object
    Dim relationField As DAO.Field
    Dim rel As DAO.Relation
    Dim relationText As String
    Dim sortedKeys As Variant
    Dim tableName As Variant
    Dim tableWasFound As Boolean
    Dim payloadText As String
    Dim tableHeaderText As String
    Dim i As Long
    ' INTENTIONAL KEYED LOOKUP: expectedNames provides keyed membership/lookup over source rows or state already read by Part8FamilyCurrentToken; it is a derived access path, not a second authority.
    Set expectedNames = CreateObject("Scripting.Dictionary")
    expectedNames.CompareMode = vbTextCompare
    payloadText = contractVersion & "|"
    allRequiredTablesPresent = True
    For Each tableName In tableNames
        expectedNames(CStr(tableName)) = True
        tableHeaderText = Part8TableHeaderText(db, CStr(tableName), tableWasFound)
        payloadText = payloadText & FingerprintTokenPart(tableHeaderText)
        metrics.TableHeadersInspected = metrics.TableHeadersInspected + 1
        If tableWasFound = False Then allRequiredTablesPresent = False
    Next tableName
    If Not isMissing(optionalTableNames) Then
        For Each tableName In optionalTableNames
            expectedNames(CStr(tableName)) = True
            tableHeaderText = Part8TableHeaderText(db, CStr(tableName), tableWasFound)
        payloadText = payloadText & FingerprintTokenPart(tableHeaderText)
            metrics.TableHeadersInspected = metrics.TableHeadersInspected + 1
        Next tableName
    End If
    If includeRelationships Then
        ' INTENTIONAL KEYED LOOKUP: relationRows provides keyed membership/lookup over source rows or state already read by Part8FamilyCurrentToken; it is a derived access path, not a second authority.
        Set relationRows = CreateObject("Scripting.Dictionary")
        relationRows.CompareMode = vbTextCompare
        For Each rel In db.Relations
            If expectedNames.Exists(CStr(rel.Table)) Or expectedNames.Exists(CStr(rel.foreignTable)) Then
                relationText = UCase$(rel.Name) & Chr$(30) & CStr(rel.Attributes) & Chr$(30) & UCase$(rel.Table) & Chr$(30) & UCase$(rel.foreignTable)
                For Each relationField In rel.fields
                    relationText = relationText & Chr$(29) & UCase$(relationField.Name) & Chr$(30) & UCase$(CStr(relationField.ForeignName))
                Next relationField
                relationRows(UCase$(rel.Name)) = relationText
                metrics.RelationshipDefinitionsInspected = metrics.RelationshipDefinitionsInspected + 1
            End If
        Next rel
        payloadText = payloadText & "RELATIONCOUNT=" & CStr(relationRows.count) & "|"
        If relationRows.count > 0 Then
            sortedKeys = SortedDictionaryKeys(relationRows)
            For i = LBound(sortedKeys) To UBound(sortedKeys)
                relationText = CStr(relationRows(sortedKeys(i)))
                payloadText = payloadText & FingerprintTokenPart(relationText)
            Next i
        End If
    End If
    Part8FamilyCurrentToken = FingerprintFromPayload(payloadText)
    Exit Function
ErrHandler:
    Err.Raise Err.Number, "Part8FamilyCurrentToken", "Could not calculate a B1 structural family token." & vbCrLf & "Contract: " & contractVersion & vbCrLf & "Err.Source: " & Err.Source & vbCrLf & "Err.Description: " & Err.Description
End Function

Private Function Part8FamilyProofMatches(ByVal db As DAO.Database, ByVal propertyName As String, ByVal contractVersion As String, ByVal tableNames As Variant, ByVal includeRelationships As Boolean, ByRef currentToken As String, ByRef metrics As TPart8Metrics, Optional ByVal optionalTableNames As Variant) As Boolean
    Dim allRequiredTablesPresent As Boolean
    Dim propertyExists As Boolean
    Dim storedToken As String
    currentToken = vbNullString
    storedToken = DatabaseTextPropertyValue(db, propertyName, propertyExists)
    If propertyExists = False Or Len(storedToken) = 0 Then Exit Function
    If isMissing(optionalTableNames) Then
        currentToken = Part8FamilyCurrentToken(db, contractVersion, tableNames, includeRelationships, allRequiredTablesPresent, metrics)
    Else
        currentToken = Part8FamilyCurrentToken(db, contractVersion, tableNames, includeRelationships, allRequiredTablesPresent, metrics, optionalTableNames)
    End If
    If allRequiredTablesPresent = False Then Exit Function
    Part8FamilyProofMatches = (StrComp(storedToken, currentToken, vbBinaryCompare) = 0)
End Function

Private Sub Part8PersistFamilyProof(ByVal db As DAO.Database, ByVal propertyName As String, ByVal contractVersion As String, ByVal tableNames As Variant, ByVal includeRelationships As Boolean, ByRef metrics As TPart8Metrics, Optional ByVal optionalTableNames As Variant, Optional ByRef persistedToken As Variant)
    Dim allRequiredTablesPresent As Boolean
    Dim currentToken As String
    If isMissing(optionalTableNames) Then
        currentToken = Part8FamilyCurrentToken(db, contractVersion, tableNames, includeRelationships, allRequiredTablesPresent, metrics)
    Else
        currentToken = Part8FamilyCurrentToken(db, contractVersion, tableNames, includeRelationships, allRequiredTablesPresent, metrics, optionalTableNames)
    End If
    If allRequiredTablesPresent = False Then Err.Raise vbObjectError + 9494, "Part8PersistFamilyProof", "A B1 structural family repair completed without every required table being present." & vbCrLf & "Contract: " & contractVersion
    Call EnsureDaoPropertyValue(db, propertyName, dbText, currentToken, "Part8PersistFamilyProof")
    If isMissing(persistedToken) = False Then persistedToken = currentToken
End Sub

