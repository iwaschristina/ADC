    mBuildRepairHelpDocumentMacrosCatalogPredecessorSnapshotDetail = vbNullString
    mBuildRepairHelpDocumentMacrosCatalogPredecessorSnapshotTiming = vbNullString
    mBuildRepairHelpDocumentMacrosCatalogPredecessorPersistedValidationToken = vbNullString
    mBuildRepairHelpDocumentMacrosCatalogScopedProofCurrent = False
End Sub

' Purpose: Initializes build repair help document macros catalog predecessor proof scope, coordinating `CatalogSetupTraceIdentity` and `TraceRunActive` as the implementation requires.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
' Returns: None (Sub). The procedure communicates its result through its database, UI, trace, or module-state side effects and raises errors where its implementation requires it.
Public Sub BeginBuildRepairHelpDocumentMacrosCatalogPredecessorProofScope()
    'Begins one Build/Repair Help Document Macros pre-mutation Catalog proof scope. The initial strict predecessor attempt owns the single current snapshot calculation; the scoped fallback may only reuse that same
    'trace-bound evidence.
    On Error GoTo ErrHandler
    Dim activeTraceRunID As String
    activeTraceRunID = CatalogSetupTraceIdentity()
    If TraceRunActive() = False Or Len(activeTraceRunID) = 0 Or StrComp(activeTraceRunID, "NoActiveTrace", vbBinaryCompare) = 0 Then Err.Raise vbObjectError + 9590, "BeginBuildRepairHelpDocumentMacrosCatalogPredecessorProofScope", "An active trace-run identity is required for the Build/Repair Help Document Macros Catalog predecessor proof scope."
    ClearBuildRepairHelpDocumentMacrosCatalogPredecessorProofScopeState
    mBuildRepairHelpDocumentMacrosCatalogPredecessorScopeActive = True
    mBuildRepairHelpDocumentMacrosCatalogPredecessorTraceRunID = activeTraceRunID
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrDescription = Err.Description
    ClearBuildRepairHelpDocumentMacrosCatalogPredecessorProofScopeState
    Err.Raise savedErrNumber, "BeginBuildRepairHelpDocumentMacrosCatalogPredecessorProofScope", savedErrDescription
End Sub

' Purpose: Closes build repair help document macros catalog predecessor proof scope, coordinating `End` as the implementation requires.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
' Returns: None (Sub). The procedure communicates its result through its database, UI, trace, or module-state side effects and raises errors where its implementation requires it.
Public Sub EndBuildRepairHelpDocumentMacrosCatalogPredecessorProofScope()
    ' Wrapper purpose: Public lifecycle endpoint that releases the operation-scoped Catalog predecessor-proof snapshot after Build/Repair Help Document Macros finishes using it.
    ' Why retained: Retained so REVIEW can close MOC-owned private lifecycle state without reaching into MOC's reset implementation.
    'Releases the operation-scoped current Catalog snapshot after Build/Repair Help Document Macros has established or rejected its pre-mutation predecessor proof.
    ClearBuildRepairHelpDocumentMacrosCatalogPredecessorProofScopeState
End Sub

Private Function CaptureBuildRepairHelpDocumentMacrosCatalogPredecessorCurrentSnapshot(ByRef currentToken As String, ByRef detailText As String, ByRef timingDetail As String) As Boolean
    On Error GoTo ErrHandler
    Dim snapshot As CatalogDomainSnapshot
    Dim compactDetail As String
    Dim currentCompactStateToken As String
    Dim snapshotReady As Boolean
    Dim exhaustiveTiming As String
    currentToken = vbNullString
    detailText = vbNullString
    timingDetail = vbNullString
    If mBuildRepairHelpDocumentMacrosCatalogPredecessorScopeActive = False Then
        detailText = "The Build/Repair Help Document Macros Catalog predecessor proof scope is not active."
        Exit Function
    End If
    If StrComp(mBuildRepairHelpDocumentMacrosCatalogPredecessorTraceRunID, CatalogSetupTraceIdentity(), vbBinaryCompare) <> 0 Then
        detailText = "The Build/Repair Help Document Macros Catalog predecessor proof scope belongs to a different trace run."
        Exit Function
    End If
    If mBuildRepairHelpDocumentMacrosCatalogPredecessorSnapshotAvailable Then
        currentToken = CatalogValidationToken(mBuildRepairHelpDocumentMacrosCatalogPredecessorSnapshot)
        detailText = mBuildRepairHelpDocumentMacrosCatalogPredecessorSnapshotDetail
        timingDetail = mBuildRepairHelpDocumentMacrosCatalogPredecessorSnapshotTiming
        CaptureBuildRepairHelpDocumentMacrosCatalogPredecessorCurrentSnapshot = True
        Exit Function
    End If
    If TryCatalogCompactSnapshotFastPath(snapshot, compactDetail, currentCompactStateToken, snapshotReady, timingDetail) = False Then
        If snapshotReady = False Then
            If CalculateCatalogDomainSnapshot(snapshot, exhaustiveTiming) = False Then
                detailText = "The current Catalog snapshot could not be calculated for the Build/Repair Help Document Macros predecessor proof." & vbCrLf & snapshot.failureDetail
                If Len(compactDetail) > 0 Then detailText = detailText & vbCrLf & compactDetail
                If Len(timingDetail) > 0 Then detailText = detailText & vbCrLf & timingDetail
                If Len(exhaustiveTiming) > 0 Then detailText = detailText & vbCrLf & exhaustiveTiming
                Exit Function
            End If
            timingDetail = SharedText_AppendNonBlankLine(timingDetail, exhaustiveTiming)
        End If
    End If
    If CatalogSnapshotHasRequiredFingerprints(snapshot) = False Then
        detailText = "The current Catalog snapshot for the Build/Repair Help Document Macros predecessor proof is incomplete."
        If Len(snapshot.failureDetail) > 0 Then detailText = detailText & vbCrLf & snapshot.failureDetail
        Exit Function
    End If
    CatalogCopyDomainSnapshot snapshot, mBuildRepairHelpDocumentMacrosCatalogPredecessorSnapshot
    mBuildRepairHelpDocumentMacrosCatalogPredecessorSnapshotAvailable = True
    mBuildRepairHelpDocumentMacrosCatalogPredecessorSnapshotDetail = compactDetail
    mBuildRepairHelpDocumentMacrosCatalogPredecessorSnapshotTiming = timingDetail
    currentToken = CatalogValidationToken(mBuildRepairHelpDocumentMacrosCatalogPredecessorSnapshot)
    detailText = compactDetail
    CaptureBuildRepairHelpDocumentMacrosCatalogPredecessorCurrentSnapshot = True
    Exit Function
ErrHandler:
    detailText = "Could not capture the current Catalog snapshot for the Build/Repair Help Document Macros predecessor proof. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
End Function

Private Function CurrentCatalogValidationToken() As String
    'Returns a trace-current setup-validated token when available, otherwise calculates one incremental broad-domain snapshot and falls back to exhaustive work only when that calculation itself fails. Build/Repair
    'Help Document Macros proof scope forces one fresh operation snapshot and reuses it only within that scope.
    On Error GoTo ErrHandler
    Dim snapshot As CatalogDomainSnapshot
    Dim compactDetail As String
    Dim currentCompactStateToken As String
    Dim heartbeatOwned As Boolean
    Dim snapshotReady As Boolean
    Dim currentTraceRunID As String
    Dim scopedTimingDetail As String
    Dim scopedCurrentToken As String
    If mCatalogSetupPart7HeartbeatActive = False Then
        heartbeatOwned = True
        mCatalogSetupPart7HeartbeatActive = True
        mCatalogSetupPart7StartedTimer = Timer
    End If
    PulseCatalogSetupPart7 "checking the current validated catalog token."
    currentTraceRunID = CatalogSetupTraceIdentity()
    If mBuildRepairHelpDocumentMacrosCatalogPredecessorScopeActive Then
        If StrComp(mBuildRepairHelpDocumentMacrosCatalogPredecessorTraceRunID, currentTraceRunID, vbBinaryCompare) <> 0 Then
            ClearBuildRepairHelpDocumentMacrosCatalogPredecessorProofScopeState
            Err.Raise vbObjectError + 9591, "CurrentCatalogValidationToken", "The active Build/Repair Help Document Macros Catalog predecessor proof scope does not match the current trace run."
        End If
        PulseCatalogSetupPart7 "capturing the Build/Repair Help Document Macros trace-current catalog snapshot."
        If CaptureBuildRepairHelpDocumentMacrosCatalogPredecessorCurrentSnapshot(scopedCurrentToken, compactDetail, scopedTimingDetail) = False Then Err.Raise vbObjectError + 9592, "CurrentCatalogValidationToken", compactDetail
        CurrentCatalogValidationToken = scopedCurrentToken
        GoTo Complete
    End If
    If mCatalogSetupStateInitialized And mCatalogSetupValidationMatches And (mCatalogSetupContextActive Or TraceRunActive()) Then
        If StrComp(mCatalogSetupTraceRunID, currentTraceRunID, vbBinaryCompare) = 0 Then
            PulseCatalogSetupPart7 "reusing the trace-current setup-validated catalog snapshot."
            CurrentCatalogValidationToken = CatalogValidationToken(mCatalogSetupSnapshot)
            GoTo Complete
        End If
    End If
    PulseCatalogSetupPart7 "checking the incremental exact-domain gate before any fail-closed exhaustive fallback."
    If TryCatalogCompactSnapshotFastPath(snapshot, compactDetail, currentCompactStateToken, snapshotReady) Then
        PulseCatalogSetupPart7 "compact catalog state matched."
        CurrentCatalogValidationToken = CatalogValidationToken(snapshot)
        GoTo Complete
    End If
    If snapshotReady = False Then
        PulseCatalogSetupPart7 "incremental catalog state was unavailable; calculating the fail-closed exhaustive snapshot."
        If CalculateCatalogDomainSnapshot(snapshot) = False Then Err.Raise vbObjectError + 9411, "CurrentCatalogValidationToken", snapshot.failureDetail
    Else
        PulseCatalogSetupPart7 "incremental catalog state identified changed domains without a second complete pass."
    End If
    CurrentCatalogValidationToken = CatalogValidationToken(snapshot)
    PulseCatalogSetupPart7 "current catalog validation token calculation completed."
Complete:
    If heartbeatOwned Then
        mCatalogSetupPart7HeartbeatActive = False
        mCatalogSetupPart7StartedTimer = 0
    End If
    Exit Function
ErrHandler:
    If heartbeatOwned Then
        mCatalogSetupPart7HeartbeatActive = False
        mCatalogSetupPart7StartedTimer = 0
    End If
    Err.Raise Err.Number, "CurrentCatalogValidationToken", "Could not calculate the current Managed Object Catalog validation token." & vbCrLf & Err.Description
End Function

Private Function PhysicalFormCatalogRowsFromInventory(ByVal physicalInventory As Collection, ByRef formCount As Long) As Collection
    'Derived projection of the one authoritative physical CodeDb form inventory. This function must never enumerate Access forms independently.
    Dim rows As New Collection
    Dim rowData As Variant
    formCount = 0
    If physicalInventory Is Nothing Then Err.Raise vbObjectError + 9817, "PhysicalFormCatalogRowsFromInventory", "The authoritative physical-form inventory is missing."
    For Each rowData In physicalInventory
        PumpSetupResponsiveness
        rows.Add Array(CStr(rowData(PHYSICAL_FORM_INV_NAME)), ADCAT_OBJECT_TYPE_FORM)
        formCount = formCount + 1
    Next rowData
    Set PhysicalFormCatalogRowsFromInventory = rows
End Function

Private Sub PersistCompleteCatalogDomainSnapshotForSetup(ByRef snapshot As CatalogDomainSnapshot)
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim inventoryPartitionToken As String
    Dim partitionFailureDetail As String
    Dim validationToken As String
    Dim compactToken As String
    Dim inventoryCacheKey As String
    Dim payloadCacheKey As String
    Set db = ResolveCatalogDb()
    inventoryPartitionToken = CatalogInventoryPartitionToken(db, partitionFailureDetail)
    If Len(inventoryPartitionToken) = 0 Then Err.Raise vbObjectError + 9584, "PersistCompleteCatalogDomainSnapshotForSetup", IIf(Len(partitionFailureDetail) = 0, "The complete inventory partition token is blank.", partitionFailureDetail)
    validationToken = CatalogValidationToken(snapshot)
    compactToken = FingerprintFromPayload(CATALOG_INCREMENTAL_GATE_VERSION & "|" & CatalogValidationToken(snapshot))
    Call EnsureDaoPropertyValue(db, CATALOG_SCHEMA_FINGERPRINT_PROPERTY, dbText, snapshot.SchemaFingerprint, "PersistCompleteCatalogDomainSnapshotForSetup")
    Call EnsureDaoPropertyValue(db, CATALOG_DEFAULTS_FINGERPRINT_PROPERTY, dbText, snapshot.DefaultsFingerprint, "PersistCompleteCatalogDomainSnapshotForSetup")
    Call EnsureDaoPropertyValue(db, CATALOG_NON_HELP_DEFAULTS_FINGERPRINT_PROPERTY, dbText, snapshot.NonHelpDefaultsFingerprint, "PersistCompleteCatalogDomainSnapshotForSetup")
    Call EnsureDaoPropertyValue(db, CATALOG_HELP_DOCUMENTS_FINGERPRINT_PROPERTY, dbText, snapshot.HelpDocumentsFingerprint, "PersistCompleteCatalogDomainSnapshotForSetup")
    Call EnsureDaoPropertyValue(db, CATALOG_HELP_SETUP_OWNERSHIP_PROPERTY, dbText, CatalogCurrentSetupHelpOwnershipToken(), "PersistCompleteCatalogDomainSnapshotForSetup")
    Call EnsureDaoPropertyValue(db, CATALOG_INVENTORY_FINGERPRINT_PROPERTY, dbText, snapshot.InventoryFingerprint, "PersistCompleteCatalogDomainSnapshotForSetup")
    Call EnsureDaoPropertyValue(db, CATALOG_CORE_INVENTORY_FINGERPRINT_PROPERTY, dbText, snapshot.CoreInventoryFingerprint, "PersistCompleteCatalogDomainSnapshotForSetup")
    Call EnsureDaoPropertyValue(db, CATALOG_FORMS_INVENTORY_FINGERPRINT_PROPERTY, dbText, snapshot.FormsInventoryFingerprint, "PersistCompleteCatalogDomainSnapshotForSetup")
    Call EnsureDaoPropertyValue(db, CATALOG_UI_INVENTORY_FINGERPRINT_PROPERTY, dbText, snapshot.UiInventoryFingerprint, "PersistCompleteCatalogDomainSnapshotForSetup")
    Call EnsureDaoPropertyValue(db, CATALOG_MACRO_INVENTORY_FINGERPRINT_PROPERTY, dbText, snapshot.MacroInventoryFingerprint, "PersistCompleteCatalogDomainSnapshotForSetup")
    Call EnsureDaoPropertyValue(db, CATALOG_DEPENDENCY_FINGERPRINT_PROPERTY, dbText, snapshot.DependencyFingerprint, "PersistCompleteCatalogDomainSnapshotForSetup")
    Call EnsureDaoPropertyValue(db, CATALOG_PAYLOAD_FINGERPRINT_PROPERTY, dbText, snapshot.PayloadFingerprint, "PersistCompleteCatalogDomainSnapshotForSetup")
    Call EnsureDaoPropertyValue(db, CATALOG_CORE_PAYLOAD_FINGERPRINT_PROPERTY, dbText, snapshot.CorePayloadFingerprint, "PersistCompleteCatalogDomainSnapshotForSetup")
    Call EnsureDaoPropertyValue(db, CATALOG_FORMS_PAYLOAD_FINGERPRINT_PROPERTY, dbText, snapshot.FormsPayloadFingerprint, "PersistCompleteCatalogDomainSnapshotForSetup")
    Call EnsureDaoPropertyValue(db, CATALOG_UI_PAYLOAD_FINGERPRINT_PROPERTY, dbText, snapshot.UiPayloadFingerprint, "PersistCompleteCatalogDomainSnapshotForSetup")
    Call EnsureDaoPropertyValue(db, CATALOG_MACRO_PAYLOAD_FINGERPRINT_PROPERTY, dbText, snapshot.MacroPayloadFingerprint, "PersistCompleteCatalogDomainSnapshotForSetup")
    Call EnsureDaoPropertyValue(db, CATALOG_UI_FINGERPRINT_PROPERTY, dbText, snapshot.UiFingerprint, "PersistCompleteCatalogDomainSnapshotForSetup")
    Call EnsureDaoPropertyValue(db, CATALOG_FORMS_FINGERPRINT_PROPERTY, dbText, snapshot.FormsFingerprint, "PersistCompleteCatalogDomainSnapshotForSetup")
    Call EnsureDaoPropertyValue(db, CATALOG_QUERY_FINGERPRINT_PROPERTY, dbText, snapshot.QueryFingerprint, "PersistCompleteCatalogDomainSnapshotForSetup")
    If Len(snapshot.operationalHistoryFingerprint) > 0 Then Call EnsureDaoPropertyValue(db, CATALOG_OPERATIONAL_HISTORY_FINGERPRINT_PROPERTY, dbText, snapshot.operationalHistoryFingerprint, "PersistCompleteCatalogDomainSnapshotForSetup")
    If Len(snapshot.diagnosticHistoryFingerprint) > 0 Then Call EnsureDaoPropertyValue(db, CATALOG_DIAGNOSTIC_HISTORY_FINGERPRINT_PROPERTY, dbText, snapshot.diagnosticHistoryFingerprint, "PersistCompleteCatalogDomainSnapshotForSetup")
    Call EnsureDaoPropertyValue(db, CATALOG_VALIDATION_TOKEN_PROPERTY, dbText, validationToken, "PersistCompleteCatalogDomainSnapshotForSetup")
    Call EnsureDaoPropertyValue(db, CATALOG_COMPACT_STATE_TOKEN_PROPERTY, dbText, compactToken, "PersistCompleteCatalogDomainSnapshotForSetup")
    Call EnsureDaoPropertyValue(db, CATALOG_INVENTORY_PARTITION_TOKEN_PROPERTY, dbText, inventoryPartitionToken, "PersistCompleteCatalogDomainSnapshotForSetup")
    inventoryCacheKey = snapshot.InventoryFingerprint & "|" & inventoryPartitionToken
    payloadCacheKey = snapshot.PayloadFingerprint & "|" & inventoryPartitionToken
    PersistCatalogObservedPropertySet db, inventoryCacheKey, CATALOG_OBSERVED_INVENTORY_KEY_PROPERTY, CATALOG_OBSERVED_CORE_INVENTORY_PROPERTY, CATALOG_OBSERVED_FORMS_INVENTORY_PROPERTY, CATALOG_OBSERVED_UI_INVENTORY_PROPERTY, CATALOG_OBSERVED_MACRO_INVENTORY_PROPERTY, snapshot.CoreInventoryFingerprint, snapshot.FormsInventoryFingerprint, snapshot.UiInventoryFingerprint, snapshot.MacroInventoryFingerprint
    PersistCatalogObservedPropertySet db, payloadCacheKey, CATALOG_OBSERVED_PAYLOAD_KEY_PROPERTY, CATALOG_OBSERVED_CORE_PAYLOAD_PROPERTY, CATALOG_OBSERVED_FORMS_PAYLOAD_PROPERTY, CATALOG_OBSERVED_UI_PAYLOAD_PROPERTY, CATALOG_OBSERVED_MACRO_PAYLOAD_PROPERTY, snapshot.CorePayloadFingerprint, snapshot.FormsPayloadFingerprint, snapshot.UiPayloadFingerprint, snapshot.MacroPayloadFingerprint
    CatalogCopyDomainSnapshot snapshot, mCatalogSetupSnapshot
    mCatalogSetupTraceRunID = CatalogSetupTraceIdentity()
    mCatalogSetupStateInitialized = True
    mCatalogSetupSchemaMatches = True
    mCatalogSetupDefaultsMatches = True
    mCatalogSetupInventoryMatches = True
    mCatalogSetupCoreInventoryMatches = True
    mCatalogSetupFormsInventoryMatches = True
    mCatalogSetupUiInventoryMatches = True
    mCatalogSetupMacroInventoryMatches = True
    mCatalogSetupDependencyMatches = True
    mCatalogSetupPayloadMatches = True
    mCatalogSetupCorePayloadMatches = True
    mCatalogSetupFormsPayloadMatches = True
    mCatalogSetupUiPayloadMatches = True
    mCatalogSetupMacroPayloadMatches = True
    mCatalogSetupUiMatches = True
    mCatalogSetupFormsMatches = True
    mCatalogSetupQueryMatches = True
    mCatalogSetupValidationMatches = True
    mCatalogSetupDefinitionsComplete = True
    mCatalogSetupDirtyDomainMask = 0
    mCatalogSetupCompactStateToken = compactToken
    Exit Sub
ErrHandler:
    Err.Raise Err.Number, "PersistCompleteCatalogDomainSnapshotForSetup", "Could not persist the authoritative complete logical Managed Object Catalog state, including Forms." & vbCrLf & Err.Description
End Sub

 ' Purpose: Refreshes complete catalog state after authoritative Setup F1 dependency reconciliation without taking ownership of descriptions, Ribbon, or Navigation Pane state.
' Public role: Inter-module public API. Setup F1 calls this after MAC_Deps reconciliation so later phases consume the exact dependency-aware complete catalog snapshot.
Public Function RefreshCompleteCatalogStateAfterDependencyWorkForSetup(Optional ByRef detailText As String = vbNullString, Optional ByRef refreshedCatalogToken As String = vbNullString) As Boolean
    RequireSetupDomainMutationAllowed SETUP_DOMAIN_F1_DERIVED_CATALOG_REFRESH, "RefreshCompleteCatalogStateAfterDependencyWorkForSetup"
    On Error GoTo ErrHandler
    Dim snapshot As CatalogDomainSnapshot
    Dim currentCompactStateToken As String
    Dim snapshotReady As Boolean
    Dim comparisonDetail As String
    Dim timingDetail As String
    Dim operationTimer As Single
    operationTimer = Timer
    refreshedCatalogToken = vbNullString
    If TryCatalogCompactSnapshotFastPath(snapshot, comparisonDetail, currentCompactStateToken, snapshotReady, timingDetail) = False Then
        If snapshotReady = False Then
            If CalculateCatalogDomainSnapshot(snapshot, timingDetail) = False Then Err.Raise vbObjectError + 9612, "RefreshCompleteCatalogStateAfterDependencyWorkForSetup", snapshot.failureDetail
        End If
    End If
    PersistCompleteCatalogDomainSnapshotForSetup snapshot
    refreshedCatalogToken = CatalogValidationToken(snapshot)
    If Len(refreshedCatalogToken) = 0 Then Err.Raise vbObjectError + 9613, "RefreshCompleteCatalogStateAfterDependencyWorkForSetup", "The refreshed complete-catalog snapshot did not produce a validation token."
    If TraceRunActive() Then
        mCompleteCatalogSameRunRibbonHandoffToken = refreshedCatalogToken
        mCompleteCatalogSameRunRibbonHandoffTraceRunID = GetActiveOrLastTraceRunID()
    End If
    detailText = "F1 refreshed the authoritative complete catalog state after managed-object dependency reconciliation. Later owner-phase proofs were not rewritten." & vbCrLf & "CatalogValidation=" & refreshedCatalogToken
    If Len(comparisonDetail) > 0 Then detailText = detailText & vbCrLf & comparisonDetail
    If Len(timingDetail) > 0 Then detailText = detailText & vbCrLf & timingDetail
    detailText = detailText & vbCrLf & "Elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer))
    RefreshCompleteCatalogStateAfterDependencyWorkForSetup = True
    Exit Function
ErrHandler:
    refreshedCatalogToken = vbNullString
    detailText = "Could not refresh the complete catalog state after F1 dependency reconciliation. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
End Function

' Purpose: Refreshes complete catalog state after description work for setup.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   detailText (Output Optional; String): Receives diagnostic detail text used to explain validation, lookup, recovery, or failure results to the caller. Default: vbNullString.
'   refreshedCatalogToken (Output Optional; String): Receives the refreshed catalog token returned by `CatalogValidationToken` after this procedure completes its validation/resolution work. Default: vbNullString.
' Returns: Boolean: True on the function's affirmative/success branch for refresh complete catalog state after description work for setup; False on its explicit negative, unavailable, rejected, or handled-failure
'     branch.
'   rejection, or not-applicable path.
Public Function RefreshCompleteCatalogStateAfterDescriptionWorkForSetup(Optional ByRef detailText As String = vbNullString, Optional ByRef refreshedCatalogToken As String = vbNullString) As Boolean
    'Refreshes shared complete-catalog derived state after authoritative G1 Description mutations without rerunning D4 placement validation. The shared Ribbon handoff advances; D4-owned proofs do not.
    RequireSetupDomainMutationAllowed SETUP_DOMAIN_G1_DERIVED_CATALOG_REFRESH, "RefreshCompleteCatalogStateAfterDescriptionWorkForSetup"
    On Error GoTo ErrHandler
    Dim snapshot As CatalogDomainSnapshot
    Dim currentCompactStateToken As String
    Dim snapshotReady As Boolean
    Dim comparisonDetail As String
    Dim timingDetail As String
    Dim operationTimer As Single
    operationTimer = Timer
    refreshedCatalogToken = vbNullString
    If TryCatalogCompactSnapshotFastPath(snapshot, comparisonDetail, currentCompactStateToken, snapshotReady, timingDetail) = False Then
        If snapshotReady = False Then
            If CalculateCatalogDomainSnapshot(snapshot, timingDetail) = False Then Err.Raise vbObjectError + 9589, "RefreshCompleteCatalogStateAfterDescriptionWorkForSetup", snapshot.failureDetail
        End If
    End If
    PersistCompleteCatalogDomainSnapshotForSetup snapshot
    refreshedCatalogToken = CatalogValidationToken(snapshot)
    If Len(refreshedCatalogToken) = 0 Then Err.Raise vbObjectError + 9610, "RefreshCompleteCatalogStateAfterDescriptionWorkForSetup", "The refreshed complete-catalog snapshot did not produce a validation token."
