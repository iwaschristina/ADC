Private Sub DefaultNavigationPaneGroup(ByVal navPaneGroupKey As String, ByVal navPaneGroupName As String, ByVal descriptionText As String, ByVal SettingKey As String, ByVal ConfigOwnerDatabaseRole As String, ByVal objectTypeScope As String, ByVal groupPurpose As String, ByVal SortOrder As Long, ByVal repairDefaultRows As Boolean)
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim sqlText As String
    Dim isNewRow As Boolean
    Dim rowChanged As Boolean
    Dim forceAuthoritativeGroupName As Boolean
    Dim forceAuthoritativeGroupNameChange As Boolean
    Dim defaultShowOnRibbon As Boolean
    Dim defaultRibbonTabKey As String
    Dim defaultRibbonTabLabel As String
    Dim defaultRibbonGroupLabel As String
    Dim defaultRibbonGroupSortOrder As Long
    Set db = ResolveCatalogDb()
    forceAuthoritativeGroupName = (StrComp(Trim$(objectTypeScope), ADCAT_OBJECT_TYPE_MACRO, vbTextCompare) = 0 And StrComp(Trim$(groupPurpose), NAVIGATION_PANE_GROUP_PURPOSE_SYSTEM_MACROS, vbTextCompare) = 0)
    defaultShowOnRibbon = NavigationPaneGroupShowOnRibbon(navPaneGroupName, groupPurpose)
    defaultRibbonTabKey = NavigationPaneGroupRibbonTabKey(navPaneGroupName, groupPurpose)
    defaultRibbonTabLabel = NavigationPaneGroupRibbonTabLabel(defaultRibbonTabKey)
    defaultRibbonGroupLabel = NavigationPaneGroupRibbonGroupLabel(navPaneGroupName, navPaneGroupKey)
    defaultRibbonGroupSortOrder = SortOrder
    sqlText = "SELECT * FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_NavigationPaneGroups") & "] WHERE [" & FIELD_NAVIGATION_PANE_GROUP_KEY & "]=" & SharedDao_SqlQuote(navPaneGroupKey) & ";"
    Set rs = db.OpenRecordset(sqlText, dbOpenDynaset)
    isNewRow = rs.EOF
    If isNewRow Then
        rs.AddNew
        rs.fields(FIELD_NAVIGATION_PANE_GROUP_KEY).value = navPaneGroupKey
        rs.fields(FIELD_NAVIGATION_PANE_GROUP_NAME).value = navPaneGroupName
        rs.fields(FIELD_GROUP_DESCRIPTION).value = Shared_String_ConvertToNullIfBlank(descriptionText)
        rs.fields(FIELD_SETTING_KEY).value = Shared_String_ConvertToNullIfBlank(SettingKey)
        rs.fields(FIELD_CONFIG_OWNER_DATABASE_ROLE).value = Shared_String_ConvertToNullIfBlank(ConfigOwnerDatabaseRole)
        rs.fields(FIELD_OBJECT_TYPE_SCOPE).value = Shared_String_ConvertToNullIfBlank(objectTypeScope)
        rs.fields(FIELD_GROUP_PURPOSE).value = Shared_String_ConvertToNullIfBlank(groupPurpose)
        SetRecordsetFieldValueWithSource rs, FIELD_LOOKUP_ACTIVE, DEFAULT_NAVIGATION_PANE_GROUP_LOOKUP_ACTIVE, "DEFAULT_NAVIGATION_PANE_GROUP_LOOKUP_ACTIVE"
        SetRecordsetFieldValueWithSource rs, FIELD_CREATE_IF_MISSING, DEFAULT_NAVIGATION_PANE_GROUP_CREATE_IF_MISSING, "DEFAULT_NAVIGATION_PANE_GROUP_CREATE_IF_MISSING"
        SetRecordsetFieldValueWithSource rs, FIELD_SHOW_ON_RIBBON, defaultShowOnRibbon, "NavigationPaneGroupShowOnRibbon"
        SetRecordsetFieldValueWithSource rs, FIELD_RIBBON_TAB_KEY, defaultRibbonTabKey, "NavigationPaneGroupRibbonTabKey"
        SetRecordsetFieldValueWithSource rs, FIELD_RIBBON_TAB_LABEL, defaultRibbonTabLabel, "NavigationPaneGroupRibbonTabLabel"
        SetRecordsetFieldValueWithSource rs, FIELD_RIBBON_GROUP_LABEL, defaultRibbonGroupLabel, "NavigationPaneGroupRibbonGroupLabel"
        rs.fields(FIELD_RIBBON_GROUP_SORT_ORDER).value = defaultRibbonGroupSortOrder
        SetRecordsetFieldValueWithSource rs, FIELD_RIBBON_GROUP_VISIBLE, defaultShowOnRibbon, "NavigationPaneGroupShowOnRibbon"
        rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value = SortOrder
        SetRecordsetFieldValueWithSource rs, FIELD_DEFAULT_SOURCE, DEFAULT_RELEVANT_FORM_SOURCE, "DEFAULT_RELEVANT_FORM_SOURCE"
        rs.fields(FIELD_DEFAULTED_ON).value = Now
        rowChanged = True
    Else
        forceAuthoritativeGroupNameChange = forceAuthoritativeGroupName And StrComp(CStr(Nz(rs.fields(FIELD_NAVIGATION_PANE_GROUP_NAME).value, vbNullString)), navPaneGroupName, vbTextCompare) <> 0
        If repairDefaultRows = False And forceAuthoritativeGroupNameChange = False Then
            rs.Close
            Exit Sub
        End If
        rs.Edit
        If forceAuthoritativeGroupNameChange Then rs.fields(FIELD_NAVIGATION_PANE_GROUP_NAME).value = navPaneGroupName
        If repairDefaultRows Then
            If Len(Trim$(CStr(Nz(rs.fields(FIELD_NAVIGATION_PANE_GROUP_NAME).value, vbNullString)))) = 0 Then rs.fields(FIELD_NAVIGATION_PANE_GROUP_NAME).value = navPaneGroupName: rowChanged = True
            If Len(Trim$(CStr(Nz(rs.fields(FIELD_GROUP_DESCRIPTION).value, vbNullString)))) = 0 Then rs.fields(FIELD_GROUP_DESCRIPTION).value = Shared_String_ConvertToNullIfBlank(descriptionText): rowChanged = True
            If Len(Trim$(CStr(Nz(rs.fields(FIELD_SETTING_KEY).value, vbNullString)))) = 0 And Len(Trim$(SettingKey)) > 0 Then rs.fields(FIELD_SETTING_KEY).value = SettingKey: rowChanged = True
            If Len(Trim$(CStr(Nz(rs.fields(FIELD_CONFIG_OWNER_DATABASE_ROLE).value, vbNullString)))) = 0 And Len(Trim$(ConfigOwnerDatabaseRole)) > 0 Then rs.fields(FIELD_CONFIG_OWNER_DATABASE_ROLE).value = ConfigOwnerDatabaseRole: rowChanged = True
            If Len(Trim$(CStr(Nz(rs.fields(FIELD_OBJECT_TYPE_SCOPE).value, vbNullString)))) = 0 And Len(Trim$(objectTypeScope)) > 0 Then rs.fields(FIELD_OBJECT_TYPE_SCOPE).value = objectTypeScope: rowChanged = True
            If StrComp(Trim$(CStr(Nz(rs.fields(FIELD_GROUP_PURPOSE).value, vbNullString))), Trim$(groupPurpose), vbTextCompare) <> 0 Then rs.fields(FIELD_GROUP_PURPOSE).value = Shared_String_ConvertToNullIfBlank(groupPurpose): rowChanged = True
            If IsNull(rs.fields(FIELD_LOOKUP_ACTIVE).value) Then
                SetRecordsetFieldValueWithSource rs, FIELD_LOOKUP_ACTIVE, DEFAULT_NAVIGATION_PANE_GROUP_LOOKUP_ACTIVE, "DEFAULT_NAVIGATION_PANE_GROUP_LOOKUP_ACTIVE"
                rowChanged = True
            End If
            If IsNull(rs.fields(FIELD_CREATE_IF_MISSING).value) Then
                SetRecordsetFieldValueWithSource rs, FIELD_CREATE_IF_MISSING, DEFAULT_NAVIGATION_PANE_GROUP_CREATE_IF_MISSING, "DEFAULT_NAVIGATION_PANE_GROUP_CREATE_IF_MISSING"
                rowChanged = True
            End If
            If IsNull(rs.fields(FIELD_SHOW_ON_RIBBON).value) Then
                SetRecordsetFieldValueWithSource rs, FIELD_SHOW_ON_RIBBON, defaultShowOnRibbon, "NavigationPaneGroupShowOnRibbon"
                rowChanged = True
            End If
            If Len(Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_TAB_KEY).value, vbNullString)))) = 0 Then
                SetRecordsetFieldValueWithSource rs, FIELD_RIBBON_TAB_KEY, defaultRibbonTabKey, "NavigationPaneGroupRibbonTabKey"
                rowChanged = True
            End If
            If Len(Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_TAB_LABEL).value, vbNullString)))) = 0 Then
                SetRecordsetFieldValueWithSource rs, FIELD_RIBBON_TAB_LABEL, defaultRibbonTabLabel, "NavigationPaneGroupRibbonTabLabel"
                rowChanged = True
            End If
            If Len(Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_GROUP_LABEL).value, vbNullString)))) = 0 Then
                SetRecordsetFieldValueWithSource rs, FIELD_RIBBON_GROUP_LABEL, defaultRibbonGroupLabel, "NavigationPaneGroupRibbonGroupLabel"
                rowChanged = True
            End If
            If IsNull(rs.fields(FIELD_RIBBON_GROUP_SORT_ORDER).value) Then rs.fields(FIELD_RIBBON_GROUP_SORT_ORDER).value = defaultRibbonGroupSortOrder: rowChanged = True
            If IsNull(rs.fields(FIELD_RIBBON_GROUP_VISIBLE).value) Then
                SetRecordsetFieldValueWithSource rs, FIELD_RIBBON_GROUP_VISIBLE, defaultShowOnRibbon, "NavigationPaneGroupShowOnRibbon"
                rowChanged = True
            End If
            If IsNull(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value) Then rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value = SortOrder: rowChanged = True
            If Len(Trim$(CStr(Nz(rs.fields(FIELD_DEFAULT_SOURCE).value, vbNullString)))) = 0 Then
                SetRecordsetFieldValueWithSource rs, FIELD_DEFAULT_SOURCE, DEFAULT_RELEVANT_FORM_SOURCE, "DEFAULT_RELEVANT_FORM_SOURCE"
                rowChanged = True
            End If
            If rowChanged Then rs.fields(FIELD_LAST_DEFAULT_REPAIR_ON).value = Now
        End If
    End If
    NormalizeZeroLengthOptionalTextFieldsForRecordsetUpdate rs
    rs.Update
    rs.Close
    Exit Sub
ErrHandler:
    Dim originalErrNumber As Long
    Dim originalErrDescription As String
    originalErrNumber = Err.Number
    originalErrDescription = Err.Description
    Err.Raise originalErrNumber, "DefaultNavigationPaneGroup", "Unable to default " & DEFAULT_UTILITY_LONG_NAME & " Navigation Pane group row without overwriting existing user values." & vbCrLf & "Group key: " & navPaneGroupKey & vbCrLf & "Description: " & originalErrDescription
End Sub

' Purpose: Creates durable Navigation Pane/ribbon management queries. Phase B does not perform physical Navigation Pane grouping.
' Public role: Public dynamic/form expression API. The name is referenced as text outside this module, so Public visibility is required for Access or generated-expression resolution.
' Parameters:
'   showMessage (Input Optional; Boolean): Controls whether the routine displays its normal user-facing status, completion, warning, or error message; False suppresses that presentation while preserving the
'   underlying operation. Default: True.
'   definitionsAlreadyDefaulted (Input Optional; Boolean): Boolean state describing whether definitions already defaulted applies to this invocation; True selects the named condition/path and False selects its
'   complementary/default path. Default: False.
' Returns: None (Sub). The procedure communicates its result through its database, UI, trace, or module-state side effects and raises errors where its implementation requires it.
Public Sub RepairNavigationPaneAndRibbonManagementQueries(Optional ByVal showMessage As Boolean = True, Optional ByVal definitionsAlreadyDefaulted As Boolean = False)
    RequireCatalogMutationRecoveryReady "RepairNavigationPaneAndRibbonManagementQueries"
    'Creates durable Navigation Pane/ribbon management queries. Phase B does not perform physical Navigation Pane grouping.
    On Error GoTo ErrHandler
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    Dim messageText As String
    If CodeDbTableExists(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_NavigationPaneGroups")) = False Then Err.Raise vbObjectError + 8878, "RepairNavigationPaneAndRibbonManagementQueries", "Required table is missing: " & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_NavigationPaneGroups")
    If CodeDbTableExists(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_RIBBON_BUTTON_TARGETS_TABLE_LOGICAL_ID)) = False Then Err.Raise vbObjectError + 8879, "RepairNavigationPaneAndRibbonManagementQueries", "Required table is missing: " & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_RIBBON_BUTTON_TARGETS_TABLE_LOGICAL_ID)
    If CodeDbTableExists(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID)) = False Then Err.Raise vbObjectError + 8880, "RepairNavigationPaneAndRibbonManagementQueries", "Required table is missing: " & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID)
    If CodeDbTableExists(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads")) = False Then Err.Raise vbObjectError + 8881, "RepairNavigationPaneAndRibbonManagementQueries", "Required table is missing: " & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads")
    EnsureCatalogFieldsFromSchema ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID)
    CorePulseProgress "Repair Navigation Pane group management query"
    RepairOrReplaceQueryForSetup ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_NavigationPaneGroups_Management"), NavigationPaneGroupsFormSql(), False
    CorePulseProgress "Repair ribbon group management query"
    RepairOrReplaceQueryForSetup ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_RibbonGroups_Management"), RibbonGroupsFormSql(), False
    CorePulseProgress "Repair editable ribbon managed-object query"
    RepairOrReplaceQueryForSetup ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_ManagedObjects_RibbonManagement"), RibbonManagedObjectsFormSql(), False
