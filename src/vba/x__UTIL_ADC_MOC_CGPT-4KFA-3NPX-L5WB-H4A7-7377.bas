Private Sub AddManagedObjectCatalogValidationFindings(ByRef findings As Collection, Optional ByVal validatePlacement As Boolean = True, Optional ByVal reuseCurrentPlacementSnapshot As Boolean = False)
    Dim placementInvalidCount As Long
    Dim placementCheckedCount As Long
    Dim placementDiagnostic As String
    Dim wrapperValidationTimer As Single
    Dim remainingValidationTimer As Single
    mCatalogLastSystemMacroWrapperValidationElapsedSeconds = 0
    mCatalogLastSystemMacroWrapperValidationDetail = vbNullString
    AddCatalogRequiredObjectFindings findings
    If findings.count > 0 Then Exit Sub
    AddCatalogDuplicateFindings findings
    AddCatalogRequiredValueFindings findings
    AddCatalogLookupIntegrityFindings findings
    AddCanonicalRelationshipFindings findings
    AddCountFinding findings, "Active generated system macro catalog rows are missing active RunCode payload rows.", "SELECT Count(*) AS " & FIELD_CNT & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_ManagedObjectsResolved") & "] AS r WHERE r.[" & FIELD_CATEGORY_CODE & "]=" & SharedDao_SqlQuote(ADCAT_CATEGORY_SYSTEM_MACRO) & " AND r.[" & FIELD_MANAGED_OBJECT_STATUS & "]=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND r." & SQL_FIELD_OBJECT_CATEGORY_STATUS & "=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND Not Exists (SELECT p." & SQL_FIELD_ID & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads") & "] AS p WHERE p.[" & FIELD_MANAGED_OBJECT_ID & "]=r.[" & FIELD_MANAGED_OBJECT_ID & "] AND p.[" & FIELD_PAYLOAD_STATUS & "]=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND Len(Nz(p.[" & FIELD_RUN_CODE_WRAPPER_NAME & _
                "],''))>0);"
    wrapperValidationTimer = Timer
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "AddManagedObjectCatalogValidationFindings", "System Macro wrapper/procedure validation starting.", "Live VBA project validation remains required.", "Strict catalog validation", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros"), "CatalogValidation", "CodeDb", "Performance"
    AddCatalogSystemMacroWrapperFindings findings, mCatalogLastSystemMacroWrapperValidationDetail
    mCatalogLastSystemMacroWrapperValidationElapsedSeconds = ElapsedSecondsFromTimer(wrapperValidationTimer)
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "AddManagedObjectCatalogValidationFindings", "System Macro wrapper/procedure validation completed.", "Elapsed: " & FormattedElapsedSeconds(mCatalogLastSystemMacroWrapperValidationElapsedSeconds) & IIf(Len(mCatalogLastSystemMacroWrapperValidationDetail) = 0, vbNullString, vbCrLf & mCatalogLastSystemMacroWrapperValidationDetail), "Strict catalog validation", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros"), "CatalogValidation", "CodeDb", "Performance"
    remainingValidationTimer = Timer
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "AddManagedObjectCatalogValidationFindings", "Remaining strict catalog validation starting.", "Placement validation=" & CStr(validatePlacement) & vbCrLf & "Reuse current placement snapshot=" & CStr(reuseCurrentPlacementSnapshot), "Strict catalog validation", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogValidation", "CodeDb", "Performance"
    AddCountFinding findings, "AutoExec system macro default is active even though AutoExec remains a placeholder boundary in the Managed Object Catalog.", "SELECT Count(*) AS " & FIELD_CNT & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_ManagedObjectsResolved") & "] WHERE [" & FIELD_CATEGORY_CODE & "]=" & SharedDao_SqlQuote(ADCAT_CATEGORY_SYSTEM_MACRO) & " AND [" & FIELD_MANAGED_OBJECT_STATUS & "]=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND " & SQL_FIELD_OBJECT_NAME & " Like '*AutoExec*';"
    If validatePlacement Then
        placementDiagnostic = BuildManagedObjectPlacementValidationDiagnostic(50, placementInvalidCount, placementCheckedCount, reuseCurrentPlacementSnapshot)
        If placementInvalidCount > 0 Then findings.Add placementDiagnostic
    End If
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "AddManagedObjectCatalogValidationFindings", "Remaining strict catalog validation completed.", "Elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(remainingValidationTimer)) & vbCrLf & "Placement rows checked=" & CStr(placementCheckedCount) & vbCrLf & "Placement invalid rows=" & CStr(placementInvalidCount), "Strict catalog validation", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogValidation", "CodeDb", "Performance"
End Sub

' Purpose: Validates managed object catalog for raise on failure, validate placement.
' Public role: Public dynamic/form expression API. The name is referenced as text outside this module, so Public visibility is required for Access or generated-expression resolution.
' Parameters:
'   showMessage (Input Optional; Boolean): Controls whether the routine displays its normal user-facing status, completion, warning, or error message; False suppresses that presentation while preserving the
'   underlying operation. Default: True.
'   raiseOnFailure (Input Optional; Boolean): When True, enables or requests on failure for this call; when False, the routine follows its normal non-forced/default path. Default: False.
'   validatePlacement (Input Optional; Boolean): Boolean state describing whether validate placement applies to this invocation; True selects the named condition/path and False selects its complementary/default
'   path. Default: True.
'   reuseCurrentPlacementSnapshot (Input Optional; Boolean): When True, enables or requests current placement snapshot for this call; when False, the routine follows its normal non-forced/default path. Default:
'   False.
' Returns: Boolean: True on the function's affirmative/success branch for validate managed object catalog; False on its explicit negative, unavailable, rejected, or handled-failure branch.
Public Function ValidateManagedObjectCatalog(Optional ByVal showMessage As Boolean = True, Optional ByVal raiseOnFailure As Boolean = False, Optional ByVal validatePlacement As Boolean = True, Optional ByVal reuseCurrentPlacementSnapshot As Boolean = False) As Boolean
    'Intended use: Returns the Validate Access Development Console Managed Object Catalog result for direct, query, form, or required cross-module callers.
    On Error GoTo ErrHandler
    Dim findings As Collection
    Dim messageText As String
    Dim failureMessageAlreadyShown As Boolean
    Dim progressStarted As Boolean
    progressStarted = False
    ' INTENTIONAL PLAN/PROOF LIFECYCLE SEPARATION: findings holds planned/recovery work or independently observed validation evidence for ValidateManagedObjectCatalog; keep it distinct from the source authority.
    Set findings = New Collection
    CorePulseProgress "Collect catalog validation findings"
    AddManagedObjectCatalogValidationFindings findings, validatePlacement, reuseCurrentPlacementSnapshot
    If findings.count = 0 Then ValidateManagedObjectRibbonStaticTags ResolveCatalogDb(), True
    If findings.count > 0 Then
        messageText = DEFAULT_UTILITY_LONG_NAME & " managed object catalog has blocking validation findings." & vbCrLf & vbCrLf
        messageText = messageText & SharedCollection_Join(findings, vbCrLf) & TableDiagnosticsLocationForMessage()
        CorePulseProgress "Managed object catalog validation failed. Review diagnostics."
        If progressStarted Then progressStarted = False
        messageText = CoreAppendProcessRunSummary(messageText, "ValidateManagedObjectCatalog")
        PrintValidationFailureToImmediateWindow messageText
        If showMessage Then
            CoreShowErrorMessage messageText, vbCritical, "Validate Managed Object Catalog", "ValidateManagedObjectCatalog", "Tables"
            failureMessageAlreadyShown = True
        End If
        ValidateManagedObjectCatalog = False
        If showMessage Then Exit Function
        If raiseOnFailure Then Err.Raise vbObjectError + 5900, "ValidateManagedObjectCatalog", messageText
        Exit Function
    End If
    ValidateManagedObjectCatalog = True
    ReportCoreActionSuccess "ValidateManagedObjectCatalog", "ManagedObjectCatalog", DEFAULT_UTILITY_SHORT_NAME & " managed object catalog validation completed successfully.", DEFAULT_UTILITY_LONG_NAME & " managed object catalog passed strict validation.", "Validate managed object catalog", ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "Table", "CodeDb", "CatalogValidation", showMessage, "Validate Managed Object Catalog", vbInformation, True, "Tables", False, visibleStatusMessage:="Managed object catalog validation completed successfully."
    If progressStarted Then progressStarted = False
    Exit Function
ErrHandler:
    Dim errNumber As Long
    Dim errSource As String
    Dim errDescription As String
    errNumber = Err.Number
    errSource = Err.Source
    errDescription = Err.Description
    ValidateManagedObjectCatalog = False
    If progressStarted Then progressStarted = False
    messageText = CoreAppendProcessRunSummary(DEFAULT_UTILITY_LONG_NAME & " managed object catalog validation failed." & vbCrLf & vbCrLf & "Procedure: ValidateManagedObjectCatalog" & vbCrLf & "Error number: " & CStr(errNumber) & vbCrLf & "Source: " & errSource & vbCrLf & "Description:" & vbCrLf & errDescription & TableDiagnosticsLocationForMessage(), "ValidateManagedObjectCatalog")
    LogTraceMessage TRACE_LEVEL_ERROR, "Validation", "ValidateManagedObjectCatalog", "Managed Object Catalog validation failed.", messageText, "Catalog validation", errNumber, errSource, errDescription, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "Table", "CodeDb", "ManagedObjectCatalog"
    If showMessage And failureMessageAlreadyShown = False Then
        CoreShowErrorMessage messageText, vbCritical, "Validate Managed Object Catalog", "ValidateManagedObjectCatalog", "Tables"
    End If
    If showMessage Then Exit Function
    Err.Raise errNumber, "ValidateManagedObjectCatalog", messageText
End Function

Private Function PrepareCanonicalColdCreateBatch(ByVal lookupTableNames As Variant, ByVal coreTableNames As Variant, ByVal systemMacroTableNames As Variant, ByVal helpDocumentTableNames As Variant, ByRef tablesCreated As Long, ByRef fieldsCreated As Long, ByRef indexesCreated As Long, ByVal lookupDefinitionIndex As Object) As String
    'Fresh-database path: construct each complete Catalog-owned TableDef and all single-field indexes in memory, append each table once, then verify the structural contract before detailed repair paths consume the
    'retained proof. G1 owns managed DAO descriptions; B2 owns non-form-dependent lookup/caption metadata and editor intent; D4 owns physical editor binding.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim seen As Object
    Dim createdNames As Object
    Dim fieldDefinitionsByTable As Object
    Dim indexDefinitionsByTable As Object
    Dim families As Variant
    Dim familyNames As Variant
    Dim familyIndex As Long
    Dim tableName As Variant
    Dim tableNameText As String
    Dim createdName As Variant
    Dim createdTableDef As DAO.tableDef
    Dim fieldDefinitions As Collection
    Dim indexDefinitions As Collection
    Set db = ResolveCatalogDb()
    ' INTENTIONAL KEYED LOOKUP: seen, createdNames, fieldDefinitionsByTable, indexDefinitionsByTable provides keyed membership/lookup over source rows or state already read by PrepareCanonicalColdCreateBatch; it is
    ' a derived access path, not a second authority.
    Set seen = CreateObject("Scripting.Dictionary")
    seen.CompareMode = vbTextCompare
    Set createdNames = CreateObject("Scripting.Dictionary")
    createdNames.CompareMode = vbTextCompare
    Set fieldDefinitionsByTable = CreateObject("Scripting.Dictionary")
    fieldDefinitionsByTable.CompareMode = vbTextCompare
    Set indexDefinitionsByTable = CreateObject("Scripting.Dictionary")
    indexDefinitionsByTable.CompareMode = vbTextCompare
    Set mB1ColdCreatedStructuralProof = CreateObject("Scripting.Dictionary")
    mB1ColdCreatedStructuralProof.CompareMode = vbTextCompare
    mB1ColdCreateStructuralProofDatabase = LCase$(Trim$(db.Name))
    mB1ColdCreateStructuralProofTraceRunID = CatalogSetupTraceIdentity()
    If Len(mB1ColdCreateStructuralProofTraceRunID) = 0 Then Err.Raise vbObjectError + 9445, "PrepareCanonicalColdCreateBatch", "A setup-scoped cold-create structural proof cannot be established without an active trace-run identity."
    families = Array(lookupTableNames, coreTableNames, systemMacroTableNames, helpDocumentTableNames)
    For familyIndex = LBound(families) To UBound(families)
        familyNames = families(familyIndex)
        For Each tableName In familyNames
            tableNameText = CStr(tableName)
            If Len(tableNameText) > 0 Then
                If seen.Exists(tableNameText) = False Then
                    seen.Add tableNameText, True
                    If SharedDao_TableExists(db, tableNameText) = False Then
                        Set fieldDefinitions = CatalogTableSchemaDefinitions(tableNameText, lookupDefinitionIndex)
                        Set indexDefinitions = CatalogTableIndexDefinitions(tableNameText, lookupDefinitionIndex)
                        If CatalogCanonicalColdCreateSupported(fieldDefinitions, indexDefinitions) Then
                            CreateCanonicalTableCold db, tableNameText, fieldsCreated, indexesCreated, fieldDefinitions, indexDefinitions
                            createdNames.Add tableNameText, True
                            fieldDefinitionsByTable.Add tableNameText, fieldDefinitions
                            indexDefinitionsByTable.Add tableNameText, indexDefinitions
                            tablesCreated = tablesCreated + 1
                        End If
                        Set fieldDefinitions = Nothing
                        Set indexDefinitions = Nothing
                    End If
                End If
            End If
        Next tableName
    Next familyIndex
    If tablesCreated > 0 Then db.TableDefs.Refresh
    For Each createdName In createdNames.keys
        If SharedDao_TableExists(db, CStr(createdName)) = False Then Err.Raise vbObjectError + 9432, "PrepareCanonicalColdCreateBatch", "A canonical cold-created table was not visible after the single batch refresh." & vbCrLf & "Table: " & CStr(createdName)
        Set createdTableDef = db.TableDefs(CStr(createdName))
        Set fieldDefinitions = fieldDefinitionsByTable(CStr(createdName))
        Set indexDefinitions = indexDefinitionsByTable(CStr(createdName))
        CompleteAndVerifyB1ColdCreatedStructure createdTableDef, fieldDefinitions, indexDefinitions
        mB1ColdCreatedStructuralProof.Add CStr(createdName), True
        Set fieldDefinitions = Nothing
        Set indexDefinitions = Nothing
        Set createdTableDef = Nothing
    Next createdName
    PrepareCanonicalColdCreateBatch = "tables=" & CStr(tablesCreated) & "; fields=" & CStr(fieldsCreated) & "; indexes=" & CStr(indexesCreated) & "; exact structural proofs=" & CStr(mB1ColdCreatedStructuralProof.count) & "; cross-phase DAO references=0; TableDefs refreshes=" & CStr(IIf(tablesCreated > 0, 1, 0))
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    Err.Raise savedErrNumber, "PrepareCanonicalColdCreateBatch", "Could not complete the canonical B1 cold-create batch." & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Function

