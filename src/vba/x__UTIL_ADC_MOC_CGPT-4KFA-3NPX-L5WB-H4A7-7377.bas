Private Sub EnsureCatalogTableExists(ByVal tableName As String)
    RequireCatalogMutationRecoveryReady "EnsureCatalogTableExists"
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim tdf As DAO.tableDef
    Dim fld As DAO.Field
    Dim readinessSnapshot As String
    If B1ColdCreatedStructuralProofAvailable(tableName) Then
        RecordB1ColdCreateStructuralBypass tableName
        Exit Sub
    End If
    Set db = ResolveCatalogDb()
    If SharedDao_TableExists(db, tableName) Then Exit Sub
    If mCatalogDesignBatchPrepared = False Then
        db.TableDefs.Refresh
        If SharedDao_TableExists(db, tableName) Then Exit Sub
    End If
    Set tdf = db.CreateTableDef(tableName)
    Set fld = tdf.CreateField(FIELD_ID, dbLong)
    fld.Attributes = fld.Attributes Or dbAutoIncrField
    tdf.fields.Append fld
    db.TableDefs.Append tdf
    TrackSetupCreatedTableRollback tableName
    If mCatalogDesignBatchPrepared = False Then db.TableDefs.Refresh
    If SharedDao_TableExists(db, tableName) = False Then
        db.TableDefs.Refresh
        If SharedDao_TableExists(db, tableName) = False Then Err.Raise vbObjectError + 9420, "EnsureCatalogTableExists", "The table was not visible after DAO appended it."
    End If
    If mCatalogDesignBatchPrepared Then
        readinessSnapshot = "Deferred during the B1 cold table-shell batch; authoritative placement is evaluated after MAC structure and defaults exist."
    Else
        readinessSnapshot = CatalogTableGroupingReadinessSnapshot(tableName)
    End If
    CoreAddOperationNote "Created managed object catalog table " & tableName & "."
    CoreAddOperationNote "Deferred Navigation Pane grouping for newly created table [" & tableName & "] until the final catalog-driven grouping pass after MAC defaults exist. Readiness: " & readinessSnapshot
    LogTraceMessage TRACE_LEVEL_DETAIL, "NavigationPane", "EnsureCatalogTableExists", "New catalog-table Navigation Pane grouping deferred until authoritative placement exists.", "Table: " & tableName & " | " & readinessSnapshot, "Create managed object catalog table", 0, vbNullString, vbNullString, tableName, "Table", "CodeDb", "NavigationPaneGrouping"
    Exit Sub
ErrHandler:
    Dim originalErrNumber As Long
    Dim originalErrSource As String
    Dim originalErrDescription As String
    Dim tableExistsAfterFailure As Boolean
    Dim failureReadinessSnapshot As String
    originalErrNumber = Err.Number
    originalErrSource = Err.Source
    originalErrDescription = Err.Description
    On Error Resume Next
    tableExistsAfterFailure = CodeDbTableExists(tableName)
    failureReadinessSnapshot = CatalogTableGroupingReadinessSnapshot(tableName)
    On Error GoTo 0
    Err.Raise originalErrNumber, "EnsureCatalogTableExists", "Unable to create managed object catalog table." & vbCrLf & "Table: " & tableName & vbCrLf & "Physical table exists after failure: " & CStr(tableExistsAfterFailure) & vbCrLf & "Navigation Pane readiness: " & failureReadinessSnapshot & vbCrLf & "Original source: " & originalErrSource & vbCrLf & "Description: " & originalErrDescription
End Sub

Private Sub RepairExplicitCatalogTextFieldSizeForSetup(ByVal tableName As String, ByVal fieldName As String, ByVal fieldSize As Long)
    'Repairs only fields carrying an explicit ReqFieldSize contract. Stored values are checked before conversion so setup never truncates data.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim maxStoredLength As Long
    Dim sqlText As String
    If fieldSize < 1 Or fieldSize > MAX_ACCESS_SHORT_TEXT_LENGTH Then Err.Raise vbObjectError + 5916, "RepairExplicitCatalogTextFieldSizeForSetup", "Required field size is outside the valid Access Short Text range."
    Set db = ResolveCatalogDb()
    sqlText = "SELECT Max(Len(Nz([" & fieldName & "],''))) AS MaxStoredLength FROM [" & tableName & "];"
    Set rs = db.OpenRecordset(sqlText, dbOpenSnapshot, dbReadOnly)
    If rs.EOF = False Then maxStoredLength = CLng(Nz(rs.fields(0).value, 0))
    rs.Close
    Set rs = Nothing
    If maxStoredLength > fieldSize Then Err.Raise vbObjectError + 5917, "RepairExplicitCatalogTextFieldSizeForSetup", "Existing data exceeds the required field size; no data was truncated and the field was not changed." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName & vbCrLf & "Longest stored value: " & CStr(maxStoredLength) & vbCrLf & "ReqFieldSize: " & CStr(fieldSize) & vbCrLf & "Default/value source: (not applicable; existing persisted row)"
    If mCatalogDesignBatchPrepared = False Then
        If SharedAccess_PrepareOpenObjectForDesignChange(acTable, tableName, "applying ReqFieldSize to field [" & fieldName & "] in table [" & tableName & "]") = False Then
            MarkSystemCommandCancelled
            Err.Raise vbObjectError + 9003, "RepairExplicitCatalogTextFieldSizeForSetup", "Field-size repair was cancelled because the affected open table was not approved for save and close."
        End If
    End If
    db.Execute "ALTER TABLE [" & tableName & "] ALTER COLUMN [" & fieldName & "] TEXT(" & CStr(fieldSize) & ");", dbFailOnError
    db.TableDefs.Refresh
    CoreAddOperationNote "Applied ReqFieldSize " & CStr(fieldSize) & " to managed object catalog field " & tableName & "." & fieldName & "."
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    Err.Raise savedErrNumber, "RepairExplicitCatalogTextFieldSizeForSetup", "Could not safely apply the required catalog field size." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName & vbCrLf & "ReqFieldSize: " & CStr(fieldSize) & vbCrLf & "Err.Description: " & savedErrDescription
End Sub

Private Sub EnsureCatalogField(ByVal tableName As String, ByVal fieldName As String, ByVal fieldType As DAO.DataTypeEnum, ByVal fieldSize As Long, ByVal autoNumber As Boolean, Optional ByVal fieldDefinition As Variant)
    RequireCatalogMutationRecoveryReady "EnsureCatalogField"
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim tdf As DAO.tableDef
    Dim fld As DAO.Field
    If B1ColdCreatedStructuralProofAvailable(tableName) Then
        RecordB1ColdCreateStructuralBypass tableName
        Exit Sub
    End If
    Set db = ResolveCatalogDb()
    Set tdf = db.TableDefs(tableName)
    If mCatalogDesignBatchPrepared = False Then tdf.fields.Refresh
    If SharedDao_TableDefFieldExistsSafe(tdf, fieldName) Then
        Set fld = tdf.fields(fieldName)
        If SharedDao_FieldDefinitionMatches(fld, fieldType, fieldSize, autoNumber) = False Then
            If fieldType = dbText And autoNumber = False And IsNull(DefaultManagedFieldReqSize(tableName, fieldName)) = False Then
                RepairExplicitCatalogTextFieldSizeForSetup tableName, fieldName, fieldSize
                Set db = ResolveCatalogDb()
                Set tdf = db.TableDefs(tableName)
                Set fld = tdf.fields(fieldName)
            End If
            If SharedDao_FieldDefinitionMatches(fld, fieldType, fieldSize, autoNumber) = False Then Err.Raise vbObjectError + 5901, "EnsureCatalogField", "Managed object catalog field has an incompatible definition." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName & vbCrLf & "Expected: " & FieldDefinitionDescription(fieldType, fieldSize, autoNumber) & vbCrLf & "Actual: " & FieldActualDefinitionDescription(fld)
        End If
        If isMissing(fieldDefinition) = False Then ApplyCatalogFieldContract fld, fieldDefinition, tableName
        Exit Sub
    End If
    If mCatalogDesignBatchPrepared = False Then
        If SharedAccess_PrepareOpenObjectForDesignChange(acTable, tableName, "adding field [" & fieldName & "] to table [" & tableName & "]") = False Then
            MarkSystemCommandCancelled
            Err.Raise vbObjectError + 9003, "EnsureCatalogField", "Field creation was cancelled because the affected open table was not approved for save and close."
        End If
    End If
    Set tdf = db.TableDefs(tableName)
    If fieldType = dbText And fieldSize > 0 Then
        Set fld = tdf.CreateField(fieldName, fieldType, fieldSize)
    Else
        Set fld = tdf.CreateField(fieldName, fieldType)
    End If
    If autoNumber Then fld.Attributes = fld.Attributes Or dbAutoIncrField
    If isMissing(fieldDefinition) = False Then ApplyCatalogFieldContract fld, fieldDefinition, tableName
    On Error Resume Next
    Err.Clear
    tdf.fields.Append fld
    If Err.Number = 3191 Or Err.Number = 3367 Then
        Err.Clear
        tdf.fields.Refresh
        If SharedDao_TableDefFieldExistsSafe(tdf, fieldName) Then
            Set fld = tdf.fields(fieldName)
            If SharedDao_FieldDefinitionMatches(fld, fieldType, fieldSize, autoNumber) = False Then
                On Error GoTo ErrHandler
                Err.Raise vbObjectError + 5901, "EnsureCatalogField", "Managed object catalog field has an incompatible definition after DAO reported that the field already exists." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName & vbCrLf & "Expected: " & FieldDefinitionDescription(fieldType, fieldSize, autoNumber) & vbCrLf & "Actual: " & FieldActualDefinitionDescription(fld)
            End If
            On Error GoTo ErrHandler
            If isMissing(fieldDefinition) = False Then ApplyCatalogFieldContract fld, fieldDefinition, tableName
            Exit Sub
        End If
    End If
    If Err.Number <> 0 Then GoTo ErrHandler
    On Error GoTo ErrHandler
    If mCatalogDesignBatchPrepared = False Then tdf.fields.Refresh
    If SharedDao_TableDefFieldExistsSafe(tdf, fieldName) = False Then
        tdf.fields.Refresh
        If SharedDao_TableDefFieldExistsSafe(tdf, fieldName) = False Then Err.Raise vbObjectError + 5906, "EnsureCatalogField", "The field was not visible after DAO appended it." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName
    End If
    Set fld = tdf.fields(fieldName)
    If SharedDao_FieldDefinitionMatches(fld, fieldType, fieldSize, autoNumber) = False Then Err.Raise vbObjectError + 5901, "EnsureCatalogField", "Managed object catalog field has an incompatible definition after creation." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName
    If isMissing(fieldDefinition) = False Then ApplyCatalogFieldContract fld, fieldDefinition, tableName
    CoreAddOperationNote "Added managed object catalog field " & tableName & "." & fieldName & "."
    Exit Sub
ErrHandler:
    Dim originalErrNumber As Long
    Dim originalErrDescription As String
    originalErrNumber = Err.Number
    originalErrDescription = Err.Description
    Err.Raise originalErrNumber, "EnsureCatalogField", "Unable to create or verify managed object catalog field." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName & vbCrLf & "Description: " & originalErrDescription
End Sub

' Purpose: Resolves catalog count SQL from the supplied/current ADC state, using `ResolveCatalogDb` and `End` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   sqlText (Input; String): SQL text supplied to or resolved by the routine; it is treated as the query/action expression described by this parameter rather than as display text.
' Returns: Long: Returns the count calculated by the routine; zero and other sentinel values retain the meanings established by the routine's existing implementation.
Public Function CatalogCountSql(ByVal sqlText As String) As Long
    On Error GoTo ErrHandler
    Dim rs As DAO.Recordset
    Set rs = ResolveCatalogDb().OpenRecordset(sqlText, dbOpenSnapshot)
    If rs.EOF = False Then CatalogCountSql = CLng(Nz(rs.fields(0).value, 0))
    rs.Close
    Exit Function
ErrHandler:
    Dim originalErrNumber As Long
    Dim originalErrDescription As String
    originalErrNumber = Err.Number
    originalErrDescription = Err.Description
    Err.Raise originalErrNumber, "CatalogCountSql", "Unable to run managed object catalog validation SQL." & vbCrLf & "SQL: " & Left$(sqlText, 1000) & vbCrLf & "Description: " & originalErrDescription
End Function

Private Function ManagedObjectCatalogReadyForMinimumContract(Optional ByVal pumpResponsiveness As Boolean = False) As Boolean
    'Single minimum managed-object readiness contract shared by list and description consumers.
    On Error GoTo ErrHandler
    If CatalogTableCanOpenWithFields(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ObjectCategories"), Array(FIELD_CATEGORY_CODE, FIELD_OBJECT_CATEGORY_STATUS, FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER), pumpResponsiveness) = False Then Exit Function
    If CatalogTableCanOpenWithFields(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), Array(FIELD_ID, FIELD_OBJECT_NAME, FIELD_OBJECT_DISPLAY_NAME, FIELD_RIBBON_TITLE, FIELD_OBJECT_TYPE, FIELD_CHAT_GPTUI_REPORT, FIELD_CATEGORY_CODE, FIELD_MANAGED_OBJECT_STATUS, FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER), pumpResponsiveness) = False Then Exit Function
    If CatalogTableCanOpenWithFields(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECT_OVERRIDES_TABLE_LOGICAL_ID), Array(FIELD_MANAGED_OBJECT_ID, FIELD_SOURCE_OBJECT_NAME_OVERRIDE, FIELD_TARGET_OBJECT_NAME_OVERRIDE, FIELD_SETUP_ACTION_OVERRIDE, FIELD_OBJECT_SOURCE_DB_ROLE_OVERRIDE, FIELD_CONFIG_OWNER_DATABASE_ROLE_OVERRIDE, FIELD_ENVIRONMENT_SCOPE_OVERRIDE, FIELD_SETUP_STAGE_OVERRIDE, FIELD_MANAGED_OBJECT_PURPOSE_OVERRIDE, FIELD_NAV_PANE_VISIBILITY_POLICY_OVERRIDE, FIELD_EXPECTED_EXISTENCE_POLICY_OVERRIDE), pumpResponsiveness) = False Then Exit Function
    If CatalogTableCanOpenWithFields(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads"), Array(FIELD_ID, FIELD_MANAGED_OBJECT_ID, FIELD_PAYLOAD_STATUS, FIELD_PAYLOAD_KIND, FIELD_RUN_CODE_WRAPPER_NAME), pumpResponsiveness) = False Then Exit Function
    If CatalogQueryCanOpenWithFields(ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_ManagedObjectsResolved"), Array(FIELD_MANAGED_OBJECT_ID, FIELD_OBJECT_NAME, FIELD_RIBBON_TITLE, FIELD_CATEGORY_CODE, FIELD_MANAGED_OBJECT_STATUS, FIELD_OBJECT_CATEGORY_STATUS, FIELD_RESOLVED_OBJECT_TYPE, FIELD_RESOLVED_SETUP_ACTION), pumpResponsiveness) = False Then Exit Function
    ManagedObjectCatalogReadyForMinimumContract = True
    Exit Function
ErrHandler:
    ManagedObjectCatalogReadyForMinimumContract = False
End Function

Private Function CatalogTableCanOpenWithFields(ByVal tableName As String, ByVal requiredFields As Variant, Optional ByVal pumpResponsiveness As Boolean = False) As Boolean
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim tdf As DAO.tableDef
    Dim fieldName As Variant
    If CodeDbTableExists(tableName) = False Then Exit Function
    If TableCanOpen(tableName, True) = False Then Exit Function
    Set db = ResolveCatalogDb()
    db.TableDefs.Refresh
    Set tdf = db.TableDefs(tableName)
    tdf.fields.Refresh
    For Each fieldName In requiredFields
        If pumpResponsiveness Then PumpSetupResponsiveness
        If SharedDao_TableDefFieldExistsSafe(tdf, CStr(fieldName)) = False Then Exit Function
    Next fieldName
    CatalogTableCanOpenWithFields = True
    Exit Function
ErrHandler:
    CatalogTableCanOpenWithFields = False
End Function

Private Function CatalogQueryCanOpenWithFields(ByVal queryName As String, ByVal requiredFields As Variant, Optional ByVal pumpResponsiveness As Boolean = False) As Boolean
    On Error GoTo ErrHandler
    Dim rs As DAO.Recordset
    Dim fieldName As Variant
    If SharedDao_QueryExists(ResolveCatalogDb(), queryName) = False Then Exit Function
    Set rs = ResolveCatalogDb().OpenRecordset("SELECT TOP 1 * FROM [" & queryName & "];", dbOpenSnapshot)
    For Each fieldName In requiredFields
        If pumpResponsiveness Then PumpSetupResponsiveness
        If SharedDao_RecordsetHasFieldSafe(rs, CStr(fieldName)) = False Then GoTo ExitHere
    Next fieldName
    CatalogQueryCanOpenWithFields = True
ExitHere:
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    Exit Function
ErrHandler:
    CatalogQueryCanOpenWithFields = False
    Resume ExitHere
End Function

' ====================================================================================================
' Phase B Managed Object Catalog procedures.
' ====================================================================================================

' Purpose: Enforces the MOC-owned recovery gate before catalog or physical managed-object lifecycle work that cannot safely proceed while transaction recovery is unresolved.
' Public role: Inter-module MOC authority used by x__UTIL_ADC_MOC_LIFECYCLE; existing MOC callers retain the same recovery gate and error semantics.
' Parameters:
'   requestedOperationName (Input; String): Diagnostic operation name included in recovery-blocked errors.
Public Sub RequireNoUnfinishedCatalogRecovery(ByVal requestedOperationName As String)
    'Intended use: blocks Catalog, setup, reconciliation, generated-object, and managed-object naming mutations while an earlier DAO workspace rollback remains unresolved.
    requestedOperationName = Trim$(requestedOperationName)
    If Len(requestedOperationName) = 0 Then requestedOperationName = DEFAULT_UTILITY_LONG_NAME & " Catalog operation"
    If ConfigCandidateMarkingRecoveryBlocked() Then Err.Raise ERR_CATALOG_RECOVERY_BLOCKED, "RequireNoUnfinishedCatalogRecovery", "A " & DEFAULT_UTILITY_LONG_NAME & " Catalog operation cannot start because Config/Candidate marking retains unresolved transaction recovery." & vbCrLf & "Requested operation: " & requestedOperationName
    If CatalogRecoveryBlocked() = False Then Exit Sub
    Err.Raise ERR_CATALOG_RECOVERY_BLOCKED, "RequireNoUnfinishedCatalogRecovery", "A " & DEFAULT_UTILITY_LONG_NAME & " Catalog operation cannot start because an earlier transaction recovery boundary is unresolved." & vbCrLf & "Requested operation: " & requestedOperationName & vbCrLf & "Recovery operation: " & IIf(Len(mCatalogRecoveryOperationName) = 0, "(not recorded)", mCatalogRecoveryOperationName) & vbCrLf & "Recovery detail:" & vbCrLf & IIf(Len(mCatalogRecoveryDetail) = 0, "(not recorded)", mCatalogRecoveryDetail) & vbCrLf & "Do not continue Catalog repair, setup, reconciliation, generated-object, or managed-object naming work in this Access session."
End Sub

Private Function VerifyCatalogRecoveryDatabaseState() As String
    On Error GoTo ErrHandler
    Dim sourceDb As DAO.Database
    Dim verifyWs As DAO.workspace
    Dim verifyDb As DAO.Database
    Dim verifyRs As DAO.Recordset
    Dim verifyTdf As DAO.tableDef
    Dim dbPath As String
    Dim managedObjectsTableName As String
    Dim tableLookupErrNumber As Long
    Dim tableLookupErrDescription As String
    Set sourceDb = ResolveCatalogDb()
    dbPath = sourceDb.Name
    managedObjectsTableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID)
    Set verifyWs = DBEngine.CreateWorkspace("ADCCatalogRecoveryVerify_" & Format$(Now, "hhnnss") & "_" & Format$(CLng(Timer * 1000), "000000000"), "Admin", vbNullString, dbUseJet)
    Set verifyDb = verifyWs.OpenDatabase(dbPath)
    verifyDb.TableDefs.Refresh
    On Error Resume Next
    Err.Clear
    Set verifyTdf = verifyDb.TableDefs(managedObjectsTableName)
    tableLookupErrNumber = Err.Number
    tableLookupErrDescription = Err.Description
    Err.Clear
    On Error GoTo ErrHandler
    If tableLookupErrNumber <> 0 And tableLookupErrNumber <> 3265 Then Err.Raise tableLookupErrNumber, "VerifyCatalogRecoveryDatabaseState", "Could not inspect the Managed Object Catalog table in the independent recovery workspace. " & tableLookupErrDescription
    If tableLookupErrNumber = 0 Then
        Set verifyRs = verifyDb.OpenRecordset("SELECT TOP 1 " & SQL_FIELD_ID & " FROM [" & managedObjectsTableName & "];", dbOpenSnapshot)
        verifyRs.Close
        Set verifyRs = Nothing
    End If
    verifyDb.Close
    Set verifyDb = Nothing
    verifyWs.Close
    Set verifyWs = Nothing
    VerifyCatalogRecoveryDatabaseState = "CodeDb was reopened and its Catalog state was read successfully through a new independent workspace."
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not verifyRs Is Nothing Then verifyRs.Close
    If Not verifyDb Is Nothing Then verifyDb.Close
    If Not verifyWs Is Nothing Then verifyWs.Close
    On Error GoTo 0
    Err.Raise ERR_CATALOG_ROLLBACK_FAILED, "VerifyCatalogRecoveryDatabaseState", "CodeDb Catalog state could not be verified through an independent workspace. Error " & CStr(savedErrNumber) & ": " & savedErrDescription
End Function

' Purpose: Performs the public retry catalog recovery operation using the routine's existing ADC workflow and side effects.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   showMessage (Input Optional; Boolean): Controls whether the routine shows its user-facing completion, status, warning, or error message in addition to performing the underlying work. Default: True.
' Returns: None (Sub). Any caller-visible results are communicated through existing side effects.
Public Sub RetryCatalogRecovery(Optional ByVal showMessage As Boolean = True)
    'Retries only the retained originating workspace; after a reset, verifies CodeDb independently without touching the default workspace transaction.
    On Error GoTo ErrHandler
    Dim rollbackErrNumber As Long
    Dim rollbackErrDescription As String
    Dim resolutionText As String
    If CatalogRecoveryBlocked() = False Then
        If showMessage Then CoreShowMessage "No unfinished Access Development Console Catalog recovery exists.", vbInformation, "Access Development Console Catalog Recovery", "RetryCatalogRecovery", "Catalog"
        Exit Sub
    End If
    If Not mCatalogRecoveryWorkspace Is Nothing Then
        On Error Resume Next
        Err.Clear
        mCatalogRecoveryWorkspace.Rollback
        rollbackErrNumber = Err.Number
        rollbackErrDescription = Err.Description
        On Error GoTo ErrHandler
        If rollbackErrNumber <> 0 And rollbackErrNumber <> 3034 Then Err.Raise ERR_CATALOG_ROLLBACK_FAILED, "RetryCatalogRecovery", "The retained originating Catalog workspace still could not be rolled back. Error " & CStr(rollbackErrNumber) & ": " & rollbackErrDescription
        If rollbackErrNumber = 3034 Then resolutionText = "The retained originating Catalog workspace had no live transaction remaining." Else resolutionText = "The retained originating Catalog workspace transaction was rolled back successfully."
        Set mCatalogRecoveryWorkspace = Nothing
    Else
        resolutionText = "The originating Catalog workspace is no longer retained. No default-workspace rollback was attempted."
    End If
    resolutionText = resolutionText & vbCrLf & VerifyCatalogRecoveryDatabaseState()
    mCatalogRecoveryOperationName = "Catalog recovery marker cleanup"
    mCatalogRecoveryDetail = resolutionText & vbCrLf & "Transaction resolution is complete; durable blocker cleanup is pending."
    PersistDurableRecoveryMarker CATALOG_RECOVERY_KEY, mCatalogRecoveryOperationName, mCatalogRecoveryDetail
    DeleteDurableRecoveryMarker CATALOG_RECOVERY_KEY
    mCatalogRecoveryBlocked = False
    mCatalogRecoveryOperationName = vbNullString
    mCatalogRecoveryDetail = vbNullString
    Set mCatalogRecoveryWorkspace = Nothing
    If showMessage Then CoreShowMessage "Access Development Console Catalog transaction recovery completed and was verified." & vbCrLf & vbCrLf & resolutionText, vbInformation, "Access Development Console Catalog Recovery", "RetryCatalogRecovery", "Catalog"
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrDescription = Err.Description
    mCatalogRecoveryBlocked = True
    On Error Resume Next
    PersistDurableRecoveryMarker CATALOG_RECOVERY_KEY, mCatalogRecoveryOperationName, savedErrDescription
    On Error GoTo 0
    If showMessage Then
        CoreShowErrorMessage "Access Development Console Catalog recovery remains unresolved." & vbCrLf & vbCrLf & "Error " & CStr(savedErrNumber) & ": " & savedErrDescription, vbCritical, "Access Development Console Catalog Recovery", "RetryCatalogRecovery", "Core"
        Exit Sub
    End If
    Err.Raise ERR_CATALOG_ROLLBACK_FAILED, "RetryCatalogRecovery", savedErrDescription
End Sub

Private Sub RegisterCatalogRecoveryFailure(ByVal operationName As String, ByVal detailText As String, Optional ByVal ws As DAO.workspace = Nothing)
    On Error GoTo PersistErr
    mCatalogRecoveryBlocked = True
    mCatalogRecoveryOperationName = operationName
    mCatalogRecoveryDetail = Trim$(detailText)
    If Not ws Is Nothing Then Set mCatalogRecoveryWorkspace = ws
    PersistDurableRecoveryMarker CATALOG_RECOVERY_KEY, mCatalogRecoveryOperationName, mCatalogRecoveryDetail
    Exit Sub
PersistErr:
    mCatalogRecoveryDetail = mCatalogRecoveryDetail & vbCrLf & "Durable recovery persistence failed. Error " & CStr(Err.Number) & ": " & Err.Description
    Err.Raise ERR_CATALOG_ROLLBACK_FAILED, "RegisterCatalogRecoveryFailure", mCatalogRecoveryDetail
End Sub

Private Sub RollbackCatalogWorkspaceOrRaise(ByVal ws As DAO.workspace, ByVal operationName As String, ByVal originalErrNumber As Long, ByVal originalErrSource As String, ByVal originalErrDescription As String)
    On Error GoTo rollbackFailed
    ws.Rollback
    Exit Sub
rollbackFailed:
    Dim rollbackErrNumber As Long
    Dim rollbackErrSource As String
    Dim rollbackErrDescription As String
    Dim detailText As String
    rollbackErrNumber = Err.Number
    rollbackErrSource = Err.Source
    rollbackErrDescription = Err.Description
    detailText = "Workspace rollback failed. Error " & CStr(rollbackErrNumber) & " from " & rollbackErrSource & ": " & rollbackErrDescription & vbCrLf & "Original operation error " & CStr(originalErrNumber) & " from " & originalErrSource & ": " & originalErrDescription
    RegisterCatalogRecoveryFailure operationName, detailText, ws
    Err.Raise ERR_CATALOG_ROLLBACK_FAILED, operationName, "The Catalog transaction could not be rolled back. The workspace transaction state is unresolved, same-workspace snapshot restoration was not attempted, and later Catalog/setup work is blocked." & vbCrLf & detailText
End Sub

