Private Sub RetireLegacyManagedObjectFieldSizeFieldForSetup(ByVal tableName As String)
    'Migrates the former observed FieldSize column to ActualFieldSize, then removes the obsolete field before canonical order verification.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim tdf As DAO.tableDef
    Set db = ResolveCatalogDb()
    Set tdf = db.TableDefs(tableName)
    If SharedDao_TableDefFieldExistsSafe(tdf, "FieldSize") = False Then Exit Sub
    If SharedDao_TableDefFieldExistsSafe(tdf, FIELD_MANAGED_OBJECT_FIELD_ACTUAL_SIZE) = False Then Err.Raise vbObjectError + 5918, "RetireLegacyManagedObjectFieldSizeFieldForSetup", "ActualFieldSize must exist before the legacy FieldSize field can be retired."
    db.Execute "UPDATE [" & tableName & "] SET " & SQL_FIELD_MANAGED_OBJECT_FIELD_ACTUAL_SIZE & "=[FieldSize] WHERE " & SQL_FIELD_MANAGED_OBJECT_FIELD_ACTUAL_SIZE & " Is Null;", dbFailOnError
    If mCatalogDesignBatchPrepared = False Then
        If SharedAccess_PrepareOpenObjectForDesignChange(acTable, tableName, "retiring legacy FieldSize after migration to ActualFieldSize") = False Then
            MarkSystemCommandCancelled
            Err.Raise vbObjectError + 9003, "RetireLegacyManagedObjectFieldSizeFieldForSetup", "Legacy FieldSize retirement was cancelled because the affected open table was not approved for save and close."
        End If
    End If
    Set tdf = db.TableDefs(tableName)
    tdf.fields.Delete "FieldSize"
    tdf.fields.Refresh
    If SharedDao_TableDefFieldExistsSafe(tdf, "FieldSize") Then Err.Raise vbObjectError + 5919, "RetireLegacyManagedObjectFieldSizeFieldForSetup", "Legacy FieldSize remained after deletion."
    CoreAddOperationNote "Migrated MAC_Fields.FieldSize to ActualFieldSize and retired the legacy field."
    Exit Sub
ErrHandler:
    Err.Raise Err.Number, "RetireLegacyManagedObjectFieldSizeFieldForSetup", "Could not migrate the legacy MAC_Fields.FieldSize field." & vbCrLf & "Table: " & tableName & vbCrLf & "Err.Description: " & Err.Description
End Sub

Private Function CatalogDuplicateRowsMatchExceptIdentity(ByVal db As DAO.Database, ByVal tableName As String, ByVal canonicalID As Long, ByVal duplicateID As Long, ByVal identityField1 As String, ByVal identityField2 As String, ByRef conflictingFieldName As String) As Boolean
    'Compares persisted non-identity values exactly so B1 can remove only redundant duplicates without deciding later-phase or user-maintained metadata.
    On Error GoTo ErrHandler
    Dim canonicalRs As DAO.Recordset
    Dim duplicateRs As DAO.Recordset
    Dim fieldIndex As Long
    Dim currentFieldName As String
    Dim canonicalValue As Variant
    Dim duplicateValue As Variant
    conflictingFieldName = vbNullString
    Set canonicalRs = db.OpenRecordset("SELECT * FROM [" & tableName & "] WHERE " & SQL_FIELD_ID & "=" & CStr(canonicalID) & ";", dbOpenSnapshot)
    Set duplicateRs = db.OpenRecordset("SELECT * FROM [" & tableName & "] WHERE " & SQL_FIELD_ID & "=" & CStr(duplicateID) & ";", dbOpenSnapshot)
    If canonicalRs.EOF Then Err.Raise vbObjectError + 5920, "CatalogDuplicateRowsMatchExceptIdentity", "The canonical duplicate-migration row does not exist." & vbCrLf & "Table: " & tableName & vbCrLf & "ID: " & CStr(canonicalID)
    If duplicateRs.EOF Then Err.Raise vbObjectError + 5921, "CatalogDuplicateRowsMatchExceptIdentity", "The duplicate-migration row does not exist." & vbCrLf & "Table: " & tableName & vbCrLf & "ID: " & CStr(duplicateID)
    For fieldIndex = 0 To canonicalRs.fields.count - 1
        currentFieldName = canonicalRs.fields(fieldIndex).Name
        If StrComp(currentFieldName, FIELD_ID, vbTextCompare) <> 0 And StrComp(currentFieldName, identityField1, vbTextCompare) <> 0 And StrComp(currentFieldName, identityField2, vbTextCompare) <> 0 Then
            canonicalValue = canonicalRs.fields(fieldIndex).value
            duplicateValue = duplicateRs.fields(currentFieldName).value
            If IsNull(canonicalValue) Xor IsNull(duplicateValue) Then
                conflictingFieldName = currentFieldName
                GoTo ValuesDiffer
            End If
            If IsNull(canonicalValue) = False Then
                If VarType(canonicalValue) = vbString Or VarType(duplicateValue) = vbString Then
                    If StrComp(CStr(canonicalValue), CStr(duplicateValue), vbBinaryCompare) <> 0 Then
                        conflictingFieldName = currentFieldName
                        GoTo ValuesDiffer
                    End If
                ElseIf canonicalValue <> duplicateValue Then
                    conflictingFieldName = currentFieldName
                    GoTo ValuesDiffer
                End If
            End If
        End If
    Next fieldIndex
    CatalogDuplicateRowsMatchExceptIdentity = True
ValuesDiffer:
    canonicalRs.Close
    duplicateRs.Close
    Set canonicalRs = Nothing
    Set duplicateRs = Nothing
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not canonicalRs Is Nothing Then canonicalRs.Close
    If Not duplicateRs Is Nothing Then duplicateRs.Close
    On Error GoTo 0
    Err.Raise savedErrNumber, "CatalogDuplicateRowsMatchExceptIdentity", "Could not compare duplicate catalog rows without changing them." & vbCrLf & "Table: " & tableName & vbCrLf & "Canonical ID: " & CStr(canonicalID) & vbCrLf & "Duplicate ID: " & CStr(duplicateID) & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Function

Private Sub RequireManagedObjectFieldValueIdentityConsolidationSafeForSetup(ByVal db As DAO.Database, ByVal tableName As String, ByVal fieldIDRemap As Object)
    'Preflights current and prospective child identities before B1 changes any parent link or deletes any redundant child row.
    On Error GoTo ErrHandler
    Dim valueRs As DAO.Recordset
    Dim canonicalIDByIdentity As Object
    Dim identityKey As String
    Dim storedValue As String
    Dim sourceManagedObjectFieldID As Long
    Dim targetManagedObjectFieldID As Long
    Dim canonicalID As Long
    Dim duplicateID As Long
    Dim conflictingFieldName As String
    Set canonicalIDByIdentity = CreateObject("Scripting.Dictionary")
    canonicalIDByIdentity.CompareMode = vbTextCompare
    Set valueRs = db.OpenRecordset("SELECT " & SQL_FIELD_ID & ",[" & FIELD_MANAGED_OBJECT_FIELD_VALUE_MANAGED_OBJECT_FIELD_ID & "],[" & FIELD_MANAGED_OBJECT_FIELD_VALUE_STORED_VALUE & "] FROM [" & tableName & "] ORDER BY " & SQL_FIELD_ID & ";", dbOpenSnapshot)
    Do While valueRs.EOF = False
        PumpSetupResponsiveness
        If IsNull(valueRs.fields(FIELD_MANAGED_OBJECT_FIELD_VALUE_MANAGED_OBJECT_FIELD_ID).value) = False And IsNull(valueRs.fields(FIELD_MANAGED_OBJECT_FIELD_VALUE_STORED_VALUE).value) = False Then
            sourceManagedObjectFieldID = CLng(valueRs.fields(FIELD_MANAGED_OBJECT_FIELD_VALUE_MANAGED_OBJECT_FIELD_ID).value)
            targetManagedObjectFieldID = sourceManagedObjectFieldID
            If fieldIDRemap.Exists(CStr(sourceManagedObjectFieldID)) Then targetManagedObjectFieldID = CLng(fieldIDRemap(CStr(sourceManagedObjectFieldID)))
            storedValue = CStr(valueRs.fields(FIELD_MANAGED_OBJECT_FIELD_VALUE_STORED_VALUE).value)
            identityKey = CStr(targetManagedObjectFieldID) & Chr$(30) & storedValue
            If canonicalIDByIdentity.Exists(identityKey) Then
                canonicalID = CLng(canonicalIDByIdentity(identityKey))
                duplicateID = CLng(valueRs.fields(FIELD_ID).value)
                conflictingFieldName = vbNullString
                If CatalogDuplicateRowsMatchExceptIdentity(db, tableName, canonicalID, duplicateID, FIELD_MANAGED_OBJECT_FIELD_VALUE_MANAGED_OBJECT_FIELD_ID, FIELD_MANAGED_OBJECT_FIELD_VALUE_STORED_VALUE, conflictingFieldName) = False Then
                    Err.Raise vbObjectError + 5922, "RequireManagedObjectFieldValueIdentityConsolidationSafeForSetup", "B1 cannot enforce the MAC_Fields_Vals identity key because duplicate rows contain different persisted non-identity data." & vbCrLf & "Table: " & tableName & vbCrLf & "Prospective ManagedObjectFieldID: " & CStr(targetManagedObjectFieldID) & vbCrLf & "StoredValue: " & storedValue & vbCrLf & "Canonical ID: " & CStr(canonicalID) & vbCrLf & "Duplicate ID: " & CStr(duplicateID) & vbCrLf & "Conflicting field: " & conflictingFieldName & vbCrLf & "No conflicting row was deleted or overwritten. Resolve the duplicate data before rerunning B1."
                End If
            Else
                canonicalIDByIdentity.Add identityKey, CLng(valueRs.fields(FIELD_ID).value)
            End If
        End If
        valueRs.MoveNext
    Loop
    valueRs.Close
    Set valueRs = Nothing
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not valueRs Is Nothing Then valueRs.Close
    On Error GoTo 0
    Err.Raise savedErrNumber, "RequireManagedObjectFieldValueIdentityConsolidationSafeForSetup", "Could not prove that MAC_Fields_Vals duplicate consolidation is lossless before B1 unique-index repair." & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Sub

Private Function RemoveRedundantProspectiveManagedObjectFieldValueDuplicatesForSetup(ByVal db As DAO.Database, ByVal tableName As String, ByVal fieldIDRemap As Object) As Long
    'After lossless preflight, removes lower-priority child rows before a parent remap can collide with an already-present child unique index.
    On Error GoTo ErrHandler
    Dim valueRs As DAO.Recordset
    Dim canonicalIDByIdentity As Object
    Dim duplicateIDs As Collection
    Dim identityKey As String
    Dim storedValue As String
    Dim sourceManagedObjectFieldID As Long
    Dim targetManagedObjectFieldID As Long
    Dim duplicateID As Variant
    Dim removedCount As Long
    Set canonicalIDByIdentity = CreateObject("Scripting.Dictionary")
    canonicalIDByIdentity.CompareMode = vbTextCompare
    Set duplicateIDs = New Collection
    Set valueRs = db.OpenRecordset("SELECT " & SQL_FIELD_ID & ",[" & FIELD_MANAGED_OBJECT_FIELD_VALUE_MANAGED_OBJECT_FIELD_ID & "],[" & FIELD_MANAGED_OBJECT_FIELD_VALUE_STORED_VALUE & "] FROM [" & tableName & "] ORDER BY " & SQL_FIELD_ID & ";", dbOpenSnapshot)
    Do While valueRs.EOF = False
        PumpSetupResponsiveness
        If IsNull(valueRs.fields(FIELD_MANAGED_OBJECT_FIELD_VALUE_MANAGED_OBJECT_FIELD_ID).value) = False And IsNull(valueRs.fields(FIELD_MANAGED_OBJECT_FIELD_VALUE_STORED_VALUE).value) = False Then
            sourceManagedObjectFieldID = CLng(valueRs.fields(FIELD_MANAGED_OBJECT_FIELD_VALUE_MANAGED_OBJECT_FIELD_ID).value)
            targetManagedObjectFieldID = sourceManagedObjectFieldID
            If fieldIDRemap.Exists(CStr(sourceManagedObjectFieldID)) Then targetManagedObjectFieldID = CLng(fieldIDRemap(CStr(sourceManagedObjectFieldID)))
            storedValue = CStr(valueRs.fields(FIELD_MANAGED_OBJECT_FIELD_VALUE_STORED_VALUE).value)
            identityKey = CStr(targetManagedObjectFieldID) & Chr$(30) & storedValue
            If canonicalIDByIdentity.Exists(identityKey) Then
                duplicateIDs.Add CLng(valueRs.fields(FIELD_ID).value)
            Else
                canonicalIDByIdentity.Add identityKey, CLng(valueRs.fields(FIELD_ID).value)
            End If
        End If
        valueRs.MoveNext
    Loop
    valueRs.Close
    Set valueRs = Nothing
    For Each duplicateID In duplicateIDs
        db.Execute "DELETE FROM [" & tableName & "] WHERE " & SQL_FIELD_ID & "=" & CStr(CLng(duplicateID)) & ";", dbFailOnError
        removedCount = removedCount + db.RecordsAffected
    Next duplicateID
    RemoveRedundantProspectiveManagedObjectFieldValueDuplicatesForSetup = removedCount
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not valueRs Is Nothing Then valueRs.Close
    On Error GoTo 0
    Err.Raise savedErrNumber, "RemoveRedundantProspectiveManagedObjectFieldValueDuplicatesForSetup", "Could not remove proven-redundant MAC_Fields_Vals rows before remapping a duplicate MAC_Fields parent." & vbCrLf & savedErrDescription
End Function

Private Sub ConsolidateManagedObjectFieldValueIdentityDuplicatesForSetup(ByVal tableName As String)
    'B1 retains the existing lowest-ID canonical row unchanged and deletes only duplicate complete identities before the composite unique key is enforced. Null StoredValue rows remain outside that key.
    'B1 removes a complete duplicate only after exact non-identity comparison proves no persisted value will be lost. Null StoredValue rows remain outside the composite unique key.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim valueRs As DAO.Recordset
    Dim canonicalIDByIdentity As Object
    Dim duplicateIDs As Collection
    Dim fieldIDRemap As Object
    Dim identityKey As String
    Dim storedValue As String
    Dim managedObjectFieldID As Long
    Dim duplicateID As Variant
    Dim duplicateCount As Long
    Set db = ResolveCatalogDb()
    Set fieldIDRemap = CreateObject("Scripting.Dictionary")
    fieldIDRemap.CompareMode = vbTextCompare
    RequireManagedObjectFieldValueIdentityConsolidationSafeForSetup db, tableName, fieldIDRemap
    Set canonicalIDByIdentity = CreateObject("Scripting.Dictionary")
    canonicalIDByIdentity.CompareMode = vbTextCompare
    Set duplicateIDs = New Collection
    Set valueRs = db.OpenRecordset("SELECT " & SQL_FIELD_ID & ",[" & FIELD_MANAGED_OBJECT_FIELD_VALUE_MANAGED_OBJECT_FIELD_ID & "],[" & FIELD_MANAGED_OBJECT_FIELD_VALUE_STORED_VALUE & "] FROM [" & tableName & "] ORDER BY " & SQL_FIELD_ID & ";", dbOpenSnapshot)
    Do While valueRs.EOF = False
        PumpSetupResponsiveness
        If IsNull(valueRs.fields(FIELD_MANAGED_OBJECT_FIELD_VALUE_MANAGED_OBJECT_FIELD_ID).value) = False And IsNull(valueRs.fields(FIELD_MANAGED_OBJECT_FIELD_VALUE_STORED_VALUE).value) = False Then
            managedObjectFieldID = CLng(valueRs.fields(FIELD_MANAGED_OBJECT_FIELD_VALUE_MANAGED_OBJECT_FIELD_ID).value)
            storedValue = CStr(valueRs.fields(FIELD_MANAGED_OBJECT_FIELD_VALUE_STORED_VALUE).value)
            identityKey = CStr(managedObjectFieldID) & Chr$(30) & storedValue
            If canonicalIDByIdentity.Exists(identityKey) Then
                duplicateIDs.Add CLng(valueRs.fields(FIELD_ID).value)
            Else
                canonicalIDByIdentity.Add identityKey, CLng(valueRs.fields(FIELD_ID).value)
            End If
        End If
        valueRs.MoveNext
    Loop
    valueRs.Close
    Set valueRs = Nothing
    For Each duplicateID In duplicateIDs
        db.Execute "DELETE FROM [" & tableName & "] WHERE " & SQL_FIELD_ID & "=" & CStr(CLng(duplicateID)) & ";", dbFailOnError
        duplicateCount = duplicateCount + db.RecordsAffected
    Next duplicateID
    If duplicateCount > 0 Then CoreAddOperationNote "B1 removed redundant legacy MAC_Fields_Vals duplicate identities after exact non-identity equality proof. Rows removed=" & CStr(duplicateCount) & "."
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not valueRs Is Nothing Then valueRs.Close
    On Error GoTo 0
    Err.Raise savedErrNumber, "ConsolidateManagedObjectFieldValueIdentityDuplicatesForSetup", "Could not consolidate redundant legacy MAC_Fields_Vals identities before B1 unique-index repair." & vbCrLf & savedErrDescription
End Sub

Private Sub ConsolidateManagedObjectFieldIdentityDuplicatesForSetup(ByVal tableName As String)
    'B1 owns this migration because the new composite key is physical table/index integrity. The existing lowest-ID canonical row remains unchanged.
    'Child identities are remapped before duplicate parents are deleted.
    'B1 owns physical identity migration, but it does not merge or choose later-phase/user-maintained metadata. Only exact non-identity duplicates may be removed.
    'Child identities are preflighted against their prospective canonical parent before any parent link changes or duplicate-row deletion occurs.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim fieldRs As DAO.Recordset
    Dim canonicalIDByIdentity As Object
    Dim duplicateParentToKeep As Object
    Dim childFieldDefinitions As Collection
    Dim childTableName As String
    Dim identityKey As String
    Dim fieldName As String
    Dim managedObjectID As Long
    Dim keepID As Long
    Dim duplicateID As Long
    Dim conflictingFieldName As String
    Dim duplicateParentID As Variant
    Dim duplicateCount As Long
    Dim remappedValueCount As Long
    Dim redundantValueCount As Long
    Set db = ResolveCatalogDb()
    childTableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectFieldValues")
    If SharedDao_DatabaseTableExistsSafe(db, childTableName) Then
        Set childFieldDefinitions = CatalogTableSchemaDefinitions(childTableName)
        EnsureCatalogFieldsFromSchema childTableName, childFieldDefinitions
    End If
    Set canonicalIDByIdentity = CreateObject("Scripting.Dictionary")
    canonicalIDByIdentity.CompareMode = vbTextCompare
    Set duplicateParentToKeep = CreateObject("Scripting.Dictionary")
    duplicateParentToKeep.CompareMode = vbTextCompare
    Set fieldRs = db.OpenRecordset("SELECT " & SQL_FIELD_ID & ",[" & FIELD_MANAGED_OBJECT_ID & "],[" & FIELD_MANAGED_OBJECT_FIELD_NAME & "] FROM [" & tableName & "] ORDER BY " & SQL_FIELD_ID & ";", dbOpenSnapshot)
    Do While fieldRs.EOF = False
        PumpSetupResponsiveness
        If IsNull(fieldRs.fields(FIELD_MANAGED_OBJECT_ID).value) = False And IsNull(fieldRs.fields(FIELD_MANAGED_OBJECT_FIELD_NAME).value) = False Then
            managedObjectID = CLng(fieldRs.fields(FIELD_MANAGED_OBJECT_ID).value)
            fieldName = CStr(fieldRs.fields(FIELD_MANAGED_OBJECT_FIELD_NAME).value)
            identityKey = CStr(managedObjectID) & Chr$(30) & fieldName
            If canonicalIDByIdentity.Exists(identityKey) Then
                keepID = CLng(canonicalIDByIdentity(identityKey))
                duplicateID = CLng(fieldRs.fields(FIELD_ID).value)
                conflictingFieldName = vbNullString
                If CatalogDuplicateRowsMatchExceptIdentity(db, tableName, keepID, duplicateID, FIELD_MANAGED_OBJECT_ID, FIELD_MANAGED_OBJECT_FIELD_NAME, conflictingFieldName) = False Then
                    Err.Raise vbObjectError + 5923, "ConsolidateManagedObjectFieldIdentityDuplicatesForSetup", "B1 cannot enforce the MAC_Fields identity key because duplicate rows contain different persisted non-identity data." & vbCrLf & "Table: " & tableName & vbCrLf & "ManagedObjectID: " & CStr(managedObjectID) & vbCrLf & "FieldName: " & fieldName & vbCrLf & "Canonical ID: " & CStr(keepID) & vbCrLf & "Duplicate ID: " & CStr(duplicateID) & vbCrLf & "Conflicting field: " & conflictingFieldName & vbCrLf & "No conflicting row was deleted or overwritten. Resolve the duplicate data before rerunning B1."
                End If
                duplicateParentToKeep.Add CStr(duplicateID), keepID
            Else
                canonicalIDByIdentity.Add identityKey, CLng(fieldRs.fields(FIELD_ID).value)
            End If
        End If
        fieldRs.MoveNext
    Loop
    fieldRs.Close
    Set fieldRs = Nothing
    If SharedDao_DatabaseTableExistsSafe(db, childTableName) Then
        RequireManagedObjectFieldValueIdentityConsolidationSafeForSetup db, childTableName, duplicateParentToKeep
        redundantValueCount = RemoveRedundantProspectiveManagedObjectFieldValueDuplicatesForSetup(db, childTableName, duplicateParentToKeep)
    End If
    For Each duplicateParentID In duplicateParentToKeep.keys
        keepID = CLng(duplicateParentToKeep(CStr(duplicateParentID)))
        duplicateID = CLng(duplicateParentID)
        If SharedDao_DatabaseTableExistsSafe(db, childTableName) Then
            db.Execute "UPDATE [" & childTableName & "] SET [" & FIELD_MANAGED_OBJECT_FIELD_VALUE_MANAGED_OBJECT_FIELD_ID & "]=" & CStr(keepID) & " WHERE [" & FIELD_MANAGED_OBJECT_FIELD_VALUE_MANAGED_OBJECT_FIELD_ID & "]=" & CStr(duplicateID) & ";", dbFailOnError
            remappedValueCount = remappedValueCount + db.RecordsAffected
        End If
        db.Execute "DELETE FROM [" & tableName & "] WHERE " & SQL_FIELD_ID & "=" & CStr(duplicateID) & ";", dbFailOnError
        duplicateCount = duplicateCount + db.RecordsAffected
    Next duplicateParentID
    If SharedDao_DatabaseTableExistsSafe(db, childTableName) Then ConsolidateManagedObjectFieldValueIdentityDuplicatesForSetup childTableName
    If duplicateCount > 0 Then CoreAddOperationNote "B1 removed redundant legacy MAC_Fields duplicate identities after exact non-identity equality proof. Parent rows removed=" & CStr(duplicateCount) & "; redundant MAC_Fields_Vals rows removed before remap=" & CStr(redundantValueCount) & "; MAC_Fields_Vals rows remapped=" & CStr(remappedValueCount) & "."
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not fieldRs Is Nothing Then fieldRs.Close
    On Error GoTo 0
    Err.Raise savedErrNumber, "ConsolidateManagedObjectFieldIdentityDuplicatesForSetup", "Could not consolidate redundant legacy MAC_Fields identities before B1 unique-index repair." & vbCrLf & savedErrDescription
End Sub

