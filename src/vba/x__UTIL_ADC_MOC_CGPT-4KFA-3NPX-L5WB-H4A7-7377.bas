Private Function Part8ManagedObjectFamilyTableNames(ByVal names As Collection) As Variant
    Dim item As Variant
    Dim result() As String
    Dim index As Long
    If names.count = 0 Then
        Part8ManagedObjectFamilyTableNames = Array()
        Exit Function
    End If
    ReDim result(0 To names.count - 1)
    index = 0
    For Each item In names
        result(index) = CStr(item)
        index = index + 1
    Next item
    Part8ManagedObjectFamilyTableNames = result
End Function

Private Sub ApplyManagedObjectDefaultDefinitions(ByVal definitions As Collection, ByVal repairDefaultRows As Boolean)
    Dim rowData As Variant
    For Each rowData In definitions
        PumpSetupResponsiveness
        DefaultDetailedManagedObject CStr(rowData(0)), CStr(rowData(1)), CStr(rowData(2)), CStr(rowData(3)), CLng(rowData(4)), repairDefaultRows
    Next rowData
End Sub

Private Sub DefaultCoreManagedObjectRowsFromCurrentUtility(ByVal repairDefaultRows As Boolean, ByVal catalogTableDefinitions As Collection, ByVal reviewQueryDefinitions As Collection, ByVal reviewPayloadDefinitions As Collection, ByVal lookupTableDefinitions As Collection, ByVal formDesignDefinitions As Collection, ByVal formDesignPayloadDefinitions As Collection)
    Dim familyTimer As Single
    Dim familyElapsed As Double
    Dim payloadElapsedBefore As Double
    mManagedDefinitionCaptureFamily = MANAGED_DEFINITION_FAMILY_SUPPORT
    CorePulseProgress "Defaulting managed objects: support and runtime tables."
    ApplyManagedObjectDefaultDefinitions CoreSupportManagedObjectDefinitions(), repairDefaultRows
    DefaultReferenceManagedObjectRows repairDefaultRows
    DefaultModuleUpdateGuardManagedObjectRows repairDefaultRows
    ' Phase B owns the logical managed-report catalog/placement definitions; physical report construction remains Phase E in x__UTIL_ADC_REPORTS.
    ApplyManagedObjectDefaultDefinitions ReportManagedObjectDefinitions(), repairDefaultRows
    mManagedDefinitionCaptureFamily = MANAGED_DEFINITION_FAMILY_CORE_TABLES
    familyTimer = Timer
    CorePulseProgress "Defaulting managed objects: catalog tables."
    ApplyManagedObjectDefaultDefinitions catalogTableDefinitions, repairDefaultRows
    If mManagedDefinitionCaptureActive Then mManagedDefinitionTableConstructionElapsedSeconds = mManagedDefinitionTableConstructionElapsedSeconds + ElapsedSecondsFromTimer(familyTimer)
    mManagedDefinitionCaptureFamily = MANAGED_DEFINITION_FAMILY_CORE_QUERIES
    familyTimer = Timer
    payloadElapsedBefore = mManagedDefinitionPayloadConstructionElapsedSeconds
    CorePulseProgress "Defaulting managed objects: review queries."
    DefaultManagedObjectReviewQueryRows repairDefaultRows, reviewQueryDefinitions, reviewPayloadDefinitions
    If mManagedDefinitionCaptureActive Then
        familyElapsed = ElapsedSecondsFromTimer(familyTimer) - (mManagedDefinitionPayloadConstructionElapsedSeconds - payloadElapsedBefore)
        If familyElapsed < 0 Then familyElapsed = 0
        mManagedDefinitionQueryConstructionElapsedSeconds = mManagedDefinitionQueryConstructionElapsedSeconds + familyElapsed
    End If
    mManagedDefinitionCaptureFamily = MANAGED_DEFINITION_FAMILY_LOOKUP_TABLES
    familyTimer = Timer
    CorePulseProgress "Defaulting managed objects: editable lookup tables."
    DefaultManagedObjectLookupTableRows repairDefaultRows, lookupTableDefinitions
    If mManagedDefinitionCaptureActive Then mManagedDefinitionLookupConstructionElapsedSeconds = mManagedDefinitionLookupConstructionElapsedSeconds + ElapsedSecondsFromTimer(familyTimer)
    mManagedDefinitionCaptureFamily = MANAGED_DEFINITION_FAMILY_FORM_DESIGN
    familyTimer = Timer
    payloadElapsedBefore = mManagedDefinitionPayloadConstructionElapsedSeconds
    CorePulseProgress "Defaulting managed objects: FormDesign queries."
    DefaultManagedObjectFormDesignRows repairDefaultRows, formDesignDefinitions, formDesignPayloadDefinitions
    If mManagedDefinitionCaptureActive Then
        familyElapsed = ElapsedSecondsFromTimer(familyTimer) - (mManagedDefinitionPayloadConstructionElapsedSeconds - payloadElapsedBefore)
        If familyElapsed < 0 Then familyElapsed = 0
        mManagedDefinitionQueryConstructionElapsedSeconds = mManagedDefinitionQueryConstructionElapsedSeconds + familyElapsed
    End If
    mManagedDefinitionCaptureFamily = MANAGED_DEFINITION_FAMILY_SUPPORT
End Sub

Private Sub DefaultManagedObjectReviewQueryRows(ByVal repairDefaultRows As Boolean, ByVal definitions As Collection, ByVal payloadDefinitions As Collection)
    ApplyManagedObjectDefaultDefinitions definitions, repairDefaultRows
    ApplyActionPayloadDefaultDefinitions payloadDefinitions, repairDefaultRows
End Sub

Private Sub DefaultManagedObjectLookupTableRows(ByVal repairDefaultRows As Boolean, ByVal definitions As Collection)
    Dim rowData As Variant
    Dim processedCount As Long
    Dim totalCount As Long
    Dim dirtyTotal As Long
    Dim shouldProcess As Boolean
    totalCount = definitions.count
    If mManagedDefinitionDeltaExecutionActive Then
        For Each rowData In definitions
            If ManagedDefinitionObjectIsDirty(CStr(rowData(0)), CStr(rowData(1)), CStr(rowData(2))) Then dirtyTotal = dirtyTotal + 1
        Next rowData
    Else
        dirtyTotal = totalCount
    End If
    For Each rowData In definitions
        shouldProcess = True
        If mManagedDefinitionDeltaExecutionActive Then shouldProcess = ManagedDefinitionObjectIsDirty(CStr(rowData(0)), CStr(rowData(1)), CStr(rowData(2)))
        If shouldProcess Then
            processedCount = processedCount + 1
            If mManagedDefinitionCaptureActive = False Then
                PumpSetupResponsiveness
                PulseProgressEvery processedCount, 10, "Defaulting dirty editable lookup-table managed object " & CStr(processedCount) & " of " & CStr(dirtyTotal) & ": [" & CStr(rowData(0)) & "].", dirtyTotal, "CatalogLookupTableDefaults", "Catalog"
            End If
            DefaultDetailedManagedObject CStr(rowData(0)), CStr(rowData(1)), CStr(rowData(2)), CStr(rowData(3)), CLng(rowData(4)), repairDefaultRows
        End If
    Next rowData
End Sub

Private Sub ApplyCoreManagedObjectDeltaFromPlan()
    Dim keyValue As Variant
    Dim definitionData As Variant
    Dim deltaData As Variant
    Dim dirtyCount As Long
    Dim dirtyIndex As Long
    dirtyCount = mManagedDefinitionObjectInsertCount + mManagedDefinitionObjectUpdateCount
    For Each keyValue In mManagedDefinitionObjectOrder
        deltaData = mManagedDefinitionObjectDelta(CStr(keyValue))
        If StrComp(CStr(deltaData(0)), MANAGED_DEFINITION_STATUS_MATCHED, vbBinaryCompare) <> 0 Then
            dirtyIndex = dirtyIndex + 1
            definitionData = mManagedDefinitionObjectPlan(CStr(keyValue))
            PulseProgressEvery dirtyIndex, 10, "B3 applying captured managed-object definition " & CStr(dirtyIndex) & " of " & CStr(dirtyCount) & ": [" & CStr(definitionData(MANAGED_DEFINITION_OBJECT_NAME)) & "].", dirtyCount, "CatalogB3ObjectDelta", "Catalog"
            DefaultManagedObject CStr(definitionData(MANAGED_DEFINITION_OBJECT_NAME)), CStr(definitionData(MANAGED_DEFINITION_OBJECT_CATEGORY)), CStr(definitionData(MANAGED_DEFINITION_OBJECT_TYPE)), CStr(definitionData(MANAGED_DEFINITION_OBJECT_DESCRIPTION)), CLng(definitionData(MANAGED_DEFINITION_OBJECT_SORT_ORDER)), True, CStr(definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_TAB_KEY)), CStr(definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_TAB_LABEL)), CStr(definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_GROUP)), CLng(definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_ORDER)), CStr(definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_TITLE)), True, vbNullString, vbNullString, CStr(definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_STATIC_TAG))
        End If
    Next keyValue
End Sub

Private Sub ApplyPart14ManagedObjectDelta()
    Dim keyValue As Variant
    Dim definitionData As Variant
    Dim deltaData As Variant
    Dim dirtyCount As Long
    Dim dirtyIndex As Long
    dirtyCount = mManagedDefinitionObjectInsertCount + mManagedDefinitionObjectUpdateCount
    For Each keyValue In mManagedDefinitionObjectOrder
        deltaData = mManagedDefinitionObjectDelta(CStr(keyValue))
        If StrComp(CStr(deltaData(0)), MANAGED_DEFINITION_STATUS_MATCHED, vbBinaryCompare) <> 0 Then
            dirtyIndex = dirtyIndex + 1
            definitionData = mManagedDefinitionObjectPlan(CStr(keyValue))
            PulseProgressEvery dirtyIndex, 10, "B4 applying dirty managed object " & CStr(dirtyIndex) & " of " & CStr(dirtyCount) & ": [" & CStr(definitionData(MANAGED_DEFINITION_OBJECT_NAME)) & "].", dirtyCount, "CatalogPart14ObjectDelta", "Catalog"
            DefaultManagedObject CStr(definitionData(MANAGED_DEFINITION_OBJECT_NAME)), CStr(definitionData(MANAGED_DEFINITION_OBJECT_CATEGORY)), CStr(definitionData(MANAGED_DEFINITION_OBJECT_TYPE)), CStr(definitionData(MANAGED_DEFINITION_OBJECT_DESCRIPTION)), CLng(definitionData(MANAGED_DEFINITION_OBJECT_SORT_ORDER)), True, CStr(definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_TAB_KEY)), CStr(definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_TAB_LABEL)), CStr(definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_GROUP)), CLng(definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_ORDER)), CStr(definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_TITLE)), True, vbNullString, vbNullString, CStr(definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_STATIC_TAG))
        End If
    Next keyValue
End Sub

Private Sub EnsureManagedObjectOverridesTable()
    Dim tableName As String
    Dim fieldDefinitions As Collection
    Dim indexDefinitions As Collection
    tableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECT_OVERRIDES_TABLE_LOGICAL_ID)
    If B1ColdCreatedStructuralProofAvailable(tableName) Then
        RecordB1ColdCreateStructuralBypass tableName, 4
    Else
        Set fieldDefinitions = CatalogTableSchemaDefinitions(tableName)
        Set indexDefinitions = CatalogTableIndexDefinitions(tableName)
        EnsureCatalogTableExists tableName
        EnsureCatalogFieldsFromSchema tableName, fieldDefinitions
        EnsureManagedTableFieldOrder tableName, fieldDefinitions
        EnsureCatalogIndexesFromSchema tableName, indexDefinitions
    End If
    ApplyDefaultsOwnedLookupDefinitions tableName
