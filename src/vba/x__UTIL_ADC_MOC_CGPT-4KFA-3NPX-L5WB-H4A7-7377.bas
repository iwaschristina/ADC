' Purpose: Restores managed object row from setup rollback for managed object ID, prior row existed.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   managedObjectID (Input; Long): Primary-key ID of the managed-object catalog row targeted by the operation/rollback record.
'   priorRowExisted (Input; Boolean): Records whether the target/row existed before the change so rollback can restore the prior object/row rather than treating it as newly created.
'   rollbackSql (Input; String): SQL text or SQL-derived value used to define, validate, compare, or execute the rollback SQL operation.
' Returns: String: Returns the resolved restore managed object row from setup rollback text in the canonical representation consumed by this module's caller; vbNullString represents no applicable value where
'   the existing contract permits it.
Public Function RestoreManagedObjectRowFromSetupRollback(ByVal managedObjectID As Long, ByVal priorRowExisted As Boolean, ByVal rollbackSql As String) As String
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim rollbackParts As Variant
    Dim parentRollbackSql As String
    Dim overrideRollbackSql As String
    If managedObjectID <= 0 Then Err.Raise vbObjectError + 9507, "RestoreManagedObjectRowFromSetupRollback", "A positive ManagedObjectID is required."
    Set db = ResolveCatalogDb()
    If priorRowExisted Then
        If Len(Trim$(rollbackSql)) = 0 Then Err.Raise vbObjectError + 9508, "RestoreManagedObjectRowFromSetupRollback", "The existing row has no restore SQL."
        rollbackParts = Split(rollbackSql, MANAGED_OBJECT_ROLLBACK_OVERRIDE_DELIMITER, 2, vbBinaryCompare)
        parentRollbackSql = CStr(rollbackParts(0))
        If UBound(rollbackParts) >= 1 Then overrideRollbackSql = CStr(rollbackParts(1))
        db.Execute parentRollbackSql, dbFailOnError
        If db.RecordsAffected <> 1 Then Err.Raise vbObjectError + 9509, "RestoreManagedObjectRowFromSetupRollback", "The existing MAC row could not be restored exactly." & vbCrLf & "ManagedObjectID: " & CStr(managedObjectID) & vbCrLf & "Rows affected: " & CStr(db.RecordsAffected)
        If Len(Trim$(overrideRollbackSql)) > 0 Then db.Execute overrideRollbackSql, dbFailOnError
        RestoreManagedObjectRowFromSetupRollback = "RESTORED"
    Else
        If SharedDao_DatabaseTableExistsSafe(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectFields")) Then
            If SharedDao_DatabaseTableExistsSafe(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectFieldValues")) Then db.Execute "DELETE FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectFieldValues") & "] WHERE [" & FIELD_MANAGED_OBJECT_FIELD_VALUE_MANAGED_OBJECT_FIELD_ID & "] In (SELECT " & SQL_FIELD_ID & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectFields") & "] WHERE [" & FIELD_MANAGED_OBJECT_ID & "]=" & CStr(managedObjectID) & ");", dbFailOnError
            db.Execute "DELETE FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectFields") & "] WHERE [" & FIELD_MANAGED_OBJECT_ID & "]=" & CStr(managedObjectID) & ";", dbFailOnError
        End If
        If SharedDao_DatabaseTableExistsSafe(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies")) Then db.Execute "DELETE FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies") & "] WHERE [" & FIELD_MANAGED_OBJECT_ID & "]=" & CStr(managedObjectID) & " OR [" & FIELD_DEPENDS_ON_MANAGED_OBJECT_ID & "]=" & CStr(managedObjectID) & ";", dbFailOnError
        If SharedDao_DatabaseTableExistsSafe(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads")) Then db.Execute "DELETE FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads") & "] WHERE [" & FIELD_MANAGED_OBJECT_ID & "]=" & CStr(managedObjectID) & ";", dbFailOnError
        If SharedDao_DatabaseTableExistsSafe(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECT_OVERRIDES_TABLE_LOGICAL_ID)) Then db.Execute "DELETE FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECT_OVERRIDES_TABLE_LOGICAL_ID) & "] WHERE [" & FIELD_MANAGED_OBJECT_ID & "]=" & CStr(managedObjectID) & ";", dbFailOnError
        If SharedDao_DatabaseTableExistsSafe(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID)) Then db.Execute "DELETE FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] WHERE " & SQL_FIELD_ID & "=" & CStr(managedObjectID) & ";", dbFailOnError
        If CountRowsIfTableExists(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), SQL_FIELD_ID & "=" & CStr(managedObjectID)) <> 0 Then Err.Raise vbObjectError + 9510, "RestoreManagedObjectRowFromSetupRollback", "A setup-inserted MAC row remained after rollback deletion." & vbCrLf & FIELD_MANAGED_OBJECT_ID & ": " & CStr(managedObjectID)
        RestoreManagedObjectRowFromSetupRollback = "DELETED"
    End If
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    Err.Raise savedErrNumber, "RestoreManagedObjectRowFromSetupRollback", "Could not restore a tracked MAC row." & vbCrLf & "ManagedObjectID: " & CStr(managedObjectID) & vbCrLf & "Prior row existed: " & CStr(priorRowExisted) & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Function

' Purpose: Resolves form design query SQL from the supplied/current ADC state, using `ManagedObjectPhysicalName` and `End` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   queryName (Input; String): Canonical or physical name identifying the query targeted by this operation.
' Returns: String: Returns the SQL text produced by this routine. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not resolved.
Public Function FormDesignQuerySql(ByVal queryName As String) As String
    ' Implementation mapping only. FormDesign query membership, build family, and build order come exclusively from the managed-object definitions owned by
    Select Case Trim$(queryName)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_Config_Display"): FormDesignQuerySql = FormDesignSourceRowSql()
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_Config_Configured"): FormDesignQuerySql = FormDesignSourceRowFilteredSql(vbNullString, "Configuration macro rows only.")
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_Config_Candidates"): FormDesignQuerySql = FormDesignCandidateSourceRowSql()
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_Config_ReviewQueue"): FormDesignQuerySql = FormDesignSourceRowFilteredSql(FormDesignReviewQueueWhereSql(), "Rows likely to need manual review.")
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_Config_TargetResolution"): FormDesignQuerySql = FormDesignSourceRowFilteredSql(FormDesignTargetResolutionWhereSql(), "Rows with config-owner routing or procedure-resolution issues.")
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_LauncherControls_BackfillSource"): FormDesignQuerySql = FormDesignLauncherBackfillSourceSql()
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_LauncherControls_ReviewSource"): FormDesignQuerySql = FormDesignCustomMacroLauncherReviewSourceSql()
        Case Else
            Err.Raise vbObjectError + 7812, "FormDesignQuerySql", "A canonical FormDesign managed query has no SQL implementation mapping." & vbCrLf & "Query: " & queryName
    End Select
End Function

Private Function FormDesignSourceRowSql() As String
    Dim sqlText As String
    sqlText = "SELECT " & OrderedTableSelectList(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Config"), "C") & ", "
    sqlText = sqlText & SharedDao_SqlQuote(ROW_KIND_CONFIGURATION) & " AS " & SQL_FIELD_ROW_KIND & ", 'Config' AS " & SQL_FIELD_ROW_CATEGORY & ", "
    sqlText = sqlText & "IIf(Nz([" & FIELD_ACTIVE & "],0)<>0,'Active','Inactive') AS " & SQL_FIELD_ACTIVE_DISPLAY & ", "
    sqlText = sqlText & "Nz(" & SQL_FIELD_MACRO_TITLE & ",Nz(" & SQL_FIELD_MACRO_KEY & ",'')) AS " & SQL_FIELD_DISPLAY_TITLE & ", "
    sqlText = sqlText & "Nz(" & SQL_FIELD_MACRO_KEY & ",'') AS " & SQL_FIELD_DISPLAY_MACRO_KEY & ", "
    sqlText = sqlText & "IIf(Len(Nz(" & SQL_FIELD_TARGET_PROCEDURE_NAME & ",''))>0,Nz(" & SQL_FIELD_TARGET_PROCEDURE_NAME & ",''),Nz(" & SQL_FIELD_GENERATED_MACRO_OBJECT_NAME & ",'')) AS " & SQL_FIELD_DISPLAY_TARGET & ", "
    sqlText = sqlText & "IIf(Len(Nz(" & SQL_FIELD_MANUAL_REVIEW_STATUS & ",''))>0,Nz(" & SQL_FIELD_MANUAL_REVIEW_STATUS & ",''),IIf(UCase(Nz(" & SQL_FIELD_CONFIGURATION_STATUS & ",''))=" & SharedDao_SqlQuote(UCase$(CONFIGURATION_STATUS_NEEDS_REVIEW)) & ",'" & MANUAL_REVIEW_STATUS_NEEDS_REVIEW & "','')) AS " & SQL_FIELD_DISPLAY_REVIEW_STATUS & " "
    sqlText = sqlText & "FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Config") & "] AS C "
    'MC_Records is configuration-only; keep this ORDER BY independent of candidate-only CandidateMacroKey.
    sqlText = sqlText & "ORDER BY Nz(" & SQL_FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER & ",0), Nz(" & SQL_FIELD_MACRO_TITLE & ",Nz(" & SQL_FIELD_MACRO_KEY & ",'')), " & SQL_FIELD_ID & ";"
    FormDesignSourceRowSql = sqlText
End Function

Private Function FormDesignCandidateSourceRowSql() As String
    Dim sqlText As String
    sqlText = "SELECT " & OrderedTableSelectList(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Candidates"), "C") & ", "
    sqlText = sqlText & "IIf(Nz(" & SQL_FIELD_CANDIDATE_STATUS & ",'')=" & SharedDao_SqlQuote(CANDIDATE_STATUS_SCAN_ERROR) & "," & SharedDao_SqlQuote("DiscoveryError") & "," & SharedDao_SqlQuote(ROW_KIND_CANDIDATE) & ") AS " & SQL_FIELD_ROW_KIND & ", 'Candidate' AS " & SQL_FIELD_ROW_CATEGORY & ", "
    sqlText = sqlText & "'Candidate' AS " & SQL_FIELD_ACTIVE_DISPLAY & ", Nz(" & SQL_FIELD_MACRO_TITLE & ",Nz(" & SQL_FIELD_CANDIDATE_MACRO_KEY & ",Nz(" & SQL_FIELD_MACRO_KEY & ",''))) AS " & SQL_FIELD_DISPLAY_TITLE & ", "
    sqlText = sqlText & "Nz(" & SQL_FIELD_MACRO_KEY & ",Nz(" & SQL_FIELD_CANDIDATE_MACRO_KEY & ",'')) AS " & SQL_FIELD_DISPLAY_MACRO_KEY & ", "
    sqlText = sqlText & "IIf(Len(Nz(" & SQL_FIELD_TARGET_PROCEDURE_NAME & ",''))>0,Nz(" & SQL_FIELD_TARGET_PROCEDURE_NAME & ",''),Nz(" & SQL_FIELD_TARGET_OBJECT_NAME & ",'')) AS " & SQL_FIELD_DISPLAY_TARGET & ", "
    sqlText = sqlText & "Nz(" & SQL_FIELD_MANUAL_REVIEW_STATUS & ",Nz(" & SQL_FIELD_CANDIDATE_STATUS & ",'')) AS " & SQL_FIELD_DISPLAY_REVIEW_STATUS & ", " & SharedDao_SqlQuote("Candidate/discovery rows.") & " AS " & SQL_FIELD_FORM_DESIGN_CATEGORY_NOTE & " "
    sqlText = sqlText & "FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Candidates") & "] AS C ORDER BY " & SQL_FIELD_ID & ";"
    FormDesignCandidateSourceRowSql = sqlText
End Function

Private Function FormDesignSourceRowFilteredSql(ByVal whereSql As String, ByVal categoryNote As String) As String
    Dim sqlText As String
    sqlText = "SELECT " & OrderedQuerySelectList(ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_Config_Display"), "S") & ", " & SharedDao_SqlQuote(categoryNote) & " AS " & SQL_FIELD_FORM_DESIGN_CATEGORY_NOTE & " "
    sqlText = sqlText & "FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_Config_Display") & "] AS S "
    If Len(Trim$(whereSql)) > 0 Then
        sqlText = sqlText & "WHERE " & whereSql & " "
    End If
    sqlText = sqlText & "ORDER BY " & OrderByPolicyText("CATALOG_FORMDESIGN_DISPLAY") & ";"
    FormDesignSourceRowFilteredSql = sqlText
End Function

Private Function FormDesignReviewQueueWhereSql() As String
    Dim sqlText As String
    sqlText = "("
    sqlText = sqlText & "UCase(Nz(" & SQL_FIELD_CONFIGURATION_STATUS & ",'')) IN (" & SharedDao_SqlQuote(UCase$(CONFIGURATION_STATUS_NEEDS_REVIEW)) & "," & SharedDao_SqlQuote(UCase$(CONFIGURATION_STATUS_INVALID)) & ",'ERROR') "
    sqlText = sqlText & "OR UCase(Nz(" & SQL_FIELD_MANUAL_REVIEW_STATUS & ",'')) IN (" & SharedDao_SqlQuote(UCase$(MANUAL_REVIEW_STATUS_NEEDS_REVIEW)) & "," & SharedDao_SqlQuote(UCase$(MANUAL_REVIEW_STATUS_BLOCKED)) & "," & SharedDao_SqlQuote(UCase$(MANUAL_REVIEW_STATUS_DEFERRED)) & ") "
    sqlText = sqlText & "OR UCase(Nz(" & SQL_FIELD_LAST_VALIDATION_RESULT & ",'')) IN (" & SharedDao_SqlQuote(UCase$(VALIDATION_RESULT_INVALID)) & "," & SharedDao_SqlQuote(UCase$(VALIDATION_RESULT_NEEDS_REVIEW)) & "," & SharedDao_SqlQuote(UCase$(VALIDATION_RESULT_ERROR)) & ") "
    sqlText = sqlText & "OR UCase(Nz(" & SQL_FIELD_LAST_GENERATED_RESULT & ",'')) IN (" & SharedDao_SqlQuote(UCase$(GENERATED_RESULT_FAILED)) & "," & SharedDao_SqlQuote(UCase$(GENERATED_RESULT_NEEDS_REVIEW)) & "," & SharedDao_SqlQuote(UCase$(GENERATED_RESULT_INVALID)) & ")"
    sqlText = sqlText & ")"
    FormDesignReviewQueueWhereSql = sqlText
End Function

Private Function FormDesignTargetResolutionWhereSql() As String
    Dim sqlText As String
    sqlText = "("
    sqlText = sqlText & "Len(Nz([" & FIELD_CONFIG_OWNER_DATABASE_ROLE & "],''))=0 "
    sqlText = sqlText & "OR (UCase(Nz(" & SQL_FIELD_MACRO_ACTION & ",''))=" & SharedDao_SqlQuote(UCase$(ACTION_RUNCODE)) & " AND Len(Nz(" & SQL_FIELD_TARGET_PROCEDURE_NAME & ",''))=0) "
    sqlText = sqlText & "OR (UCase(Nz(" & SQL_FIELD_MACRO_ACTION & ",''))=" & SharedDao_SqlQuote(UCase$(ACTION_OPENFORM)) & " AND Len(Nz(" & SQL_FIELD_TARGET_OBJECT_NAME & ",''))=0) "
    sqlText = sqlText & "OR UCase(Nz(" & SQL_FIELD_LAST_VALIDATION_RESULT & ",'')) IN (" & SharedDao_SqlQuote(UCase$(VALIDATION_RESULT_INVALID)) & "," & SharedDao_SqlQuote(UCase$(VALIDATION_RESULT_NEEDS_REVIEW)) & "," & SharedDao_SqlQuote(UCase$(VALIDATION_RESULT_ERROR)) & ")"
    sqlText = sqlText & ")"
    FormDesignTargetResolutionWhereSql = sqlText
End Function

Private Function FormDesignLauncherBackfillSourceSql() As String
    Dim sqlText As String
    sqlText = "SELECT " & SQL_FIELD_ID & ", " & SQL_FIELD_MACRO_KEY & ", " & SQL_FIELD_MACRO_TITLE & ", [" & FIELD_CONFIG_OWNER_DATABASE_ROLE & "], " & SQL_FIELD_GENERATED_MACRO_OBJECT_NAME & ", " & SQL_FIELD_LAUNCHER_TOOLTIP & ", " & SQL_FIELD_OBJECT_DESCRIPTION & ", " & SQL_FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER & ", " & SQL_FIELD_NAVIGATION_PANE_GROUP & ", " & SQL_FIELD_CONFIRMATION_MODE & ", " & SQL_FIELD_DISPLAY_TITLE & ", " & SQL_FIELD_DISPLAY_MACRO_KEY & " "
    sqlText = sqlText & "FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_Config_Configured") & "] "
    sqlText = sqlText & "WHERE Nz([" & FIELD_ACTIVE & "],0)<>0 "
    sqlText = sqlText & "AND Len(Nz(" & SQL_FIELD_GENERATED_MACRO_OBJECT_NAME & ",''))>0 "
    sqlText = sqlText & "AND UCase(Nz(" & SQL_FIELD_MACRO_TITLE & ",''))<>'AUTOEXEC' "
    sqlText = sqlText & "AND UCase(Nz(" & SQL_FIELD_MACRO_KEY & ",''))<>'AUTOEXEC' "
    sqlText = sqlText & "ORDER BY " & OrderByPolicyText("CATALOG_FORMDESIGN_LAUNCHER") & ";"
    FormDesignLauncherBackfillSourceSql = sqlText
End Function

Private Function FormDesignCustomMacroLauncherReviewSourceSql() As String
    Dim sqlText As String
    sqlText = "SELECT " & SQL_FIELD_ID & ", " & SQL_FIELD_MACRO_KEY & ", " & SQL_FIELD_MACRO_TITLE & ", [" & FIELD_CONFIG_OWNER_DATABASE_ROLE & "], " & SQL_FIELD_GENERATED_MACRO_OBJECT_NAME & ", " & SQL_FIELD_LAUNCHER_TOOLTIP & ", " & SQL_FIELD_OBJECT_DESCRIPTION & ", " & SQL_FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER & ", " & SQL_FIELD_NAVIGATION_PANE_GROUP & ", " & SQL_FIELD_CONFIRMATION_MODE & ", " & SQL_FIELD_LAST_GENERATED_ON & ", " & SQL_FIELD_LAST_GENERATED_RESULT & ", " & SQL_FIELD_DISPLAY_TITLE & ", " & SQL_FIELD_DISPLAY_MACRO_KEY & " "
    sqlText = sqlText & "FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_Config_Configured") & "] "
    sqlText = sqlText & "WHERE Nz([" & FIELD_ACTIVE & "],0)<>0 "
    sqlText = sqlText & "AND (Len(Nz(" & SQL_FIELD_GENERATED_MACRO_OBJECT_NAME & ",''))>0 OR Len(Nz(" & SQL_FIELD_MACRO_TITLE & ",''))>0 OR Len(Nz(" & SQL_FIELD_MACRO_KEY & ",''))>0) "
    sqlText = sqlText & "ORDER BY " & OrderByPolicyText("CATALOG_FORMDESIGN_LAUNCHER") & ";"
    FormDesignCustomMacroLauncherReviewSourceSql = sqlText
End Function

Private Sub AddUniqueLong(ByRef values As Collection, ByVal valueNumber As Long)
    'Adds one Long value once by using its invariant decimal text as the Collection key.
    On Error Resume Next
    ' INTENTIONAL FILTERED PARTITION: values is a consumer-required subset/projection derived from the source enumerated by AddUniqueLong; its membership is not independently authoritative.
    If values Is Nothing Then Set values = New Collection
    values.Add valueNumber, CStr(valueNumber)
End Sub

Private Function UniquePhysicalObjectTypeFromSnapshot(ByVal physicalRows As Collection, ByVal objectName As String, ByRef matchCount As Long, ByRef matchText As String) As String
    'Resolves one object name against the in-memory physical catalog snapshot and reports every matching supported Access object type.
    Dim physicalData As Variant
    Dim uniqueType As String
    matchCount = 0
    matchText = vbNullString
    If Len(objectName) = 0 Then Exit Function
    If physicalRows Is Nothing Then Exit Function
    For Each physicalData In physicalRows
        PumpSetupResponsiveness
        If StrComp(CStr(physicalData(0)), objectName, vbTextCompare) = 0 Then AppendPhysicalTypeMatch True, CStr(physicalData(1)), matchCount, matchText, uniqueType
    Next physicalData
    If matchCount = 1 Then UniquePhysicalObjectTypeFromSnapshot = uniqueType
End Function

Private Sub AppendPhysicalTypeMatch(ByVal typeExists As Boolean, ByVal objectTypeCode As String, ByRef matchCount As Long, ByRef matchText As String, ByRef uniqueType As String)
    If typeExists = False Then Exit Sub
    matchCount = matchCount + 1
    If Len(matchText) > 0 Then matchText = matchText & ", "
    matchText = matchText & objectTypeCode
    uniqueType = objectTypeCode
End Sub

Private Function MergeDuplicateAuditNotes(ByVal canonicalNotes As String, ByVal duplicateNotes As String, ByVal duplicateID As Long) As String
    canonicalNotes = Trim$(canonicalNotes)
    duplicateNotes = Trim$(duplicateNotes)
    MergeDuplicateAuditNotes = canonicalNotes
    If Len(duplicateNotes) > 0 And InStr(1, canonicalNotes, duplicateNotes, vbBinaryCompare) = 0 Then
        If Len(MergeDuplicateAuditNotes) > 0 Then MergeDuplicateAuditNotes = MergeDuplicateAuditNotes & " | "
        MergeDuplicateAuditNotes = MergeDuplicateAuditNotes & "Merged note from duplicate " & FIELD_MANAGED_OBJECT_ID & "=" & CStr(duplicateID) & ": " & duplicateNotes
    End If
End Function

Private Sub MoveDuplicateActionPayloads(ByVal db As DAO.Database, ByVal payloadTableName As String, ByVal duplicateID As Long, ByVal canonicalID As Long, ByVal canonicalName As String, ByRef movedCount As Long, ByRef mergedCount As Long)
    'Moves payload kinds that do not exist on the canonical row and safely merges only functionally equivalent payload rows.
    'The canonical payload set is loaded once for this duplicate Form; it is requeried only after a move changes membership in that set.
    Dim duplicateRows As DAO.Recordset
    Dim canonicalRows As DAO.Recordset
    Dim canonicalEdit As DAO.Recordset
    Dim duplicatePayloadID As Long
    Dim canonicalPayloadID As Long
    Dim canonicalMatchCount As Long
    Dim payloadKind As String
    Dim differenceText As String
    Dim mergedNotes As String
    Set duplicateRows = db.OpenRecordset("SELECT * FROM [" & payloadTableName & "] WHERE [" & FIELD_MANAGED_OBJECT_ID & "]=" & CStr(duplicateID) & " ORDER BY " & SQL_FIELD_ID & ";", dbOpenSnapshot)
    Set canonicalRows = db.OpenRecordset("SELECT * FROM [" & payloadTableName & "] WHERE [" & FIELD_MANAGED_OBJECT_ID & "]=" & CStr(canonicalID) & " ORDER BY " & SQL_FIELD_ID & ";", dbOpenSnapshot)
    Set canonicalEdit = db.OpenRecordset("SELECT * FROM [" & payloadTableName & "] WHERE [" & FIELD_MANAGED_OBJECT_ID & "]=" & CStr(canonicalID) & " ORDER BY " & SQL_FIELD_ID & ";", dbOpenDynaset)
    Do While Not duplicateRows.EOF
        PumpSetupResponsiveness
        duplicatePayloadID = CLng(duplicateRows.fields(FIELD_ID))
        payloadKind = CStr(Nz(duplicateRows!payloadKind, vbNullString))
        canonicalPayloadID = 0
        canonicalMatchCount = 0
        differenceText = vbNullString
        If canonicalRows.EOF = False Then canonicalRows.MoveFirst
        Do While canonicalRows.EOF = False
            If StrComp(CStr(Nz(canonicalRows.fields(FIELD_PAYLOAD_KIND).value, vbNullString)), payloadKind, vbTextCompare) = 0 Then
                canonicalMatchCount = canonicalMatchCount + 1
                If canonicalMatchCount = 1 Then
                    canonicalPayloadID = CLng(canonicalRows.fields(FIELD_ID))
                    differenceText = ActionPayloadDifferenceText(duplicateRows, canonicalRows)
                End If
            End If
            canonicalRows.MoveNext
        Loop
        If canonicalMatchCount = 0 Then
            db.Execute "UPDATE [" & payloadTableName & "] SET [" & FIELD_MANAGED_OBJECT_ID & "]=" & CStr(canonicalID) & "," & SQL_FIELD_MANAGED_OBJECT_DEPENDENCY_NOTES & "=IIf(Len(Trim(Nz(" & SQL_FIELD_MANAGED_OBJECT_DEPENDENCY_NOTES & ",'')))=0,''," & SQL_FIELD_MANAGED_OBJECT_DEPENDENCY_NOTES & " & ' | ') & " & SharedDao_SqlQuote("Reassigned from duplicate " & FIELD_MANAGED_OBJECT_ID & "=" & CStr(duplicateID) & " to canonical Form " & canonicalName & ".") & " WHERE " & SQL_FIELD_ID & "=" & CStr(duplicatePayloadID) & ";", dbFailOnError
            movedCount = movedCount + db.RecordsAffected
            'The move changes which rows belong to the canonical set; refresh only at this actual mutation boundary.
            canonicalRows.Requery
            canonicalEdit.Requery
        Else
            If canonicalMatchCount > 1 Then Err.Raise vbObjectError + 9093, "MoveDuplicateActionPayloads", "The canonical managed-form row already has multiple action payloads with the same PayloadKind." & vbCrLf & "Canonical form: " & canonicalName & vbCrLf & "Canonical ManagedObjectID: " & CStr(canonicalID) & vbCrLf & "PayloadKind: " & IIf(Len(payloadKind) = 0, "(blank)", payloadKind)
            If Len(differenceText) > 0 Then Err.Raise vbObjectError + 9094, "MoveDuplicateActionPayloads", "A duplicate managed-form action payload conflicts with the canonical payload and cannot be combined safely." & vbCrLf & "Canonical form: " & canonicalName & vbCrLf & "Duplicate ManagedObjectID: " & CStr(duplicateID) & vbCrLf & "Canonical ManagedObjectID: " & CStr(canonicalID) & vbCrLf & "PayloadKind: " & IIf(Len(payloadKind) = 0, "(blank)", payloadKind) & vbCrLf & "Conflicting fields: " & differenceText
            canonicalEdit.FindFirst SQL_FIELD_ID & "=" & CStr(canonicalPayloadID)
            If canonicalEdit.NoMatch Then Err.Raise vbObjectError + 9095, "MoveDuplicateActionPayloads", "The canonical action payload disappeared before an equivalent duplicate payload could be merged." & vbCrLf & "Canonical form: " & canonicalName & vbCrLf & "Canonical payload ID: " & CStr(canonicalPayloadID)
            canonicalEdit.Edit
            If IsNull(duplicateRows.fields(FIELD_DEFAULTED_ON).value) = False Then
                If IsNull(canonicalEdit.fields(FIELD_DEFAULTED_ON).value) Then
                    canonicalEdit.fields(FIELD_DEFAULTED_ON).value = duplicateRows.fields(FIELD_DEFAULTED_ON).value
                ElseIf CDate(duplicateRows.fields(FIELD_DEFAULTED_ON).value) < CDate(canonicalEdit.fields(FIELD_DEFAULTED_ON).value) Then
                    canonicalEdit.fields(FIELD_DEFAULTED_ON).value = duplicateRows.fields(FIELD_DEFAULTED_ON).value
                End If
            End If
            If IsNull(duplicateRows.fields(FIELD_LAST_DEFAULT_REPAIR_ON).value) = False Then
                If IsNull(canonicalEdit.fields(FIELD_LAST_DEFAULT_REPAIR_ON).value) Then
                    canonicalEdit.fields(FIELD_LAST_DEFAULT_REPAIR_ON).value = duplicateRows.fields(FIELD_LAST_DEFAULT_REPAIR_ON).value
                ElseIf CDate(duplicateRows.fields(FIELD_LAST_DEFAULT_REPAIR_ON).value) > CDate(canonicalEdit.fields(FIELD_LAST_DEFAULT_REPAIR_ON).value) Then
                    canonicalEdit.fields(FIELD_LAST_DEFAULT_REPAIR_ON).value = duplicateRows.fields(FIELD_LAST_DEFAULT_REPAIR_ON).value
                End If
            End If
            mergedNotes = MergeDuplicateAuditNotes(CStr(Nz(canonicalEdit.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_NOTES), vbNullString)), CStr(Nz(duplicateRows.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_NOTES), vbNullString)), duplicateID)
            canonicalEdit.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_NOTES) = Shared_String_ConvertToNullIfBlank(mergedNotes)
            canonicalEdit.Update
            db.Execute "DELETE FROM [" & payloadTableName & "] WHERE " & SQL_FIELD_ID & "=" & CStr(duplicatePayloadID) & ";", dbFailOnError
            mergedCount = mergedCount + db.RecordsAffected
        End If
        duplicateRows.MoveNext
    Loop
    canonicalEdit.Close
    canonicalRows.Close
    duplicateRows.Close
End Sub

Private Sub AddCountFinding(ByRef findings As Collection, ByVal messageText As String, ByVal sqlText As String)
    Dim foundCount As Long
    foundCount = CatalogCountSql(sqlText)
    If foundCount > 0 Then findings.Add messageText & " Count: " & CStr(foundCount)
End Sub

Private Sub AddMissingLookupFinding(ByRef findings As Collection, ByVal messageText As String, ByVal sourceTableName As String, ByVal sourceFieldName As String, ByVal lookupTableName As String, ByVal lookupFieldName As String)
    Dim sqlText As String
    sqlText = "SELECT Count(*) AS " & FIELD_CNT & " FROM [" & sourceTableName & "] AS s LEFT JOIN [" & lookupTableName & "] AS l ON s.[" & sourceFieldName & "]=l.[" & lookupFieldName & "] WHERE Len(Nz(s.[" & sourceFieldName & "],''))>0 AND l.[" & lookupFieldName & "] Is Null;"
    AddCountFinding findings, messageText, sqlText
End Sub

Private Sub AddCatalogDuplicateFindings(ByRef findings As Collection)
    Dim duplicateSystemMacroDesignatorDetail As String
    If CatalogCountSql("SELECT Count(*) AS " & FIELD_CNT & " FROM (SELECT [" & FIELD_CATEGORY_CODE & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ObjectCategories") & "] GROUP BY [" & FIELD_CATEGORY_CODE & "] HAVING Count(*)>1) AS q;") > 0 Then findings.Add "Duplicate CategoryCode values exist in " & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ObjectCategories") & "."
    If CatalogCountSql("SELECT Count(*) AS " & FIELD_CNT & " FROM (SELECT " & SQL_FIELD_OBJECT_NAME & ", " & SQL_FIELD_OBJECT_TYPE & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] GROUP BY " & SQL_FIELD_OBJECT_NAME & ", " & SQL_FIELD_OBJECT_TYPE & " HAVING Count(*)>1) AS q;") > 0 Then findings.Add "Duplicate ObjectName/ObjectType values exist in " & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "."
    If CatalogCountSql("SELECT Count(*) AS " & FIELD_CNT & " FROM (SELECT [" & FIELD_SYSTEM_MACRO_KEY & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & "] GROUP BY [" & FIELD_SYSTEM_MACRO_KEY & "] HAVING Count(*)>1) AS q;") > 0 Then findings.Add "Duplicate SystemMacroKey values exist in " & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & "."
    If CatalogCountSql("SELECT Count(*) AS " & FIELD_CNT & " FROM (SELECT [" & FIELD_SYSTEM_MACRO_DESIGNATOR & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & "] WHERE Nz([" & FIELD_SYSTEM_MACRO_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " GROUP BY [" & FIELD_SYSTEM_MACRO_DESIGNATOR & "] HAVING Count(*)>1) AS q;") > 0 Then
        duplicateSystemMacroDesignatorDetail = ActiveSystemMacroDesignatorDuplicateDetail()
        If Len(duplicateSystemMacroDesignatorDetail) > 0 Then
            findings.Add "Duplicate active SystemMacroDesignator values exist in " & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & "." & vbCrLf & duplicateSystemMacroDesignatorDetail
        Else
            findings.Add "Duplicate active SystemMacroDesignator values exist in " & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & "."
        End If
    End If
End Sub

