' Purpose: Resolves manual review form SQL from the supplied/current ADC state, using `ManagedObjectPhysicalName` and `OR` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
' Returns: String: Returns the SQL text produced by this routine. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not resolved.
Public Function ManualReviewFormSql() As String
    'Returns editable manual-review rows from the configuration authority. Candidate review remains on the separate candidate review source so both forms stay updateable.
    Dim sqlText As String
    Dim manualStatusProblem As String
    Dim configurationStatusProblem As String
    Dim validationProblem As String
    Dim generationProblem As String
    Dim reviewSortExpression As String
    manualStatusProblem = "Nz(cfg." & SQL_FIELD_MANUAL_REVIEW_STATUS & ",'')=" & SharedDao_SqlQuote(MANUAL_REVIEW_STATUS_NEEDS_REVIEW) & " Or Nz(cfg." & SQL_FIELD_MANUAL_REVIEW_STATUS & ",'')=" & SharedDao_SqlQuote(MANUAL_REVIEW_STATUS_BLOCKED) & " Or Nz(cfg." & SQL_FIELD_MANUAL_REVIEW_STATUS & ",'')=" & SharedDao_SqlQuote(MANUAL_REVIEW_STATUS_DEFERRED)
    configurationStatusProblem = "Nz(cfg." & SQL_FIELD_CONFIGURATION_STATUS & ",'')=" & SharedDao_SqlQuote(CONFIGURATION_STATUS_NEEDS_REVIEW) & " Or Nz(cfg." & SQL_FIELD_CONFIGURATION_STATUS & ",'')=" & SharedDao_SqlQuote(CONFIGURATION_STATUS_INVALID)
    validationProblem = "Nz(cfg." & SQL_FIELD_LAST_VALIDATION_RESULT & ",'')=" & SharedDao_SqlQuote(VALIDATION_RESULT_INVALID) & " Or Nz(cfg." & SQL_FIELD_LAST_VALIDATION_RESULT & ",'')=" & SharedDao_SqlQuote(VALIDATION_RESULT_ERROR) & " Or Nz(cfg." & SQL_FIELD_LAST_VALIDATION_RESULT & ",'')=" & SharedDao_SqlQuote(VALIDATION_RESULT_NEEDS_REVIEW)
    generationProblem = "Nz(cfg." & SQL_FIELD_LAST_GENERATED_RESULT & ",'')=" & SharedDao_SqlQuote(GENERATED_RESULT_FAILED) & " Or Nz(cfg." & SQL_FIELD_LAST_GENERATED_RESULT & ",'')=" & SharedDao_SqlQuote(GENERATED_RESULT_INVALID) & " Or Nz(cfg." & SQL_FIELD_LAST_GENERATED_RESULT & ",'')=" & SharedDao_SqlQuote(GENERATED_RESULT_NEEDS_REVIEW)
    reviewSortExpression = ManualReviewSortExpression("cfg." & SQL_FIELD_MANUAL_REVIEW_STATUS, "cfg." & SQL_FIELD_CONFIGURATION_STATUS)
    sqlText = "SELECT cfg." & SQL_FIELD_ID & ", " & SharedDao_SqlQuote(ROW_KIND_CONFIGURATION) & " AS " & SQL_FIELD_ROW_KIND & ", cfg." & SQL_FIELD_MACRO_KEY & ", Null AS " & SQL_FIELD_CANDIDATE_MACRO_KEY & ", cfg." & SQL_FIELD_MACRO_TITLE & ", cfg.[" & FIELD_MACRO_CATEGORY_KEY & "], cfg.[" & FIELD_MACRO_SUBCATEGORY_KEY & "], cfg.[" & FIELD_ACTIVE & "], "
    sqlText = sqlText & "cfg." & SQL_FIELD_CONFIGURATION_STATUS & ", Null AS " & SQL_FIELD_CANDIDATE_STATUS & ", cfg." & SQL_FIELD_MANUAL_REVIEW_STATUS & ", cfg." & SQL_FIELD_MANUAL_REVIEW_NOTES & ", cfg." & SQL_FIELD_REVIEW_PRIORITY & ", "
    sqlText = sqlText & "cfg." & SQL_FIELD_MACRO_ACTION & ", cfg.[" & FIELD_CONFIG_OWNER_DATABASE_ROLE & "], Null AS [" & FIELD_CANDIDATE_OWNER_DATABASE_ROLE & "], cfg." & SQL_FIELD_TARGET_PROCEDURE_NAME & ", cfg." & SQL_FIELD_TARGET_PROCEDURE_MODULE_NAME & ", cfg." & SQL_FIELD_TARGET_OBJECT_NAME & ", "
    sqlText = sqlText & "False AS " & SQL_FIELD_SELECTED_FOR_ACCEPTANCE & ", Null AS " & SQL_FIELD_ACCEPTANCE_STATUS & ", Null AS " & SQL_FIELD_ACCEPTED_ON & ", Null AS " & SQL_FIELD_ACCEPTED_CONFIGURATION_ID & ", Null AS " & SQL_FIELD_ACCEPTANCE_NOTES & ", cfg." & SQL_FIELD_SELECTED_FOR_DUPLICATE_DELETION & ", cfg." & SQL_FIELD_GENERATED_MACRO_OBJECT_NAME & ", "
    sqlText = sqlText & "cfg." & SQL_FIELD_LAST_VALIDATED_ON & ", cfg." & SQL_FIELD_LAST_VALIDATION_RESULT & ", cfg." & SQL_FIELD_LAST_VALIDATION_NOTES & ", cfg." & SQL_FIELD_LAST_GENERATED_ON & ", cfg." & SQL_FIELD_LAST_GENERATED_RESULT & ", cfg." & SQL_FIELD_LAST_GENERATED_NOTES & ", "
    sqlText = sqlText & "Trim(IIf(" & manualStatusProblem & ",'Manual review status; ','')) & Trim(IIf(" & configurationStatusProblem & ",'Config status; ','')) & Trim(IIf(" & validationProblem & ",'Validation; ','')) & Trim(IIf(" & generationProblem & ",'Generation; ','')) AS " & FIELD_REVIEW_REASON & ", "
    sqlText = sqlText & reviewSortExpression & " AS " & FIELD_REVIEW_SORT & ", IIf(Len(Nz(cfg." & SQL_FIELD_MACRO_TITLE & ",''))>0,cfg." & SQL_FIELD_MACRO_TITLE & ",Nz(cfg." & SQL_FIELD_MACRO_KEY & ",'')) AS " & FIELD_DISPLAY_TITLE & ", "
    sqlText = sqlText & "Nz(cfg.[" & FIELD_CONFIG_OWNER_DATABASE_ROLE & "],'') & IIf(Len(Nz(cfg." & SQL_FIELD_TARGET_PROCEDURE_NAME & ",''))>0,': ' & cfg." & SQL_FIELD_TARGET_PROCEDURE_NAME & ",IIf(Len(Nz(cfg." & SQL_FIELD_TARGET_OBJECT_NAME & ",''))>0,': ' & cfg." & SQL_FIELD_TARGET_OBJECT_NAME & ",'')) AS " & FIELD_TARGET_SUMMARY & " "
    sqlText = sqlText & "FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Config") & "] AS cfg WHERE (" & manualStatusProblem & " Or " & configurationStatusProblem & " Or " & validationProblem & " Or " & generationProblem & ") "
    sqlText = sqlText & "ORDER BY " & reviewSortExpression & ", Nz(cfg." & SQL_FIELD_REVIEW_PRIORITY & ",0) DESC, cfg." & SQL_FIELD_MACRO_TITLE & ", cfg." & SQL_FIELD_ID & ";"
    ManualReviewFormSql = sqlText
End Function

Private Sub RepairManagedObjectDependencyDocumentationStatusForSetup(ByVal db As DAO.Database)
    'DocumentationStatus is derived from the authoritative dependency relationship description; keep the persisted status synchronized before Phase-B validation/fingerprinting.
    Dim tableName As String
    Dim expectedExpression As String
    Dim sqlText As String
    tableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies")
    If SharedDao_DatabaseTableExistsSafe(db, tableName) = False Then Exit Sub
    expectedExpression = "IIf(Len(Trim(Nz([" & FIELD_MANAGED_OBJECT_DEPENDENCY_DETAIL_DESCRIPTION & "],'')))=0," & SharedDao_SqlQuote(DOCUMENTATION_STATUS_MISSING_DESCRIPTION) & "," & SharedDao_SqlQuote(DOCUMENTATION_STATUS_COMPLETE) & ")"
    sqlText = "UPDATE [" & tableName & "] SET [" & FIELD_MANAGED_OBJECT_DEPENDENCY_DOCUMENTATION_STATUS & "]=" & expectedExpression & " WHERE Nz([" & FIELD_MANAGED_OBJECT_DEPENDENCY_DOCUMENTATION_STATUS & "],'')<>" & expectedExpression & ";"
    db.Execute sqlText, dbFailOnError
    If db.RecordsAffected > 0 Then CatalogMarkSetupDomainsDirty CATALOG_DIRTY_DEPENDENCIES
End Sub

Private Sub ValidateNonFormDependencies(ByVal db As DAO.Database)
    On Error GoTo ErrHandler
    Dim rs As DAO.Recordset
    Dim seenContent As Object
    Dim seenIdentity As Object
    Dim contentSignatureText As String
    Dim identitySignatureText As String
    Dim dependencyType As String
    Dim dependencyName As String
    Dim dependsOnID As Long
    Dim expectedDocumentationStatus As String
    ' INTENTIONAL KEYED LOOKUP: seenContent, seenIdentity provides keyed membership/lookup over source rows or state already read by ValidateNonFormDependencies; it is a derived access path, not a second authority.
    Set seenContent = CreateObject("Scripting.Dictionary")
    seenContent.CompareMode = vbBinaryCompare
    Set seenIdentity = CreateObject("Scripting.Dictionary")
    seenIdentity.CompareMode = vbBinaryCompare
    Set rs = db.OpenRecordset("SELECT d.* FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies") & "] AS d INNER JOIN [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] AS m ON d.[" & FIELD_MANAGED_OBJECT_ID & "]=m." & SQL_FIELD_ID & " WHERE Nz(m.[" & FIELD_MANAGED_OBJECT_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND UCase(Trim(Nz(m." & SQL_FIELD_OBJECT_TYPE & ",'')))<>'FORM' AND (Len(Trim(Nz(d.[" & FIELD_MANAGED_OBJECT_DEPENDENCY_STATUS & "],'')))=0 OR UCase(Trim(Nz(d.[" & FIELD_MANAGED_OBJECT_DEPENDENCY_STATUS & "],'')))=" & SharedDao_SqlQuote(UCase$(ADCAT_STATUS_ACTIVE)) & ") ORDER BY d." & SQL_FIELD_ID & ";", dbOpenSnapshot)
    Do While rs.EOF = False
        PumpSetupResponsiveness
        dependencyType = Trim$(CStr(Nz(rs.fields(FIELD_DEPENDENCY_TYPE).value, vbNullString)))
        dependencyName = Trim$(CStr(Nz(rs.fields(FIELD_DEPENDENCY_NAME).value, vbNullString)))
        dependsOnID = CLng(Nz(rs.fields(FIELD_DEPENDS_ON_MANAGED_OBJECT_ID).value, 0))
        expectedDocumentationStatus = IIf(Len(Trim$(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_DETAIL_DESCRIPTION).value, vbNullString)))) = 0, DOCUMENTATION_STATUS_MISSING_DESCRIPTION, DOCUMENTATION_STATUS_COMPLETE)
        If StrComp(Trim$(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_DOCUMENTATION_STATUS).value, vbNullString))), expectedDocumentationStatus, vbTextCompare) <> 0 Then Err.Raise vbObjectError + 9561, "ValidateNonFormDependencies", "A managed-object dependency DocumentationStatus does not match its DependencyDescription." & vbCrLf & "Dependency ID: " & CStr(CLng(rs.fields(FIELD_ID).value)) & vbCrLf & "Expected DocumentationStatus: " & expectedDocumentationStatus
        If Len(dependencyType) = 0 Then Err.Raise vbObjectError + 9562, "ValidateNonFormDependencies", "An active non-form dependency row has a blank DependencyType." & vbCrLf & "Dependency ID: " & CStr(CLng(rs.fields(FIELD_ID).value))
        If dependsOnID <= 0 And Len(dependencyName) = 0 Then Err.Raise vbObjectError + 9563, "ValidateNonFormDependencies", "An active non-form dependency row identifies neither a managed-object ID nor a dependency name." & vbCrLf & "Dependency ID: " & CStr(CLng(rs.fields(FIELD_ID).value))
        identitySignatureText = ManagedObjectDependencyIdentitySignature(rs)
        contentSignatureText = ManagedObjectDependencyContentSignature(rs)
        If seenContent.Exists(contentSignatureText) Then Err.Raise vbObjectError + 9564, "ValidateNonFormDependencies", "An exact duplicate active non-form dependency remains after Phase B reconciliation." & vbCrLf & "Dependency ID: " & CStr(CLng(rs.fields(FIELD_ID).value)) & vbCrLf & "Matching dependency ID: " & CStr(CLng(seenContent(contentSignatureText)))
        If seenIdentity.Exists(identitySignatureText) Then Err.Raise vbObjectError + 9570, "ValidateNonFormDependencies", "Conflicting active non-form dependency definitions share the same dependency identity." & vbCrLf & "Dependency ID: " & CStr(CLng(rs.fields(FIELD_ID).value)) & vbCrLf & "Conflicting dependency ID: " & CStr(CLng(seenIdentity(identitySignatureText)))
        seenContent.Add contentSignatureText, CLng(rs.fields(FIELD_ID).value)
        seenIdentity.Add identitySignatureText, CLng(rs.fields(FIELD_ID).value)
        rs.MoveNext
    Loop
    rs.Close
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    Err.Raise savedErrNumber, "ValidateNonFormDependencies", savedErrDescription
End Sub

Private Function CanonicalGeneratedManagedFormNames() As Collection
    'Returns managed-generated catalog membership; physical builder inventories remain separate.
    ' CANONICAL UNIQUENESS: ManagedGeneratedFormNames comes from the canonical managed-object registry, which rejects duplicate managed Form identity. Do not add downstream deduplication here; fix invalid duplicate
    ' definitions at that authority.
    Set CanonicalGeneratedManagedFormNames = SortedTextCollection(ManagedGeneratedFormNames())
End Function

Private Function CanonicalPersistentGeneratedManagedFormNames() As Collection
    'Persistent-generated form authority is the canonical managed-object registry; these names are intentionally excluded from ordinary generated-form rebuild/delete rosters.
    Set CanonicalPersistentGeneratedManagedFormNames = SortedTextCollection(ManagedPersistentGeneratedFormNames())
End Function

Private Function AuthoritativeManagedFormNames(ByVal canonicalGeneratedNames As Collection, ByVal discoveredUserFormNames As Collection) As Collection
    'Combines ordinary generated, persistent generated, and dynamically discovered ADC-prefixed user forms into one sorted unique collection.
    Dim names As New Collection
    Dim item As Variant
    For Each item In canonicalGeneratedNames
        AddUniqueText names, CStr(item)
    Next item
    For Each item In CanonicalPersistentGeneratedManagedFormNames()
        AddUniqueText names, CStr(item)
    Next item
    For Each item In discoveredUserFormNames
        AddUniqueExactText names, CStr(item)
    Next item
    Set AuthoritativeManagedFormNames = SortedTextCollection(names)
End Function

Private Function ManagedFormAuditCount(ByVal db As DAO.Database, ByVal sqlText As String) As Long
    Dim rs As DAO.Recordset
    Set rs = db.OpenRecordset(sqlText, dbOpenSnapshot)
    If rs.EOF = False Then ManagedFormAuditCount = CLng(Nz(rs.fields(0).value, 0))
    rs.Close
End Function

Private Function ManagedFormPlacementOwnedStateToken(ByVal db As DAO.Database, ByRef failureDetail As String) As String
    On Error GoTo ErrHandler
    Dim rs As DAO.Recordset
    Dim fld As DAO.Field
    Dim state As CatalogHashState
    Dim rowCount As Long
    Dim sqlText As String
    failureDetail = vbNullString
    CatalogHashInitialize state
    CatalogHashAppendText state, FingerprintTokenPart(MANAGED_FORM_RECONCILIATION_TOKEN_VERSION & "|D4FormUiMetadata")
    sqlText = "SELECT * FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] WHERE Nz([" & FIELD_MANAGED_OBJECT_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))='FORM' ORDER BY " & SQL_FIELD_OBJECT_NAME & "," & SQL_FIELD_ID & ";"
    Set rs = db.OpenRecordset(sqlText, dbOpenSnapshot)
    Do While rs.EOF = False
        PumpSetupResponsiveness
        CatalogHashAppendText state, FingerprintTokenPart(CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString)))
        For Each fld In rs.fields
            If CatalogFastPathUiField(fld.Name) Then
                If StrComp(fld.Name, FIELD_OBJECT_DESCRIPTION, vbTextCompare) <> 0 Then
                    CatalogHashAppendText state, FingerprintTokenPart(fld.Name)
                    CatalogHashAppendText state, FingerprintTokenPart(CStr(Nz(fld.value, vbNullString)))
                End If
            End If
        Next fld
        rowCount = rowCount + 1
        rs.MoveNext
    Loop
    rs.Close
    CatalogHashAppendText state, FingerprintTokenPart("Rows=" & CStr(rowCount))
    ManagedFormPlacementOwnedStateToken = CatalogHashToken(state)
    Exit Function
ErrHandler:
    failureDetail = "Could not calculate the D4-owned managed-form UI-metadata token. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
End Function

Private Function ManagedFormCatalogOwnedStateToken(ByVal db As DAO.Database, ByRef failureDetail As String) As String
    On Error GoTo ErrHandler
    Dim allInventoryState As CatalogHashState
    Dim coreInventoryState As CatalogHashState
    Dim formsInventoryState As CatalogHashState
    Dim uiInventoryState As CatalogHashState
    Dim macroInventoryState As CatalogHashState
    Dim allPayloadState As CatalogHashState
    Dim corePayloadState As CatalogHashState
    Dim formsPayloadState As CatalogHashState
    Dim uiPayloadState As CatalogHashState
    Dim macroPayloadState As CatalogHashState
    Dim formDefinitionsState As CatalogHashState
    Dim combinedState As CatalogHashState
    Dim placementToken As String
    failureDetail = vbNullString
    CatalogHashInitialize allInventoryState: CatalogHashAppendText allInventoryState, FingerprintTokenPart(CatalogDomainSeed("Inventory"))
    CatalogHashInitialize coreInventoryState: CatalogHashAppendText coreInventoryState, FingerprintTokenPart(CatalogDomainSeed("InventoryCore"))
    CatalogHashInitialize formsInventoryState: CatalogHashAppendText formsInventoryState, FingerprintTokenPart(CatalogDomainSeed("InventoryForms"))
    CatalogHashInitialize uiInventoryState: CatalogHashAppendText uiInventoryState, FingerprintTokenPart(CatalogDomainSeed("InventoryUI"))
    CatalogHashInitialize macroInventoryState: CatalogHashAppendText macroInventoryState, FingerprintTokenPart(CatalogDomainSeed("InventoryMacros"))
    CatalogHashAppendManagedObjectInventory db, allInventoryState, coreInventoryState, formsInventoryState, uiInventoryState, macroInventoryState, failureDetail
    If Len(failureDetail) > 0 Then Exit Function
    CatalogHashInitialize allPayloadState: CatalogHashAppendText allPayloadState, FingerprintTokenPart(CatalogDomainSeed("Payloads"))
    CatalogHashInitialize corePayloadState: CatalogHashAppendText corePayloadState, FingerprintTokenPart(CatalogDomainSeed("PayloadsCore"))
    CatalogHashInitialize formsPayloadState: CatalogHashAppendText formsPayloadState, FingerprintTokenPart(CatalogDomainSeed("PayloadsForms"))
    CatalogHashInitialize uiPayloadState: CatalogHashAppendText uiPayloadState, FingerprintTokenPart(CatalogDomainSeed("PayloadsUI"))
    CatalogHashInitialize macroPayloadState: CatalogHashAppendText macroPayloadState, FingerprintTokenPart(CatalogDomainSeed("PayloadsMacros"))
    CatalogHashAppendManagedPayloads db, allPayloadState, corePayloadState, formsPayloadState, uiPayloadState, macroPayloadState, failureDetail
    If Len(failureDetail) > 0 Then Exit Function
    CatalogHashInitialize formDefinitionsState: CatalogHashAppendText formDefinitionsState, FingerprintTokenPart(CatalogDomainSeed("Forms"))
    CatalogHashAppendTableData db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_FormDefinitions"), "Forms", formDefinitionsState, failureDetail
    If Len(failureDetail) > 0 Then Exit Function
    placementToken = ManagedFormPlacementOwnedStateToken(db, failureDetail)
    If Len(placementToken) = 0 Then Exit Function
    CatalogHashInitialize combinedState
    CatalogHashAppendText combinedState, FingerprintTokenPart(MANAGED_FORM_RECONCILIATION_TOKEN_VERSION & "|D4CatalogOwnedState")
    CatalogHashAppendText combinedState, FingerprintTokenPart(CatalogHashToken(formsInventoryState))
    CatalogHashAppendText combinedState, FingerprintTokenPart(CatalogHashToken(formsPayloadState))
    CatalogHashAppendText combinedState, FingerprintTokenPart(CatalogHashToken(formDefinitionsState))
    CatalogHashAppendText combinedState, FingerprintTokenPart(placementToken)
    ManagedFormCatalogOwnedStateToken = CatalogHashToken(combinedState)
    Exit Function
ErrHandler:
    failureDetail = "Could not calculate the D4-owned managed-form catalog state token. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
End Function

Private Function ManagedFormReconciliationStateToken(ByVal db As DAO.Database, ByRef failureDetail As String, Optional ByVal suppliedCanonicalGeneratedNames As Variant, Optional ByVal suppliedDiscoveredUserFormNames As Variant, Optional ByVal suppliedAuthoritativeNames As Variant, Optional ByVal suppliedPhysicalInventory As Variant) As String
    On Error GoTo ErrHandler
    Dim state As CatalogHashState
    Dim canonicalGeneratedNames As Collection
    Dim canonicalPersistentGeneratedNames As Collection
    Dim discoveredUserFormNames As Collection
    Dim authoritativeNames As Collection
    Dim item As Variant
    Dim d4CatalogToken As String
    Dim formName As String
    Dim formCount As Long
    Dim includePhysicalForm As Boolean
    Dim physicalInventory As Collection
    Dim physicalRow As Variant
    failureDetail = vbNullString
    d4CatalogToken = ManagedFormCatalogOwnedStateToken(db, failureDetail)
    If Len(d4CatalogToken) = 0 Then
        If Len(failureDetail) = 0 Then failureDetail = "The D4-owned managed-form catalog state token is unavailable."
        Exit Function
    End If
    If isMissing(suppliedCanonicalGeneratedNames) = False Then
        If IsObject(suppliedCanonicalGeneratedNames) Then Set canonicalGeneratedNames = suppliedCanonicalGeneratedNames
    End If
    If canonicalGeneratedNames Is Nothing Then Set canonicalGeneratedNames = CanonicalGeneratedManagedFormNames()
    If isMissing(suppliedPhysicalInventory) = False Then
        If IsObject(suppliedPhysicalInventory) Then Set physicalInventory = suppliedPhysicalInventory
    End If
    If physicalInventory Is Nothing Then Set physicalInventory = PhysicalManagedFormInventory(db, canonicalGeneratedNames)
    Set canonicalPersistentGeneratedNames = CanonicalPersistentGeneratedManagedFormNames()
    If isMissing(suppliedDiscoveredUserFormNames) = False Then
        If IsObject(suppliedDiscoveredUserFormNames) Then Set discoveredUserFormNames = suppliedDiscoveredUserFormNames
    End If
    If discoveredUserFormNames Is Nothing Then Set discoveredUserFormNames = DiscoveredUserFormNamesFromInventory(physicalInventory)
    If isMissing(suppliedAuthoritativeNames) = False Then
        If IsObject(suppliedAuthoritativeNames) Then Set authoritativeNames = suppliedAuthoritativeNames
    End If
    If authoritativeNames Is Nothing Then Set authoritativeNames = AuthoritativeManagedFormNames(canonicalGeneratedNames, discoveredUserFormNames)
    CatalogHashInitialize state
    CatalogHashAppendText state, FingerprintTokenPart(MANAGED_FORM_RECONCILIATION_TOKEN_VERSION)
    CatalogHashAppendText state, FingerprintTokenPart(d4CatalogToken)
    CatalogHashAppendText state, FingerprintTokenPart("GeneratedAuthority")
    For Each item In canonicalGeneratedNames
        PumpSetupResponsiveness
        CatalogHashAppendText state, FingerprintTokenPart(CStr(item))
    Next item
    CatalogHashAppendText state, FingerprintTokenPart("GeneratedAuthorityCount=" & CStr(canonicalGeneratedNames.count))
    CatalogHashAppendText state, FingerprintTokenPart("PersistentGeneratedAuthority")
    For Each item In canonicalPersistentGeneratedNames
        PumpSetupResponsiveness
        CatalogHashAppendText state, FingerprintTokenPart(CStr(item))
    Next item
    CatalogHashAppendText state, FingerprintTokenPart("PersistentGeneratedAuthorityCount=" & CStr(canonicalPersistentGeneratedNames.count))
    CatalogHashAppendText state, FingerprintTokenPart("UserAuthority")
    For Each item In discoveredUserFormNames
        PumpSetupResponsiveness
        CatalogHashAppendText state, FingerprintTokenPart(CStr(item))
    Next item
    CatalogHashAppendText state, FingerprintTokenPart("UserAuthorityCount=" & CStr(discoveredUserFormNames.count))
    For Each physicalRow In physicalInventory
        PumpSetupResponsiveness
        formName = CStr(physicalRow(PHYSICAL_FORM_INV_NAME))
        includePhysicalForm = ExactTextCollectionContains(authoritativeNames, formName)
        If includePhysicalForm Then
            CatalogHashAppendText state, FingerprintTokenPart(formName)
            CatalogHashAppendText state, FingerprintTokenPart(Format$(CDbl(CDate(physicalRow(PHYSICAL_FORM_INV_DATE_CREATE))), "0.000000000000000"))
            CatalogHashAppendText state, FingerprintTokenPart(CStr(CLng(physicalRow(PHYSICAL_FORM_INV_FLAGS))))
            formCount = formCount + 1
        End If
    Next physicalRow
    CatalogHashAppendText state, FingerprintTokenPart("FormCount=" & CStr(formCount))
    ManagedFormReconciliationStateToken = CatalogHashToken(state)
    Exit Function
ErrHandler:
    failureDetail = "Could not calculate the exact managed-form reconciliation state token. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
End Function

Private Function OriginalManagedFormRowExisted(ByVal allAffectedRows As Collection, ByVal formName As String) As Boolean
    Dim rowData As Variant
    For Each rowData In allAffectedRows
        PumpSetupResponsiveness
        If StrComp(CStr(rowData(1)), formName, vbTextCompare) = 0 And StrComp(CStr(rowData(2)), ADCAT_OBJECT_TYPE_FORM, vbTextCompare) = 0 Then
            OriginalManagedFormRowExisted = True
            Exit Function
        End If
    Next rowData
End Function

' Purpose: Attempts to get physical managed form inventory for setup; expected negative outcomes are returned through the function result and/or ByRef outputs rather than changing this routine's public
'   contract.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   inventoryRows (Output; Collection): Receives the Catalog-owned physical managed-form inventory for the active trace run; it is set to Nothing when no valid inventory can be returned.
' Returns: Boolean: True when the attempted operation completes and its required outputs/state are valid; False when the routine follows its normal non-success path. VBA errors may still be raised where
'   the existing code treats a condition as exceptional.
Public Function TryGetPhysicalManagedFormInventoryForSetup(ByRef inventoryRows As Collection) As Boolean
    'Setup-trace consumer for the single Catalog-owned physical CodeDb form snapshot. A trace-run key, not the B-phase Catalog context, owns lifetime because Forms work begins after B5 closes that context.
    Set inventoryRows = Nothing
    If TraceRunActive() = False Then Exit Function
    Set inventoryRows = PhysicalManagedFormInventory(ResolveCatalogDb(), CanonicalGeneratedManagedFormNames())
    TryGetPhysicalManagedFormInventoryForSetup = True
End Function

' Purpose: Performs invalidate physical managed form inventory for setup by coordinating `End` while preserving this module's existing validation and error semantics.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
' Returns: None (Sub). The procedure communicates its result through its database, UI, trace, or module-state side effects and raises errors where its implementation requires it.
Public Sub InvalidatePhysicalManagedFormInventoryForSetup()
    'Invalidates the one Setup-lifetime physical-form snapshot only at an authoritative physical-form mutation boundary. The next Setup consumer rebuilds it once and later consumers reuse that refreshed snapshot.
    Set mPhysicalFormInventoryRows = Nothing
    mPhysicalFormInventoryTraceRunID = vbNullString
    mPhysicalFormInventoryReuseCount = 0
End Sub

Private Function PhysicalManagedFormInventory(ByVal db As DAO.Database, ByVal canonicalGeneratedNames As Collection) As Collection
    'Single physical CodeDb form snapshot for the current Setup trace run. Classification is generated authority first, then persistent generated, then exact ADC-prefix Discovered User.
    On Error GoTo ErrHandler
    Dim rs As DAO.Recordset
    Dim rows As New Collection
    Dim persistentNames As Collection
    Dim formName As String
    Dim classification As String
    Dim managedIdentity As String
    Dim currentTraceRunID As String
    Dim operationTimer As Single
    currentTraceRunID = CatalogSetupTraceIdentity()
    If StrComp(currentTraceRunID, "NoActiveTrace", vbBinaryCompare) <> 0 Then
        If StrComp(mPhysicalFormInventoryTraceRunID, currentTraceRunID, vbBinaryCompare) = 0 Then
            If Not mPhysicalFormInventoryRows Is Nothing Then
                mPhysicalFormInventoryReuseCount = mPhysicalFormInventoryReuseCount + 1
                LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "PhysicalManagedFormInventory", "Physical CodeDb form inventory reused.", "Rows: " & CStr(mPhysicalFormInventoryRows.count) & vbCrLf & "Reuse count: " & CStr(mPhysicalFormInventoryReuseCount), "Setup-trace physical form inventory", 0, vbNullString, vbNullString, MSYS_OBJECTS_TABLE, "FormInventory", "CodeDb", "Performance"
                Set PhysicalManagedFormInventory = mPhysicalFormInventoryRows
                Exit Function
            End If
        End If
    End If
    Set persistentNames = CanonicalPersistentGeneratedManagedFormNames()
    operationTimer = Timer
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "PhysicalManagedFormInventory", "Physical CodeDb form inventory starting.", "Enumeration source: " & MSYS_OBJECTS_TABLE & vbCrLf & "PhysicalOwnerDatabaseRole: CodeDb", "D4 physical form inventory", 0, vbNullString, vbNullString, MSYS_OBJECTS_TABLE, "FormInventory", "CodeDb", "Performance"
    Set rs = db.OpenRecordset("SELECT [Name],[DateCreate],[DateUpdate],[Flags] FROM [" & MSYS_OBJECTS_TABLE & "] WHERE [Type]=" & CStr(MSYS_OBJECT_TYPE_FORM) & " ORDER BY [Name];", dbOpenSnapshot)
    Do While rs.EOF = False
        PumpSetupResponsiveness
        formName = CStr(Nz(rs.fields("Name").value, vbNullString))
        classification = vbNullString
        managedIdentity = vbNullString
        If TextCollectionContains(canonicalGeneratedNames, formName) Then
            classification = DEFAULT_CATALOG_OWNER_GENERATED
            managedIdentity = ManagedObjectCanonicalLogicalIdentity(formName, ADCAT_OBJECT_TYPE_FORM)
        ElseIf TextCollectionContains(persistentNames, formName) Then
            classification = DEFAULT_CATALOG_OWNER_PERSISTENT_GENERATED
            managedIdentity = PersistentGeneratedFormLogicalIdentity(formName)
        ElseIf PhysicalFormIsDiscoveryCandidate(formName) Then
            classification = DEFAULT_CATALOG_OWNER_USER
            managedIdentity = DiscoveredUserFormManagedIdentity(formName)
        End If
        rows.Add Array(formName, CONFIG_OWNER_DATABASE_ROLE_CODE_DB, ADCAT_OBJECT_TYPE_FORM, classification, managedIdentity, rs.fields(FIELD_DATE_CREATE).value, rs.fields(FIELD_DATE_UPDATE).value, CLng(Nz(rs.fields(FIELD_FLAGS).value, 0)))
        RequireSafeWorkContinue "PhysicalManagedFormInventory", "Form [" & IIf(Len(formName) = 0, "(blank)", formName) & "]"
        rs.MoveNext
    Loop
    rs.Close
    Set rs = Nothing
    If StrComp(currentTraceRunID, "NoActiveTrace", vbBinaryCompare) <> 0 Then
        Set mPhysicalFormInventoryRows = rows
        mPhysicalFormInventoryTraceRunID = currentTraceRunID
        mPhysicalFormInventoryReuseCount = 0
    End If
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "PhysicalManagedFormInventory", "Physical CodeDb form inventory completed.", "Physical form rows: " & CStr(rows.count) & vbCrLf & "Setup-trace cache stored: " & CStr(StrComp(currentTraceRunID, "NoActiveTrace", vbBinaryCompare) <> 0) & vbCrLf & "Elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer)), "Setup-trace physical form inventory", 0, vbNullString, vbNullString, MSYS_OBJECTS_TABLE, "FormInventory", "CodeDb", "Performance"
    Set PhysicalManagedFormInventory = rows
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    Err.Raise savedErrNumber, "PhysicalManagedFormInventory", "Could not enumerate the authoritative physical CodeDb form inventory from " & MSYS_OBJECTS_TABLE & "." & vbCrLf & "Last form: " & formName & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Function

Private Function DiscoveredUserFormNamesFromInventory(ByVal inventoryRows As Collection) As Collection
    'Derived filtered partition of the one authoritative physical-form snapshot: exact "ADC " prefix and not owned by ordinary/persistent generated authority.
    Dim rowData As Variant
    Dim names As New Collection
    Dim formName As String
    Dim classification As String
    Dim prefixCandidateCount As Long
    Dim canonicalOwnedExcludedCount As Long
    If inventoryRows Is Nothing Then Err.Raise vbObjectError + 9818, "DiscoveredUserFormNamesFromInventory", "The authoritative physical-form inventory is missing."
    For Each rowData In inventoryRows
        PumpSetupResponsiveness
        formName = CStr(rowData(PHYSICAL_FORM_INV_NAME))
        classification = CStr(rowData(PHYSICAL_FORM_INV_CLASSIFICATION))
        If PhysicalFormIsDiscoveryCandidate(formName) Then
            prefixCandidateCount = prefixCandidateCount + 1
            If StrComp(classification, DEFAULT_CATALOG_OWNER_USER, vbTextCompare) = 0 Then
                AddUniqueExactText names, formName
            ElseIf StrComp(classification, DEFAULT_CATALOG_OWNER_GENERATED, vbTextCompare) = 0 Or StrComp(classification, DEFAULT_CATALOG_OWNER_PERSISTENT_GENERATED, vbTextCompare) = 0 Then
                canonicalOwnedExcludedCount = canonicalOwnedExcludedCount + 1
            End If
        End If
    Next rowData
    Set names = SortedTextCollection(names)
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "DiscoveredUserFormNamesFromInventory", "Discovered User form partition derived from the authoritative physical snapshot.", "Physical form rows: " & CStr(inventoryRows.count) & vbCrLf & "Exact ADC-prefix candidates: " & CStr(prefixCandidateCount) & vbCrLf & "Canonical generated/persistent-generated excluded: " & CStr(canonicalOwnedExcludedCount) & vbCrLf & "Discovered User forms returned: " & CStr(names.count), "D4 physical form inventory", 0, vbNullString, vbNullString, MSYS_OBJECTS_TABLE, "FormInventory", "CodeDb", "Performance"
    Set DiscoveredUserFormNamesFromInventory = names
End Function

Private Function PhysicalManagedFormNames(ByVal db As DAO.Database, ByVal canonicalGeneratedNames As Collection) As Collection
    'Convenience consumer of the authoritative physical-form inventory; membership authority remains PhysicalManagedFormInventory plus PhysicalFormIsDiscoveryCandidate.
    Dim inventoryRows As Collection
    Set inventoryRows = PhysicalManagedFormInventory(db, canonicalGeneratedNames)
    Set PhysicalManagedFormNames = DiscoveredUserFormNamesFromInventory(inventoryRows)
End Function

Private Sub SelectPreferredManagedFormRow(ByVal candidateRowID As Long, ByVal candidateOwnerRank As Long, ByRef selectedRowID As Long, ByRef selectedOwnerRank As Long)
    'Selects the strongest owner first and the lowest ID only when ownership ranks match.
    If selectedRowID = 0 Or candidateOwnerRank > selectedOwnerRank Or (candidateOwnerRank = selectedOwnerRank And candidateRowID < selectedRowID) Then
        selectedRowID = candidateRowID
        selectedOwnerRank = candidateOwnerRank
    End If
End Sub

Private Sub ManagedFormVerificationCountAdd(ByVal countIndex As Object, ByVal keyText As String)
    If countIndex.Exists(keyText) Then
        countIndex(keyText) = CLng(countIndex(keyText)) + 1
    Else
        countIndex.Add keyText, CLng(1)
    End If
End Sub

Private Function ManagedFormVerificationCount(ByVal countIndex As Object, ByVal keyText As String) As Long
    If countIndex.Exists(keyText) Then ManagedFormVerificationCount = CLng(countIndex(keyText))
End Function

Private Function ManagedFormVerificationOwnerKey(ByVal formName As String, ByVal ownerCode As String) As String
    ManagedFormVerificationOwnerKey = UCase$(formName) & Chr$(30) & UCase$(ownerCode)
End Function

Private Function ManagedFormVerificationIdentityKey(ByVal formName As String, ByVal ownerCode As String, ByVal managedIdentity As String) As String
    ManagedFormVerificationIdentityKey = ManagedFormVerificationOwnerKey(formName, ownerCode) & Chr$(30) & managedIdentity
End Function

Private Function ManagedFormVerificationRegistryKey(ByVal formName As String, ByVal ownerCode As String, ByVal generatedFlag As Boolean) As String
    ManagedFormVerificationRegistryKey = UCase$(formName) & Chr$(30) & UCase$(ownerCode) & Chr$(30) & CStr(generatedFlag)
End Function

Private Function ManagedFormVerificationRegistryRoleKey(ByVal formName As String, ByVal ownerCode As String, ByVal generatedFlag As Boolean, ByVal physicalOwnerRole As String) As String
    ManagedFormVerificationRegistryRoleKey = ManagedFormVerificationRegistryKey(formName, ownerCode, generatedFlag) & Chr$(30) & UCase$(physicalOwnerRole)
End Function

Private Sub VerifyAuthoritativeManagedForms(ByVal db As DAO.Database, ByVal canonicalGeneratedNames As Collection, ByVal authoritativeNames As Collection)
    'Verifies exactly-one membership and the three mutually exclusive ownership classes: Generated, PersistentGenerated, Discovered User.
    Dim rs As DAO.Recordset
    Dim item As Variant
    Dim formName As String
    Dim actualCount As Long
    Dim expectedOwner As String
    Dim expectedGeneratedFlag As Boolean
    Dim expectedManagedIdentity As String
    Dim expectedPhysicalOwnerRole As String
    Dim persistentNames As Collection
    Dim macTotalCounts As Object
    Dim macOwnerCounts As Object
    Dim macIdentityCounts As Object
    Dim registryCounts As Object
    Dim registryRoleCounts As Object
    Dim macFormNames As Collection
    Dim actualOwner As String
    Dim actualIdentity As String
    Dim actualGenerated As Boolean
    Dim actualPhysicalOwnerRole As String
    Set persistentNames = CanonicalPersistentGeneratedManagedFormNames()
    ' INTENTIONAL KEYED LOOKUPS: these procedure-local indexes are fresh projections of the two authoritative successor-proof tables.
    Set macTotalCounts = CreateObject("Scripting.Dictionary")
    macTotalCounts.CompareMode = vbTextCompare
    Set macOwnerCounts = CreateObject("Scripting.Dictionary")
    macOwnerCounts.CompareMode = vbTextCompare
    Set macIdentityCounts = CreateObject("Scripting.Dictionary")
    macIdentityCounts.CompareMode = vbTextCompare
    Set registryCounts = CreateObject("Scripting.Dictionary")
    registryCounts.CompareMode = vbTextCompare
    Set registryRoleCounts = CreateObject("Scripting.Dictionary")
    registryRoleCounts.CompareMode = vbTextCompare
    Set macFormNames = New Collection
    Set rs = db.OpenRecordset("SELECT " & SQL_FIELD_OBJECT_NAME & ",[" & FIELD_CATALOG_OWNER & "],[" & FIELD_LOGICAL_OBJECT_NAME & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] WHERE UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))='FORM';", dbOpenSnapshot)
    Do While rs.EOF = False
        formName = CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString))
        actualOwner = CStr(Nz(rs.fields(FIELD_CATALOG_OWNER).value, vbNullString))
        actualIdentity = CStr(Nz(rs.fields(FIELD_LOGICAL_OBJECT_NAME).value, vbNullString))
        ManagedFormVerificationCountAdd macTotalCounts, formName
        ManagedFormVerificationCountAdd macOwnerCounts, ManagedFormVerificationOwnerKey(formName, actualOwner)
        ManagedFormVerificationCountAdd macIdentityCounts, ManagedFormVerificationIdentityKey(formName, actualOwner, actualIdentity)
        macFormNames.Add formName
        rs.MoveNext
    Loop
    rs.Close
    Set rs = Nothing
    Set rs = db.OpenRecordset("SELECT " & SQL_FIELD_FORM_OBJECT_NAME & ",[" & FIELD_CATALOG_OWNER & "]," & SQL_FIELD_IS_GENERATED_BY_UTILITY & ",[" & FIELD_CONFIG_OWNER_DATABASE_ROLE & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_FormDefinitions") & "];", dbOpenSnapshot)
    Do While rs.EOF = False
        formName = CStr(Nz(rs.fields(FIELD_FORM_OBJECT_NAME).value, vbNullString))
        actualOwner = CStr(Nz(rs.fields(FIELD_CATALOG_OWNER).value, vbNullString))
        actualGenerated = CBool(Nz(rs.fields(FIELD_IS_GENERATED_BY_UTILITY).value, False))
        actualPhysicalOwnerRole = CStr(Nz(rs.fields(FIELD_CONFIG_OWNER_DATABASE_ROLE).value, vbNullString))
        ManagedFormVerificationCountAdd registryCounts, ManagedFormVerificationRegistryKey(formName, actualOwner, actualGenerated)
        ManagedFormVerificationCountAdd registryRoleCounts, ManagedFormVerificationRegistryRoleKey(formName, actualOwner, actualGenerated, actualPhysicalOwnerRole)
        rs.MoveNext
    Loop
    rs.Close
    Set rs = Nothing
    For Each item In authoritativeNames
        PumpSetupResponsiveness
        formName = CStr(item)
        actualCount = ManagedFormVerificationCount(macTotalCounts, formName)
        If actualCount <> 1 Then Err.Raise vbObjectError + 9039, "VerifyAuthoritativeManagedForms", "An authoritative managed form does not have exactly one MAC row." & vbCrLf & "Form: " & formName & vbCrLf & "Rows: " & CStr(actualCount)
        expectedManagedIdentity = vbNullString
        expectedPhysicalOwnerRole = vbNullString
        If TextCollectionContains(canonicalGeneratedNames, formName) Then
            expectedOwner = DEFAULT_CATALOG_OWNER_GENERATED
            expectedGeneratedFlag = True
        ElseIf TextCollectionContains(persistentNames, formName) Then
            expectedOwner = DEFAULT_CATALOG_OWNER_PERSISTENT_GENERATED
            expectedGeneratedFlag = True
            expectedManagedIdentity = PersistentGeneratedFormLogicalIdentity(formName)
            expectedPhysicalOwnerRole = CONFIG_OWNER_DATABASE_ROLE_CODE_DB
            If SharedDao_AccessObjectExists(db, acForm, formName) = False Then Err.Raise vbObjectError + 9043, "VerifyAuthoritativeManagedForms", "A required PersistentGenerated launcher form is physically missing from CodeDb." & vbCrLf & "Form: " & formName & vbCrLf & "PhysicalOwnerDatabaseRole: " & expectedPhysicalOwnerRole
        Else
            expectedOwner = DEFAULT_CATALOG_OWNER_USER
            expectedGeneratedFlag = False
            expectedManagedIdentity = DiscoveredUserFormManagedIdentity(formName)
            expectedPhysicalOwnerRole = CONFIG_OWNER_DATABASE_ROLE_CODE_DB
        End If
        If Len(expectedManagedIdentity) > 0 Then
            actualCount = ManagedFormVerificationCount(macIdentityCounts, ManagedFormVerificationIdentityKey(formName, expectedOwner, expectedManagedIdentity))
        Else
            actualCount = ManagedFormVerificationCount(macOwnerCounts, ManagedFormVerificationOwnerKey(formName, expectedOwner))
        End If
        If actualCount <> 1 Then Err.Raise vbObjectError + 9040, "VerifyAuthoritativeManagedForms", "An authoritative managed form has the wrong ownership classification or managed identity." & vbCrLf & "Form: " & formName & vbCrLf & "Expected CatalogOwner: " & expectedOwner & IIf(Len(expectedManagedIdentity) > 0, vbCrLf & "Expected managed identity: " & expectedManagedIdentity, vbNullString)
        If Len(expectedPhysicalOwnerRole) > 0 Then
            actualCount = ManagedFormVerificationCount(registryRoleCounts, ManagedFormVerificationRegistryRoleKey(formName, expectedOwner, expectedGeneratedFlag, expectedPhysicalOwnerRole))
        Else
            actualCount = ManagedFormVerificationCount(registryCounts, ManagedFormVerificationRegistryKey(formName, expectedOwner, expectedGeneratedFlag))
        End If
        If actualCount <> 1 Then Err.Raise vbObjectError + 9042, "VerifyAuthoritativeManagedForms", "An authoritative managed form does not have exactly one correctly classified UI_Frm_Registry row." & vbCrLf & "Form: " & formName & vbCrLf & "Expected CatalogOwner: " & expectedOwner & IIf(Len(expectedPhysicalOwnerRole) > 0, vbCrLf & "Expected physical owner database role: " & expectedPhysicalOwnerRole, vbNullString)
    Next item
    For Each item In macFormNames
        formName = CStr(item)
        If ExactTextCollectionContains(authoritativeNames, formName) = False Then Err.Raise vbObjectError + 9041, "VerifyAuthoritativeManagedForms", "A stale or disallowed managed Form row remains after reconciliation." & vbCrLf & "Form: " & formName
    Next item
    AddTraceNote "Managed-form successor verification reused one fresh MAC Form-row index and one fresh UI_Frm_Registry index instead of issuing three count queries per authoritative Form."
End Sub

Private Function DiscoveredUserFormManagedIdentity(ByVal formName As String) As String
    'Deterministic managed identity: PhysicalOwnerDatabaseRole + ObjectType + exact physical form name. No name normalization is permitted.
    DiscoveredUserFormManagedIdentity = CONFIG_OWNER_DATABASE_ROLE_CODE_DB & "|" & ADCAT_OBJECT_TYPE_FORM & "|" & formName
End Function

Private Sub ApplyDiscoveredUserFormManagedIdentity(ByVal formName As String)
    'Converges authoritative physical identity facts without overwriting user-maintained display/description metadata.
    'When the authoritative managed-definition batch is active, consume its already-open rows instead of re-querying Managed Objects and UI_Frm_Registry per Form.
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim identityText As String
    Dim rowChanged As Boolean
    Dim ownsManagedRecordset As Boolean
    Dim ownsFormRecordset As Boolean
    Dim managedBookmark As Variant
    Dim formBookmark As Variant
    Dim batchRowKey As String
    Dim candidateKey As Variant
    Dim exactKeyPrefix As String
    Dim formRowAvailable As Boolean
    identityText = DiscoveredUserFormManagedIdentity(formName)
    If mManagedDefinitionBatchActive Then
        If mManagedDefinitionBatchManagedRs Is Nothing Or mManagedDefinitionBatchManagedBookmarks Is Nothing Then Err.Raise vbObjectError + 9826, "ApplyDiscoveredUserFormManagedIdentity", "The reusable Managed Objects batch is unavailable while discovered User form identity is being reconciled." & vbCrLf & "Form: " & formName
        Set rs = mManagedDefinitionBatchManagedRs
        batchRowKey = ManagedDefinitionExactManagedBookmarkKey(formName, ADCAT_OBJECT_TYPE_FORM)
        If mManagedDefinitionBatchManagedBookmarks.Exists(batchRowKey) Then
            managedBookmark = mManagedDefinitionBatchManagedBookmarks(batchRowKey)
            rs.Bookmark = managedBookmark
        Else
            exactKeyPrefix = UCase$(ADCAT_OBJECT_TYPE_FORM) & Chr$(30)
            For Each candidateKey In mManagedDefinitionBatchManagedBookmarks.keys
                If Left$(CStr(candidateKey), Len(exactKeyPrefix)) = exactKeyPrefix Then
                    If StrComp(Mid$(CStr(candidateKey), Len(exactKeyPrefix) + 1), formName, vbTextCompare) = 0 Then
                        managedBookmark = mManagedDefinitionBatchManagedBookmarks(candidateKey)
                        rs.Bookmark = managedBookmark
                        Exit For
                    End If
                End If
            Next candidateKey
            If IsEmpty(managedBookmark) Then Err.Raise vbObjectError + 9827, "ApplyDiscoveredUserFormManagedIdentity", "The reusable Managed Objects batch does not contain the discovered User form row." & vbCrLf & "Form: " & formName
        End If
    Else
        Set db = ResolveCatalogDb()
        Set rs = db.OpenRecordset("SELECT " & SQL_FIELD_OBJECT_NAME & ",[" & FIELD_LOGICAL_OBJECT_NAME & "],[" & FIELD_OBJECT_NAMING_CATEGORY & "],[" & FIELD_CATALOG_OWNER & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] WHERE UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))='FORM' AND " & SQL_FIELD_OBJECT_NAME & "=" & SharedDao_SqlQuote(formName) & ";", dbOpenDynaset)
        ownsManagedRecordset = True
    End If
    If rs.EOF = False Then
        If StrComp(CStr(rs.fields(FIELD_OBJECT_NAME).value), formName, vbBinaryCompare) <> 0 Or StrComp(CStr(Nz(rs.fields(FIELD_LOGICAL_OBJECT_NAME).value, vbNullString)), identityText, vbBinaryCompare) <> 0 Or Len(CStr(Nz(rs.fields(FIELD_OBJECT_NAMING_CATEGORY).value, vbNullString))) > 0 Or StrComp(CStr(Nz(rs.fields(FIELD_CATALOG_OWNER).value, vbNullString)), DEFAULT_CATALOG_OWNER_USER, vbTextCompare) <> 0 Then
            rs.Edit
            rs.fields(FIELD_OBJECT_NAME).value = formName
            rs.fields(FIELD_LOGICAL_OBJECT_NAME).value = identityText
            rs.fields(FIELD_OBJECT_NAMING_CATEGORY).value = Null
            SetRecordsetFieldValueWithSource rs, FIELD_CATALOG_OWNER, DEFAULT_CATALOG_OWNER_USER, "DEFAULT_CATALOG_OWNER_USER"
            rs.Update
            If mManagedDefinitionBatchActive Then
                batchRowKey = ManagedDefinitionExactManagedBookmarkKey(formName, ADCAT_OBJECT_TYPE_FORM)
                If mManagedDefinitionBatchManagedBookmarks.Exists(batchRowKey) Then mManagedDefinitionBatchManagedBookmarks(batchRowKey) = rs.Bookmark Else mManagedDefinitionBatchManagedBookmarks.Add batchRowKey, rs.Bookmark
            End If
            rowChanged = True
        End If
    End If
    If ownsManagedRecordset Then rs.Close
    If mManagedDefinitionBatchActive Then
        If mManagedDefinitionBatchFormsRs Is Nothing Or mManagedDefinitionBatchFormBookmarks Is Nothing Then Err.Raise vbObjectError + 9828, "ApplyDiscoveredUserFormManagedIdentity", "The reusable UI_Frm_Registry batch is unavailable while discovered User form identity is being reconciled." & vbCrLf & "Form: " & formName
        Set rs = mManagedDefinitionBatchFormsRs
        If mManagedDefinitionBatchFormBookmarks.Exists(formName) Then
            formBookmark = mManagedDefinitionBatchFormBookmarks(formName)
            rs.Bookmark = formBookmark
            formRowAvailable = True
        Else
            For Each candidateKey In mManagedDefinitionBatchFormBookmarks.keys
                If StrComp(CStr(candidateKey), formName, vbTextCompare) = 0 Then
                    formBookmark = mManagedDefinitionBatchFormBookmarks(candidateKey)
                    rs.Bookmark = formBookmark
                    formRowAvailable = True
                    Exit For
                End If
            Next candidateKey
        End If
    Else
        Set rs = db.OpenRecordset("SELECT " & SQL_FIELD_FORM_OBJECT_NAME & "," & SQL_FIELD_MANAGED_OBJECT_FIELD_SOURCE_OBJECT_NAME & ",[" & FIELD_CONFIG_OWNER_DATABASE_ROLE & "],[" & FIELD_CATALOG_OWNER & "]," & SQL_FIELD_IS_GENERATED_BY_UTILITY & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_FormDefinitions") & "] WHERE " & SQL_FIELD_FORM_OBJECT_NAME & "=" & SharedDao_SqlQuote(formName) & ";", dbOpenDynaset)
        ownsFormRecordset = True
        formRowAvailable = (rs.EOF = False)
    End If
    If formRowAvailable Then
        If StrComp(CStr(rs.fields(FIELD_FORM_OBJECT_NAME).value), formName, vbBinaryCompare) <> 0 Or StrComp(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_FIELD_SOURCE_OBJECT_NAME).value, vbNullString)), formName, vbBinaryCompare) <> 0 Or StrComp(CStr(Nz(rs.fields(FIELD_CONFIG_OWNER_DATABASE_ROLE).value, vbNullString)), CONFIG_OWNER_DATABASE_ROLE_CODE_DB, vbTextCompare) <> 0 Or StrComp(CStr(Nz(rs.fields(FIELD_CATALOG_OWNER).value, vbNullString)), DEFAULT_CATALOG_OWNER_USER, vbTextCompare) <> 0 Or CBool(Nz(rs.fields(FIELD_IS_GENERATED_BY_UTILITY).value, False)) Then
            rs.Edit
            rs.fields(FIELD_FORM_OBJECT_NAME).value = formName
            rs.fields(FIELD_MANAGED_OBJECT_FIELD_SOURCE_OBJECT_NAME).value = formName
            rs.fields(FIELD_CONFIG_OWNER_DATABASE_ROLE).value = CONFIG_OWNER_DATABASE_ROLE_CODE_DB
            SetRecordsetFieldValueWithSource rs, FIELD_CATALOG_OWNER, DEFAULT_CATALOG_OWNER_USER, "DEFAULT_CATALOG_OWNER_USER"
            rs.fields(FIELD_IS_GENERATED_BY_UTILITY).value = False
            rs.Update
            If mManagedDefinitionBatchActive Then
                If mManagedDefinitionBatchFormBookmarks.Exists(formName) Then mManagedDefinitionBatchFormBookmarks(formName) = rs.Bookmark Else mManagedDefinitionBatchFormBookmarks.Add formName, rs.Bookmark
            End If
            rowChanged = True
        End If
    End If
    If ownsFormRecordset Then rs.Close
    If rowChanged Then MarkManagedDefinitionMutation CATALOG_DIRTY_FORMS Or CATALOG_DIRTY_INVENTORY
End Sub

Private Sub DefaultManagedUserForm(ByVal formName As String, ByVal descriptionText As String, ByVal SortOrder As Long, ByVal repairDefaultRows As Boolean)
    'Discovered User forms are physical exact-ADC-prefix forms outside generated authority. Identity is deterministic and separate from Ribbon identity.
    Dim ribbonGroupLabel As String
    Dim ribbonGroupSortOrder As Long
    Dim ribbonTitle As String
    ribbonGroupLabel = DEFAULT_USER_FORM_RIBBON_GROUP_FORMS
    ribbonGroupSortOrder = UserFormRibbonGroupSortOrder(ribbonGroupLabel)
    'Discovered User Ribbon titles are the exact physical object name with only the authoritative leading "ADC " discovery prefix removed; no other title normalization is allowed.
    ribbonTitle = Mid$(formName, Len(DEFAULT_UTILITY_SHORT_NAME & " ") + 1)
    If Len(ribbonTitle) = 0 Then Err.Raise vbObjectError + 9797, "DefaultManagedUserForm", "A discovered user form has no Ribbon title after removing the required ADC prefix." & vbCrLf & "Form: " & formName
    DefaultManagedObject formName, ADCAT_CATEGORY_MANAGED_FORM, ADCAT_OBJECT_TYPE_FORM, descriptionText, SortOrder, repairDefaultRows, _
        DEFAULT_RIBBON_TAB_KEY_FORMS, DEFAULT_RIBBON_TAB_LABEL_FORMS, ribbonGroupLabel, ribbonGroupSortOrder, ribbonTitle, True, _
        SETTING_DEFAULT_FORMS_NAV_GROUP, DEFAULT_CATALOG_OWNER_USER, vbNullString, True, True
    ApplyDiscoveredUserFormManagedIdentity formName
    DefaultRelevantForm formName, formName, descriptionText, vbNullString, DEFAULT_NAVIGATION_PANE_GROUP_KEY_GENERATED_FORMS, CONFIG_OWNER_DATABASE_ROLE_CODE_DB, SortOrder, repairDefaultRows, DEFAULT_CATALOG_OWNER_USER, False
    LogTraceMessage TRACE_LEVEL_DETAIL, "ManagedForms", "DefaultManagedUserForm", "Discovered User form reconciled.", "PhysicalOwnerDatabaseRole: " & CONFIG_OWNER_DATABASE_ROLE_CODE_DB & vbCrLf & "ObjectType: " & ADCAT_OBJECT_TYPE_FORM & vbCrLf & "ExactPhysicalFormName: " & formName & vbCrLf & "Managed identity: " & DiscoveredUserFormManagedIdentity(formName), "Reconcile discovered user form", 0, vbNullString, vbNullString, formName, "Form", "CodeDb", "DiscoveredUser"
End Sub

Private Function UserOwnedFormRibbonKeyFromObjectTitle(ByVal objectTitle As String, ByVal formName As String) As String
    'Canonical user-owned form Ribbon-key derivation. Remove spaces only; preserve case and all other text that the current Ribbon/tag contracts allow.
    objectTitle = Trim$(objectTitle)
    UserOwnedFormRibbonKeyFromObjectTitle = Replace(objectTitle, " ", vbNullString, 1, -1, vbBinaryCompare)
    If Len(UserOwnedFormRibbonKeyFromObjectTitle) = 0 Then Err.Raise vbObjectError + 9792, "UserOwnedFormRibbonKeyFromObjectTitle", "A user-owned form has no canonical ObjectDisplayName from which to derive Ribbon identity." & vbCrLf & "Form: " & formName
    If InStr(1, UserOwnedFormRibbonKeyFromObjectTitle, "|", vbBinaryCompare) > 0 Or InStr(1, UserOwnedFormRibbonKeyFromObjectTitle, ";", vbBinaryCompare) > 0 Then Err.Raise vbObjectError + 9793, "UserOwnedFormRibbonKeyFromObjectTitle", "A user-owned form's canonical ObjectDisplayName produces a Ribbon key containing a reserved AccessUI tag delimiter." & vbCrLf & "Form: " & formName & vbCrLf & "ObjectDisplayName: " & objectTitle & vbCrLf & "Derived Ribbon key: " & UserOwnedFormRibbonKeyFromObjectTitle
End Function

Private Sub ValidateUserOwnedFormRibbonKeyCollision(ByVal db As DAO.Database, ByVal managedObjectID As Long, ByVal formName As String, ByVal objectTitle As String, ByVal ribbonKey As String)
    'Collision failure is intentional: two catalog identities may not share one derived user-owned form Ribbon identity.
    Dim rs As DAO.Recordset
    Dim sqlText As String
    Dim collisionDetail As String
    sqlText = "SELECT TOP 1 " & SQL_FIELD_ID & "," & SQL_FIELD_OBJECT_NAME & "," & SQL_FIELD_OBJECT_DISPLAY_NAME & "," & SQL_FIELD_OBJECT_TYPE & ",[" & FIELD_CATALOG_OWNER & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] WHERE [" & FIELD_RIBBON_STATIC_TAG & "]=" & SharedDao_SqlQuote(ribbonKey)
    If managedObjectID > 0 Then sqlText = sqlText & " AND " & SQL_FIELD_ID & "<>" & CStr(managedObjectID)
    sqlText = sqlText & " ORDER BY " & SQL_FIELD_ID & ";"
    Set rs = db.OpenRecordset(sqlText, dbOpenSnapshot)
    If rs.EOF = False Then
        collisionDetail = "A user-owned form Ribbon identity collides with another managed object. Ribbon materialization cannot continue with an ambiguous static tag/custom ID." & vbCrLf & _
            "Incoming form: " & formName & vbCrLf & _
            "Incoming ObjectDisplayName: " & objectTitle & vbCrLf & _
            "Derived Ribbon key: " & ribbonKey & vbCrLf & _
            "Existing object: " & CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString)) & vbCrLf & _
            "Existing ObjectDisplayName: " & CStr(Nz(rs.fields(FIELD_OBJECT_DISPLAY_NAME).value, vbNullString)) & vbCrLf & _
            "Existing object type: " & CStr(Nz(rs.fields(FIELD_OBJECT_TYPE).value, vbNullString)) & vbCrLf & _
            "Existing CatalogOwner: " & CStr(Nz(rs.fields(FIELD_CATALOG_OWNER).value, vbNullString))
    End If
    rs.Close
    If Len(collisionDetail) > 0 Then Err.Raise vbObjectError + 9794, "ValidateUserOwnedFormRibbonKeyCollision", collisionDetail
End Sub

Private Sub ApplyManagedFormPlacement(ByVal db As DAO.Database, ByVal formName As String, ByVal isDiscoveredUserForm As Boolean)
    'Applies authoritative Navigation Pane and ribbon placement for one allowed managed form.
    Dim ribbonTabKey As String
    If ManagedObjectIsRibbonExcludedByPolicy(formName, ADCAT_OBJECT_TYPE_FORM) Then
        ApplyHiddenSetupFormPlacementPolicy db, formName
        Exit Sub
    End If
    Dim ribbonTabLabel As String
    Dim ribbonGroupLabel As String
    Dim ribbonGroupSortOrder As Long
    Dim ribbonTabKeySourceName As String
    Dim ribbonTabLabelSourceName As String
    Dim ribbonGroupLabelSourceName As String
    Dim managedObjectsTableName As String
    Dim navigationPaneGroupSettingKey As String
    If isDiscoveredUserForm Then
        ribbonTabKey = DEFAULT_RIBBON_TAB_KEY_FORMS
        ribbonTabLabel = DEFAULT_RIBBON_TAB_LABEL_FORMS
        ribbonGroupLabel = DEFAULT_USER_FORM_RIBBON_GROUP_FORMS
        ribbonGroupSortOrder = UserFormRibbonGroupSortOrder(ribbonGroupLabel)
        ribbonTabKeySourceName = "DEFAULT_RIBBON_TAB_KEY_FORMS"
        ribbonTabLabelSourceName = "DEFAULT_RIBBON_TAB_LABEL_FORMS"
        ribbonGroupLabelSourceName = "DEFAULT_USER_FORM_RIBBON_GROUP_FORMS"
    Else
        If ManagedObjectPlacementRibbon(formName, ADCAT_OBJECT_TYPE_FORM, ribbonTabKey, ribbonTabLabel, ribbonGroupLabel, ribbonGroupSortOrder) = False Then Exit Sub
        ribbonTabKeySourceName = "ManagedObjectPlacementRibbon"
        ribbonTabLabelSourceName = "ManagedObjectPlacementRibbon"
        ribbonGroupLabelSourceName = "ManagedObjectPlacementRibbon"
    End If
    managedObjectsTableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID)
    navigationPaneGroupSettingKey = ManagedObjectNavigationPaneSettingKey(formName, ADCAT_OBJECT_TYPE_FORM)
    ValidateSqlTextFieldValueLength db, managedObjectsTableName, FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY, navigationPaneGroupSettingKey, "ManagedObjectNavigationPaneSettingKey"
    ValidateSqlTextFieldValueLength db, managedObjectsTableName, FIELD_RIBBON_TAB_KEY, ribbonTabKey, ribbonTabKeySourceName
    ValidateSqlTextFieldValueLength db, managedObjectsTableName, FIELD_RIBBON_TAB_LABEL, ribbonTabLabel, ribbonTabLabelSourceName
    ValidateSqlTextFieldValueLength db, managedObjectsTableName, FIELD_RIBBON_GROUP_LABEL, ribbonGroupLabel, ribbonGroupLabelSourceName
    Dim differenceWhere As String
    differenceWhere = "(Nz([" & FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY & "],'')<>" & SharedDao_SqlQuote(navigationPaneGroupSettingKey) & _
                      " OR Nz([" & FIELD_RIBBON_TAB_KEY & "],'')<>" & SharedDao_SqlQuote(ribbonTabKey) & _
                      " OR Nz([" & FIELD_RIBBON_TAB_LABEL & "],'')<>" & SharedDao_SqlQuote(ribbonTabLabel) & _
                      " OR Nz([" & FIELD_RIBBON_GROUP_LABEL & "],'')<>" & SharedDao_SqlQuote(ribbonGroupLabel) & _
                      " OR Nz([" & FIELD_RIBBON_GROUP_SORT_ORDER & "],0)<>" & CStr(ribbonGroupSortOrder)
    differenceWhere = differenceWhere & ")"
    db.Execute "UPDATE [" & managedObjectsTableName & "] SET [" & FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY & "]=" & SharedDao_SqlQuote(navigationPaneGroupSettingKey) & ", [" & FIELD_RIBBON_TAB_KEY & "]=" & SharedDao_SqlQuote(ribbonTabKey) & ", [" & FIELD_RIBBON_TAB_LABEL & "]=" & SharedDao_SqlQuote(ribbonTabLabel) & ", [" & FIELD_RIBBON_GROUP_LABEL & "]=" & SharedDao_SqlQuote(ribbonGroupLabel) & ", [" & FIELD_RIBBON_GROUP_SORT_ORDER & "]=" & CStr(ribbonGroupSortOrder) & " WHERE UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))='FORM' AND " & SQL_FIELD_OBJECT_NAME & "=" & SharedDao_SqlQuote(formName) & " AND " & differenceWhere & ";", dbFailOnError
End Sub

Private Sub DefaultRelevantForm(ByVal formName As String, ByVal formDisplayName As String, ByVal descriptionText As String, ByVal formType As String, ByVal navPaneGroupKey As String, ByVal ConfigOwnerDatabaseRole As String, ByVal SortOrder As Long, ByVal repairDefaultRows As Boolean, Optional ByVal catalogOwner As String = vbNullString, Optional ByVal isGeneratedByUtility As Boolean = False)
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim sqlText As String
    Dim isNewRow As Boolean
    Dim rowChanged As Boolean
    Dim ownsRecordset As Boolean
    Dim batchBookmark As Variant
    Dim candidateKey As Variant
    If Len(formName) = 0 Then Exit Sub
    If Len(catalogOwner) = 0 Then catalogOwner = DEFAULT_CATALOG_OWNER_USER
    PumpSetupResponsiveness
    descriptionText = ManagedObjectDefaultDescriptionForSetup(formName, ADCAT_CATEGORY_MANAGED_FORM, ADCAT_OBJECT_TYPE_FORM, descriptionText)
    If mManagedDefinitionBatchActive Then
        Set db = mManagedDefinitionBatchDb
        If mManagedDefinitionBatchFormsRs Is Nothing Or mManagedDefinitionBatchFormBookmarks Is Nothing Then Err.Raise vbObjectError + 9824, "DefaultRelevantForm", "The reusable UI_Frm_Registry batch is unavailable while form metadata is being reconciled."
        Set rs = mManagedDefinitionBatchFormsRs
        If mManagedDefinitionBatchFormBookmarks.Exists(formName) Then
            batchBookmark = mManagedDefinitionBatchFormBookmarks(formName)
            rs.Bookmark = batchBookmark
        Else
            For Each candidateKey In mManagedDefinitionBatchFormBookmarks.keys
                If StrComp(CStr(candidateKey), formName, vbTextCompare) = 0 Then
                    batchBookmark = mManagedDefinitionBatchFormBookmarks(candidateKey)
                    rs.Bookmark = batchBookmark
                    Exit For
                End If
            Next candidateKey
            If IsEmpty(batchBookmark) Then isNewRow = True
        End If
    Else
        Set db = ResolveCatalogDb()
        sqlText = "SELECT * FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_FormDefinitions") & "] WHERE " & SQL_FIELD_FORM_OBJECT_NAME & "=" & SharedDao_SqlQuote(formName) & ";"
        Set rs = db.OpenRecordset(sqlText, dbOpenDynaset)
        ownsRecordset = True
        isNewRow = rs.EOF
    End If
    If isNewRow Then
        rs.AddNew
        rs.fields(FIELD_FORM_OBJECT_NAME).value = formName
        rs.fields(FIELD_FORM_DISPLAY_NAME_BASE).value = formDisplayName
        rs.fields(FIELD_FORM_DESCRIPTION).value = descriptionText
        If Len(formType) > 0 Then rs.fields(FIELD_FORM_TYPE).value = formType Else rs.fields(FIELD_FORM_TYPE).value = Null
        rs.fields(FIELD_NAVIGATION_PANE_GROUP_KEY).value = navPaneGroupKey
        rs.fields(FIELD_CONFIG_OWNER_DATABASE_ROLE).value = ConfigOwnerDatabaseRole
        SetRecordsetFieldValueWithSource rs, FIELD_FORM_STATUS, DEFAULT_RELEVANT_FORM_STATUS, "DEFAULT_RELEVANT_FORM_STATUS"
        rs.fields(FIELD_CATALOG_OWNER).value = catalogOwner
        rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value = SortOrder
        rs.fields(FIELD_MANAGED_OBJECT_FIELD_SOURCE_OBJECT_NAME).value = formName
        rs.fields(FIELD_IS_GENERATED_BY_UTILITY).value = isGeneratedByUtility
        SetRecordsetFieldValueWithSource rs, FIELD_OPEN_AFTER_SETUP, DEFAULT_RELEVANT_FORM_OPEN_AFTER_SETUP, "DEFAULT_RELEVANT_FORM_OPEN_AFTER_SETUP"
        SetRecordsetFieldValueWithSource rs, FIELD_DEFAULT_SOURCE, DEFAULT_RELEVANT_FORM_SOURCE, "DEFAULT_RELEVANT_FORM_SOURCE"
        rs.fields(FIELD_DEFAULTED_ON).value = Now
        rowChanged = True
    ElseIf repairDefaultRows Then
        rs.Edit
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_FORM_DISPLAY_NAME_BASE).value, vbNullString)))) = 0 Then rs.fields(FIELD_FORM_DISPLAY_NAME_BASE).value = formDisplayName: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_FORM_DESCRIPTION).value, vbNullString)))) = 0 Then rs.fields(FIELD_FORM_DESCRIPTION).value = descriptionText: rowChanged = True
        If Len(formType) > 0 Then
            If Len(Trim$(CStr(Nz(rs.fields(FIELD_FORM_TYPE).value, vbNullString)))) = 0 Then rs.fields(FIELD_FORM_TYPE).value = formType: rowChanged = True
        End If
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_NAVIGATION_PANE_GROUP_KEY).value, vbNullString)))) = 0 Then rs.fields(FIELD_NAVIGATION_PANE_GROUP_KEY).value = navPaneGroupKey: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_CONFIG_OWNER_DATABASE_ROLE).value, vbNullString)))) = 0 Then rs.fields(FIELD_CONFIG_OWNER_DATABASE_ROLE).value = ConfigOwnerDatabaseRole: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_FORM_STATUS).value, vbNullString)))) = 0 Then
            SetRecordsetFieldValueWithSource rs, FIELD_FORM_STATUS, DEFAULT_RELEVANT_FORM_STATUS, "DEFAULT_RELEVANT_FORM_STATUS"
            rowChanged = True
        End If
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_CATALOG_OWNER).value, vbNullString)))) = 0 Then rs.fields(FIELD_CATALOG_OWNER).value = catalogOwner: rowChanged = True
        If IsNull(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value) Then rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value = SortOrder: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_FIELD_SOURCE_OBJECT_NAME).value, vbNullString)))) = 0 Then rs.fields(FIELD_MANAGED_OBJECT_FIELD_SOURCE_OBJECT_NAME).value = formName: rowChanged = True
        If IsNull(rs.fields(FIELD_IS_GENERATED_BY_UTILITY).value) Then rs.fields(FIELD_IS_GENERATED_BY_UTILITY).value = isGeneratedByUtility: rowChanged = True
        If IsNull(rs.fields(FIELD_OPEN_AFTER_SETUP).value) Then
            SetRecordsetFieldValueWithSource rs, FIELD_OPEN_AFTER_SETUP, DEFAULT_RELEVANT_FORM_OPEN_AFTER_SETUP, "DEFAULT_RELEVANT_FORM_OPEN_AFTER_SETUP"
            rowChanged = True
        End If
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_DEFAULT_SOURCE).value, vbNullString)))) = 0 Then
            SetRecordsetFieldValueWithSource rs, FIELD_DEFAULT_SOURCE, DEFAULT_RELEVANT_FORM_SOURCE, "DEFAULT_RELEVANT_FORM_SOURCE"
            rowChanged = True
        End If
        If rowChanged Then rs.fields(FIELD_LAST_DEFAULT_REPAIR_ON).value = Now
    Else
        If ownsRecordset Then rs.Close
        Exit Sub
    End If
    If rowChanged = False Then
        If rs.EditMode <> dbEditNone Then rs.CancelUpdate
        If ownsRecordset Then rs.Close
        Exit Sub
    End If
    rs.Update
    MarkManagedDefinitionMutation CATALOG_DIRTY_FORMS
    If mManagedDefinitionBatchActive Then
        If isNewRow Then
            rs.Bookmark = rs.LastModified
            If mManagedDefinitionBatchFormBookmarks.Exists(formName) = False Then
                mManagedDefinitionBatchFormBookmarks.Add formName, rs.Bookmark
            End If
        End If
    End If
    If ownsRecordset Then rs.Close
    Exit Sub
ErrHandler:
    Dim originalErrNumber As Long
    Dim originalErrSource As String
    Dim originalErrDescription As String
    originalErrNumber = Err.Number
    originalErrSource = Err.Source
    originalErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then
        If rs.EditMode <> dbEditNone Then rs.CancelUpdate
        If ownsRecordset Then rs.Close
    End If
    On Error GoTo 0
    Err.Raise originalErrNumber, "DefaultRelevantForm", "Could not default the " & DEFAULT_UTILITY_LONG_NAME & " form row without overwriting existing user values." & vbCrLf & "Form: " & formName & vbCrLf & "Err.Source: " & originalErrSource & vbCrLf & "Err.Description: " & originalErrDescription
End Sub

Private Sub ValidateSqlTextFieldValueLength(ByVal db As DAO.Database, ByVal tableName As String, ByVal fieldName As String, ByVal fieldValue As Variant, ByVal valueSourceName As String)
    'Validates source-known text values before action SQL bypasses the recordset assignment validator.
    Dim targetField As DAO.Field
    If IsNull(fieldValue) Then Exit Sub
    If SharedDao_DatabaseTableFieldExistsSafe(db, tableName, fieldName) = False Then Exit Sub
    Set targetField = db.TableDefs(tableName).fields(fieldName)
    If targetField.Type <> dbText Then Exit Sub
    If Len(CStr(fieldValue)) <= targetField.Size Then Exit Sub
    Err.Raise vbObjectError + 10144, "ValidateSqlTextFieldValueLength", "A value exceeds the destination Short Text field length before action SQL execution." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName & vbCrLf & "Maximum length: " & CStr(targetField.Size) & vbCrLf & "Value length: " & CStr(Len(CStr(fieldValue))) & vbCrLf & "Default/value source: " & IIf(Len(Trim$(valueSourceName)) > 0, valueSourceName, "(not applicable; runtime/caller value)")
End Sub

Private Sub DefaultPersistentGeneratedForm(ByVal formName As String, ByVal repairDefaultRows As Boolean)
    Dim db As DAO.Database
    Dim definitionData As Variant
    Dim descriptionText As String
    Dim sortOrderValue As Long
    Dim ribbonTabKey As String
    Dim ribbonTabLabel As String
    Dim ribbonGroupLabel As String
    Dim ribbonGroupSortOrder As Long
    Dim ribbonTitle As String
    Dim ribbonTag As String
    Dim logicalIdentity As String
    Dim managedObjectsTableName As String
    If TryGetManagedObjectDefinition(formName, ADCAT_OBJECT_TYPE_FORM, definitionData) = False Then Err.Raise vbObjectError + 9795, "DefaultPersistentGeneratedForm", "The persistent generated form has no canonical managed-object definition." & vbCrLf & "Form: " & formName
    descriptionText = CStr(definitionData(3))
    sortOrderValue = CLng(definitionData(4))
    If ManagedObjectPlacementRibbon(formName, ADCAT_OBJECT_TYPE_FORM, ribbonTabKey, ribbonTabLabel, ribbonGroupLabel, ribbonGroupSortOrder) = False Then Err.Raise vbObjectError + 9796, "DefaultPersistentGeneratedForm", "The persistent generated form has no canonical Ribbon placement." & vbCrLf & "Form: " & formName
    ribbonTitle = ManagedObjectCanonicalRibbonTitleOverride(formName, ADCAT_OBJECT_TYPE_FORM)
    TryRibbonStaticButtonTagDefault ADCAT_OBJECT_TYPE_FORM, formName, ribbonTag
    DefaultManagedObject formName, ADCAT_CATEGORY_MANAGED_FORM, ADCAT_OBJECT_TYPE_FORM, descriptionText, sortOrderValue, repairDefaultRows, ribbonTabKey, ribbonTabLabel, ribbonGroupLabel, ribbonGroupSortOrder, ribbonTitle, True, ManagedObjectNavigationPaneSettingKey(formName, ADCAT_OBJECT_TYPE_FORM), DEFAULT_CATALOG_OWNER_PERSISTENT_GENERATED, ribbonTag, False
    logicalIdentity = PersistentGeneratedFormLogicalIdentity(formName)
    Set db = ResolveCatalogDb()
    managedObjectsTableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID)
    ValidateSqlTextFieldValueLength db, managedObjectsTableName, FIELD_LOGICAL_OBJECT_NAME, logicalIdentity, "PersistentGeneratedFormLogicalIdentity"
    ValidateSqlTextFieldValueLength db, managedObjectsTableName, FIELD_CATALOG_OWNER, DEFAULT_CATALOG_OWNER_PERSISTENT_GENERATED, "DEFAULT_CATALOG_OWNER_PERSISTENT_GENERATED"
    db.Execute "UPDATE [" & managedObjectsTableName & "] SET [" & FIELD_LOGICAL_OBJECT_NAME & "]=" & SharedDao_SqlQuote(logicalIdentity) & ",[" & FIELD_OBJECT_NAMING_CATEGORY & "]=Null,[" & FIELD_CATALOG_OWNER & "]=" & SharedDao_SqlQuote(DEFAULT_CATALOG_OWNER_PERSISTENT_GENERATED) & " WHERE UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))='FORM' AND " & SQL_FIELD_OBJECT_NAME & "=" & SharedDao_SqlQuote(formName) & ";", dbFailOnError
    DefaultRelevantForm formName, formName, descriptionText, DEFAULT_FORM_TYPE_SINGLE, DEFAULT_NAVIGATION_PANE_GROUP_KEY_GENERATED_FORMS, CONFIG_OWNER_DATABASE_ROLE_CODE_DB, sortOrderValue, repairDefaultRows, DEFAULT_CATALOG_OWNER_PERSISTENT_GENERATED, True
End Sub

Private Sub NormalizeManagedFormOwnershipSets(ByVal db As DAO.Database, ByVal generatedNameList As String, ByVal persistentNameList As String, ByVal userNameList As String)
    Dim changedCount As Long
    Dim managedObjectsTableName As String
    Dim formDefinitionsTableName As String
    managedObjectsTableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID)
    formDefinitionsTableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_FormDefinitions")
    If Len(generatedNameList) > 0 Then
        ValidateSqlTextFieldValueLength db, managedObjectsTableName, FIELD_CATALOG_OWNER, DEFAULT_CATALOG_OWNER_GENERATED, "DEFAULT_CATALOG_OWNER_GENERATED"
        db.Execute "UPDATE [" & managedObjectsTableName & "] SET [" & FIELD_CATALOG_OWNER & "]=" & SharedDao_SqlQuote(DEFAULT_CATALOG_OWNER_GENERATED) & " WHERE UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))='FORM' AND " & SQL_FIELD_OBJECT_NAME & " IN (" & generatedNameList & ") AND Nz([" & FIELD_CATALOG_OWNER & "],'')<>" & SharedDao_SqlQuote(DEFAULT_CATALOG_OWNER_GENERATED) & ";", dbFailOnError
        changedCount = changedCount + db.RecordsAffected
    End If
    If Len(persistentNameList) > 0 Then
        ValidateSqlTextFieldValueLength db, managedObjectsTableName, FIELD_CATALOG_OWNER, DEFAULT_CATALOG_OWNER_PERSISTENT_GENERATED, "DEFAULT_CATALOG_OWNER_PERSISTENT_GENERATED"
        db.Execute "UPDATE [" & managedObjectsTableName & "] SET [" & FIELD_CATALOG_OWNER & "]=" & SharedDao_SqlQuote(DEFAULT_CATALOG_OWNER_PERSISTENT_GENERATED) & " WHERE UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))='FORM' AND " & SQL_FIELD_OBJECT_NAME & " IN (" & persistentNameList & ") AND Nz([" & FIELD_CATALOG_OWNER & "],'')<>" & SharedDao_SqlQuote(DEFAULT_CATALOG_OWNER_PERSISTENT_GENERATED) & ";", dbFailOnError
        changedCount = changedCount + db.RecordsAffected
        ValidateSqlTextFieldValueLength db, formDefinitionsTableName, FIELD_CATALOG_OWNER, DEFAULT_CATALOG_OWNER_PERSISTENT_GENERATED, "DEFAULT_CATALOG_OWNER_PERSISTENT_GENERATED"
        ValidateSqlTextFieldValueLength db, formDefinitionsTableName, FIELD_CONFIG_OWNER_DATABASE_ROLE, CONFIG_OWNER_DATABASE_ROLE_CODE_DB, "CONFIG_OWNER_DATABASE_ROLE_CODE_DB"
        db.Execute "UPDATE [" & formDefinitionsTableName & "] SET [" & FIELD_CATALOG_OWNER & "]=" & SharedDao_SqlQuote(DEFAULT_CATALOG_OWNER_PERSISTENT_GENERATED) & "," & SQL_FIELD_IS_GENERATED_BY_UTILITY & "=True,[" & FIELD_CONFIG_OWNER_DATABASE_ROLE & "]=" & SharedDao_SqlQuote(CONFIG_OWNER_DATABASE_ROLE_CODE_DB) & " WHERE " & SQL_FIELD_FORM_OBJECT_NAME & " IN (" & persistentNameList & ") AND (Nz([" & FIELD_CATALOG_OWNER & "],'')<>" & SharedDao_SqlQuote(DEFAULT_CATALOG_OWNER_PERSISTENT_GENERATED) & " OR Nz(" & SQL_FIELD_IS_GENERATED_BY_UTILITY & ",False)<>True OR Nz([" & FIELD_CONFIG_OWNER_DATABASE_ROLE & "],'')<>" & SharedDao_SqlQuote(CONFIG_OWNER_DATABASE_ROLE_CODE_DB) & ");", dbFailOnError
        changedCount = changedCount + db.RecordsAffected
    End If
    If Len(userNameList) > 0 Then
        ValidateSqlTextFieldValueLength db, managedObjectsTableName, FIELD_CATALOG_OWNER, DEFAULT_CATALOG_OWNER_USER, "DEFAULT_CATALOG_OWNER_USER"
        db.Execute "UPDATE [" & managedObjectsTableName & "] SET [" & FIELD_CATALOG_OWNER & "]=" & SharedDao_SqlQuote(DEFAULT_CATALOG_OWNER_USER) & " WHERE UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))='FORM' AND " & SQL_FIELD_OBJECT_NAME & " IN (" & userNameList & ") AND Nz([" & FIELD_CATALOG_OWNER & "],'')<>" & SharedDao_SqlQuote(DEFAULT_CATALOG_OWNER_USER) & ";", dbFailOnError
        changedCount = changedCount + db.RecordsAffected
        ValidateSqlTextFieldValueLength db, formDefinitionsTableName, FIELD_CATALOG_OWNER, DEFAULT_CATALOG_OWNER_USER, "DEFAULT_CATALOG_OWNER_USER"
        ValidateSqlTextFieldValueLength db, formDefinitionsTableName, FIELD_CONFIG_OWNER_DATABASE_ROLE, CONFIG_OWNER_DATABASE_ROLE_CODE_DB, "CONFIG_OWNER_DATABASE_ROLE_CODE_DB"
        db.Execute "UPDATE [" & formDefinitionsTableName & "] SET [" & FIELD_CATALOG_OWNER & "]=" & SharedDao_SqlQuote(DEFAULT_CATALOG_OWNER_USER) & "," & SQL_FIELD_IS_GENERATED_BY_UTILITY & "=False,[" & FIELD_CONFIG_OWNER_DATABASE_ROLE & "]=" & SharedDao_SqlQuote(CONFIG_OWNER_DATABASE_ROLE_CODE_DB) & " WHERE " & SQL_FIELD_FORM_OBJECT_NAME & " IN (" & userNameList & ") AND (Nz([" & FIELD_CATALOG_OWNER & "],'')<>" & SharedDao_SqlQuote(DEFAULT_CATALOG_OWNER_USER) & " OR Nz(" & SQL_FIELD_IS_GENERATED_BY_UTILITY & ",False)<>False OR Nz([" & FIELD_CONFIG_OWNER_DATABASE_ROLE & "],'')<>" & SharedDao_SqlQuote(CONFIG_OWNER_DATABASE_ROLE_CODE_DB) & ");", dbFailOnError
        changedCount = changedCount + db.RecordsAffected
    End If
    If changedCount > 0 Then MarkManagedDefinitionMutation CATALOG_DIRTY_FORMS Or CATALOG_DIRTY_INVENTORY Or CATALOG_DIRTY_UI
End Sub

Private Sub PersistManagedFormReconciliationStateToken(ByVal db As DAO.Database, ByVal tokenText As String)
    RequireSetupDomainMutationAllowed SETUP_DOMAIN_D4_MANAGED_FORM_PROOF, "PersistManagedFormReconciliationStateToken"
    On Error GoTo OptionalStateWarning
    If Len(tokenText) = 0 Then Err.Raise vbObjectError + 9122, "PersistManagedFormReconciliationStateToken", "The managed-form reconciliation state token is blank."
    Call EnsureDaoPropertyValue(db, MANAGED_FORM_RECONCILIATION_TOKEN_PROPERTY, dbText, tokenText, "PersistManagedFormReconciliationStateToken")
    Exit Sub
OptionalStateWarning:
    CoreAddOperationNote "Warning: managed-form reconciliation completed, but its optional exact compact state token could not be persisted. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
    Err.Clear
End Sub

Private Sub ReassignDuplicateManagedFormMetadata(ByVal db As DAO.Database, ByVal duplicateMappings As Collection, ByRef canonicalIDs As Collection, ByRef incomingRedirectedCount As Long, ByRef outgoingRedirectedCount As Long, ByRef payloadMovedCount As Long, ByRef payloadMergedCount As Long)
    'Redirects metadata from discarded duplicate IDs to the selected canonical Form row while preserving conflicts for explicit review.
    Dim mapping As Variant
    Dim duplicateID As Long
    Dim canonicalID As Long
    Dim canonicalName As String
    Dim dependencyTableName As String
    Dim payloadTableName As String
    Dim dependencyTableExists As Boolean
    Dim payloadTableExists As Boolean
    dependencyTableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies")
    payloadTableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads")
    dependencyTableExists = SharedDao_DatabaseTableExistsSafe(db, dependencyTableName)
    payloadTableExists = SharedDao_DatabaseTableExistsSafe(db, payloadTableName)
    For Each mapping In duplicateMappings
        PumpSetupResponsiveness
        duplicateID = CLng(mapping(0))
        canonicalID = CLng(mapping(1))
        canonicalName = CStr(mapping(2))
        AddUniqueLong canonicalIDs, canonicalID
        If dependencyTableExists Then
            db.Execute "UPDATE [" & dependencyTableName & "] SET [" & FIELD_DEPENDS_ON_MANAGED_OBJECT_ID & "]=" & CStr(canonicalID) & " WHERE [" & FIELD_DEPENDS_ON_MANAGED_OBJECT_ID & "]=" & CStr(duplicateID) & ";", dbFailOnError
            incomingRedirectedCount = incomingRedirectedCount + db.RecordsAffected
            db.Execute "UPDATE [" & dependencyTableName & "] SET [" & FIELD_MANAGED_OBJECT_ID & "]=" & CStr(canonicalID) & " WHERE [" & FIELD_MANAGED_OBJECT_ID & "]=" & CStr(duplicateID) & ";", dbFailOnError
            outgoingRedirectedCount = outgoingRedirectedCount + db.RecordsAffected
        End If
        If payloadTableExists Then MoveDuplicateActionPayloads db, payloadTableName, duplicateID, canonicalID, canonicalName, payloadMovedCount, payloadMergedCount
    Next mapping
End Sub

Private Sub BuildManagedFormReconciliationPlan( _
    ByVal db As DAO.Database, ByVal affectedWhereText As String, ByVal authoritativeNames As Collection, ByVal canonicalGeneratedNames As Collection, ByVal physicalInventory As Collection, _
    ByRef allAffectedRows As Collection, ByRef staleManagedIDs As Collection, ByRef duplicateManagedIDs As Collection, ByRef duplicateCanonicalRows As Collection, _
    ByRef dependencyAuditManagedIDs As Collection, ByRef rowsNeedingFormTypeNormalization As Collection, ByRef normalizedManagedFormIDs As Collection, _
    ByRef canonicalSystemDefaultCount As Long, ByRef canonicalGeneratedCount As Long, ByRef canonicalOtherCount As Long)
    'Builds the complete pre-mutation D4 reconciliation plan from one coherent MAC snapshot and one physical-form snapshot; the caller owns all later mutation, verification, and transaction sequencing.
    On Error GoTo ErrHandler
    Dim rs As DAO.Recordset
    Dim staleFormNames As Collection
    Dim physicalRows As Collection
    Dim rowData As Variant
    Dim compareData As Variant
    Dim item As Variant
    Dim formName As String
    Dim objectName As String
    Dim objectTypeCode As String
    Dim objectStatus As String
    Dim physicalType As String
    Dim physicalMatchText As String
    Dim rowCountForName As Long
    Dim activeFormRowID As Long
    Dim inactiveFormRowID As Long
    Dim activeFormTypeNormalizationRowID As Long
    Dim inactiveFormTypeNormalizationRowID As Long
    Dim activeFormOwnerRank As Long
    Dim inactiveFormOwnerRank As Long
    Dim activeFormTypeNormalizationOwnerRank As Long
    Dim inactiveFormTypeNormalizationOwnerRank As Long
    Dim rowOwnerRank As Long
    Dim canonicalRowID As Long
    Dim canonicalOwnerRank As Long
    Dim physicalMatchCount As Long
    Dim formCount As Long
    Dim classifiedCount As Long
    Dim rowIsActive As Boolean
    Dim shouldDelete As Boolean
    Dim staleDecision As String
    Dim staleReason As String
    ' INTENTIONAL OPERATION SNAPSHOT: allAffectedRows captures one coherent source state for this invocation of ReconcileManagedFormRowsCore; validity ends with the operation rather than becoming a live data
    ' authority.
    ' INTENTIONAL FILTERED PARTITION: staleManagedIDs, staleFormNames, duplicateManagedIDs, duplicateCanonicalRows, dependencyAuditManagedIDs, rowsNeedingFormTypeNormalization is a consumer-required
    ' subset/projection derived from the source enumerated by ReconcileManagedFormRowsCore; its membership is not independently authoritative.
    ' INTENTIONAL PLAN/PROOF LIFECYCLE SEPARATION: normalizedManagedFormIDs holds planned/recovery work or independently observed validation evidence for ReconcileManagedFormRowsCore; keep it distinct from the
    ' source authority.
    Set allAffectedRows = New Collection
    Set staleManagedIDs = New Collection
    Set staleFormNames = New Collection
    Set duplicateManagedIDs = New Collection
    Set duplicateCanonicalRows = New Collection
    Set dependencyAuditManagedIDs = New Collection
    Set rowsNeedingFormTypeNormalization = New Collection
    Set normalizedManagedFormIDs = New Collection
    Set rs = db.OpenRecordset("SELECT " & SQL_FIELD_ID & ", " & SQL_FIELD_OBJECT_NAME & ", " & SQL_FIELD_OBJECT_TYPE & ", [" & FIELD_MANAGED_OBJECT_STATUS & "], [" & FIELD_CATALOG_OWNER & "], [" & FIELD_LOGICAL_OBJECT_NAME & "], [" & FIELD_OBJECT_NAMING_CATEGORY & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] WHERE " & affectedWhereText & " ORDER BY " & SQL_FIELD_OBJECT_NAME & ", " & SQL_FIELD_ID & ";", dbOpenSnapshot)
    Do While Not rs.EOF
        PumpSetupResponsiveness
        allAffectedRows.Add Array(CLng(rs.fields(FIELD_ID)), CStr(Nz(rs!objectName, vbNullString)), Trim$(CStr(Nz(rs!objectType, vbNullString))), Trim$(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_STATUS).value, ADCAT_STATUS_ACTIVE))), Trim$(CStr(Nz(rs!catalogOwner, vbNullString))), Trim$(CStr(Nz(rs.fields(FIELD_LOGICAL_OBJECT_NAME).value, vbNullString))), Trim$(CStr(Nz(rs.fields(FIELD_OBJECT_NAMING_CATEGORY).value, vbNullString))))
        rs.MoveNext
    Loop
    rs.Close
    Set rs = Nothing
    Set physicalRows = PhysicalFormCatalogRowsFromInventory(physicalInventory, formCount)
    CorePulseProgress "Managed-form reconciliation: classifying authoritative rows against the physical Access object catalog."
    classifiedCount = 0
    For Each item In authoritativeNames
        PumpSetupResponsiveness
        classifiedCount = classifiedCount + 1
        PulseProgressEvery classifiedCount, 10, "Managed-form classification " & CStr(classifiedCount) & " of " & CStr(authoritativeNames.count) & ": " & CStr(item), authoritativeNames.count, "CatalogManagedFormClassification", "Catalog"
        formName = CStr(item)
        rowCountForName = 0
        activeFormRowID = 0
        inactiveFormRowID = 0
        activeFormTypeNormalizationRowID = 0
        inactiveFormTypeNormalizationRowID = 0
        activeFormOwnerRank = 0
        inactiveFormOwnerRank = 0
        activeFormTypeNormalizationOwnerRank = 0
        inactiveFormTypeNormalizationOwnerRank = 0
        For Each rowData In allAffectedRows
            PumpSetupResponsiveness
            If StrComp(CStr(rowData(1)), formName, vbTextCompare) = 0 Then
                rowCountForName = rowCountForName + 1
                objectStatus = Trim$(CStr(rowData(3)))
                rowIsActive = (Len(objectStatus) = 0 Or StrComp(objectStatus, ADCAT_STATUS_ACTIVE, vbTextCompare) = 0)
                'Ranks only recognized owner codes within a status/type tier; the precedence itself is Defaults-owned and ID remains the final tie-breaker.
                rowOwnerRank = ManagedFormCatalogOwnerRank(CStr(rowData(4)))
                If StrComp(CStr(rowData(2)), ADCAT_OBJECT_TYPE_FORM, vbTextCompare) = 0 Then
                    If rowIsActive Then SelectPreferredManagedFormRow CLng(rowData(0)), rowOwnerRank, activeFormRowID, activeFormOwnerRank
                    If rowIsActive = False Then SelectPreferredManagedFormRow CLng(rowData(0)), rowOwnerRank, inactiveFormRowID, inactiveFormOwnerRank
                Else
                    If rowIsActive Then SelectPreferredManagedFormRow CLng(rowData(0)), rowOwnerRank, activeFormTypeNormalizationRowID, activeFormTypeNormalizationOwnerRank
                    If rowIsActive = False Then SelectPreferredManagedFormRow CLng(rowData(0)), rowOwnerRank, inactiveFormTypeNormalizationRowID, inactiveFormTypeNormalizationOwnerRank
                End If
            End If
        Next rowData
        physicalMatchCount = 0
        physicalMatchText = vbNullString
        physicalType = UniquePhysicalObjectTypeFromSnapshot(physicalRows, formName, physicalMatchCount, physicalMatchText)
        If physicalMatchCount > 1 Then Err.Raise vbObjectError + 9050, "ReconcileManagedFormRowsCore", "Authoritative managed form name is physically ambiguous." & vbCrLf & "Form: " & formName & vbCrLf & "Physical matches: " & physicalMatchText
        canonicalRowID = 0
        canonicalOwnerRank = 0
        If rowCountForName > 0 Then
            If activeFormRowID > 0 Then
                canonicalRowID = activeFormRowID
                canonicalOwnerRank = activeFormOwnerRank
            ElseIf inactiveFormRowID > 0 Then
                canonicalRowID = inactiveFormRowID
                canonicalOwnerRank = inactiveFormOwnerRank
            ElseIf activeFormTypeNormalizationRowID > 0 And TextCollectionContains(canonicalGeneratedNames, formName) Then
                canonicalRowID = activeFormTypeNormalizationRowID
                canonicalOwnerRank = activeFormTypeNormalizationOwnerRank
                rowsNeedingFormTypeNormalization.Add Array(canonicalRowID, formName)
                AddUniqueLong normalizedManagedFormIDs, canonicalRowID
                AddUniqueLong dependencyAuditManagedIDs, canonicalRowID
            ElseIf inactiveFormTypeNormalizationRowID > 0 And TextCollectionContains(canonicalGeneratedNames, formName) Then
                canonicalRowID = inactiveFormTypeNormalizationRowID
                canonicalOwnerRank = inactiveFormTypeNormalizationOwnerRank
                rowsNeedingFormTypeNormalization.Add Array(canonicalRowID, formName)
                AddUniqueLong normalizedManagedFormIDs, canonicalRowID
                AddUniqueLong dependencyAuditManagedIDs, canonicalRowID
            ElseIf physicalMatchCount = 1 And StrComp(physicalType, ADCAT_OBJECT_TYPE_FORM, vbTextCompare) = 0 And activeFormTypeNormalizationRowID > 0 Then
                canonicalRowID = activeFormTypeNormalizationRowID
                canonicalOwnerRank = activeFormTypeNormalizationOwnerRank
                rowsNeedingFormTypeNormalization.Add Array(canonicalRowID, formName)
                AddUniqueLong normalizedManagedFormIDs, canonicalRowID
                AddUniqueLong dependencyAuditManagedIDs, canonicalRowID
            ElseIf physicalMatchCount = 1 And StrComp(physicalType, ADCAT_OBJECT_TYPE_FORM, vbTextCompare) = 0 And inactiveFormTypeNormalizationRowID > 0 Then
                canonicalRowID = inactiveFormTypeNormalizationRowID
                canonicalOwnerRank = inactiveFormTypeNormalizationOwnerRank
                rowsNeedingFormTypeNormalization.Add Array(canonicalRowID, formName)
                AddUniqueLong normalizedManagedFormIDs, canonicalRowID
                AddUniqueLong dependencyAuditManagedIDs, canonicalRowID
            Else
                Err.Raise vbObjectError + 9051, "ReconcileManagedFormRowsCore", "An authoritative managed form name already belongs to a non-Form managed-object row and cannot be normalized safely." & vbCrLf & "Form: " & formName & vbCrLf & "Physical matches: " & IIf(Len(physicalMatchText) = 0, "(none)", physicalMatchText)
            End If
            Select Case canonicalOwnerRank
                Case 3
                    canonicalSystemDefaultCount = canonicalSystemDefaultCount + 1
                Case 2
                    canonicalGeneratedCount = canonicalGeneratedCount + 1
                Case Else
                    canonicalOtherCount = canonicalOtherCount + 1
            End Select
            For Each compareData In allAffectedRows
                PumpSetupResponsiveness
                If StrComp(CStr(compareData(1)), formName, vbTextCompare) = 0 And CLng(compareData(0)) <> canonicalRowID Then
                    LogTraceMessage TRACE_LEVEL_DETAIL, "ManagedForms", "ReconcileManagedFormRowsCore", "Managed-form stale-row candidate classified.", "RowID=" & CStr(CLng(compareData(0))) & vbCrLf & "ObjectName=" & CStr(compareData(1)) & vbCrLf & "ObjectType=" & CStr(compareData(2)) & vbCrLf & "Status=" & CStr(compareData(3)) & vbCrLf & "CatalogOwner=" & CStr(compareData(4)) & vbCrLf & "LogicalObjectName=" & CStr(compareData(5)) & vbCrLf & "ObjectNamingCategory=" & CStr(compareData(6)) & vbCrLf & "Decision=Delete" & vbCrLf & "Reason=Duplicate noncanonical row for authoritative managed form; canonical ManagedObjectID=" & CStr(canonicalRowID) & ".", "Classify managed-form stale-row candidate", 0, vbNullString, vbNullString, CStr(compareData(1)), CStr(compareData(2)), "CodeDb", "ManagedForms"
                    AddUniqueLong staleManagedIDs, CLng(compareData(0))
                    AddUniqueLong duplicateManagedIDs, CLng(compareData(0))
                    duplicateCanonicalRows.Add Array(CLng(compareData(0)), canonicalRowID, formName)
                    AddUniqueLong dependencyAuditManagedIDs, canonicalRowID
                End If
            Next compareData
        End If
    Next item
    For Each rowData In allAffectedRows
        PumpSetupResponsiveness
        objectName = CStr(rowData(1))
        objectTypeCode = CStr(rowData(2))
        If ExactTextCollectionContains(authoritativeNames, objectName) = False Then
            shouldDelete = False
            If StrComp(objectTypeCode, ADCAT_OBJECT_TYPE_FORM, vbTextCompare) = 0 Then
                shouldDelete = True
                staleDecision = "Delete"
                staleReason = "Form row is not in the authoritative generated/persistent-generated/discovered-user form set."
            ElseIf PhysicalFormIsDiscoveryCandidate(objectName) Then
                physicalMatchCount = 0
                physicalMatchText = vbNullString
                physicalType = UniquePhysicalObjectTypeFromSnapshot(physicalRows, objectName, physicalMatchCount, physicalMatchText)
                If physicalMatchCount > 1 Then Err.Raise vbObjectError + 9056, "ReconcileManagedFormRowsCore", "A prefixed non-authoritative managed object is physically ambiguous and cannot be deleted safely." & vbCrLf & "Object: " & objectName & vbCrLf & "Physical matches: " & physicalMatchText
                If physicalMatchCount = 0 Or StrComp(physicalType, objectTypeCode, vbTextCompare) <> 0 Or StrComp(physicalType, ADCAT_OBJECT_TYPE_FORM, vbTextCompare) = 0 Then shouldDelete = True
                staleDecision = IIf(shouldDelete, "Delete", "Retain")
                staleReason = "Exact-ADC-prefix row physical comparison: matches=" & CStr(physicalMatchCount) & "; physical type=" & IIf(Len(physicalType) = 0, "(none)", physicalType) & "; stored type=" & objectTypeCode & "."
            Else
                staleDecision = "Retain"
                staleReason = "Row is outside the generated-form reconciliation contract."
            End If
            LogTraceMessage TRACE_LEVEL_DETAIL, "ManagedForms", "ReconcileManagedFormRowsCore", "Managed-form stale-row candidate classified.", "RowID=" & CStr(CLng(rowData(0))) & vbCrLf & "ObjectName=" & objectName & vbCrLf & "ObjectType=" & objectTypeCode & vbCrLf & "Status=" & CStr(rowData(3)) & vbCrLf & "CatalogOwner=" & CStr(rowData(4)) & vbCrLf & "LogicalObjectName=" & CStr(rowData(5)) & vbCrLf & "ObjectNamingCategory=" & CStr(rowData(6)) & vbCrLf & "Decision=" & staleDecision & vbCrLf & "Reason=" & staleReason, "Classify managed-form stale-row candidate", 0, vbNullString, vbNullString, objectName, objectTypeCode, "CodeDb", "ManagedForms"
            If shouldDelete Then
                AddUniqueLong staleManagedIDs, CLng(rowData(0))
                If Len(objectName) > 0 Then AddUniqueText staleFormNames, objectName
            End If
        End If
    Next rowData
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    Err.Raise savedErrNumber, "ReconcileManagedFormRowsCore", savedErrDescription
End Sub

Private Sub ReconcileManagedFormRowsCore(ByVal repairDefaultRows As Boolean, ByVal callerOwnsTransaction As Boolean, Optional ByRef reconciliationSummary As String = vbNullString, Optional ByVal suppliedCanonicalGeneratedNames As Variant, Optional ByVal suppliedDiscoveredUserFormNames As Variant, Optional ByVal suppliedAuthoritativeNames As Variant, Optional ByVal suppliedPhysicalInventory As Variant)
    'Performs authoritative managed-form reconciliation inside either its own transaction or a caller-owned transaction.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim ws As DAO.workspace
    Dim canonicalGeneratedNames As Collection
    Dim canonicalPersistentGeneratedNames As Collection
    Dim discoveredUserFormNames As Collection
    Dim authoritativeNames As Collection
    Dim allAffectedRows As Collection
    Dim staleManagedIDs As Collection
    Dim duplicateManagedIDs As Collection
    Dim duplicateCanonicalRows As Collection
    Dim dependencyAuditManagedIDs As Collection
    Dim rowsNeedingFormTypeNormalization As Collection
    Dim normalizedManagedFormIDs As Collection
    Dim physicalInventory As Collection
    Dim rowData As Variant
    Dim generatedDefinition As Variant
    Dim item As Variant
    Dim formName As String
    Dim descriptionText As String
    Dim authoritativeNameList As String
    Dim affectedWhereText As String
    Dim generatedNameList As String
    Dim persistentNameList As String
    Dim userNameList As String
    Dim staleIDList As String
    Dim normalizedManagedFormIDList As String
    Dim dependencyAuditIDList As String
    Dim sortOrderValue As Long
    Dim removedCount As Long
    Dim addedOrUpdatedCount As Long
    Dim normalizedFormTypeCount As Long
    Dim duplicateRemovedCount As Long
    Dim canonicalSystemDefaultCount As Long
    Dim canonicalGeneratedCount As Long
    Dim canonicalOtherCount As Long
    Dim compatibleIncomingDependencyCheckedCount As Long
    Dim compatibleIncomingDependencyAlreadyCorrectCount As Long
    Dim compatibleIncomingDependencyUpdatedCount As Long
    Dim incompatibleIncomingDependencyDeactivatedCount As Long
    Dim inactiveIncompatibleIncomingDependencyCount As Long
    Dim duplicateIncomingDependencyRedirectedCount As Long
    Dim duplicateOutgoingDependencyRedirectedCount As Long
    Dim exactDependencyDuplicateRemovedCount As Long
    Dim duplicatePayloadMovedCount As Long
    Dim duplicatePayloadMergedCount As Long
    Dim deletedNoncurrentGeneratedDefinitionCount As Long
    Dim deletedNoncurrentDiscoveredUserDefinitionCount As Long
    Dim transactionStarted As Boolean
    Dim managedFormRowExisted As Boolean
    Dim managedDefinitionBatchStarted As Boolean
    Dim rollbackFailureText As String
    Dim traceDetail As String
    Dim operationNote As String
    Dim reconciliationStage As String
    reconciliationSummary = vbNullString
    reconciliationStage = "Initialize managed-form reconciliation"
    CorePulseProgress "Managed-form reconciliation: collecting generated and " & DEFAULT_UTILITY_SHORT_NAME & "-prefixed form inventories."
    Set db = ResolveCatalogDb()
    If SharedDao_DatabaseTableExistsSafe(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID)) = False Then Err.Raise vbObjectError + 9091, "ReconcileManagedFormRowsCore", "The MAC table is missing. Managed form reconciliation stopped before mutation."
    If SharedDao_DatabaseTableExistsSafe(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_FormDefinitions")) = False Then Err.Raise vbObjectError + 9032, "ReconcileManagedFormRowsCore", "The required UI_Frm_Registry catalog table is missing. Managed form reconciliation stopped before deleting any rows."
    ValidateAddInReviewManagedObjectDuplicateConflicts db
    If isMissing(suppliedCanonicalGeneratedNames) = False Then
        If IsObject(suppliedCanonicalGeneratedNames) Then Set canonicalGeneratedNames = suppliedCanonicalGeneratedNames
    End If
    If canonicalGeneratedNames Is Nothing Then Set canonicalGeneratedNames = CanonicalGeneratedManagedFormNames()
    If isMissing(suppliedPhysicalInventory) = False Then
        If IsObject(suppliedPhysicalInventory) Then Set physicalInventory = suppliedPhysicalInventory
    End If
    If physicalInventory Is Nothing Then Set physicalInventory = PhysicalManagedFormInventory(db, canonicalGeneratedNames)
    Set canonicalPersistentGeneratedNames = CanonicalPersistentGeneratedManagedFormNames()
    If isMissing(suppliedDiscoveredUserFormNames) = False Then
        If IsObject(suppliedDiscoveredUserFormNames) Then Set discoveredUserFormNames = suppliedDiscoveredUserFormNames
    End If
    If discoveredUserFormNames Is Nothing Then Set discoveredUserFormNames = DiscoveredUserFormNamesFromInventory(physicalInventory)
    If isMissing(suppliedAuthoritativeNames) = False Then
        If IsObject(suppliedAuthoritativeNames) Then Set authoritativeNames = suppliedAuthoritativeNames
    End If
    If authoritativeNames Is Nothing Then Set authoritativeNames = AuthoritativeManagedFormNames(canonicalGeneratedNames, discoveredUserFormNames)
    CorePulseProgress "Managed-form reconciliation inventory ready: generated=" & CStr(canonicalGeneratedNames.count) & "; persistent-generated=" & CStr(canonicalPersistentGeneratedNames.count) & "; discovered-user=" & CStr(discoveredUserFormNames.count) & "; authoritative=" & CStr(authoritativeNames.count) & "."
    authoritativeNameList = QuotedTextCollectionList(authoritativeNames)
    generatedNameList = QuotedTextCollectionList(canonicalGeneratedNames)
    persistentNameList = QuotedTextCollectionList(canonicalPersistentGeneratedNames)
    userNameList = QuotedTextCollectionList(discoveredUserFormNames)
    affectedWhereText = "UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))='FORM'"
    If Len(authoritativeNameList) > 0 Then affectedWhereText = affectedWhereText & " OR " & SQL_FIELD_OBJECT_NAME & " IN (" & authoritativeNameList & ")"
    BuildManagedFormReconciliationPlan db, affectedWhereText, authoritativeNames, canonicalGeneratedNames, physicalInventory, allAffectedRows, staleManagedIDs, duplicateManagedIDs, _
        duplicateCanonicalRows, dependencyAuditManagedIDs, rowsNeedingFormTypeNormalization, normalizedManagedFormIDs, canonicalSystemDefaultCount, canonicalGeneratedCount, canonicalOtherCount
    staleIDList = LongCollectionList(staleManagedIDs)
    addedOrUpdatedCount = 0
    CorePulseProgress "Managed-form reconciliation classification complete; applying type normalization, duplicate cleanup, and authoritative metadata."
    normalizedManagedFormIDList = LongCollectionList(normalizedManagedFormIDs)
    dependencyAuditIDList = LongCollectionList(dependencyAuditManagedIDs)
    If callerOwnsTransaction = False Then
        Set ws = DBEngine.Workspaces(0)
        ws.BeginTrans
        transactionStarted = True
    End If
    For Each rowData In rowsNeedingFormTypeNormalization
        PumpSetupResponsiveness
        db.Execute "UPDATE [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] SET " & SQL_FIELD_OBJECT_TYPE & "=" & SharedDao_SqlQuote(ADCAT_OBJECT_TYPE_FORM) & ",[" & FIELD_CATEGORY_CODE & "]=" & SharedDao_SqlQuote(ADCAT_CATEGORY_MANAGED_FORM) & ",[" & FIELD_MANAGED_OBJECT_STATUS & "]=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " WHERE " & SQL_FIELD_ID & "=" & CStr(CLng(rowData(0))) & ";", dbFailOnError
        normalizedFormTypeCount = normalizedFormTypeCount + db.RecordsAffected
    Next rowData
    If Len(normalizedManagedFormIDList) > 0 Then
        If SharedDao_DatabaseTableExistsSafe(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads")) Then db.Execute "DELETE FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads") & "] WHERE [" & FIELD_MANAGED_OBJECT_ID & "] IN (" & normalizedManagedFormIDList & ");", dbFailOnError
        If SharedDao_DatabaseTableExistsSafe(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies")) Then db.Execute "DELETE FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies") & "] WHERE [" & FIELD_MANAGED_OBJECT_ID & "] IN (" & normalizedManagedFormIDList & ");", dbFailOnError
    End If
    If duplicateCanonicalRows.count > 0 Then ReassignDuplicateManagedFormMetadata db, duplicateCanonicalRows, dependencyAuditManagedIDs, duplicateIncomingDependencyRedirectedCount, duplicateOutgoingDependencyRedirectedCount, duplicatePayloadMovedCount, duplicatePayloadMergedCount
    dependencyAuditIDList = LongCollectionList(dependencyAuditManagedIDs)
    If Len(dependencyAuditIDList) > 0 And SharedDao_DatabaseTableExistsSafe(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies")) Then
        ReconcileIncomingFormDependencies db, dependencyAuditIDList, compatibleIncomingDependencyCheckedCount, compatibleIncomingDependencyAlreadyCorrectCount, compatibleIncomingDependencyUpdatedCount, incompatibleIncomingDependencyDeactivatedCount, inactiveIncompatibleIncomingDependencyCount
        RemoveExactManagedObjectDependencyDuplicates db, dependencyAuditManagedIDs, exactDependencyDuplicateRemovedCount
        ValidateManagedObjectDependencyAudit db, dependencyAuditIDList
    End If
    If Len(staleIDList) > 0 Then
        If SharedDao_DatabaseTableExistsSafe(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies")) Then db.Execute "DELETE FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies") & "] WHERE [" & FIELD_MANAGED_OBJECT_ID & "] IN (" & staleIDList & ") OR [" & FIELD_DEPENDS_ON_MANAGED_OBJECT_ID & "] IN (" & staleIDList & ");", dbFailOnError
        If SharedDao_DatabaseTableExistsSafe(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads")) Then db.Execute "DELETE FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads") & "] WHERE [" & FIELD_MANAGED_OBJECT_ID & "] IN (" & staleIDList & ");", dbFailOnError
        db.Execute "DELETE FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] WHERE " & SQL_FIELD_ID & " IN (" & staleIDList & ");", dbFailOnError
        removedCount = db.RecordsAffected
    End If
    duplicateRemovedCount = duplicateManagedIDs.count
    If normalizedFormTypeCount > 0 Or removedCount > 0 Then MarkManagedDefinitionMutation CATALOG_DIRTY_FORMS Or CATALOG_DIRTY_INVENTORY Or CATALOG_DIRTY_UI
    If Len(authoritativeNameList) > 0 Then
        db.Execute "UPDATE [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] SET " & SQL_FIELD_OBJECT_TYPE & "=" & SharedDao_SqlQuote(ADCAT_OBJECT_TYPE_FORM) & ",[" & FIELD_CATEGORY_CODE & "]=" & SharedDao_SqlQuote(ADCAT_CATEGORY_MANAGED_FORM) & ",[" & FIELD_MANAGED_OBJECT_STATUS & "]=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " WHERE " & SQL_FIELD_OBJECT_NAME & " IN (" & authoritativeNameList & ") AND (UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))<>'FORM' OR Nz([" & FIELD_CATEGORY_CODE & "],'')<>" & SharedDao_SqlQuote(ADCAT_CATEGORY_MANAGED_FORM) & " OR UCase(Trim(Nz([" & FIELD_MANAGED_OBJECT_STATUS & "],'')))<>" & SharedDao_SqlQuote(UCase$(ADCAT_STATUS_ACTIVE)) & ");", dbFailOnError
        If db.RecordsAffected > 0 Then MarkManagedDefinitionMutation CATALOG_DIRTY_FORMS Or CATALOG_DIRTY_INVENTORY Or CATALOG_DIRTY_UI
    End If
    reconciliationStage = "Load fresh post-mutation managed-form default batch"
    BeginManagedDefinitionBatch True, True
    managedDefinitionBatchStarted = True
    AddTraceNote "D4 full reconciliation reused one fresh post-mutation Managed Objects/UI_Frm_Registry batch for all authoritative Form defaulting."
    For Each item In canonicalGeneratedNames
        PumpSetupResponsiveness
        formName = CStr(item)
        generatedDefinition = GeneratedFormCatalogDefinition(formName)
        If IsArray(generatedDefinition) = False Then Err.Raise vbObjectError + 9045, "ReconcileManagedFormRowsCore", "A canonical generated form has no generated-form catalog definition." & vbCrLf & "Form: " & formName
        descriptionText = CStr(generatedDefinition(2))
        sortOrderValue = CLng(generatedDefinition(5))
        managedFormRowExisted = OriginalManagedFormRowExisted(allAffectedRows, formName)
        DefaultDetailedManagedObject formName, ADCAT_CATEGORY_MANAGED_FORM, ADCAT_OBJECT_TYPE_FORM, descriptionText, sortOrderValue, repairDefaultRows
        If repairDefaultRows Or managedFormRowExisted = False Then ApplyManagedFormPlacement db, formName, False
        addedOrUpdatedCount = addedOrUpdatedCount + 1
    Next item
    For Each item In canonicalPersistentGeneratedNames
        PumpSetupResponsiveness
        formName = CStr(item)
        managedFormRowExisted = OriginalManagedFormRowExisted(allAffectedRows, formName)
        DefaultPersistentGeneratedForm formName, repairDefaultRows
        If repairDefaultRows Or managedFormRowExisted = False Then ApplyManagedFormPlacement db, formName, False
        addedOrUpdatedCount = addedOrUpdatedCount + 1
    Next item
    sortOrderValue = 1000
    For Each item In discoveredUserFormNames
        PumpSetupResponsiveness
        formName = CStr(item)
        managedFormRowExisted = OriginalManagedFormRowExisted(allAffectedRows, formName)
        DefaultManagedUserForm formName, DEFAULT_UTILITY_SHORT_NAME & "-prefixed user form discovered automatically from the authoritative physical CodeDb form inventory.", sortOrderValue, repairDefaultRows
        addedOrUpdatedCount = addedOrUpdatedCount + 1
        sortOrderValue = sortOrderValue + 1
    Next item
    EndManagedDefinitionBatch True, "D4 full reconciliation post-mutation authoritative Form defaulting"
    managedDefinitionBatchStarted = False
    NormalizeManagedFormOwnershipSets db, generatedNameList, persistentNameList, userNameList
    reconciliationStage = "Delete noncurrent generated UI_Frm_Registry"
    CorePulseProgress "Managed-form reconciliation: deleting noncurrent utility-generated UI_Frm_Registry metadata."
    deletedNoncurrentGeneratedDefinitionCount = x__UTIL_ADC_UI_FORMS.DeleteNoncurrentGeneratedFormDefinitions(db, canonicalGeneratedNames)
    If deletedNoncurrentGeneratedDefinitionCount > 0 Then MarkManagedDefinitionMutation CATALOG_DIRTY_FORMS Or CATALOG_DIRTY_INVENTORY
    reconciliationStage = "Delete stale discovered-user UI_Frm_Registry"
    deletedNoncurrentDiscoveredUserDefinitionCount = x__UTIL_ADC_UI_FORMS.DeleteNoncurrentDiscoveredUserFormDefinitions(db, discoveredUserFormNames)
    If deletedNoncurrentDiscoveredUserDefinitionCount > 0 Then
        MarkManagedDefinitionMutation CATALOG_DIRTY_FORMS Or CATALOG_DIRTY_INVENTORY
        LogTraceMessage TRACE_LEVEL_INFO, "ManagedForms", "ReconcileManagedFormRowsCore", "Stale Discovered User UI_Frm_Registry metadata removed.", "Rows deleted: " & CStr(deletedNoncurrentDiscoveredUserDefinitionCount), "Reconcile discovered user forms", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_FormDefinitions"), "Table", "CodeDb", "DiscoveredUser"
    End If
    reconciliationStage = "Verify authoritative form rows"
    CorePulseProgress "Managed-form reconciliation: verifying authoritative form rows and ownership metadata."
    VerifyAuthoritativeManagedForms db, canonicalGeneratedNames, authoritativeNames
    reconciliationStage = "Verify ownership and active metadata"
    If Len(authoritativeNameList) > 0 Then
        If CountRowsIfTableExists(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), SQL_FIELD_OBJECT_NAME & " IN (" & authoritativeNameList & ") AND (UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))<>'FORM' OR Nz([" & FIELD_MANAGED_OBJECT_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")<>" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")") <> 0 Then Err.Raise vbObjectError + 9052, "ReconcileManagedFormRowsCore", "An authoritative managed form row is not normalized to active Form metadata."
    End If
    If Len(generatedNameList) > 0 Then
        If CountRowsIfTableExists(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), SQL_FIELD_OBJECT_NAME & " IN (" & generatedNameList & ") AND Nz([" & FIELD_CATALOG_OWNER & "]," & SharedDao_SqlQuote(DEFAULT_CATALOG_OWNER_GENERATED) & ")<>" & SharedDao_SqlQuote(DEFAULT_CATALOG_OWNER_GENERATED)) <> 0 Then Err.Raise vbObjectError + 9061, "ReconcileManagedFormRowsCore", "An authoritative generated-form MAC row is not classified as generated."
        If CountRowsIfTableExists(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_FormDefinitions"), SQL_FIELD_FORM_OBJECT_NAME & " IN (" & generatedNameList & ") AND (Nz([" & FIELD_CATALOG_OWNER & "]," & SharedDao_SqlQuote(DEFAULT_CATALOG_OWNER_GENERATED) & ")<>" & SharedDao_SqlQuote(DEFAULT_CATALOG_OWNER_GENERATED) & " OR Nz(" & SQL_FIELD_IS_GENERATED_BY_UTILITY & ",False)<>True)") <> 0 Then Err.Raise vbObjectError + 9064, "ReconcileManagedFormRowsCore", "An authoritative generated UI_Frm_Registry row is not classified as generated."
    End If
    If Len(persistentNameList) > 0 Then
        If CountRowsIfTableExists(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), SQL_FIELD_OBJECT_NAME & " IN (" & persistentNameList & ") AND Nz([" & FIELD_CATALOG_OWNER & "]," & SharedDao_SqlQuote(DEFAULT_CATALOG_OWNER_PERSISTENT_GENERATED) & ")<>" & SharedDao_SqlQuote(DEFAULT_CATALOG_OWNER_PERSISTENT_GENERATED)) <> 0 Then Err.Raise vbObjectError + 9066, "ReconcileManagedFormRowsCore", "An authoritative persistent generated-form MAC row is not classified as PersistentGenerated."
        If CountRowsIfTableExists(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_FormDefinitions"), SQL_FIELD_FORM_OBJECT_NAME & " IN (" & persistentNameList & ") AND (Nz([" & FIELD_CATALOG_OWNER & "]," & SharedDao_SqlQuote(DEFAULT_CATALOG_OWNER_PERSISTENT_GENERATED) & ")<>" & SharedDao_SqlQuote(DEFAULT_CATALOG_OWNER_PERSISTENT_GENERATED) & " OR Nz(" & SQL_FIELD_IS_GENERATED_BY_UTILITY & ",False)<>True)") <> 0 Then Err.Raise vbObjectError + 9067, "ReconcileManagedFormRowsCore", "An authoritative persistent generated UI_Frm_Registry row is not classified as PersistentGenerated."
    End If
    If Len(userNameList) > 0 Then
        If CountRowsIfTableExists(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), SQL_FIELD_OBJECT_NAME & " IN (" & userNameList & ") AND Nz([" & FIELD_CATALOG_OWNER & "]," & SharedDao_SqlQuote(DEFAULT_CATALOG_OWNER_USER) & ")<>" & SharedDao_SqlQuote(DEFAULT_CATALOG_OWNER_USER)) <> 0 Then Err.Raise vbObjectError + 9062, "ReconcileManagedFormRowsCore", "An authoritative " & DEFAULT_UTILITY_SHORT_NAME & "-prefixed user-form MAC row is not classified as user-owned."
        If CountRowsIfTableExists(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_FormDefinitions"), SQL_FIELD_FORM_OBJECT_NAME & " IN (" & userNameList & ") AND (Nz([" & FIELD_CATALOG_OWNER & "]," & SharedDao_SqlQuote(DEFAULT_CATALOG_OWNER_USER) & ")<>" & SharedDao_SqlQuote(DEFAULT_CATALOG_OWNER_USER) & " OR Nz(" & SQL_FIELD_IS_GENERATED_BY_UTILITY & ",False)<>False)") <> 0 Then Err.Raise vbObjectError + 9065, "ReconcileManagedFormRowsCore", "An authoritative " & DEFAULT_UTILITY_SHORT_NAME & "-prefixed user UI_Frm_Registry row is not classified as user-owned."
    End If
    If Len(staleIDList) > 0 Then
        If CountRowsIfTableExists(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), SQL_FIELD_ID & " IN (" & staleIDList & ")") <> 0 Then Err.Raise vbObjectError + 9055, "ReconcileManagedFormRowsCore", "Stale MAC rows remain after managed-form reconciliation."
        If CountRowsIfTableExists(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads"), ManagedObjectIDWhereText(staleIDList, "[" & FIELD_MANAGED_OBJECT_ID & "]")) <> 0 Then Err.Raise vbObjectError + 9033, "ReconcileManagedFormRowsCore", "Stale MAC_ActionPayloads form rows remain after reconciliation."
        If CountRowsIfTableExists(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies"), ManagedObjectDependencyWhereText(staleIDList)) <> 0 Then Err.Raise vbObjectError + 9034, "ReconcileManagedFormRowsCore", "Stale MAC_Deps form rows remain after reconciliation."
    End If
    If dependencyAuditManagedIDs.count > 0 Then ValidateDuplicateManagedFormMetadata db, dependencyAuditManagedIDs
    CorePulseProgress "Managed-form reconciliation verification complete; committing the reconciliation transaction."
    If callerOwnsTransaction = False Then
        ws.CommitTrans
        transactionStarted = False
    End If
    reconciliationSummary = "Canonical existing rows selected by ownership tier: SystemDefault=" & CStr(canonicalSystemDefaultCount) & "; Generated=" & CStr(canonicalGeneratedCount) & "; Other=" & CStr(canonicalOtherCount) & "." & vbCrLf
    reconciliationSummary = reconciliationSummary & "Compatible incoming dependencies checked=" & CStr(compatibleIncomingDependencyCheckedCount) & "; already correct=" & CStr(compatibleIncomingDependencyAlreadyCorrectCount) & "; actually updated=" & CStr(compatibleIncomingDependencyUpdatedCount) & "." & vbCrLf
    reconciliationSummary = reconciliationSummary & "Incompatible active incoming dependencies deactivated: " & CStr(incompatibleIncomingDependencyDeactivatedCount) & "." & vbCrLf
    reconciliationSummary = reconciliationSummary & "Inactive incompatible incoming dependencies left unchanged: " & CStr(inactiveIncompatibleIncomingDependencyCount) & "." & vbCrLf
    reconciliationSummary = reconciliationSummary & "Duplicate dependency references redirected: incoming=" & CStr(duplicateIncomingDependencyRedirectedCount) & "; outgoing=" & CStr(duplicateOutgoingDependencyRedirectedCount) & "; exact duplicates removed=" & CStr(exactDependencyDuplicateRemovedCount) & "." & vbCrLf
    reconciliationSummary = reconciliationSummary & "Duplicate action payloads moved=" & CStr(duplicatePayloadMovedCount) & "; safely merged=" & CStr(duplicatePayloadMergedCount) & "." & vbCrLf
    reconciliationSummary = reconciliationSummary & "Duplicate managed rows removed: " & CStr(duplicateRemovedCount) & "." & vbCrLf
    reconciliationSummary = reconciliationSummary & "Noncurrent ordinary generated UI_Frm_Registry rows deleted: " & CStr(deletedNoncurrentGeneratedDefinitionCount) & "." & vbCrLf & "Stale Discovered User UI_Frm_Registry rows deleted: " & CStr(deletedNoncurrentDiscoveredUserDefinitionCount) & "." & vbCrLf
    traceDetail = "Removed stale or duplicate managed rows: " & CStr(removedCount) & vbCrLf & "Wrong-type rows normalized safely: " & CStr(normalizedFormTypeCount) & vbCrLf & "Generated, persistent-generated, and Discovered User rows processed: " & CStr(addedOrUpdatedCount) & vbCrLf & reconciliationSummary
    operationNote = "Managed-form reconciliation audit: canonical SystemDefault=" & CStr(canonicalSystemDefaultCount) & "; Generated=" & CStr(canonicalGeneratedCount) & "; Other=" & CStr(canonicalOtherCount) & "; compatible dependencies checked=" & CStr(compatibleIncomingDependencyCheckedCount) & "; already correct=" & CStr(compatibleIncomingDependencyAlreadyCorrectCount) & "; updated=" & CStr(compatibleIncomingDependencyUpdatedCount) & "; duplicate incoming redirected=" & CStr(duplicateIncomingDependencyRedirectedCount) & "; duplicate outgoing redirected=" & CStr(duplicateOutgoingDependencyRedirectedCount) & "; payloads moved=" & CStr(duplicatePayloadMovedCount) & "; payloads merged=" & CStr(duplicatePayloadMergedCount) & "; duplicate rows removed=" & CStr(duplicateRemovedCount) & "; noncurrent generated UI_Frm_Registry deleted=" & CStr(deletedNoncurrentGeneratedDefinitionCount) & _
                "; stale discovered-user UI_Frm_Registry deleted=" & CStr(deletedNoncurrentDiscoveredUserDefinitionCount) & _
        "."
    If callerOwnsTransaction = False Then CoreAddOperationNote operationNote
    LogTraceMessage TRACE_LEVEL_INFO, "ADC_ManagedObjects", "ReconcileManagedFormRowsCore", "Managed form membership reconciled.", traceDetail, "Reconcile managed forms", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "Table", "CodeDb", "ManagedForms"
    CorePulseProgress "Managed-form reconciliation completed."
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    If managedDefinitionBatchStarted Or mManagedDefinitionBatchActive Then EndManagedDefinitionBatch False, "D4 full reconciliation post-mutation authoritative Form defaulting"
    managedDefinitionBatchStarted = False
    On Error GoTo 0
    If callerOwnsTransaction = False And transactionStarted Then
        RollbackCatalogWorkspaceOrRaise ws, "ReconcileManagedFormRowsCore", savedErrNumber, savedErrSource, savedErrDescription
        transactionStarted = False
    End If
    Err.Raise savedErrNumber, "ReconcileManagedFormRowsCore", "Could not reconcile authoritative generated/persistent-generated/Discovered User managed form membership." & vbCrLf & "Stage: " & reconciliationStage & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription & IIf(Len(rollbackFailureText) > 0, vbCrLf & rollbackFailureText, vbNullString)
End Sub

Private Function FormCompatibleDependencyTypeSqlList() As String
    FormCompatibleDependencyTypeSqlList = "''" & "," & SharedDao_SqlQuote(UCase$(ADCAT_DEPENDENCY_TYPE_CATALOG_OBJECT)) & "," & SharedDao_SqlQuote(UCase$(ADCAT_DEPENDENCY_TYPE_ACCESS_OBJECT))
End Function

Private Sub ReconcileIncomingFormDependencies(ByVal db As DAO.Database, ByVal auditedIDList As String, ByRef compatibleCheckedCount As Long, ByRef compatibleAlreadyCorrectCount As Long, ByRef compatibleUpdatedCount As Long, ByRef incompatibleDeactivatedCount As Long, ByRef inactiveIncompatibleCount As Long)
    'The current physical Form identity is authoritative. Reconcile dependency metadata after managed-form type normalization; this is current catalog repair, not historical object-type migration.
    'Audits Form-compatible incoming dependencies, updates only actual mismatches, deactivates incompatible active rows, and reports unchanged rows separately.
    Dim notePrefix As String
    Dim compatibleWhere As String
    Dim activeIncompatibleWhere As String
    Dim sqlText As String
    auditedIDList = Trim$(auditedIDList)
    compatibleCheckedCount = 0
    compatibleAlreadyCorrectCount = 0
    compatibleUpdatedCount = 0
    incompatibleDeactivatedCount = 0
    inactiveIncompatibleCount = 0
    If Len(auditedIDList) = 0 Then Exit Sub
    compatibleWhere = "d.[" & FIELD_DEPENDS_ON_MANAGED_OBJECT_ID & "] IN (" & auditedIDList & ") AND UCase(Trim(Nz(d.[" & FIELD_DEPENDENCY_TYPE & "],''))) In (" & FormCompatibleDependencyTypeSqlList() & ")"
    sqlText = "SELECT Count(*) AS " & SQL_FIELD_ROW_COUNT & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies") & "] AS d INNER JOIN [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] AS m ON d.[" & FIELD_DEPENDS_ON_MANAGED_OBJECT_ID & "]=m." & SQL_FIELD_ID & " WHERE " & compatibleWhere & ";"
    compatibleCheckedCount = ManagedFormAuditCount(db, sqlText)
    sqlText = "SELECT Count(*) AS " & SQL_FIELD_ROW_COUNT & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies") & "] AS d INNER JOIN [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] AS m ON d.[" & FIELD_DEPENDS_ON_MANAGED_OBJECT_ID & "]=m." & SQL_FIELD_ID & " WHERE " & compatibleWhere & " AND Nz(d.[" & FIELD_DEPENDENCY_NAME & "],'')=Nz(m." & SQL_FIELD_OBJECT_NAME & ",'') AND UCase(Trim(Nz(d.[" & FIELD_DEPENDENCY_OBJECT_TYPE & "],'')))='FORM';"
    compatibleAlreadyCorrectCount = ManagedFormAuditCount(db, sqlText)
    db.Execute "UPDATE [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies") & "] AS d INNER JOIN [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] AS m ON d.[" & FIELD_DEPENDS_ON_MANAGED_OBJECT_ID & "]=m." & SQL_FIELD_ID & " SET d.[" & FIELD_DEPENDENCY_NAME & "]=m." & SQL_FIELD_OBJECT_NAME & ",d.[" & FIELD_DEPENDENCY_OBJECT_TYPE & "]=" & SharedDao_SqlQuote(ADCAT_OBJECT_TYPE_FORM) & " WHERE " & compatibleWhere & " AND (Nz(d.[" & FIELD_DEPENDENCY_NAME & "],'')<>Nz(m." & SQL_FIELD_OBJECT_NAME & ",'') OR UCase(Trim(Nz(d.[" & FIELD_DEPENDENCY_OBJECT_TYPE & "],'')))<>'FORM');", dbFailOnError
    compatibleUpdatedCount = db.RecordsAffected
    inactiveIncompatibleCount = CountRowsIfTableExists(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies"), "[" & FIELD_DEPENDS_ON_MANAGED_OBJECT_ID & "] IN (" & auditedIDList & ") AND UCase(Trim(Nz([" & FIELD_MANAGED_OBJECT_DEPENDENCY_STATUS & "],''))) Not In (''," & SharedDao_SqlQuote(UCase$(ADCAT_STATUS_ACTIVE)) & ") AND UCase(Trim(Nz([" & FIELD_DEPENDENCY_TYPE & "],''))) Not In (" & FormCompatibleDependencyTypeSqlList() & ")")
    notePrefix = "Deactivated automatically because the referenced managed object is an authoritative Form and this dependency type is not Form-compatible. Previous dependency name="
    activeIncompatibleWhere = "[" & FIELD_DEPENDS_ON_MANAGED_OBJECT_ID & "] IN (" & auditedIDList & ") AND (Len(Trim(Nz(" & SQL_FIELD_MANAGED_OBJECT_DEPENDENCY_STATUS & ",'')))=0 OR UCase(Trim(Nz(" & SQL_FIELD_MANAGED_OBJECT_DEPENDENCY_STATUS & ",'')))=" & SharedDao_SqlQuote(UCase$(ADCAT_STATUS_ACTIVE)) & ") AND UCase(Trim(Nz([" & FIELD_DEPENDENCY_TYPE & "],''))) Not In (" & FormCompatibleDependencyTypeSqlList() & ")"
    db.Execute "UPDATE [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies") & "] SET [" & FIELD_MANAGED_OBJECT_DEPENDENCY_STATUS & "]='Inactive',[" & FIELD_MANAGED_OBJECT_DEPENDENCY_NOTES & "]=IIf(Len(Trim(Nz([" & FIELD_MANAGED_OBJECT_DEPENDENCY_NOTES & "],'')))=0,'',[" & FIELD_MANAGED_OBJECT_DEPENDENCY_NOTES & "] & ' | ') & " & SharedDao_SqlQuote(notePrefix) & " & IIf(Len(Trim(Nz([" & FIELD_DEPENDENCY_NAME & "],'')))=0,'(blank)',[" & FIELD_DEPENDENCY_NAME & "]) & '; previous object type=' & IIf(Len(Trim(Nz([" & FIELD_DEPENDENCY_OBJECT_TYPE & "],'')))=0,'(blank)',[" & FIELD_DEPENDENCY_OBJECT_TYPE & "]) & '.' WHERE " & activeIncompatibleWhere & ";", dbFailOnError
    incompatibleDeactivatedCount = db.RecordsAffected
    If compatibleCheckedCount <> compatibleAlreadyCorrectCount + compatibleUpdatedCount Then Err.Raise vbObjectError + 9092, "ReconcileIncomingFormDependencies", "Compatible dependency audit counters do not reconcile." & vbCrLf & "Checked: " & CStr(compatibleCheckedCount) & vbCrLf & "Already correct: " & CStr(compatibleAlreadyCorrectCount) & vbCrLf & "Updated: " & CStr(compatibleUpdatedCount)
End Sub

Private Sub ValidateDuplicateManagedFormMetadata(ByVal db As DAO.Database, ByVal canonicalIDs As Collection)
    'Verifies that canonical rows have at most one action payload per kind after duplicate-row reconciliation.
    Dim rs As DAO.Recordset
    Dim canonicalIDList As String
    Dim sqlText As String
    canonicalIDList = LongCollectionList(canonicalIDs)
    If Len(canonicalIDList) = 0 Then Exit Sub
    If SharedDao_DatabaseTableExistsSafe(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads")) Then
        sqlText = "SELECT [" & FIELD_MANAGED_OBJECT_ID & "],Nz([" & FIELD_PAYLOAD_KIND & "],'') AS " & SQL_FIELD_PAYLOAD_KIND_VALUE & ",Count(*) AS " & SQL_FIELD_ROW_COUNT & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads") & "] WHERE [" & FIELD_MANAGED_OBJECT_ID & "] IN (" & canonicalIDList & ") GROUP BY [" & FIELD_MANAGED_OBJECT_ID & "],Nz([" & FIELD_PAYLOAD_KIND & "],'') HAVING Count(*)>1;"
        Set rs = db.OpenRecordset(sqlText, dbOpenSnapshot)
        If rs.EOF = False Then Err.Raise vbObjectError + 9096, "ValidateDuplicateManagedFormMetadata", "A canonical managed-form row retains multiple action payloads with the same PayloadKind." & vbCrLf & "ManagedObjectID: " & CStr(CLng(rs!managedObjectID)) & vbCrLf & "PayloadKind: " & IIf(Len(CStr(rs.fields(FIELD_PAYLOAD_KIND_VALUE))) = 0, "(blank)", CStr(rs.fields(FIELD_PAYLOAD_KIND_VALUE))) & vbCrLf & "Rows: " & CStr(CLng(rs!rowCount))
        rs.Close
        Set rs = Nothing
    End If
End Sub

Private Function ManagedMacroDescriptionCache() As Object
    On Error GoTo ReturnEmpty
    Dim cache As Object
    Dim rs As DAO.Recordset
    Dim objectName As String
    Dim usesSharedRecordset As Boolean
    ' INTENTIONAL KEYED LOOKUP: cache provides keyed membership/lookup over source rows or state already read by ManagedMacroDescriptionCache; it is a derived access path, not a second authority.
    Set cache = CreateObject("Scripting.Dictionary")
    cache.CompareMode = vbTextCompare
    If mManagedDefinitionBatchActive Then
        Set rs = mManagedDefinitionBatchManagedRs
        usesSharedRecordset = True
        If Not (rs.BOF And rs.EOF) Then rs.MoveFirst
    Else
        If CodeDbTableExists(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID)) = False Then GoTo ReturnCache
        Set rs = ResolveCatalogDb().OpenRecordset("SELECT " & SQL_FIELD_OBJECT_NAME & "," & SQL_FIELD_OBJECT_DESCRIPTION & "," & SQL_FIELD_OBJECT_TYPE & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] ORDER BY " & SQL_FIELD_ID & ";", dbOpenSnapshot)
    End If
    Do While Not rs.EOF
        PumpSetupResponsiveness
        If StrComp(Trim$(CStr(Nz(rs.fields(FIELD_OBJECT_TYPE).value, vbNullString))), ADCAT_OBJECT_TYPE_MACRO, vbTextCompare) = 0 Then
            objectName = CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString))
            If Len(objectName) > 0 Then
                If cache.Exists(objectName) = False Then cache.Add objectName, CStr(Nz(rs.fields(FIELD_OBJECT_DESCRIPTION).value, vbNullString))
            End If
        End If
        rs.MoveNext
    Loop
    If usesSharedRecordset = False Then rs.Close
ReturnCache:
    Set ManagedMacroDescriptionCache = cache
    Exit Function
ReturnEmpty:
    On Error Resume Next
    If Not rs Is Nothing And usesSharedRecordset = False Then rs.Close
    If cache Is Nothing Then
        ' INTENTIONAL KEYED LOOKUP: cache provides keyed membership/lookup over source rows or state already read by ManagedMacroDescriptionCache; it is a derived access path, not a second authority.
        Set cache = CreateObject("Scripting.Dictionary")
        cache.CompareMode = vbTextCompare
    End If
    Set ManagedMacroDescriptionCache = cache
End Function

' Purpose: Performs ordered table select list by coordinating `ResolveCatalogDb` and `SharedDao_BracketName` while preserving this module's existing validation and error semantics.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   tableName (Input; String): Physical Access table name identifying the table whose schema, data, or metadata the routine processes.
'   tableAlias (Input Optional; String): SQL/table alias used when qualifying fields or constructing the query expression; blank uses the routine’s unaliased/default form. Default: vbNullString.
' Returns: String: Returns the resolved ordered table select list text in the canonical representation consumed by this module's caller; vbNullString represents no applicable value where the existing contract
'   permits it.
Public Function OrderedTableSelectList(ByVal tableName As String, Optional ByVal tableAlias As String = vbNullString) As String
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim tdf As DAO.tableDef
    Dim fld As DAO.Field
    Dim resultText As String
    Dim prefixText As String
    Set db = ResolveCatalogDb()
    Set tdf = db.TableDefs(tableName)
    tdf.fields.Refresh
    If Len(Trim$(tableAlias)) > 0 Then prefixText = SharedDao_BracketName(tableAlias) & "."
    For Each fld In tdf.fields
        PumpSetupResponsiveness
        If Len(resultText) > 0 Then resultText = resultText & ", "
        resultText = resultText & prefixText & SharedDao_BracketName(fld.Name)
    Next fld
    OrderedTableSelectList = resultText
    Exit Function
ErrHandler:
    Dim originalErrNumber As Long
    Dim originalErrDescription As String
    originalErrNumber = Err.Number
    originalErrDescription = Err.Description
    Err.Raise originalErrNumber, "OrderedTableSelectList", "Could not build the authoritative ordered SELECT list for a managed table." & vbCrLf & "Table: " & tableName & vbCrLf & "Alias: " & tableAlias & vbCrLf & "Description: " & originalErrDescription
End Function

Private Sub ResolvePart8FamilyTableNames(ByRef lookupTableNames As Variant, ByRef coreTableNames As Variant, ByRef macroClassificationTableNames As Variant, ByRef systemMacroTableNames As Variant, ByRef helpDocumentTableNames As Variant, ByRef structuralFamilyCount As Long)
    'Intended use: Materializes all B1 table-family arrays from one canonical Defaults registry pass for the lifetime of one B1 structural operation.
    Dim lookupNames As Collection
    Dim coreNames As Collection
    Dim macroClassificationNames As Collection
    Dim systemMacroNames As Collection
    Dim helpDocumentNames As Collection
    ResolveB1TableFamilies lookupNames, coreNames, macroClassificationNames, systemMacroNames, helpDocumentNames, structuralFamilyCount
    lookupTableNames = Part8ManagedObjectFamilyTableNames(lookupNames)
    coreTableNames = Part8ManagedObjectFamilyTableNames(coreNames)
    macroClassificationTableNames = Part8ManagedObjectFamilyTableNames(macroClassificationNames)
    systemMacroTableNames = Part8ManagedObjectFamilyTableNames(systemMacroNames)
    helpDocumentTableNames = Part8ManagedObjectFamilyTableNames(helpDocumentNames)
End Sub

Private Function Part8TableHeaderText(ByVal db As DAO.Database, ByVal tableName As String, ByRef tableWasFound As Boolean) As String
    On Error GoTo MissingTable
    Dim tdf As DAO.tableDef
    Set tdf = db.TableDefs(tableName)
    tableWasFound = True
    Part8TableHeaderText = UCase$(tableName) & Chr$(30) & CStr(tdf.Attributes) & Chr$(30) & Part8DateToken(tdf.LastUpdated) & Chr$(30) & CStr(Nz(tdf.Connect, vbNullString)) & Chr$(30) & CStr(Nz(tdf.sourceTableName, vbNullString))
    Exit Function
MissingTable:
    Err.Clear
    tableWasFound = False
    Part8TableHeaderText = UCase$(tableName) & Chr$(30) & "<missing>"
End Function

