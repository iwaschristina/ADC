Private Function CatalogTableIndexDefinitions(ByVal tableName As String, Optional ByVal lookupDefinitionIndex As Variant) As Collection
    'Single physical index-schema authority for Catalog-owned B1 tables.
    ' CANONICAL AUTHORITY: rows owns the in-memory definition set constructed by CatalogTableIndexDefinitions; downstream consumers derive views from this set rather than create a competing authority.
    Dim rows As New Collection
    Dim codeFieldName As String
    Dim displayFieldName As String
    Dim isSimpleLookup As Boolean
    Select Case tableName
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_NavigationPaneGroups")
            rows.Add Array(INDEX_PRIMARY_KEY, FIELD_ID, True, True)
            rows.Add Array(INDEX_UX_NAVIGATION_PANE_GROUP_KEY, FIELD_NAVIGATION_PANE_GROUP_KEY, True, False)
            rows.Add Array(INDEX_IX_NAVIGATION_PANE_GROUP_NAME, FIELD_NAVIGATION_PANE_GROUP_NAME, False, False)
            rows.Add Array(INDEX_IX_NAVIGATION_PANE_GROUP_SETTING_KEY, FIELD_SETTING_KEY, True, False)
            rows.Add Array(INDEX_IX_NAVIGATION_PANE_GROUP_RIBBON_TAB_KEY, FIELD_RIBBON_TAB_KEY, False, False)
            rows.Add Array(INDEX_IX_NAVIGATION_PANE_GROUP_RIBBON_GROUP_SORT_ORDER, FIELD_RIBBON_GROUP_SORT_ORDER, False, False)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_FormDefinitions")
            rows.Add Array(INDEX_PRIMARY_KEY, FIELD_ID, True, True)
            rows.Add Array(INDEX_UX_FORM_OBJECT_NAME, FIELD_FORM_OBJECT_NAME, True, False)
            rows.Add Array(INDEX_IX_FORM_TYPE, FIELD_FORM_TYPE, False, False)
            rows.Add Array(INDEX_IX_FORM_NAVIGATION_PANE_GROUP_KEY, FIELD_NAVIGATION_PANE_GROUP_KEY, False, False)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_RIBBON_BUTTON_TARGETS_TABLE_LOGICAL_ID)
            rows.Add Array(INDEX_PRIMARY_KEY, FIELD_ID, True, True)
            rows.Add Array(INDEX_UX_RIBBON_BUTTON_TARGETS_RIBBON_BUTTON, FIELD_RIBBON_NAME & "|" & FIELD_BUTTON_KEY, True, False)
            rows.Add Array(INDEX_IX_RIBBON_BUTTON_TARGETS_RIBBON_NAME, FIELD_RIBBON_NAME, False, False)
            rows.Add Array(INDEX_IX_RIBBON_BUTTON_TARGETS_BUTTON_KEY, FIELD_BUTTON_KEY, False, False)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros")
            rows.Add Array(INDEX_PRIMARY_KEY, FIELD_ID, True, True)
            rows.Add Array(INDEX_UX_SYSTEM_MACRO_KEY, FIELD_SYSTEM_MACRO_KEY, True, False)
            rows.Add Array(INDEX_IX_SYSTEM_MACRO_DESIGNATOR, FIELD_SYSTEM_MACRO_DESIGNATOR, False, False)
            rows.Add Array(INDEX_IX_RUN_CODE_WRAPPER_NAME, FIELD_RUN_CODE_WRAPPER_NAME, False, False)
            rows.Add Array(INDEX_IX_SYSTEM_MACRO_GROUP_KEY, FIELD_SYSTEM_MACRO_GROUP_KEY, False, False)
            rows.Add Array(INDEX_IX_SYSTEM_MACRO_CATEGORY_KEY, FIELD_MACRO_CATEGORY_KEY, False, False)
            rows.Add Array(INDEX_IX_SYSTEM_MACRO_SUBCATEGORY_KEY, FIELD_MACRO_SUBCATEGORY_KEY, False, False)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HelpDocuments")
            rows.Add Array(INDEX_PRIMARY_KEY, FIELD_ID, True, True)
            rows.Add Array(INDEX_UX_HELP_DOCUMENT_KEY, FIELD_HELP_DOCUMENT_KEY, True, False)
            rows.Add Array(INDEX_IX_HELP_DOCUMENT_NUMBER, FIELD_HELP_DOCUMENT_NUMBER, False, False)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ObjectCategories")
            rows.Add Array(INDEX_PRIMARY_KEY, FIELD_ID, True, True)
            rows.Add Array(INDEX_UX_CATEGORY_CODE, FIELD_CATEGORY_CODE, True, False)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECT_OVERRIDES_TABLE_LOGICAL_ID)
            rows.Add Array(INDEX_PRIMARY_KEY, FIELD_MANAGED_OBJECT_ID, True, True)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID)
            rows.Add Array(INDEX_PRIMARY_KEY, FIELD_ID, True, True)
            rows.Add Array(INDEX_UX_MANAGED_OBJECTS_OBJECT_NAME_TYPE, FIELD_OBJECT_NAME & "|" & FIELD_OBJECT_TYPE, True, False)
            rows.Add Array(INDEX_UX_MANAGED_OBJECTS_RIBBON_STATIC_TAG, FIELD_RIBBON_STATIC_TAG, True, False)
            rows.Add Array(INDEX_IX_CATEGORY_CODE, FIELD_CATEGORY_CODE, False, False)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads")
            rows.Add Array(INDEX_PRIMARY_KEY, FIELD_ID, True, True)
            rows.Add Array(INDEX_UX_MANAGED_OBJECT_ACTION_PAYLOADS_OBJECT_KIND, FIELD_MANAGED_OBJECT_ID & "|" & FIELD_PAYLOAD_KIND, True, False)
            rows.Add Array(INDEX_IX_MANAGED_OBJECT_ID, FIELD_MANAGED_OBJECT_ID, False, False)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies")
            rows.Add Array(INDEX_PRIMARY_KEY, FIELD_ID, True, True)
            rows.Add Array(INDEX_IX_DEPENDENCY_MANAGED_OBJECT_ID, FIELD_MANAGED_OBJECT_ID, False, False)
            rows.Add Array(INDEX_IX_DEPENDS_ON_MANAGED_OBJECT_ID, FIELD_DEPENDS_ON_MANAGED_OBJECT_ID, False, False)
            'Inactive dependency rows are retained and skipped by validation, so B1 intentionally does not impose an all-row six-field unique index; active dependency identity is enforced procedurally.
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectFields")
            rows.Add Array(INDEX_PRIMARY_KEY, FIELD_ID, True, True)
            rows.Add Array(INDEX_UX_MANAGED_OBJECT_FIELDS_OBJECT_FIELD_NAME, FIELD_MANAGED_OBJECT_ID & "|" & FIELD_MANAGED_OBJECT_FIELD_NAME, True, False, True)
            rows.Add Array(INDEX_IX_MANAGED_OBJECT_FIELDS_OBJECT, FIELD_MANAGED_OBJECT_ID, False, False)
            rows.Add Array(INDEX_IX_MANAGED_OBJECT_FIELDS_NAME, FIELD_MANAGED_OBJECT_FIELD_NAME, False, False)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectFieldValues")
            rows.Add Array(INDEX_PRIMARY_KEY, FIELD_ID, True, True)
            rows.Add Array(INDEX_UX_MANAGED_OBJECT_FIELD_VALUES_FIELD_STORED_VALUE, FIELD_MANAGED_OBJECT_FIELD_VALUE_MANAGED_OBJECT_FIELD_ID & "|" & FIELD_MANAGED_OBJECT_FIELD_VALUE_STORED_VALUE, True, False, True)
            rows.Add Array(INDEX_IX_MANAGED_OBJECT_FIELD_VALUES_FIELD, FIELD_MANAGED_OBJECT_FIELD_VALUE_MANAGED_OBJECT_FIELD_ID, False, False)
        Case Else
            If isMissing(lookupDefinitionIndex) Then
                isSimpleLookup = CatalogSimpleLookupFieldNames(tableName, codeFieldName, displayFieldName)
            Else
                isSimpleLookup = CatalogSimpleLookupFieldNames(tableName, codeFieldName, displayFieldName, lookupDefinitionIndex)
            End If
            If isSimpleLookup Then
                rows.Add Array(INDEX_PRIMARY_KEY, FIELD_ID, True, True)
                rows.Add Array(INDEX_PREFIX_UNIQUE_2 & Left$(codeFieldName, 48), codeFieldName, True, False)
            End If
    End Select
    Set CatalogTableIndexDefinitions = rows
End Function

Private Sub ApplyCatalogFieldContract(ByVal fld As DAO.Field, ByVal fieldDefinition As Variant, ByVal tableName As String)
    On Error GoTo ErrHandler
    Dim fld2 As DAO.Field2
    If UBound(fieldDefinition) >= 4 Then If IsNull(fieldDefinition(4)) = False Then If fld.Required <> CBool(fieldDefinition(4)) Then fld.Required = CBool(fieldDefinition(4))
    If UBound(fieldDefinition) >= 5 Then
        If IsNull(fieldDefinition(5)) = False And (fld.Type = dbText Or fld.Type = dbMemo) Then If fld.allowZeroLength <> CBool(fieldDefinition(5)) Then fld.allowZeroLength = CBool(fieldDefinition(5))
    End If
    If UBound(fieldDefinition) >= 6 Then If IsNull(fieldDefinition(6)) = False Then If StrComp(CStr(Nz(fld.DefaultValue, vbNullString)), CStr(fieldDefinition(6)), vbBinaryCompare) <> 0 Then fld.DefaultValue = CStr(fieldDefinition(6))
    If UBound(fieldDefinition) >= 7 Then If IsNull(fieldDefinition(7)) = False Then If StrComp(CStr(Nz(fld.validationRule, vbNullString)), CStr(fieldDefinition(7)), vbBinaryCompare) <> 0 Then fld.validationRule = CStr(fieldDefinition(7))
    If UBound(fieldDefinition) >= 8 Then If IsNull(fieldDefinition(8)) = False Then If StrComp(CStr(Nz(fld.validationText, vbNullString)), CStr(fieldDefinition(8)), vbBinaryCompare) <> 0 Then fld.validationText = CStr(fieldDefinition(8))
    If UBound(fieldDefinition) >= 9 Then
        If IsNull(fieldDefinition(9)) = False Then
            Set fld2 = fld
            If StrComp(CStr(fld2.expression), CStr(fieldDefinition(9)), vbBinaryCompare) <> 0 Then fld2.expression = CStr(fieldDefinition(9))
        End If
    End If
    Exit Sub
ErrHandler:
    Err.Raise Err.Number, "ApplyCatalogFieldContract", "Could not enforce the canonical Catalog field contract." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fld.Name & vbCrLf & "Err.Description: " & Err.Description
End Sub

Private Function CatalogFieldContractMatches(ByVal fld As DAO.Field, ByVal fieldDefinition As Variant) As Boolean
    Dim fld2 As DAO.Field2
    If UBound(fieldDefinition) >= 4 Then If IsNull(fieldDefinition(4)) = False Then If fld.Required <> CBool(fieldDefinition(4)) Then Exit Function
    If UBound(fieldDefinition) >= 5 Then If IsNull(fieldDefinition(5)) = False And (fld.Type = dbText Or fld.Type = dbMemo) Then If fld.allowZeroLength <> CBool(fieldDefinition(5)) Then Exit Function
    If UBound(fieldDefinition) >= 6 Then If IsNull(fieldDefinition(6)) = False Then If StrComp(CStr(Nz(fld.DefaultValue, vbNullString)), CStr(fieldDefinition(6)), vbBinaryCompare) <> 0 Then Exit Function
    If UBound(fieldDefinition) >= 7 Then If IsNull(fieldDefinition(7)) = False Then If StrComp(CStr(Nz(fld.validationRule, vbNullString)), CStr(fieldDefinition(7)), vbBinaryCompare) <> 0 Then Exit Function
    If UBound(fieldDefinition) >= 8 Then If IsNull(fieldDefinition(8)) = False Then If StrComp(CStr(Nz(fld.validationText, vbNullString)), CStr(fieldDefinition(8)), vbBinaryCompare) <> 0 Then Exit Function
    If UBound(fieldDefinition) >= 9 Then
        If IsNull(fieldDefinition(9)) = False Then
            On Error GoTo ExpressionMismatch
            Set fld2 = fld
            If StrComp(CStr(fld2.expression), CStr(fieldDefinition(9)), vbBinaryCompare) <> 0 Then Exit Function
            On Error GoTo 0
        End If
    End If
    CatalogFieldContractMatches = True
    Exit Function
ExpressionMismatch:
    CatalogFieldContractMatches = False
End Function

Private Function CatalogIndexMatchesDefinition(ByVal tdf As DAO.tableDef, ByVal indexDefinition As Variant) As Boolean
    On Error GoTo ExitHere
    Dim idx As DAO.index
    Dim fieldNames As Variant
    Dim i As Long
    Set idx = Nothing
    On Error Resume Next
    Set idx = tdf.Indexes(CStr(indexDefinition(0)))
    On Error GoTo ExitHere
    If idx Is Nothing Then Exit Function
    fieldNames = Split(CStr(indexDefinition(1)), "|")
    If idx.fields.count <> UBound(fieldNames) - LBound(fieldNames) + 1 Then Exit Function
    If CBool(idx.Unique) <> CBool(indexDefinition(2)) Then Exit Function
    If CBool(idx.Primary) <> CBool(indexDefinition(3)) Then Exit Function
    If UBound(indexDefinition) >= 4 Then If CBool(idx.IgnoreNulls) <> CBool(indexDefinition(4)) Then Exit Function
    For i = LBound(fieldNames) To UBound(fieldNames)
        If StrComp(idx.fields(i - LBound(fieldNames)).Name, CStr(fieldNames(i)), vbTextCompare) <> 0 Then Exit Function
    Next i
    CatalogIndexMatchesDefinition = True
ExitHere:
End Function

Private Sub EnsureCatalogIndexDefinition(ByVal db As DAO.Database, ByVal tableName As String, ByVal indexDefinition As Variant)
    Dim fieldNames As Variant
    Dim fieldName As Variant
    Dim tdf As DAO.tableDef
    Dim idx As DAO.index
    If InStr(1, CStr(indexDefinition(1)), "|", vbBinaryCompare) = 0 Then
        EnsureSingleFieldIndex db, tableName, CStr(indexDefinition(0)), CStr(indexDefinition(1)), CBool(indexDefinition(2)), CBool(indexDefinition(3)), mCatalogDesignBatchPrepared
        Exit Sub
    End If
    Set tdf = db.TableDefs(tableName)
    tdf.Indexes.Refresh
    If CatalogIndexMatchesDefinition(tdf, indexDefinition) Then Exit Sub
    If mCatalogDesignBatchPrepared = False Then
        If SharedAccess_PrepareOpenObjectForDesignChange(acTable, tableName, "creating or repairing composite index [" & CStr(indexDefinition(0)) & "] on table [" & tableName & "]") = False Then
            MarkSystemCommandCancelled
            Err.Raise vbObjectError + 9445, "EnsureCatalogIndexDefinition", "Composite Catalog index repair was cancelled because the affected table was not approved for save and close."
        End If
        Set db = ResolveCatalogDb()
        Set tdf = db.TableDefs(tableName)
        tdf.Indexes.Refresh
    End If
    On Error Resume Next
    Err.Clear
    tdf.Indexes.Delete CStr(indexDefinition(0))
    Err.Clear
    On Error GoTo 0
    Set idx = tdf.CreateIndex(CStr(indexDefinition(0)))
    idx.Unique = CBool(indexDefinition(2))
    idx.Primary = CBool(indexDefinition(3))
    If UBound(indexDefinition) >= 4 Then idx.IgnoreNulls = CBool(indexDefinition(4))
    fieldNames = Split(CStr(indexDefinition(1)), "|")
    For Each fieldName In fieldNames
        If SharedDao_TableDefFieldExistsSafe(tdf, CStr(fieldName)) = False Then Err.Raise vbObjectError + 9446, "EnsureCatalogIndexDefinition", "A canonical composite-index field is missing." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & CStr(fieldName)
        idx.fields.Append idx.CreateField(CStr(fieldName))
    Next fieldName
    tdf.Indexes.Append idx
    tdf.Indexes.Refresh
    If CatalogIndexMatchesDefinition(tdf, indexDefinition) = False Then Err.Raise vbObjectError + 9447, "EnsureCatalogIndexDefinition", "The canonical composite index did not match after repair." & vbCrLf & "Table: " & tableName & vbCrLf & "Index: " & CStr(indexDefinition(0))
End Sub

Private Sub EnsureCatalogIndexesFromSchema(ByVal tableName As String, Optional ByVal canonicalDefinitions As Variant, Optional ByVal lookupDefinitionIndex As Variant)
    Dim db As DAO.Database
    Dim definitions As Collection
    Dim indexDefinition As Variant
    If B1ColdCreatedStructuralProofAvailable(tableName) Then
        RecordB1ColdCreateStructuralBypass tableName
        Exit Sub
    End If
    Set db = ResolveCatalogDb()
    If StrComp(tableName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_NavigationPaneGroups"), vbTextCompare) = 0 Then
        db.Execute "UPDATE [" & tableName & "] SET [" & FIELD_SETTING_KEY & "]=Null WHERE [" & FIELD_SETTING_KEY & "] Is Not Null AND Len(Trim([" & FIELD_SETTING_KEY & "]))=0;", dbFailOnError
    End If
    If IsObject(canonicalDefinitions) Then Set definitions = canonicalDefinitions
    If definitions Is Nothing Then
        If isMissing(lookupDefinitionIndex) Then
            Set definitions = CatalogTableIndexDefinitions(tableName)
        Else
            Set definitions = CatalogTableIndexDefinitions(tableName, lookupDefinitionIndex)
        End If
    End If
    If definitions.count = 0 Then Err.Raise vbObjectError + 9431, "EnsureCatalogIndexesFromSchema", "No Catalog-owned index definition exists for the requested table." & vbCrLf & "Table: " & tableName
    For Each indexDefinition In definitions
        EnsureCatalogIndexDefinition db, tableName, indexDefinition
    Next indexDefinition
End Sub

Private Function CatalogCanonicalColdCreateSupported(ByVal fieldDefinitions As Collection, ByVal indexDefinitions As Collection) As Boolean
    If fieldDefinitions Is Nothing Then Exit Function
    If indexDefinitions Is Nothing Then Exit Function
    CatalogCanonicalColdCreateSupported = (fieldDefinitions.count > 0 And indexDefinitions.count > 0)
End Function

Private Sub EnsureCatalogFieldsFromSchema(ByVal tableName As String, Optional ByVal canonicalDefinitions As Variant, Optional ByVal lookupDefinitionIndex As Variant)
    Dim definitions As Collection
    Dim fieldDefinition As Variant
    If B1ColdCreatedStructuralProofAvailable(tableName) Then
        RecordB1ColdCreateStructuralBypass tableName
        Exit Sub
    End If
    If IsObject(canonicalDefinitions) Then Set definitions = canonicalDefinitions
    If definitions Is Nothing Then
        If isMissing(lookupDefinitionIndex) Then
            Set definitions = CatalogTableSchemaDefinitions(tableName)
        Else
            Set definitions = CatalogTableSchemaDefinitions(tableName, lookupDefinitionIndex)
        End If
    End If
    If definitions.count = 0 Then Err.Raise vbObjectError + 9430, "EnsureCatalogFieldsFromSchema", "No Catalog-owned schema definition exists for the requested table." & vbCrLf & "Table: " & tableName
    For Each fieldDefinition In definitions
        EnsureCatalogField tableName, CStr(fieldDefinition(0)), CLng(fieldDefinition(1)), CLng(fieldDefinition(2)), CBool(fieldDefinition(3)), fieldDefinition
    Next fieldDefinition
End Sub

Private Sub ClearLookupEditorMetadataFromField(ByVal fld As DAO.Field, ByVal tableName As String, ByVal fieldName As String)
    On Error GoTo ErrHandler
    RequireSetupDomainMutationAllowed SETUP_DOMAIN_D4_LOOKUP_EDITOR_BINDING, "ClearLookupEditorMetadataFromField"
    Dim diagnosticContext As String
    Dim deleteErrNumber As Long
    Dim deleteErrSource As String
    Dim deleteErrDescription As String
    Dim verifyErrNumber As Long
    Dim verifyErrSource As String
    Dim verifyErrDescription As String
    Dim verificationProperty As DAO.Property
    fieldName = Trim$(fieldName)
    diagnosticContext = "Table: " & tableName & vbCrLf & "Field: " & fieldName
    Call EnsureDaoPropertyValue(fld, "AllowValueListEdits", dbBoolean, False, "ClearLookupEditorMetadataFromField", diagnosticContext)
    On Error Resume Next
    Err.Clear
    fld.properties.Delete "ListItemsEditForm"
    deleteErrNumber = Err.Number
    deleteErrSource = Err.Source
    deleteErrDescription = Err.Description
    Err.Clear
    On Error GoTo ErrHandler
    If deleteErrNumber <> 0 And deleteErrNumber <> 3265 And deleteErrNumber <> 3270 Then Err.Raise deleteErrNumber, deleteErrSource, deleteErrDescription
    fld.properties.Refresh
    On Error Resume Next
    Err.Clear
    Set verificationProperty = fld.properties("ListItemsEditForm")
    verifyErrNumber = Err.Number
    verifyErrSource = Err.Source
    verifyErrDescription = Err.Description
    Err.Clear
    On Error GoTo ErrHandler
    If verifyErrNumber = 0 Then Err.Raise vbObjectError + 9598, "ClearLookupEditorMetadataFromField", "ListItemsEditForm remained present after the no-editor metadata state was applied."
    If verifyErrNumber <> 3265 And verifyErrNumber <> 3270 Then Err.Raise verifyErrNumber, verifyErrSource, verifyErrDescription
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    Err.Raise savedErrNumber, "ClearLookupEditorMetadataFromField", "Could not clear and verify lookup-editor metadata." & vbCrLf & "Table: " & IIf(Len(tableName) = 0, "(not supplied)", tableName) & vbCrLf & "Field: " & IIf(Len(fieldName) = 0, "(not supplied)", fieldName) & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Sub

Private Sub ApplyLookupEditorMetadataToField(ByVal fld As DAO.Field, ByVal lookupTableName As String, ByVal tableName As String, ByVal fieldName As String)
    RequireSetupDomainMutationAllowed SETUP_DOMAIN_D4_LOOKUP_EDITOR_BINDING, "ApplyLookupEditorMetadataToField"
    Dim policyCode As String
    Dim editorFormName As String
    Dim editorAvailable As Boolean
    Dim diagnosticContext As String
    fieldName = Trim$(fieldName)
    diagnosticContext = "Table: " & tableName & vbCrLf & "Field: " & fieldName
    editorFormName = LookupEditorPhysicalFormNameForSource(lookupTableName, policyCode)
    If Len(Trim$(editorFormName)) = 0 Or StrComp(policyCode, LOOKUP_EDITOR_POLICY_NONE, vbTextCompare) = 0 Then
        ClearLookupEditorMetadataFromField fld, tableName, fieldName
        Exit Sub
    End If
    editorAvailable = SharedDao_AccessObjectExists(ResolveCatalogDb(), acForm, editorFormName)
    If editorAvailable Then
        Call EnsureDaoPropertyValue(fld, "AllowValueListEdits", dbBoolean, True, "ApplyLookupEditorMetadataToField", diagnosticContext)
        Call EnsureDaoPropertyValue(fld, "ListItemsEditForm", dbText, editorFormName, "ApplyLookupEditorMetadataToField", diagnosticContext)
    Else
        ClearLookupEditorMetadataFromField fld, tableName, fieldName
    End If
End Sub

Private Function EnsureCatalogLookupField(ByVal tdf As DAO.tableDef, ByVal fieldName As String, ByVal lookupTableName As String, ByVal codeFieldName As String, ByVal displayFieldName As String, ByVal LimitToList As Boolean, ByVal columnWidthsText As String) As Boolean
    On Error GoTo ErrHandler
    Dim fld As DAO.Field
    Dim rowSourceText As String
    If SharedDao_TableDefFieldExistsSafe(tdf, fieldName) = False Then Exit Function
    codeFieldName = Trim$(codeFieldName)
    displayFieldName = Trim$(displayFieldName)
    columnWidthsText = Trim$(columnWidthsText)
    If Len(columnWidthsText) = 0 Then columnWidthsText = "0;2"
    columnWidthsText = NormalizeLookupColumnWidthsForAccess(columnWidthsText, 2, 1, LimitToList)
    If Len(lookupTableName) = 0 Then Exit Function
    If Len(codeFieldName) = 0 Then Exit Function
    If Len(displayFieldName) = 0 Then Exit Function
    If CodeDbTableExists(lookupTableName) = False Then
        CoreAddOperationNote "Skipped lookup metadata because lookup table is not available. Table=" & tdf.Name & "; Field=" & fieldName & "; LookupTable=" & lookupTableName & "."
        Exit Function
    End If
    If TableFieldExists(lookupTableName, codeFieldName) = False Then
        CoreAddOperationNote "Skipped lookup metadata because lookup code field is missing. Table=" & tdf.Name & "; Field=" & fieldName & "; LookupTable=" & lookupTableName & "; CodeField=" & codeFieldName & "."
        Exit Function
    End If
    If TableFieldExists(lookupTableName, displayFieldName) = False Then
        CoreAddOperationNote "Skipped lookup metadata because lookup display field is missing. Table=" & tdf.Name & "; Field=" & fieldName & "; LookupTable=" & lookupTableName & "; DisplayField=" & displayFieldName & "."
        Exit Function
    End If
    Set fld = tdf.fields(fieldName)
    rowSourceText = TableLookupRowSource(lookupTableName, codeFieldName, displayFieldName, TableFieldExists(lookupTableName, FIELD_LOOKUP_ACTIVE), StrComp(codeFieldName, FIELD_SETTING_KEY, vbTextCompare) = 0, TableFieldExists(lookupTableName, FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER))
    Call ApplyLookupFieldProperties(fld, "Table/Query", rowSourceText, LimitToList, 2, 1, columnWidthsText, "EnsureCatalogLookupField", vbObjectError + 7750, vbObjectError + 7751)
    'Outside numbered Setup, preserve the established runtime/manual full lookup-maintenance behavior. During numbered Setup, B2 stops at presentation/intent and D4 owns the physical editor link.
    If SetupDomainMutationWritesAllowedForCurrentPart(SETUP_DOMAIN_D4_LOOKUP_EDITOR_BINDING) Then ApplyLookupEditorMetadataToField fld, lookupTableName, tdf.Name, fieldName
    EnsureCatalogLookupField = True
    Exit Function
ErrHandler:
    CoreAddOperationNote "Skipped lookup metadata after Access rejected the lookup property update. Table=" & SafeDaoTableDefName(tdf) & "; Field=" & fieldName & "; LookupTable=" & lookupTableName & "; Error=" & CStr(Err.Number) & " - " & Err.Description
    Err.Clear
End Function

Private Function BuildManagedTableFieldDescriptionShortIndex(ByVal db As DAO.Database) As Object
    On Error GoTo ErrHandler
    Dim descriptionIndex As Object
    Dim rs As DAO.Recordset
    Dim sqlText As String
    Dim tableName As String
    Dim fieldName As String
    Dim descriptionText As String
    Dim identityKey As String
    Set descriptionIndex = CreateObject("Scripting.Dictionary")
    descriptionIndex.CompareMode = vbTextCompare
    sqlText = "SELECT o." & SQL_FIELD_OBJECT_NAME & ",f.[" & FIELD_MANAGED_OBJECT_FIELD_NAME & "],f.[" & FIELD_MANAGED_OBJECT_FIELD_DESCRIPTION_SHORT & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectFields") & "] AS f INNER JOIN [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] AS o ON f.[" & FIELD_MANAGED_OBJECT_ID & "]=o." & SQL_FIELD_ID & " WHERE Nz(f.[" & FIELD_MANAGED_OBJECT_FIELD_IS_ACTIVE & "],False)<>False AND Nz(o.[" & FIELD_MANAGED_OBJECT_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND UCase(Trim(Nz(o." & SQL_FIELD_OBJECT_TYPE & ",'')))='TABLE' ORDER BY o." & SQL_FIELD_OBJECT_NAME & ",f.[" & FIELD_MANAGED_OBJECT_FIELD_NAME & "];"
    Set rs = db.OpenRecordset(sqlText, dbOpenSnapshot)
    Do While rs.EOF = False
        PumpSetupResponsiveness
        tableName = CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString))
        fieldName = Trim$(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_FIELD_NAME).value, vbNullString)))
        descriptionText = CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_FIELD_DESCRIPTION_SHORT).value, vbNullString))
        If Len(tableName) > 0 And Len(fieldName) > 0 Then
            identityKey = tableName & "|" & fieldName
            If descriptionIndex.Exists(identityKey) Then Err.Raise vbObjectError + 9640, "BuildManagedTableFieldDescriptionShortIndex", "Duplicate active MAC_Fields description identity." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName
            descriptionIndex.Add identityKey, descriptionText
        End If
        rs.MoveNext
    Loop
    rs.Close
    Set rs = Nothing
    Set BuildManagedTableFieldDescriptionShortIndex = descriptionIndex
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    Err.Raise savedErrNumber, "BuildManagedTableFieldDescriptionShortIndex", "Could not build the authoritative MAC_Fields.FieldDescriptionShort index." & vbCrLf & savedErrDescription
End Function

Private Function ResolveManagedTableFieldDescriptionShort(ByVal tableName As String, ByVal fieldName As String, ByVal descriptionShortIndex As Object, Optional ByRef resolutionSource As Variant, Optional ByVal allowDefaultDescriptionFallback As Boolean = False) As String
    Dim identityKey As String
    If Not isMissing(resolutionSource) Then resolutionSource = vbNullString
    identityKey = tableName & "|" & Trim$(fieldName)
    If Not descriptionShortIndex Is Nothing Then
        If descriptionShortIndex.Exists(identityKey) Then
            ResolveManagedTableFieldDescriptionShort = CStr(descriptionShortIndex(identityKey))
            If Not isMissing(resolutionSource) Then resolutionSource = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectFields") & "." & FIELD_MANAGED_OBJECT_FIELD_DESCRIPTION_SHORT
            Exit Function
        End If
    End If
    If allowDefaultDescriptionFallback Then
        ResolveManagedTableFieldDescriptionShort = ManagedObjectCatalogFieldDescriptionShort(tableName, fieldName, resolutionSource)
        If Len(Trim$(ResolveManagedTableFieldDescriptionShort)) > 0 Then Exit Function
    End If
    If StrComp(tableName, DB_TABLE_USYS_RIBBONS, vbTextCompare) = 0 Then
        ResolveManagedTableFieldDescriptionShort = RibbonTableFieldDescription(fieldName)
        If Not isMissing(resolutionSource) Then resolutionSource = "RibbonTableFieldDescription (USysRibbons is Access-owned and has no MAC_Fields row)"
    End If
End Function

' Purpose: Applies and verifies authoritative field Descriptions for one managed table during an authorized standalone repair operation.
' Public role: Inter-module public API used by runtime table/query repair after the Managed Object Catalog and MAC_Fields metadata are structurally ready. Numbered Setup continues to defer these writes to G1.
' Parameters:
'   tableName (Input; String): Physical managed-table name whose fields must be reconciled against authoritative FieldDescriptionShort metadata.
'   descriptionChangeCount (Output/in-out Optional; Variant): Receives the number of field Description properties created or repaired for this table.
'   detailText (Output/in-out Optional; String): Receives concise verification detail for diagnostics and operation summaries.
'   allowDefaultSeedDescriptionsWhenCatalogUnavailable (Input Optional; Boolean): True permits canonical Defaults seed descriptions only when MAC_Fields does not yet exist, preserving cold-start TABLES
'   repair. If MAC_Fields exists, its persisted FieldDescriptionShort mappings remain authoritative. Default: False.
' Returns: Boolean: True when every physical field on the managed table has an exact authoritative Description; errors are raised for missing managed definitions, missing tables, missing metadata, or
'   disallowed writes.
Public Function ApplyAndVerifyManagedTableFieldDescriptionsForStandaloneRepair(ByVal tableName As String, Optional ByRef descriptionChangeCount As Variant, Optional ByRef detailText As String = vbNullString, Optional ByVal allowDefaultSeedDescriptionsWhenCatalogUnavailable As Boolean = False) As Boolean
    'Standalone maintenance reuses the same per-table field Description reconciler as G1 without running the full G1 aggregate pass or touching unmanaged USysRibbons.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim definitionData As Variant
    Dim descriptionShortIndex As Object
    Dim managedObjectFieldsTableName As String
    Dim useDefaultSeedDescriptions As Boolean
    Dim fieldsInspected As Variant
    Dim descriptionsAlreadyCorrect As Variant
    Dim descriptionsCreated As Variant
    Dim descriptionsRepaired As Variant
    Dim verifiedProof As Variant
    Dim proofReused As Variant
    Dim changedCount As Long
    If Not isMissing(descriptionChangeCount) Then descriptionChangeCount = CLng(0)
    detailText = vbNullString
    If Len(tableName) = 0 Then Err.Raise vbObjectError + 10105, "ApplyAndVerifyManagedTableFieldDescriptionsForStandaloneRepair", "A managed standalone field-description repair requires a table name."
    If SetupDomainMutationWritesAllowedForCurrentPart(SETUP_DOMAIN_G1_DESCRIPTIONS) = False Then Err.Raise vbObjectError + 10106, "ApplyAndVerifyManagedTableFieldDescriptionsForStandaloneRepair", "Managed field Description mutation is deferred to G1 during numbered Setup."
    If TryGetManagedObjectDefinition(tableName, ADCAT_OBJECT_TYPE_TABLE, definitionData) = False Then Err.Raise vbObjectError + 10107, "ApplyAndVerifyManagedTableFieldDescriptionsForStandaloneRepair", "The requested table is not a canonical managed table." & vbCrLf & "Table: " & tableName
    Set db = ResolveCatalogDb()
    If SharedDao_DatabaseTableExistsSafe(db, tableName) = False Then Err.Raise vbObjectError + 10108, "ApplyAndVerifyManagedTableFieldDescriptionsForStandaloneRepair", "The managed table is missing after standalone structural repair." & vbCrLf & "Table: " & tableName
    managedObjectFieldsTableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectFields")
    If SharedDao_DatabaseTableExistsSafe(db, managedObjectFieldsTableName) Then
        Set descriptionShortIndex = BuildManagedTableFieldDescriptionShortIndex(db)
    ElseIf allowDefaultSeedDescriptionsWhenCatalogUnavailable Then
        useDefaultSeedDescriptions = True
    Else
        Set descriptionShortIndex = BuildManagedTableFieldDescriptionShortIndex(db)
    End If
    EnsureCatalogFieldDescriptions tableName, descriptionShortIndex, fieldsInspected, descriptionsAlreadyCorrect, descriptionsCreated, descriptionsRepaired, verifiedProof, proofReused, allowProofReuse:=False, allowDefaultDescriptionFallback:=useDefaultSeedDescriptions
    changedCount = CLng(Nz(descriptionsCreated, 0)) + CLng(Nz(descriptionsRepaired, 0))
    If Not isMissing(descriptionChangeCount) Then descriptionChangeCount = changedCount
    detailText = "Managed table field descriptions exact: " & tableName & _
                 " | Fields inspected=" & CStr(CLng(Nz(fieldsInspected, 0))) & _
                 " | Created=" & CStr(CLng(Nz(descriptionsCreated, 0))) & _
                 " | Repaired=" & CStr(CLng(Nz(descriptionsRepaired, 0))) & _
                 " | Authority=" & IIf(useDefaultSeedDescriptions, "Defaults seed (MAC_Fields unavailable)", "MAC_Fields.FieldDescriptionShort") & _
                 " | Proof reused=" & CStr(CBool(Nz(proofReused, False)))
    ApplyAndVerifyManagedTableFieldDescriptionsForStandaloneRepair = True
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    detailText = "Standalone managed-table field-description reconciliation failed for [" & tableName & "]. Error " & CStr(savedErrNumber) & " from " & savedErrSource & ": " & savedErrDescription
    If IsCancellationError(savedErrNumber) Then Err.Raise savedErrNumber, savedErrSource, savedErrDescription
    Err.Raise savedErrNumber, "ApplyAndVerifyManagedTableFieldDescriptionsForStandaloneRepair", detailText
End Function

Private Sub EnsureCatalogFieldDescriptions(ByVal tableName As String, ByVal descriptionShortIndex As Object, Optional ByRef fieldsInspected As Variant, Optional ByRef descriptionsAlreadyCorrect As Variant, Optional ByRef descriptionsCreated As Variant, Optional ByRef descriptionsRepaired As Variant, Optional ByRef verifiedProof As Variant, Optional ByRef proofReused As Variant, Optional ByVal readOnlyVerify As Boolean = False, Optional ByVal allowProofReuse As Boolean = True, Optional ByVal allowDefaultDescriptionFallback As Boolean = False)
    If readOnlyVerify = False Then
        If SetupDomainMutationWritesAllowedForCurrentPart(SETUP_DOMAIN_G1_DESCRIPTIONS) = False Then Err.Raise vbObjectError + 9622, "EnsureCatalogFieldDescriptions", "Managed DAO field Description mutation is owned exclusively by Setup G1." & vbCrLf & "Table: " & tableName
    End If
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim tdf As DAO.tableDef
    Dim fld As DAO.Field
    Dim descriptionText As String
    Dim fieldName As String
    Dim currentDescription As String
    Dim currentPropertyType As Long
    Dim propertyExists As Boolean
    Dim resolutionSource As Variant
    Dim defaultDescriptionSource As Variant
    Dim defaultDescriptionText As String
    Dim failureSourceName As String
    Dim coverageIssue As String
    Dim fieldCount As Long
    Dim physicallyInspectedFieldCount As Long
    Dim missingDescriptionCount As Long
    Dim placeholderDescriptionCount As Long
    Dim proofHeader As String
    Dim storedProof As String
    Dim completedProof As String
    Dim proofPropertyName As String
    Dim physicalResultText As String
    Dim canonicalFieldOrderText As String
    Dim fieldNames As Variant
    Dim fieldNameValue As Variant
    Dim physicalFieldIndex As Long
    If Not isMissing(verifiedProof) Then verifiedProof = vbNullString
    If Not isMissing(proofReused) Then proofReused = False
    Set db = ResolveCatalogDb()
    Set tdf = db.TableDefs(tableName)
    proofHeader = FieldDescriptionProofText(tdf, descriptionShortIndex, fieldCount, canonicalFieldOrderText, allowDefaultDescriptionFallback)
    InitializeFieldDescriptionProofCache
    proofPropertyName = FieldDescriptionProofPropertyName(tdf.Name)
    If allowProofReuse Then
        If TryFieldDescriptionSameRunProof(tableName, completedProof, fieldCount, proofHeader) Then
            If Not isMissing(verifiedProof) Then verifiedProof = completedProof
            If Not isMissing(proofReused) Then proofReused = True
            Exit Sub
        End If
        If mFieldDescriptionProofCache.Exists(proofPropertyName) Then
            storedProof = CStr(mFieldDescriptionProofCache(proofPropertyName))
            If FieldDescriptionProofMatchesHeader(storedProof, proofHeader) Then
                PublishFieldDescriptionSameRunProof tdf.Name, storedProof, fieldCount
                If Not isMissing(verifiedProof) Then verifiedProof = storedProof
                If Not isMissing(proofReused) Then proofReused = True
                Exit Sub
            End If
        End If
    End If
    If Len(canonicalFieldOrderText) > 0 Then
        fieldNames = Split(canonicalFieldOrderText, "|")
    Else
        ReDim fieldNames(0 To tdf.fields.count - 1)
        For physicalFieldIndex = 0 To tdf.fields.count - 1
            fieldNames(physicalFieldIndex) = tdf.fields(physicalFieldIndex).Name
        Next physicalFieldIndex
    End If
    For Each fieldNameValue In fieldNames
        PumpSetupResponsiveness
        fieldName = CStr(fieldNameValue)
        Set fld = tdf.fields(fieldName)
        resolutionSource = vbNullString
        descriptionText = ResolveManagedTableFieldDescriptionShort(tdf.Name, fieldName, descriptionShortIndex, resolutionSource, allowDefaultDescriptionFallback)
        If Len(Trim$(descriptionText)) = 0 Then
            missingDescriptionCount = missingDescriptionCount + 1
            If StrComp(tdf.Name, DB_TABLE_USYS_RIBBONS, vbTextCompare) = 0 Then
                coverageIssue = "No authoritative USysRibbons short field description exists."
            Else
                coverageIssue = "No active MAC_Fields.FieldDescriptionShort mapping exists, or the mapped value is blank."
            End If
            Err.Raise vbObjectError + 6710, "EnsureCatalogFieldDescriptions", coverageIssue
        End If
        If Len(descriptionText) > 255 Then
            failureSourceName = CStr(resolutionSource)
            If InStr(1, failureSourceName, FIELD_MANAGED_OBJECT_FIELD_DESCRIPTION_SHORT, vbTextCompare) > 0 Then
                defaultDescriptionSource = vbNullString
                defaultDescriptionText = ManagedObjectCatalogFieldDescriptionShort(tdf.Name, fieldName, defaultDescriptionSource)
                If Len(defaultDescriptionText) > 0 And StrComp(defaultDescriptionText, descriptionText, vbBinaryCompare) = 0 And Len(Trim$(CStr(defaultDescriptionSource))) > 0 Then
                    failureSourceName = CStr(defaultDescriptionSource)
                Else
                    failureSourceName = "(not applicable; persisted MAC_Fields.FieldDescriptionShort does not match the current DEFAULTS default)"
                End If
            End If
            coverageIssue = "MAC_Fields.FieldDescriptionShort exceeds the 255-character Access DAO Field.Description limit. Shorten this value manually before G1 can apply it." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName & vbCrLf & "Characters: " & CStr(Len(descriptionText)) & vbCrLf & "Default/value source: " & IIf(Len(Trim$(failureSourceName)) > 0, failureSourceName, "(not resolved)")
            Err.Raise vbObjectError + 9641, "EnsureCatalogFieldDescriptions", coverageIssue
        End If
        If FieldDescriptionTextIsPlaceholder(descriptionText) Then
            placeholderDescriptionCount = placeholderDescriptionCount + 1
            coverageIssue = "The authoritative field description is a placeholder or generic fallback."
            Err.Raise vbObjectError + 6710, "EnsureCatalogFieldDescriptions", coverageIssue
        End If
        physicallyInspectedFieldCount = physicallyInspectedFieldCount + 1
        If Not isMissing(fieldsInspected) Then fieldsInspected = CLng(Nz(fieldsInspected, 0)) + 1
        currentDescription = vbNullString
        currentPropertyType = 0
        propertyExists = False
        ReadDaoFieldDescriptionState fld, currentDescription, currentPropertyType, propertyExists
        If propertyExists And currentPropertyType = CLng(dbText) And StrComp(currentDescription, descriptionText, vbBinaryCompare) = 0 Then
            If Not isMissing(descriptionsAlreadyCorrect) Then descriptionsAlreadyCorrect = CLng(Nz(descriptionsAlreadyCorrect, 0)) + 1
        Else
            If readOnlyVerify Then
                Err.Raise vbObjectError + 6711, "EnsureCatalogFieldDescriptions", "The managed-table field Description is not current during read-only exact-state verification."
            End If
            If propertyExists Then
                If Not isMissing(descriptionsRepaired) Then descriptionsRepaired = CLng(Nz(descriptionsRepaired, 0)) + 1
            Else
                If Not isMissing(descriptionsCreated) Then descriptionsCreated = CLng(Nz(descriptionsCreated, 0)) + 1
            End If
            EnsureDaoFieldDescription fld, descriptionText, tdf.Name
            currentDescription = descriptionText
            currentPropertyType = CLng(dbText)
        End If
        physicalResultText = physicalResultText & LengthPrefixedVariant(fld.Name) & LengthPrefixedVariant(CStr(currentPropertyType)) & LengthPrefixedVariant(currentDescription)
    Next fieldNameValue
    Set tdf = db.TableDefs(tableName)
    proofHeader = FieldDescriptionProofText(tdf, descriptionShortIndex, fieldCount, canonicalFieldOrderText, allowDefaultDescriptionFallback)
    completedProof = CompletedFieldDescriptionProofText(proofHeader, physicalResultText)
    If readOnlyVerify = False Then
        Call EnsureDaoPropertyValue(db, proofPropertyName, dbText, completedProof, "EnsureCatalogFieldDescriptions")
        mFieldDescriptionProofCache(proofPropertyName) = completedProof
    End If
    PublishFieldDescriptionSameRunProof tdf.Name, completedProof, fieldCount
    If Not isMissing(verifiedProof) Then verifiedProof = completedProof
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    Dim technicalDetail As String
    Dim userIssue As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    technicalDetail = "Table: " & tableName & vbCrLf & "Field: " & IIf(Len(fieldName) = 0, "(not reached)", fieldName) & vbCrLf & "Authoritative source: " & IIf(Len(Trim$(CStr(resolutionSource))) = 0, "(none)", CStr(resolutionSource)) & vbCrLf & "Resolved description: " & descriptionText & vbCrLf & "Fields inspected: " & CStr(physicallyInspectedFieldCount) & vbCrLf & "Missing descriptions: " & CStr(missingDescriptionCount) & vbCrLf & "Placeholder descriptions: " & CStr(placeholderDescriptionCount) & vbCrLf & "Original Err.Number: " & CStr(savedErrNumber) & vbCrLf & "Original Err.Source: " & savedErrSource & vbCrLf & "Original Err.Description: " & savedErrDescription
    If readOnlyVerify = False Or savedErrNumber <> vbObjectError + 6711 Then LogTraceMessage TRACE_LEVEL_ERROR, "FieldDescriptions", "EnsureCatalogFieldDescriptions", "Catalog field-description proof or physical Description repair failed.", technicalDetail, "Resolve authoritative catalog field descriptions", savedErrNumber, savedErrSource, savedErrDescription, tableName, "Table", "CodeDb", "FieldDescriptions"
    userIssue = coverageIssue
    If Len(userIssue) = 0 Then userIssue = "The authoritative Access field Description property could not be applied and verified."
    Err.Raise savedErrNumber, "EnsureCatalogFieldDescriptions", tableName & "." & IIf(Len(fieldName) = 0, "(unknown field)", fieldName) & " could not be validated." & vbCrLf & userIssue
End Sub

Private Function CalculateCatalogOwnerProofSnapshotForSetup(ByVal completedPartIdentity As String, ByRef snapshot As CatalogDomainSnapshot) As Boolean
    'Calculates only the cumulative catalog fingerprint domains owned through B1-B4; B5 support-query state remains exclusively in the complete catalog snapshot.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim defaultsTables As Collection
    Dim item As Variant
    Dim defaultsState As CatalogHashState
    Dim nonHelpDefaultsState As CatalogHashState
    Dim helpDocumentsState As CatalogHashState
    Dim inventoryState As CatalogHashState
    Dim coreInventoryState As CatalogHashState
    Dim formsInventoryState As CatalogHashState
    Dim uiInventoryState As CatalogHashState
    Dim macroInventoryState As CatalogHashState
    Dim payloadState As CatalogHashState
    Dim corePayloadState As CatalogHashState
    Dim formsPayloadState As CatalogHashState
    Dim uiPayloadState As CatalogHashState
    Dim macroPayloadState As CatalogHashState
    completedPartIdentity = UCase$(Trim$(completedPartIdentity))
    Select Case completedPartIdentity
        Case "B1", "B2", "B3", "B4"
        Case Else
            Err.Raise vbObjectError + 10163, "CalculateCatalogOwnerProofSnapshotForSetup", "Catalog owner-proof snapshots are supported only for completed Parts B1-B4."
    End Select
    snapshot.failureDetail = vbNullString
    Set db = ResolveCatalogDb()
    db.TableDefs.Refresh
    db.Relations.Refresh
    If CalculateCatalogSchemaDomain(db, snapshot.SchemaFingerprint, snapshot.SchemaTableCount, snapshot.failureDetail, False) = False Then Exit Function
    If completedPartIdentity = "B1" Then
        CalculateCatalogOwnerProofSnapshotForSetup = True
        Exit Function
    End If
    Set defaultsTables = CatalogFastPathDefaultsTableNames()
    CatalogHashInitialize defaultsState
    CatalogHashAppendText defaultsState, FingerprintTokenPart(CatalogDomainSeed("Defaults"))
    CatalogHashInitialize nonHelpDefaultsState
    CatalogHashAppendText nonHelpDefaultsState, FingerprintTokenPart(CatalogDomainSeed("DefaultsNonHelp"))
    CatalogHashInitialize helpDocumentsState
    CatalogHashAppendText helpDocumentsState, FingerprintTokenPart(CatalogDomainSeed("DefaultsHelpDocuments"))
    For Each item In defaultsTables
        PumpSetupResponsiveness
        CatalogHashAppendDefaultsTableData db, CStr(item), defaultsState, nonHelpDefaultsState, helpDocumentsState, snapshot.failureDetail
        If Len(snapshot.failureDetail) > 0 Then Exit Function
        snapshot.DefaultsTableCount = snapshot.DefaultsTableCount + 1
    Next item
    snapshot.DefaultsFingerprint = CatalogHashToken(defaultsState)
    snapshot.NonHelpDefaultsFingerprint = CatalogHashToken(nonHelpDefaultsState)
    snapshot.HelpDocumentsFingerprint = CatalogHashToken(helpDocumentsState)
    If completedPartIdentity = "B2" Then
        CalculateCatalogOwnerProofSnapshotForSetup = True
        Exit Function
    End If
    CatalogHashInitialize inventoryState
    CatalogHashAppendText inventoryState, FingerprintTokenPart(CatalogDomainSeed("Inventory"))
    CatalogHashInitialize coreInventoryState
    CatalogHashAppendText coreInventoryState, FingerprintTokenPart(CatalogDomainSeed("InventoryCore"))
    CatalogHashInitialize formsInventoryState
    CatalogHashAppendText formsInventoryState, FingerprintTokenPart(CatalogDomainSeed("InventoryForms"))
    CatalogHashInitialize uiInventoryState
    CatalogHashAppendText uiInventoryState, FingerprintTokenPart(CatalogDomainSeed("InventoryUI"))
    CatalogHashInitialize macroInventoryState
    CatalogHashAppendText macroInventoryState, FingerprintTokenPart(CatalogDomainSeed("InventoryMacros"))
    CatalogHashAppendManagedObjectInventory db, inventoryState, coreInventoryState, formsInventoryState, uiInventoryState, macroInventoryState, snapshot.failureDetail
    If Len(snapshot.failureDetail) > 0 Then Exit Function
    snapshot.InventoryFingerprint = CatalogHashToken(inventoryState)
    snapshot.CoreInventoryFingerprint = CatalogHashToken(coreInventoryState)
    snapshot.FormsInventoryFingerprint = CatalogHashToken(formsInventoryState)
    snapshot.UiInventoryFingerprint = CatalogHashToken(uiInventoryState)
    snapshot.MacroInventoryFingerprint = CatalogHashToken(macroInventoryState)
    CatalogHashInitialize payloadState
    CatalogHashAppendText payloadState, FingerprintTokenPart(CatalogDomainSeed("Payloads"))
    CatalogHashInitialize corePayloadState
    CatalogHashAppendText corePayloadState, FingerprintTokenPart(CatalogDomainSeed("PayloadsCore"))
    CatalogHashInitialize formsPayloadState
    CatalogHashAppendText formsPayloadState, FingerprintTokenPart(CatalogDomainSeed("PayloadsForms"))
    CatalogHashInitialize uiPayloadState
    CatalogHashAppendText uiPayloadState, FingerprintTokenPart(CatalogDomainSeed("PayloadsUI"))
    CatalogHashInitialize macroPayloadState
    CatalogHashAppendText macroPayloadState, FingerprintTokenPart(CatalogDomainSeed("PayloadsMacros"))
    CatalogHashAppendManagedPayloads db, payloadState, corePayloadState, formsPayloadState, uiPayloadState, macroPayloadState, snapshot.failureDetail
    If Len(snapshot.failureDetail) > 0 Then Exit Function
    snapshot.PayloadFingerprint = CatalogHashToken(payloadState)
    snapshot.CorePayloadFingerprint = CatalogHashToken(corePayloadState)
    snapshot.FormsPayloadFingerprint = CatalogHashToken(formsPayloadState)
    snapshot.UiPayloadFingerprint = CatalogHashToken(uiPayloadState)
    snapshot.MacroPayloadFingerprint = CatalogHashToken(macroPayloadState)
    CalculateCatalogOwnerProofSnapshotForSetup = True
    Exit Function
ErrHandler:
    snapshot.failureDetail = "Could not calculate the phase-scoped catalog owner-proof snapshot through " & completedPartIdentity & ". Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
End Function

' Purpose: Checks whether catalog prerequisite already satisfies the exact state required by the current Setup run so the owning phase can determine whether repair is necessary.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   requestedPartIdentity (Input; String): Setup Part identity requested by the caller; it is resolved against the canonical implemented-part list before work proceeds.
'   detailText (Output; String): Receives diagnostic detail text used to explain validation, lookup, recovery, or failure results to the caller.
' Returns: Boolean: True when catalog prerequisite matches the exact state required by the current Setup contract; False when the owning phase still needs repair, refresh, or reconciliation.
Public Function CatalogPrerequisiteCurrentForSetup(ByVal requestedPartIdentity As String, ByRef detailText As String) As Boolean
    On Error GoTo NotCurrent
    Dim db As DAO.Database
    Dim snapshot As CatalogDomainSnapshot
    Dim storedSchema As String
    Dim storedDefaults As String
    Dim storedCoreInventory As String
    Dim storedUiInventory As String
    Dim storedMacroInventory As String
    Dim storedCorePayload As String
    Dim storedUiPayload As String
    Dim storedMacroPayload As String
    Dim storedQuery As String
    Dim storedLookupEditorPolicyProof As String
    Dim currentLookupEditorPolicyProof As String
    Dim lookupEditorPolicyProofExists As Boolean
    Dim lookupEditorPolicyMatches As Boolean
    Dim schemaExists As Boolean
    Dim defaultsExists As Boolean
    Dim coreInventoryExists As Boolean
    Dim uiInventoryExists As Boolean
    Dim macroInventoryExists As Boolean
    Dim corePayloadExists As Boolean
    Dim uiPayloadExists As Boolean
    Dim macroPayloadExists As Boolean
    Dim queryFingerprintExists As Boolean
    Dim schemaMatches As Boolean
    Dim defaultsMatches As Boolean
    Dim coreInventoryMatches As Boolean
    Dim uiInventoryMatches As Boolean
    Dim macroInventoryMatches As Boolean
    Dim corePayloadMatches As Boolean
    Dim uiPayloadMatches As Boolean
    Dim macroPayloadMatches As Boolean
    Dim queryMatches As Boolean
    Dim defaultsRequired As Boolean
    Dim coreUiDefinitionsRequired As Boolean
    Dim macroDefinitionsRequired As Boolean
    Dim queryFingerprintRequired As Boolean
    Dim lookupEditorPolicyRequired As Boolean
    Dim prerequisiteProofAvailable As Boolean
    Dim prerequisiteOk As Boolean
    requestedPartIdentity = UCase$(Trim$(requestedPartIdentity))
    detailText = vbNullString
    Set db = ResolveCatalogDb()
    storedSchema = DatabaseTextPropertyValue(db, CATALOG_SCHEMA_FINGERPRINT_PROPERTY, schemaExists)
    storedDefaults = DatabaseTextPropertyValue(db, CATALOG_DEFAULTS_FINGERPRINT_PROPERTY, defaultsExists)
    storedCoreInventory = DatabaseTextPropertyValue(db, CATALOG_CORE_INVENTORY_FINGERPRINT_PROPERTY, coreInventoryExists)
    storedUiInventory = DatabaseTextPropertyValue(db, CATALOG_UI_INVENTORY_FINGERPRINT_PROPERTY, uiInventoryExists)
    storedMacroInventory = DatabaseTextPropertyValue(db, CATALOG_MACRO_INVENTORY_FINGERPRINT_PROPERTY, macroInventoryExists)
    storedCorePayload = DatabaseTextPropertyValue(db, CATALOG_CORE_PAYLOAD_FINGERPRINT_PROPERTY, corePayloadExists)
    storedUiPayload = DatabaseTextPropertyValue(db, CATALOG_UI_PAYLOAD_FINGERPRINT_PROPERTY, uiPayloadExists)
    storedMacroPayload = DatabaseTextPropertyValue(db, CATALOG_MACRO_PAYLOAD_FINGERPRINT_PROPERTY, macroPayloadExists)
    storedQuery = DatabaseTextPropertyValue(db, CATALOG_QUERY_FINGERPRINT_PROPERTY, queryFingerprintExists)
    storedLookupEditorPolicyProof = DatabaseTextPropertyValue(db, B2_LOOKUP_EDITOR_POLICY_PROOF_PROPERTY, lookupEditorPolicyProofExists)
    Select Case requestedPartIdentity
        Case "B2"
            prerequisiteProofAvailable = schemaExists And Len(storedSchema) > 0
        Case "B3"
            defaultsRequired = True
            lookupEditorPolicyRequired = True
            prerequisiteProofAvailable = schemaExists And Len(storedSchema) > 0 And defaultsExists And Len(storedDefaults) > 0 And _
                                         lookupEditorPolicyProofExists And Len(storedLookupEditorPolicyProof) > 0
        Case "B4"
            defaultsRequired = True
            coreUiDefinitionsRequired = True
            lookupEditorPolicyRequired = True
            prerequisiteProofAvailable = schemaExists And Len(storedSchema) > 0 And defaultsExists And Len(storedDefaults) > 0 And _
                                         lookupEditorPolicyProofExists And Len(storedLookupEditorPolicyProof) > 0 And _
                                         coreInventoryExists And Len(storedCoreInventory) > 0 And uiInventoryExists And Len(storedUiInventory) > 0 And _
                                         corePayloadExists And Len(storedCorePayload) > 0 And uiPayloadExists And Len(storedUiPayload) > 0
        Case "B5"
            defaultsRequired = True
            coreUiDefinitionsRequired = True
            macroDefinitionsRequired = True
            lookupEditorPolicyRequired = True
            prerequisiteProofAvailable = schemaExists And Len(storedSchema) > 0 And defaultsExists And Len(storedDefaults) > 0 And _
                                         lookupEditorPolicyProofExists And Len(storedLookupEditorPolicyProof) > 0 And _
                                         coreInventoryExists And Len(storedCoreInventory) > 0 And uiInventoryExists And Len(storedUiInventory) > 0 And _
                                         macroInventoryExists And Len(storedMacroInventory) > 0 And corePayloadExists And Len(storedCorePayload) > 0 And _
                                         uiPayloadExists And Len(storedUiPayload) > 0 And macroPayloadExists And Len(storedMacroPayload) > 0
        Case "C1", "C2", "C3"
            defaultsRequired = True
            coreUiDefinitionsRequired = True
            macroDefinitionsRequired = True
            queryFingerprintRequired = True
            lookupEditorPolicyRequired = True
            prerequisiteProofAvailable = schemaExists And Len(storedSchema) > 0 And defaultsExists And Len(storedDefaults) > 0 And _
                                         lookupEditorPolicyProofExists And Len(storedLookupEditorPolicyProof) > 0 And _
                                         coreInventoryExists And Len(storedCoreInventory) > 0 And uiInventoryExists And Len(storedUiInventory) > 0 And _
                                         macroInventoryExists And Len(storedMacroInventory) > 0 And corePayloadExists And Len(storedCorePayload) > 0 And _
                                         uiPayloadExists And Len(storedUiPayload) > 0 And macroPayloadExists And Len(storedMacroPayload) > 0 And _
                                         queryFingerprintExists And Len(storedQuery) > 0
        Case Else
            Err.Raise vbObjectError + 9580, "CatalogPrerequisiteCurrentForSetup", "Unsupported requested Part identity: " & requestedPartIdentity
    End Select
    If prerequisiteProofAvailable = False Then
        detailText = "Requested Part=" & requestedPartIdentity & "; required persisted catalog proof is unavailable; broad current catalog snapshot and validation traversal skipped."
        Exit Function
    End If
    Select Case requestedPartIdentity
        Case "B2"
            If CalculateCatalogOwnerProofSnapshotForSetup("B1", snapshot) = False Then detailText = "Catalog prerequisite snapshot could not be calculated. " & snapshot.failureDetail: Exit Function
        Case "B3"
            If CalculateCatalogOwnerProofSnapshotForSetup("B2", snapshot) = False Then detailText = "Catalog prerequisite snapshot could not be calculated. " & snapshot.failureDetail: Exit Function
        Case "B4"
            If CalculateCatalogOwnerProofSnapshotForSetup("B3", snapshot) = False Then detailText = "Catalog prerequisite snapshot could not be calculated. " & snapshot.failureDetail: Exit Function
        Case "B5"
            If CalculateCatalogOwnerProofSnapshotForSetup("B4", snapshot) = False Then detailText = "Catalog prerequisite snapshot could not be calculated. " & snapshot.failureDetail: Exit Function
        Case "C1", "C2", "C3"
            If CalculateCatalogDomainSnapshot(snapshot) = False Then detailText = "Catalog prerequisite snapshot could not be calculated. " & snapshot.failureDetail: Exit Function
    End Select
    schemaMatches = schemaExists And StrComp(storedSchema, snapshot.SchemaFingerprint, vbBinaryCompare) = 0
    defaultsMatches = defaultsExists And StrComp(storedDefaults, snapshot.DefaultsFingerprint, vbBinaryCompare) = 0
    coreInventoryMatches = coreInventoryExists And StrComp(storedCoreInventory, snapshot.CoreInventoryFingerprint, vbBinaryCompare) = 0
    uiInventoryMatches = uiInventoryExists And StrComp(storedUiInventory, snapshot.UiInventoryFingerprint, vbBinaryCompare) = 0
    macroInventoryMatches = macroInventoryExists And StrComp(storedMacroInventory, snapshot.MacroInventoryFingerprint, vbBinaryCompare) = 0
    corePayloadMatches = corePayloadExists And StrComp(storedCorePayload, snapshot.CorePayloadFingerprint, vbBinaryCompare) = 0
    uiPayloadMatches = uiPayloadExists And StrComp(storedUiPayload, snapshot.UiPayloadFingerprint, vbBinaryCompare) = 0
    macroPayloadMatches = macroPayloadExists And StrComp(storedMacroPayload, snapshot.MacroPayloadFingerprint, vbBinaryCompare) = 0
    queryMatches = queryFingerprintExists And StrComp(storedQuery, snapshot.QueryFingerprint, vbBinaryCompare) = 0
    If requestedPartIdentity = "B2" Then
        lookupEditorPolicyMatches = True
    Else
        lookupEditorPolicyMatches = B2LookupEditorPolicyProofMatches(db, currentLookupEditorPolicyProof)
    End If
    Select Case requestedPartIdentity
        Case "B2"
            prerequisiteOk = schemaMatches
        Case "B3"
            prerequisiteOk = schemaMatches And defaultsMatches And lookupEditorPolicyMatches
        Case "B4"
            prerequisiteOk = schemaMatches And defaultsMatches And lookupEditorPolicyMatches And coreInventoryMatches And uiInventoryMatches And corePayloadMatches And uiPayloadMatches
            If prerequisiteOk Then
                ValidateNonFormManagedObjectRows db
                ValidateNonFormDependencies db
                ValidateManagedObjectPlacementDefinitionsForSetup False, False
            End If
        Case "B5"
            prerequisiteOk = schemaMatches And defaultsMatches And lookupEditorPolicyMatches And coreInventoryMatches And uiInventoryMatches And macroInventoryMatches And corePayloadMatches And uiPayloadMatches And macroPayloadMatches
            If prerequisiteOk Then
                ValidateNonFormManagedObjectRows db
                ValidateNonFormDependencies db
                ValidateManagedObjectPlacementDefinitionsForSetup False, False
                ValidateSystemHelpManagedDefinitions db, CoreSetupHelpDocumentSynchronizationScope()
            End If
        Case "C1", "C2", "C3"
            prerequisiteOk = schemaMatches And defaultsMatches And lookupEditorPolicyMatches And coreInventoryMatches And uiInventoryMatches And macroInventoryMatches And corePayloadMatches And uiPayloadMatches And macroPayloadMatches And queryMatches
            If prerequisiteOk Then
                ValidateNonFormManagedObjectRows db
                ValidateNonFormDependencies db
                ValidateManagedObjectPlacementDefinitionsForSetup True, False
                ValidateSystemHelpManagedDefinitions db, CoreSetupHelpDocumentSynchronizationScope()
                ValidateNonFormDatabaseReferenceFieldIndex db
            End If
    End Select
    CatalogPrerequisiteCurrentForSetup = prerequisiteOk
    detailText = "Requested Part=" & requestedPartIdentity & "; Schema=" & IIf(schemaMatches, "matched", IIf(schemaExists, "changed", "unseeded")) & _
                 "; Defaults=" & IIf(defaultsRequired, IIf(defaultsMatches, "matched", IIf(defaultsExists, "changed", "unseeded")), "not required") & _
                 "; CoreInventory=" & IIf(coreUiDefinitionsRequired, IIf(coreInventoryMatches, "matched", IIf(coreInventoryExists, "changed", "unseeded")), "not required") & _
                 "; UiInventory=" & IIf(coreUiDefinitionsRequired, IIf(uiInventoryMatches, "matched", IIf(uiInventoryExists, "changed", "unseeded")), "not required") & _
                 "; MacroInventory=" & IIf(macroDefinitionsRequired, IIf(macroInventoryMatches, "matched", IIf(macroInventoryExists, "changed", "unseeded")), "not required") & _
                 "; CorePayload=" & IIf(coreUiDefinitionsRequired, IIf(corePayloadMatches, "matched", IIf(corePayloadExists, "changed", "unseeded")), "not required") & _
                 "; UiPayload=" & IIf(coreUiDefinitionsRequired, IIf(uiPayloadMatches, "matched", IIf(uiPayloadExists, "changed", "unseeded")), "not required") & _
                 "; MacroPayload=" & IIf(macroDefinitionsRequired, IIf(macroPayloadMatches, "matched", IIf(macroPayloadExists, "changed", "unseeded")), "not required") & _
                 "; Queries=" & IIf(queryFingerprintRequired, IIf(queryMatches, "matched", IIf(queryFingerprintExists, "changed", "unseeded")), "not required") & _
                 "; B2LookupEditorPolicy=" & IIf(lookupEditorPolicyRequired, IIf(lookupEditorPolicyMatches, "matched", IIf(lookupEditorPolicyProofExists, "changed", "unseeded")), "not required") & "."
    Exit Function
NotCurrent:
    detailText = "Catalog predecessor verification failed for requested Part " & requestedPartIdentity & ". Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
End Function

' Purpose: Initializes catalog standalone part context for setup, coordinating `End` as the implementation requires.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   requestedPartIdentity (Input; String): Setup Part identity requested by the caller; it is resolved against the canonical implemented-part list before work proceeds.
' Returns: None (Sub). The procedure communicates its result through its database, UI, trace, or module-state side effects and raises errors where its implementation requires it.
Public Sub BeginCatalogStandalonePartContextForSetup(ByVal requestedPartIdentity As String)
    requestedPartIdentity = UCase$(Trim$(requestedPartIdentity))
    BeginCatalogSetupContext
    Select Case requestedPartIdentity
        Case "B1"
            'B1 owns structure and begins from the ordinary catalog setup context.
        Case "B2", "B3", "B4", "B5"
            'The caller already proved B1 current without mutation. Prevent downstream routines from silently re-entering B1.
            mCatalogSetupStructureComplete = True
        Case Else
            Err.Raise vbObjectError + 9583, "BeginCatalogStandalonePartContextForSetup", "Unsupported catalog Part identity for owner-proof persistence: " & requestedPartIdentity
    End Select
    If requestedPartIdentity = "B4" Or requestedPartIdentity = "B5" Then
        PrepareManagedDefinitionSplitForSetup
        If requestedPartIdentity = "B4" Then
            'B3 was proven current by the caller. Advance only the in-memory split cursor; no B3 mutation is executed.
            mManagedDefinitionSplitPhase = MANAGED_DEFINITION_PHASE_UI
        Else
            'B4 was proven current by the caller. Advance only the in-memory split cursor; no B3/B4 mutation is executed.
            mManagedDefinitionSplitPhase = MANAGED_DEFINITION_PHASE_MACROS
        End If
    End If
End Sub

' Purpose: Persists the durable owner proof for completed catalog Part B1-B4 while that Part is active; shared by coordinated and standalone Setup.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   completedPartIdentity (Input; String): Stable completed part identity used to select or correlate the exact ADC definition/state handled by this procedure.
' Returns: None (Sub). The procedure communicates its result through its database, UI, trace, or module-state side effects and raises errors where its implementation requires it.
Public Sub PersistCatalogStandalonePartProofForSetup(ByVal completedPartIdentity As String)
    Dim proofDomainIdentity As String
    completedPartIdentity = UCase$(Trim$(completedPartIdentity))
    Select Case completedPartIdentity
        Case "B1": proofDomainIdentity = SETUP_DOMAIN_B1_CATALOG_STRUCTURE
        Case "B2": proofDomainIdentity = SETUP_DOMAIN_B2_CATALOG_REFERENCE_DEFAULTS
        Case "B3": proofDomainIdentity = SETUP_DOMAIN_B3_NONFORM_MANAGED_DEFINITIONS
        Case "B4": proofDomainIdentity = SETUP_DOMAIN_B4_MACRO_MANAGED_DEFINITIONS
        Case Else: Err.Raise vbObjectError + 10039, "PersistCatalogStandalonePartProofForSetup", "Catalog owner-proof persistence is supported only for B1-B4."
    End Select
    RequireSetupDomainMutationAllowed proofDomainIdentity, "PersistCatalogStandalonePartProofForSetup"
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim snapshot As CatalogDomainSnapshot
    If CalculateCatalogOwnerProofSnapshotForSetup(completedPartIdentity, snapshot) = False Then Err.Raise vbObjectError + 9581, "PersistCatalogStandalonePartProofForSetup", "Could not calculate catalog owner proof after " & completedPartIdentity & ". " & snapshot.failureDetail
    Set db = ResolveCatalogDb()
    Select Case completedPartIdentity
        Case "B1"
            Call EnsureDaoPropertyValue(db, CATALOG_SCHEMA_FINGERPRINT_PROPERTY, dbText, snapshot.SchemaFingerprint, "PersistCatalogStandalonePartProofForSetup")
        Case "B2"
            Call EnsureDaoPropertyValue(db, CATALOG_SCHEMA_FINGERPRINT_PROPERTY, dbText, snapshot.SchemaFingerprint, "PersistCatalogStandalonePartProofForSetup")
            Call EnsureDaoPropertyValue(db, CATALOG_DEFAULTS_FINGERPRINT_PROPERTY, dbText, snapshot.DefaultsFingerprint, "PersistCatalogStandalonePartProofForSetup")
            Call EnsureDaoPropertyValue(db, CATALOG_NON_HELP_DEFAULTS_FINGERPRINT_PROPERTY, dbText, snapshot.NonHelpDefaultsFingerprint, "PersistCatalogStandalonePartProofForSetup")
            Call EnsureDaoPropertyValue(db, CATALOG_HELP_DOCUMENTS_FINGERPRINT_PROPERTY, dbText, snapshot.HelpDocumentsFingerprint, "PersistCatalogStandalonePartProofForSetup")
        Case "B3"
            Call EnsureDaoPropertyValue(db, CATALOG_SCHEMA_FINGERPRINT_PROPERTY, dbText, snapshot.SchemaFingerprint, "PersistCatalogStandalonePartProofForSetup")
            Call EnsureDaoPropertyValue(db, CATALOG_DEFAULTS_FINGERPRINT_PROPERTY, dbText, snapshot.DefaultsFingerprint, "PersistCatalogStandalonePartProofForSetup")
            Call EnsureDaoPropertyValue(db, CATALOG_NON_HELP_DEFAULTS_FINGERPRINT_PROPERTY, dbText, snapshot.NonHelpDefaultsFingerprint, "PersistCatalogStandalonePartProofForSetup")
            Call EnsureDaoPropertyValue(db, CATALOG_HELP_DOCUMENTS_FINGERPRINT_PROPERTY, dbText, snapshot.HelpDocumentsFingerprint, "PersistCatalogStandalonePartProofForSetup")
            Call EnsureDaoPropertyValue(db, CATALOG_CORE_INVENTORY_FINGERPRINT_PROPERTY, dbText, snapshot.CoreInventoryFingerprint, "PersistCatalogStandalonePartProofForSetup")
            Call EnsureDaoPropertyValue(db, CATALOG_UI_INVENTORY_FINGERPRINT_PROPERTY, dbText, snapshot.UiInventoryFingerprint, "PersistCatalogStandalonePartProofForSetup")
            Call EnsureDaoPropertyValue(db, CATALOG_CORE_PAYLOAD_FINGERPRINT_PROPERTY, dbText, snapshot.CorePayloadFingerprint, "PersistCatalogStandalonePartProofForSetup")
            Call EnsureDaoPropertyValue(db, CATALOG_UI_PAYLOAD_FINGERPRINT_PROPERTY, dbText, snapshot.UiPayloadFingerprint, "PersistCatalogStandalonePartProofForSetup")
        Case "B4"
            Call EnsureDaoPropertyValue(db, CATALOG_SCHEMA_FINGERPRINT_PROPERTY, dbText, snapshot.SchemaFingerprint, "PersistCatalogStandalonePartProofForSetup")
            Call EnsureDaoPropertyValue(db, CATALOG_DEFAULTS_FINGERPRINT_PROPERTY, dbText, snapshot.DefaultsFingerprint, "PersistCatalogStandalonePartProofForSetup")
            Call EnsureDaoPropertyValue(db, CATALOG_NON_HELP_DEFAULTS_FINGERPRINT_PROPERTY, dbText, snapshot.NonHelpDefaultsFingerprint, "PersistCatalogStandalonePartProofForSetup")
            Call EnsureDaoPropertyValue(db, CATALOG_HELP_DOCUMENTS_FINGERPRINT_PROPERTY, dbText, snapshot.HelpDocumentsFingerprint, "PersistCatalogStandalonePartProofForSetup")
            Call EnsureDaoPropertyValue(db, CATALOG_CORE_INVENTORY_FINGERPRINT_PROPERTY, dbText, snapshot.CoreInventoryFingerprint, "PersistCatalogStandalonePartProofForSetup")
            Call EnsureDaoPropertyValue(db, CATALOG_UI_INVENTORY_FINGERPRINT_PROPERTY, dbText, snapshot.UiInventoryFingerprint, "PersistCatalogStandalonePartProofForSetup")
            Call EnsureDaoPropertyValue(db, CATALOG_MACRO_INVENTORY_FINGERPRINT_PROPERTY, dbText, snapshot.MacroInventoryFingerprint, "PersistCatalogStandalonePartProofForSetup")
            Call EnsureDaoPropertyValue(db, CATALOG_CORE_PAYLOAD_FINGERPRINT_PROPERTY, dbText, snapshot.CorePayloadFingerprint, "PersistCatalogStandalonePartProofForSetup")
            Call EnsureDaoPropertyValue(db, CATALOG_UI_PAYLOAD_FINGERPRINT_PROPERTY, dbText, snapshot.UiPayloadFingerprint, "PersistCatalogStandalonePartProofForSetup")
            Call EnsureDaoPropertyValue(db, CATALOG_MACRO_PAYLOAD_FINGERPRINT_PROPERTY, dbText, snapshot.MacroPayloadFingerprint, "PersistCatalogStandalonePartProofForSetup")
        Case Else
            Err.Raise vbObjectError + 9582, "PersistCatalogStandalonePartProofForSetup", "Unsupported catalog Part identity for owner-proof persistence: " & completedPartIdentity
    End Select
    EnsureDatabasePropertyRemoved db, CATALOG_COMPACT_STATE_TOKEN_PROPERTY, "PersistCatalogStandalonePartProofForSetup"
    EnsureDatabasePropertyRemoved db, CATALOG_INVENTORY_PARTITION_TOKEN_PROPERTY, "PersistCatalogStandalonePartProofForSetup"
    Exit Sub
ErrHandler:
    Err.Raise Err.Number, "PersistCatalogStandalonePartProofForSetup", "Could not persist catalog owner proof for " & completedPartIdentity & ". " & Err.Description
End Sub

Private Function CatalogTableGroupingReadinessSnapshot(ByVal tableName As String) As String
    On Error GoTo SnapshotErr
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim sqlText As String
    Dim snapshotText As String
    Dim rowDetails As String
    Dim rowCount As Long
    Set db = ResolveCatalogDb()
    snapshotText = "Physical table exists=" & CStr(CodeDbTableExists(tableName))
    If CodeDbTableExists(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID)) = False Then
        CatalogTableGroupingReadinessSnapshot = snapshotText & "; [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] table exists=False; grouping must wait for catalog creation/defaulting."
        Exit Function
    End If
    If TableFieldExists(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), FIELD_OBJECT_NAME) = False Or TableFieldExists(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), FIELD_OBJECT_TYPE) = False Or TableFieldExists(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), FIELD_MANAGED_OBJECT_STATUS) = False Or TableFieldExists(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY) = False Then
        CatalogTableGroupingReadinessSnapshot = snapshotText & "; [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] schema is incomplete; grouping must wait for catalog schema repair/defaulting."
        Exit Function
    End If
    sqlText = "SELECT " & SQL_FIELD_ID & ",Nz([" & FIELD_MANAGED_OBJECT_STATUS & "],'') AS " & SQL_FIELD_STATUS_VALUE & ",Nz([" & FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY & "],'') AS " & SQL_FIELD_GROUP_SETTING_KEY & " "
    sqlText = sqlText & "FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] "
    sqlText = sqlText & "WHERE UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))='TABLE' AND UCase(Nz(" & SQL_FIELD_OBJECT_NAME & ",''))=" & SharedDao_SqlQuote(UCase$(tableName)) & " ORDER BY " & SQL_FIELD_ID & ";"
    Set rs = db.OpenRecordset(sqlText, dbOpenSnapshot)
    Do While rs.EOF = False
        PumpSetupResponsiveness
        rowCount = rowCount + 1
        If Len(rowDetails) > 0 Then rowDetails = rowDetails & " | "
        rowDetails = rowDetails & "ID=" & CStr(rs.fields(FIELD_ID).value) & ", Status=" & CStr(rs.fields(FIELD_STATUS_VALUE).value) & ", GroupSettingKey=" & CStr(rs.fields(FIELD_GROUP_SETTING_KEY).value)
        rs.MoveNext
    Loop
    rs.Close
    Set rs = Nothing
    If rowCount = 0 Then rowDetails = "No matching table row exists yet."
    CatalogTableGroupingReadinessSnapshot = snapshotText & "; matching MAC rows=" & CStr(rowCount) & "; " & rowDetails
    Exit Function
SnapshotErr:
    Dim savedErrNumber As Long
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    CatalogTableGroupingReadinessSnapshot = "Readiness snapshot failed. Error " & CStr(savedErrNumber) & ": " & savedErrDescription
End Function

Private Function CatalogHashToken(ByRef state As CatalogHashState) As String
    CatalogHashToken = Right$("00000000" & Hex$(CLng(state.hashValue)), 8) & ":" & CStr(state.textLength)
End Function

Private Function CatalogSnapshotHasRequiredFingerprints(ByRef snapshot As CatalogDomainSnapshot) As Boolean
    CatalogSnapshotHasRequiredFingerprints = Len(snapshot.SchemaFingerprint) > 0 And Len(snapshot.DefaultsFingerprint) > 0 And Len(snapshot.NonHelpDefaultsFingerprint) > 0 And Len(snapshot.HelpDocumentsFingerprint) > 0 And Len(snapshot.InventoryFingerprint) > 0 And Len(snapshot.CoreInventoryFingerprint) > 0 And Len(snapshot.FormsInventoryFingerprint) > 0 And Len(snapshot.UiInventoryFingerprint) > 0 And Len(snapshot.MacroInventoryFingerprint) > 0 And Len(snapshot.DependencyFingerprint) > 0 And Len(snapshot.PayloadFingerprint) > 0 And Len(snapshot.CorePayloadFingerprint) > 0 And Len(snapshot.FormsPayloadFingerprint) > 0 And Len(snapshot.UiPayloadFingerprint) > 0 And Len(snapshot.MacroPayloadFingerprint) > 0 And Len(snapshot.UiFingerprint) > 0 And Len(snapshot.FormsFingerprint) > 0 And Len(snapshot.QueryFingerprint) > 0
End Function

Private Function CatalogInventoryPartitionToken(ByVal db As DAO.Database, ByRef failureDetail As String) As String
    On Error GoTo ErrHandler
    Dim rs As DAO.Recordset
    Dim state As CatalogHashState
    Dim rowCount As Long
    failureDetail = vbNullString
    CatalogHashInitialize state
    CatalogHashAppendText state, FingerprintTokenPart(CATALOG_INCREMENTAL_GATE_VERSION & "|InventoryPartition")
    Set rs = db.OpenRecordset("SELECT " & SQL_FIELD_ID & "," & SQL_FIELD_OBJECT_TYPE & ",[" & FIELD_CATEGORY_CODE & "]," & SQL_FIELD_OBJECT_NAME & " FROM " & SharedDao_BracketName(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID)) & " ORDER BY " & SQL_FIELD_ID, dbOpenSnapshot)
    Do While rs.EOF = False
        PumpSetupResponsiveness
        CatalogHashAppendText state, FingerprintTokenPart(CStr(Nz(rs.fields(FIELD_ID).value, 0)))
        CatalogHashAppendText state, FingerprintTokenPart(CStr(Nz(rs.fields(FIELD_OBJECT_TYPE).value, vbNullString)))
        CatalogHashAppendText state, FingerprintTokenPart(CStr(Nz(rs.fields(FIELD_CATEGORY_CODE).value, vbNullString)))
        CatalogHashAppendText state, FingerprintTokenPart(CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString)))
        rowCount = rowCount + 1
        rs.MoveNext
    Loop
    rs.Close
    Set rs = Nothing
    CatalogHashAppendText state, FingerprintTokenPart("Rows=" & CStr(rowCount))
    CatalogInventoryPartitionToken = CatalogHashToken(state)
    Exit Function
ErrHandler:
    failureDetail = "Could not calculate the managed-object inventory partition token. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
End Function

Private Function CalculateCatalogBroadDomainSnapshot(ByRef snapshot As CatalogDomainSnapshot, ByRef inventoryPartitionToken As String, Optional ByRef timingDetail As String = vbNullString) As Boolean
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim schemaTables As Collection
    Dim defaultsTables As Collection
    Dim queryNames As Collection
    Dim item As Variant
    Dim itemText As String
    Dim schemaState As CatalogHashState
    Dim defaultsState As CatalogHashState
    Dim nonHelpDefaultsState As CatalogHashState
    Dim helpDocumentsState As CatalogHashState
    Dim inventoryState As CatalogHashState
    Dim dependencyState As CatalogHashState
    Dim payloadState As CatalogHashState
    Dim formsState As CatalogHashState
    Dim queryState As CatalogHashState
    Dim operationTimer As Single
    Dim stageTimer As Single
    snapshot.failureDetail = vbNullString
    timingDetail = vbNullString
    inventoryPartitionToken = vbNullString
    operationTimer = Timer
    stageTimer = Timer
    Set db = ResolveCatalogDb()
    PulseCatalogSetupPart7 "incremental gate: refreshing Access metadata once."
    db.TableDefs.Refresh
    db.QueryDefs.Refresh
    db.Relations.Refresh
    Set schemaTables = CatalogFastPathSchemaTableNames()
    Set defaultsTables = CatalogFastPathDefaultsTableNames()
    Set queryNames = CatalogFastPathQueryNames()
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Incremental metadata and authoritative identity-set loading: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    CatalogHashInitialize schemaState: CatalogHashAppendText schemaState, FingerprintTokenPart(CatalogDomainSeed("Schema"))
    CatalogHashInitialize defaultsState: CatalogHashAppendText defaultsState, FingerprintTokenPart(CatalogDomainSeed("Defaults"))
    CatalogHashInitialize nonHelpDefaultsState: CatalogHashAppendText nonHelpDefaultsState, FingerprintTokenPart(CatalogDomainSeed("DefaultsNonHelp"))
    CatalogHashInitialize helpDocumentsState: CatalogHashAppendText helpDocumentsState, FingerprintTokenPart(CatalogDomainSeed("DefaultsHelpDocuments"))
    CatalogHashInitialize inventoryState: CatalogHashAppendText inventoryState, FingerprintTokenPart(CatalogDomainSeed("Inventory"))
    CatalogHashInitialize dependencyState: CatalogHashAppendText dependencyState, FingerprintTokenPart(CatalogDomainSeed("Dependencies"))
    CatalogHashInitialize payloadState: CatalogHashAppendText payloadState, FingerprintTokenPart(CatalogDomainSeed("Payloads"))
    CatalogHashInitialize formsState: CatalogHashAppendText formsState, FingerprintTokenPart(CatalogDomainSeed("Forms"))
    CatalogHashInitialize queryState: CatalogHashAppendText queryState, FingerprintTokenPart(CatalogDomainSeed("Queries"))
    stageTimer = Timer
    For Each item In schemaTables
        PumpSetupResponsiveness
        itemText = CatalogFastPathTableDefinitionText(db, CStr(item), snapshot.failureDetail)
        If Len(snapshot.failureDetail) > 0 Then GoTo TimingExit
        CatalogHashAppendText schemaState, itemText
        snapshot.SchemaTableCount = snapshot.SchemaTableCount + 1
    Next item
    CatalogHashAppendText schemaState, CatalogFastPathRelationshipText(db, schemaTables)
    snapshot.SchemaFingerprint = CatalogHashToken(schemaState)
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Broad schema token: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    stageTimer = Timer
    For Each item In defaultsTables
        PumpSetupResponsiveness
        CatalogHashAppendDefaultsTableData db, CStr(item), defaultsState, nonHelpDefaultsState, helpDocumentsState, snapshot.failureDetail
        If Len(snapshot.failureDetail) > 0 Then GoTo TimingExit
        snapshot.DefaultsTableCount = snapshot.DefaultsTableCount + 1
    Next item
    snapshot.DefaultsFingerprint = CatalogHashToken(defaultsState)
    snapshot.NonHelpDefaultsFingerprint = CatalogHashToken(nonHelpDefaultsState)
    snapshot.HelpDocumentsFingerprint = CatalogHashToken(helpDocumentsState)
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Broad defaults token: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    stageTimer = Timer
    CatalogHashAppendTableData db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "Inventory", inventoryState, snapshot.failureDetail
    If Len(snapshot.failureDetail) > 0 Then GoTo TimingExit
    snapshot.InventoryFingerprint = CatalogHashToken(inventoryState)
    inventoryPartitionToken = CatalogInventoryPartitionToken(db, snapshot.failureDetail)
    If Len(snapshot.failureDetail) > 0 Then GoTo TimingExit
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Broad inventory and partition tokens: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    stageTimer = Timer
    CatalogHashAppendTableData db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies"), "Dependencies", dependencyState, snapshot.failureDetail
    If Len(snapshot.failureDetail) > 0 Then GoTo TimingExit
    snapshot.DependencyFingerprint = CatalogHashToken(dependencyState)
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Broad dependency token: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    stageTimer = Timer
    CatalogHashAppendTableData db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads"), "Payloads", payloadState, snapshot.failureDetail
    If Len(snapshot.failureDetail) > 0 Then GoTo TimingExit
    snapshot.PayloadFingerprint = CatalogHashToken(payloadState)
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Broad payload token: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    stageTimer = Timer
    snapshot.UiFingerprint = CalculateCatalogUiFingerprint(db, snapshot.failureDetail)
    If Len(snapshot.failureDetail) > 0 Then GoTo TimingExit
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Broad UI token: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    stageTimer = Timer
    CatalogHashAppendTableData db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_FormDefinitions"), "Forms", formsState, snapshot.failureDetail
    If Len(snapshot.failureDetail) > 0 Then GoTo TimingExit
    snapshot.FormsFingerprint = CatalogHashToken(formsState)
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Broad forms token: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    stageTimer = Timer
    For Each item In queryNames
        PumpSetupResponsiveness
        itemText = CatalogFastPathQueryDefinitionText(db, CStr(item), snapshot.failureDetail)
        If Len(snapshot.failureDetail) > 0 Then GoTo TimingExit
        CatalogHashAppendText queryState, itemText
        snapshot.queryCount = snapshot.queryCount + 1
    Next item
    snapshot.QueryFingerprint = CatalogHashToken(queryState)
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Broad query token: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    CalculateCatalogBroadDomainSnapshot = True
TimingExit:
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "B1 broad-domain pass total: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer)))
    Exit Function
ErrHandler:
    snapshot.failureDetail = "Could not calculate the B1 broad-domain state. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "B1 broad-domain pass failed after: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer)))
End Function

Private Function CatalogSnapshotsMatch(ByRef currentSnapshot As CatalogDomainSnapshot, ByRef persistedSnapshot As CatalogDomainSnapshot) As Boolean
    If StrComp(currentSnapshot.SchemaFingerprint, persistedSnapshot.SchemaFingerprint, vbBinaryCompare) <> 0 Then Exit Function
    If StrComp(currentSnapshot.DefaultsFingerprint, persistedSnapshot.DefaultsFingerprint, vbBinaryCompare) <> 0 Then Exit Function
    If StrComp(currentSnapshot.NonHelpDefaultsFingerprint, persistedSnapshot.NonHelpDefaultsFingerprint, vbBinaryCompare) <> 0 Then Exit Function
    If StrComp(currentSnapshot.HelpDocumentsFingerprint, persistedSnapshot.HelpDocumentsFingerprint, vbBinaryCompare) <> 0 Then Exit Function
    If StrComp(currentSnapshot.InventoryFingerprint, persistedSnapshot.InventoryFingerprint, vbBinaryCompare) <> 0 Then Exit Function
    If StrComp(currentSnapshot.CoreInventoryFingerprint, persistedSnapshot.CoreInventoryFingerprint, vbBinaryCompare) <> 0 Then Exit Function
    If StrComp(currentSnapshot.FormsInventoryFingerprint, persistedSnapshot.FormsInventoryFingerprint, vbBinaryCompare) <> 0 Then Exit Function
    If StrComp(currentSnapshot.UiInventoryFingerprint, persistedSnapshot.UiInventoryFingerprint, vbBinaryCompare) <> 0 Then Exit Function
    If StrComp(currentSnapshot.MacroInventoryFingerprint, persistedSnapshot.MacroInventoryFingerprint, vbBinaryCompare) <> 0 Then Exit Function
    If StrComp(currentSnapshot.DependencyFingerprint, persistedSnapshot.DependencyFingerprint, vbBinaryCompare) <> 0 Then Exit Function
    If StrComp(currentSnapshot.PayloadFingerprint, persistedSnapshot.PayloadFingerprint, vbBinaryCompare) <> 0 Then Exit Function
    If StrComp(currentSnapshot.CorePayloadFingerprint, persistedSnapshot.CorePayloadFingerprint, vbBinaryCompare) <> 0 Then Exit Function
    If StrComp(currentSnapshot.FormsPayloadFingerprint, persistedSnapshot.FormsPayloadFingerprint, vbBinaryCompare) <> 0 Then Exit Function
    If StrComp(currentSnapshot.UiPayloadFingerprint, persistedSnapshot.UiPayloadFingerprint, vbBinaryCompare) <> 0 Then Exit Function
    If StrComp(currentSnapshot.MacroPayloadFingerprint, persistedSnapshot.MacroPayloadFingerprint, vbBinaryCompare) <> 0 Then Exit Function
    If StrComp(currentSnapshot.UiFingerprint, persistedSnapshot.UiFingerprint, vbBinaryCompare) <> 0 Then Exit Function
    If StrComp(currentSnapshot.FormsFingerprint, persistedSnapshot.FormsFingerprint, vbBinaryCompare) <> 0 Then Exit Function
    If StrComp(currentSnapshot.QueryFingerprint, persistedSnapshot.QueryFingerprint, vbBinaryCompare) <> 0 Then Exit Function
    CatalogSnapshotsMatch = True
End Function

Private Function CatalogLoadPersistedSnapshot(ByVal db As DAO.Database, ByRef snapshot As CatalogDomainSnapshot, Optional ByRef missingDetail As String = vbNullString) As Boolean
    Dim propertyExists As Boolean
    missingDetail = vbNullString
    snapshot.SchemaFingerprint = DatabaseTextPropertyValue(db, CATALOG_SCHEMA_FINGERPRINT_PROPERTY, propertyExists)
    If propertyExists = False Or Len(snapshot.SchemaFingerprint) = 0 Then missingDetail = "Schema=missing persisted D4 evidence.": Exit Function
    snapshot.DefaultsFingerprint = DatabaseTextPropertyValue(db, CATALOG_DEFAULTS_FINGERPRINT_PROPERTY, propertyExists)
    If propertyExists = False Or Len(snapshot.DefaultsFingerprint) = 0 Then missingDetail = "Defaults=missing persisted D4 evidence.": Exit Function
    snapshot.NonHelpDefaultsFingerprint = DatabaseTextPropertyValue(db, CATALOG_NON_HELP_DEFAULTS_FINGERPRINT_PROPERTY, propertyExists)
    If propertyExists = False Or Len(snapshot.NonHelpDefaultsFingerprint) = 0 Then missingDetail = "NonHelpDefaults=missing persisted D4 evidence.": Exit Function
    snapshot.HelpDocumentsFingerprint = DatabaseTextPropertyValue(db, CATALOG_HELP_DOCUMENTS_FINGERPRINT_PROPERTY, propertyExists)
    If propertyExists = False Or Len(snapshot.HelpDocumentsFingerprint) = 0 Then missingDetail = "HelpDocumentsRows=missing persisted D4 evidence.": Exit Function
    snapshot.InventoryFingerprint = DatabaseTextPropertyValue(db, CATALOG_INVENTORY_FINGERPRINT_PROPERTY, propertyExists)
    If propertyExists = False Or Len(snapshot.InventoryFingerprint) = 0 Then missingDetail = "Inventory=missing persisted D4 evidence.": Exit Function
    snapshot.CoreInventoryFingerprint = DatabaseTextPropertyValue(db, CATALOG_CORE_INVENTORY_FINGERPRINT_PROPERTY, propertyExists)
    If propertyExists = False Or Len(snapshot.CoreInventoryFingerprint) = 0 Then missingDetail = "CoreInventory=missing persisted D4 evidence.": Exit Function
    snapshot.FormsInventoryFingerprint = DatabaseTextPropertyValue(db, CATALOG_FORMS_INVENTORY_FINGERPRINT_PROPERTY, propertyExists)
    If propertyExists = False Or Len(snapshot.FormsInventoryFingerprint) = 0 Then missingDetail = "FormsInventory=missing persisted D4 evidence.": Exit Function
    snapshot.UiInventoryFingerprint = DatabaseTextPropertyValue(db, CATALOG_UI_INVENTORY_FINGERPRINT_PROPERTY, propertyExists)
    If propertyExists = False Or Len(snapshot.UiInventoryFingerprint) = 0 Then missingDetail = "UiInventory=missing persisted D4 evidence.": Exit Function
    snapshot.MacroInventoryFingerprint = DatabaseTextPropertyValue(db, CATALOG_MACRO_INVENTORY_FINGERPRINT_PROPERTY, propertyExists)
    If propertyExists = False Or Len(snapshot.MacroInventoryFingerprint) = 0 Then missingDetail = "MacroInventory=missing persisted D4 evidence.": Exit Function
    snapshot.DependencyFingerprint = DatabaseTextPropertyValue(db, CATALOG_DEPENDENCY_FINGERPRINT_PROPERTY, propertyExists)
    If propertyExists = False Or Len(snapshot.DependencyFingerprint) = 0 Then missingDetail = "Dependencies=missing persisted D4 evidence.": Exit Function
    snapshot.PayloadFingerprint = DatabaseTextPropertyValue(db, CATALOG_PAYLOAD_FINGERPRINT_PROPERTY, propertyExists)
    If propertyExists = False Or Len(snapshot.PayloadFingerprint) = 0 Then missingDetail = "Payloads=missing persisted D4 evidence.": Exit Function
    snapshot.CorePayloadFingerprint = DatabaseTextPropertyValue(db, CATALOG_CORE_PAYLOAD_FINGERPRINT_PROPERTY, propertyExists)
    If propertyExists = False Or Len(snapshot.CorePayloadFingerprint) = 0 Then missingDetail = "CorePayloads=missing persisted D4 evidence.": Exit Function
    snapshot.FormsPayloadFingerprint = DatabaseTextPropertyValue(db, CATALOG_FORMS_PAYLOAD_FINGERPRINT_PROPERTY, propertyExists)
    If propertyExists = False Or Len(snapshot.FormsPayloadFingerprint) = 0 Then missingDetail = "FormsPayloads=missing persisted D4 evidence.": Exit Function
    snapshot.UiPayloadFingerprint = DatabaseTextPropertyValue(db, CATALOG_UI_PAYLOAD_FINGERPRINT_PROPERTY, propertyExists)
    If propertyExists = False Or Len(snapshot.UiPayloadFingerprint) = 0 Then missingDetail = "UiPayloads=missing persisted D4 evidence.": Exit Function
    snapshot.MacroPayloadFingerprint = DatabaseTextPropertyValue(db, CATALOG_MACRO_PAYLOAD_FINGERPRINT_PROPERTY, propertyExists)
    If propertyExists = False Or Len(snapshot.MacroPayloadFingerprint) = 0 Then missingDetail = "MacroPayloads=missing persisted D4 evidence.": Exit Function
    snapshot.UiFingerprint = DatabaseTextPropertyValue(db, CATALOG_UI_FINGERPRINT_PROPERTY, propertyExists)
    If propertyExists = False Or Len(snapshot.UiFingerprint) = 0 Then missingDetail = "UI=missing persisted D4 evidence.": Exit Function
    snapshot.FormsFingerprint = DatabaseTextPropertyValue(db, CATALOG_FORMS_FINGERPRINT_PROPERTY, propertyExists)
    If propertyExists = False Or Len(snapshot.FormsFingerprint) = 0 Then missingDetail = "Forms=missing persisted D4 evidence.": Exit Function
    snapshot.QueryFingerprint = DatabaseTextPropertyValue(db, CATALOG_QUERY_FINGERPRINT_PROPERTY, propertyExists)
    If propertyExists = False Or Len(snapshot.QueryFingerprint) = 0 Then missingDetail = "Queries=missing persisted D4 evidence.": Exit Function
    snapshot.operationalHistoryFingerprint = DatabaseTextPropertyValue(db, CATALOG_OPERATIONAL_HISTORY_FINGERPRINT_PROPERTY, propertyExists)
    snapshot.diagnosticHistoryFingerprint = DatabaseTextPropertyValue(db, CATALOG_DIAGNOSTIC_HISTORY_FINGERPRINT_PROPERTY, propertyExists)
    CatalogLoadPersistedSnapshot = True
End Function

Private Function TryCatalogCompactSnapshotFastPath(ByRef snapshot As CatalogDomainSnapshot, ByRef detailText As String, ByRef currentCompactStateToken As String, ByRef currentSnapshotAvailable As Boolean, Optional ByRef timingDetail As String = vbNullString) As Boolean
    On Error GoTo NotCurrent
    Dim db As DAO.Database
    Dim persistedSnapshot As CatalogDomainSnapshot
    Dim persistedAvailable As Boolean
    Dim validationExists As Boolean
    Dim rootPropertyExists As Boolean
    Dim storedCompactToken As String
    Dim storedValidationToken As String
    Dim inventoryPartitionToken As String
    Dim broadTiming As String
    Dim subdomainTiming As String
    Dim operationTimer As Single
    Dim stageTimer As Single
    currentCompactStateToken = vbNullString
    currentSnapshotAvailable = False
    timingDetail = vbNullString
    detailText = vbNullString
    operationTimer = Timer
    Set db = ResolveCatalogDb()
    stageTimer = Timer
    storedCompactToken = DatabaseTextPropertyValue(db, CATALOG_COMPACT_STATE_TOKEN_PROPERTY, rootPropertyExists)
    persistedAvailable = CatalogLoadPersistedSnapshot(db, persistedSnapshot)
    storedValidationToken = DatabaseTextPropertyValue(db, CATALOG_VALIDATION_TOKEN_PROPERTY, validationExists)
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Persisted root, domain, and validation evidence loading: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    If rootPropertyExists = False Or Len(storedCompactToken) = 0 Or persistedAvailable = False Or validationExists = False Or Len(storedValidationToken) = 0 Then
        detailText = "B1 persisted compact comparison proof is absent; skipped impossible current broad-catalog snapshot construction."
        AddTraceNote detailText
        GoTo NotMatched
    End If
    stageTimer = Timer
    If CalculateCatalogBroadDomainSnapshot(snapshot, inventoryPartitionToken, broadTiming) = False Then GoTo NotMatched
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, broadTiming)
    If ResolveCatalogInventorySubdomains(db, snapshot, persistedSnapshot, persistedAvailable, inventoryPartitionToken, subdomainTiming) = False Then GoTo NotMatched
    If ResolveCatalogPayloadSubdomains(db, snapshot, persistedSnapshot, persistedAvailable, inventoryPartitionToken, subdomainTiming) = False Then GoTo NotMatched
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, subdomainTiming)
    If persistedAvailable Then
        snapshot.operationalHistoryFingerprint = persistedSnapshot.operationalHistoryFingerprint
        snapshot.diagnosticHistoryFingerprint = persistedSnapshot.diagnosticHistoryFingerprint
    End If
    currentSnapshotAvailable = CatalogSnapshotHasRequiredFingerprints(snapshot)
    If currentSnapshotAvailable = False Then GoTo NotMatched
    currentCompactStateToken = FingerprintFromPayload(CATALOG_INCREMENTAL_GATE_VERSION & "|" & CatalogValidationToken(snapshot))
    detailText = CatalogIncrementalComparisonDetail(snapshot, persistedSnapshot, persistedAvailable, storedCompactToken, currentCompactStateToken)
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Current incremental snapshot construction boundary: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    If CatalogSnapshotsMatch(snapshot, persistedSnapshot) = False Then GoTo NotMatched
    If StrComp(storedValidationToken, CatalogValidationToken(snapshot), vbBinaryCompare) <> 0 Then GoTo NotMatched
    TryCatalogCompactSnapshotFastPath = True
NotMatched:
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Incremental compact snapshot total: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer)))
    Exit Function
NotCurrent:
    detailText = "B1 incremental compact state could not be calculated. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
    snapshot.failureDetail = detailText
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Incremental compact snapshot failed after: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer)))
    Err.Clear
End Function

Private Function CalculateCatalogDomainSnapshot(ByRef snapshot As CatalogDomainSnapshot, Optional ByRef timingDetail As String = vbNullString) As Boolean
    'Calculates all exact subdomain fingerprints with incremental hash states, avoiding repeated large-string concatenation while preserving the established fingerprint contract.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim defaultsTables As Collection
    Dim queryNames As Collection
    Dim item As Variant
    Dim itemText As String
    Dim itemIndex As Long
    Dim defaultsState As CatalogHashState
    Dim nonHelpDefaultsState As CatalogHashState
    Dim helpDocumentsState As CatalogHashState
    Dim inventoryState As CatalogHashState
    Dim coreInventoryState As CatalogHashState
    Dim formsInventoryState As CatalogHashState
    Dim uiInventoryState As CatalogHashState
    Dim macroInventoryState As CatalogHashState
    Dim dependencyState As CatalogHashState
    Dim payloadState As CatalogHashState
    Dim corePayloadState As CatalogHashState
    Dim formsPayloadState As CatalogHashState
    Dim uiPayloadState As CatalogHashState
    Dim macroPayloadState As CatalogHashState
    Dim formsState As CatalogHashState
    Dim queryState As CatalogHashState
    Dim operationTimer As Single
    Dim stageTimer As Single
    snapshot.failureDetail = vbNullString
    timingDetail = vbNullString
    operationTimer = Timer
    stageTimer = Timer
    Set db = ResolveCatalogDb()
    PulseCatalogSetupPart7 "exhaustive snapshot: refreshing Access metadata collections."
    db.TableDefs.Refresh
    db.QueryDefs.Refresh
    db.Relations.Refresh
    Set defaultsTables = CatalogFastPathDefaultsTableNames()
    Set queryNames = CatalogFastPathQueryNames()
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Access metadata and authoritative identity-set loading: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    CatalogHashInitialize defaultsState: CatalogHashAppendText defaultsState, FingerprintTokenPart(CatalogDomainSeed("Defaults"))
    CatalogHashInitialize nonHelpDefaultsState: CatalogHashAppendText nonHelpDefaultsState, FingerprintTokenPart(CatalogDomainSeed("DefaultsNonHelp"))
    CatalogHashInitialize helpDocumentsState: CatalogHashAppendText helpDocumentsState, FingerprintTokenPart(CatalogDomainSeed("DefaultsHelpDocuments"))
    CatalogHashInitialize inventoryState: CatalogHashAppendText inventoryState, FingerprintTokenPart(CatalogDomainSeed("Inventory"))
    CatalogHashInitialize coreInventoryState: CatalogHashAppendText coreInventoryState, FingerprintTokenPart(CatalogDomainSeed("InventoryCore"))
    CatalogHashInitialize formsInventoryState: CatalogHashAppendText formsInventoryState, FingerprintTokenPart(CatalogDomainSeed("InventoryForms"))
    CatalogHashInitialize uiInventoryState: CatalogHashAppendText uiInventoryState, FingerprintTokenPart(CatalogDomainSeed("InventoryUI"))
    CatalogHashInitialize macroInventoryState: CatalogHashAppendText macroInventoryState, FingerprintTokenPart(CatalogDomainSeed("InventoryMacros"))
    CatalogHashInitialize dependencyState: CatalogHashAppendText dependencyState, FingerprintTokenPart(CatalogDomainSeed("Dependencies"))
    CatalogHashInitialize payloadState: CatalogHashAppendText payloadState, FingerprintTokenPart(CatalogDomainSeed("Payloads"))
    CatalogHashInitialize corePayloadState: CatalogHashAppendText corePayloadState, FingerprintTokenPart(CatalogDomainSeed("PayloadsCore"))
    CatalogHashInitialize formsPayloadState: CatalogHashAppendText formsPayloadState, FingerprintTokenPart(CatalogDomainSeed("PayloadsForms"))
    CatalogHashInitialize uiPayloadState: CatalogHashAppendText uiPayloadState, FingerprintTokenPart(CatalogDomainSeed("PayloadsUI"))
    CatalogHashInitialize macroPayloadState: CatalogHashAppendText macroPayloadState, FingerprintTokenPart(CatalogDomainSeed("PayloadsMacros"))
    CatalogHashInitialize formsState: CatalogHashAppendText formsState, FingerprintTokenPart(CatalogDomainSeed("Forms"))
    CatalogHashInitialize queryState: CatalogHashAppendText queryState, FingerprintTokenPart(CatalogDomainSeed("Queries"))
    stageTimer = Timer
    If CalculateCatalogSchemaDomain(db, snapshot.SchemaFingerprint, snapshot.SchemaTableCount, snapshot.failureDetail, False) = False Then GoTo TimingExit
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Schema-domain calculation: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    stageTimer = Timer
    itemIndex = 0
    For Each item In defaultsTables
        PumpSetupResponsiveness
        itemIndex = itemIndex + 1
        PulseCatalogSetupPart7 "exhaustive default/reference table " & CStr(itemIndex) & " of " & CStr(defaultsTables.count) & ": " & CStr(item)
        CatalogHashAppendDefaultsTableData db, CStr(item), defaultsState, nonHelpDefaultsState, helpDocumentsState, snapshot.failureDetail
        If Len(snapshot.failureDetail) > 0 Then GoTo TimingExit
        snapshot.DefaultsTableCount = snapshot.DefaultsTableCount + 1
    Next item
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Defaults-domain calculation: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    stageTimer = Timer
    PulseCatalogSetupPart7 "exhaustive managed-object inventory domains."
    CatalogHashAppendManagedObjectInventory db, inventoryState, coreInventoryState, formsInventoryState, uiInventoryState, macroInventoryState, snapshot.failureDetail
    If Len(snapshot.failureDetail) > 0 Then GoTo TimingExit
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Inventory-domain calculation, including Core/Forms/UI/Macro subdomains in one pass: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    stageTimer = Timer
    PulseCatalogSetupPart7 "exhaustive dependency rows."
    CatalogHashAppendTableData db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies"), "Dependencies", dependencyState, snapshot.failureDetail
    If Len(snapshot.failureDetail) > 0 Then GoTo TimingExit
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Dependency-domain calculation: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    stageTimer = Timer
    PulseCatalogSetupPart7 "exhaustive managed action-payload domains."
    CatalogHashAppendManagedPayloads db, payloadState, corePayloadState, formsPayloadState, uiPayloadState, macroPayloadState, snapshot.failureDetail
    If Len(snapshot.failureDetail) > 0 Then GoTo TimingExit
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Payload-domain calculation, including Core/Forms/UI/Macro subdomains in one pass: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    stageTimer = Timer
    PulseCatalogSetupPart7 "exhaustive Navigation Pane and ribbon metadata."
    snapshot.UiFingerprint = CalculateCatalogUiFingerprint(db, snapshot.failureDetail)
    If Len(snapshot.failureDetail) > 0 Then GoTo TimingExit
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "UI-domain calculation: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    stageTimer = Timer
    PulseCatalogSetupPart7 "exhaustive managed-form metadata."
    CatalogHashAppendTableData db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_FormDefinitions"), "Forms", formsState, snapshot.failureDetail
    If Len(snapshot.failureDetail) > 0 Then GoTo TimingExit
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Forms-domain calculation: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    stageTimer = Timer
    itemIndex = 0
    For Each item In queryNames
        PumpSetupResponsiveness
        itemIndex = itemIndex + 1
        PulseCatalogSetupPart7 "exhaustive support query " & CStr(itemIndex) & " of " & CStr(queryNames.count) & ": " & CStr(item)
        itemText = CatalogFastPathQueryDefinitionText(db, CStr(item), snapshot.failureDetail)
        If Len(snapshot.failureDetail) > 0 Then GoTo TimingExit
        CatalogHashAppendText queryState, itemText
        snapshot.queryCount = snapshot.queryCount + 1
    Next item
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Queries-domain calculation: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    stageTimer = Timer
    PulseCatalogSetupPart7 "finalizing exhaustive domain fingerprint tokens."
    snapshot.DefaultsFingerprint = CatalogHashToken(defaultsState)
    snapshot.NonHelpDefaultsFingerprint = CatalogHashToken(nonHelpDefaultsState)
    snapshot.HelpDocumentsFingerprint = CatalogHashToken(helpDocumentsState)
    snapshot.InventoryFingerprint = CatalogHashToken(inventoryState)
    snapshot.CoreInventoryFingerprint = CatalogHashToken(coreInventoryState)
    snapshot.FormsInventoryFingerprint = CatalogHashToken(formsInventoryState)
    snapshot.UiInventoryFingerprint = CatalogHashToken(uiInventoryState)
    snapshot.MacroInventoryFingerprint = CatalogHashToken(macroInventoryState)
    snapshot.DependencyFingerprint = CatalogHashToken(dependencyState)
    snapshot.PayloadFingerprint = CatalogHashToken(payloadState)
    snapshot.CorePayloadFingerprint = CatalogHashToken(corePayloadState)
    snapshot.FormsPayloadFingerprint = CatalogHashToken(formsPayloadState)
    snapshot.UiPayloadFingerprint = CatalogHashToken(uiPayloadState)
    snapshot.MacroPayloadFingerprint = CatalogHashToken(macroPayloadState)
    snapshot.FormsFingerprint = CatalogHashToken(formsState)
    snapshot.QueryFingerprint = CatalogHashToken(queryState)
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Root domain-token construction: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    CalculateCatalogDomainSnapshot = True
TimingExit:
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Exhaustive catalog snapshot total: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer)))
    Exit Function
ErrHandler:
    snapshot.failureDetail = "Could not calculate managed-catalog subdomain fingerprints. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Exhaustive catalog snapshot failed after: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer)))
End Function

Private Sub CatalogCopyDomainSnapshot(ByRef sourceSnapshot As CatalogDomainSnapshot, ByRef targetSnapshot As CatalogDomainSnapshot)
    targetSnapshot.SchemaFingerprint = sourceSnapshot.SchemaFingerprint
    targetSnapshot.DefaultsFingerprint = sourceSnapshot.DefaultsFingerprint
    targetSnapshot.NonHelpDefaultsFingerprint = sourceSnapshot.NonHelpDefaultsFingerprint
    targetSnapshot.HelpDocumentsFingerprint = sourceSnapshot.HelpDocumentsFingerprint
    targetSnapshot.InventoryFingerprint = sourceSnapshot.InventoryFingerprint
    targetSnapshot.CoreInventoryFingerprint = sourceSnapshot.CoreInventoryFingerprint
    targetSnapshot.FormsInventoryFingerprint = sourceSnapshot.FormsInventoryFingerprint
    targetSnapshot.UiInventoryFingerprint = sourceSnapshot.UiInventoryFingerprint
    targetSnapshot.MacroInventoryFingerprint = sourceSnapshot.MacroInventoryFingerprint
    targetSnapshot.DependencyFingerprint = sourceSnapshot.DependencyFingerprint
    targetSnapshot.PayloadFingerprint = sourceSnapshot.PayloadFingerprint
    targetSnapshot.CorePayloadFingerprint = sourceSnapshot.CorePayloadFingerprint
    targetSnapshot.FormsPayloadFingerprint = sourceSnapshot.FormsPayloadFingerprint
    targetSnapshot.UiPayloadFingerprint = sourceSnapshot.UiPayloadFingerprint
    targetSnapshot.MacroPayloadFingerprint = sourceSnapshot.MacroPayloadFingerprint
    targetSnapshot.UiFingerprint = sourceSnapshot.UiFingerprint
    targetSnapshot.FormsFingerprint = sourceSnapshot.FormsFingerprint
    targetSnapshot.QueryFingerprint = sourceSnapshot.QueryFingerprint
    targetSnapshot.operationalHistoryFingerprint = sourceSnapshot.operationalHistoryFingerprint
    targetSnapshot.diagnosticHistoryFingerprint = sourceSnapshot.diagnosticHistoryFingerprint
    targetSnapshot.SchemaTableCount = sourceSnapshot.SchemaTableCount
    targetSnapshot.DefaultsTableCount = sourceSnapshot.DefaultsTableCount
    targetSnapshot.queryCount = sourceSnapshot.queryCount
    targetSnapshot.failureDetail = sourceSnapshot.failureDetail
End Sub

Private Function RefreshCatalogDirtyDomainSnapshot(ByRef sourceSnapshot As CatalogDomainSnapshot, ByRef refreshedSnapshot As CatalogDomainSnapshot, ByRef refreshDetail As String) As Boolean
    'Recalculates only subdomains that Setup actually mutated; uncertainty still falls back to the existing complete exact snapshot in the caller.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim defaultsTables As Collection
    Dim queryNames As Collection
    Dim item As Variant
    Dim itemText As String
    Dim defaultsState As CatalogHashState
    Dim nonHelpDefaultsState As CatalogHashState
    Dim helpDocumentsState As CatalogHashState
    Dim inventoryState As CatalogHashState
    Dim coreInventoryState As CatalogHashState
    Dim formsInventoryState As CatalogHashState
    Dim uiInventoryState As CatalogHashState
    Dim macroInventoryState As CatalogHashState
    Dim dependencyState As CatalogHashState
    Dim payloadState As CatalogHashState
    Dim corePayloadState As CatalogHashState
    Dim formsPayloadState As CatalogHashState
    Dim uiPayloadState As CatalogHashState
    Dim macroPayloadState As CatalogHashState
    Dim formsState As CatalogHashState
    Dim queryState As CatalogHashState
    Dim dirtyMask As Long
    Dim domainTimer As Single
    dirtyMask = mCatalogSetupDirtyDomainMask
    refreshDetail = "Dirty catalog subdomains: " & CatalogDirtyDomainSummary(dirtyMask)
    CatalogCopyDomainSnapshot sourceSnapshot, refreshedSnapshot
    refreshedSnapshot.failureDetail = vbNullString
    If dirtyMask = 0 Then
        RefreshCatalogDirtyDomainSnapshot = True
        Exit Function
    End If
    Set db = ResolveCatalogDb()
    If (dirtyMask And CATALOG_DIRTY_SCHEMA) <> 0 Then
        domainTimer = Timer
        CorePulseProgress "Refreshing the exact catalog schema fingerprint without recalculating unchanged domains."
        If CalculateCatalogSchemaDomain(db, refreshedSnapshot.SchemaFingerprint, refreshedSnapshot.SchemaTableCount, refreshedSnapshot.failureDetail, True) = False Then Exit Function
        refreshDetail = refreshDetail & vbCrLf & "Exact schema fingerprint refresh: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(domainTimer))
    Else
        db.TableDefs.Refresh
    End If
    If (dirtyMask And CATALOG_DIRTY_DEFAULTS) <> 0 Then
        domainTimer = Timer
        CorePulseProgress "Refreshing catalog default/reference fingerprints."
        Set defaultsTables = CatalogFastPathDefaultsTableNames()
        CatalogHashInitialize defaultsState
        CatalogHashAppendText defaultsState, FingerprintTokenPart(CatalogDomainSeed("Defaults"))
        CatalogHashInitialize nonHelpDefaultsState
        CatalogHashAppendText nonHelpDefaultsState, FingerprintTokenPart(CatalogDomainSeed("DefaultsNonHelp"))
        CatalogHashInitialize helpDocumentsState
        CatalogHashAppendText helpDocumentsState, FingerprintTokenPart(CatalogDomainSeed("DefaultsHelpDocuments"))
        refreshedSnapshot.DefaultsTableCount = 0
        For Each item In defaultsTables
            PumpSetupResponsiveness
            CatalogHashAppendDefaultsTableData db, CStr(item), defaultsState, nonHelpDefaultsState, helpDocumentsState, refreshedSnapshot.failureDetail
            If Len(refreshedSnapshot.failureDetail) > 0 Then Exit Function
            refreshedSnapshot.DefaultsTableCount = refreshedSnapshot.DefaultsTableCount + 1
        Next item
        refreshedSnapshot.DefaultsFingerprint = CatalogHashToken(defaultsState)
        refreshedSnapshot.NonHelpDefaultsFingerprint = CatalogHashToken(nonHelpDefaultsState)
        refreshedSnapshot.HelpDocumentsFingerprint = CatalogHashToken(helpDocumentsState)
        refreshDetail = refreshDetail & vbCrLf & "Defaults fingerprint refresh: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(domainTimer))
    End If
    If (dirtyMask And CATALOG_DIRTY_INVENTORY) <> 0 Then
        domainTimer = Timer
        CorePulseProgress "Refreshing managed-object inventory fingerprints."
        CatalogHashInitialize inventoryState: CatalogHashAppendText inventoryState, FingerprintTokenPart(CatalogDomainSeed("Inventory"))
        CatalogHashInitialize coreInventoryState: CatalogHashAppendText coreInventoryState, FingerprintTokenPart(CatalogDomainSeed("InventoryCore"))
        CatalogHashInitialize formsInventoryState: CatalogHashAppendText formsInventoryState, FingerprintTokenPart(CatalogDomainSeed("InventoryForms"))
        CatalogHashInitialize uiInventoryState: CatalogHashAppendText uiInventoryState, FingerprintTokenPart(CatalogDomainSeed("InventoryUI"))
        CatalogHashInitialize macroInventoryState: CatalogHashAppendText macroInventoryState, FingerprintTokenPart(CatalogDomainSeed("InventoryMacros"))
        CatalogHashAppendManagedObjectInventory db, inventoryState, coreInventoryState, formsInventoryState, uiInventoryState, macroInventoryState, refreshedSnapshot.failureDetail
        If Len(refreshedSnapshot.failureDetail) > 0 Then Exit Function
        refreshedSnapshot.InventoryFingerprint = CatalogHashToken(inventoryState)
        refreshedSnapshot.CoreInventoryFingerprint = CatalogHashToken(coreInventoryState)
        refreshedSnapshot.FormsInventoryFingerprint = CatalogHashToken(formsInventoryState)
        refreshedSnapshot.UiInventoryFingerprint = CatalogHashToken(uiInventoryState)
        refreshedSnapshot.MacroInventoryFingerprint = CatalogHashToken(macroInventoryState)
        refreshDetail = refreshDetail & vbCrLf & "Managed-object inventory fingerprint refresh: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(domainTimer))
    End If
    If (dirtyMask And CATALOG_DIRTY_DEPENDENCIES) <> 0 Then
        domainTimer = Timer
        CorePulseProgress "Refreshing managed-object dependency fingerprints."
        CatalogHashInitialize dependencyState
        CatalogHashAppendText dependencyState, FingerprintTokenPart(CatalogDomainSeed("Dependencies"))
        CatalogHashAppendTableData db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies"), "Dependencies", dependencyState, refreshedSnapshot.failureDetail
        If Len(refreshedSnapshot.failureDetail) > 0 Then Exit Function
        refreshedSnapshot.DependencyFingerprint = CatalogHashToken(dependencyState)
        refreshDetail = refreshDetail & vbCrLf & "Dependency fingerprint refresh: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(domainTimer))
    End If
    If (dirtyMask And CATALOG_DIRTY_PAYLOADS) <> 0 Then
        domainTimer = Timer
        CorePulseProgress "Refreshing managed-object action-payload fingerprints."
        CatalogHashInitialize payloadState: CatalogHashAppendText payloadState, FingerprintTokenPart(CatalogDomainSeed("Payloads"))
        CatalogHashInitialize corePayloadState: CatalogHashAppendText corePayloadState, FingerprintTokenPart(CatalogDomainSeed("PayloadsCore"))
        CatalogHashInitialize formsPayloadState: CatalogHashAppendText formsPayloadState, FingerprintTokenPart(CatalogDomainSeed("PayloadsForms"))
        CatalogHashInitialize uiPayloadState: CatalogHashAppendText uiPayloadState, FingerprintTokenPart(CatalogDomainSeed("PayloadsUI"))
        CatalogHashInitialize macroPayloadState: CatalogHashAppendText macroPayloadState, FingerprintTokenPart(CatalogDomainSeed("PayloadsMacros"))
        CatalogHashAppendManagedPayloads db, payloadState, corePayloadState, formsPayloadState, uiPayloadState, macroPayloadState, refreshedSnapshot.failureDetail
        If Len(refreshedSnapshot.failureDetail) > 0 Then Exit Function
        refreshedSnapshot.PayloadFingerprint = CatalogHashToken(payloadState)
        refreshedSnapshot.CorePayloadFingerprint = CatalogHashToken(corePayloadState)
        refreshedSnapshot.FormsPayloadFingerprint = CatalogHashToken(formsPayloadState)
        refreshedSnapshot.UiPayloadFingerprint = CatalogHashToken(uiPayloadState)
        refreshedSnapshot.MacroPayloadFingerprint = CatalogHashToken(macroPayloadState)
        refreshDetail = refreshDetail & vbCrLf & "Action-payload fingerprint refresh: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(domainTimer))
    End If
    If (dirtyMask And CATALOG_DIRTY_UI) <> 0 Then
        domainTimer = Timer
        CorePulseProgress "Refreshing Navigation Pane and ribbon metadata fingerprints."
        refreshedSnapshot.UiFingerprint = CalculateCatalogUiFingerprint(db, refreshedSnapshot.failureDetail)
        If Len(refreshedSnapshot.failureDetail) > 0 Then Exit Function
        refreshDetail = refreshDetail & vbCrLf & "UI metadata fingerprint refresh: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(domainTimer))
    End If
    If (dirtyMask And CATALOG_DIRTY_FORMS) <> 0 Then
        domainTimer = Timer
        CorePulseProgress "Refreshing managed-form catalog fingerprints."
        CatalogHashInitialize formsState
        CatalogHashAppendText formsState, FingerprintTokenPart(CatalogDomainSeed("Forms"))
        CatalogHashAppendTableData db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_FormDefinitions"), "Forms", formsState, refreshedSnapshot.failureDetail
        If Len(refreshedSnapshot.failureDetail) > 0 Then Exit Function
        refreshedSnapshot.FormsFingerprint = CatalogHashToken(formsState)
        refreshDetail = refreshDetail & vbCrLf & "Forms fingerprint refresh: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(domainTimer))
    End If
    If (dirtyMask And CATALOG_DIRTY_QUERIES) <> 0 Then
        domainTimer = Timer
        CorePulseProgress "Refreshing managed-catalog support-query fingerprints."
        db.QueryDefs.Refresh
        Set queryNames = CatalogFastPathQueryNames()
        CatalogHashInitialize queryState
        CatalogHashAppendText queryState, FingerprintTokenPart(CatalogDomainSeed("Queries"))
        refreshedSnapshot.queryCount = 0
        For Each item In queryNames
            PumpSetupResponsiveness
            itemText = CatalogFastPathQueryDefinitionText(db, CStr(item), refreshedSnapshot.failureDetail)
            If Len(refreshedSnapshot.failureDetail) > 0 Then Exit Function
            CatalogHashAppendText queryState, itemText
            refreshedSnapshot.queryCount = refreshedSnapshot.queryCount + 1
        Next item
        refreshedSnapshot.QueryFingerprint = CatalogHashToken(queryState)
        refreshDetail = refreshDetail & vbCrLf & "Support-query fingerprint refresh: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(domainTimer))
    End If
    RefreshCatalogDirtyDomainSnapshot = True
    Exit Function
ErrHandler:
    refreshedSnapshot.failureDetail = "Could not refresh the setup-mutated managed-catalog subdomains. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
End Function

Private Function CatalogValidationToken(ByRef snapshot As CatalogDomainSnapshot) As String
    Dim payloadText As String
    payloadText = CatalogContractSignature()
    payloadText = payloadText & "|" & snapshot.SchemaFingerprint
    payloadText = payloadText & "|" & snapshot.DefaultsFingerprint
    payloadText = payloadText & "|" & snapshot.InventoryFingerprint
    payloadText = payloadText & "|" & snapshot.CoreInventoryFingerprint
    payloadText = payloadText & "|" & snapshot.FormsInventoryFingerprint
    payloadText = payloadText & "|" & snapshot.UiInventoryFingerprint
    payloadText = payloadText & "|" & snapshot.MacroInventoryFingerprint
    payloadText = payloadText & "|" & snapshot.DependencyFingerprint
    payloadText = payloadText & "|" & snapshot.PayloadFingerprint
    payloadText = payloadText & "|" & snapshot.CorePayloadFingerprint
    payloadText = payloadText & "|" & snapshot.FormsPayloadFingerprint
    payloadText = payloadText & "|" & snapshot.UiPayloadFingerprint
    payloadText = payloadText & "|" & snapshot.MacroPayloadFingerprint
    payloadText = payloadText & "|" & snapshot.UiFingerprint
    payloadText = payloadText & "|" & snapshot.FormsFingerprint
    payloadText = payloadText & "|" & snapshot.QueryFingerprint
    CatalogValidationToken = FingerprintFromPayload(payloadText)
End Function

Private Sub PersistNonFormCatalogDomainSnapshot(ByRef snapshot As CatalogDomainSnapshot)
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Set db = ResolveCatalogDb()
    Call EnsureDaoPropertyValue(db, CATALOG_SCHEMA_FINGERPRINT_PROPERTY, dbText, snapshot.SchemaFingerprint, "PersistNonFormCatalogDomainSnapshot")
    Call EnsureDaoPropertyValue(db, CATALOG_DEFAULTS_FINGERPRINT_PROPERTY, dbText, snapshot.DefaultsFingerprint, "PersistNonFormCatalogDomainSnapshot")
    Call EnsureDaoPropertyValue(db, CATALOG_NON_HELP_DEFAULTS_FINGERPRINT_PROPERTY, dbText, snapshot.NonHelpDefaultsFingerprint, "PersistNonFormCatalogDomainSnapshot")
    Call EnsureDaoPropertyValue(db, CATALOG_HELP_DOCUMENTS_FINGERPRINT_PROPERTY, dbText, snapshot.HelpDocumentsFingerprint, "PersistNonFormCatalogDomainSnapshot")
    Call EnsureDaoPropertyValue(db, CATALOG_CORE_INVENTORY_FINGERPRINT_PROPERTY, dbText, snapshot.CoreInventoryFingerprint, "PersistNonFormCatalogDomainSnapshot")
    Call EnsureDaoPropertyValue(db, CATALOG_UI_INVENTORY_FINGERPRINT_PROPERTY, dbText, snapshot.UiInventoryFingerprint, "PersistNonFormCatalogDomainSnapshot")
    Call EnsureDaoPropertyValue(db, CATALOG_MACRO_INVENTORY_FINGERPRINT_PROPERTY, dbText, snapshot.MacroInventoryFingerprint, "PersistNonFormCatalogDomainSnapshot")
    Call EnsureDaoPropertyValue(db, CATALOG_CORE_PAYLOAD_FINGERPRINT_PROPERTY, dbText, snapshot.CorePayloadFingerprint, "PersistNonFormCatalogDomainSnapshot")
    Call EnsureDaoPropertyValue(db, CATALOG_UI_PAYLOAD_FINGERPRINT_PROPERTY, dbText, snapshot.UiPayloadFingerprint, "PersistNonFormCatalogDomainSnapshot")
    Call EnsureDaoPropertyValue(db, CATALOG_MACRO_PAYLOAD_FINGERPRINT_PROPERTY, dbText, snapshot.MacroPayloadFingerprint, "PersistNonFormCatalogDomainSnapshot")
    Call EnsureDaoPropertyValue(db, CATALOG_QUERY_FINGERPRINT_PROPERTY, dbText, snapshot.QueryFingerprint, "PersistNonFormCatalogDomainSnapshot")
    EnsureDatabasePropertyRemoved db, CATALOG_INVENTORY_FINGERPRINT_PROPERTY, "PersistNonFormCatalogDomainSnapshot"
    EnsureDatabasePropertyRemoved db, CATALOG_FORMS_INVENTORY_FINGERPRINT_PROPERTY, "PersistNonFormCatalogDomainSnapshot"
    EnsureDatabasePropertyRemoved db, CATALOG_DEPENDENCY_FINGERPRINT_PROPERTY, "PersistNonFormCatalogDomainSnapshot"
    EnsureDatabasePropertyRemoved db, CATALOG_PAYLOAD_FINGERPRINT_PROPERTY, "PersistNonFormCatalogDomainSnapshot"
    EnsureDatabasePropertyRemoved db, CATALOG_FORMS_PAYLOAD_FINGERPRINT_PROPERTY, "PersistNonFormCatalogDomainSnapshot"
    EnsureDatabasePropertyRemoved db, CATALOG_UI_FINGERPRINT_PROPERTY, "PersistNonFormCatalogDomainSnapshot"
    EnsureDatabasePropertyRemoved db, CATALOG_FORMS_FINGERPRINT_PROPERTY, "PersistNonFormCatalogDomainSnapshot"
    EnsureDatabasePropertyRemoved db, CATALOG_VALIDATION_TOKEN_PROPERTY, "PersistNonFormCatalogDomainSnapshot"
    EnsureDatabasePropertyRemoved db, CATALOG_COMPACT_STATE_TOKEN_PROPERTY, "PersistNonFormCatalogDomainSnapshot"
    EnsureDatabasePropertyRemoved db, CATALOG_INVENTORY_PARTITION_TOKEN_PROPERTY, "PersistNonFormCatalogDomainSnapshot"
    mCatalogSetupCompactStateToken = vbNullString
    Exit Sub
ErrHandler:
    Err.Raise Err.Number, "PersistNonFormCatalogDomainSnapshot", "Could not persist Phase-B non-form catalog proof while invalidating form-inclusive proof fields." & vbCrLf & "Description: " & Err.Description
End Sub

Private Sub ClearBuildRepairHelpDocumentMacrosCatalogPredecessorProofScopeState()
    Dim emptySnapshot As CatalogDomainSnapshot
    mBuildRepairHelpDocumentMacrosCatalogPredecessorScopeActive = False
