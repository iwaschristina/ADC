Private Sub DefaultSystemHelpMacroManagedObjectRows(ByVal repairDefaultRows As Boolean, ByVal defaultCatalog As Collection, ByVal systemMacroGroupKeyIndex As Object, ByVal synchronizationScope As HelpDocumentSynchronizationScope)
    'Setup B4 reconciles built-in System Macros plus its Help scope. Operational Build/Repair Help Document Macros captures only Help-document definitions so unrelated System Macro payloads cannot become
    'operational-refresh mutations.
    If synchronizationScope = HelpDocumentScopeSetupSystemAndAllActive Or synchronizationScope = HelpDocumentScopeSetupSystemOnly Then
        If mManagedDefinitionCaptureActive Then mManagedDefinitionCaptureFamily = MANAGED_DEFINITION_FAMILY_SYSTEM_MACROS
        CorePulseProgress "Defaulting managed objects: system macros."
        DefaultSystemMacroManagedObjectRows repairDefaultRows, defaultCatalog, systemMacroGroupKeyIndex
    ElseIf synchronizationScope <> HelpDocumentScopeAllActive Then
        Err.Raise vbObjectError + 9542, "DefaultSystemHelpMacroManagedObjectRows", "Unsupported Help Document synchronization scope: " & CStr(synchronizationScope)
    End If
    If synchronizationScope <> HelpDocumentScopeSetupSystemOnly Then
        If mManagedDefinitionCaptureActive Then mManagedDefinitionCaptureFamily = MANAGED_DEFINITION_FAMILY_HELP_DOCUMENTS
        CorePulseProgress "Defaulting managed objects: help-document macros."
        DefaultHelpDocumentManagedObjectRows repairDefaultRows, synchronizationScope
    End If
    If mManagedDefinitionCaptureActive Then mManagedDefinitionCaptureFamily = MANAGED_DEFINITION_FAMILY_SUPPORT
    CorePulseProgress "Managed-object row and action-payload defaulting complete."
End Sub

