Private Sub B2AddMetadataPlanTable(ByVal rows As Object, ByVal tableName As String)
    Dim definitions As Collection
    If Len(tableName) = 0 Then Exit Sub
    If rows.Exists(tableName) Then Exit Sub
    Set definitions = B2SharedFieldMetadataDefinitions(tableName)
    If definitions.count = 0 Then Exit Sub
    rows.Add tableName, definitions
End Sub

Private Function B2TryGetLocalTableDef(ByVal db As DAO.Database, ByVal tableName As String, ByRef tdf As DAO.tableDef) As Boolean
    Set tdf = Nothing
    On Error Resume Next
    Set tdf = db.TableDefs(tableName)
    Err.Clear
    On Error GoTo 0
    B2TryGetLocalTableDef = Not tdf Is Nothing
End Function

Private Function ManagedDefinitionStableIdentityKey(ByVal logicalObjectName As String, ByVal namingCategory As String, ByVal objectTypeCode As String, Optional ByVal physicalObjectName As String = vbNullString) As String
    logicalObjectName = Trim$(logicalObjectName)
    namingCategory = Trim$(namingCategory)
    objectTypeCode = Trim$(objectTypeCode)
    If Len(namingCategory) = 0 And Len(physicalObjectName) > 0 Then namingCategory = ManagedObjectNamingCategory(objectTypeCode, vbNullString, physicalObjectName)
    If Len(logicalObjectName) = 0 And Len(namingCategory) > 0 And Len(physicalObjectName) > 0 Then logicalObjectName = LogicalObjectNameFromPhysicalName(namingCategory, physicalObjectName)
    If Len(logicalObjectName) = 0 Then logicalObjectName = physicalObjectName
    ManagedDefinitionStableIdentityKey = UCase$(namingCategory) & Chr$(30) & UCase$(logicalObjectName) & Chr$(30) & UCase$(objectTypeCode)
End Function

Private Function ManagedTableOptionalMissingReason(ByVal db As DAO.Database, ByVal tableName As String) As String
    On Error GoTo ErrHandler
    Dim rs As DAO.Recordset
    Dim sqlText As String
    Dim expectedExistencePolicy As String
    Dim setupAction As String
    sqlText = "SELECT TOP 1 " & ResolvedExpectedExistencePolicySql("o", "c") & " " & "AS " & SQL_FIELD_RESOLVED_EXPECTED_EXISTENCE_POLICY & "," & ResolvedSetupActionSql("o", "c") & " AS " & FIELD_RESOLVED_SETUP_ACTION & " FROM ([" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] AS m INNER JOIN [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ObjectCategories") & "] AS c ON m.[" & FIELD_CATEGORY_CODE & "]=c.[" & FIELD_CATEGORY_CODE & "]) LEFT JOIN [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECT_OVERRIDES_TABLE_LOGICAL_ID) & "] AS o ON m." & SQL_FIELD_ID & "=o.[" & FIELD_MANAGED_OBJECT_ID & "] WHERE Nz(m.[" & FIELD_MANAGED_OBJECT_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND UCase(Trim(Nz(m." & SQL_FIELD_OBJECT_TYPE & ",'')))='TABLE' AND m." & SQL_FIELD_OBJECT_NAME & "=" & SharedDao_SqlQuote(tableName) & ";"
    Set rs = db.OpenRecordset(sqlText, dbOpenSnapshot)
    If rs.EOF = False Then
        expectedExistencePolicy = CStr(Nz(rs.fields(FIELD_RESOLVED_EXPECTED_EXISTENCE_POLICY).value, vbNullString))
        setupAction = CStr(Nz(rs.fields(FIELD_RESOLVED_SETUP_ACTION).value, vbNullString))
        ManagedTableOptionalMissingReason = ManagedObjectOptionalMissingReason(expectedExistencePolicy, setupAction)
    End If
    rs.Close
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    Err.Raise savedErrNumber, "ManagedTableOptionalMissingReason", "Could not resolve the optional-existence policy for an absent active managed table." & vbCrLf & "Table: " & tableName & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Function

Private Function CountRowsIfTableExists(ByVal db As DAO.Database, ByVal tableName As String, ByVal whereText As String) As Long
    Dim rs As DAO.Recordset
    If SharedDao_DatabaseTableExistsSafe(db, tableName) = False Then Exit Function
    Set rs = db.OpenRecordset("SELECT Count(*) AS " & SQL_FIELD_ROW_COUNT & " FROM [" & tableName & "] WHERE " & whereText & ";", dbOpenSnapshot)
    CountRowsIfTableExists = CLng(rs!rowCount)
    rs.Close
End Function

Private Function B2ExpectedSqlSourceObjectType(ByVal sourceName As String) As String
    Dim objectTypeCode As String
    If StrComp(sourceName, MSYS_OBJECTS_TABLE, vbTextCompare) = 0 _
       Or StrComp(sourceName, NAV_PANE_GROUPS_TABLE, vbTextCompare) = 0 Then
        B2ExpectedSqlSourceObjectType = ADCAT_OBJECT_TYPE_TABLE
        Exit Function
    End If
    objectTypeCode = ManagedObjectTypeCodeForName(sourceName)
    If StrComp(objectTypeCode, ADCAT_OBJECT_TYPE_TABLE, vbTextCompare) = 0 _
       Or StrComp(objectTypeCode, ADCAT_OBJECT_TYPE_QUERY, vbTextCompare) = 0 Then
        B2ExpectedSqlSourceObjectType = objectTypeCode
        Exit Function
    End If
    Err.Raise vbObjectError + 9509, "B2ExpectedSqlSourceObjectType", "A B2 live RowSource contains an unclassified source object. Add the source to the canonical managed-object registry or explicitly classify the system source before persisting a metadata proof." & vbCrLf & "Source: " & sourceName
End Function

Private Sub B2CollectSqlSourceNames(ByVal sqlText As String, ByVal dependencyRows As Object)
    Dim marker As Variant
    Dim searchText As String
    Dim markerPosition As Long
    Dim scanPosition As Long
    Dim nameStart As Long
    Dim nameEnd As Long
    Dim sourceName As String
    Dim sourceClauseCount As Long
    Dim parsedSourceCount As Long
    Dim charIndex As Long
    Dim currentChar As String
    Dim nextChar As String
    Dim inBracketedName As Boolean
    Dim inSingleQuotedText As Boolean
    Dim inDoubleQuotedText As Boolean
    Dim pendingWhitespace As Boolean
    pendingWhitespace = True
    charIndex = 1
    Do While charIndex <= Len(sqlText)
        currentChar = Mid$(sqlText, charIndex, 1)
        nextChar = vbNullString
        If charIndex < Len(sqlText) Then nextChar = Mid$(sqlText, charIndex + 1, 1)
        If inBracketedName Then
            searchText = searchText & currentChar
            If currentChar = "]" Then
                If nextChar = "]" Then
                    searchText = searchText & nextChar
                    charIndex = charIndex + 1
                Else
                    inBracketedName = False
                End If
            End If
        ElseIf inSingleQuotedText Then
            If currentChar = "'" Then
                If nextChar = "'" Then
                    searchText = searchText & "__"
                    charIndex = charIndex + 1
                Else
                    searchText = searchText & currentChar
                    inSingleQuotedText = False
                End If
            Else
                searchText = searchText & "_"
            End If
        ElseIf inDoubleQuotedText Then
            If currentChar = Chr$(34) Then
                If nextChar = Chr$(34) Then
                    searchText = searchText & "__"
                    charIndex = charIndex + 1
                Else
                    searchText = searchText & currentChar
                    inDoubleQuotedText = False
                End If
            Else
                searchText = searchText & "_"
            End If
        Else
            Select Case currentChar
                Case " ", vbTab, vbCr, vbLf
                    pendingWhitespace = True
                Case "["
                    If pendingWhitespace Then searchText = searchText & " "
                    pendingWhitespace = False
                    searchText = searchText & currentChar
                    inBracketedName = True
                Case "'"
                    If pendingWhitespace Then searchText = searchText & " "
                    pendingWhitespace = False
                    searchText = searchText & currentChar
                    inSingleQuotedText = True
                Case Chr$(34)
                    If pendingWhitespace Then searchText = searchText & " "
                    pendingWhitespace = False
                    searchText = searchText & currentChar
                    inDoubleQuotedText = True
                Case Else
                    If pendingWhitespace Then searchText = searchText & " "
                    pendingWhitespace = False
                    searchText = searchText & currentChar
            End Select
        End If
        charIndex = charIndex + 1
    Loop
    If pendingWhitespace Then searchText = searchText & " "
    For Each marker In Array(" FROM ", " JOIN ")
        markerPosition = 1
        Do
            markerPosition = InStr(markerPosition, searchText, CStr(marker), vbTextCompare)
            If markerPosition = 0 Then Exit Do
            sourceClauseCount = sourceClauseCount + 1
            scanPosition = markerPosition + Len(CStr(marker))
            Do While scanPosition <= Len(searchText)
                currentChar = Mid$(searchText, scanPosition, 1)
                If currentChar <> " " And currentChar <> "(" Then Exit Do
                scanPosition = scanPosition + 1
            Loop
            If scanPosition <= Len(searchText) Then
                If Mid$(searchText, scanPosition, 1) = "[" Then
                    nameStart = scanPosition + 1
                    nameEnd = InStr(nameStart, searchText, "]", vbBinaryCompare)
                    If nameEnd = 0 Then Err.Raise vbObjectError + 9510, "B2CollectSqlSourceNames", "A B2 live RowSource contains an unterminated bracketed source name." & vbCrLf & "SQL: " & sqlText
                    sourceName = Mid$(searchText, nameStart, nameEnd - nameStart)
                    B2AddMetadataDependency dependencyRows, sourceName, B2ExpectedSqlSourceObjectType(sourceName)
                    parsedSourceCount = parsedSourceCount + 1
                Else
                    'Access may persist ordinary source identifiers without brackets. Accept only that simple identifier grammar; canonical object classification still proves the resolved source.
                    currentChar = Mid$(searchText, scanPosition, 1)
                    If (currentChar >= "A" And currentChar <= "Z") _
                       Or (currentChar >= "a" And currentChar <= "z") _
                       Or currentChar = "_" Then
                        nameStart = scanPosition
                        nameEnd = nameStart
                        Do While nameEnd <= Len(searchText)
                            currentChar = Mid$(searchText, nameEnd, 1)
                            If (currentChar >= "A" And currentChar <= "Z") _
                               Or (currentChar >= "a" And currentChar <= "z") _
                               Or (currentChar >= "0" And currentChar <= "9") _
                               Or currentChar = "_" Then
                                nameEnd = nameEnd + 1
                            Else
                                Exit Do
                            End If
                        Loop
                        nextChar = vbNullString
                        If nameEnd <= Len(searchText) Then nextChar = Mid$(searchText, nameEnd, 1)
                        If nextChar = vbNullString Or nextChar = " " Or nextChar = ")" Or nextChar = ";" Then
                            sourceName = Mid$(searchText, nameStart, nameEnd - nameStart)
                            If StrComp(sourceName, "SELECT", vbTextCompare) <> 0 Then
                                B2AddMetadataDependency dependencyRows, sourceName, B2ExpectedSqlSourceObjectType(sourceName)
                                parsedSourceCount = parsedSourceCount + 1
                            End If
                        End If
                    End If
                End If
            End If
            markerPosition = markerPosition + Len(CStr(marker))
        Loop
    Next marker
    If parsedSourceCount <> sourceClauseCount Then Err.Raise vbObjectError + 9516, "B2CollectSqlSourceNames", "A B2 live RowSource contains an unsupported source clause, so an exact dependency proof cannot be persisted." & vbCrLf & "Source clauses: " & CStr(sourceClauseCount) & vbCrLf & "Parsed sources: " & CStr(parsedSourceCount) & vbCrLf & "SQL: " & sqlText
End Sub

Private Function ManagedObjectSqlLiteralForField(ByVal fieldValue As Variant, ByVal fieldType As Long) As String
    If IsNull(fieldValue) Then
        ManagedObjectSqlLiteralForField = "Null"
        Exit Function
    End If
    Select Case fieldType
        Case dbBoolean
            ManagedObjectSqlLiteralForField = IIf(CBool(fieldValue), "True", "False")
        Case dbByte, dbInteger, dbLong
            ManagedObjectSqlLiteralForField = CStr(CLng(fieldValue))
        Case dbSingle, dbDouble, dbCurrency, dbDecimal
            ManagedObjectSqlLiteralForField = Trim$(Str$(CDbl(fieldValue)))
        Case dbDate
            ManagedObjectSqlLiteralForField = "#" & Format$(CDate(fieldValue), "yyyy\/mm\/dd hh\:nn\:ss") & "#"
        Case Else
            ManagedObjectSqlLiteralForField = SharedDao_SqlQuote(CStr(fieldValue))
    End Select
End Function

' Purpose: Returns the canonical SQL expression that resolves a managed object's expected-existence-policy override against its object-category default for callers that must build SQL before the saved resolved
'   query is
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   managedObjectAlias (Input; String): Stable managed-object alias used to identify the object independently of its physical Access name in catalog/query/display logic.
'   objectCategoryAlias (Input; String): Category value classifying the object alias item so the routine can select the correct naming, logging, or processing rules.
' Returns: String: Returns the SQL text resolved/generated for resolved expected existence policy SQL, ready for the Access query/recordsource operation that consumes it; vbNullString indicates no applicable
'   SQL where the function permits that state.
Public Function ResolvedExpectedExistencePolicySql(ByVal managedObjectAlias As String, ByVal objectCategoryAlias As String) As String
    'Returns the canonical SQL expression that resolves a managed object's expected-existence-policy override against its object-category default for callers that must build SQL before the saved resolved query is
    'available.
    managedObjectAlias = Trim$(managedObjectAlias)
    objectCategoryAlias = Trim$(objectCategoryAlias)
    If Len(managedObjectAlias) = 0 Or Len(objectCategoryAlias) = 0 Then Err.Raise vbObjectError + 7811, "ResolvedExpectedExistencePolicySql", "Managed-object and object-category SQL aliases are required."
    ResolvedExpectedExistencePolicySql = "IIf(Len(Nz(" & managedObjectAlias & ".[" & FIELD_EXPECTED_EXISTENCE_POLICY_OVERRIDE & "],''))>0," & managedObjectAlias & ".[" & FIELD_EXPECTED_EXISTENCE_POLICY_OVERRIDE & "]," & objectCategoryAlias & "." & SQL_FIELD_DEFAULT_EXPECTED_EXISTENCE_POLICY & ")"
End Function

