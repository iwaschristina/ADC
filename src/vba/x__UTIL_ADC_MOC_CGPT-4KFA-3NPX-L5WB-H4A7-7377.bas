End Function

Private Function CatalogPayloadContractSignature() As String
    CatalogPayloadContractSignature = CATALOG_CORE_PAYLOAD_CONTRACT_VERSION & "|" & CATALOG_FORMS_PAYLOAD_CONTRACT_VERSION & "|" & CATALOG_UI_PAYLOAD_CONTRACT_VERSION & "|" & CATALOG_MACRO_PAYLOAD_CONTRACT_VERSION
End Function

Private Function CatalogContractSignature() As String
    CatalogContractSignature = CATALOG_HASH_FORMAT_VERSION & "|" & CATALOG_SCHEMA_CONTRACT_VERSION & "|" & CATALOG_DEFAULTS_CONTRACT_VERSION & "|" & CatalogInventoryContractSignature() & "|" & CATALOG_DEPENDENCY_CONTRACT_VERSION & "|" & CatalogPayloadContractSignature() & "|" & CATALOG_UI_CONTRACT_VERSION & "|" & CATALOG_FORMS_CONTRACT_VERSION & "|" & CATALOG_QUERY_CONTRACT_VERSION
End Function

