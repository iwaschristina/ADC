' Purpose: Validates managed object placement resolver coverage phase for include managed forms.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   showMessage (Input Optional; Boolean): Controls whether the routine displays its normal user-facing status, completion, warning, or error message; False suppresses that presentation while preserving the
'   underlying operation. Default: False.
'   detailsForMessage (Output Optional; String): Receives detail text formatted for inclusion in the caller's user-facing message. Default: vbNullString.
'   includeManagedForms (Input Optional; Boolean): True includes managed forms in this operation; False excludes that optional content while leaving the rest of the operation unchanged. Default: True.
' Returns: Boolean: True on the function's affirmative/success branch for validate managed object placement resolver coverage phase; False on its explicit negative, unavailable, rejected, or handled-failure branch.
'   or not-applicable path.
Public Function ValidateManagedObjectPlacementResolverCoveragePhase(Optional ByVal showMessage As Boolean = False, Optional ByRef detailsForMessage As String = vbNullString, Optional ByVal includeManagedForms As Boolean = True) As Boolean
    'Owns the complete centralized placement-resolver coverage gate.
    RequireCatalogSetupPhaseReady "ValidateManagedObjectPlacementResolverCoveragePhase"
    On Error GoTo ErrHandler
    Dim phaseTimer As Single
    Dim traceTimer As Single
    Dim timingText As String
    phaseTimer = Timer
    ValidateManagedObjectPlacementResolverCoverageForSetup timingText, includeManagedForms
    detailsForMessage = IIf(includeManagedForms, "Complete managed-object placement resolver coverage verified.", "Non-form managed-object placement resolver coverage verified; forms handled in Phase D.") & vbCrLf & "Validation elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(phaseTimer))
    mCatalogSetupDefinitionsComplete = True
    traceTimer = Timer
    LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "ValidateManagedObjectPlacementResolverCoveragePhase", "Managed-object placement resolver coverage phase completed.", detailsForMessage, "Placement resolver validation", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "PlacementValidation", "CodeDb", "ManagedObjectCatalog"
    timingText = SharedText_AppendNonBlankLine(timingText, "B5 wrapper completion trace write: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(traceTimer)))
    LogCatalogSetupSubstageTiming "ValidateManagedObjectPlacementResolverCoveragePhase", "Setup B5 placement coverage", timingText
    If showMessage Then CoreShowMessage detailsForMessage, vbInformation, "Managed Object Catalog", "ShowADCMessage", "Tables"
    ValidateManagedObjectPlacementResolverCoveragePhase = True
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    timingText = SharedText_AppendNonBlankLine(timingText, "B5 wrapper failed after: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(phaseTimer)))
    LogCatalogSetupSubstageTiming "ValidateManagedObjectPlacementResolverCoveragePhase", "Setup B5 placement coverage failure", timingText
    detailsForMessage = "Managed-object placement resolver coverage phase failed." & vbCrLf & "Err.Number: " & CStr(savedErrNumber) & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
    LogTraceMessage TRACE_LEVEL_ERROR, "ManagedObjectCatalog", "ValidateManagedObjectPlacementResolverCoveragePhase", "Managed-object placement resolver coverage phase failed.", detailsForMessage, "Placement resolver validation", savedErrNumber, savedErrSource, savedErrDescription, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "PlacementValidation", "CodeDb", "ManagedObjectCatalog"
    If showMessage Then CoreShowErrorMessage detailsForMessage, vbCritical, "Managed Object Catalog", "ValidateManagedObjectPlacementResolverCoveragePhase", "Tables": Exit Function
    Err.Raise savedErrNumber, "ValidateManagedObjectPlacementResolverCoveragePhase", detailsForMessage
End Function

Private Function ExplicitManagedObjectPlacementNeedsDefault(ByVal rs As DAO.Recordset) As Boolean
    ExplicitManagedObjectPlacementNeedsDefault = (Len(Trim$(CStr(Nz(FieldValueIfExists(rs, FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY), vbNullString)))) = 0 Or _
        Len(Trim$(CStr(Nz(FieldValueIfExists(rs, FIELD_RIBBON_TAB_KEY), vbNullString)))) = 0 Or _
        Len(Trim$(CStr(Nz(FieldValueIfExists(rs, FIELD_RIBBON_TAB_LABEL), vbNullString)))) = 0 Or _
        Len(Trim$(CStr(Nz(FieldValueIfExists(rs, FIELD_RIBBON_GROUP_LABEL), vbNullString)))) = 0 Or _
        SharedValue_NzLong(FieldValueIfExists(rs, FIELD_RIBBON_GROUP_SORT_ORDER)) <= 0)
End Function

Private Sub ApplyExplicitManagedObjectPlacementDefaultsToRecordset(ByVal rs As DAO.Recordset, ByVal navigationSettingKey As String, ByVal ribbonTabKey As String, ByVal ribbonTabLabel As String, ByVal ribbonGroupLabel As String, ByVal ribbonGroupSortOrder As Long, ByVal preserveExistingValues As Boolean)
    'Dynamic user-form placement is derived from the user-form policy, not from the static canonical managed-object registry.
    If preserveExistingValues Then
        If Len(Trim$(CStr(Nz(FieldValueIfExists(rs, FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY), vbNullString)))) = 0 Then SetRecordsetFieldValueIfExists rs, FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY, navigationSettingKey
        If Len(Trim$(CStr(Nz(FieldValueIfExists(rs, FIELD_RIBBON_TAB_KEY), vbNullString)))) = 0 Then SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_TAB_KEY, ribbonTabKey
        If Len(Trim$(CStr(Nz(FieldValueIfExists(rs, FIELD_RIBBON_TAB_LABEL), vbNullString)))) = 0 Then SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_TAB_LABEL, ribbonTabLabel
        If Len(Trim$(CStr(Nz(FieldValueIfExists(rs, FIELD_RIBBON_GROUP_LABEL), vbNullString)))) = 0 Then SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_GROUP_LABEL, ribbonGroupLabel
        If SharedValue_NzLong(FieldValueIfExists(rs, FIELD_RIBBON_GROUP_SORT_ORDER)) <= 0 Then SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_GROUP_SORT_ORDER, ribbonGroupSortOrder
    Else
        SetRecordsetFieldValueIfExists rs, FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY, navigationSettingKey
        SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_TAB_KEY, ribbonTabKey
        SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_TAB_LABEL, ribbonTabLabel
        SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_GROUP_LABEL, ribbonGroupLabel
        SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_GROUP_SORT_ORDER, ribbonGroupSortOrder
    End If
End Sub

Private Sub ApplyManagedObjectPlacementDefaultsToRecordset(ByVal rs As DAO.Recordset, ByVal objectName As String, ByVal objectTypeCode As String, ByVal categoryCode As String, Optional ByVal preserveExistingValues As Boolean = False)
    'Placement fields are derived projections of the canonical object definition. They are never fallback or override authorities.
    Dim SettingKey As String
    Dim ribbonTabKey As String
    Dim ribbonTabLabel As String
    Dim ribbonGroupLabel As String
    Dim ribbonGroupSortOrder As Long
    Dim ignoredLogicalIdentity As String
    Dim ignoredNavigationSettingKey As String
    Dim ignoredRibbonTabKey As String
    Dim ignoredRibbonTabLabel As String
    Dim ignoredRibbonGroupLabel As String
    Dim ignoredRibbonGroupSortOrder As Long
    Dim ignoredDirectlyExposedOnRibbon As Boolean
    Dim ignoredDefinitionSource As String
    If StrComp(categoryCode, ADCAT_CATEGORY_SYSTEM_MACRO, vbTextCompare) = 0 Then
        If preserveExistingValues = False Then SetRecordsetFieldValueIfExists rs, FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY, Null
        Exit Sub
    End If
    If StrComp(objectTypeCode, ADCAT_OBJECT_TYPE_MACRO, vbTextCompare) = 0 Then
        If preserveExistingValues = False Then
            SetRecordsetFieldValueIfExists rs, FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY, Null
            SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_TAB_KEY, Null
            SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_TAB_LABEL, Null
            SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_GROUP_LABEL, Null
            SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_GROUP_SORT_ORDER, Null
        End If
        Exit Sub
    End If
    SettingKey = ManagedObjectNavigationPaneSettingKey(objectName, objectTypeCode)
    If Len(SettingKey) = 0 Then Err.Raise vbObjectError + 9425, "ApplyManagedObjectPlacementDefaultsToRecordset", "The canonical managed-object definition has no resolvable Navigation Pane group assignment." & vbCrLf & "Object: " & objectName & vbCrLf & "Object type: " & objectTypeCode
    If ManagedObjectPlacementRibbon(objectName, objectTypeCode, ribbonTabKey, ribbonTabLabel, ribbonGroupLabel, ribbonGroupSortOrder) = False Then Err.Raise vbObjectError + 9426, "ApplyManagedObjectPlacementDefaultsToRecordset", "The canonical managed-object definition has no resolvable Ribbon group assignment." & vbCrLf & "Object: " & objectName & vbCrLf & "Object type: " & objectTypeCode
    SetRecordsetFieldValueIfExists rs, FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY, SettingKey
    SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_TAB_KEY, ribbonTabKey
    SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_TAB_LABEL, ribbonTabLabel
    SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_GROUP_LABEL, ribbonGroupLabel
    SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_GROUP_SORT_ORDER, ribbonGroupSortOrder
End Sub

Private Function TryResolveManagedObjectPlacementDefinition(ByVal objectName As String, ByVal objectTypeCode As String, ByRef logicalIdentity As String, ByRef scopeCode As String, ByRef navigationSettingKey As String, ByRef ribbonTabKey As String, ByRef ribbonTabLabel As String, ByRef ribbonGroupLabel As String, ByRef ribbonGroupSortOrder As Long, ByRef directlyExposedOnRibbon As Boolean, ByRef definitionSource As String, ByVal authoritativeManagedUserForms As Collection, ByVal canonicalGeneratedFormNames As Collection, ByVal storedRibbonTabKey As Variant, ByVal storedRibbonGroupLabel As Variant, ByVal navigationPaneDefinitionIndex As Object, ByRef navigationPaneApplicabilityLookupCount As Long, Optional ByRef definitionElapsedSeconds As Double = 0, Optional ByRef scopeElapsedSeconds As Double = 0, Optional ByRef navigationElapsedSeconds As Double = 0, Optional ByRef ribbonElapsedSeconds As Double = 0) As Boolean
    Dim stageTimer As Single
    Dim isGenerated As Boolean
    logicalIdentity = vbNullString
    scopeCode = vbNullString
    navigationSettingKey = vbNullString
    ribbonTabKey = vbNullString
    ribbonTabLabel = vbNullString
    ribbonGroupLabel = vbNullString
    ribbonGroupSortOrder = 0
    directlyExposedOnRibbon = True
    definitionSource = vbNullString
    stageTimer = Timer
    If StrComp(objectTypeCode, ADCAT_OBJECT_TYPE_FORM, vbTextCompare) = 0 Then
        If Not authoritativeManagedUserForms Is Nothing Then
            If TextCollectionContains(authoritativeManagedUserForms, objectName) Then
                logicalIdentity = objectName
                definitionElapsedSeconds = definitionElapsedSeconds + ElapsedSecondsFromTimer(stageTimer)
                stageTimer = Timer
                scopeCode = NAVIGATION_PANE_GROUP_PURPOSE_FORMS
                scopeElapsedSeconds = scopeElapsedSeconds + ElapsedSecondsFromTimer(stageTimer)
                stageTimer = Timer
                navigationSettingKey = SETTING_DEFAULT_FORMS_NAV_GROUP
                navigationElapsedSeconds = navigationElapsedSeconds + ElapsedSecondsFromTimer(stageTimer)
                stageTimer = Timer
                If TryResolveFormsRibbonPlacement(objectName, objectTypeCode, isGenerated, ribbonGroupLabel, ribbonGroupSortOrder, storedRibbonTabKey, storedRibbonGroupLabel, canonicalGeneratedFormNames) Then
                    ribbonTabKey = DEFAULT_RIBBON_TAB_KEY_FORMS
                    ribbonTabLabel = DEFAULT_RIBBON_TAB_LABEL_FORMS
                    definitionSource = "PhysicalManagedFormNames/TryResolveFormsRibbonPlacement"
                    TryResolveManagedObjectPlacementDefinition = (isGenerated = False And Len(scopeCode) > 0 And Len(navigationSettingKey) > 0 And Len(ribbonTabKey) > 0 And Len(ribbonTabLabel) > 0 And Len(ribbonGroupLabel) > 0 And ribbonGroupSortOrder > 0)
                End If
                ribbonElapsedSeconds = ribbonElapsedSeconds + ElapsedSecondsFromTimer(stageTimer)
                Exit Function
            End If
        End If
    End If
    definitionElapsedSeconds = definitionElapsedSeconds + ElapsedSecondsFromTimer(stageTimer)
    stageTimer = Timer
    scopeCode = ManagedObjectPlacementScope(objectName, objectTypeCode)
    scopeElapsedSeconds = scopeElapsedSeconds + ElapsedSecondsFromTimer(stageTimer)
    stageTimer = Timer
    If TryResolveAddInReviewPlacementDefinition(objectName, objectTypeCode, logicalIdentity, navigationSettingKey, ribbonTabKey, ribbonTabLabel, ribbonGroupLabel, ribbonGroupSortOrder, directlyExposedOnRibbon, definitionSource) Then
        definitionElapsedSeconds = definitionElapsedSeconds + ElapsedSecondsFromTimer(stageTimer)
        TryResolveManagedObjectPlacementDefinition = True
        Exit Function
    End If
    definitionElapsedSeconds = definitionElapsedSeconds + ElapsedSecondsFromTimer(stageTimer)
    logicalIdentity = objectName
    stageTimer = Timer
    navigationPaneApplicabilityLookupCount = navigationPaneApplicabilityLookupCount + 1
    navigationSettingKey = ManagedPlacementNavigationPaneSettingKeyFromIndex(scopeCode, navigationPaneDefinitionIndex)
    navigationElapsedSeconds = navigationElapsedSeconds + ElapsedSecondsFromTimer(stageTimer)
    directlyExposedOnRibbon = Not ManagedObjectIsRibbonExcludedByPolicy(objectName, objectTypeCode)
    stageTimer = Timer
    If ManagedObjectPlacementRibbon(objectName, objectTypeCode, ribbonTabKey, ribbonTabLabel, ribbonGroupLabel, ribbonGroupSortOrder) Then
        definitionSource = "ADCManagedObjectDefinitions/" & IIf(Len(scopeCode) = 0, "UnrecognizedScope", scopeCode) & "/DirectRibbonExposure=" & CStr(directlyExposedOnRibbon)
        TryResolveManagedObjectPlacementDefinition = (Len(navigationSettingKey) > 0)
    End If
    ribbonElapsedSeconds = ribbonElapsedSeconds + ElapsedSecondsFromTimer(stageTimer)
End Function

Private Sub ValidateManagedObjectPlacementDefinitionsForSetup(Optional ByVal requirePlacement As Boolean = False, Optional ByVal includeManagedForms As Boolean = True)
    On Error GoTo ErrHandler
    Dim definitions As Collection
    Dim definitionData As Variant
    Dim evaluation As TAddInReviewManagedObjectEvaluation
    Dim db As DAO.Database
    Dim snapshotRows As Collection
    Dim rowData As Variant
    Dim objectID As Long
    Dim objectName As String
    Dim objectTypeCode As String
    Dim categoryCode As String
    Dim rowLogicalIdentity As String
    Dim definitionLogicalIdentity As String
    Dim scopeCode As String
    Dim definitionSource As String
    Dim definitionMatched As Boolean
    Dim missingComponents As String
    Dim exactPlacementDifference As String
    Dim checkedCount As Long
    Dim exactMatchCount As Long
    Dim addInReviewDefinitionsChecked As Long
    Dim addInReviewFailureCount As Long
    Dim generalFailureCount As Long
    Dim failureDetail As String
    Dim successDetail As String
    Dim snapshotDetail As String
    Dim stageTimer As Single
    Dim evaluationTimer As Single
    Dim evaluationLoopTimer As Single
    Dim snapshotTimer As Single
    Dim snapshotValidationTimer As Single
    stageTimer = Timer
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "ValidateManagedObjectPlacementDefinitionsForSetup", "D4 placement validation: building Add-In Review authoritative definitions.", "IncludeForms=" & CStr(includeManagedForms) & vbCrLf & "RequirePlacement=" & CStr(requirePlacement), "D4 placement validation", 0, vbNullString, vbNullString, vbNullString, "AddInReviewDefinitions", "CodeDb", "Performance"
    Set definitions = AddInReviewPlacementDefinitions()
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "ValidateManagedObjectPlacementDefinitionsForSetup", "D4 placement validation: Add-In Review authoritative definitions built.", "Definitions=" & CStr(definitions.count) & vbCrLf & "Elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)), "D4 placement validation", 0, vbNullString, vbNullString, vbNullString, "AddInReviewDefinitions", "CodeDb", "Performance"
    stageTimer = Timer
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "ValidateManagedObjectPlacementDefinitionsForSetup", "D4 placement validation: Add-In Review definition-set validation starting.", "Definitions=" & CStr(definitions.count), "D4 placement validation", 0, vbNullString, vbNullString, vbNullString, "AddInReviewDefinitions", "CodeDb", "Performance"
    ValidateAddInReviewDefinitionSet definitions
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "ValidateManagedObjectPlacementDefinitionsForSetup", "D4 placement validation: Add-In Review definition-set validation completed.", "Elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)), "D4 placement validation", 0, vbNullString, vbNullString, vbNullString, "AddInReviewDefinitions", "CodeDb", "Performance"
    Set db = ResolveCatalogDb()
    evaluationLoopTimer = Timer
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "ValidateManagedObjectPlacementDefinitionsForSetup", "D4 placement validation: Add-In Review exact-match evaluation loop starting.", "Definitions available=" & CStr(definitions.count), "D4 placement validation", 0, vbNullString, vbNullString, vbNullString, "AddInReviewDefinitions", "CodeDb", "Performance"
    For Each definitionData In definitions
        If includeManagedForms Or StrComp(CStr(definitionData(ADD_IN_REVIEW_DEF_OBJECT_TYPE)), ADCAT_OBJECT_TYPE_FORM, vbTextCompare) <> 0 Then
            PumpSetupResponsiveness
            addInReviewDefinitionsChecked = addInReviewDefinitionsChecked + 1
            evaluationTimer = Timer
            LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "ValidateManagedObjectPlacementDefinitionsForSetup", "D4 placement validation: Add-In Review definition evaluation starting.", "Definition " & CStr(addInReviewDefinitionsChecked) & " of " & CStr(definitions.count) & vbCrLf & "Logical identity=" & CStr(definitionData(ADD_IN_REVIEW_DEF_LOGICAL_IDENTITY)) & vbCrLf & "Object=" & CStr(definitionData(ADD_IN_REVIEW_DEF_OBJECT_NAME)) & vbCrLf & "Type=" & CStr(definitionData(ADD_IN_REVIEW_DEF_OBJECT_TYPE)), "D4 placement validation", 0, vbNullString, vbNullString, CStr(definitionData(ADD_IN_REVIEW_DEF_OBJECT_NAME)), CStr(definitionData(ADD_IN_REVIEW_DEF_OBJECT_TYPE)), "CodeDb", "Performance"
            EvaluateAddInReviewManagedObjectDefinition db, definitionData, requirePlacement, evaluation
            LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "ValidateManagedObjectPlacementDefinitionsForSetup", "D4 placement validation: Add-In Review definition evaluation completed.", "Definition=" & CStr(definitionData(ADD_IN_REVIEW_DEF_LOGICAL_IDENTITY)) & vbCrLf & "Object=" & CStr(definitionData(ADD_IN_REVIEW_DEF_OBJECT_NAME)) & vbCrLf & "Classification=" & AddInReviewMatchClassificationText(evaluation.classification) & vbCrLf & "Elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(evaluationTimer)), "D4 placement validation", 0, vbNullString, vbNullString, CStr(definitionData(ADD_IN_REVIEW_DEF_OBJECT_NAME)), CStr(definitionData(ADD_IN_REVIEW_DEF_OBJECT_TYPE)), "CodeDb", "Performance"
            If evaluation.classification = ADD_IN_REVIEW_MATCH_EXACT Then
                exactMatchCount = exactMatchCount + 1
                successDetail = SharedText_AppendNonBlankLine(successDetail, "Definition=" & CStr(definitionData(ADD_IN_REVIEW_DEF_LOGICAL_IDENTITY)) & "; Object=" & CStr(definitionData(ADD_IN_REVIEW_DEF_OBJECT_NAME)) & "; Type=" & CStr(definitionData(ADD_IN_REVIEW_DEF_OBJECT_TYPE)) & "; RowID=" & CStr(evaluation.selectedRowID))
            Else
                addInReviewFailureCount = addInReviewFailureCount + 1
                failureDetail = SharedText_AppendNonBlankLine(failureDetail, AddInReviewDefinitionFailureText(definitionData, evaluation))
            End If
            If addInReviewDefinitionsChecked = 1 Or (addInReviewDefinitionsChecked Mod 5) = 0 Or addInReviewDefinitionsChecked = definitions.count Then
                LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "ValidateManagedObjectPlacementDefinitionsForSetup", "D4 placement validation: Add-In Review evaluation milestone.", "Definition=" & CStr(addInReviewDefinitionsChecked) & vbCrLf & "Total definitions=" & CStr(definitions.count) & vbCrLf & "Logical identity=" & CStr(definitionData(ADD_IN_REVIEW_DEF_LOGICAL_IDENTITY)) & vbCrLf & "Object=" & CStr(definitionData(ADD_IN_REVIEW_DEF_OBJECT_NAME)) & vbCrLf & "Loop elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(evaluationLoopTimer)), "D4 placement validation", 0, vbNullString, vbNullString, CStr(definitionData(ADD_IN_REVIEW_DEF_OBJECT_NAME)), CStr(definitionData(ADD_IN_REVIEW_DEF_OBJECT_TYPE)), "CodeDb", "Performance"
            End If
            RequireSafeWorkContinue "ValidateManagedObjectPlacementDefinitionsForSetup", "Definition [" & CStr(definitionData(ADD_IN_REVIEW_DEF_LOGICAL_IDENTITY)) & "]"
        End If
    Next definitionData
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "ValidateManagedObjectPlacementDefinitionsForSetup", "D4 placement validation: Add-In Review exact-match evaluation loop completed.", "Definitions checked=" & CStr(addInReviewDefinitionsChecked) & vbCrLf & "Exact matches=" & CStr(exactMatchCount) & vbCrLf & "Failures=" & CStr(addInReviewFailureCount) & vbCrLf & "Elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(evaluationLoopTimer)), "D4 placement validation", 0, vbNullString, vbNullString, vbNullString, "AddInReviewDefinitions", "CodeDb", "Performance"
    snapshotTimer = Timer
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "ValidateManagedObjectPlacementDefinitionsForSetup", "D4 placement validation: obtaining shared managed-placement snapshot.", "IncludeForms=" & CStr(includeManagedForms), "D4 placement validation", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitions", "CodeDb", "Performance"
    Set snapshotRows = EnsureManagedPlacementValidationSnapshot(includeManagedForms, snapshotDetail)
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "ValidateManagedObjectPlacementDefinitionsForSetup", "D4 placement validation: shared managed-placement snapshot obtained.", "Rows=" & CStr(snapshotRows.count) & vbCrLf & "Elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(snapshotTimer)) & IIf(Len(snapshotDetail) = 0, vbNullString, vbCrLf & snapshotDetail), "D4 placement validation", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitions", "CodeDb", "Performance"
    snapshotValidationTimer = Timer
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "ValidateManagedObjectPlacementDefinitionsForSetup", "D4 placement validation: shared placement snapshot validation loop starting.", "Rows=" & CStr(snapshotRows.count), "D4 placement validation", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitions", "CodeDb", "Performance"
    For Each rowData In snapshotRows
        PumpSetupResponsiveness
        checkedCount = checkedCount + 1
        objectID = CLng(rowData(PLACEMENT_SNAPSHOT_ID))
        objectName = CStr(rowData(PLACEMENT_SNAPSHOT_OBJECT_NAME))
        rowLogicalIdentity = CStr(rowData(PLACEMENT_SNAPSHOT_LOGICAL_NAME))
        objectTypeCode = CStr(rowData(PLACEMENT_SNAPSHOT_OBJECT_TYPE))
        categoryCode = CStr(rowData(PLACEMENT_SNAPSHOT_CATEGORY))
        definitionLogicalIdentity = CStr(rowData(PLACEMENT_SNAPSHOT_DEFINITION_LOGICAL_NAME))
        scopeCode = CStr(rowData(PLACEMENT_SNAPSHOT_SCOPE))
        definitionSource = CStr(rowData(PLACEMENT_SNAPSHOT_DEFINITION_SOURCE))
        definitionMatched = CBool(rowData(PLACEMENT_SNAPSHOT_DEFINITION_MATCHED))
        missingComponents = CStr(rowData(PLACEMENT_SNAPSHOT_MISSING_COMPONENTS))
        If definitionMatched = False Or Len(missingComponents) > 0 Then
            generalFailureCount = generalFailureCount + 1
            failureDetail = SharedText_AppendNonBlankLine(failureDetail, "General placement definition failure: ID=" & CStr(objectID) & "; Object=" & objectName & "; LogicalIdentity=" & IIf(Len(rowLogicalIdentity) = 0, definitionLogicalIdentity, rowLogicalIdentity) & "; Type=" & objectTypeCode & "; Category=" & categoryCode & "; Scope=" & IIf(Len(scopeCode) = 0, "(unrecognized)", scopeCode) & "; DefinitionSource=" & IIf(Len(definitionSource) = 0, "(none)", definitionSource) & "; MissingComponent=" & IIf(Len(missingComponents) = 0, "AuthoritativePlacementDefinition", missingComponents))
        Else
            exactPlacementDifference = vbNullString
            If CanonicalManagedPlacementSnapshotRowMatchesAuthority(rowData, exactPlacementDifference) = False Then
                generalFailureCount = generalFailureCount + 1
                failureDetail = SharedText_AppendNonBlankLine(failureDetail, "Canonical-owned placement mismatch: ID=" & CStr(objectID) & "; Object=" & objectName & "; LogicalIdentity=" & IIf(Len(rowLogicalIdentity) = 0, definitionLogicalIdentity, rowLogicalIdentity) & "; Type=" & objectTypeCode & "; Category=" & categoryCode & "; Scope=" & IIf(Len(scopeCode) = 0, "(unrecognized)", scopeCode) & "; DefinitionSource=" & IIf(Len(definitionSource) = 0, "(none)", definitionSource) & vbCrLf & exactPlacementDifference)
            End If
        End If
        If checkedCount = 1 Or (checkedCount Mod 25) = 0 Or checkedCount = snapshotRows.count Then
            LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "ValidateManagedObjectPlacementDefinitionsForSetup", "D4 placement validation: placement snapshot validation milestone.", "Row=" & CStr(checkedCount) & " of " & CStr(snapshotRows.count) & vbCrLf & "Object=" & IIf(Len(objectName) = 0, "(blank)", objectName) & vbCrLf & "Type=" & IIf(Len(objectTypeCode) = 0, "(blank)", objectTypeCode) & vbCrLf & "Failures=" & CStr(generalFailureCount) & vbCrLf & "Elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(snapshotValidationTimer)), "D4 placement validation", 0, vbNullString, vbNullString, objectName, objectTypeCode, "CodeDb", "Performance"
        End If
        RequireSafeWorkContinue "ValidateManagedObjectPlacementDefinitionsForSetup", objectTypeCode & " [" & objectName & "]"
    Next rowData
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "ValidateManagedObjectPlacementDefinitionsForSetup", "D4 placement validation: shared placement snapshot validation loop completed.", "Rows checked=" & CStr(checkedCount) & vbCrLf & "General failures=" & CStr(generalFailureCount) & vbCrLf & "Elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(snapshotValidationTimer)), "D4 placement validation", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitions", "CodeDb", "Performance"
    If addInReviewFailureCount > 0 Or generalFailureCount > 0 Then Err.Raise vbObjectError + 9496, "ValidateManagedObjectPlacementDefinitionsForSetup", "The Managed Object Catalog does not contain the exact authoritative placement state." & vbCrLf & "Active non-system rows checked: " & CStr(checkedCount) & vbCrLf & "Add-In Review definitions checked: " & CStr(addInReviewDefinitionsChecked) & vbCrLf & "Add-In Review exact active matches: " & CStr(exactMatchCount) & vbCrLf & "Add-In Review definitions failing: " & CStr(addInReviewFailureCount) & vbCrLf & "Other placement definitions failing: " & CStr(generalFailureCount) & vbCrLf & "Placement metadata required: " & CStr(requirePlacement) & vbCrLf & failureDetail
    LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "ValidateManagedObjectPlacementDefinitionsForSetup", "Authoritative managed-object placement definitions passed exact validation.", "Active non-system rows checked: " & CStr(checkedCount) & vbCrLf & "Add-In Review definitions checked: " & CStr(addInReviewDefinitionsChecked) & vbCrLf & "Add-In Review exact active matches: " & CStr(exactMatchCount) & vbCrLf & "Placement metadata required: " & CStr(requirePlacement) & vbCrLf & snapshotDetail & vbCrLf & successDetail, "Validate managed-object placement definitions", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "PlacementDefinitionPreflight", "CodeDb", "ManagedObjectCatalog"
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    If IsCancellationError(savedErrNumber) Then Err.Raise savedErrNumber, savedErrSource, savedErrDescription
    LogTraceMessage TRACE_LEVEL_ERROR, "ManagedObjectCatalog", "ValidateManagedObjectPlacementDefinitionsForSetup", "Authoritative managed-object placement validation failed.", savedErrDescription, "Validate managed-object placement definitions", savedErrNumber, savedErrSource, savedErrDescription, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "PlacementDefinitionPreflight", "CodeDb", "ManagedObjectCatalog"
    Err.Raise savedErrNumber, "ValidateManagedObjectPlacementDefinitionsForSetup", "Could not validate authoritative managed-object placement definitions before catalog placement updates." & vbCrLf & "Active non-system rows checked: " & CStr(checkedCount) & vbCrLf & "Add-In Review exact active matches: " & CStr(exactMatchCount) & vbCrLf & "Add-In Review definitions failing: " & CStr(addInReviewFailureCount) & vbCrLf & "Other placement definitions failing: " & CStr(generalFailureCount) & vbCrLf & "Original source: " & savedErrSource & vbCrLf & "Original description: " & savedErrDescription
End Sub

Private Sub ValidateManagedObjectPlacementResolverCoverageForSetup(Optional ByRef timingDetail As String = vbNullString, Optional ByVal includeManagedForms As Boolean = True)
    'Fails before Navigation Pane mutation or ribbon work when an active managed object lacks authoritative resolver coverage.
    On Error GoTo ErrHandler
    Dim snapshotRows As Collection
    Dim rowData As Variant
    Dim objectID As Long
    Dim objectName As String
    Dim logicalObjectName As String
    Dim objectTypeCode As String
    Dim categoryCode As String
    Dim catalogOwner As String
    Dim defaultSource As String
    Dim scopeCode As String
    Dim definitionLogicalIdentity As String
    Dim ribbonTabKey As String
    Dim ribbonTabLabel As String
    Dim ribbonGroupLabel As String
    Dim ribbonGroupSortOrder As Long
    Dim directlyExposedOnRibbon As Boolean
    Dim definitionSource As String
    Dim definitionMatched As Boolean
    Dim unresolvedCount As Long
    Dim checkedCount As Long
    Dim unresolvedText As String
    Dim rowText As String
    Dim missingComponents As String
    Dim storedTabKey As String
    Dim storedTabLabel As String
    Dim storedGroupLabel As String
    Dim storedGroupOrder As Long
    Dim operationTimer As Single
    Dim stageTimer As Single
    Dim unresolvedCollectionElapsedSeconds As Double
    Dim traceTimer As Single
    Dim failureMessage As String
    Dim snapshotDetail As String
    timingDetail = vbNullString
    operationTimer = Timer
    Set snapshotRows = EnsureManagedPlacementValidationSnapshot(includeManagedForms, snapshotDetail)
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, snapshotDetail)
    For Each rowData In snapshotRows
        PumpSetupResponsiveness
        stageTimer = Timer
        checkedCount = checkedCount + 1
        objectID = CLng(rowData(PLACEMENT_SNAPSHOT_ID))
        objectName = CStr(rowData(PLACEMENT_SNAPSHOT_OBJECT_NAME))
        logicalObjectName = CStr(rowData(PLACEMENT_SNAPSHOT_LOGICAL_NAME))
        objectTypeCode = CStr(rowData(PLACEMENT_SNAPSHOT_OBJECT_TYPE))
        categoryCode = CStr(rowData(PLACEMENT_SNAPSHOT_CATEGORY))
        catalogOwner = CStr(rowData(PLACEMENT_SNAPSHOT_CATALOG_OWNER))
        defaultSource = CStr(rowData(PLACEMENT_SNAPSHOT_DEFAULT_SOURCE))
        storedTabKey = CStr(rowData(PLACEMENT_SNAPSHOT_STORED_TAB_KEY))
        storedTabLabel = CStr(rowData(PLACEMENT_SNAPSHOT_STORED_TAB_LABEL))
        storedGroupLabel = CStr(rowData(PLACEMENT_SNAPSHOT_STORED_GROUP_LABEL))
        storedGroupOrder = CLng(rowData(PLACEMENT_SNAPSHOT_STORED_GROUP_ORDER))
        definitionLogicalIdentity = CStr(rowData(PLACEMENT_SNAPSHOT_DEFINITION_LOGICAL_NAME))
        scopeCode = CStr(rowData(PLACEMENT_SNAPSHOT_SCOPE))
        ribbonTabKey = CStr(rowData(PLACEMENT_SNAPSHOT_EXPECTED_TAB_KEY))
        ribbonTabLabel = CStr(rowData(PLACEMENT_SNAPSHOT_EXPECTED_TAB_LABEL))
        ribbonGroupLabel = CStr(rowData(PLACEMENT_SNAPSHOT_EXPECTED_GROUP_LABEL))
        ribbonGroupSortOrder = CLng(rowData(PLACEMENT_SNAPSHOT_EXPECTED_GROUP_ORDER))
        directlyExposedOnRibbon = CBool(rowData(PLACEMENT_SNAPSHOT_DIRECT_RIBBON))
        definitionSource = CStr(rowData(PLACEMENT_SNAPSHOT_DEFINITION_SOURCE))
        definitionMatched = CBool(rowData(PLACEMENT_SNAPSHOT_DEFINITION_MATCHED))
        missingComponents = CStr(rowData(PLACEMENT_SNAPSHOT_MISSING_COMPONENTS))
        If definitionMatched = False Or Len(missingComponents) > 0 Then
            unresolvedCount = unresolvedCount + 1
            rowText = "Unresolved placement resolver row " & CStr(unresolvedCount) & ": ID=" & CStr(objectID) & "; Object=" & IIf(Len(objectName) = 0, "(blank)", objectName) & "; LogicalIdentity=" & IIf(Len(logicalObjectName) = 0, IIf(Len(definitionLogicalIdentity) = 0, "(blank)", definitionLogicalIdentity), logicalObjectName) & "; Type=" & IIf(Len(objectTypeCode) = 0, "(blank)", objectTypeCode) & "; Category=" & IIf(Len(categoryCode) = 0, "(blank)", categoryCode) & "; Scope=" & IIf(Len(scopeCode) = 0, "(unrecognized)", scopeCode)
            rowText = rowText & vbCrLf & "  Stored override values: TabKey=" & IIf(Len(storedTabKey) = 0, "(blank)", storedTabKey) & "; TabLabel=" & IIf(Len(storedTabLabel) = 0, "(blank)", storedTabLabel) & "; Group=" & IIf(Len(storedGroupLabel) = 0, "(blank)", storedGroupLabel) & "; GroupOrder=" & CStr(storedGroupOrder)
            rowText = rowText & vbCrLf & "  Category-default values: (not defined; authoritative ribbon placement is object/scope resolved)"
            rowText = rowText & vbCrLf & "  Effective resolved values: TabKey=" & IIf(Len(ribbonTabKey) = 0, "(blank)", ribbonTabKey) & "; TabLabel=" & IIf(Len(ribbonTabLabel) = 0, "(blank)", ribbonTabLabel) & "; Group=" & IIf(Len(ribbonGroupLabel) = 0, "(blank)", ribbonGroupLabel) & "; GroupOrder=" & CStr(ribbonGroupSortOrder)
            rowText = rowText & vbCrLf & "  Placement definition matched=" & CStr(definitionMatched) & "; Matched definition source=" & IIf(Len(definitionSource) = 0, "(none)", definitionSource) & "; Direct ribbon exposure=" & CStr(directlyExposedOnRibbon) & "; Missing component=" & IIf(Len(missingComponents) = 0, "AuthoritativePlacementDefinition", missingComponents)
            rowText = rowText & vbCrLf & "  Ownership/provenance: CatalogOwner=" & IIf(Len(catalogOwner) = 0, "(blank)", catalogOwner) & "; DefaultSource=" & IIf(Len(defaultSource) = 0, "(blank)", defaultSource)
            If Len(unresolvedText) > 0 Then unresolvedText = unresolvedText & vbCrLf
            unresolvedText = unresolvedText & rowText
        End If
        unresolvedCollectionElapsedSeconds = unresolvedCollectionElapsedSeconds + ElapsedSecondsFromTimer(stageTimer)
        RequireSafeWorkContinue "ValidateManagedObjectPlacementResolverCoverageForSetup", objectTypeCode & " [" & objectName & "]"
    Next rowData
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Resolver coverage validation over shared snapshot: " & FormattedElapsedSeconds(unresolvedCollectionElapsedSeconds))
    If unresolvedCount > 0 Then
        stageTimer = Timer
        failureMessage = "Managed-object placement resolver coverage is incomplete." & vbCrLf & vbCrLf & "Active non-system rows checked: " & CStr(checkedCount) & vbCrLf & "Unresolved rows: " & CStr(unresolvedCount) & vbCrLf & vbCrLf & unresolvedText
        timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Failure-message construction: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
        Err.Raise vbObjectError + 9424, "ValidateManagedObjectPlacementResolverCoverageForSetup", failureMessage
    End If
    traceTimer = Timer
    LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "ValidateManagedObjectPlacementResolverCoverageForSetup", "Managed-object placement resolver coverage verified before Navigation Pane and ribbon work.", "Active non-system rows checked: " & CStr(checkedCount) & vbCrLf & "Unresolved rows: 0" & vbCrLf & "Shared placement snapshot reused by later B5 validators: True", "Validate placement resolver coverage", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitions", "CodeDb", "ManagedObjectCatalog"
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Validation completion trace write: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(traceTimer)))
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Setup B5 resolver validation total: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer)))
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Setup B5 resolver validation failed after: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer)))
    If IsCancellationError(savedErrNumber) Then Err.Raise savedErrNumber, savedErrSource, savedErrDescription
    Err.Raise savedErrNumber, "ValidateManagedObjectPlacementResolverCoverageForSetup", "Could not verify complete managed-object placement resolver coverage before Navigation Pane and ribbon work." & vbCrLf & "Rows checked: " & CStr(checkedCount) & vbCrLf & "Unresolved rows found: " & CStr(unresolvedCount) & vbCrLf & "Original source: " & savedErrSource & vbCrLf & "Original description: " & savedErrDescription
End Sub

Private Function BuildManagedObjectPlacementValidationDiagnostic(ByVal maximumRows As Long, ByRef invalidCount As Long, ByRef checkedCount As Long, Optional ByVal reuseCurrentPlacementSnapshot As Boolean = False) As String
    On Error GoTo ErrHandler
    Dim snapshotRows As Collection
    Dim rowData As Variant
    Dim objectID As Long
    Dim objectName As String
    Dim objectTypeCode As String
    Dim categoryCode As String
    Dim catalogOwner As String
    Dim defaultSource As String
    Dim managedStatus As String
    Dim currentSettingKey As String
    Dim expectedSettingKey As String
    Dim currentTabKey As String
    Dim currentTabLabel As String
    Dim currentGroupLabel As String
    Dim currentGroupOrder As Long
    Dim expectedTabKey As String
    Dim expectedTabLabel As String
    Dim expectedGroupLabel As String
    Dim expectedGroupOrder As Long
    Dim resolverScope As String
    Dim expectedRibbonResolved As Boolean
    Dim navigationGroupName As String
    Dim navigationResolved As Boolean
    Dim placementIncomplete As Boolean
    Dim ribbonRequired As Boolean
    Dim rowDetail As String
    Dim resultText As String
    Dim emittedCount As Long
    Dim lastDefaultRepairText As String
    Dim snapshotDetail As String
    If reuseCurrentPlacementSnapshot = False Then ClearManagedPlacementValidationSnapshot
    Set snapshotRows = EnsureManagedPlacementValidationSnapshot(True, snapshotDetail)
    For Each rowData In snapshotRows
        PumpSetupResponsiveness
        checkedCount = checkedCount + 1
        objectID = CLng(rowData(PLACEMENT_SNAPSHOT_ID))
        objectName = CStr(rowData(PLACEMENT_SNAPSHOT_OBJECT_NAME))
        objectTypeCode = CStr(rowData(PLACEMENT_SNAPSHOT_OBJECT_TYPE))
        categoryCode = CStr(rowData(PLACEMENT_SNAPSHOT_CATEGORY))
        catalogOwner = CStr(rowData(PLACEMENT_SNAPSHOT_CATALOG_OWNER))
        defaultSource = CStr(rowData(PLACEMENT_SNAPSHOT_DEFAULT_SOURCE))
        managedStatus = ADCAT_STATUS_ACTIVE
        currentSettingKey = CStr(rowData(PLACEMENT_SNAPSHOT_STORED_NAV_SETTING))
        currentTabKey = CStr(rowData(PLACEMENT_SNAPSHOT_STORED_TAB_KEY))
        currentTabLabel = CStr(rowData(PLACEMENT_SNAPSHOT_STORED_TAB_LABEL))
        currentGroupLabel = CStr(rowData(PLACEMENT_SNAPSHOT_STORED_GROUP_LABEL))
        currentGroupOrder = CLng(rowData(PLACEMENT_SNAPSHOT_STORED_GROUP_ORDER))
        lastDefaultRepairText = DiagnosticDateText(rowData(PLACEMENT_SNAPSHOT_LAST_DEFAULT_REPAIR))
        resolverScope = CStr(rowData(PLACEMENT_SNAPSHOT_SCOPE))
        expectedSettingKey = CStr(rowData(PLACEMENT_SNAPSHOT_EXPECTED_NAV_SETTING))
        expectedTabKey = CStr(rowData(PLACEMENT_SNAPSHOT_EXPECTED_TAB_KEY))
        expectedTabLabel = CStr(rowData(PLACEMENT_SNAPSHOT_EXPECTED_TAB_LABEL))
        expectedGroupLabel = CStr(rowData(PLACEMENT_SNAPSHOT_EXPECTED_GROUP_LABEL))
        expectedGroupOrder = CLng(rowData(PLACEMENT_SNAPSHOT_EXPECTED_GROUP_ORDER))
        expectedRibbonResolved = (Len(expectedTabKey) > 0 And Len(expectedTabLabel) > 0 And Len(expectedGroupLabel) > 0 And expectedGroupOrder > 0)
        navigationGroupName = vbNullString
        If Len(currentSettingKey) > 0 Then navigationGroupName = ManagedObjectDefaultNavigationPaneGroupName(objectName, objectTypeCode)
        navigationResolved = (Len(navigationGroupName) > 0)
        ribbonRequired = Not ManagedObjectIsRibbonExcludedByPolicy(objectName, objectTypeCode)
        placementIncomplete = (Len(objectName) = 0 Or Len(objectTypeCode) = 0 Or Len(currentSettingKey) = 0 Or navigationResolved = False Or Len(currentTabKey) = 0 Or Len(currentTabLabel) = 0 Or Len(currentGroupLabel) = 0 Or currentGroupOrder <= 0)
        If placementIncomplete Then
            invalidCount = invalidCount + 1
            If emittedCount < maximumRows Then
                emittedCount = emittedCount + 1
                rowDetail = "Invalid placement " & CStr(invalidCount) & ": ID=" & CStr(objectID) & "; Object=" & IIf(Len(objectName) = 0, "(blank)", objectName) & "; Type=" & IIf(Len(objectTypeCode) = 0, "(blank)", objectTypeCode) & "; Category=" & IIf(Len(categoryCode) = 0, "(blank)", categoryCode) & "; Status=" & IIf(Len(managedStatus) = 0, "(blank)", managedStatus)
                rowDetail = rowDetail & vbCrLf & "  Ownership/provenance: CatalogOwner=" & IIf(Len(catalogOwner) = 0, "(blank)", catalogOwner) & "; DefaultSource=" & IIf(Len(defaultSource) = 0, "(blank)", defaultSource) & "; LastDefaultRepairOn=" & lastDefaultRepairText
                rowDetail = rowDetail & vbCrLf & "  Current placement: Setting=" & IIf(Len(currentSettingKey) = 0, "(blank)", currentSettingKey) & "; ResolvedNavigationGroup=" & IIf(navigationResolved, navigationGroupName, "(not resolved)") & "; TabKey=" & IIf(Len(currentTabKey) = 0, "(blank)", currentTabKey) & "; TabLabel=" & IIf(Len(currentTabLabel) = 0, "(blank)", currentTabLabel) & "; Group=" & IIf(Len(currentGroupLabel) = 0, "(blank)", currentGroupLabel) & "; GroupOrder=" & CStr(currentGroupOrder)
                rowDetail = rowDetail & vbCrLf & "  Resolver expectation: Scope=" & IIf(Len(resolverScope) = 0, "(unrecognized)", resolverScope) & "; Setting=" & expectedSettingKey & "; DirectRibbonExposure=" & CStr(ribbonRequired) & "; RibbonResolved=" & CStr(expectedRibbonResolved) & "; TabKey=" & IIf(Len(expectedTabKey) = 0, "(unresolved)", expectedTabKey) & "; TabLabel=" & IIf(Len(expectedTabLabel) = 0, "(unresolved)", expectedTabLabel) & "; Group=" & IIf(Len(expectedGroupLabel) = 0, "(unresolved)", expectedGroupLabel) & "; GroupOrder=" & CStr(expectedGroupOrder)
                If Len(resultText) > 0 Then resultText = resultText & vbCrLf
                resultText = resultText & rowDetail
            End If
        End If
    Next rowData
    BuildManagedObjectPlacementValidationDiagnostic = "Managed-object placement validation snapshot:" & vbCrLf & "Active non-system rows checked: " & CStr(checkedCount) & vbCrLf & "Invalid rows: " & CStr(invalidCount) & IIf(invalidCount = 0, vbCrLf & "All active non-system managed objects have explicit, resolvable Navigation Pane and Ribbon group assignments; direct Ribbon exposure is independently defined by the canonical object definition.", vbCrLf & resultText & IIf(invalidCount > emittedCount, vbCrLf & "Additional invalid rows omitted: " & CStr(invalidCount - emittedCount), vbNullString))
    BuildManagedObjectPlacementValidationDiagnostic = BuildManagedObjectPlacementValidationDiagnostic & vbCrLf & snapshotDetail
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    Err.Raise savedErrNumber, "BuildManagedObjectPlacementValidationDiagnostic", "Could not build the complete active managed-object placement diagnostic snapshot." & vbCrLf & "Rows checked: " & CStr(checkedCount) & vbCrLf & "Invalid rows identified: " & CStr(invalidCount) & vbCrLf & "Current object: " & IIf(Len(objectName) = 0, "(none)", objectName) & vbCrLf & "Original source: " & savedErrSource & vbCrLf & "Description: " & savedErrDescription
End Function

' Purpose: Validates every active non-system managed object and reports the complete invalid placement set instead of stopping at the first row.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   showMessage (Input Optional; Boolean): Controls whether the routine displays its normal user-facing status, completion, warning, or error message; False suppresses that presentation while preserving the
'   underlying operation. Default: True.
'   raiseOnFailure (Input Optional; Boolean): When True, enables or requests on failure for this call; when False, the routine follows its normal non-forced/default path. Default: False.
'   reuseCurrentPlacementSnapshot (Input Optional; Boolean): When True, enables or requests current placement snapshot for this call; when False, the routine follows its normal non-forced/default path. Default:
'   False.
' Returns: Boolean result of validate managed object placement metadata; True and False correspond to the affirmative and negative branches explicitly implemented by this function.
'   not-applicable path.
Public Function ValidateManagedObjectPlacementMetadata(Optional ByVal showMessage As Boolean = True, Optional ByVal raiseOnFailure As Boolean = False, Optional ByVal reuseCurrentPlacementSnapshot As Boolean = False) As Boolean
    'Validates every active non-system managed object and reports the complete invalid placement set instead of stopping at the first row.
    On Error GoTo ErrHandler
    Dim invalidCount As Long
    Dim checkedCount As Long
    Dim diagnosticText As String
    diagnosticText = BuildManagedObjectPlacementValidationDiagnostic(50, invalidCount, checkedCount, reuseCurrentPlacementSnapshot)
    ValidateManagedObjectPlacementMetadata = (invalidCount = 0)
    If ValidateManagedObjectPlacementMetadata Then Exit Function
    LogTraceMessage TRACE_LEVEL_ERROR, "Preflight", "ValidateManagedObjectPlacementMetadata", "Managed-object placement metadata validation failed.", diagnosticText, "Validate complete active placement snapshot", vbObjectError + 8763, "ValidateManagedObjectPlacementMetadata", "One or more active managed objects have invalid placement metadata.", ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "Table", "CodeDb", "Tables"
    If showMessage Then
        CoreShowErrorMessage diagnosticText, vbCritical, "Managed Object Placement Validation", "ValidateManagedObjectPlacementMetadata", "Tables"
        Exit Function
    End If
    If raiseOnFailure Then
        On Error GoTo 0
        Err.Raise vbObjectError + 8763, "ValidateManagedObjectPlacementMetadata", diagnosticText
    End If
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    diagnosticText = "Placement metadata validation could not complete." & vbCrLf & "Rows checked before failure: " & CStr(checkedCount) & vbCrLf & "Invalid rows identified before failure: " & CStr(invalidCount) & vbCrLf & "Original Err.Number: " & CStr(savedErrNumber) & vbCrLf & "Original Err.Source: " & savedErrSource & vbCrLf & "Original Err.Description: " & savedErrDescription & IIf(Len(Trim$(diagnosticText)) = 0, vbNullString, vbCrLf & vbCrLf & "Partial diagnostic snapshot:" & vbCrLf & diagnosticText)
    On Error Resume Next
    LogTraceMessage TRACE_LEVEL_ERROR, "Preflight", "ValidateManagedObjectPlacementMetadata", "Managed-object placement metadata validation could not complete.", diagnosticText, "Build complete active placement snapshot", savedErrNumber, savedErrSource, savedErrDescription, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "Table", "CodeDb", "Tables"
    On Error GoTo 0
    If showMessage Then
        CoreShowErrorMessage diagnosticText, vbCritical, "Managed Object Placement Validation", "ValidateManagedObjectPlacementMetadata", "Tables"
        Exit Function
    End If
    If raiseOnFailure Then Err.Raise savedErrNumber, "ValidateManagedObjectPlacementMetadata", diagnosticText
End Function

' Purpose: Returns the same complete placement evidence used by the blocking ribbon preflight so failure diagnostics cannot disagree with validation.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   maximumRows (Input Optional; Long): Upper bound limiting the maximum rows quantity scanned, displayed, or processed by this call. Default: 50.
' Returns: String: Returns formatted managed object placement diagnostic text text intended for tracing, diagnostics, or user-facing reporting; vbNullString is returned when there is nothing applicable to
'   report.
Public Function ManagedObjectPlacementDiagnosticText(Optional ByVal maximumRows As Long = 50) As String
    'Returns the same complete placement evidence used by the blocking ribbon preflight so failure diagnostics cannot disagree with validation.
    On Error GoTo ErrHandler
    Dim invalidCount As Long
    Dim checkedCount As Long
    If maximumRows < 1 Then maximumRows = 1
    ManagedObjectPlacementDiagnosticText = BuildManagedObjectPlacementValidationDiagnostic(maximumRows, invalidCount, checkedCount)
    Exit Function
ErrHandler:
    ManagedObjectPlacementDiagnosticText = "Managed-object placement diagnostic collection failed. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
End Function

' Purpose: Validates managed object catalog for setup.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   showMessage (Input Optional; Boolean): Controls whether the routine displays its normal user-facing status, completion, warning, or error message; False suppresses that presentation while preserving the
'   underlying operation. Default: False.
'   detailsForMessage (Output Optional; String): Receives detail text formatted for inclusion in the caller's user-facing message. Default: vbNullString.
' Returns: Boolean: True on the function's affirmative/success branch for validate managed object catalog for setup; False on its explicit negative, unavailable, rejected, or handled-failure branch.
'   not-applicable path.
Public Function ValidateManagedObjectCatalogForSetup(Optional ByVal showMessage As Boolean = False, Optional ByRef detailsForMessage As String = vbNullString) As Boolean
    RequireCatalogSetupPhaseReady "ValidateManagedObjectCatalogForSetup"
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim refreshedSnapshot As CatalogDomainSnapshot
    Dim completeFallbackSnapshot As CatalogDomainSnapshot
    Dim phaseTimer As Single
    Dim refreshDetail As String
    Dim databaseReferenceDetail As String
    Dim databaseReferenceInventoryChanged As Boolean
    Dim databaseReferenceDirtyPublished As Boolean
    Dim partialRefreshUsed As Boolean
    Dim completeFallbackUsed As Boolean
    detailsForMessage = vbNullString
    EnsureCatalogSetupPhaseState
    If mCatalogSetupDefinitionsComplete = False Then Err.Raise vbObjectError + 9412, "ValidateManagedObjectCatalogForSetup", "Phase-B managed definitions and non-form placement coverage did not complete before catalog validation."
    phaseTimer = Timer
    Set db = ResolveCatalogDb()
    CorePulseProgress "Validating Phase-B non-form managed rows, dependencies, System Macro and Help Document Macro payloads, and Database Reference field index."
    RepairManagedObjectDependencyDocumentationStatusForSetup db
    ValidateNonFormManagedObjectRows db
    ValidateNonFormDependencies db
    ValidateSystemHelpManagedDefinitions db, CoreSetupHelpDocumentSynchronizationScope()
    ValidateManagedObjectRibbonStaticTags db, False
    ValidateManagedObjectPlacementDefinitionsForSetup True, False
    SynchronizeNonFormDatabaseReferenceFieldIndexForSetup db, databaseReferenceDetail, databaseReferenceInventoryChanged
    If databaseReferenceInventoryChanged Then
        CatalogMarkSetupDomainsDirty CATALOG_DIRTY_INVENTORY
        databaseReferenceDirtyPublished = True
    End If
    If mCatalogSetupDirtyDomainMask = 0 Then
        CatalogCopyDomainSnapshot mCatalogSetupSnapshot, refreshedSnapshot
        refreshDetail = "No Phase-B non-form catalog subdomain required recalculation."
    Else
        partialRefreshUsed = RefreshCatalogDirtyDomainSnapshot(mCatalogSetupSnapshot, refreshedSnapshot, refreshDetail)
        If partialRefreshUsed = False Then
            completeFallbackUsed = True
            If CalculateCatalogDomainSnapshot(completeFallbackSnapshot) = False Then Err.Raise vbObjectError + 9410, "ValidateManagedObjectCatalogForSetup", "Phase-B catalog repair completed, but exact subdomain fingerprints could not be refreshed. " & completeFallbackSnapshot.failureDetail
            CatalogCopyDomainSnapshot completeFallbackSnapshot, refreshedSnapshot
        End If
    End If
    PersistNonFormCatalogDomainSnapshot refreshedSnapshot
    CatalogCopyDomainSnapshot refreshedSnapshot, mCatalogSetupSnapshot
    mCatalogSetupSchemaMatches = True
    mCatalogSetupDefaultsMatches = True
    mCatalogSetupCoreInventoryMatches = True
    mCatalogSetupUiInventoryMatches = True
    mCatalogSetupMacroInventoryMatches = True
    mCatalogSetupCorePayloadMatches = True
    mCatalogSetupUiPayloadMatches = True
    mCatalogSetupMacroPayloadMatches = True
    mCatalogSetupQueryMatches = True
    mCatalogSetupInventoryMatches = False
    mCatalogSetupFormsInventoryMatches = False
    mCatalogSetupDependencyMatches = False
    mCatalogSetupPayloadMatches = False
    mCatalogSetupFormsPayloadMatches = False
    mCatalogSetupUiMatches = False
    mCatalogSetupFormsMatches = False
    mCatalogSetupValidationMatches = False
    mCatalogSetupSystemMacroInputsChanged = False
    mCatalogSetupDirtyDomainMask = 0
    detailsForMessage = "Phase-B non-form catalog validation: Passed" & vbCrLf & _
        "Managed rows: non-form identity/duplicate checks passed" & vbCrLf & _
        "Dependencies: non-form integrity/duplicate checks passed" & vbCrLf & _
        "System Macro and Help Document Macro definitions: managed RunCode payloads match authoritative source" & vbCrLf & _
        "Database Reference: non-form table/query physical-field index evidence passed" & vbCrLf & databaseReferenceDetail & vbCrLf & _
        "Persisted proof: schema/defaults, core/UI/macro inventory, core/UI/macro payloads, support queries" & vbCrLf & _
        "Form-inclusive inventory/payload/UI/dependency/full-validation tokens: explicitly invalidated for D4" & vbCrLf & _
        "Fingerprint refresh: " & IIf(completeFallbackUsed, "complete fallback", IIf(partialRefreshUsed, "selective", "not required")) & vbCrLf & refreshDetail & vbCrLf & _
        "Elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(phaseTimer))
    LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "ValidateManagedObjectCatalogForSetup", "Phase-B non-form catalog validation completed.", detailsForMessage, "Non-form catalog validation", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogValidationNonForm", "CodeDb", "ManagedObjectCatalog"
    If showMessage Then CoreShowMessage detailsForMessage, vbInformation, "Managed Object Catalog", "ShowADCMessage", "Tables"
    ValidateManagedObjectCatalogForSetup = True
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    If databaseReferenceInventoryChanged And databaseReferenceDirtyPublished = False Then CatalogMarkSetupDomainsDirty CATALOG_DIRTY_INVENTORY
    detailsForMessage = "Phase-B non-form catalog validation failed." & vbCrLf & "Err.Number: " & CStr(savedErrNumber) & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
    LogTraceMessage TRACE_LEVEL_ERROR, "ManagedObjectCatalog", "ValidateManagedObjectCatalogForSetup", "Phase-B non-form catalog validation failed.", detailsForMessage, "Non-form catalog validation", savedErrNumber, savedErrSource, savedErrDescription, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogValidationNonForm", "CodeDb", "ManagedObjectCatalog"
    If showMessage Then CoreShowErrorMessage detailsForMessage, vbCritical, "Managed Object Catalog", "ValidateManagedObjectCatalogForSetup", "Tables": Exit Function
    Err.Raise savedErrNumber, "ValidateManagedObjectCatalogForSetup", detailsForMessage
End Function

Private Sub RepairManagedObjectCatalogStructureCore(ByRef metrics As TPart8Metrics)
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim operationTraceSuppressionStarted As Boolean
    Dim lookupMatched As Boolean
    Dim coreMatched As Boolean
    Dim macroMatched As Boolean
    Dim systemMacroMatched As Boolean
    Dim helpMatched As Boolean
    Dim lookupToken As String
    Dim coreToken As String
    Dim macroToken As String
    Dim systemMacroToken As String
    Dim helpToken As String
    Dim matchedNames As String
    Dim repairedNames As String
    Dim timingText As String
    Dim stageTimer As Single
    Dim proofTimer As Single
    Dim operationTimer As Single
    Dim lookupTableNames As Variant
    Dim coreTableNames As Variant
    Dim macroClassificationTableNames As Variant
    Dim systemMacroTableNames As Variant
    Dim helpDocumentTableNames As Variant
    Dim structuralFamilyCount As Long
    Dim coldCreateDetail As String
    Dim coldTablesCreated As Long
    Dim coldFieldsCreated As Long
    Dim coldIndexesCreated As Long
    Dim lookupDefinitionIndex As Object
    Dim terminologySchemaDefinitions As Collection
    Dim terminologyIndexDefinitions As Collection
    Set db = ResolveCatalogDb()
    ResetB1ColdCreateStructuralProof
    mB1StructureOnly = True
    operationTimer = Timer
    stageTimer = Timer
    ResolvePart8FamilyTableNames lookupTableNames, coreTableNames, macroClassificationTableNames, systemMacroTableNames, helpDocumentTableNames, structuralFamilyCount
    timingText = SharedText_AppendNonBlankLine(timingText, "One-pass B1 canonical family snapshot: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    metrics.FamiliesMatched = 0
    metrics.FamiliesRepaired = 0
    metrics.TableHeadersInspected = 0
    metrics.RelationshipDefinitionsInspected = 0
    metrics.TablesSentToRepair = 0
    metrics.FamilyDetail = vbNullString
    stageTimer = Timer
    lookupMatched = Part8FamilyProofMatches(db, PART8_LOOKUP_STRUCTURE_PROOF_PROPERTY, PART8_LOOKUP_STRUCTURE_CONTRACT, lookupTableNames, False, lookupToken, metrics)
    timingText = SharedText_AppendNonBlankLine(timingText, "Lookup-table family proof check: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    stageTimer = Timer
    coreMatched = B1CoreStructureProofMatches(db, coreTableNames, coreToken, metrics)
    timingText = SharedText_AppendNonBlankLine(timingText, "Core-table family proof check: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    stageTimer = Timer
    macroMatched = B1MacroClassificationProofMatches(db, macroClassificationTableNames, macroToken, metrics)
    If macroMatched = False Then
        Dim macroClassificationDetail As String
        If MacroClassificationStateCurrentForB1(macroClassificationDetail) = False Then Err.Raise vbObjectError + 9614, "RepairManagedObjectCatalogStructureCore", "B1 prerequisite failed because the A2-owned macro-classification domain is not current. B1 will not repair predecessor-owned structure." & vbCrLf & macroClassificationDetail
        B1PersistMacroClassificationProof db, macroClassificationTableNames, metrics, macroToken
        macroMatched = True
        AddTraceNote "B1 verified the A2-owned macro-classification table/schema structure read-only and persisted its exact predecessor proof; B5 owns canonical relationship creation and repair."
    End If
    timingText = SharedText_AppendNonBlankLine(timingText, "Macro-classification predecessor verification/proof: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    timingText = SharedText_AppendNonBlankLine(timingText, "Config lookup-metadata family: delegated to B2")
    stageTimer = Timer
    systemMacroMatched = Part8FamilyProofMatches(db, PART8_SYSTEM_MACRO_PROOF_PROPERTY, PART8_SYSTEM_MACRO_CONTRACT, systemMacroTableNames, False, systemMacroToken, metrics)
    timingText = SharedText_AppendNonBlankLine(timingText, "MC_Sys family proof check: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    stageTimer = Timer
    helpMatched = Part8FamilyProofMatches(db, PART8_HELP_DOCUMENT_PROOF_PROPERTY, PART8_HELP_DOCUMENT_CONTRACT, helpDocumentTableNames, False, helpToken, metrics)
    timingText = SharedText_AppendNonBlankLine(timingText, "Help_Docs family proof check: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    If lookupMatched = False Then
        coreMatched = False
        Set lookupDefinitionIndex = CatalogSimpleLookupDefinitionIndex()
    End If
    If coreMatched = False Then
        Set terminologySchemaDefinitions = TerminologyFieldSchemaDefinitions()
        Set terminologyIndexDefinitions = TerminologyIndexSchemaDefinitions()
        RequireSetupPreflightTerminologyBackupCoverage terminologySchemaDefinitions, terminologyIndexDefinitions
    End If
    If lookupMatched Then metrics.FamiliesMatched = metrics.FamiliesMatched + 1: matchedNames = Part8AppendListItem(matchedNames, "LookupTables")
    If coreMatched Then metrics.FamiliesMatched = metrics.FamiliesMatched + 1: matchedNames = Part8AppendListItem(matchedNames, "CoreTables")
    If macroMatched Then metrics.FamiliesMatched = metrics.FamiliesMatched + 1: matchedNames = Part8AppendListItem(matchedNames, "MacroClassification")
    If systemMacroMatched Then metrics.FamiliesMatched = metrics.FamiliesMatched + 1: matchedNames = Part8AppendListItem(matchedNames, "SystemMacroCatalog")
    If helpMatched Then metrics.FamiliesMatched = metrics.FamiliesMatched + 1: matchedNames = Part8AppendListItem(matchedNames, "HelpDocCatalog")
    If lookupMatched And coreMatched And macroMatched And systemMacroMatched And helpMatched Then
        metrics.FamilyDetail = "B1 structural family proofs matched." & vbCrLf & "Families matched: " & CStr(structuralFamilyCount) & vbCrLf & "Families repaired: 0" & vbCrLf & "Matched families: " & matchedNames & vbCrLf & "Table headers inspected: " & CStr(metrics.TableHeadersInspected) & vbCrLf & "Relationship definitions inspected: " & CStr(metrics.RelationshipDefinitionsInspected) & vbCrLf & "Tables sent to detailed repair paths: 0" & vbCrLf & timingText & vbCrLf & "B1 family gate total: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer))
        LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "RepairManagedObjectCatalogStructureCore", "B1 structural family fast path used.", metrics.FamilyDetail, "B1 structural family gate", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogStructure", "CodeDb", "Performance"
        mB1StructureOnly = False
        Exit Sub
    End If
    PrepareOpenCatalogTablesForDesignChange "repairing only dirty Managed Object Catalog structural families", lookupTableNames, coreTableNames, macroClassificationTableNames, systemMacroTableNames, helpDocumentTableNames
    mCatalogDesignBatchPrepared = True
    BeginOperationDetailTraceSuppression
    operationTraceSuppressionStarted = True
    stageTimer = Timer
    coldCreateDetail = PrepareCanonicalColdCreateBatch(lookupTableNames, coreTableNames, systemMacroTableNames, helpDocumentTableNames, coldTablesCreated, coldFieldsCreated, coldIndexesCreated, lookupDefinitionIndex)
    mB1ColdCreateStructuralBypassActive = (coldTablesCreated > 0)
    timingText = SharedText_AppendNonBlankLine(timingText, "Canonical cold-create batch: " & coldCreateDetail & "; elapsed=" & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    If lookupMatched = False Then
        stageTimer = Timer
        CorePulseProgress "Repair dirty managed object catalog lookup-table family."
        AddTraceNote "Repair dirty managed object catalog lookup-table family."
        RepairManagedObjectCatalogLookupTables lookupTableNames, lookupDefinitionIndex
        Part8PersistFamilyProof db, PART8_LOOKUP_STRUCTURE_PROOF_PROPERTY, PART8_LOOKUP_STRUCTURE_CONTRACT, lookupTableNames, False, metrics
        metrics.FamiliesRepaired = metrics.FamiliesRepaired + 1
        metrics.TablesSentToRepair = metrics.TablesSentToRepair + Part8ArrayCount(lookupTableNames)
        repairedNames = Part8AppendListItem(repairedNames, "LookupTables")
        timingText = SharedText_AppendNonBlankLine(timingText, "Lookup-table family repair and proof persistence: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    End If
    If coreMatched = False Then
        stageTimer = Timer
        CorePulseProgress "Repair dirty managed object catalog core-table family."
        AddTraceNote "Repair dirty managed object catalog core-table family."
        RepairManagedObjectCatalogCoreTables coreTableNames, terminologySchemaDefinitions, terminologyIndexDefinitions
        EnsureTerminologyReviewQueryForSetup
        db.QueryDefs.Refresh
        proofTimer = Timer
        ReportB1PostCoreStageBoundary "CoreTablesProof", "B1 core-table and " & ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_Terminology_Review") & " proof persistence starting."
        PersistB1CoreStructureProof db, coreTableNames, metrics
        ReportB1PostCoreStageBoundary "CoreTablesProof", "B1 core-table proof persistence completed.", ElapsedSecondsFromTimer(proofTimer)
        metrics.FamiliesRepaired = metrics.FamiliesRepaired + 1
        metrics.TablesSentToRepair = metrics.TablesSentToRepair + Part8ArrayCount(coreTableNames)
        repairedNames = Part8AppendListItem(repairedNames, "CoreTables")
        timingText = SharedText_AppendNonBlankLine(timingText, "Core-table family repair and proof persistence: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    End If
    If systemMacroMatched = False Then
        stageTimer = Timer
        ReportB1PostCoreStageBoundary "SystemMacroCatalog", "B1 System Macro catalog family repair and proof persistence starting."
        AddTraceNote "B1 owns only [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & "] table structure; canonical system-macro source rows remain deferred to B4."
        RepairManagedObjectCatalogSystemMacroTables systemMacroTableNames
        Part8PersistFamilyProof db, PART8_SYSTEM_MACRO_PROOF_PROPERTY, PART8_SYSTEM_MACRO_CONTRACT, systemMacroTableNames, False, metrics
        ReportB1PostCoreStageBoundary "SystemMacroCatalog", "B1 System Macro catalog family repair and proof persistence completed.", ElapsedSecondsFromTimer(stageTimer)
        metrics.FamiliesRepaired = metrics.FamiliesRepaired + 1
        metrics.TablesSentToRepair = metrics.TablesSentToRepair + Part8ArrayCount(systemMacroTableNames)
        repairedNames = Part8AppendListItem(repairedNames, "SystemMacroCatalog")
        timingText = SharedText_AppendNonBlankLine(timingText, "MC_Sys family repair and proof persistence: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    End If
    If helpMatched = False Then
        stageTimer = Timer
        ReportB1PostCoreStageBoundary "HelpDocCatalog", "B1 Help Doc catalog family repair and proof persistence starting."
        RepairManagedObjectCatalogHelpDocumentTables helpDocumentTableNames
        Part8PersistFamilyProof db, PART8_HELP_DOCUMENT_PROOF_PROPERTY, PART8_HELP_DOCUMENT_CONTRACT, helpDocumentTableNames, False, metrics, , helpToken
        ReportB1PostCoreStageBoundary "HelpDocCatalog", "B1 Help Doc catalog family repair and proof persistence completed.", ElapsedSecondsFromTimer(stageTimer)
        metrics.FamiliesRepaired = metrics.FamiliesRepaired + 1
        metrics.TablesSentToRepair = metrics.TablesSentToRepair + Part8ArrayCount(helpDocumentTableNames)
        repairedNames = Part8AppendListItem(repairedNames, "HelpDocCatalog")
        timingText = SharedText_AppendNonBlankLine(timingText, "Help_Docs family repair and proof persistence: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    End If
    EndOperationDetailTraceSuppression
    operationTraceSuppressionStarted = False
    timingText = SharedText_AppendNonBlankLine(timingText, "Cold-created structural repair bypass: " & B1ColdCreateStructuralBypassDetail())
    mCatalogDesignBatchPrepared = False
    mB1ColdCreateStructuralBypassActive = False
    metrics.FamilyDetail = "B1 structural family comparison and dirty-only repair completed." & vbCrLf & "Families matched: " & CStr(metrics.FamiliesMatched) & vbCrLf & "Families repaired: " & CStr(metrics.FamiliesRepaired) & vbCrLf & "Matched families: " & IIf(Len(matchedNames) = 0, "<none>", matchedNames) & vbCrLf & "Repaired families: " & IIf(Len(repairedNames) = 0, "<none>", repairedNames) & vbCrLf & "Table headers inspected: " & CStr(metrics.TableHeadersInspected) & vbCrLf & "Relationship definitions inspected: " & CStr(metrics.RelationshipDefinitionsInspected) & vbCrLf & "Tables sent to detailed repair paths: " & CStr(metrics.TablesSentToRepair) & vbCrLf & timingText & vbCrLf & "B1 family gate and dirty repair total: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer))
    LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "RepairManagedObjectCatalogStructureCore", "Catalog structural family delta completed.", metrics.FamilyDetail, "B1 structural family gate", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogStructure", "CodeDb", "Performance"
    ResetB1ColdCreateStructuralProof
    mB1StructureOnly = False
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    mCatalogDesignBatchPrepared = False
    ResetB1ColdCreateStructuralProof
    mB1StructureOnly = False
    If operationTraceSuppressionStarted Then
        EndOperationDetailTraceSuppression
        operationTraceSuppressionStarted = False
    End If
    Err.Raise savedErrNumber, "RepairManagedObjectCatalogStructureCore", "Managed Object Catalog structural family comparison or repair failed." & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Sub

Private Sub RepairManagedObjectCatalogHelpDocumentTables(ByVal tableNames As Variant)
    Dim tableName As Variant
    For Each tableName In tableNames
        Select Case CStr(tableName)
            Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HelpDocuments")
                RepairHelpDocumentsTable False, False, False
            Case Else
                Err.Raise vbObjectError + 9500, "RepairManagedObjectCatalogHelpDocumentTables", "The canonical B1 help-document family contains a table with no repair implementation mapping." & vbCrLf & "Table: " & CStr(tableName)
        End Select
    Next tableName
End Sub

Private Sub RepairManagedObjectCatalogLookupTables(ByVal tableNames As Variant, ByVal lookupDefinitionIndex As Object)
    Dim tableName As Variant
    For Each tableName In tableNames
        RepairManagedObjectCatalogLookupTable CStr(tableName), lookupDefinitionIndex
    Next tableName
End Sub

Private Sub RepairManagedObjectCatalogLookupTable(ByVal tableName As String, ByVal lookupDefinitionIndex As Object)
    Dim codeFieldName As String
    Dim displayFieldName As String
    Select Case tableName
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SetupActions")
            EnsureSetupActionsTable lookupDefinitionIndex
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_FormTypes")
            EnsureSimpleLookupTable ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_FormTypes"), FIELD_FORM_TYPE_CODE, FIELD_FORM_TYPE_NAME, lookupDefinitionIndex
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_NavigationPaneGroups")
            'UI_Groups is a runtime catalog table, but it is also the lookup source for category, managed-object, config, and form Navigation Pane selections.
            EnsureNavigationPaneGroupsTable
        Case Else
            If CatalogSimpleLookupFieldNames(tableName, codeFieldName, displayFieldName, lookupDefinitionIndex) = False Then Err.Raise vbObjectError + 9496, "RepairManagedObjectCatalogLookupTable", "The canonical B1 lookup family contains a table with no repair implementation mapping." & vbCrLf & "Table: " & tableName
            EnsureSimpleLookupTable tableName, codeFieldName, displayFieldName, lookupDefinitionIndex
    End Select
End Sub

Private Sub RepairManagedObjectCatalogCoreTables(ByVal tableNames As Variant, ByVal terminologySchemaDefinitions As Collection, ByVal terminologyIndexDefinitions As Collection)
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim stageTimer As Single
    Dim timingText As String
    Dim timingLabel As String
    Dim operationTimer As Single
    Dim tableName As Variant
    Set db = ResolveCatalogDb()
    operationTimer = Timer
    For Each tableName In tableNames
        stageTimer = Timer
        timingLabel = RepairManagedObjectCatalogCoreTable(CStr(tableName), terminologySchemaDefinitions, terminologyIndexDefinitions)
        timingText = SharedText_AppendNonBlankLine(timingText, timingLabel & ": " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    Next tableName
    stageTimer = Timer
    db.TableDefs.Refresh
    timingText = SharedText_AppendNonBlankLine(timingText, "Whole core-table collection refresh after metadata repair: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    stageTimer = Timer
    AddTraceNote "Skipped Help_Docs in the core-table family repair; Help_Docs has a dedicated B1-owned family repair/proof path, and B2 later verifies that B1-owned structure before B2 work."
    timingText = timingText & vbCrLf & "Core-table repair total: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer))
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "RepairManagedObjectCatalogCoreTables", "Setup B1 core-table repair timing", timingText, "B1 core-table repair timing", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogStructure", "CodeDb", "Performance"
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    Err.Raise savedErrNumber, savedErrSource, savedErrDescription
End Sub

Private Function RepairManagedObjectCatalogCoreTable(ByVal tableName As String, ByVal terminologySchemaDefinitions As Collection, ByVal terminologyIndexDefinitions As Collection) As String
    Select Case tableName
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ObjectCategories")
            EnsureObjectCategoriesTable
            RepairManagedObjectCatalogCoreTable = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ObjectCategories")
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECT_OVERRIDES_TABLE_LOGICAL_ID)
            EnsureManagedObjectOverridesTable
            RepairManagedObjectCatalogCoreTable = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECT_OVERRIDES_TABLE_LOGICAL_ID)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID)
            EnsureManagedObjectsTable
            RepairManagedObjectCatalogCoreTable = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads")
            EnsureManagedObjectActionPayloadsTable
            RepairManagedObjectCatalogCoreTable = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads")
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies")
            EnsureManagedObjectDependenciesTable
            RepairManagedObjectCatalogCoreTable = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies")
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectFields")
            EnsureManagedObjectFieldsTable
            RepairManagedObjectCatalogCoreTable = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectFields")
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectFieldValues")
            EnsureManagedObjectFieldValuesTable
            RepairManagedObjectCatalogCoreTable = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectFieldValues")
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_RIBBON_BUTTON_TARGETS_TABLE_LOGICAL_ID)
            EnsureRibbonButtonTargetsTable
            RepairManagedObjectCatalogCoreTable = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_RIBBON_BUTTON_TARGETS_TABLE_LOGICAL_ID)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_TERMINOLOGY_TABLE_LOGICAL_ID)
            EnsureTerminologyTable False, terminologySchemaDefinitions, terminologyIndexDefinitions
            RepairManagedObjectCatalogCoreTable = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_TERMINOLOGY_TABLE_LOGICAL_ID)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_FormDefinitions")
            EnsureFormsTable
            RepairManagedObjectCatalogCoreTable = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_FormDefinitions")
        Case Else
            Err.Raise vbObjectError + 9497, "RepairManagedObjectCatalogCoreTable", "The canonical B1 core family contains a table with no repair implementation mapping." & vbCrLf & "Table: " & tableName
    End Select
End Function

Private Sub DefaultManagedObjectCatalogLookups(ByVal repairDefaultRows As Boolean)
    Dim defaultRow As Variant
    For Each defaultRow In CatalogSetupActionDefinitions()
        DefaultCatalogSetupAction CStr(defaultRow(0)), CStr(defaultRow(1)), CStr(defaultRow(2)), CLng(defaultRow(3)), repairDefaultRows
    Next defaultRow
    For Each defaultRow In CatalogLookupDefinitions()
        DefaultLookupRow CStr(defaultRow(0)), CStr(defaultRow(1)), CStr(defaultRow(2)), CStr(defaultRow(3)), CStr(defaultRow(4)), CStr(defaultRow(5)), CLng(defaultRow(6)), repairDefaultRows, CStr(defaultRow(7))
    Next defaultRow
End Sub

Private Sub DefaultManagedObjectCatalogCategories(ByVal repairDefaultRows As Boolean)
    Dim defaultRow As Variant
    For Each defaultRow In CatalogObjectCategoryDefinitions()
        DefaultObjectCategory CStr(defaultRow(0)), CStr(defaultRow(1)), CStr(defaultRow(2)), CLng(defaultRow(3)), CStr(defaultRow(4)), CStr(defaultRow(5)), CStr(defaultRow(6)), CStr(defaultRow(7)), CStr(defaultRow(8)), CStr(defaultRow(9)), CStr(defaultRow(10)), CStr(defaultRow(11)), repairDefaultRows
    Next defaultRow
