Private Sub DefaultHelpDocumentManagedObjectRows(ByVal repairDefaultRows As Boolean, ByVal synchronizationScope As HelpDocumentSynchronizationScope)
    On Error GoTo ErrHandler
    Dim rs As DAO.Recordset
    Dim MacroTitle As String
    Dim helpDocumentKey As String
    Dim runCodeExpression As String
    Dim tooltipText As String
    Dim SortOrder As Long
    Dim sqlText As String
    Dim processedCount As Long
    Dim totalCount As Long
    Dim ribbonTabKey As String
    Dim ribbonTabLabel As String
    Dim ribbonGroupLabel As String
    Dim ribbonGroupSortOrder As Long
    Dim ribbonTitleText As String
    Dim HelpDocumentMacroNumber As Long
    Dim HelpDocumentRibbonStaticTag As String
    Dim helpDocumentNumber As Long
    Dim rowIdentity As String
    Dim defaultTitleText As String
    Dim macroTitleOverride As String
    If CodeDbTableExists(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HelpDocuments")) = False Then Exit Sub
    If TableCanOpen(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HelpDocuments"), True) = False Then Exit Sub
    If synchronizationScope = HelpDocumentScopeSetupSystemOnly Then Exit Sub
    HelpDocumentSystemRibbonPlacement ribbonTabKey, ribbonTabLabel, ribbonGroupLabel, ribbonGroupSortOrder
    sqlText = "SELECT * FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HelpDocuments") & "] WHERE Nz(" & SQL_FIELD_HELP_DOCUMENT_STATUS & "," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE)
    sqlText = sqlText & " ORDER BY " & OrderByPolicyText("CATALOG_HELP_DOCUMENT") & ";"
    Set rs = ResolveCatalogDb().OpenRecordset(sqlText, dbOpenSnapshot)
    If rs.EOF = False Then
        rs.MoveLast
        totalCount = rs.RecordCount
        rs.MoveFirst
    End If
    Do While rs.EOF = False
        PumpSetupResponsiveness
        processedCount = processedCount + 1
        helpDocumentKey = CStr(Nz(rs.fields(FIELD_HELP_DOCUMENT_KEY).value, vbNullString))
        rowIdentity = vbNullString
        If SharedDao_RecordsetHasFieldSafe(rs, FIELD_ID) Then rowIdentity = CStr(Nz(rs.fields(FIELD_ID).value, vbNullString))
        PulseProgressEvery processedCount, 10, "Defaulting help-document managed object " & CStr(processedCount) & " of " & CStr(totalCount) & ": " & helpDocumentKey & ".", totalCount, "CatalogHelpDocumentDefaults", "Catalog"
        If HelpDocumentKeyInSynchronizationScope(synchronizationScope) Then
            helpDocumentNumber = CLng(Nz(rs.fields(FIELD_HELP_DOCUMENT_NUMBER).value, 0))
            defaultTitleText = CStr(Nz(rs.fields(FIELD_DEFAULT_TITLE_TEXT).value, vbNullString))
            macroTitleOverride = CStr(Nz(rs.fields(FIELD_MACRO_TITLE_OVERRIDE).value, vbNullString))
            ResolveHelpDocumentMaterialization helpDocumentKey, helpDocumentNumber, defaultTitleText, macroTitleOverride, rowIdentity, synchronizationScope, MacroTitle, runCodeExpression
            HelpDocumentMacroNumber = GetHelpDocumentMacroNumber(helpDocumentNumber)
            HelpDocumentRibbonStaticTag = GetHelpDocumentRibbonStaticTag(helpDocumentNumber)
            tooltipText = CStr(Nz(rs.fields(FIELD_OBJECT_DESCRIPTION).value, vbNullString))
            If Len(Trim$(tooltipText)) = 0 Then tooltipText = Left$("Generated ADC Help-document launcher macro [" & MacroTitle & "]. It calls " & runCodeExpression & " to resolve and open Help_Docs key [" & helpDocumentKey & "] at runtime. Help_Docs owns the document metadata; this macro is the generated navigation surface.", 255)
            SortOrder = CLng(Nz(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value, helpDocumentNumber))
            If SortOrder < 10 Then SortOrder = 10
            ribbonTitleText = defaultTitleText
            If Len(ribbonTitleText) > 0 Then
                If IncludeSystemMacroDesignatorInRibbonTitle() Then ribbonTitleText = Format$(HelpDocumentMacroNumber, "00") & " " & ribbonTitleText
            Else
                ribbonTitleText = macroTitleOverride
            End If
            DefaultManagedObject MacroTitle, ADCAT_CATEGORY_SYSTEM_MACRO, ADCAT_OBJECT_TYPE_MACRO, tooltipText, SortOrder, repairDefaultRows, ribbonTabKey, ribbonTabLabel, ribbonGroupLabel, ribbonGroupSortOrder, ribbonTitleText, True, vbNullString, vbNullString, HelpDocumentRibbonStaticTag
            DefaultActionPayloadForObject MacroTitle, ADCAT_PAYLOAD_ACCESS_MACRO_RUNCODE, vbNullString, runCodeExpression, tooltipText, MANAGED_OBJECT_CATALOG_SCHEMA_VERSION, SortOrder, repairDefaultRows
        End If
        rs.MoveNext
    Loop
    rs.Close
    Exit Sub
ErrHandler:
    Dim handlerErrNumber As Long
    Dim handlerErrDescription As String
    handlerErrNumber = Err.Number
    handlerErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    Err.Raise handlerErrNumber, "DefaultHelpDocumentManagedObjectRows", "Unable to build managed-object definitions for an in-scope active Help_Docs record." & vbCrLf & "Operation: " & HelpDocumentSynchronizationOperationName(synchronizationScope) & vbCrLf & "HelpDocumentKey: " & IIf(Len(Trim$(helpDocumentKey)) = 0, "(blank)", helpDocumentKey) & vbCrLf & "Row identity: " & IIf(Len(rowIdentity) = 0, "(unavailable)", rowIdentity) & vbCrLf & "Table: " & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HelpDocuments") & vbCrLf & "Description: " & handlerErrDescription
End Sub

