Private Function OrderedQuerySelectList(ByVal queryName As String, Optional ByVal queryAlias As String = vbNullString) As String
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim qdf As DAO.queryDef
    Dim fld As DAO.Field
    Dim resultText As String
    Dim prefixText As String
    Set db = ResolveCatalogDb()
    db.QueryDefs.Refresh
    Set qdf = db.QueryDefs(queryName)
    qdf.fields.Refresh
    If Len(queryAlias) > 0 Then prefixText = SharedDao_BracketName(queryAlias) & "."
    For Each fld In qdf.fields
        PumpSetupResponsiveness
        If Len(resultText) > 0 Then resultText = resultText & ", "
        resultText = resultText & prefixText & SharedDao_BracketName(fld.Name)
    Next fld
    OrderedQuerySelectList = resultText
    Exit Function
ErrHandler:
    Dim originalErrNumber As Long
    Dim originalErrDescription As String
    originalErrNumber = Err.Number
    originalErrDescription = Err.Description
    Err.Raise originalErrNumber, "OrderedQuerySelectList", "Could not build the authoritative ordered SELECT list for a managed query." & vbCrLf & "Query: " & queryName & vbCrLf & "Alias: " & queryAlias & vbCrLf & "Description: " & originalErrDescription
End Function

Private Sub B2SortTextArray(ByRef values As Variant)
    Dim lowerBound As Long
    Dim upperBound As Long
    Dim outerIndex As Long
    Dim innerIndex As Long
    Dim swapValue As Variant
    lowerBound = LBound(values)
    upperBound = UBound(values)
    For outerIndex = lowerBound To upperBound - 1
        For innerIndex = outerIndex + 1 To upperBound
            If StrComp(CStr(values(outerIndex)), CStr(values(innerIndex)), vbTextCompare) > 0 Then
                swapValue = values(outerIndex)
                values(outerIndex) = values(innerIndex)
                values(innerIndex) = swapValue
            End If
        Next innerIndex
    Next outerIndex
End Sub

Private Function ManagedDefinitionPart11TimingText() As String
