    sqlParts.Add "cand." & SQL_FIELD_CANDIDATE_SCAN_TARGET_DB_NAME & ", cand." & SQL_FIELD_CANDIDATE_SCAN_TARGET_DB_PATH & ", cand." & SQL_FIELD_CANDIDATE_VB_PROJECT_NAME & ", cand." & SQL_FIELD_CANDIDATE_MODULE_NAME & ", cand." & SQL_FIELD_CANDIDATE_PROCEDURE_DECLARATION & ", cand." & SQL_FIELD_CANDIDATE_ARGUMENT_SIGNATURE & ", cand." & SQL_FIELD_HAS_REQUIRED_ARGUMENTS & ", cand." & SQL_FIELD_REQUIRED_ARGUMENT_COUNT & ", cand." & SQL_FIELD_OPTIONAL_ARGUMENT_COUNT & ","
    sqlParts.Add "cand." & SQL_FIELD_MODULE_HEADER_FOUND & ", cand." & SQL_FIELD_MODULE_HEADER_MALFORMED & ", cand." & SQL_FIELD_MODULE_HEADER_TITLE & ", cand." & SQL_FIELD_MODULE_HEADER_PURPOSE & ", cand." & SQL_FIELD_MODULE_HEADER_ENTRY_POINTS & ", cand." & SQL_FIELD_PROCEDURE_LISTED_IN_ENTRY_POINTS & ", cand." & SQL_FIELD_ENTRY_POINT_MATCH_CONFIDENCE & ", cand." & SQL_FIELD_MODULE_HEADER_SCAN_NOTES & ","
    sqlParts.Add "cand." & SQL_FIELD_SCAN_SIGNATURE & ", cand." & SQL_FIELD_LAST_SCAN_BATCH_ID & ", cand." & SQL_FIELD_LAST_SCANNED_ON & ", cand." & SQL_FIELD_DISCOVERED_ON & ", Null AS " & SQL_FIELD_CONFIGURED_ON & ", cand." & SQL_FIELD_REJECTED_ON & ", cand." & SQL_FIELD_CANDIDATE_NOTES & ", cand." & SQL_FIELD_ACTION_DESCRIPTION & ", cand." & SQL_FIELD_LAUNCHER_TOOLTIP & ", cand." & SQL_FIELD_OBJECT_DESCRIPTION & ", cand." & SQL_FIELD_SOURCE_NOTES & ","
    sqlParts.Add "cand." & SQL_FIELD_ACCEPTANCE_STATUS & ", cand." & SQL_FIELD_ACCEPTED_ON & ", cand." & SQL_FIELD_ACCEPTED_CONFIGURATION_ID & ", cand." & SQL_FIELD_ACCEPTANCE_NOTES & ", False AS " & SQL_FIELD_SELECTED_FOR_DUPLICATE_DELETION & ","
    sqlParts.Add "IIf(Len(Nz(cand." & SQL_FIELD_MACRO_TITLE & ",''))>0,cand." & SQL_FIELD_MACRO_TITLE & ",IIf(Len(Nz(cand." & SQL_FIELD_TARGET_PROCEDURE_NAME & ",''))>0,cand." & SQL_FIELD_TARGET_PROCEDURE_NAME & ",Nz(cand." & SQL_FIELD_TARGET_OBJECT_NAME & ",''))) AS " & FIELD_CANDIDATE_DISPLAY_NAME & ","
    sqlParts.Add "Nz(cand.[" & FIELD_CANDIDATE_OWNER_DATABASE_ROLE & "],'') & IIf(Len(Nz(cand." & SQL_FIELD_CANDIDATE_MODULE_NAME & ",''))>0,': ' & cand." & SQL_FIELD_CANDIDATE_MODULE_NAME & ",IIf(Len(Nz(cand." & SQL_FIELD_TARGET_OBJECT_NAME & ",''))>0,': ' & cand." & SQL_FIELD_TARGET_OBJECT_NAME & ",'')) AS " & FIELD_CANDIDATE_ROLE_SUMMARY & ","
    sqlParts.Add "IIf(Nz(cand." & SQL_FIELD_HAS_REQUIRED_ARGUMENTS & ",False)<>False Or Nz(cand." & SQL_FIELD_REQUIRED_ARGUMENT_COUNT & ",0)>0, True, False) AS " & FIELD_NEEDS_ARGUMENTS_FLAG & ","
    sqlParts.Add "IIf(Nz(cand." & SQL_FIELD_CANDIDATE_STATUS & ",'')=" & SharedDao_SqlQuote(CANDIDATE_STATUS_STALE) & ",'Candidate status is stale',Null) AS " & FIELD_STALE_CANDIDATE_HINT
