    Else
        CorePulseProgress "Register management queries in the Managed Object Catalog"
        DefaultManagedObjectNavigationPaneRibbonQueryRows True
    End If
    ReportCoreActionSuccess "RepairNavigationPaneAndRibbonManagementQueries", "QueryRepair", "Navigation Pane and ribbon management queries repaired successfully.", "Management queries repaired:" & vbCrLf & " - " & ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_NavigationPaneGroups_Management") & vbCrLf & " - " & ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_RibbonGroups_Management") & vbCrLf & " - " & ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_ManagedObjects_RibbonManagement") & vbCrLf & " - " & ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_RibbonButtonTargets_Review"), "Repair Navigation Pane and ribbon management queries", vbNullString, "QuerySet", "CodeDb", "QueryRepair", showMessage, "Repair Navigation Pane And Ribbon Queries", vbInformation, True, "Tables", False
    Exit Sub
ErrHandler:
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    messageText = "Could not create, catalog, or refresh the Navigation Pane/ribbon management queries." & vbCrLf & vbCrLf & "Err.Number: " & CStr(savedErrNumber) & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
    LogTraceMessage TRACE_LEVEL_ERROR, "QueryRepair", "RepairNavigationPaneAndRibbonManagementQueries", "Navigation Pane/ribbon management query repair failed.", messageText, "Repair Navigation Pane and ribbon management queries", savedErrNumber, savedErrSource, savedErrDescription, vbNullString, "QuerySet", "CodeDb", "QueryRepair"
    If showMessage Then
        CoreShowErrorMessage messageText, vbCritical, "Repair Navigation Pane And Ribbon Queries", "RepairNavigationPaneAndRibbonManagementQueries", "Tables"
        Exit Sub
    End If
    Err.Raise savedErrNumber, "RepairNavigationPaneAndRibbonManagementQueries", messageText
End Sub

Private Function NavigationPaneGroupsFormSql() As String
    Dim sqlText As String
    sqlText = "SELECT " & SQL_FIELD_ID & ", [" & FIELD_NAVIGATION_PANE_GROUP_KEY & "], [" & FIELD_NAVIGATION_PANE_GROUP_NAME & "], " & SQL_FIELD_GROUP_DESCRIPTION & ", " & SQL_FIELD_GROUP_PURPOSE & ", [" & FIELD_OBJECT_TYPE_SCOPE & "], [" & FIELD_CONFIG_OWNER_DATABASE_ROLE & "], [" & FIELD_SETTING_KEY & "], " & SQL_FIELD_LOOKUP_ACTIVE & ", [" & FIELD_CREATE_IF_MISSING & "], " & SQL_FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER & ", [" & FIELD_SHOW_ON_RIBBON & "], [" & FIELD_RIBBON_TAB_KEY & "], [" & FIELD_RIBBON_TAB_LABEL & "], [" & FIELD_RIBBON_GROUP_LABEL & "], [" & FIELD_RIBBON_GROUP_SORT_ORDER & "], [" & FIELD_RIBBON_GROUP_VISIBLE & "], [" & FIELD_DEFAULTED_ON & "], [" & FIELD_LAST_DEFAULT_REPAIR_ON & "], " & SQL_FIELD_DEFAULT_SOURCE & ", " & SQL_FIELD_MANAGED_OBJECT_DEPENDENCY_NOTES & " "
    sqlText = sqlText & "FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_NavigationPaneGroups") & "] ORDER BY " & OrderByPolicyText("CATALOG_NAVIGATION_GROUP") & ";"
    NavigationPaneGroupsFormSql = sqlText
End Function

Private Sub EnsureRibbonButtonTargetsTable()
    Dim tableName As String
