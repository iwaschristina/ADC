' Purpose: Resolves macro report source SQL from the supplied/current ADC state, using `SharedDao_SqlQuote` and `End` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
' Returns: String: Returns the SQL text produced by this routine. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not resolved.
Public Function MacroReportSourceSql() As String
    ' Thin read-only Phase-A base projection over authoritative current MC_Records rows. It intentionally has no Catalog-table dependency because A3 must be valid on a clean Setup before Phase B creates the catalog.
    ' Phase E enriches this base projection with completed B-phase placement metadata when it assigns the physical report RecordSource.
    Dim sqlText As String
    sqlText = "SELECT cfg." & SQL_FIELD_ID & ", cfg." & SQL_FIELD_MACRO_KEY & ", cfg." & SQL_FIELD_MACRO_TITLE & ", cfg.[" & FIELD_MACRO_CATEGORY_KEY & "], cfg.[" & FIELD_MACRO_SUBCATEGORY_KEY & "], cfg." & SQL_FIELD_CONFIGURATION_STATUS & ", cfg.[" & FIELD_ACTIVE & "], cfg." & SQL_FIELD_SELECTED_FOR_RUNNER_MACRO_GENERATION & ", "
    sqlText = sqlText & "cfg." & SQL_FIELD_MACRO_ACTION & ", cfg.[" & FIELD_CONFIG_OWNER_DATABASE_ROLE & "], cfg." & SQL_FIELD_TARGET_PROCEDURE_NAME & ", cfg." & SQL_FIELD_TARGET_PROCEDURE_MODULE_NAME & ", cfg." & SQL_FIELD_TARGET_OBJECT_NAME & ", cfg." & SQL_FIELD_LAST_VALIDATION_RESULT & ", cfg." & SQL_FIELD_LAST_GENERATED_RESULT & ", cfg." & SQL_FIELD_GENERATED_MACRO_OBJECT_NAME & ", cfg." & SQL_FIELD_NAVIGATION_PANE_GROUP & ", cfg." & SQL_FIELD_OBJECT_DESCRIPTION & ", "
    sqlText = sqlText & SharedDao_SqlQuote(ADCAT_OBJECT_TYPE_MACRO) & " AS " & SQL_FIELD_REPORT_PLACEMENT_OBJECT_TYPE & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Config") & "] AS cfg "
    sqlText = sqlText & "ORDER BY " & OrderByPolicyText("REPORT_MACRO_CONFIG") & ";"
    MacroReportSourceSql = sqlText
End Function

' Purpose: Resolves generation status form SQL from the supplied/current ADC state, using `ManagedObjectPhysicalName` and `End` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
' Returns: String: Returns the SQL text produced by this routine. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not resolved.
Public Function GenerationStatusFormSql() As String
    'Intended use: Returns the Access Development Console Generation Status Form Sql result for direct, query, form, or required cross-module callers.
    Dim sqlText As String
    sqlText = ""
    sqlText = sqlText & "SELECT cfg." & SQL_FIELD_ID & ", cfg." & SQL_FIELD_MACRO_KEY & ", cfg." & SQL_FIELD_MACRO_TITLE & ", cfg.[" & FIELD_ACTIVE & "], cfg." & SQL_FIELD_SELECTED_FOR_RUNNER_MACRO_GENERATION & ", cfg." & SQL_FIELD_CONFIGURATION_STATUS & ", "
    sqlText = sqlText & "cfg." & SQL_FIELD_MACRO_ACTION & ", cfg.[" & FIELD_CONFIG_OWNER_DATABASE_ROLE & "], cfg." & SQL_FIELD_TARGET_PROCEDURE_NAME & ", cfg." & SQL_FIELD_TARGET_PROCEDURE_MODULE_NAME & ", "
    sqlText = sqlText & "cfg." & SQL_FIELD_GENERATED_MACRO_OBJECT_NAME & ", cfg." & SQL_FIELD_LAST_VALIDATED_ON & ", cfg." & SQL_FIELD_LAST_VALIDATION_RESULT & ", cfg." & SQL_FIELD_LAST_VALIDATION_NOTES & ", "
    sqlText = sqlText & "cfg." & SQL_FIELD_LAST_GENERATED_ON & ", cfg." & SQL_FIELD_LAST_GENERATED_RESULT & ", cfg." & SQL_FIELD_LAST_GENERATED_NOTES & ", cfg." & SQL_FIELD_MANUAL_REVIEW_STATUS & ", cfg." & SQL_FIELD_REVIEW_PRIORITY & ", "
    sqlText = sqlText & "IIf(cfg." & SQL_FIELD_LAST_VALIDATED_ON & " Is Null, True, False) AS " & FIELD_NEVER_VALIDATED_FLAG & ", "
    sqlText = sqlText & "IIf(cfg." & SQL_FIELD_LAST_GENERATED_ON & " Is Null, True, False) AS " & FIELD_NEVER_GENERATED_FLAG & ", "
    sqlText = sqlText & "IIf(Nz(cfg." & SQL_FIELD_LAST_VALIDATION_RESULT & ",'')=" & SharedDao_SqlQuote(VALIDATION_RESULT_INVALID) & " Or Nz(cfg." & SQL_FIELD_LAST_VALIDATION_RESULT & ",'')=" & SharedDao_SqlQuote(VALIDATION_RESULT_ERROR) & " Or Nz(cfg." & SQL_FIELD_LAST_VALIDATION_RESULT & ",'')=" & SharedDao_SqlQuote(VALIDATION_RESULT_NEEDS_REVIEW) & ", True, False) AS " & FIELD_VALIDATION_PROBLEM_FLAG & ", "
    sqlText = sqlText & "IIf(Nz(cfg." & SQL_FIELD_LAST_GENERATED_RESULT & ",'')=" & SharedDao_SqlQuote(GENERATED_RESULT_FAILED) & " Or Nz(cfg." & SQL_FIELD_LAST_GENERATED_RESULT & ",'')=" & SharedDao_SqlQuote(GENERATED_RESULT_INVALID) & " Or Nz(cfg." & SQL_FIELD_LAST_GENERATED_RESULT & ",'')=" & SharedDao_SqlQuote(GENERATED_RESULT_NEEDS_REVIEW) & ", True, False) AS " & FIELD_GENERATION_PROBLEM_FLAG & ", "
    sqlText = sqlText & "IIf(Nz(cfg.[" & FIELD_ACTIVE & "],False)<>False And Nz(cfg." & SQL_FIELD_CONFIGURATION_STATUS & "," & SharedDao_SqlQuote(CONFIGURATION_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(CONFIGURATION_STATUS_ACTIVE) & " And Nz(cfg." & SQL_FIELD_LAST_VALIDATION_RESULT & "," & SharedDao_SqlQuote(VALIDATION_RESULT_VALID) & ")<>" & SharedDao_SqlQuote(VALIDATION_RESULT_INVALID) & " And Nz(cfg." & SQL_FIELD_LAST_VALIDATION_RESULT & "," & SharedDao_SqlQuote(VALIDATION_RESULT_VALID) & ")<>" & SharedDao_SqlQuote(VALIDATION_RESULT_ERROR) & " And Nz(cfg." & SQL_FIELD_LAST_VALIDATION_RESULT & "," & SharedDao_SqlQuote(VALIDATION_RESULT_VALID) & ")<>" & SharedDao_SqlQuote(VALIDATION_RESULT_NEEDS_REVIEW) & ", True, False) AS " & FIELD_READY_TO_GENERATE_FLAG & " "
    sqlText = sqlText & "FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Config") & "] AS cfg "
    sqlText = sqlText & "ORDER BY " & OrderByPolicyText("CATALOG_GENERATION_STATUS") & ";"
    GenerationStatusFormSql = sqlText
