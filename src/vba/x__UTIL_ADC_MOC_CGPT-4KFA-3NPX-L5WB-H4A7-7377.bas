' Purpose: Resolves the authoritative database object for MOC and MOC lifecycle work, honoring the active setup-scoped CodeDb context when present.
' Public role: Inter-module MOC authority used by x__UTIL_ADC_MOC_LIFECYCLE; no second database-context resolver is introduced by the split.
' Returns: DAO.Database: The active setup-scoped catalog database when available; otherwise the current CodeDb.
Public Function ResolveCatalogDb() As DAO.Database
    'Catalog-only database resolver. During catalog setup this uses the setup-scoped CodeDb; otherwise it returns the global CodeDb.
    If mCatalogSetupContextActive Then
        If Not mCatalogSetupContextDb Is Nothing Then
            Set ResolveCatalogDb = mCatalogSetupContextDb
            Exit Function
        End If
    End If
    Set ResolveCatalogDb = codeDb
End Function

' Purpose: Returns the built-in bootstrap requirement for fields whose physical size is explicitly constrained by ADC. Null means no explicit ReqFieldSize applies.
Public Function DefaultManagedFieldReqSize(ByVal tableName As String, ByVal fieldName As String) As Variant
    'Most cataloged fields have no explicit ReqFieldSize. Reject them before resolving managed physical table names so B5 does not add catalog-name lookups to every inventoried field.
    Select Case fieldName
        Case FIELD_FORM_OBJECT_NAME, FIELD_OBJECT_NAME, FIELD_MACRO_TITLE_OVERRIDE, FIELD_SOURCE_OBJECT_NAME_OVERRIDE, FIELD_TARGET_OBJECT_NAME_OVERRIDE, _
            FIELD_MANAGED_OBJECT_FIELD_NAME, FIELD_MANAGED_OBJECT_FIELD_SOURCE_OBJECT_NAME, FIELD_MANAGED_OBJECT_FIELD_SOURCE_FIELD_NAME, FIELD_MANAGED_OBJECT_FIELD_DEFAULT_VALUE, _
            FIELD_MANAGED_OBJECT_FIELD_VALIDATION_TEXT, FIELD_MANAGED_OBJECT_FIELD_DESCRIPTION_SHORT, FIELD_MACRO_TITLE, FIELD_TARGET_OBJECT_NAME, FIELD_GENERATED_MACRO_OBJECT_NAME, _
            FIELD_LAUNCHER_TOOLTIP, FIELD_EXPECTED_TOOLTIP, FIELD_ACTUAL_TOOLTIP
        Case Else
            DefaultManagedFieldReqSize = Null
            Exit Function
    End Select
    Select Case tableName
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_FormDefinitions")
            If fieldName = FIELD_FORM_OBJECT_NAME Or fieldName = FIELD_MANAGED_OBJECT_FIELD_SOURCE_OBJECT_NAME Then DefaultManagedFieldReqSize = MAX_ACCESS_OBJECT_NAME_LENGTH: Exit Function
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_RIBBON_BUTTON_TARGETS_TABLE_LOGICAL_ID)
            If fieldName = FIELD_OBJECT_NAME Then DefaultManagedFieldReqSize = MAX_ACCESS_OBJECT_NAME_LENGTH: Exit Function
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros"), ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HelpDocuments")
            If fieldName = FIELD_MACRO_TITLE_OVERRIDE Then DefaultManagedFieldReqSize = MAX_ACCESS_OBJECT_NAME_LENGTH: Exit Function
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID)
            If fieldName = FIELD_OBJECT_NAME Then DefaultManagedFieldReqSize = MAX_ACCESS_OBJECT_NAME_LENGTH: Exit Function
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECT_OVERRIDES_TABLE_LOGICAL_ID)
            If fieldName = FIELD_SOURCE_OBJECT_NAME_OVERRIDE Or fieldName = FIELD_TARGET_OBJECT_NAME_OVERRIDE Then DefaultManagedFieldReqSize = MAX_ACCESS_OBJECT_NAME_LENGTH: Exit Function
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectFields")
            If fieldName = FIELD_MANAGED_OBJECT_FIELD_NAME Or fieldName = FIELD_MANAGED_OBJECT_FIELD_SOURCE_FIELD_NAME Then DefaultManagedFieldReqSize = MAX_ACCESS_FIELD_NAME_LENGTH: Exit Function
            If fieldName = FIELD_MANAGED_OBJECT_FIELD_SOURCE_OBJECT_NAME Then DefaultManagedFieldReqSize = MAX_ACCESS_OBJECT_NAME_LENGTH: Exit Function
            If fieldName = FIELD_MANAGED_OBJECT_FIELD_DEFAULT_VALUE Or fieldName = FIELD_MANAGED_OBJECT_FIELD_VALIDATION_TEXT Or fieldName = FIELD_MANAGED_OBJECT_FIELD_DESCRIPTION_SHORT Then DefaultManagedFieldReqSize = MAX_ACCESS_SHORT_TEXT_LENGTH: Exit Function
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Config")
            If fieldName = FIELD_MACRO_TITLE Or fieldName = FIELD_TARGET_OBJECT_NAME Or fieldName = FIELD_GENERATED_MACRO_OBJECT_NAME Then DefaultManagedFieldReqSize = MAX_ACCESS_OBJECT_NAME_LENGTH: Exit Function
            If fieldName = FIELD_LAUNCHER_TOOLTIP Then DefaultManagedFieldReqSize = MAX_ACCESS_SHORT_TEXT_LENGTH: Exit Function
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_LauncherControlsReview")
            If fieldName = FIELD_EXPECTED_TOOLTIP Or fieldName = FIELD_ACTUAL_TOOLTIP Then DefaultManagedFieldReqSize = MAX_ACCESS_SHORT_TEXT_LENGTH: Exit Function
    End Select
    DefaultManagedFieldReqSize = Null
End Function

' Purpose: Resolves the required physical field size used by Setup. Persisted MAC_Fields.ReqFieldSize is authoritative when available; built-in constants bootstrap cold creation and upgrades.
Public Function ManagedFieldReqSizeForSetup(ByVal tableName As String, ByVal fieldName As String) As Long
    On Error GoTo ErrHandler
    Dim defaultSize As Variant
    Dim persistedSize As Variant
    Dim db As DAO.Database
    Dim objectTdf As DAO.tableDef
    Dim fieldTdf As DAO.tableDef
    Dim rs As DAO.Recordset
    Dim objectTableName As String
    Dim fieldTableName As String
    Dim sqlText As String
    defaultSize = DefaultManagedFieldReqSize(tableName, fieldName)
    If IsNull(defaultSize) = False Then ManagedFieldReqSizeForSetup = CLng(defaultSize)
    Set db = ResolveCatalogDb()
    If db Is Nothing Then Exit Function
    objectTableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID)
    fieldTableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectFields")
    If SharedDao_DatabaseTableExistsSafe(db, objectTableName) = False Or SharedDao_DatabaseTableExistsSafe(db, fieldTableName) = False Then Exit Function
    Set objectTdf = db.TableDefs(objectTableName)
    Set fieldTdf = db.TableDefs(fieldTableName)
    If SharedDao_TableDefFieldExistsSafe(objectTdf, FIELD_OBJECT_NAME) = False Or SharedDao_TableDefFieldExistsSafe(objectTdf, FIELD_OBJECT_TYPE) = False Or SharedDao_TableDefFieldExistsSafe(objectTdf, FIELD_MANAGED_OBJECT_STATUS) = False Then Exit Function
    If SharedDao_TableDefFieldExistsSafe(fieldTdf, FIELD_MANAGED_OBJECT_ID) = False Or SharedDao_TableDefFieldExistsSafe(fieldTdf, FIELD_MANAGED_OBJECT_FIELD_NAME) = False Or SharedDao_TableDefFieldExistsSafe(fieldTdf, FIELD_MANAGED_OBJECT_FIELD_REQUIRED_SIZE) = False Or SharedDao_TableDefFieldExistsSafe(fieldTdf, FIELD_MANAGED_OBJECT_FIELD_IS_ACTIVE) = False Then Exit Function
    sqlText = "SELECT f." & SQL_FIELD_MANAGED_OBJECT_FIELD_REQUIRED_SIZE & " FROM [" & fieldTableName & "] AS f INNER JOIN [" & objectTableName & "] AS o ON f." & SQL_FIELD_MANAGED_OBJECT_ID & "=o." & SQL_FIELD_ID & " WHERE UCase(Trim(Nz(o." & SQL_FIELD_OBJECT_NAME & ",'')))=" & SharedDao_SqlQuote(UCase$(Trim$(tableName))) & " AND UCase(Trim(Nz(o." & SQL_FIELD_OBJECT_TYPE & ",'')))='TABLE' AND UCase(Trim(Nz(f." & SQL_FIELD_MANAGED_OBJECT_FIELD_NAME & ",'')))=" & SharedDao_SqlQuote(UCase$(Trim$(fieldName))) & " AND Nz(f." & SQL_FIELD_MANAGED_OBJECT_FIELD_IS_ACTIVE & ",False)<>False AND Nz(o.[" & FIELD_MANAGED_OBJECT_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ";"
    Set rs = db.OpenRecordset(sqlText, dbOpenSnapshot, dbReadOnly)
    If rs.EOF = False Then
        persistedSize = rs.fields(0).value
        rs.MoveNext
        If rs.EOF = False Then Err.Raise vbObjectError + 5914, "ManagedFieldReqSizeForSetup", "Multiple active MAC_Fields rows define ReqFieldSize for the same managed table field." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName
        If IsNull(persistedSize) = False Then
            If CLng(persistedSize) < 1 Or CLng(persistedSize) > MAX_ACCESS_SHORT_TEXT_LENGTH Then Err.Raise vbObjectError + 5915, "ManagedFieldReqSizeForSetup", "Persisted ReqFieldSize is outside the valid Access Short Text range." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName & vbCrLf & "ReqFieldSize: " & CStr(persistedSize)
            ManagedFieldReqSizeForSetup = CLng(persistedSize)
        End If
    End If
    rs.Close
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    Err.Raise savedErrNumber, "ManagedFieldReqSizeForSetup", "Could not resolve the authoritative required field size." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName & vbCrLf & "Err.Description: " & savedErrDescription
End Function


Private Function ManagedObjectNamesMatchConfiguredRules(Optional ByRef mismatchSummary As String = vbNullString, Optional ByVal allowResponsivenessPump As Boolean = True) As Boolean
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim tdf As DAO.tableDef
    Dim currentName As String
    Dim logicalName As String
    Dim objectTypeCode As String
    Dim namingCategory As String
    Dim targetName As String
    Dim mismatchCount As Long
    Dim interruptedReadRetries As Long
RetryRead:
    On Error GoTo ErrHandler
    mismatchSummary = vbNullString
    mismatchCount = 0
    Set rs = Nothing
    Set tdf = Nothing
    Set db = ResolveCatalogDb()
    If DaoTableExists(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID)) = False Then ManagedObjectNamesMatchConfiguredRules = True: Exit Function
    Set tdf = db.TableDefs(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID))
    If SharedDao_TableDefFieldExistsSafe(tdf, FIELD_LOGICAL_OBJECT_NAME) = False Or SharedDao_TableDefFieldExistsSafe(tdf, FIELD_OBJECT_NAMING_CATEGORY) = False Or SharedDao_TableDefFieldExistsSafe(tdf, FIELD_OBJECT_TYPE) = False Then ManagedObjectNamesMatchConfiguredRules = True: Exit Function
    Set rs = db.OpenRecordset("SELECT " & SQL_FIELD_OBJECT_NAME & ",[" & FIELD_LOGICAL_OBJECT_NAME & "],[" & FIELD_OBJECT_NAMING_CATEGORY & "]," & SQL_FIELD_OBJECT_TYPE & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] WHERE Nz([" & FIELD_MANAGED_OBJECT_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND Len(Nz([" & FIELD_LOGICAL_OBJECT_NAME & "],''))>0 AND Len(Nz([" & FIELD_OBJECT_NAMING_CATEGORY & "],''))>0 ORDER BY " & OrderByPolicyText("CATALOG_NAMING_RULE_REVIEW") & ";", dbOpenSnapshot, dbReadOnly)
    Do While rs.EOF = False
        If allowResponsivenessPump Then PumpSetupResponsiveness
        currentName = CStr(Nz(rs!objectName, vbNullString))
        logicalName = Trim$(CStr(rs.fields(FIELD_LOGICAL_OBJECT_NAME).value))
        objectTypeCode = UCase$(Trim$(CStr(Nz(rs!objectType, vbNullString))))
        namingCategory = Trim$(CStr(rs.fields(FIELD_OBJECT_NAMING_CATEGORY).value))
        targetName = TargetManagedObjectPhysicalName(namingCategory, logicalName)
        If StrComp(currentName, targetName, vbBinaryCompare) <> 0 Then
            mismatchCount = mismatchCount + 1
            If mismatchCount <= 20 Then mismatchSummary = SharedText_AppendNonBlankLine(mismatchSummary, objectTypeCode & " / " & namingCategory & ": " & currentName & " -> " & targetName)
        End If
        rs.MoveNext
    Loop
    rs.Close
    If mismatchCount > 20 Then mismatchSummary = mismatchSummary & vbCrLf & "... " & CStr(mismatchCount - 20) & " additional object(s)."
    ManagedObjectNamesMatchConfiguredRules = (mismatchCount = 0)
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    Set rs = Nothing
    Set tdf = Nothing
    Set db = Nothing
    On Error GoTo 0
    If savedErrNumber = 3059 And interruptedReadRetries = 0 Then
        interruptedReadRetries = 1
        allowResponsivenessPump = False
        On Error Resume Next
        LogTraceMessage TRACE_LEVEL_INFO, "Setup", "ManagedObjectNamesMatchConfiguredRules", "Managed-name validation snapshot read was interrupted once and will be retried without event pumping.", "DAO error 3059 was returned by " & savedErrSource & ". The read-only snapshot will be reopened once before validation is failed.", "Retry managed-name validation snapshot", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "Table", "CodeDb", "Setup"
        On Error GoTo 0
        GoTo RetryRead
    End If
    If savedErrNumber = 3059 Then savedErrDescription = savedErrDescription & vbCrLf & "The single read-only retry without event pumping also failed."
    Err.Raise savedErrNumber, "ManagedObjectNamesMatchConfiguredRules", "Could not compare current managed-object names with the configured naming rules." & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Function

Private Sub CatalogHashAppendManagedObjectInventory(ByVal db As DAO.Database, ByRef allState As CatalogHashState, ByRef coreState As CatalogHashState, ByRef formsState As CatalogHashState, ByRef uiState As CatalogHashState, ByRef macroState As CatalogHashState, ByRef failureDetail As String)
    On Error GoTo ErrHandler
    Dim tdf As DAO.tableDef
    Dim fld As DAO.Field
    Dim rs As DAO.Recordset
    Dim projectedNames As Object
    Dim includedFieldTokens() As String
    Dim includedFieldCount As Long
    Dim fieldIndex As Long
    Dim projectionText As String
    Dim tokenText As String
    Dim chunkText As String
    Dim rowDomain As String
    Dim rowCount As Long
    CatalogHashAppendText allState, FingerprintTokenPart("DATA:Inventory:" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID))
    CatalogHashAppendText coreState, FingerprintTokenPart("DATA:InventoryCore:" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID))
    CatalogHashAppendText formsState, FingerprintTokenPart("DATA:InventoryForms:" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID))
    CatalogHashAppendText uiState, FingerprintTokenPart("DATA:InventoryUI:" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID))
    CatalogHashAppendText macroState, FingerprintTokenPart("DATA:InventoryMacros:" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID))
    Set tdf = db.TableDefs(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID))
    tdf.fields.Refresh
    For Each fld In tdf.fields
        If CatalogFastPathFieldIncluded("Inventory", fld.Name) Then includedFieldCount = includedFieldCount + 1
    Next fld
    If includedFieldCount = 0 Then
        failureDetail = "The managed-object inventory contract selected no fields from " & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "."
        Exit Sub
    End If
    ReDim includedFieldTokens(0 To includedFieldCount - 1)
    ' INTENTIONAL KEYED LOOKUP: projectedNames provides keyed membership/lookup over source rows or state already read by CatalogHashAppendManagedObjectInventory; it is a derived access path, not a second authority.
    Set projectedNames = CreateObject("Scripting.Dictionary")
    projectedNames.CompareMode = vbTextCompare
    fieldIndex = 0
    For Each fld In tdf.fields
        If CatalogFastPathFieldIncluded("Inventory", fld.Name) Then
            includedFieldTokens(fieldIndex) = FingerprintTokenPart(fld.Name)
            If Len(projectionText) > 0 Then projectionText = projectionText & ","
            projectionText = projectionText & SharedDao_BracketName(fld.Name)
            projectedNames(fld.Name) = True
            fieldIndex = fieldIndex + 1
        End If
    Next fld
    If projectedNames.Exists(FIELD_OBJECT_NAME) = False Then
        projectionText = projectionText & "," & SQL_FIELD_OBJECT_NAME
        projectedNames(FIELD_OBJECT_NAME) = True
    End If
    If projectedNames.Exists(FIELD_OBJECT_TYPE) = False Then
        projectionText = projectionText & "," & SQL_FIELD_OBJECT_TYPE
        projectedNames(FIELD_OBJECT_TYPE) = True
    End If
    If projectedNames.Exists(FIELD_CATEGORY_CODE) = False Then
        projectionText = projectionText & "," & SharedDao_BracketName(FIELD_CATEGORY_CODE)
        projectedNames(FIELD_CATEGORY_CODE) = True
    End If
    PulseCatalogSetupPart7 "streaming managed-object inventory with an explicit " & CStr(includedFieldCount) & "-field contract projection."
    Set rs = db.OpenRecordset("SELECT " & projectionText & " FROM " & SharedDao_BracketName(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID)) & " ORDER BY " & SQL_FIELD_ID, dbOpenSnapshot)
    Do While rs.EOF = False
        PumpSetupResponsiveness
        rowDomain = CatalogManagedObjectInventoryDomain(CStr(Nz(rs.fields(FIELD_OBJECT_TYPE).value, vbNullString)), CStr(Nz(rs.fields(FIELD_CATEGORY_CODE).value, vbNullString)), CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString)))
        chunkText = vbNullString
        For fieldIndex = 0 To includedFieldCount - 1
            CatalogHashQueueManagedObjectInventoryText allState, coreState, formsState, uiState, macroState, rowDomain, chunkText, includedFieldTokens(fieldIndex)
            tokenText = FingerprintTokenPart(CatalogFastPathValueText(rs.fields(fieldIndex).value))
            CatalogHashQueueManagedObjectInventoryText allState, coreState, formsState, uiState, macroState, rowDomain, chunkText, tokenText
        Next fieldIndex
        CatalogHashQueueManagedObjectInventoryText allState, coreState, formsState, uiState, macroState, rowDomain, chunkText, vbLf
        CatalogHashFlushManagedObjectInventoryText allState, coreState, formsState, uiState, macroState, rowDomain, chunkText
        rowCount = rowCount + 1
        If rowCount Mod 25 = 0 Then PulseCatalogSetupPart7 "streamed " & CStr(rowCount) & " managed-object inventory rows through the explicit contract projection."
        rs.MoveNext
    Loop
    PulseCatalogSetupPart7 "completed managed-object inventory (" & CStr(rowCount) & " rows; " & CStr(includedFieldCount) & " fingerprint fields)."
    rs.Close
    Set rs = Nothing
    Set tdf = Nothing
    Set projectedNames = Nothing
    Exit Sub
ErrHandler:
    failureDetail = "Could not fingerprint managed-object inventory domains in one projected streaming pass. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    Set rs = Nothing
    Set tdf = Nothing
    Set projectedNames = Nothing
    On Error GoTo 0
End Sub

Private Sub CatalogHashQueueManagedObjectInventoryText(ByRef allState As CatalogHashState, ByRef coreState As CatalogHashState, ByRef formsState As CatalogHashState, ByRef uiState As CatalogHashState, ByRef macroState As CatalogHashState, ByVal rowDomain As String, ByRef chunkText As String, ByVal valueText As String)
    If Len(valueText) = 0 Then Exit Sub
    If Len(chunkText) > 0 Then
        If Len(chunkText) + Len(valueText) > CATALOG_HASH_STREAM_CHUNK_CHARACTERS Then CatalogHashFlushManagedObjectInventoryText allState, coreState, formsState, uiState, macroState, rowDomain, chunkText
    End If
    If Len(valueText) >= CATALOG_HASH_STREAM_CHUNK_CHARACTERS Then
        CatalogHashAppendManagedObjectInventoryText allState, coreState, formsState, uiState, macroState, rowDomain, valueText
    Else
        chunkText = chunkText & valueText
    End If
End Sub

Private Sub CatalogHashFlushManagedObjectInventoryText(ByRef allState As CatalogHashState, ByRef coreState As CatalogHashState, ByRef formsState As CatalogHashState, ByRef uiState As CatalogHashState, ByRef macroState As CatalogHashState, ByVal rowDomain As String, ByRef chunkText As String)
    If Len(chunkText) = 0 Then Exit Sub
    CatalogHashAppendManagedObjectInventoryText allState, coreState, formsState, uiState, macroState, rowDomain, chunkText
    chunkText = vbNullString
End Sub

Private Sub CatalogHashAppendManagedObjectInventoryText(ByRef allState As CatalogHashState, ByRef coreState As CatalogHashState, ByRef formsState As CatalogHashState, ByRef uiState As CatalogHashState, ByRef macroState As CatalogHashState, ByVal rowDomain As String, ByVal valueText As String)
    Select Case UCase$(rowDomain)
        Case "CORE": CatalogHashAppendTextPair allState, coreState, valueText
        Case "FORMS": CatalogHashAppendTextPair allState, formsState, valueText
        Case "UI": CatalogHashAppendTextPair allState, uiState, valueText
        Case "MACROS": CatalogHashAppendTextPair allState, macroState, valueText
        Case Else: CatalogHashAppendText allState, valueText
    End Select
End Sub

Private Function CatalogManagedObjectInventoryDomain(ByVal objectType As String, ByVal categoryCode As String, ByVal objectName As String) As String
    objectType = UCase$(Trim$(objectType))
    categoryCode = UCase$(Trim$(categoryCode))
    If objectType = UCase$(ADCAT_OBJECT_TYPE_MACRO) Then
        CatalogManagedObjectInventoryDomain = "Macros"
    ElseIf StrComp(objectName, ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_NavigationPaneGroups_Management"), vbBinaryCompare) = 0 Or StrComp(objectName, ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_RibbonGroups_Management"), vbBinaryCompare) = 0 Or StrComp(objectName, ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_ManagedObjects_RibbonManagement"), vbBinaryCompare) = 0 Or StrComp(objectName, ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_RibbonButtonTargets_Review"), vbBinaryCompare) = 0 Then
        CatalogManagedObjectInventoryDomain = "UI"
    ElseIf objectType = UCase$(ADCAT_OBJECT_TYPE_FORM) Or categoryCode = UCase$(ADCAT_CATEGORY_MANAGED_FORM) Then
        CatalogManagedObjectInventoryDomain = "Forms"
    Else
        'FormDesign rows are queries and therefore remain in the non-form Core partition owned by their established A3/B3 query/catalog authorities; D4 consumes the complete logical catalog after generated Forms are
        'current.
        CatalogManagedObjectInventoryDomain = "Core"
    End If
End Function

