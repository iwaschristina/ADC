    RepairOrReplaceQueryForSetup ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_RibbonButtonTargets_Review"), RibbonButtonTargetsReviewSql(), False
    If definitionsAlreadyDefaulted Then
