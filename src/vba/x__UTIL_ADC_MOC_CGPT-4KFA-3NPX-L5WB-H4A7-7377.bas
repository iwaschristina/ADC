    End If
    ApplyDefaultsOwnedLookupDefinitions tableName
End Sub

Private Function DefaultSystemMacroSourceCurrent(ByRef detailText As String, Optional ByVal defaultCatalog As Variant) As Boolean
    On Error GoTo NotCurrent
    Dim expectedRows As Collection
    Dim expectedByKey As Object
    Dim seenKeys As Object
    Dim rs As DAO.Recordset
    Dim rowData As Variant
    Dim expectedMetadata As Variant
    Dim systemMacroKey As String
    Dim currentTargetTableNames As String
    Dim currentTargetQueryNames As String
    Dim keyItem As Variant
    Dim savedErrNumber As Long
    Dim savedErrDescription As String
    If IsObject(defaultCatalog) Then Set expectedRows = defaultCatalog
    If expectedRows Is Nothing Then Set expectedRows = BuildSystemMacroDefaultCatalog()
    ' INTENTIONAL KEYED LOOKUP: expectedByKey provides keyed membership/lookup over source rows or state already read by DefaultSystemMacroSourceCurrent; it is a derived access path, not a second authority.
    Set expectedByKey = CreateObject("Scripting.Dictionary")
    expectedByKey.CompareMode = vbTextCompare
    For Each rowData In expectedRows
        systemMacroKey = Trim$(SystemMacroCatalogKey(rowData))
        If Len(systemMacroKey) = 0 Then Err.Raise vbObjectError + 9543, "DefaultSystemMacroSourceCurrent", "A canonical built-in System Macro definition has a blank SystemMacroKey."
        If expectedByKey.Exists(systemMacroKey) Then Err.Raise vbObjectError + 9544, "DefaultSystemMacroSourceCurrent", "Duplicate canonical built-in SystemMacroKey: " & systemMacroKey
        expectedByKey.Add systemMacroKey, Array(SystemMacroCatalogTargetTableNames(rowData), SystemMacroCatalogTargetQueryNames(rowData))
    Next rowData
    ' INTENTIONAL KEYED LOOKUP: seenKeys provides keyed membership/lookup over source rows or state already read by DefaultSystemMacroSourceCurrent; it is a derived access path, not a second authority.
    Set seenKeys = CreateObject("Scripting.Dictionary")
    seenKeys.CompareMode = vbTextCompare
    detailText = vbNullString
    If SystemMacroCatalogTableCanOpen() = False Then detailText = "Required table is missing or unavailable: " & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros"): Exit Function
    Set rs = ResolveCatalogDb().OpenRecordset("SELECT [" & FIELD_SYSTEM_MACRO_KEY & "],[" & FIELD_SYSTEM_MACRO_TARGET_TABLE_NAMES & "],[" & FIELD_SYSTEM_MACRO_TARGET_QUERY_NAMES & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & "] WHERE UCase(Trim(Nz(" & SQL_FIELD_DEFAULT_SOURCE & ",'')))=" & SharedDao_SqlQuote(UCase$(DEFAULT_CONSTANT_DEFINITION_SOURCE)) & ";", dbOpenSnapshot)
    Do While rs.EOF = False
        systemMacroKey = Trim$(CStr(Nz(rs.fields(FIELD_SYSTEM_MACRO_KEY).value, vbNullString)))
        If Len(systemMacroKey) = 0 Then detailText = "A VBA-owned built-in MC_Sys row has a blank SystemMacroKey.": GoTo NotCurrent
        If expectedByKey.Exists(systemMacroKey) = False Then detailText = "Noncurrent VBA-owned SystemMacroKey is still present: " & systemMacroKey: GoTo NotCurrent
        If seenKeys.Exists(systemMacroKey) Then detailText = "Duplicate VBA-owned SystemMacroKey is present: " & systemMacroKey: GoTo NotCurrent
        expectedMetadata = expectedByKey(systemMacroKey)
        currentTargetTableNames = Trim$(CStr(Nz(rs.fields(FIELD_SYSTEM_MACRO_TARGET_TABLE_NAMES).value, vbNullString)))
        currentTargetQueryNames = Trim$(CStr(Nz(rs.fields(FIELD_SYSTEM_MACRO_TARGET_QUERY_NAMES).value, vbNullString)))
        If StrComp(currentTargetTableNames, CStr(expectedMetadata(0)), vbBinaryCompare) <> 0 Then detailText = "VBA-owned System Macro table-target metadata is not current: " & systemMacroKey: GoTo NotCurrent
        If StrComp(currentTargetQueryNames, CStr(expectedMetadata(1)), vbBinaryCompare) <> 0 Then detailText = "VBA-owned System Macro query-target metadata is not current: " & systemMacroKey: GoTo NotCurrent
        seenKeys.Add systemMacroKey, True
        rs.MoveNext
    Loop
    rs.Close
    Set rs = Nothing
    If seenKeys.count <> expectedByKey.count Then detailText = "The VBA-owned built-in MC_Sys definition set is incomplete. Expected=" & CStr(expectedByKey.count) & "; found=" & CStr(seenKeys.count) & ".": Exit Function
    For Each keyItem In expectedByKey.keys
        If seenKeys.Exists(CStr(keyItem)) = False Then detailText = "Required VBA-owned SystemMacroKey is missing: " & CStr(keyItem): Exit Function
    Next keyItem
    detailText = "The VBA-owned built-in MC_Sys keys and structured table/query target metadata exactly match the current default definitions (" & CStr(expectedByKey.count) & " rows)."
    DefaultSystemMacroSourceCurrent = True
    Exit Function
NotCurrent:
    savedErrNumber = Err.Number
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    If Len(detailText) = 0 Then detailText = "Could not verify the current VBA-owned MC_Sys definition set. Error " & CStr(savedErrNumber) & ": " & savedErrDescription
End Function

Private Sub DeleteNoncurrentSystemMacroRows(ByVal defaultCatalog As Collection)
    'Defaults is authoritative for the current built-in System Macro set. ADC-owned rows absent from that set are deleted as current-state reconciliation, not historical-version migration; do not add hardcoded
    'historical macro-name cleanup here.
    On Error GoTo ErrHandler
    Dim currentKeys As Object
    Dim rs As DAO.Recordset
    Dim systemMacroKey As String
    Dim deletedCount As Long
    Set currentKeys = CurrentDefaultSystemMacroKeyMap(defaultCatalog)
    Set rs = ResolveCatalogDb().OpenRecordset("SELECT * FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & "] WHERE UCase(Trim(Nz(" & SQL_FIELD_DEFAULT_SOURCE & ",'')))=" & SharedDao_SqlQuote(UCase$(DEFAULT_CONSTANT_DEFINITION_SOURCE)) & ";", dbOpenDynaset)
    Do While rs.EOF = False
        systemMacroKey = Trim$(CStr(Nz(rs.fields(FIELD_SYSTEM_MACRO_KEY).value, vbNullString)))
        If currentKeys.Exists(systemMacroKey) = False Then
            rs.Delete
            deletedCount = deletedCount + 1
        End If
        rs.MoveNext
    Loop
    rs.Close
    If deletedCount > 0 Then
        CatalogMarkSetupDomainsDirty CATALOG_DIRTY_DEFAULTS Or CATALOG_DIRTY_INVENTORY Or CATALOG_DIRTY_UI
        mCatalogSetupSystemMacroInputsChanged = True
        LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "DeleteNoncurrentSystemMacroRows", "Noncurrent ADC-owned MC_Sys rows were removed from the authoritative catalog.", "Rows deleted: " & CStr(deletedCount), "Reconcile built-in system macro definitions", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros"), "SystemMacroCatalog", "CodeDb", "ManagedObjectCatalog"
    End If
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    Err.Raise savedErrNumber, "DeleteNoncurrentSystemMacroRows", "Could not delete noncurrent ADC-owned MC_Sys rows." & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Sub

Private Sub DefaultSystemMacros(ByVal repairDefaultRows As Boolean, Optional ByVal defaultCatalog As Variant)
    Dim rows As Collection
    Dim rowData As Variant
    Dim rawDefaultTitleText As String
    If IsObject(defaultCatalog) Then Set rows = defaultCatalog
    If rows Is Nothing Then Set rows = BuildSystemMacroDefaultCatalog()
    For Each rowData In rows
        PumpSetupResponsiveness
        rawDefaultTitleText = GetSystemMacroCatalogRawDefaultTitleText(rowData)
        DefaultSystemMacro SystemMacroCatalogKey(rowData), SystemMacroCatalogDesignator(rowData), rawDefaultTitleText, SystemMacroCatalogRunCodeFunctionName(rowData), SystemMacroCatalogDescription(rowData), SystemMacroCatalogTargetTableNames(rowData), SystemMacroCatalogTargetQueryNames(rowData), SystemMacroCatalogSortOrder(rowData), repairDefaultRows, SystemMacroCatalogGroupKey(rowData)
    Next rowData
    DeleteNoncurrentSystemMacroRows rows
End Sub

Private Sub RepairSystemMacroDesignatorConflictsFromDefaultCatalog(ByVal repairDefaultRows As Boolean)
    Dim duplicateDetail As String
    If repairDefaultRows = False Then Exit Sub
    If CodeDbTableExists(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros")) = False Then Exit Sub
    If CatalogCountSql("SELECT Count(*) AS " & FIELD_CNT & " FROM (SELECT [" & FIELD_SYSTEM_MACRO_DESIGNATOR & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & "] WHERE Nz([" & FIELD_SYSTEM_MACRO_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " GROUP BY [" & FIELD_SYSTEM_MACRO_DESIGNATOR & "] HAVING Count(*)>1) AS q;") = 0 Then Exit Sub
    duplicateDetail = ActiveSystemMacroDesignatorDuplicateDetail()
    Err.Raise vbObjectError + 8982, "RepairSystemMacroDesignatorConflictsFromDefaultCatalog", "Duplicate active SystemMacroDesignator values exist. Full setup preserved the existing user-entered designators instead of replacing them with VBA defaults." & vbCrLf & vbCrLf & duplicateDetail & vbCrLf & vbCrLf & "Assign unique designators in [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & "], then run setup again."
End Sub

Private Function ActiveSystemMacroDesignatorDuplicateDetail() As String
    On Error GoTo ErrHandler
    Dim rs As DAO.Recordset
    Dim sqlText As String
    Dim detailLines As Collection
    ' INTENTIONAL ORDERED VIEW: detailLines preserves the deterministic sequence required by ActiveSystemMacroDesignatorDuplicateDetail; keyed-only or unordered storage would not preserve the consumer semantics.
    Set detailLines = New Collection
    sqlText = "SELECT s.[" & FIELD_SYSTEM_MACRO_DESIGNATOR & "], s.[" & FIELD_SYSTEM_MACRO_KEY & "], s.[" & FIELD_DEFAULT_TITLE_TEXT & "], s.[" & FIELD_RUN_CODE_WRAPPER_NAME & "] "
    sqlText = sqlText & "FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & "] AS s INNER JOIN ("
    sqlText = sqlText & "SELECT [" & FIELD_SYSTEM_MACRO_DESIGNATOR & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & "] WHERE Nz([" & FIELD_SYSTEM_MACRO_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " GROUP BY [" & FIELD_SYSTEM_MACRO_DESIGNATOR & "] HAVING Count(*)>1"
    sqlText = sqlText & ") AS d ON s.[" & FIELD_SYSTEM_MACRO_DESIGNATOR & "]=d.[" & FIELD_SYSTEM_MACRO_DESIGNATOR & "] "
    sqlText = sqlText & "WHERE Nz(s.[" & FIELD_SYSTEM_MACRO_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " "
    sqlText = sqlText & "ORDER BY " & OrderByPolicyText("CATALOG_SYSTEM_MACRO_DUPLICATE") & ";"
    Set rs = ResolveCatalogDb().OpenRecordset(sqlText, dbOpenSnapshot)
    Do While rs.EOF = False
        PumpSetupResponsiveness
        detailLines.Add "SystemMacroDesignator=" & CStr(rs.fields(FIELD_SYSTEM_MACRO_DESIGNATOR).value) & "; SystemMacroKey=" & CStr(Nz(rs.fields(FIELD_SYSTEM_MACRO_KEY).value, vbNullString)) & "; DefaultTitleText=" & CStr(Nz(rs.fields(FIELD_DEFAULT_TITLE_TEXT).value, vbNullString)) & "; RunCodeWrapperName=" & CStr(Nz(rs.fields(FIELD_RUN_CODE_WRAPPER_NAME).value, vbNullString))
        rs.MoveNext
    Loop
    rs.Close
    ActiveSystemMacroDesignatorDuplicateDetail = SharedCollection_Join(detailLines, vbCrLf)
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    ActiveSystemMacroDesignatorDuplicateDetail = "Duplicate detail query failed. Table=" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & "; Err.Number=" & CStr(savedErrNumber) & "; Err.Source=" & savedErrSource & "; Err.Description=" & savedErrDescription
End Function

Private Sub DefaultSystemMacro(ByVal systemMacroKey As String, ByVal systemMacroDesignator As String, ByVal defaultTitleText As String, ByVal runCodeWrapperName As String, ByVal macroDescription As String, ByVal targetTableNames As String, ByVal targetQueryNames As String, ByVal systemMacroSortOrder As Long, ByVal repairDefaultRows As Boolean, ByVal canonicalSystemMacroGroupKey As String)
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim sqlText As String
    Dim isNewRow As Boolean
    Dim rowChanged As Boolean
    Dim currentSystemMacroGroupKey As String
    Dim currentTargetTableNames As String
    Dim currentTargetQueryNames As String
    Dim groupKeyChanged As Boolean
    Dim targetMetadataChanged As Boolean
    canonicalSystemMacroGroupKey = Trim$(canonicalSystemMacroGroupKey)
    If Len(canonicalSystemMacroGroupKey) = 0 Then Err.Raise vbObjectError + 8980, "DefaultSystemMacro", "The canonical built-in system macro definition has an invalid SystemMacroGroupKey." & vbCrLf & "SystemMacroKey: " & systemMacroKey & vbCrLf & "SystemMacroGroupKey: " & canonicalSystemMacroGroupKey
    If StrComp(defaultTitleText, Trim$(defaultTitleText), vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 10142, "DefaultSystemMacro", "The canonical built-in System Macro definition has noncanonical outer whitespace in DefaultTitleText." & vbCrLf & "SystemMacroKey: " & systemMacroKey & vbCrLf & "DefaultTitleText: [" & defaultTitleText & "]"
    targetTableNames = Trim$(targetTableNames)
    targetQueryNames = Trim$(targetQueryNames)
    Set db = ResolveCatalogDb()
    sqlText = "SELECT * FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & "] WHERE [" & FIELD_SYSTEM_MACRO_KEY & "]=" & SharedDao_SqlQuote(systemMacroKey) & ";"
    Set rs = db.OpenRecordset(sqlText, dbOpenDynaset)
    isNewRow = rs.EOF
    If isNewRow Then
        rs.AddNew
        rs.fields(FIELD_SYSTEM_MACRO_KEY).value = systemMacroKey
        rs.fields(FIELD_SYSTEM_MACRO_DESIGNATOR).value = systemMacroDesignator
        rs.fields(FIELD_DEFAULT_TITLE_TEXT).value = defaultTitleText
        rs.fields(FIELD_MACRO_TITLE_OVERRIDE).value = Null
        rs.fields(FIELD_SYSTEM_MACRO_STATUS).value = ADCAT_STATUS_ACTIVE
        rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value = systemMacroSortOrder
        rs.fields(FIELD_RUN_CODE_WRAPPER_NAME).value = runCodeWrapperName
        rs.fields(FIELD_SYSTEM_MACRO_GROUP_KEY).value = canonicalSystemMacroGroupKey
        If Len(targetTableNames) > 0 Then rs.fields(FIELD_SYSTEM_MACRO_TARGET_TABLE_NAMES).value = targetTableNames Else rs.fields(FIELD_SYSTEM_MACRO_TARGET_TABLE_NAMES).value = Null
        If Len(targetQueryNames) > 0 Then rs.fields(FIELD_SYSTEM_MACRO_TARGET_QUERY_NAMES).value = targetQueryNames Else rs.fields(FIELD_SYSTEM_MACRO_TARGET_QUERY_NAMES).value = Null
        rs.fields(FIELD_MACRO_DESCRIPTION).value = macroDescription
        SetRecordsetFieldValueWithSource rs, FIELD_DEFAULT_SOURCE, DEFAULT_CONSTANT_DEFINITION_SOURCE, "DEFAULT_CONSTANT_DEFINITION_SOURCE"
        rs.fields(FIELD_DEFAULTED_ON).value = Now
        rowChanged = True
    Else
        currentSystemMacroGroupKey = Trim$(CStr(Nz(rs.fields(FIELD_SYSTEM_MACRO_GROUP_KEY).value, vbNullString)))
        currentTargetTableNames = Trim$(CStr(Nz(rs.fields(FIELD_SYSTEM_MACRO_TARGET_TABLE_NAMES).value, vbNullString)))
        currentTargetQueryNames = Trim$(CStr(Nz(rs.fields(FIELD_SYSTEM_MACRO_TARGET_QUERY_NAMES).value, vbNullString)))
        groupKeyChanged = (StrComp(currentSystemMacroGroupKey, canonicalSystemMacroGroupKey, vbBinaryCompare) <> 0)
        targetMetadataChanged = (StrComp(currentTargetTableNames, targetTableNames, vbBinaryCompare) <> 0 Or StrComp(currentTargetQueryNames, targetQueryNames, vbBinaryCompare) <> 0)
        If repairDefaultRows Or groupKeyChanged Or targetMetadataChanged Then
            rs.Edit
            If repairDefaultRows Then
                If Len(CStr(Nz(rs.fields(FIELD_SYSTEM_MACRO_DESIGNATOR).value, vbNullString))) = 0 Then rs.fields(FIELD_SYSTEM_MACRO_DESIGNATOR).value = systemMacroDesignator: rowChanged = True
                If Len(Trim$(CStr(Nz(rs.fields(FIELD_DEFAULT_TITLE_TEXT).value, vbNullString)))) = 0 Then rs.fields(FIELD_DEFAULT_TITLE_TEXT).value = defaultTitleText: rowChanged = True
                If Len(Trim$(CStr(Nz(rs.fields(FIELD_SYSTEM_MACRO_STATUS).value, vbNullString)))) = 0 Then rs.fields(FIELD_SYSTEM_MACRO_STATUS).value = ADCAT_STATUS_ACTIVE: rowChanged = True
                If IsNull(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value) Then rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value = systemMacroSortOrder: rowChanged = True
                If Len(Trim$(CStr(Nz(rs.fields(FIELD_RUN_CODE_WRAPPER_NAME).value, vbNullString)))) = 0 Then rs.fields(FIELD_RUN_CODE_WRAPPER_NAME).value = runCodeWrapperName: rowChanged = True
                If Len(Trim$(CStr(Nz(rs.fields(FIELD_MACRO_DESCRIPTION).value, vbNullString)))) = 0 Then rs.fields(FIELD_MACRO_DESCRIPTION).value = macroDescription: rowChanged = True
                If Len(Trim$(CStr(Nz(rs.fields(FIELD_DEFAULT_SOURCE).value, vbNullString)))) = 0 Then
                    SetRecordsetFieldValueWithSource rs, FIELD_DEFAULT_SOURCE, DEFAULT_CONSTANT_DEFINITION_SOURCE, "DEFAULT_CONSTANT_DEFINITION_SOURCE"
                    rowChanged = True
                End If
            End If
            If groupKeyChanged Then rs.fields(FIELD_SYSTEM_MACRO_GROUP_KEY).value = canonicalSystemMacroGroupKey: rowChanged = True
            If targetMetadataChanged Then
                If Len(targetTableNames) > 0 Then rs.fields(FIELD_SYSTEM_MACRO_TARGET_TABLE_NAMES).value = targetTableNames Else rs.fields(FIELD_SYSTEM_MACRO_TARGET_TABLE_NAMES).value = Null
                If Len(targetQueryNames) > 0 Then rs.fields(FIELD_SYSTEM_MACRO_TARGET_QUERY_NAMES).value = targetQueryNames Else rs.fields(FIELD_SYSTEM_MACRO_TARGET_QUERY_NAMES).value = Null
                rowChanged = True
            End If
            If rowChanged Then rs.fields(FIELD_LAST_DEFAULT_REPAIR_ON).value = Now
        Else
            rs.Close
            Exit Sub
        End If
    End If
    rs.Update
    rs.Close
    If groupKeyChanged Or targetMetadataChanged Then
        If targetMetadataChanged Then
            CatalogMarkSetupDomainsDirty CATALOG_DIRTY_DEFAULTS Or CATALOG_DIRTY_UI
        Else
            CatalogMarkSetupDomainsDirty CATALOG_DIRTY_DEFAULTS
        End If
        mCatalogSetupSystemMacroInputsChanged = True
    End If
    Exit Sub
ErrHandler:
    Dim originalErrNumber As Long
    Dim originalErrDescription As String
    originalErrNumber = Err.Number
    originalErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    Err.Raise originalErrNumber, "DefaultSystemMacro", "Unable to default the built-in system macro row while enforcing canonical classification and target metadata." & vbCrLf & "SystemMacroKey: " & systemMacroKey & vbCrLf & "Table: " & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & vbCrLf & "Description: " & originalErrDescription
End Sub

Private Function BuildSystemMacroTitleMap(ByVal catalogRows As Collection) As Object
    Dim titleMap As Object
    Dim rowData As Variant
    Dim systemMacroKey As String
    ' INTENTIONAL KEYED LOOKUP: titleMap provides keyed membership/lookup over source rows or state already read by BuildSystemMacroTitleMap; it is a derived access path, not a second authority.
    Set titleMap = CreateObject("Scripting.Dictionary")
    titleMap.CompareMode = vbTextCompare
    If catalogRows Is Nothing Then Err.Raise vbObjectError + 9502, "BuildSystemMacroTitleMap", "The system-macro catalog collection is unavailable."
    For Each rowData In catalogRows
        PumpSetupResponsiveness
        systemMacroKey = Trim$(SystemMacroCatalogKey(rowData))
        If Len(systemMacroKey) > 0 Then
            If titleMap.Exists(systemMacroKey) Then Err.Raise vbObjectError + 9503, "BuildSystemMacroTitleMap", "The live system-macro catalog contains a duplicate SystemMacroKey." & vbCrLf & "SystemMacroKey: " & systemMacroKey
            titleMap.Add systemMacroKey, SystemMacroCatalogTitle(rowData)
        End If
    Next rowData
    Set BuildSystemMacroTitleMap = titleMap
End Function

Private Sub ValidateRequiredSystemMacroPlacement(ByVal db As DAO.Database, ByVal systemMacroTitleMap As Object, ByVal systemMacroKey As String, ByVal groupDefinitionIndex As Object, ByVal systemMacroDefinition As Variant)
    Dim MacroTitle As String
    Dim criteriaText As String
    Dim matchCount As Long
    Dim expectedGroup As String
    Dim expectedOrder As Long
    Dim expectedTabKey As String
    Dim expectedTabLabel As String
    systemMacroKey = Trim$(systemMacroKey)
    If systemMacroTitleMap Is Nothing Then Err.Raise vbObjectError + 9480, "ValidateRequiredSystemMacroPlacement", "The required system-macro title index is unavailable." & vbCrLf & "SystemMacroKey: " & systemMacroKey
    If systemMacroTitleMap.Exists(systemMacroKey) Then MacroTitle = CStr(systemMacroTitleMap(systemMacroKey))
    If Len(Trim$(MacroTitle)) = 0 Then Err.Raise vbObjectError + 9480, "ValidateRequiredSystemMacroPlacement", "The required project/add-in system macro title could not be resolved from the setup-scoped title index." & vbCrLf & "SystemMacroKey: " & systemMacroKey
    SystemRibbonPlacementForKey systemMacroKey, expectedTabKey, expectedTabLabel, expectedGroup, expectedOrder, groupDefinitionIndex, systemMacroDefinition
    criteriaText = "Nz([" & FIELD_MANAGED_OBJECT_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE)
    criteriaText = criteriaText & " AND UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))=" & SharedDao_SqlQuote(UCase$(ADCAT_OBJECT_TYPE_MACRO))
    criteriaText = criteriaText & " AND UCase(Trim(Nz([" & FIELD_CATEGORY_CODE & "],'')))=" & SharedDao_SqlQuote(UCase$(ADCAT_CATEGORY_SYSTEM_MACRO))
    criteriaText = criteriaText & " AND UCase(Nz(" & SQL_FIELD_OBJECT_NAME & ",''))=" & SharedDao_SqlQuote(UCase$(MacroTitle))
    criteriaText = criteriaText & " AND UCase(Trim(Nz([" & FIELD_RIBBON_TAB_KEY & "],'')))=" & SharedDao_SqlQuote(UCase$(Trim$(expectedTabKey)))
    criteriaText = criteriaText & " AND UCase(Trim(Nz([" & FIELD_RIBBON_TAB_LABEL & "],'')))=" & SharedDao_SqlQuote(UCase$(Trim$(expectedTabLabel)))
    criteriaText = criteriaText & " AND UCase(Trim(Nz([" & FIELD_RIBBON_GROUP_LABEL & "],'')))=" & SharedDao_SqlQuote(UCase$(expectedGroup))
    criteriaText = criteriaText & " AND Nz([" & FIELD_RIBBON_GROUP_SORT_ORDER & "],0)=" & CStr(expectedOrder)
    matchCount = CountRowsIfTableExists(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), criteriaText)
    If matchCount <> 1 Then Err.Raise vbObjectError + 9481, "ValidateRequiredSystemMacroPlacement", "A required project/add-in system macro is not represented exactly once in " & expectedTabLabel & " > " & expectedGroup & "." & vbCrLf & "SystemMacroKey: " & systemMacroKey & vbCrLf & "Macro: " & MacroTitle & vbCrLf & "Matching managed rows: " & CStr(matchCount)
End Sub

Private Sub DefaultSystemMacroManagedObjectRows(ByVal repairDefaultRows As Boolean, ByVal defaultCatalog As Collection, ByVal systemMacroGroupKeyIndex As Object)
    Dim catalogRows As Collection
    Dim rowData As Variant
    Dim SortOrder As Long
    Dim MacroTitle As String
    Dim runCodeName As String
    Dim descriptionText As String
    Dim systemMacroKey As String
    Dim ribbonGroupLabel As String
    Dim ribbonGroupSortOrder As Long
    Dim ribbonTitle As String
    Dim ribbonTabKey As String
    Dim ribbonTabLabel As String
    Dim processedCount As Long
    Dim totalCount As Long
    Dim groupDefinitionIndex As Object
    Dim systemMacroDefinitions As Collection
    Dim systemMacroDefinitionIndex As Object
    Dim systemMacroDefinition As Variant
    Dim definitionData As Variant
    Dim definitionKey As String
    Dim ribbonStaticTag As String
    If mManagedDefinitionCaptureActive = False Then
        RepairSystemMacroCatalogTable repairDefaultRows, False
    End If
    Set systemMacroDefinitions = x__UTIL_ADC_DEFAULTS.GetSystemMacroDefinitions()
    ' INTENTIONAL KEYED LOOKUP: systemMacroDefinitionIndex provides keyed membership/lookup over source rows or state already read by DefaultSystemMacroManagedObjectRows; it is a derived access path, not a second
    ' authority.
    Set systemMacroDefinitionIndex = CreateObject("Scripting.Dictionary")
    systemMacroDefinitionIndex.CompareMode = vbTextCompare
    For Each definitionData In systemMacroDefinitions
        definitionKey = Trim$(CStr(definitionData(0)))
        If Len(definitionKey) > 0 Then
            If systemMacroDefinitionIndex.Exists(definitionKey) = False Then systemMacroDefinitionIndex.Add definitionKey, definitionData
        End If
    Next definitionData
    Set catalogRows = SystemMacroCatalog(defaultCatalog, systemMacroGroupKeyIndex, systemMacroDefinitions)
    Set groupDefinitionIndex = SystemRibbonGroupDefinitionIndex()
    totalCount = catalogRows.count
    For Each rowData In catalogRows
        PumpSetupResponsiveness
        processedCount = processedCount + 1
        PulseProgressEvery processedCount, 10, "Defaulting system-macro managed object " & CStr(processedCount) & " of " & CStr(totalCount) & ": [" & SystemMacroCatalogTitle(rowData) & "].", totalCount, "CatalogSystemMacroDefaults", "Catalog"
        SortOrder = SystemMacroCatalogSortOrder(rowData) * 10
        If SortOrder < 10 Then SortOrder = 10
        systemMacroKey = SystemMacroCatalogKey(rowData)
        ' Validate required canonical group metadata even though this procedure does not otherwise consume the returned group key.
        Call SystemMacroCatalogGroupKey(rowData)
        MacroTitle = SystemMacroCatalogTitle(rowData)
        runCodeName = SystemMacroCatalogRunCodeFunctionName(rowData)
        descriptionText = SystemMacroCatalogDescription(rowData)
        ribbonStaticTag = vbNullString
        If systemMacroDefinitionIndex.Exists(systemMacroKey) Then
            systemMacroDefinition = systemMacroDefinitionIndex(systemMacroKey)
            SystemRibbonPlacementForKey systemMacroKey, ribbonTabKey, ribbonTabLabel, ribbonGroupLabel, ribbonGroupSortOrder, groupDefinitionIndex, systemMacroDefinition
            ribbonTitle = SystemRibbonTitleForKey(systemMacroKey, systemMacroDefinition)
            ribbonStaticTag = SystemMacroRibbonStaticTag(systemMacroKey, systemMacroDefinition)
        Else
            SystemRibbonPlacementForKey systemMacroKey, ribbonTabKey, ribbonTabLabel, ribbonGroupLabel, ribbonGroupSortOrder, groupDefinitionIndex
            ribbonTitle = SystemRibbonTitleForKey(systemMacroKey)
            ribbonStaticTag = SystemMacroRibbonStaticTag(systemMacroKey)
        End If
        DefaultManagedObject MacroTitle, ADCAT_CATEGORY_SYSTEM_MACRO, ADCAT_OBJECT_TYPE_MACRO, descriptionText, SortOrder, repairDefaultRows, ribbonTabKey, ribbonTabLabel, ribbonGroupLabel, ribbonGroupSortOrder, ribbonTitle, True, vbNullString, vbNullString, ribbonStaticTag
        DefaultActionPayloadForObject MacroTitle, ADCAT_PAYLOAD_ACCESS_MACRO_RUNCODE, vbNullString, runCodeName, descriptionText, MANAGED_OBJECT_CATALOG_SCHEMA_VERSION, SortOrder, repairDefaultRows
        RequireSafeWorkContinue "DefaultSystemMacroManagedObjectRows", "Macro [" & MacroTitle & "]"
    Next rowData
End Sub

' Purpose: Resolves system macro persisted title by key from the supplied/current ADC state, using `ManagedObjectPhysicalName` and `CodeDbTableExists` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   systemMacroKey (Input; String): Stable identity/key used to select the system macro key definition, row, workflow part, or managed object without relying on display text.
' Returns: String: Returns the system macro persisted title by key text value. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not
'   resolved.
Public Function SystemMacroPersistedTitleByKey(ByVal systemMacroKey As String) As String
    'Narrow persisted-catalog lookup for callers that need the current physical macro name without constructing the complete built-in System Macro definition set.
    On Error GoTo ErrHandler
    Dim rs As DAO.Recordset
    Dim sqlText As String
    Dim tableName As String
    Dim macroDesignator As String
    Dim macroTitleOverride As String
    Dim resolvedTitleText As String
    systemMacroKey = Trim$(systemMacroKey)
    If Len(systemMacroKey) = 0 Then Exit Function
    tableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros")
    If CodeDbTableExists(tableName) = False Then Exit Function
    If TableCanOpen(tableName) = False Then Exit Function
    sqlText = "SELECT [" & FIELD_SYSTEM_MACRO_DESIGNATOR & "],[" & FIELD_DEFAULT_TITLE_TEXT & "],[" & FIELD_MACRO_TITLE_OVERRIDE & "] FROM [" & tableName & "] " & _
        "WHERE [" & FIELD_SYSTEM_MACRO_KEY & "]=" & SharedDao_SqlQuote(systemMacroKey) & " AND Nz([" & FIELD_SYSTEM_MACRO_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND Len(Nz([" & FIELD_RUN_CODE_WRAPPER_NAME & "],''))>0;"
    Set rs = ResolveCatalogDb().OpenRecordset(sqlText, dbOpenSnapshot)
    If rs.EOF = False Then
        macroDesignator = CStr(Nz(rs.fields(FIELD_SYSTEM_MACRO_DESIGNATOR).value, vbNullString))
        macroTitleOverride = Trim$(CStr(Nz(rs.fields(FIELD_MACRO_TITLE_OVERRIDE).value, vbNullString)))
        If Len(macroTitleOverride) > 0 Then
            SystemMacroPersistedTitleByKey = macroTitleOverride
        Else
            resolvedTitleText = CStr(Nz(rs.fields(FIELD_DEFAULT_TITLE_TEXT).value, vbNullString))
            SystemMacroPersistedTitleByKey = SystemMacroCalculatedTitleFromResolvedValues(macroDesignator, resolvedTitleText)
        End If
    End If
    rs.Close
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    Err.Raise savedErrNumber, "SystemMacroPersistedTitleByKey", "Could not resolve the current persisted System Macro title by SystemMacroKey." & vbCrLf & "SystemMacroKey: " & systemMacroKey & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Function

' Purpose: Resolves and returns system macro deletion membership rows from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   rowsRead (Output; Long): Receives the resolved rows read produced from this procedure's validated inputs and current ADC state.
' Returns: Collection: Returns the system macro deletion membership rows object/collection resolved by this routine for direct use by the caller; the routine's documented absence/error path applies when no such
'   object can be resolved.
Public Function SystemMacroDeletionMembershipRows(ByRef rowsRead As Long) As Collection
    'Narrow persisted-catalog read for Phase C destructive membership. It intentionally avoids System Macro definitions, Navigation Pane definitions, and Setup Part roster construction.
    On Error GoTo ErrHandler
    Dim rows As New Collection
    Dim rs As DAO.Recordset
    Dim sqlText As String
    Dim systemMacroKey As String
    Dim TitleText As String
    Dim macroTitleOverride As String
    Dim MacroTitle As String
    Dim runCodeExpression As String
    Dim macroDesignator As String
    rowsRead = 0
    sqlText = "SELECT [" & FIELD_SYSTEM_MACRO_KEY & "],[" & FIELD_SYSTEM_MACRO_DESIGNATOR & "],[" & FIELD_DEFAULT_TITLE_TEXT & "],[" & FIELD_MACRO_TITLE_OVERRIDE & "],[" & FIELD_RUN_CODE_WRAPPER_NAME & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & "] " & _
        "WHERE Nz([" & FIELD_SYSTEM_MACRO_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND Len(Nz([" & FIELD_RUN_CODE_WRAPPER_NAME & "],''))>0;"
    Set rs = ResolveCatalogDb().OpenRecordset(sqlText, dbOpenSnapshot)
    Do While rs.EOF = False
        PumpSetupResponsiveness
        rowsRead = rowsRead + 1
        systemMacroKey = Trim$(CStr(Nz(rs.fields(FIELD_SYSTEM_MACRO_KEY).value, vbNullString)))
        macroDesignator = CStr(Nz(rs.fields(FIELD_SYSTEM_MACRO_DESIGNATOR).value, vbNullString))
        macroTitleOverride = Trim$(CStr(Nz(rs.fields(FIELD_MACRO_TITLE_OVERRIDE).value, vbNullString)))
        If Len(macroTitleOverride) > 0 Then
            MacroTitle = macroTitleOverride
        Else
            TitleText = CStr(Nz(rs.fields(FIELD_DEFAULT_TITLE_TEXT).value, vbNullString))
            MacroTitle = SystemMacroCalculatedTitleFromResolvedValues(macroDesignator, TitleText)
        End If
        runCodeExpression = Trim$(CStr(rs.fields(FIELD_RUN_CODE_WRAPPER_NAME).value))
        If Len(Trim$(MacroTitle)) > 0 Then rows.Add Array(systemMacroKey, MacroTitle, runCodeExpression)
        rs.MoveNext
    Loop
    rs.Close
    Set SystemMacroDeletionMembershipRows = rows
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    Err.Raise savedErrNumber, "SystemMacroDeletionMembershipRows", "Could not read the narrow active MC_Sys deletion membership." & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Function

' Purpose: Resolves system macro catalog from the supplied/current ADC state, using `isMissing` and `IsObject` where required by the lookup path.
' Public role: Public dynamic/form expression API. The name is referenced as text outside this module, so Public visibility is required for Access or generated-expression resolution.
' Parameters:
'   suppliedDefaultCatalog (Input Optional; Variant): Variant input representing supplied default catalog; the routine accepts the caller-provided value in the form required by its existing validation and
'   conversion logic.
'   suppliedSystemMacroGroupKeyIndex (Input Optional; Variant): Numeric supplied system macro group key index value used by the routine for identity, ordering, limits, or counts as indicated by the
'   parameter name.
'   suppliedSystemMacroDefinitions (Input Optional; Variant): Variant input representing supplied system macro definitions; the routine accepts the caller-provided value in the form required by its
'   existing validation and conversion logic.
' Returns: Collection: Returns the ordered Collection assembled by the routine; callers receive the object reference and should treat its membership/order according to the routine contract.
Public Function SystemMacroCatalog(Optional ByVal suppliedDefaultCatalog As Variant, Optional ByVal suppliedSystemMacroGroupKeyIndex As Variant, Optional ByVal suppliedSystemMacroDefinitions As Variant) As Collection
    'Primary source of truth for built-in system macro rows is the context-owned MC_Sys table. The hard-coded default catalog is retained only so setup can bootstrap when the table is missing or not openable.
    Dim defaultCatalog As Collection
    Dim systemMacroGroupKeyIndex As Object
    Dim systemMacroDefinitions As Collection
    If isMissing(suppliedDefaultCatalog) = False Then
        If IsObject(suppliedDefaultCatalog) Then Set defaultCatalog = suppliedDefaultCatalog
    End If
    If isMissing(suppliedSystemMacroGroupKeyIndex) = False Then
        If IsObject(suppliedSystemMacroGroupKeyIndex) Then Set systemMacroGroupKeyIndex = suppliedSystemMacroGroupKeyIndex
    End If
    If isMissing(suppliedSystemMacroDefinitions) = False Then
        If IsObject(suppliedSystemMacroDefinitions) Then Set systemMacroDefinitions = suppliedSystemMacroDefinitions
    End If
    If SystemMacroCatalogTableCanOpen() Then
        If systemMacroDefinitions Is Nothing Then Set systemMacroDefinitions = x__UTIL_ADC_DEFAULTS.GetSystemMacroDefinitions()
        Set SystemMacroCatalog = SystemMacroCatalogFromSystemMacroTable(defaultCatalog, systemMacroGroupKeyIndex, systemMacroDefinitions)
    Else
        If defaultCatalog Is Nothing Then
            If systemMacroDefinitions Is Nothing Then
                If systemMacroGroupKeyIndex Is Nothing Then
                    Set defaultCatalog = BuildSystemMacroDefaultCatalog()
                Else
                    Set defaultCatalog = BuildSystemMacroDefaultCatalog(systemMacroGroupKeyIndex)
                End If
            Else
                Set defaultCatalog = BuildSystemMacroDefaultCatalog(systemMacroGroupKeyIndex, systemMacroDefinitions)
            End If
        End If
        Set SystemMacroCatalog = defaultCatalog
    End If
End Function

Private Function SystemMacroCatalogTableCanOpen() As Boolean
    On Error GoTo ErrHandler
    If CodeDbTableExists(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros")) = False Then Exit Function
    If TableCanOpen(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros"), True) = False Then Exit Function
    SystemMacroCatalogTableCanOpen = True
    Exit Function
ErrHandler:
    SystemMacroCatalogTableCanOpen = False
End Function

Private Function SystemMacroDefaultDescriptionCache(ByVal defaultCatalog As Collection) As Object
    Dim cache As Object
    Dim rowData As Variant
    ' INTENTIONAL KEYED LOOKUP: cache provides keyed membership/lookup over source rows or state already read by SystemMacroDefaultDescriptionCache; it is a derived access path, not a second authority.
    Set cache = CreateObject("Scripting.Dictionary")
    cache.CompareMode = vbTextCompare
    For Each rowData In defaultCatalog
        PumpSetupResponsiveness
        If cache.Exists(CStr(rowData(0))) = False Then cache.Add CStr(rowData(0)), CStr(rowData(4))
    Next rowData
    Set SystemMacroDefaultDescriptionCache = cache
End Function

Private Function SystemMacroRequiredDescriptionFromCaches(ByVal systemMacroKey As String, ByVal MacroTitle As String, ByVal runCodeExpression As String, ByVal fallbackText As String, ByVal defaultDescriptions As Object, ByVal managedDescriptions As Object) As String
    Dim defaultDescription As String
    Dim managedDescription As String
    If Not defaultDescriptions Is Nothing Then
        If defaultDescriptions.Exists(systemMacroKey) Then defaultDescription = CStr(defaultDescriptions(systemMacroKey))
    End If
    If Len(Trim$(defaultDescription)) = 0 Then defaultDescription = SystemMacroFallbackDescription(systemMacroKey, MacroTitle, runCodeExpression)
    managedDescription = fallbackText
    If Not managedDescriptions Is Nothing Then
        If managedDescriptions.Exists(MacroTitle) Then managedDescription = CStr(managedDescriptions(MacroTitle))
    End If
    If Len(Trim$(managedDescription)) = 0 Then
        SystemMacroRequiredDescriptionFromCaches = defaultDescription
    Else
        SystemMacroRequiredDescriptionFromCaches = managedDescription
    End If
End Function

Private Function CurrentDefaultSystemMacroKeyMap(ByVal defaultCatalog As Collection) As Object
    Dim keyMap As Object
    Dim rowData As Variant
    Dim systemMacroKey As String
    ' INTENTIONAL KEYED LOOKUP: keyMap provides keyed membership/lookup over source rows or state already read by CurrentDefaultSystemMacroKeyMap; it is a derived access path, not a second authority.
    Set keyMap = CreateObject("Scripting.Dictionary")
    keyMap.CompareMode = vbTextCompare
    For Each rowData In defaultCatalog
        systemMacroKey = Trim$(SystemMacroCatalogKey(rowData))
        If Len(systemMacroKey) > 0 Then keyMap(systemMacroKey) = True
    Next rowData
    Set CurrentDefaultSystemMacroKeyMap = keyMap
End Function

Private Function SystemMacroCatalogFromSystemMacroTable(Optional ByVal suppliedDefaultCatalog As Variant, Optional ByVal suppliedSystemMacroGroupKeyIndex As Variant, Optional ByVal suppliedSystemMacroDefinitions As Variant) As Collection
    On Error GoTo ErrHandler
    Dim rows As Collection
    Dim rs As DAO.Recordset
    Dim sqlText As String
    Dim MacroTitle As String
    Dim macroDesignator As String
    Dim defaultTitleText As String
    Dim macroTitleOverride As String
    Dim systemMacroKey As String
    Dim runCodeExpression As String
    Dim descriptionText As String
    Dim systemMacroGroupKey As String
    Dim targetTableNames As String
    Dim targetQueryNames As String
    Dim defaultSource As String
    Dim navigationPaneDefinitions As Collection
    Dim systemMacroGroupDefinitions As Collection
    Dim defaultCatalog As Collection
    Dim defaultDescriptions As Object
    Dim managedDescriptions As Object
    Dim currentDefaultKeys As Object
    Dim systemMacroGroupKeyIndex As Object
    Dim systemMacroDefinitions As Collection
    Dim systemMacroDefinitionIndex As Object
    Dim definitionData As Variant
    Dim systemMacroDefinition As Variant
    Dim definitionKey As String
    Dim systemMacroDefinitionKnown As Boolean
    Dim persistedSystemMacroGroupKey As Variant
    Dim missingSystemMacroDefinition As Variant
    ' INTENTIONAL FILTERED PARTITION: rows is a consumer-required subset/projection derived from the source enumerated by SystemMacroCatalogFromSystemMacroTable; its membership is not independently authoritative.
    Set rows = New Collection
    If isMissing(suppliedSystemMacroGroupKeyIndex) = False Then
        If IsObject(suppliedSystemMacroGroupKeyIndex) Then Set systemMacroGroupKeyIndex = suppliedSystemMacroGroupKeyIndex
    End If
    If systemMacroGroupKeyIndex Is Nothing Then
        Set navigationPaneDefinitions = NavigationPaneGroupDefinitions()
        Set systemMacroGroupDefinitions = SystemMacroNavigationPaneGroupDefinitions(navigationPaneDefinitions)
        Set systemMacroGroupKeyIndex = SystemMacroNavigationPaneGroupKeyIndex(systemMacroGroupDefinitions)
    End If
    If isMissing(suppliedSystemMacroDefinitions) = False Then
        If IsObject(suppliedSystemMacroDefinitions) Then Set systemMacroDefinitions = suppliedSystemMacroDefinitions
    End If
    If systemMacroDefinitions Is Nothing Then Set systemMacroDefinitions = x__UTIL_ADC_DEFAULTS.GetSystemMacroDefinitions()
    ' INTENTIONAL KEYED LOOKUP: systemMacroDefinitionIndex provides keyed membership/lookup over source rows or state already read by SystemMacroCatalogFromSystemMacroTable; it is a derived access path, not a second
    ' authority.
    Set systemMacroDefinitionIndex = CreateObject("Scripting.Dictionary")
    systemMacroDefinitionIndex.CompareMode = vbTextCompare
    For Each definitionData In systemMacroDefinitions
        definitionKey = Trim$(CStr(definitionData(0)))
        If Len(definitionKey) > 0 Then
            If systemMacroDefinitionIndex.Exists(definitionKey) = False Then systemMacroDefinitionIndex.Add definitionKey, definitionData
        End If
    Next definitionData
    If isMissing(suppliedDefaultCatalog) = False Then
        If IsObject(suppliedDefaultCatalog) Then Set defaultCatalog = suppliedDefaultCatalog
    End If
    If defaultCatalog Is Nothing Then Set defaultCatalog = BuildSystemMacroDefaultCatalog(systemMacroGroupKeyIndex, systemMacroDefinitions)
    Set defaultDescriptions = SystemMacroDefaultDescriptionCache(defaultCatalog)
    Set managedDescriptions = ManagedMacroDescriptionCache()
    Set currentDefaultKeys = CurrentDefaultSystemMacroKeyMap(defaultCatalog)
    sqlText = "SELECT * FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & "] "
    sqlText = sqlText & "WHERE Nz([" & FIELD_SYSTEM_MACRO_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE)
    sqlText = sqlText & " AND Len(Nz([" & FIELD_RUN_CODE_WRAPPER_NAME & "],''))>0 "
    sqlText = sqlText & "ORDER BY " & OrderByPolicyText("CATALOG_SYSTEM_MACRO") & ";"
    Set rs = ResolveCatalogDb().OpenRecordset(sqlText, dbOpenSnapshot)
    Do While rs.EOF = False
        PumpSetupResponsiveness
        systemMacroKey = Trim$(CStr(Nz(rs.fields(FIELD_SYSTEM_MACRO_KEY).value, vbNullString)))
        systemMacroDefinitionKnown = systemMacroDefinitionIndex.Exists(systemMacroKey)
        If systemMacroDefinitionKnown Then systemMacroDefinition = systemMacroDefinitionIndex(systemMacroKey)
        defaultSource = Trim$(CStr(Nz(FieldValueIfExists(rs, "DefaultSource"), vbNullString)))
        If StrComp(defaultSource, DEFAULT_CONSTANT_DEFINITION_SOURCE, vbTextCompare) <> 0 Or currentDefaultKeys.Exists(systemMacroKey) Then
            macroDesignator = CStr(Nz(rs.fields(FIELD_SYSTEM_MACRO_DESIGNATOR).value, vbNullString))
            defaultTitleText = CStr(Nz(rs.fields(FIELD_DEFAULT_TITLE_TEXT).value, vbNullString))
            macroTitleOverride = CStr(Nz(rs.fields(FIELD_MACRO_TITLE_OVERRIDE).value, vbNullString))
            runCodeExpression = CStr(rs.fields(FIELD_RUN_CODE_WRAPPER_NAME).value)
            If systemMacroDefinitionKnown Then
                MacroTitle = SystemMacroActualTitleFromValues(macroDesignator, defaultTitleText, macroTitleOverride, systemMacroKey, systemMacroDefinition)
            Else
                MacroTitle = SystemMacroActualTitleFromValues(macroDesignator, defaultTitleText, macroTitleOverride, systemMacroKey, missingSystemMacroDefinition)
            End If
            If Len(Trim$(MacroTitle)) > 0 Then
                descriptionText = SystemMacroRequiredDescriptionFromCaches(systemMacroKey, MacroTitle, runCodeExpression, CStr(Nz(rs.fields(FIELD_MACRO_DESCRIPTION).value, vbNullString)), defaultDescriptions, managedDescriptions)
                persistedSystemMacroGroupKey = FieldValueIfExists(rs, FIELD_SYSTEM_MACRO_GROUP_KEY)
                If IsNull(persistedSystemMacroGroupKey) Then
                    If systemMacroDefinitionKnown Then systemMacroGroupKey = Trim$(CStr(systemMacroDefinition(4))) Else systemMacroGroupKey = vbNullString
                Else
                    systemMacroGroupKey = CStr(persistedSystemMacroGroupKey)
                End If
                targetTableNames = Trim$(CStr(Nz(rs.fields(FIELD_SYSTEM_MACRO_TARGET_TABLE_NAMES).value, vbNullString)))
                targetQueryNames = Trim$(CStr(Nz(rs.fields(FIELD_SYSTEM_MACRO_TARGET_QUERY_NAMES).value, vbNullString)))
                AddSystemMacroCatalogRow rows, systemMacroGroupKeyIndex, systemMacroKey, macroDesignator, MacroTitle, runCodeExpression, descriptionText, systemMacroGroupKey, targetTableNames, targetQueryNames, CLng(Nz(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value, 0)), defaultTitleText
            End If
        End If
        rs.MoveNext
    Loop
    rs.Close
    Set SystemMacroCatalogFromSystemMacroTable = rows
    Exit Function
ErrHandler:
    Dim originalErrNumber As Long
    Dim originalErrDescription As String
    originalErrNumber = Err.Number
    originalErrDescription = Err.Description
    Err.Raise originalErrNumber, "SystemMacroCatalogFromSystemMacroTable", "Unable to load current authoritative and user-maintained system macro catalog rows from [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & "]." & vbCrLf & "Table: " & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & vbCrLf & "Description: " & originalErrDescription
End Function

Private Function BuildSystemMacroDefaultCatalog(Optional ByVal systemMacroGroupKeyIndex As Variant, Optional ByVal suppliedSystemMacroDefinitions As Variant) As Collection
    'Authoritative raw system-macro definitions are owned by
    'Catalog behavior calculates physical titles and RunCode expressions from those definitions.
    ' INTENTIONAL FILTERED PROJECTION: rows transforms authoritative SystemMacro definitions into the catalog-facing default rows (physical title, RunCode, group metadata); x__UTIL_ADC_DEFAULTS remains the
    ' definition authority.
    Dim rows As New Collection
    Dim navigationPaneDefinitions As Collection
    Dim systemMacroGroupDefinitions As Collection
    Dim resolvedSystemMacroGroupKeyIndex As Object
    Dim systemMacroDefinitions As Collection
    Dim defaultRow As Variant
    If IsObject(systemMacroGroupKeyIndex) Then Set resolvedSystemMacroGroupKeyIndex = systemMacroGroupKeyIndex
    If resolvedSystemMacroGroupKeyIndex Is Nothing Then
        Set navigationPaneDefinitions = NavigationPaneGroupDefinitions()
        Set systemMacroGroupDefinitions = SystemMacroNavigationPaneGroupDefinitions(navigationPaneDefinitions)
        Set resolvedSystemMacroGroupKeyIndex = SystemMacroNavigationPaneGroupKeyIndex(systemMacroGroupDefinitions)
    End If
    If isMissing(suppliedSystemMacroDefinitions) = False Then
        If IsObject(suppliedSystemMacroDefinitions) Then Set systemMacroDefinitions = suppliedSystemMacroDefinitions
    End If
    If systemMacroDefinitions Is Nothing Then Set systemMacroDefinitions = x__UTIL_ADC_DEFAULTS.GetSystemMacroDefinitions()
    For Each defaultRow In systemMacroDefinitions
        AddSystemMacroCatalogRow _
            rows, _
            resolvedSystemMacroGroupKeyIndex, _
            CStr(defaultRow(0)), _
            CStr(defaultRow(1)), _
            SystemMacroCalculatedTitle(CStr(defaultRow(1)), CStr(defaultRow(2)), CStr(defaultRow(0)), defaultRow), _
            SystemMacroCommandRunCodeExpression(CStr(defaultRow(0))), _
            CStr(defaultRow(3)), _
            CStr(defaultRow(4)), _
            SystemMacroTargetTableNamesFromDefinition(defaultRow), _
            SystemMacroTargetQueryNamesFromDefinition(defaultRow), _
            SystemMacroSortOrderFromDefinition(defaultRow), _
            SystemMacroCatalogDefaultTitleText(CStr(defaultRow(0)), CStr(defaultRow(2)), defaultRow)
    Next defaultRow
    Set BuildSystemMacroDefaultCatalog = rows
End Function

Private Function SystemMacroNavigationPaneGroupKeyIndex(ByVal groupDefinitions As Collection) As Object
    Dim keyIndex As Object
    Dim rowData As Variant
    Dim groupKey As String
    ' INTENTIONAL KEYED LOOKUP: keyIndex provides keyed membership/lookup over source rows or state already read by SystemMacroNavigationPaneGroupKeyIndex; it is a derived access path, not a second authority.
    Set keyIndex = CreateObject("Scripting.Dictionary")
    keyIndex.CompareMode = vbTextCompare
    For Each rowData In groupDefinitions
        groupKey = Trim$(CStr(rowData(0)))
        If Len(groupKey) > 0 Then
            If keyIndex.Exists(groupKey) Then Err.Raise vbObjectError + 7801, "SystemMacroNavigationPaneGroupKeyIndex", "More than one authoritative Navigation Pane group definition matches the requested System Macro group key." & vbCrLf & "SystemMacroGroupKey: " & groupKey
            keyIndex.Add groupKey, CStr(rowData(0))
        End If
    Next rowData
    Set SystemMacroNavigationPaneGroupKeyIndex = keyIndex
End Function

Private Sub AddSystemMacroCatalogRow(ByRef rows As Collection, ByVal systemMacroGroupKeyIndex As Object, ByVal systemMacroKey As String, ByVal systemMacroDesignator As String, ByVal MacroTitle As String, ByVal runCodeFunctionName As String, ByVal descriptionText As String, ByVal systemMacroGroupKey As String, ByVal targetTableNames As String, ByVal targetQueryNames As String, ByVal systemMacroSortOrder As Long, ByVal rawDefaultTitleText As String)
    Dim normalizedSystemMacroGroupKey As String
    systemMacroGroupKey = Trim$(systemMacroGroupKey)
    If Not systemMacroGroupKeyIndex Is Nothing Then
        If systemMacroGroupKeyIndex.Exists(systemMacroGroupKey) Then normalizedSystemMacroGroupKey = CStr(systemMacroGroupKeyIndex(systemMacroGroupKey))
    End If
    If Len(normalizedSystemMacroGroupKey) = 0 Then Err.Raise vbObjectError + 8981, "AddSystemMacroCatalogRow", "The system macro catalog row has an invalid SystemMacroGroupKey." & vbCrLf & "SystemMacroKey: " & systemMacroKey & vbCrLf & "SystemMacroGroupKey: " & systemMacroGroupKey
    rows.Add Array(systemMacroKey, systemMacroDesignator, MacroTitle, runCodeFunctionName, descriptionText, normalizedSystemMacroGroupKey, Trim$(targetTableNames), Trim$(targetQueryNames), systemMacroSortOrder, rawDefaultTitleText)
End Sub

' Purpose: Resolves system macro catalog group key from the supplied/current ADC state, using `End` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   rowData (Input; Variant): Variant input representing row data; the routine accepts the caller-provided value in the form required by its existing validation and conversion logic.
' Returns: String: Returns the system macro catalog group key text value. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not
'   resolved.
Public Function SystemMacroCatalogGroupKey(ByVal rowData As Variant) As String
    'Intended use: Returns the explicit validated System Macro Catalog Group Key; malformed catalog rows fail rather than receiving an invented fallback group.
    If UBound(rowData) < 5 Then Err.Raise vbObjectError + 8983, "SystemMacroCatalogGroupKey", "The system macro catalog row does not contain a SystemMacroGroupKey value."
    SystemMacroCatalogGroupKey = CStr(rowData(5))
