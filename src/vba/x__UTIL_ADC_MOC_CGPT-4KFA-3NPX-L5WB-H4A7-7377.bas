Private Sub B2AddMetadataDependency(ByVal dependencyRows As Object, ByVal dependencyName As String, ByVal expectedObjectType As String, Optional ByVal requiredFieldName As String = vbNullString)
    Dim dependencyKey As String
    dependencyName = Trim$(dependencyName)
    expectedObjectType = Trim$(expectedObjectType)
    requiredFieldName = Trim$(requiredFieldName)
    If Left$(dependencyName, 1) = "[" And Right$(dependencyName, 1) = "]" Then dependencyName = Replace(Mid$(dependencyName, 2, Len(dependencyName) - 2), "]]", "]")
    If Len(dependencyName) = 0 Or Len(expectedObjectType) = 0 Then Exit Sub
    dependencyKey = UCase$(expectedObjectType) & Chr$(30) & UCase$(dependencyName) & Chr$(30) & UCase$(requiredFieldName)
    If dependencyRows.Exists(dependencyKey) = False Then dependencyRows.Add dependencyKey, Array(expectedObjectType, dependencyName, requiredFieldName)
End Sub

Private Sub B2CollectDefinitionDependencies(ByVal Definition As Variant, ByVal dependencyRows As Object)
    Dim definitionKind As String
    Dim rowSourceText As String
    definitionKind = UCase$(CStr(Definition(0)))
    Select Case definitionKind
        Case UCase$(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_TABLE)
            B2AddMetadataDependency dependencyRows, CStr(Definition(2)), ADCAT_OBJECT_TYPE_TABLE
            B2AddMetadataDependency dependencyRows, CStr(Definition(2)), "TableField", CStr(Definition(3))
            If Len(Trim$(CStr(Definition(4)))) > 0 Then B2AddMetadataDependency dependencyRows, CStr(Definition(2)), "TableField", CStr(Definition(4))
        Case UCase$(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_LIVE)
            rowSourceText = Trim$(CStr(Definition(2)))
            B2CollectSqlSourceNames rowSourceText, dependencyRows
    End Select
End Sub

Private Function B2MetadataDefinitionPayload(ByVal tableName As String, ByVal definitions As Collection, ByVal dependencyRows As Object) As String
    Dim Definition As Variant
    Dim itemIndex As Long
    Dim payloadText As String
    Dim policyCode As String
    Dim editorFormName As String
    payloadText = FingerprintTokenPart(UCase$(tableName))
    For Each Definition In definitions
        For itemIndex = LBound(Definition) To UBound(Definition)
            payloadText = payloadText & FingerprintTokenPart(CStr(Definition(itemIndex)))
        Next itemIndex
        If StrComp(CStr(Definition(0)), CATALOG_FIELD_LOOKUP_DEFINITION_KIND_TABLE, vbTextCompare) = 0 Then
            payloadText = payloadText & FingerprintTokenPart(LookupEditorPolicyFingerprintForPhysicalSource(CStr(Definition(2))))
            editorFormName = LookupEditorPhysicalFormNameForSource(CStr(Definition(2)), policyCode)
            payloadText = payloadText & FingerprintTokenPart("ExpectedEditor=" & editorFormName)
        End If
        B2CollectDefinitionDependencies Definition, dependencyRows
    Next Definition
    B2MetadataDefinitionPayload = payloadText
End Function

Private Function B2MetadataDependencyPayload(ByVal db As DAO.Database, ByVal dependencyRows As Object, ByRef allDependenciesPresent As Boolean) As String
    Dim dependencyKeys As Variant
    Dim dependencyIndex As Long
    Dim dependencyData As Variant
    Dim expectedObjectType As String
    Dim dependencyName As String
    Dim requiredFieldName As String
    Dim qdf As DAO.queryDef
    Dim tdf As DAO.tableDef
    Dim fld As DAO.Field
    Dim payloadText As String
    allDependenciesPresent = True
    If dependencyRows.count = 0 Then Exit Function
    dependencyKeys = dependencyRows.keys
    B2SortTextArray dependencyKeys
    For dependencyIndex = LBound(dependencyKeys) To UBound(dependencyKeys)
        dependencyData = dependencyRows.item(CStr(dependencyKeys(dependencyIndex)))
        expectedObjectType = CStr(dependencyData(0))
        dependencyName = CStr(dependencyData(1))
        requiredFieldName = CStr(dependencyData(2))
        payloadText = payloadText & FingerprintTokenPart(expectedObjectType)
        payloadText = payloadText & FingerprintTokenPart(dependencyName)
        payloadText = payloadText & FingerprintTokenPart(requiredFieldName)
        Select Case UCase$(expectedObjectType)
            Case UCase$(ADCAT_OBJECT_TYPE_QUERY)
                Set qdf = Nothing
                On Error Resume Next
                Set qdf = db.QueryDefs(dependencyName)
                Err.Clear
                On Error GoTo 0
                If qdf Is Nothing Then
                    payloadText = payloadText & FingerprintTokenPart("<missing-query>")
                    allDependenciesPresent = False
                Else
                    payloadText = payloadText & FingerprintTokenPart(qdf.sql)
                End If
            Case UCase$(ADCAT_OBJECT_TYPE_TABLE)
                Set tdf = Nothing
                On Error Resume Next
                Set tdf = db.TableDefs(dependencyName)
                Err.Clear
                On Error GoTo 0
                If tdf Is Nothing Then
                    payloadText = payloadText & FingerprintTokenPart("<missing-table>")
                    allDependenciesPresent = False
                Else
                    payloadText = payloadText & FingerprintTokenPart("<table-present>")
                End If
            Case "TABLEFIELD"
                Set tdf = Nothing
                Set fld = Nothing
                On Error Resume Next
                Set tdf = db.TableDefs(dependencyName)
                If Not tdf Is Nothing Then Set fld = tdf.fields(requiredFieldName)
                Err.Clear
                On Error GoTo 0
                If fld Is Nothing Then
                    payloadText = payloadText & FingerprintTokenPart("<missing-source-field>")
                    allDependenciesPresent = False
                Else
                    payloadText = payloadText & FingerprintTokenPart(CStr(fld.Type))
                    payloadText = payloadText & FingerprintTokenPart(CStr(fld.Size))
                    payloadText = payloadText & FingerprintTokenPart(CStr(fld.Attributes))
                End If
            Case "LOOKUPEDITORFORM"
                If SharedDao_AccessObjectExists(db, acForm, dependencyName) Then
                    payloadText = payloadText & FingerprintTokenPart("<form-present>")
                Else
                    'Form availability changes invalidate B2 currentness, but a missing D2-owned generated form is not a missing B2 structural input.
                    payloadText = payloadText & FingerprintTokenPart("<form-missing>")
                End If
            Case Else
                Err.Raise vbObjectError + 9515, "B2MetadataDependencyPayload", "A B2 metadata dependency has an unsupported expected object type." & vbCrLf & "Dependency: " & dependencyName & vbCrLf & "Expected type: " & expectedObjectType
        End Select
    Next dependencyIndex
    B2MetadataDependencyPayload = payloadText
End Function

