                FIELD_CATALOG_OWNER & "], " & SQL_FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER & ", [" & FIELD_MANAGED_OBJECT_VERSION & "], " & SQL_FIELD_LAST_VALIDATED_ON & ", " & SQL_FIELD_LAST_SETUP_ACTION_ON & ", " & SQL_FIELD_LAST_SETUP_RESULT & ", " & SQL_FIELD_LAST_SETUP_MESSAGE & ", " & SQL_FIELD_MANUAL_REVIEW_NOTES & ", [" & FIELD_DEFAULTED_ON & "], [" & FIELD_LAST_DEFAULT_REPAIR_ON & "], " & SQL_FIELD_DEFAULT_SOURCE & ", " & SQL_FIELD_MANAGED_OBJECT_DEPENDENCY_NOTES & " "
    sqlText = sqlText & "FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] ORDER BY " & OrderByPolicyText("CATALOG_RIBBON_MANAGED_OBJECTS_FORM") & ";"
