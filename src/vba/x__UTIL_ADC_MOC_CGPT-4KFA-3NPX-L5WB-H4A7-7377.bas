    sqlText = sqlText & "cand." & SQL_FIELD_LAST_SCAN_BATCH_ID & ", cand." & SQL_FIELD_LAST_SCANNED_ON & ", cand." & SQL_FIELD_DISCOVERED_ON & ", cand." & SQL_FIELD_CANDIDATE_NOTES & ", cand." & SQL_FIELD_ACCEPTANCE_STATUS & ", "
    sqlText = sqlText & "cand." & SQL_FIELD_ACCEPTED_ON & ", cand." & SQL_FIELD_ACCEPTED_CONFIGURATION_ID & ", cand." & SQL_FIELD_ACCEPTANCE_NOTES & ", "
