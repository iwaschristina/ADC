Private Sub ResetB1ColdCreateStructuralProof()
    mB1ColdCreateStructuralBypassActive = False
    mB1ColdCreateStructuralBypassCalls = 0
    mB1ColdCreateStructuralProofDatabase = vbNullString
    mB1ColdCreateStructuralProofTraceRunID = vbNullString
    Set mB1ColdCreatedStructuralProof = Nothing
    Set mB1ColdCreateStructuralBypassTables = Nothing
    Set mB1ColdCreateStructuralFallbackTables = Nothing
End Sub

Private Function B1ColdCreatedStructuralProofAvailable(ByVal tableName As String) As Boolean
    Dim currentDatabase As String
    Dim currentTraceRunID As String
    Dim exactTableName As String
    exactTableName = tableName
    If mB1ColdCreateStructuralBypassActive = False Then Exit Function
    If mB1ColdCreatedStructuralProof Is Nothing Then Exit Function
    currentDatabase = LCase$(Trim$(ResolveCatalogDb().Name))
    currentTraceRunID = CatalogSetupTraceIdentity()
    If StrComp(currentDatabase, mB1ColdCreateStructuralProofDatabase, vbBinaryCompare) <> 0 Then
        RecordB1ColdCreateStructuralFallback exactTableName, "database identity changed"
        Exit Function
    End If
    If Len(currentTraceRunID) = 0 Or StrComp(currentTraceRunID, mB1ColdCreateStructuralProofTraceRunID, vbBinaryCompare) <> 0 Then
        RecordB1ColdCreateStructuralFallback exactTableName, "setup trace identity changed"
        Exit Function
    End If
    If mB1ColdCreatedStructuralProof.Exists(exactTableName) = False Then Exit Function
    B1ColdCreatedStructuralProofAvailable = True
End Function

Private Sub RecordB1ColdCreateStructuralBypass(ByVal tableName As String, Optional ByVal avoidedCallCount As Long = 1)
    mB1ColdCreateStructuralBypassCalls = mB1ColdCreateStructuralBypassCalls + avoidedCallCount
    If mB1ColdCreateStructuralBypassTables Is Nothing Then
        Set mB1ColdCreateStructuralBypassTables = CreateObject("Scripting.Dictionary")
        mB1ColdCreateStructuralBypassTables.CompareMode = vbTextCompare
    End If
    If mB1ColdCreateStructuralBypassTables.Exists(tableName) = False Then mB1ColdCreateStructuralBypassTables.Add tableName, True
End Sub

Private Sub RecordB1ColdCreateStructuralFallback(ByVal tableName As String, ByVal reasonText As String)
    Dim fallbackKey As String
    fallbackKey = tableName & ": " & reasonText
    If mB1ColdCreateStructuralFallbackTables Is Nothing Then
        Set mB1ColdCreateStructuralFallbackTables = CreateObject("Scripting.Dictionary")
        mB1ColdCreateStructuralFallbackTables.CompareMode = vbTextCompare
    End If
    If mB1ColdCreateStructuralFallbackTables.Exists(fallbackKey) = False Then mB1ColdCreateStructuralFallbackTables.Add fallbackKey, True
End Sub

Private Function B1ColdCreateStructuralFallbackDetail() As String
    Dim fallbackItem As Variant
    Dim detailText As String
    If mB1ColdCreateStructuralFallbackTables Is Nothing Then
        B1ColdCreateStructuralFallbackDetail = "<none>"
        Exit Function
    End If
    For Each fallbackItem In mB1ColdCreateStructuralFallbackTables.keys
        If Len(detailText) > 0 Then detailText = detailText & " | "
        detailText = detailText & CStr(fallbackItem)
    Next fallbackItem
    B1ColdCreateStructuralFallbackDetail = detailText
End Function

Private Function B1ColdCreateStructuralBypassDetail() As String
    Dim proofCount As Long
    Dim tableCount As Long
    Dim fallbackCount As Long
    If Not mB1ColdCreatedStructuralProof Is Nothing Then proofCount = mB1ColdCreatedStructuralProof.count
    If Not mB1ColdCreateStructuralBypassTables Is Nothing Then tableCount = mB1ColdCreateStructuralBypassTables.count
    If Not mB1ColdCreateStructuralFallbackTables Is Nothing Then fallbackCount = mB1ColdCreateStructuralFallbackTables.count
    B1ColdCreateStructuralBypassDetail = "verified cold-created tables=" & CStr(proofCount) & "; distinct tables using structural bypass=" & CStr(tableCount) & "; structural calls bypassed=" & CStr(mB1ColdCreateStructuralBypassCalls) & "; fallback tables=" & CStr(fallbackCount) & "; fallback detail=" & B1ColdCreateStructuralFallbackDetail()
End Function

