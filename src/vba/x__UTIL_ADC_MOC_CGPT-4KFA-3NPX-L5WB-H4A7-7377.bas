End Sub

Private Sub AddMissingCatalogTableFinding(ByRef findings As Collection, ByVal tableName As String)
    If CodeDbTableExists(tableName) = False Then findings.Add "Missing required managed object catalog table: " & tableName
End Sub

Private Sub IncrementManagedDefinitionSnapshotFallback(ByVal callerName As String)
    If mManagedDefinitionSnapshotFallbackCounts Is Nothing Then Exit Sub
    If Len(callerName) = 0 Then callerName = "(unknown)"
    If mManagedDefinitionSnapshotFallbackCounts.Exists(callerName) Then
        mManagedDefinitionSnapshotFallbackCounts(callerName) = CLng(mManagedDefinitionSnapshotFallbackCounts(callerName)) + 1
    Else
        mManagedDefinitionSnapshotFallbackCounts.Add callerName, 1
    End If
End Sub

' Purpose: Marks catalog managed object description mutation for setup.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
' Returns: None (Sub). The procedure communicates its result through its database, UI, trace, or module-state side effects and raises errors where its implementation requires it.
Public Sub MarkCatalogManagedObjectDescriptionMutationForSetup()
    RequireSetupDomainMutationAllowed SETUP_DOMAIN_G1_DERIVED_CATALOG_REFRESH, "MarkCatalogManagedObjectDescriptionMutationForSetup"
    ' Wrapper purpose: G1-facing facade that marks the Catalog inventory dirty after an authoritative managed-object description mutation.
    ' Why retained: Retained so G1 can signal the semantic mutation without accessing MOC's general dirty-domain mechanism or private state directly.
    'G1 uses this only after it actually changes authoritative MAC.ObjectDescription data.
    CatalogMarkSetupDomainsDirty CATALOG_DIRTY_INVENTORY
End Sub
