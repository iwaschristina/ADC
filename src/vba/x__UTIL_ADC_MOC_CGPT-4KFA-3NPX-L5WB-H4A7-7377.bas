Private Function B1MacroClassificationCurrentToken(ByVal db As DAO.Database, ByVal tableNames As Variant, ByRef allRequiredTablesPresent As Boolean, ByRef metrics As TPart8Metrics) As String
    On Error GoTo ErrHandler
    Dim tableToken As String
    tableToken = Part8FamilyCurrentToken(db, PART8_MACRO_CLASSIFICATION_CONTRACT, tableNames, False, allRequiredTablesPresent, metrics)
    B1MacroClassificationCurrentToken = FingerprintFromPayload(FingerprintTokenPart(tableToken))
    Exit Function
ErrHandler:
    Dim originalErrNumber As Long
    Dim originalErrSource As String
    Dim originalErrDescription As String
    originalErrNumber = Err.Number
    originalErrSource = Err.Source
    originalErrDescription = Err.Description
    Err.Raise originalErrNumber, "B1MacroClassificationCurrentToken", "Could not calculate the B1 table/schema proof token for the A2-owned macro-classification domain. Err.Source: " & originalErrSource & vbCrLf & "Err.Description: " & originalErrDescription
End Function

Private Function B1MacroClassificationProofMatches(ByVal db As DAO.Database, ByVal tableNames As Variant, ByRef currentToken As String, ByRef metrics As TPart8Metrics) As Boolean
    Dim propertyExists As Boolean
    Dim storedToken As String
    Dim allRequiredTablesPresent As Boolean
    currentToken = vbNullString
    storedToken = DatabaseTextPropertyValue(db, PART8_MACRO_CLASSIFICATION_PROOF_PROPERTY, propertyExists)
    If propertyExists = False Or Len(storedToken) = 0 Then Exit Function
    currentToken = B1MacroClassificationCurrentToken(db, tableNames, allRequiredTablesPresent, metrics)
    If allRequiredTablesPresent = False Then Exit Function
    B1MacroClassificationProofMatches = (StrComp(storedToken, currentToken, vbBinaryCompare) = 0)
End Function

Private Sub B1PersistMacroClassificationProof(ByVal db As DAO.Database, ByVal tableNames As Variant, ByRef metrics As TPart8Metrics, Optional ByRef persistedToken As Variant)
    Dim allRequiredTablesPresent As Boolean
    Dim currentToken As String
    currentToken = B1MacroClassificationCurrentToken(db, tableNames, allRequiredTablesPresent, metrics)
    If allRequiredTablesPresent = False Then Err.Raise vbObjectError + 9614, "B1PersistMacroClassificationProof", "The A2-owned macro-classification tables are not all present after read-only B1 verification."
    Call EnsureDaoPropertyValue(db, PART8_MACRO_CLASSIFICATION_PROOF_PROPERTY, dbText, currentToken, "B1PersistMacroClassificationProof")
    If isMissing(persistedToken) = False Then persistedToken = currentToken
End Sub

