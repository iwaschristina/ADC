' Purpose: Determines whether catalog recovery is blocked by an unresolved prerequisite, recovery state, or policy condition.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   durableRecoverySnapshot (Input Optional; Variant): Snapshot of durable recovery state captured before or during the operation and used for validation, rollback, or recovery decisions.
' Returns: Boolean: True when catalog recovery is blocked by the condition tracked by this routine; False when work may proceed.
Public Function CatalogRecoveryBlocked(Optional ByVal durableRecoverySnapshot As Variant) As Boolean
    'Intended use: lets the Core recovery coordinator avoid starting same-workspace restoration while Catalog transaction state is unresolved.
    On Error GoTo FailClosed
    Dim durableOperation As String
    Dim durableDetail As String
    Dim durablePayload As String
    Dim recoverySnapshot As Object
    Dim markerExists As Boolean
    If mCatalogRecoveryBlocked Then CatalogRecoveryBlocked = True: Exit Function
    If isMissing(durableRecoverySnapshot) Then
        markerExists = CoreDurableRecoveryMarkerExists(CATALOG_RECOVERY_KEY, durableOperation, durableDetail, durablePayload)
    Else
        If IsObject(durableRecoverySnapshot) = False Then Err.Raise vbObjectError + 6220, "CatalogRecoveryBlocked", "The supplied durable recovery snapshot is not an object."
        Set recoverySnapshot = durableRecoverySnapshot
        markerExists = CoreDurableRecoveryMarkerExistsInSnapshot(recoverySnapshot, CATALOG_RECOVERY_KEY, durableOperation, durableDetail, durablePayload)
    End If
    If markerExists Then
        mCatalogRecoveryBlocked = True
        mCatalogRecoveryOperationName = durableOperation
        mCatalogRecoveryDetail = durableDetail
        CatalogRecoveryBlocked = True
    End If
    Exit Function
FailClosed:
    mCatalogRecoveryBlocked = True
    mCatalogRecoveryOperationName = "Durable Catalog recovery inspection"
    mCatalogRecoveryDetail = "The durable Catalog recovery marker could not be inspected. Error " & CStr(Err.Number) & ": " & Err.Description
    CatalogRecoveryBlocked = True
End Function

' Purpose: Performs require catalog mutation recovery ready as the module's public orchestration step using the established ADC state and validation contract.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   requestedOperationName (Input; String): Operation-name token identifying the destructive/maintenance action for confirmation, diagnostics, and dispatch.
' Returns: None (Sub). The procedure communicates its result through its database, UI, trace, or module-state side effects and raises errors where its implementation requires it.
Public Sub RequireCatalogMutationRecoveryReady(ByVal requestedOperationName As String)
    'Setup-only gate: Preflight owns cross-domain recovery validation; Catalog mutations fail closed if a Catalog-local blocker appears afterward.
    Dim durableOperation As String
    Dim durableDetail As String
    Dim durablePayload As String
    requestedOperationName = Trim$(requestedOperationName)
    If Len(requestedOperationName) = 0 Then requestedOperationName = DEFAULT_UTILITY_LONG_NAME & " Catalog mutation"
    If mCatalogRecoveryBlocked Then Err.Raise ERR_CATALOG_RECOVERY_BLOCKED, "RequireCatalogMutationRecoveryReady", "Catalog mutation cannot continue because a Catalog recovery boundary is unresolved." & vbCrLf & "Requested operation: " & requestedOperationName & vbCrLf & "Recovery operation: " & IIf(Len(mCatalogRecoveryOperationName) = 0, "(not recorded)", mCatalogRecoveryOperationName) & vbCrLf & "Recovery detail:" & vbCrLf & IIf(Len(mCatalogRecoveryDetail) = 0, "(not recorded)", mCatalogRecoveryDetail)
    If CoreDurableRecoveryMarkerExists(CATALOG_RECOVERY_KEY, durableOperation, durableDetail, durablePayload) Then Err.Raise ERR_CATALOG_RECOVERY_BLOCKED, "RequireCatalogMutationRecoveryReady", "Catalog mutation cannot continue because a durable Catalog recovery marker is unresolved." & vbCrLf & "Requested operation: " & requestedOperationName & vbCrLf & "Recovery operation: " & IIf(Len(Trim$(durableOperation)) = 0, "(not recorded)", durableOperation) & vbCrLf & "Recovery detail:" & vbCrLf & IIf(Len(Trim$(durableDetail)) = 0, "(not recorded)", durableDetail)
End Sub

