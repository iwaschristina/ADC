        rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value = SortOrder
        rs.fields(FIELD_DEFAULT_OBJECT_TYPE).value = defaultObjectType
        rs.fields(FIELD_DEFAULT_SETUP_ACTION).value = defaultSetupAction
        rs.fields(FIELD_DEFAULT_OBJECT_SOURCE_DB_ROLE).value = defaultObjectSourceDbRole
        rs.fields(FIELD_DEFAULT_CONFIG_OWNER_DATABASE_ROLE).value = defaultConfigOwnerDatabaseRole
        rs.fields(FIELD_DEFAULT_ENVIRONMENT_SCOPE).value = defaultEnvironmentScope
        rs.fields(FIELD_DEFAULT_SETUP_STAGE).value = defaultSetupStage
        rs.fields(FIELD_DEFAULT_MANAGED_OBJECT_PURPOSE).value = defaultManagedObjectPurpose
        rs.fields(FIELD_DEFAULT_NAV_PANE_VISIBILITY_POLICY).value = defaultNavPaneVisibilityPolicy
        SetRecordsetFieldValueWithSource rs, FIELD_DEFAULT_EXPECTED_EXISTENCE_POLICY, expectedExistencePolicy, "ObjectCategoryExpectedExistenceDefault"
        SetRecordsetFieldValueWithSource rs, FIELD_DEFAULT_SOURCE, DEFAULT_CATALOG_SOURCE, "DEFAULT_CATALOG_SOURCE"
        rs.fields(FIELD_DEFAULTED_ON).value = Now()
        rowChanged = True
    ElseIf repairDefaultRows Then
        rs.Edit
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_CATEGORY_NAME).value, vbNullString)))) = 0 Then rs.fields(FIELD_CATEGORY_NAME).value = categoryName: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_DESCRIPTION).value, vbNullString)))) = 0 Then rs.fields(FIELD_DESCRIPTION).value = descriptionText: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_OBJECT_CATEGORY_STATUS).value, vbNullString)))) = 0 Then rs.fields(FIELD_OBJECT_CATEGORY_STATUS).value = ADCAT_STATUS_ACTIVE: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_CATALOG_OWNER).value, vbNullString)))) = 0 Then
            SetRecordsetFieldValueWithSource rs, FIELD_CATALOG_OWNER, ADCAT_OWNER_SYSTEM_DEFAULT, "ADCAT_OWNER_SYSTEM_DEFAULT"
            rowChanged = True
        End If
        If IsNull(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value) Then rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value = SortOrder: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_DEFAULT_OBJECT_TYPE).value, vbNullString)))) = 0 Then rs.fields(FIELD_DEFAULT_OBJECT_TYPE).value = defaultObjectType: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_DEFAULT_SETUP_ACTION).value, vbNullString)))) = 0 Then rs.fields(FIELD_DEFAULT_SETUP_ACTION).value = defaultSetupAction: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_DEFAULT_OBJECT_SOURCE_DB_ROLE).value, vbNullString)))) = 0 Then rs.fields(FIELD_DEFAULT_OBJECT_SOURCE_DB_ROLE).value = defaultObjectSourceDbRole: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_DEFAULT_CONFIG_OWNER_DATABASE_ROLE).value, vbNullString)))) = 0 Then rs.fields(FIELD_DEFAULT_CONFIG_OWNER_DATABASE_ROLE).value = defaultConfigOwnerDatabaseRole: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_DEFAULT_ENVIRONMENT_SCOPE).value, vbNullString)))) = 0 Then rs.fields(FIELD_DEFAULT_ENVIRONMENT_SCOPE).value = defaultEnvironmentScope: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_DEFAULT_SETUP_STAGE).value, vbNullString)))) = 0 Then rs.fields(FIELD_DEFAULT_SETUP_STAGE).value = defaultSetupStage: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_DEFAULT_MANAGED_OBJECT_PURPOSE).value, vbNullString)))) = 0 Then rs.fields(FIELD_DEFAULT_MANAGED_OBJECT_PURPOSE).value = defaultManagedObjectPurpose: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_DEFAULT_NAV_PANE_VISIBILITY_POLICY).value, vbNullString)))) = 0 Then rs.fields(FIELD_DEFAULT_NAV_PANE_VISIBILITY_POLICY).value = defaultNavPaneVisibilityPolicy: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_DEFAULT_EXPECTED_EXISTENCE_POLICY).value, vbNullString)))) = 0 Then
            SetRecordsetFieldValueWithSource rs, FIELD_DEFAULT_EXPECTED_EXISTENCE_POLICY, expectedExistencePolicy, "ObjectCategoryExpectedExistenceDefault"
            rowChanged = True
        End If
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_DEFAULT_SOURCE).value, vbNullString)))) = 0 Then
            SetRecordsetFieldValueWithSource rs, FIELD_DEFAULT_SOURCE, DEFAULT_CATALOG_SOURCE, "DEFAULT_CATALOG_SOURCE"
            rowChanged = True
        End If
        If rowChanged Then rs.fields(FIELD_LAST_DEFAULT_REPAIR_ON).value = Now()
    Else
        rs.Close
        Exit Sub
    End If
    If rowChanged = False Then
        If rs.EditMode <> dbEditNone Then rs.CancelUpdate
        rs.Close
        Exit Sub
    End If
    NormalizeZeroLengthOptionalTextFieldsForRecordsetUpdate rs
    rs.Update
    AddTraceNote "Managed object catalog category default changed: CategoryCode=" & categoryCode & "; CategoryName=" & categoryName & "; IsNewRow=" & CStr(isNewRow) & "."
    rs.Close
    Exit Sub
ErrHandler:
    Dim originalErrNumber As Long
    Dim originalErrDescription As String
    originalErrNumber = Err.Number
    originalErrDescription = Err.Description
    Err.Raise originalErrNumber, "DefaultObjectCategory", "Unable to default managed object catalog category without overwriting existing user values." & vbCrLf & "CategoryCode: " & categoryCode & vbCrLf & "Description: " & originalErrDescription
End Sub

Private Sub DefaultActionPayloadForObject(ByVal objectName As String, ByVal payloadKind As String, ByVal actionProcedureName As String, ByVal runCodeWrapperName As String, ByVal macroDescription As String, ByVal payloadVersion As String, ByVal SortOrder As Long, ByVal repairDefaultRows As Boolean)
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim managedObjectID As Long
    Dim rs As DAO.Recordset
    Dim sqlText As String
    Dim isNewRow As Boolean
    Dim rowChanged As Boolean
    Dim ownsRecordset As Boolean
    Dim batchRowKey As String
    Dim batchBookmark As Variant
    Dim payloadCaptureTimer As Single
    Dim payloadDefinitionKey As String
    Dim payloadDefinitionData As Variant
    If Len(objectName) = 0 Then Exit Sub
    If mManagedDefinitionCaptureActive Then
        payloadCaptureTimer = Timer
        CaptureManagedActionPayloadDefinition objectName, payloadKind, actionProcedureName, runCodeWrapperName, macroDescription, payloadVersion, SortOrder
        mManagedDefinitionPayloadConstructionElapsedSeconds = mManagedDefinitionPayloadConstructionElapsedSeconds + ElapsedSecondsFromTimer(payloadCaptureTimer)
        Exit Sub
    End If
    If mManagedDefinitionDeltaExecutionActive Then
        If ManagedDefinitionPayloadIsDirty(objectName, payloadKind) = False Then Exit Sub
        repairDefaultRows = True
    End If
    PumpSetupResponsiveness
    managedObjectID = ManagedObjectIDByName(objectName)
    If managedObjectID <= 0 Then Err.Raise vbObjectError + 9527, "DefaultActionPayloadForObject", "A dirty authoritative payload could not resolve its managed-object row." & vbCrLf & "ObjectName: " & objectName & vbCrLf & "PayloadKind: " & payloadKind
    If mManagedDefinitionBatchActive Then
        Set db = mManagedDefinitionBatchDb
        Set rs = mManagedDefinitionBatchPayloadRs
        batchRowKey = ManagedDefinitionPayloadBookmarkKey(managedObjectID, payloadKind)
        If mManagedDefinitionBatchPayloadBookmarks.Exists(batchRowKey) Then
            batchBookmark = mManagedDefinitionBatchPayloadBookmarks(batchRowKey)
            rs.Bookmark = batchBookmark
        Else
            isNewRow = True
        End If
    Else
        Set db = ResolveCatalogDb()
        sqlText = "SELECT * FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads") & "] WHERE [" & FIELD_MANAGED_OBJECT_ID & "]=" & CStr(managedObjectID) & " AND [" & FIELD_PAYLOAD_KIND & "]=" & SharedDao_SqlQuote(payloadKind) & ";"
        Set rs = db.OpenRecordset(sqlText, dbOpenDynaset)
        ownsRecordset = True
        isNewRow = rs.EOF
    End If
    If isNewRow Then
        rs.AddNew
        rs.fields(FIELD_MANAGED_OBJECT_ID).value = managedObjectID
        rs.fields(FIELD_PAYLOAD_KIND).value = payloadKind
        rs.fields(FIELD_PAYLOAD_STATUS).value = ADCAT_STATUS_ACTIVE
        rs.fields(FIELD_ACTION_PROCEDURE_NAME).value = Shared_String_ConvertToNullIfBlank(actionProcedureName)
        rs.fields(FIELD_RUN_CODE_WRAPPER_NAME).value = Shared_String_ConvertToNullIfBlank(runCodeWrapperName)
        rs.fields(FIELD_MACRO_DESCRIPTION).value = macroDescription
        rs.fields(FIELD_PAYLOAD_VERSION).value = payloadVersion
        SetRecordsetFieldValueWithSource rs, FIELD_CATALOG_OWNER, ADCAT_OWNER_SYSTEM_DEFAULT, "ADCAT_OWNER_SYSTEM_DEFAULT"
        rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value = SortOrder
        SetRecordsetFieldValueWithSource rs, FIELD_DEFAULT_SOURCE, DEFAULT_CATALOG_SOURCE, "DEFAULT_CATALOG_SOURCE"
        rs.fields(FIELD_DEFAULTED_ON).value = Now()
        rowChanged = True
    ElseIf repairDefaultRows Then
        rs.Edit
        If mManagedDefinitionDeltaExecutionActive Then
            payloadDefinitionKey = ManagedDefinitionPayloadPlanKey(CStr(mManagedDefinitionObjectPhysicalIndex(objectName)), payloadKind)
            payloadDefinitionData = mManagedDefinitionPayloadPlan(payloadDefinitionKey)
            ApplyManagedDefinitionExactPayloadValues rs, payloadDefinitionData, rowChanged
        End If
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_PAYLOAD_STATUS).value, vbNullString)))) = 0 Then rs.fields(FIELD_PAYLOAD_STATUS).value = ADCAT_STATUS_ACTIVE: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_ACTION_PROCEDURE_NAME).value, vbNullString)))) = 0 And Len(Trim$(actionProcedureName)) > 0 Then rs.fields(FIELD_ACTION_PROCEDURE_NAME).value = actionProcedureName: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_RUN_CODE_WRAPPER_NAME).value, vbNullString)))) = 0 And Len(Trim$(runCodeWrapperName)) > 0 Then rs.fields(FIELD_RUN_CODE_WRAPPER_NAME).value = runCodeWrapperName: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_MACRO_DESCRIPTION).value, vbNullString)))) = 0 Then rs.fields(FIELD_MACRO_DESCRIPTION).value = macroDescription: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_PAYLOAD_VERSION).value, vbNullString)))) = 0 Then rs.fields(FIELD_PAYLOAD_VERSION).value = payloadVersion: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_CATALOG_OWNER).value, vbNullString)))) = 0 Then
            SetRecordsetFieldValueWithSource rs, FIELD_CATALOG_OWNER, ADCAT_OWNER_SYSTEM_DEFAULT, "ADCAT_OWNER_SYSTEM_DEFAULT"
            rowChanged = True
        End If
        If IsNull(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value) Then rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value = SortOrder: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_DEFAULT_SOURCE).value, vbNullString)))) = 0 Then
            SetRecordsetFieldValueWithSource rs, FIELD_DEFAULT_SOURCE, DEFAULT_CATALOG_SOURCE, "DEFAULT_CATALOG_SOURCE"
            rowChanged = True
        End If
        If rowChanged Then rs.fields(FIELD_LAST_DEFAULT_REPAIR_ON).value = Now()
    Else
        If ownsRecordset Then rs.Close
        Exit Sub
    End If
    If rowChanged = False Then
        If rs.EditMode <> dbEditNone Then rs.CancelUpdate
        If ownsRecordset Then rs.Close
        Exit Sub
    End If
    NormalizeZeroLengthOptionalTextFieldsForRecordsetUpdate rs
    rs.Update
    MarkManagedDefinitionMutation CATALOG_DIRTY_PAYLOADS
    If mManagedDefinitionBatchActive Then
        If isNewRow Then
            rs.Bookmark = rs.LastModified
            If mManagedDefinitionBatchPayloadBookmarks.Exists(batchRowKey) = False Then mManagedDefinitionBatchPayloadBookmarks.Add batchRowKey, rs.Bookmark
            mManagedDefinitionBatchPayloadInserted = mManagedDefinitionBatchPayloadInserted + 1
        Else
            mManagedDefinitionBatchPayloadUpdated = mManagedDefinitionBatchPayloadUpdated + 1
        End If
    Else
        AddTraceNote "Managed object action payload default changed: ObjectName=" & objectName & "; ManagedObjectID=" & CStr(managedObjectID) & "; PayloadKind=" & payloadKind & "; IsNewRow=" & CStr(isNewRow) & "."
    End If
    If ownsRecordset Then rs.Close
    Exit Sub
ErrHandler:
    Dim originalErrNumber As Long
    Dim originalErrSource As String
    Dim originalErrDescription As String
    originalErrNumber = Err.Number
    originalErrSource = Err.Source
    originalErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then
        If rs.EditMode <> dbEditNone Then rs.CancelUpdate
        If ownsRecordset Then rs.Close
    End If
    On Error GoTo 0
    Err.Raise originalErrNumber, "DefaultActionPayloadForObject", "Unable to default managed object action payload without overwriting existing user values." & vbCrLf & "ObjectName: " & objectName & vbCrLf & "PayloadKind: " & payloadKind & vbCrLf & "Original source: " & originalErrSource & vbCrLf & "Description: " & originalErrDescription
End Sub

Private Function AddInReviewDefinitionFailureText(ByVal definitionData As Variant, ByRef evaluation As TAddInReviewManagedObjectEvaluation) As String
    Dim detailText As String
    detailText = "Definition: " & CStr(definitionData(ADD_IN_REVIEW_DEF_LOGICAL_IDENTITY))
    detailText = detailText & vbCrLf & "Expected ObjectType: " & CStr(definitionData(ADD_IN_REVIEW_DEF_OBJECT_TYPE))
    detailText = detailText & vbCrLf & "Expected ObjectName: " & CStr(definitionData(ADD_IN_REVIEW_DEF_OBJECT_NAME))
    detailText = detailText & vbCrLf & "Expected ManagedObjectKey: " & CStr(definitionData(ADD_IN_REVIEW_DEF_LOGICAL_IDENTITY)) & "|" & ManagedObjectNamingCategory(CStr(definitionData(ADD_IN_REVIEW_DEF_OBJECT_TYPE)), CStr(definitionData(ADD_IN_REVIEW_DEF_CATEGORY)), CStr(definitionData(ADD_IN_REVIEW_DEF_OBJECT_NAME)))
    detailText = detailText & vbCrLf & "Rows found: " & CStr(evaluation.RowsFound)
    detailText = detailText & vbCrLf & "Active rows found: " & CStr(evaluation.ActiveRowsFound)
    detailText = detailText & vbCrLf & "Failure classification: " & AddInReviewMatchClassificationText(evaluation.classification)
    detailText = detailText & vbCrLf & "Existing row IDs: " & IIf(Len(evaluation.ExistingRowIDs) = 0, "(none)", evaluation.ExistingRowIDs)
    detailText = detailText & vbCrLf & "Existing names/types/statuses:" & vbCrLf & IIf(Len(evaluation.ExistingRowSummary) = 0, "(none)", evaluation.ExistingRowSummary)
    AddInReviewDefinitionFailureText = detailText
End Function

