Private Function PlacementMissingComponentText(ByVal scopeCode As String, ByVal placementResolved As Boolean, ByVal ribbonTabKey As String, ByVal ribbonTabLabel As String, ByVal ribbonGroupLabel As String, ByVal ribbonGroupSortOrder As Long) As String
