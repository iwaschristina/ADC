    Dim sqlText As String
    Dim isNewRow As Boolean
    Dim rowChanged As Boolean
    Dim expectedExistencePolicy As String
    expectedExistencePolicy = ObjectCategoryExpectedExistenceDefault(defaultSetupAction)
    Set db = ResolveCatalogDb()
    sqlText = "SELECT * FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ObjectCategories") & "] WHERE [" & FIELD_CATEGORY_CODE & "]=" & SharedDao_SqlQuote(categoryCode) & ";"
    Set rs = db.OpenRecordset(sqlText, dbOpenDynaset)
