Private Sub ReportB1PostCoreStageBoundary(ByVal stageName As String, ByVal eventText As String, Optional ByVal elapsedSeconds As Double = -1)
    'Keeps the Setup Control heartbeat current and closes each B1 post-core boundary to disk while detail tracing is suppressed.
    On Error Resume Next
    Dim detailText As String
    eventText = Trim$(eventText)
    detailText = "Stage: " & stageName
    If elapsedSeconds >= 0 Then detailText = detailText & " | Elapsed: " & FormattedElapsedSeconds(elapsedSeconds)
    CorePulseProgress eventText
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "RepairManagedObjectCatalogStructureCore", eventText, detailText, "B1 post-core stage", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogStructure", "CodeDb", "Performance"
    FlushTraceLogFile
    PumpSetupResponsiveness
    On Error GoTo 0
End Sub

Private Function B1CoreStructureCurrentToken(ByVal db As DAO.Database, ByVal tableNames As Variant, ByRef allRequiredObjectsPresent As Boolean, ByRef metrics As TPart8Metrics) As String
    Dim tableToken As String
    Dim payloadText As String
    tableToken = Part8FamilyCurrentToken(db, PART8_CORE_STRUCTURE_CONTRACT, tableNames, False, allRequiredObjectsPresent, metrics)
    payloadText = FingerprintTokenPart(PART8_CORE_STRUCTURE_CONTRACT)
    payloadText = payloadText & FingerprintTokenPart(tableToken)
    If SharedDao_QueryExists(db, ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_Terminology_Review")) Then
        payloadText = payloadText & FingerprintTokenPart(ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_Terminology_Review"))
        payloadText = payloadText & FingerprintTokenPart(db.QueryDefs(ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_Terminology_Review")).sql)
    Else
        payloadText = payloadText & FingerprintTokenPart(ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_Terminology_Review") & Chr$(30) & "<missing>")
        allRequiredObjectsPresent = False
    End If
    B1CoreStructureCurrentToken = FingerprintFromPayload(payloadText)
End Function

Private Function B1CoreStructureProofMatches(ByVal db As DAO.Database, ByVal tableNames As Variant, ByRef currentToken As String, ByRef metrics As TPart8Metrics) As Boolean
    Dim allRequiredObjectsPresent As Boolean
    Dim propertyExists As Boolean
    Dim storedToken As String
    storedToken = DatabaseTextPropertyValue(db, PART8_CORE_STRUCTURE_PROOF_PROPERTY, propertyExists)
    If propertyExists = False Then Exit Function
    currentToken = B1CoreStructureCurrentToken(db, tableNames, allRequiredObjectsPresent, metrics)
    If allRequiredObjectsPresent = False Then Exit Function
    B1CoreStructureProofMatches = (StrComp(storedToken, currentToken, vbBinaryCompare) = 0)
End Function

Private Sub PersistB1CoreStructureProof(ByVal db As DAO.Database, ByVal tableNames As Variant, ByRef metrics As TPart8Metrics)
    Dim allRequiredObjectsPresent As Boolean
    Dim currentToken As String
    currentToken = B1CoreStructureCurrentToken(db, tableNames, allRequiredObjectsPresent, metrics)
    If allRequiredObjectsPresent = False Then Err.Raise vbObjectError + 9514, "PersistB1CoreStructureProof", "B1 cannot persist its core structural proof because the Help_Terms table, its core table family, or " & ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_Terminology_Review") & " are incomplete."
    EnsureDaoPropertyValue db, PART8_CORE_STRUCTURE_PROOF_PROPERTY, dbText, currentToken, "PersistB1CoreStructureProof"
End Sub

