Private Sub ValidateNonFormManagedObjectRows(ByVal db As DAO.Database)
    On Error GoTo ErrHandler
    Dim rs As DAO.Recordset
    Dim seen As Object
    Dim duplicateKeys As Object
    Dim objectName As String
    Dim objectType As String
    Dim identityKey As String
    Dim invalidCount As Long
    Dim duplicateCount As Long
    ' INTENTIONAL KEYED LOOKUP: seen, duplicateKeys provides keyed membership/lookup over source rows or state already read by ValidateNonFormManagedObjectRows; it is a derived access path, not a second authority.
    Set seen = CreateObject("Scripting.Dictionary")
    seen.CompareMode = vbBinaryCompare
    Set duplicateKeys = CreateObject("Scripting.Dictionary")
    duplicateKeys.CompareMode = vbBinaryCompare
    Set rs = db.OpenRecordset("SELECT " & SQL_FIELD_OBJECT_NAME & "," & SQL_FIELD_OBJECT_TYPE & ",[" & FIELD_CATEGORY_CODE & "],[" & FIELD_CATALOG_OWNER & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] WHERE Nz([" & FIELD_MANAGED_OBJECT_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))<>'FORM';", dbOpenSnapshot)
    Do While rs.EOF = False
        PumpSetupResponsiveness
        objectName = CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString))
        objectType = Trim$(CStr(Nz(rs.fields(FIELD_OBJECT_TYPE).value, vbNullString)))
        If Len(objectName) = 0 Or StrComp(objectName, Trim$(objectName), vbBinaryCompare) <> 0 Or Len(objectType) = 0 Or Len(Trim$(CStr(Nz(rs.fields(FIELD_CATEGORY_CODE).value, vbNullString)))) = 0 Or Len(Trim$(CStr(Nz(rs.fields(FIELD_CATALOG_OWNER).value, vbNullString)))) = 0 Then invalidCount = invalidCount + 1
        identityKey = UCase$(objectName) & "|" & UCase$(objectType)
        If seen.Exists(identityKey) Then
            If duplicateKeys.Exists(identityKey) = False Then duplicateKeys.Add identityKey, True
        Else
            seen.Add identityKey, True
        End If
        rs.MoveNext
    Loop
    rs.Close
    Set rs = Nothing
    duplicateCount = duplicateKeys.count
    If invalidCount > 0 Then Err.Raise vbObjectError + 9560, "ValidateNonFormManagedObjectRows", "Active non-form MAC rows have incomplete or noncanonical required identity metadata." & vbCrLf & "Rows: " & CStr(invalidCount)
    If duplicateCount > 0 Then Err.Raise vbObjectError + 9561, "ValidateNonFormManagedObjectRows", "Duplicate active non-form MAC identities remain after Phase B reconciliation." & vbCrLf & "Duplicate identities: " & CStr(duplicateCount)
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    Err.Raise savedErrNumber, "ValidateNonFormManagedObjectRows", savedErrDescription
End Sub

Private Sub ValidateManagedObjectRibbonStaticTags(ByVal db As DAO.Database, Optional ByVal includeManagedForms As Boolean = True)
    'Uses the same two set-based checks for either the Phase-B non-form scope or the complete logical Managed Object Catalog including Forms; no per-object scan is added.
    Dim rs As DAO.Recordset
    Dim tableName As String
    Dim sqlText As String
    Dim formScopeWhere As String
    tableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID)
    If includeManagedForms = False Then formScopeWhere = " AND UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))<>'FORM'"
    sqlText = "SELECT Count(*) AS " & SQL_FIELD_INVALID_COUNT & " FROM [" & tableName & "] WHERE Nz([" & FIELD_MANAGED_OBJECT_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND Len(Trim(Nz([" & FIELD_RIBBON_TAB_KEY & "],'')))>0 AND Len(Trim(Nz([" & FIELD_RIBBON_TAB_LABEL & "],'')))>0 AND Len(Trim(Nz([" & FIELD_RIBBON_GROUP_LABEL & "],'')))>0 AND Nz([" & FIELD_RIBBON_GROUP_SORT_ORDER & "],0)>0" & formScopeWhere & " AND (Len(Trim(Nz([" & FIELD_RIBBON_STATIC_TAG & "],'')))=0 OR InStr(Nz([" & FIELD_RIBBON_STATIC_TAG & "],''),'|')>0 OR InStr(Nz([" & FIELD_RIBBON_STATIC_TAG & "],''),';')>0);"
    Set rs = db.OpenRecordset(sqlText, dbOpenSnapshot)
    If CLng(rs.fields(FIELD_INVALID_COUNT).value) > 0 Then Err.Raise vbObjectError + 9565, "ValidateManagedObjectRibbonStaticTags", "Active Ribbon placements have blank or invalid permanent tags. Every Ribbon item must have one persisted tag without the reserved | or ; delimiters." & vbCrLf & "Rows: " & CStr(CLng(rs.fields(FIELD_INVALID_COUNT).value))
    rs.Close
    Set rs = db.OpenRecordset("SELECT [" & FIELD_RIBBON_STATIC_TAG & "],Count(*) AS " & SQL_FIELD_TAG_COUNT & " FROM [" & tableName & "] WHERE Nz([" & FIELD_MANAGED_OBJECT_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND Len(Trim(Nz([" & FIELD_RIBBON_STATIC_TAG & "],'')))>0" & formScopeWhere & " GROUP BY [" & FIELD_RIBBON_STATIC_TAG & "] HAVING Count(*)>1;", dbOpenSnapshot)
    If rs.EOF = False Then Err.Raise vbObjectError + 9566, "ValidateManagedObjectRibbonStaticTags", "The Managed Object Catalog contains a duplicate permanent Ribbon tag. Tags may never be reused." & vbCrLf & "Tag: " & CStr(rs.fields(FIELD_RIBBON_STATIC_TAG).value) & vbCrLf & "Rows: " & CStr(CLng(rs.fields(FIELD_TAG_COUNT).value))
    rs.Close
End Sub

Private Function ManagedObjectIDWhereText(ByVal managedObjectIDList As String, ByVal fieldName As String) As String
    If Len(Trim$(managedObjectIDList)) = 0 Then ManagedObjectIDWhereText = "False" Else ManagedObjectIDWhereText = fieldName & " IN (" & managedObjectIDList & ")"
End Function

Private Sub DefaultManagedObjectFormDesignRows(ByVal repairDefaultRows As Boolean, ByVal definitions As Collection, ByVal payloads As Collection)
    Dim rowData As Variant
    Dim processedCount As Long
    Dim totalCount As Long
    totalCount = definitions.count
    For Each rowData In definitions
        PumpSetupResponsiveness
        processedCount = processedCount + 1
        PulseProgressEvery processedCount, 10, "Defaulting FormDesign managed object " & CStr(processedCount) & " of " & CStr(totalCount) & ": [" & CStr(rowData(0)) & "].", totalCount, "CatalogFormDesignDefaults", "Catalog"
        DefaultDetailedManagedObject CStr(rowData(0)), CStr(rowData(1)), CStr(rowData(2)), CStr(rowData(3)), CLng(rowData(4)), repairDefaultRows
    Next rowData
    For Each rowData In payloads
        DefaultActionPayloadForObject CStr(rowData(0)), CStr(rowData(1)), CStr(rowData(2)), CStr(rowData(3)), ManagedObjectDefaultDescriptionForSetup(CStr(rowData(0)), ADCAT_CATEGORY_FORM_QUERY, ADCAT_OBJECT_TYPE_QUERY, CStr(rowData(4))), CStr(rowData(5)), CLng(rowData(6)), repairDefaultRows
    Next rowData
End Sub

Private Sub ValidateAddInReviewManagedObjectDuplicateConflicts(ByVal db As DAO.Database)
    Dim definitions As Collection
    Dim definitionData As Variant
    Dim evaluation As TAddInReviewManagedObjectEvaluation
    Dim conflictCount As Long
    Dim conflictText As String
    Set definitions = AddInReviewPlacementDefinitions()
    ValidateAddInReviewDefinitionSet definitions
    For Each definitionData In definitions
        EvaluateAddInReviewManagedObjectDefinition db, definitionData, False, evaluation
        If evaluation.ActiveRowsFound > 1 Or (evaluation.RowsFound > 1 And evaluation.ActiveRowsFound = 0) Then
            conflictCount = conflictCount + 1
            conflictText = SharedText_AppendNonBlankLine(conflictText, AddInReviewDefinitionFailureText(definitionData, evaluation))
        End If
    Next definitionData
    If conflictCount > 0 Then Err.Raise vbObjectError + 9495, "ValidateAddInReviewManagedObjectDuplicateConflicts", "Add-In Review managed-object identity conflicts were found before managed-form reconciliation. No managed-form mutation was started." & vbCrLf & conflictText
End Sub

' Purpose: Resolves managed object default navigation pane group name from the supplied/current ADC state, using `ManagedObjectDefaultNavigationPaneGroupSettingKey` and `End` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   objectName (Input; String): Canonical or physical name identifying the object targeted by this operation.
'   objectTypeCode (Input; String): Canonical code used to classify or select the object type code behavior.
' Returns: String: Returns the resolved name produced by this routine. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not resolved.
Public Function ManagedObjectDefaultNavigationPaneGroupName(ByVal objectName As String, ByVal objectTypeCode As String) As String
    'Returns the configured physical default Navigation Pane group name from the setup snapshot before a counted database fallback.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim SettingKey As String
    SettingKey = ManagedObjectDefaultNavigationPaneGroupSettingKey(objectName, objectTypeCode)
    If Len(SettingKey) = 0 Then Exit Function
    InitializeManagedDefinitionReferenceSnapshots
    If Not mManagedDefinitionNavigationGroupSnapshot Is Nothing Then
        If mManagedDefinitionNavigationGroupSnapshot.Exists(SettingKey) Then
            ManagedObjectDefaultNavigationPaneGroupName = CStr(mManagedDefinitionNavigationGroupSnapshot(SettingKey))
            Exit Function
        End If
    End If
    IncrementManagedDefinitionSnapshotFallback "ManagedObjectDefaultNavigationPaneGroupName"
    Set db = ResolveCatalogDb()
    Set rs = db.OpenRecordset("SELECT TOP 1 [" & FIELD_NAVIGATION_PANE_GROUP_NAME & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_NavigationPaneGroups") & "] WHERE [" & FIELD_SETTING_KEY & "]=" & SharedDao_SqlQuote(SettingKey) & " AND Nz(" & SQL_FIELD_LOOKUP_ACTIVE & ",True)<>False ORDER BY " & OrderByPolicyText("NAVIGATION_GROUP_SETTING_MATCH") & ";", dbOpenSnapshot)
    If rs.EOF = False Then ManagedObjectDefaultNavigationPaneGroupName = Trim$(CStr(Nz(rs.fields(FIELD_NAVIGATION_PANE_GROUP_NAME).value, vbNullString)))
    rs.Close
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrDescription As String
    savedErrNumber = Err.Number: savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    Err.Raise savedErrNumber, "ManagedObjectDefaultNavigationPaneGroupName", savedErrDescription
End Function

Private Function ManagedObjectDefaultNavigationPaneGroupSettingKey(ByVal objectName As String, ByVal objectTypeCode As String) As String
    'Returns the explicit configured default Navigation Pane setting key, using the setup snapshot before a counted database fallback.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim physicalKey As String
    Dim snapshotData As Variant
    InitializeManagedDefinitionReferenceSnapshots
    physicalKey = ManagedDefinitionManagedBookmarkKey(objectName, objectTypeCode)
    If Not mManagedDefinitionNamingSnapshot Is Nothing Then
        If mManagedDefinitionNamingSnapshot.Exists(physicalKey) Then
            snapshotData = mManagedDefinitionNamingSnapshot(physicalKey)
            ManagedObjectDefaultNavigationPaneGroupSettingKey = Trim$(CStr(snapshotData(2)))
            Exit Function
        End If
    End If
    IncrementManagedDefinitionSnapshotFallback "ManagedObjectDefaultNavigationPaneGroupSettingKey"
    If TableCanOpen(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID)) = False Then Exit Function
    Set db = ResolveCatalogDb()
    Set rs = db.OpenRecordset("SELECT TOP 1 [" & FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] WHERE " & SQL_FIELD_OBJECT_NAME & "=" & SharedDao_SqlQuote(objectName) & " AND " & SQL_FIELD_OBJECT_TYPE & "=" & SharedDao_SqlQuote(Trim$(objectTypeCode)) & ";", dbOpenSnapshot)
    If rs.EOF = False Then ManagedObjectDefaultNavigationPaneGroupSettingKey = Trim$(CStr(Nz(rs.fields(FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY).value, vbNullString)))
    rs.Close
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrDescription As String
    savedErrNumber = Err.Number: savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    Err.Raise savedErrNumber, "ManagedObjectDefaultNavigationPaneGroupSettingKey", savedErrDescription
End Function

' Purpose: Validates configured physical names for setup for source procedure, allow responsiveness pump.
' Public role: Public module entry point. This procedure is listed in the module header as an intentional externally callable ADC entry point and may be invoked directly by Access/VBA callers.
' Parameters:
'   sourceProcedure (Input; String): Procedure name recorded as the source of trace, error, status, or diagnostic information emitted by this call.
'   allowResponsivenessPump (Input Optional; Boolean): When True, enables or requests responsiveness pump for this call; when False, the routine follows its normal non-forced/default path. Default: True.
' Returns: None (Sub). The procedure communicates its result through its database, UI, trace, or module-state side effects and raises errors where its implementation requires it.
Public Sub ValidateConfiguredPhysicalNamesForSetup(ByVal sourceProcedure As String, Optional ByVal allowResponsivenessPump As Boolean = True)
    Dim mismatchSummary As String
    Dim validationDetail As String
    Dim codeDbValue As DAO.Database
    Dim hostDbValue As DAO.Database
    Dim codeDbPath As String
    Dim hostDbPath As String
    Dim sameDatabase As Boolean
    Set codeDbValue = ResolveCatalogDb()
    Set hostDbValue = GetHostDb()
    codeDbPath = Trim$(codeDbValue.Name)
    hostDbPath = Trim$(hostDbValue.Name)
    If Len(codeDbPath) = 0 Then Err.Raise vbObjectError + 8943, "ValidateConfiguredPhysicalNamesForSetup", sourceProcedure & " resolved a CodeDb with a blank path/name."
    If Len(hostDbPath) = 0 Then Err.Raise vbObjectError + 8945, "ValidateConfiguredPhysicalNamesForSetup", sourceProcedure & " resolved a HostDb with a blank path/name."
    sameDatabase = (StrComp(NormalizedDatabasePath(codeDbPath), NormalizedDatabasePath(hostDbPath), vbTextCompare) = 0)
    ValidateConfiguredPhysicalObjectNameSetForSetup validationDetail
    If ManagedObjectNamesMatchConfiguredRules(mismatchSummary, allowResponsivenessPump) = False Then Err.Raise vbObjectError + 8940, "ValidateConfiguredPhysicalNamesForSetup", sourceProcedure & " stopped before material Setup work because " & DEFAULT_UTILITY_SHORT_NAME & "-managed physical object names do not match the configured naming rules." & vbCrLf & vbCrLf & mismatchSummary & vbCrLf & vbCrLf & "Required action: run _03 Apply ADC Object Naming Rules explicitly, review the result, then rerun Setup. A1 does not rename objects."
    LogTraceMessage TRACE_LEVEL_INFO, "Setup", "ValidateConfiguredPhysicalNamesForSetup", "A1 configuration and physical-name validation completed.", "CodeDb: " & codeDbPath & vbCrLf & "HostDb: " & hostDbPath & vbCrLf & "Same database: " & CStr(sameDatabase) & vbCrLf & validationDetail, "A1 - Validate configuration and physical names", 0, vbNullString, vbNullString, vbNullString, "DatabaseContext", "CodeDb", "Setup"
End Sub

Private Sub ValidateConfiguredPhysicalObjectNameSetForSetup(ByRef validationDetail As String)
    Dim allNames As Collection
    Dim moduleNames As Collection
    Dim seen As Object
    Dim item As Variant
    Dim splitPos As Long
    Dim objectTypeCode As String
    Dim objectName As String
    Dim keyText As String
    Dim totalCount As Long
    ' INTENTIONAL FILTERED PARTITION: allNames is a consumer-required subset/projection derived from the source enumerated by ValidateConfiguredPhysicalObjectNameSetForSetup; its membership is not independently
    ' authoritative.
    ' INTENTIONAL KEYED LOOKUP: seen provides keyed membership/lookup over source rows or state already read by ValidateConfiguredPhysicalObjectNameSetForSetup; it is a derived access path, not a second authority.
    Set allNames = New Collection
    Set seen = CreateObject("Scripting.Dictionary")
    seen.CompareMode = vbTextCompare
    Set moduleNames = TablesConfiguredPhysicalObjectNamesForSetup()
    AddConfiguredPhysicalObjectNames allNames, moduleNames
    Set moduleNames = ReferencesConfiguredPhysicalObjectNamesForSetup()
    AddConfiguredPhysicalObjectNames allNames, moduleNames
    For Each item In allNames
        splitPos = InStr(1, CStr(item), "|", vbBinaryCompare)
        If splitPos <= 1 Then Err.Raise vbObjectError + 8946, "ValidateConfiguredPhysicalObjectNameSetForSetup", "A configured physical-name descriptor is malformed: " & CStr(item)
        objectTypeCode = UCase$(Trim$(Left$(CStr(item), splitPos - 1)))
        objectName = Mid$(CStr(item), splitPos + 1)
        If objectTypeCode <> "TABLE" And objectTypeCode <> "QUERY" Then Err.Raise vbObjectError + 8947, "ValidateConfiguredPhysicalObjectNameSetForSetup", "A configured physical-name descriptor has an unsupported object type." & vbCrLf & "Descriptor: " & CStr(item)
        If Len(objectName) = 0 Then Err.Raise vbObjectError + 8948, "ValidateConfiguredPhysicalObjectNameSetForSetup", "A configured physical object name resolved to blank." & vbCrLf & "Object type: " & objectTypeCode
        If Len(objectName) > MAX_ACCESS_OBJECT_NAME_LENGTH Then Err.Raise vbObjectError + 8949, "ValidateConfiguredPhysicalObjectNameSetForSetup", "A configured physical object name exceeds the Access object-name limit." & vbCrLf & "Object type: " & objectTypeCode & vbCrLf & "Name: " & objectName & vbCrLf & "Length: " & CStr(Len(objectName)) & vbCrLf & "Maximum: " & CStr(MAX_ACCESS_OBJECT_NAME_LENGTH)
        If InStr(1, objectName, ".", vbBinaryCompare) > 0 Or InStr(1, objectName, "!", vbBinaryCompare) > 0 Or InStr(1, objectName, "[", vbBinaryCompare) > 0 Or InStr(1, objectName, "]", vbBinaryCompare) > 0 Or InStr(1, objectName, "`", vbBinaryCompare) > 0 Then Err.Raise vbObjectError + 8950, "ValidateConfiguredPhysicalObjectNameSetForSetup", "A configured physical object name contains a character that " & DEFAULT_UTILITY_SHORT_NAME & " does not allow in managed table/query names." & vbCrLf & "Object type: " & objectTypeCode & vbCrLf & "Name: " & objectName
        keyText = UCase$(objectName)
        If seen.Exists(keyText) Then Err.Raise vbObjectError + 8951, "ValidateConfiguredPhysicalObjectNameSetForSetup", "Two configured physical objects resolve to the same configured name." & vbCrLf & "Name: " & objectName & vbCrLf & "First descriptor: " & CStr(seen(keyText)) & vbCrLf & "Second descriptor: " & CStr(item)
        seen.Add keyText, CStr(item)
        totalCount = totalCount + 1
    Next item
    validationDetail = "Validated configured physical object names: " & CStr(totalCount)
End Sub

Private Function CanonicalManagedPlacementSnapshotRowMatchesAuthority(ByVal rowData As Variant, ByRef differenceText As String) As Boolean
    Dim catalogOwner As String
    Dim storedNavigationSetting As String
    Dim storedTabKey As String
    Dim storedTabLabel As String
    Dim storedGroupLabel As String
    Dim storedGroupOrder As Long
    Dim expectedNavigationSetting As String
    Dim expectedTabKey As String
    Dim expectedTabLabel As String
    Dim expectedGroupLabel As String
    Dim expectedGroupOrder As Long
    Dim definitionMatched As Boolean
    Dim missingComponents As String
    differenceText = vbNullString
    catalogOwner = CStr(rowData(PLACEMENT_SNAPSHOT_CATALOG_OWNER))
    If StrComp(catalogOwner, ADCAT_OWNER_SYSTEM_DEFAULT, vbTextCompare) <> 0 And StrComp(catalogOwner, DEFAULT_CATALOG_OWNER_GENERATED, vbTextCompare) <> 0 And StrComp(catalogOwner, DEFAULT_CATALOG_OWNER_PERSISTENT_GENERATED, vbTextCompare) <> 0 Then
        CanonicalManagedPlacementSnapshotRowMatchesAuthority = True
        Exit Function
    End If
    definitionMatched = CBool(rowData(PLACEMENT_SNAPSHOT_DEFINITION_MATCHED))
    missingComponents = CStr(rowData(PLACEMENT_SNAPSHOT_MISSING_COMPONENTS))
    If definitionMatched = False Or Len(missingComponents) > 0 Then
        differenceText = "Authoritative placement unresolved"
        If Len(missingComponents) > 0 Then differenceText = differenceText & "; Missing=" & missingComponents
        Exit Function
    End If
    storedNavigationSetting = CStr(rowData(PLACEMENT_SNAPSHOT_STORED_NAV_SETTING))
    storedTabKey = CStr(rowData(PLACEMENT_SNAPSHOT_STORED_TAB_KEY))
    storedTabLabel = CStr(rowData(PLACEMENT_SNAPSHOT_STORED_TAB_LABEL))
    storedGroupLabel = CStr(rowData(PLACEMENT_SNAPSHOT_STORED_GROUP_LABEL))
    storedGroupOrder = CLng(rowData(PLACEMENT_SNAPSHOT_STORED_GROUP_ORDER))
    expectedNavigationSetting = CStr(rowData(PLACEMENT_SNAPSHOT_EXPECTED_NAV_SETTING))
    expectedTabKey = CStr(rowData(PLACEMENT_SNAPSHOT_EXPECTED_TAB_KEY))
    expectedTabLabel = CStr(rowData(PLACEMENT_SNAPSHOT_EXPECTED_TAB_LABEL))
    expectedGroupLabel = CStr(rowData(PLACEMENT_SNAPSHOT_EXPECTED_GROUP_LABEL))
    expectedGroupOrder = CLng(rowData(PLACEMENT_SNAPSHOT_EXPECTED_GROUP_ORDER))
    ' Canonical-owned placement is a derived projection of the current authoritative definition. SystemDefault, Generated, and PersistentGenerated rows may not retain a conflicting user-authored tab/group.
    If Len(storedNavigationSetting) = 0 Or Len(storedTabKey) = 0 Or Len(storedTabLabel) = 0 Or Len(storedGroupLabel) = 0 Or storedGroupOrder <= 0 Then differenceText = "Stored placement is incomplete": Exit Function
    If StrComp(storedNavigationSetting, expectedNavigationSetting, vbTextCompare) <> 0 Then differenceText = SharedText_AppendNonBlankLine(differenceText, FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY & ": Stored=" & IIf(Len(storedNavigationSetting) = 0, "(blank)", storedNavigationSetting) & "; Expected=" & IIf(Len(expectedNavigationSetting) = 0, "(blank)", expectedNavigationSetting))
    If StrComp(storedTabKey, expectedTabKey, vbTextCompare) <> 0 Then differenceText = SharedText_AppendNonBlankLine(differenceText, FIELD_RIBBON_TAB_KEY & ": Stored=" & IIf(Len(storedTabKey) = 0, "(blank)", storedTabKey) & "; Expected=" & IIf(Len(expectedTabKey) = 0, "(blank)", expectedTabKey))
    If StrComp(storedTabLabel, expectedTabLabel, vbTextCompare) <> 0 Then differenceText = SharedText_AppendNonBlankLine(differenceText, FIELD_RIBBON_TAB_LABEL & ": Stored=" & IIf(Len(storedTabLabel) = 0, "(blank)", storedTabLabel) & "; Expected=" & IIf(Len(expectedTabLabel) = 0, "(blank)", expectedTabLabel))
    If StrComp(storedGroupLabel, expectedGroupLabel, vbTextCompare) <> 0 Then differenceText = SharedText_AppendNonBlankLine(differenceText, FIELD_RIBBON_GROUP_LABEL & ": Stored=" & IIf(Len(storedGroupLabel) = 0, "(blank)", storedGroupLabel) & "; Expected=" & IIf(Len(expectedGroupLabel) = 0, "(blank)", expectedGroupLabel))
    If storedGroupOrder <> expectedGroupOrder Then differenceText = SharedText_AppendNonBlankLine(differenceText, FIELD_RIBBON_GROUP_SORT_ORDER & ": Stored=" & CStr(storedGroupOrder) & "; Expected=" & CStr(expectedGroupOrder))
    CanonicalManagedPlacementSnapshotRowMatchesAuthority = (Len(differenceText) = 0)
End Function

Private Function NonFormSystemDefaultManagedPlacementsCurrent(ByRef detailText As String) As Boolean
    Dim snapshotRows As Collection
    Dim rowData As Variant
    Dim snapshotDetail As String
    Dim differenceText As String
    Dim mismatchCount As Long
    Dim emittedCount As Long
    detailText = vbNullString
    Set snapshotRows = EnsureManagedPlacementValidationSnapshot(False, snapshotDetail)
    For Each rowData In snapshotRows
        PumpSetupResponsiveness
        differenceText = vbNullString
        If CanonicalManagedPlacementSnapshotRowMatchesAuthority(rowData, differenceText) = False Then
            mismatchCount = mismatchCount + 1
            If emittedCount < 20 Then
                emittedCount = emittedCount + 1
                detailText = SharedText_AppendNonBlankLine(detailText, CStr(rowData(PLACEMENT_SNAPSHOT_OBJECT_TYPE)) & " [" & CStr(rowData(PLACEMENT_SNAPSHOT_OBJECT_NAME)) & "]" & vbCrLf & differenceText)
            End If
        End If
    Next rowData
    If mismatchCount > emittedCount Then detailText = SharedText_AppendNonBlankLine(detailText, "Additional mismatched system-default placement rows omitted: " & CStr(mismatchCount - emittedCount))
    detailText = SharedText_AppendNonBlankLine("System-default non-form placement proof: rows=" & CStr(snapshotRows.count) & "; mismatches=" & CStr(mismatchCount), detailText)
    detailText = SharedText_AppendNonBlankLine(detailText, snapshotDetail)
    NonFormSystemDefaultManagedPlacementsCurrent = (mismatchCount = 0)
End Function

Private Sub PrepareManagedDefinitionSplitForSetup()
    Dim systemMacroSourceDetail As String
    Dim preflightTimer As Single
    Dim prerequisiteTimer As Single
    Dim preparationDetail As String
    Dim placementAuthorityDetail As String
    Dim accountedSeconds As Double
    RequireCatalogSetupPhaseReady "PrepareManagedDefinitionSplitForSetup"
    If mManagedDefinitionSplitPrepared Then Exit Sub
    ResetManagedDefinitionSplitPreflightState
    preflightTimer = Timer
    prerequisiteTimer = Timer
    EnsureCatalogSetupPhaseState
    If mCatalogSetupStructureComplete = False Then Err.Raise vbObjectError + 9635, "PrepareManagedDefinitionSplitForSetup", "B3 managed-definition preflight refused to run because required predecessor B1 catalog structure is not current. B3 does not repair B1."
    If mCatalogSetupDefaultsMatches = False Then Err.Raise vbObjectError + 9636, "PrepareManagedDefinitionSplitForSetup", "B3 managed-definition preflight refused to run because required predecessor B2 catalog reference/default state is not current. B3 does not repair B2."
    mManagedDefinitionPrerequisiteElapsedSeconds = ElapsedSecondsFromTimer(prerequisiteTimer)
    mManagedDefinitionSplitCoreRequired = (mCatalogSetupCoreInventoryMatches = False Or mCatalogSetupCorePayloadMatches = False Or mCatalogSetupDependencyMatches = False Or NoncanonicalSystemDefaultManagedTableRowExists())
    mManagedDefinitionSplitFormsRequired = True ' Phase B deliberately does not evaluate form-domain currentness; D owns that proof.
    mManagedDefinitionSplitUiRequired = (mCatalogSetupUiMatches = False Or mCatalogSetupUiInventoryMatches = False Or mCatalogSetupUiPayloadMatches = False)
    If mManagedDefinitionSplitCoreRequired = False Or mManagedDefinitionSplitUiRequired = False Then
        If NonFormSystemDefaultManagedPlacementsCurrent(placementAuthorityDetail) = False Then
            mManagedDefinitionSplitCoreRequired = True
            mManagedDefinitionSplitUiRequired = True
            LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "PrepareManagedDefinitionSplitForSetup", "B3 catalog fast path invalidated because persisted system-default placement differs from the current authoritative resolver output.", placementAuthorityDetail, "Preflight exact system-default placement state", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitionsUI", "CodeDb", "ManagedObjectCatalog"
        End If
    End If
    mManagedDefinitionSplitMacrosRequired = (mCatalogSetupMacroInventoryMatches = False Or mCatalogSetupMacroPayloadMatches = False Or (CoreSetupHelpDocumentSynchronizationScope() = HelpDocumentScopeSetupSystemAndAllActive And mCatalogSetupSystemMacroInputsChanged))
    If DefaultSystemMacroSourceCurrent(systemMacroSourceDetail) = False Then
        mManagedDefinitionSplitMacrosRequired = True
        LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "PrepareManagedDefinitionSplitForSetup", "System Macro and Help Document Macro fast path invalidated because the built-in [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & "] source differs from the current VBA-owned definition set.", systemMacroSourceDetail, "Preflight current built-in system macro source", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros"), "SystemMacroCatalog", "CodeDb", "ManagedObjectCatalog"
    ElseIf mManagedDefinitionSplitMacrosRequired = False Then
        If SystemHelpMacroManagedDefinitionsCurrent(systemMacroSourceDetail) = False Then
            mManagedDefinitionSplitMacrosRequired = True
            LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "PrepareManagedDefinitionSplitForSetup", "System Macro and Help Document Macro fast path invalidated because persisted managed definitions differ from the current authoritative System Macro and Help Document Macro placement and payload definitions.", systemMacroSourceDetail, "Preflight exact System Macro and Help Document Macro managed definitions", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitionsMacros", "CodeDb", "ManagedObjectCatalog"
        End If
    End If
    mManagedDefinitionSplitRowsRequired = (mManagedDefinitionSplitCoreRequired Or mManagedDefinitionSplitUiRequired Or mManagedDefinitionSplitMacrosRequired)
    mManagedDefinitionSplitQueriesRequired = Not mCatalogSetupQueryMatches
    mManagedDefinitionSplitFastPath = (mManagedDefinitionSplitRowsRequired = False And mManagedDefinitionSplitQueriesRequired = False)
    If mManagedDefinitionSplitRowsRequired Then
        BeginManagedDefinitionBatch True
        If mManagedDefinitionSplitCoreRequired Then
            BuildCoreManagedDefinitionPlan
            BuildManagedDefinitionDelta True
        End If
    End If
    mManagedDefinitionSplitStartedTimer = Timer
    mManagedDefinitionSplitPhase = 0
    mManagedDefinitionSplitPrepared = True
    mManagedDefinitionPreloopTotalElapsedSeconds = ElapsedSecondsFromTimer(preflightTimer)
    accountedSeconds = mManagedDefinitionPrerequisiteElapsedSeconds + mManagedDefinitionReferenceSnapshotElapsedSeconds + mManagedDefinitionBatchPreparationElapsedSeconds + mManagedDefinitionPlanPreparationElapsedSeconds + mManagedDefinitionInitialDeltaComparisonElapsedSeconds
    mManagedDefinitionPreloopUnattributedElapsedSeconds = mManagedDefinitionPreloopTotalElapsedSeconds - accountedSeconds
    If mManagedDefinitionPreloopUnattributedElapsedSeconds < 0 Then mManagedDefinitionPreloopUnattributedElapsedSeconds = 0
    preparationDetail = "Managed-definition split preflight completed before mutation." & vbCrLf & "Core=" & CStr(mManagedDefinitionSplitCoreRequired) & "; Forms handled in Phase D=" & CStr(mManagedDefinitionSplitFormsRequired) & "; non-form presentation metadata=" & CStr(mManagedDefinitionSplitUiRequired) & "; System Macros and Help Document Macros=" & CStr(mManagedDefinitionSplitMacrosRequired) & "; support queries=" & CStr(mManagedDefinitionSplitQueriesRequired) & "." & vbCrLf & ManagedDefinitionPart11TimingText()
    If Len(mManagedDefinitionInitialDirtyObjectList) > 0 Then preparationDetail = preparationDetail & vbCrLf & "Dirty managed objects:" & vbCrLf & mManagedDefinitionInitialDirtyObjectList
    If Len(mManagedDefinitionInitialDirtyPayloadList) > 0 Then preparationDetail = preparationDetail & vbCrLf & "Dirty action payloads:" & vbCrLf & mManagedDefinitionInitialDirtyPayloadList
    AddTraceNote preparationDetail
    LogCatalogSetupSubstageTiming "PrepareManagedDefinitionSplitForSetup", "Setup B3 managed-definition pre-loop", preparationDetail
End Sub

' Purpose: Repairs non form presentation definitions for setup.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   showMessage (Input Optional; Boolean): Controls whether the routine displays its normal user-facing status, completion, warning, or error message; False suppresses that presentation while preserving the
'   underlying operation. Default: False.
'   detailsForMessage (Output Optional; String): Receives detail text formatted for inclusion in the caller's user-facing message. Default: vbNullString.
'   namingInputsChanged (Output Optional; Boolean): Set True when the procedure determines that naming inputs changed applies; set False when that condition is not met. Default: False.
' Returns: Boolean: True on the function's affirmative/success branch for repair non form presentation definitions for setup; False on its explicit negative, unavailable, rejected, or handled-failure branch.
'   not-applicable path.
Public Function RepairNonFormPresentationDefinitionsForSetup(Optional ByVal showMessage As Boolean = False, Optional ByRef detailsForMessage As String = vbNullString, Optional ByRef namingInputsChanged As Boolean = False) As Boolean
    RequireSetupDomainMutationAllowed SETUP_DOMAIN_B3_NONFORM_MANAGED_DEFINITIONS, "RepairNonFormPresentationDefinitionsForSetup"
    'Owns B3 non-form presentation metadata and management-query action payloads only; no physical Navigation Pane placement or ribbon build/commit occurs here.
    On Error GoTo ErrHandler
    Dim phaseTimer As Single
    Dim stageTimer As Single
    Dim traceTimer As Single
    Dim mutationCountBefore As Long
    Dim managedMutationCountBefore As Long
    Dim timingText As String
    Dim definitionTiming As String
    RequireManagedDefinitionSplitPhase MANAGED_DEFINITION_PHASE_CORE, "RepairNonFormPresentationDefinitionsForSetup"
    phaseTimer = Timer
    namingInputsChanged = False
    managedMutationCountBefore = mManagedDefinitionBatchManagedInserted + mManagedDefinitionBatchManagedUpdated
    mPhase13TimingActive = True
    mPhase13FingerprintInvalidationElapsedSeconds = 0
    timingText = SharedText_AppendNonBlankLine(timingText, "Reusable DAO batch preparation performed during coordinated preflight: " & FormattedElapsedSeconds(mManagedDefinitionBatchPreparationElapsedSeconds))
    mutationCountBefore = ManagedDefinitionBatchMutationCount()
    stageTimer = Timer
    If mManagedDefinitionSplitUiRequired Then
        DefaultNavigationRibbonManagedObjectRows False, definitionTiming
    Else
        definitionTiming = "Definition and payload row comparisons skipped because the exact UI definition subdomain matched."
    End If
    timingText = SharedText_AppendNonBlankLine(timingText, definitionTiming)
    timingText = SharedText_AppendNonBlankLine(timingText, "B3 definition/defaulting call boundary: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    timingText = SharedText_AppendNonBlankLine(timingText, "Fingerprint invalidation bookkeeping: " & FormattedElapsedSeconds(mPhase13FingerprintInvalidationElapsedSeconds))
    timingText = SharedText_AppendNonBlankLine(timingText, "Actual mutations added during B3: " & CStr(ManagedDefinitionBatchMutationCount() - mutationCountBefore))
    namingInputsChanged = ((mManagedDefinitionBatchManagedInserted + mManagedDefinitionBatchManagedUpdated) > managedMutationCountBefore)
    mPhase13TimingActive = False
    mManagedDefinitionSplitPhase = MANAGED_DEFINITION_PHASE_UI
    detailsForMessage = IIf(mManagedDefinitionSplitUiRequired, "Non-form presentation-metadata definitions path: Repaired", "Non-form presentation-metadata definitions fast path: Used")
    detailsForMessage = detailsForMessage & vbCrLf & "B3 managed-row, payload, naming, and category evidence reused: " & CStr(mManagedDefinitionBatchActive And mManagedDefinitionReferenceSnapshotsReady)
    detailsForMessage = detailsForMessage & vbCrLf & "Elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(phaseTimer))
    traceTimer = Timer
    LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "RepairNonFormPresentationDefinitionsForSetup", "B3 non-form presentation-metadata definitions completed without physical Navigation Pane or ribbon mutation.", detailsForMessage, "Non-form presentation metadata", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitionsUI", "CodeDb", "ManagedObjectCatalog"
    timingText = SharedText_AppendNonBlankLine(timingText, "B3 completion trace serialization/write: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(traceTimer)))
    timingText = SharedText_AppendNonBlankLine(timingText, "Setup B3 total: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(phaseTimer)))
    LogCatalogSetupSubstageTiming "RepairNonFormPresentationDefinitionsForSetup", "Setup B3 non-form presentation metadata", timingText
    If showMessage Then CoreShowMessage detailsForMessage, vbInformation, "Managed Object Catalog", "ShowADCMessage", "Tables"
    RepairNonFormPresentationDefinitionsForSetup = True
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    mPhase13TimingActive = False
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    AbortManagedDefinitionSplit
    detailsForMessage = "B3 non-form presentation-metadata definitions phase failed." & vbCrLf & "Err.Number: " & CStr(savedErrNumber) & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
    LogTraceMessage TRACE_LEVEL_ERROR, "ManagedObjectCatalog", "RepairNonFormPresentationDefinitionsForSetup", "B3 non-form presentation-metadata definitions phase failed.", detailsForMessage, "Non-form presentation metadata", savedErrNumber, savedErrSource, savedErrDescription, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitionsUI", "CodeDb", "ManagedObjectCatalog"
    If showMessage Then CoreShowErrorMessage detailsForMessage, vbCritical, "Managed Object Catalog", "RepairNonFormPresentationDefinitionsForSetup", "Tables": Exit Function
    Err.Raise savedErrNumber, "RepairNonFormPresentationDefinitionsForSetup", detailsForMessage
End Function

' Purpose: Finalizes Phase-B non-form managed-definition support queries without certifying the deferred complete logical catalog that D4 establishes after Forms.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   showMessage (Input Optional; Boolean): Controls whether the routine displays its normal user-facing status, completion, warning, or error message; False suppresses that presentation while preserving the
'   underlying operation. Default: False.
'   detailsForMessage (Output Optional; String): Receives detail text formatted for inclusion in the caller's user-facing message. Default: vbNullString.
' Returns: Boolean: True on the function's affirmative/success branch for repair managed definition support queries for setup; False on its explicit negative, unavailable, rejected, or handled-failure branch.
'   not-applicable path.
Public Function RepairManagedDefinitionSupportQueriesForSetup(Optional ByVal showMessage As Boolean = False, Optional ByRef detailsForMessage As String = vbNullString) As Boolean
    RequireSetupDomainMutationAllowed SETUP_DOMAIN_B5_CATALOG_SUPPORT, "RepairManagedDefinitionSupportQueriesForSetup"
    'Finalizes Phase-B non-form managed-definition support queries without certifying the deferred complete logical catalog that D4 establishes after Forms.
    On Error GoTo ErrHandler
    Dim phaseTimer As Single
    RequireManagedDefinitionSplitPhase MANAGED_DEFINITION_PHASE_MACROS, "RepairManagedDefinitionSupportQueriesForSetup"
    phaseTimer = Timer
    If mManagedDefinitionSplitQueriesRequired Then
        CorePulseProgress "Repairing Managed Object Catalog support queries after all definition rows are ready."
        CreateOrRefreshManagedObjectCatalogQueries CONFIG_OWNER_DATABASE_ROLE_CODE_DB
        RepairNavigationPaneAndRibbonManagementQueries False, True
        CatalogMarkSetupDomainsDirty CATALOG_DIRTY_QUERIES
    End If
    If mManagedDefinitionSplitRowsRequired Or mManagedDefinitionSplitQueriesRequired Then
        mCatalogSetupCoreInventoryMatches = True
        mCatalogSetupUiInventoryMatches = True
        mCatalogSetupMacroInventoryMatches = True
        mCatalogSetupCorePayloadMatches = True
        mCatalogSetupUiPayloadMatches = True
        mCatalogSetupMacroPayloadMatches = True
        mCatalogSetupQueryMatches = True
        mCatalogSetupInventoryMatches = False
        mCatalogSetupFormsInventoryMatches = False
        mCatalogSetupDependencyMatches = False
        mCatalogSetupPayloadMatches = False
        mCatalogSetupFormsPayloadMatches = False
        mCatalogSetupUiMatches = False
        mCatalogSetupFormsMatches = False
        mCatalogSetupValidationMatches = False
    End If
    detailsForMessage = IIf(mManagedDefinitionSplitFastPath, "Managed-definition support-query fast path: Used", "Managed-definition support-query path: Repaired")
    detailsForMessage = detailsForMessage & vbCrLf & "B3 managed-row, payload, naming, and category evidence remained active through B4: " & CStr(mManagedDefinitionBatchActive And mManagedDefinitionReferenceSnapshotsReady)
    If mManagedDefinitionBatchActive Then EndManagedDefinitionBatch True
    CorePulseProgress "Repair canonical ADC relationships"
    RepairCanonicalRelationshipsForSetup
    mManagedDefinitionSplitPhase = MANAGED_DEFINITION_PHASE_SUPPORT_QUERIES
    detailsForMessage = detailsForMessage & vbCrLf & "Phase elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(phaseTimer))
    detailsForMessage = detailsForMessage & vbCrLf & "Complete Phase-B definition elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(mManagedDefinitionSplitStartedTimer))
    ClearManagedDefinitionSplitState
    LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "RepairManagedDefinitionSupportQueriesForSetup", "Managed-definition support-query finalization completed.", detailsForMessage, "Managed-definition support queries", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitionSupportQueries", "CodeDb", "ManagedObjectCatalog"
    If showMessage Then CoreShowMessage detailsForMessage, vbInformation, "Managed Object Catalog", "ShowADCMessage", "Tables"
    RepairManagedDefinitionSupportQueriesForSetup = True
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    AbortManagedDefinitionSplit
    detailsForMessage = "Managed-definition support-query finalization failed." & vbCrLf & "Err.Number: " & CStr(savedErrNumber) & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
    LogTraceMessage TRACE_LEVEL_ERROR, "ManagedObjectCatalog", "RepairManagedDefinitionSupportQueriesForSetup", "Managed-definition support-query finalization failed.", detailsForMessage, "Managed-definition support queries", savedErrNumber, savedErrSource, savedErrDescription, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitionSupportQueries", "CodeDb", "ManagedObjectCatalog"
    If showMessage Then CoreShowErrorMessage detailsForMessage, vbCritical, "Managed Object Catalog", "RepairManagedDefinitionSupportQueriesForSetup", "Tables": Exit Function
    Err.Raise savedErrNumber, "RepairManagedDefinitionSupportQueriesForSetup", detailsForMessage
End Function

Private Sub DefaultCatalogSetupAction(ByVal setupActionCode As String, ByVal setupActionName As String, ByVal descriptionText As String, ByVal SortOrder As Long, ByVal repairDefaultRows As Boolean)
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim sqlText As String
    Dim isNewRow As Boolean
    Set db = ResolveCatalogDb()
    sqlText = "SELECT * FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SetupActions") & "] WHERE " & SQL_FIELD_SETUP_ACTION_CODE & "=" & SharedDao_SqlQuote(setupActionCode) & ";"
    Set rs = db.OpenRecordset(sqlText, dbOpenDynaset)
    isNewRow = rs.EOF
    If isNewRow Then
        rs.AddNew
        rs.fields(FIELD_SETUP_ACTION_CODE).value = setupActionCode
        rs.fields(FIELD_SETUP_ACTION_NAME).value = setupActionName
        rs.fields(FIELD_DESCRIPTION).value = descriptionText
        SetRecordsetFieldValueWithSource rs, FIELD_LOOKUP_ACTIVE, DEFAULT_NAVIGATION_PANE_GROUP_LOOKUP_ACTIVE, "DEFAULT_NAVIGATION_PANE_GROUP_LOOKUP_ACTIVE"
        rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value = SortOrder
    ElseIf repairDefaultRows Then
        rs.Edit
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_SETUP_ACTION_NAME).value, vbNullString)))) = 0 Then rs.fields(FIELD_SETUP_ACTION_NAME).value = setupActionName
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_DESCRIPTION).value, vbNullString)))) = 0 Then rs.fields(FIELD_DESCRIPTION).value = descriptionText
        If IsNull(rs.fields(FIELD_LOOKUP_ACTIVE).value) Then SetRecordsetFieldValueWithSource rs, FIELD_LOOKUP_ACTIVE, DEFAULT_NAVIGATION_PANE_GROUP_LOOKUP_ACTIVE, "DEFAULT_NAVIGATION_PANE_GROUP_LOOKUP_ACTIVE"
        If IsNull(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value) Then rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value = SortOrder
    Else
        rs.Close
        Exit Sub
    End If
    rs.Update
    rs.Close
    Exit Sub
ErrHandler:
    Dim originalErrNumber As Long
    Dim originalErrDescription As String
    originalErrNumber = Err.Number
    originalErrDescription = Err.Description
    Err.Raise originalErrNumber, "DefaultCatalogSetupAction", "Unable to default managed object catalog setup action without overwriting existing user values." & vbCrLf & "SetupActionCode: " & setupActionCode & vbCrLf & "Description: " & originalErrDescription
End Sub

Private Sub NormalizeZeroLengthOptionalTextFieldsForRecordsetUpdate(ByVal rs As DAO.Recordset)
    On Error GoTo ErrHandler
    Dim fld As DAO.Field
    For Each fld In rs.fields
        PumpSetupResponsiveness
        If DaoFieldIsTextLike(fld) Then
            If IsNull(fld.value) = False Then
                If Len(CStr(fld.value)) = 0 Then
                    If DaoFieldIsRequired(fld) = False Then fld.value = Null
                End If
            End If
        End If
    Next fld
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    AddTraceNote "Zero-length optional text normalization failed before recordset update. ErrNumber=" & CStr(savedErrNumber) & "; ErrSource=" & savedErrSource & "; ErrDescription=" & savedErrDescription
    On Error GoTo 0
    Err.Raise savedErrNumber, "NormalizeZeroLengthOptionalTextFieldsForRecordsetUpdate", x__UTIL_ADC_MACRO_RUNTIME.FormatErrorWithContext("Could not normalize zero-length optional text fields before the recordset update.", "Original Err.Source: " & savedErrSource & vbCrLf & "Original Err.Description: " & savedErrDescription)
End Sub

' Purpose: Returns the canonical SQL expression that resolves a managed object's SetupAction override against its object-category default for callers that must build SQL before the saved resolved query is
'   available.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   managedObjectAlias (Input; String): Stable managed-object alias used to identify the object independently of its physical Access name in catalog/query/display logic.
'   objectCategoryAlias (Input; String): Category value classifying the object alias item so the routine can select the correct naming, logging, or processing rules.
' Returns: String: Returns the SQL text resolved/generated for resolved setup action SQL, ready for the Access query/recordsource operation that consumes it; vbNullString indicates no applicable SQL where the
'   function permits that state.
Public Function ResolvedSetupActionSql(ByVal managedObjectAlias As String, ByVal objectCategoryAlias As String) As String
    'Returns the canonical SQL expression that resolves a managed object's SetupAction override against its object-category default for callers that must build SQL before the saved resolved query is available.
    managedObjectAlias = Trim$(managedObjectAlias)
    objectCategoryAlias = Trim$(objectCategoryAlias)
    If Len(managedObjectAlias) = 0 Or Len(objectCategoryAlias) = 0 Then Err.Raise vbObjectError + 7810, "ResolvedSetupActionSql", "Managed-object and object-category SQL aliases are required."
    ResolvedSetupActionSql = "IIf(Len(Nz(" & managedObjectAlias & ".[" & FIELD_SETUP_ACTION_OVERRIDE & "],''))>0," & managedObjectAlias & ".[" & FIELD_SETUP_ACTION_OVERRIDE & "]," & objectCategoryAlias & "." & SQL_FIELD_DEFAULT_SETUP_ACTION & ")"
End Function

Private Sub ApplyHiddenSetupFormPlacementPolicy(ByVal db As DAO.Database, ByVal formName As String)
    Dim ribbonTabKey As String
    Dim ribbonTabLabel As String
    Dim ribbonGroupLabel As String
    Dim ribbonGroupSortOrder As Long
    Dim managedObjectsTableName As String
    Dim navigationPaneGroupSettingKey As String
    If ManagedObjectIsRibbonExcludedByPolicy(formName, ADCAT_OBJECT_TYPE_FORM) = False Then Exit Sub
    If ManagedObjectPlacementRibbon(formName, ADCAT_OBJECT_TYPE_FORM, ribbonTabKey, ribbonTabLabel, ribbonGroupLabel, ribbonGroupSortOrder) = False Then Err.Raise vbObjectError + 9427, "ApplyHiddenSetupFormPlacementPolicy", "The canonical hidden-form definition has no resolvable Ribbon group assignment." & vbCrLf & "Form: " & formName
    managedObjectsTableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID)
    navigationPaneGroupSettingKey = ManagedObjectNavigationPaneSettingKey(formName, ADCAT_OBJECT_TYPE_FORM)
    ValidateSqlTextFieldValueLength db, managedObjectsTableName, FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY, navigationPaneGroupSettingKey, "ManagedObjectNavigationPaneSettingKey"
    ValidateSqlTextFieldValueLength db, managedObjectsTableName, FIELD_RIBBON_TAB_KEY, ribbonTabKey, "ManagedObjectPlacementRibbon"
    ValidateSqlTextFieldValueLength db, managedObjectsTableName, FIELD_RIBBON_TAB_LABEL, ribbonTabLabel, "ManagedObjectPlacementRibbon"
    ValidateSqlTextFieldValueLength db, managedObjectsTableName, FIELD_RIBBON_GROUP_LABEL, ribbonGroupLabel, "ManagedObjectPlacementRibbon"
    db.Execute "UPDATE [" & managedObjectsTableName & "] SET [" & FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY & "]=" & SharedDao_SqlQuote(navigationPaneGroupSettingKey) & ", [" & FIELD_RIBBON_TAB_KEY & "]=" & SharedDao_SqlQuote(ribbonTabKey) & ", [" & FIELD_RIBBON_TAB_LABEL & "]=" & SharedDao_SqlQuote(ribbonTabLabel) & ", [" & FIELD_RIBBON_GROUP_LABEL & "]=" & SharedDao_SqlQuote(ribbonGroupLabel) & ", [" & FIELD_RIBBON_GROUP_SORT_ORDER & "]=" & CStr(ribbonGroupSortOrder) & ", " & SQL_FIELD_RIBBON_TITLE & "=Null WHERE UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))='FORM' AND " & SQL_FIELD_OBJECT_NAME & "=" & SharedDao_SqlQuote(formName) & ";", dbFailOnError
End Sub

Private Function PersistManagedFormDomainProofForSetup(ByRef detailText As String, Optional ByVal suppliedCanonicalGeneratedNames As Variant, Optional ByVal suppliedDiscoveredUserFormNames As Variant, Optional ByVal suppliedAuthoritativeNames As Variant, Optional ByVal suppliedPhysicalInventory As Variant) As Boolean
    RequireSetupDomainMutationAllowed SETUP_DOMAIN_D4_MANAGED_FORM_PROOF, "PersistManagedFormDomainProofForSetup"
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim tokenText As String
    Dim failureDetail As String
    Set db = ResolveCatalogDb()
    tokenText = ManagedFormReconciliationStateToken(db, failureDetail, suppliedCanonicalGeneratedNames, suppliedDiscoveredUserFormNames, suppliedAuthoritativeNames, suppliedPhysicalInventory)
    If Len(tokenText) = 0 Then Err.Raise vbObjectError + 9571, "PersistManagedFormDomainProofForSetup", IIf(Len(failureDetail) = 0, "The managed-form domain proof token is blank.", failureDetail)
    PersistManagedFormReconciliationStateToken db, tokenText
    detailText = "Managed-form domain proof persisted. Token=" & tokenText
    PersistManagedFormDomainProofForSetup = True
    Exit Function
ErrHandler:
    detailText = "Managed-form domain proof could not be persisted. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
End Function

' Purpose: Checks whether managed form domain already satisfies the exact state required by the current Setup run so the owning phase can determine whether repair is necessary.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   detailText (Input/output; String): Receives or supplies diagnostic detail text used to explain validation, lookup, recovery, or failure results to the caller.
' Returns: Boolean: True when the condition represented by RepairManagedFormDomainForSetup is present under the routine's documented inputs/current state; False when that condition is absent.
Public Function ManagedFormDomainCurrentForSetup(ByRef detailText As String) As Boolean
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim currentToken As String
    Dim storedToken As String
    Dim failureDetail As String
    Dim propertyExists As Boolean
    Set db = ResolveCatalogDb()
    storedToken = DatabaseTextPropertyValue(db, MANAGED_FORM_RECONCILIATION_TOKEN_PROPERTY, propertyExists)
    If propertyExists = False Or Len(storedToken) = 0 Then detailText = "The persisted D4 managed-form domain proof is missing.": Exit Function
    currentToken = ManagedFormReconciliationStateToken(db, failureDetail)
    If Len(currentToken) = 0 Then detailText = IIf(Len(failureDetail) = 0, "The current managed-form domain proof token is unavailable.", failureDetail): Exit Function
    If StrComp(currentToken, storedToken, vbBinaryCompare) <> 0 Then detailText = "The persisted D4 managed-form domain proof does not match the current D4-owned managed-form/catalog state.": Exit Function
    detailText = "D4 managed-form domain proof is current."
    ManagedFormDomainCurrentForSetup = True
    Exit Function
ErrHandler:
    detailText = "Could not verify the D4 managed-form domain proof. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
End Function

' Purpose: Repairs managed form domain for setup.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   showMessage (Input Optional; Boolean): Controls whether the routine displays its normal user-facing status, completion, warning, or error message; False suppresses that presentation while preserving the
'   underlying operation. Default: False.
'   detailsForMessage (Output Optional; String): Receives detail text formatted for inclusion in the caller's user-facing message. Default: vbNullString.
' Returns: Boolean: True on the function's affirmative/success branch for repair managed form domain for setup; False on its explicit negative, unavailable, rejected, or handled-failure branch.
'   path.
Public Function RepairManagedFormDomainForSetup(Optional ByVal showMessage As Boolean = False, Optional ByRef detailsForMessage As String = vbNullString) As Boolean
    RequireSetupDomainMutationAllowed SETUP_DOMAIN_D4_MANAGED_FORM_LOGICAL_STATE, "RepairManagedFormDomainForSetup"
    On Error GoTo ErrHandler
    Dim phaseTimer As Single
    Dim reconciliationSummary As String
    Dim reconciliationRan As Boolean
    Dim verifiedStateToken As String
    Dim placementChangeCount As Variant
    Dim proofDetail As String
    Dim db As DAO.Database
    Dim canonicalGeneratedNames As Collection
    Dim discoveredUserFormNames As Collection
    Dim authoritativeNames As Collection
    Dim physicalInventory As Collection
    Dim generatedCatalogNotes As Collection
    Dim generatedCatalogChangeCount As Variant
    phaseTimer = Timer
    RequireCatalogMutationRecoveryReady "RepairManagedFormDomainForSetup"
    Set canonicalGeneratedNames = CanonicalGeneratedManagedFormNames()
    Set db = ResolveCatalogDb()
    Set physicalInventory = PhysicalManagedFormInventory(db, canonicalGeneratedNames)
    Set discoveredUserFormNames = DiscoveredUserFormNamesFromInventory(physicalInventory)
    Set authoritativeNames = AuthoritativeManagedFormNames(canonicalGeneratedNames, discoveredUserFormNames)
    'D4 establishes canonical generated UI_Frm_Registry state after D2 and D3 have proven both physical generated-form partitions current.
    Set generatedCatalogNotes = New Collection
    CorePulseProgress "Setup D4: registering and verifying canonical generated UI_Frm_Registry rows."
    x__UTIL_ADC_UI_FORMS.RegisterGeneratedFormsInFormsCatalog canonicalGeneratedNames, generatedCatalogNotes, generatedCatalogChangeCount
    If CLng(Nz(generatedCatalogChangeCount, 0)) > 0 Then MarkManagedDefinitionMutation CATALOG_DIRTY_FORMS
    CorePulseProgress "Setup D4: reconciling the complete managed-form catalog domain."
    ReconcileManagedFormsForRibbon False, reconciliationSummary, reconciliationRan, verifiedStateToken, canonicalGeneratedNames, discoveredUserFormNames, authoritativeNames, physicalInventory
    CorePulseProgress "Setup D4: converging form-only Navigation Pane/ribbon metadata."
    placementChangeCount = CLng(0)
    EnsureFormsRibbonPlacementCurrent placementChangeCount
    If CLng(Nz(placementChangeCount, 0)) = 0 And Len(verifiedStateToken) > 0 Then
        proofDetail = "Managed-form domain proof retained from reconciliation. Token=" & verifiedStateToken
    Else
        If PersistManagedFormDomainProofForSetup(proofDetail, canonicalGeneratedNames, discoveredUserFormNames, authoritativeNames, physicalInventory) = False Then Err.Raise vbObjectError + 9572, "RepairManagedFormDomainForSetup", proofDetail
    End If
    detailsForMessage = "Setup D4 managed-form domain reconciled." & vbCrLf & _
                        "Managed-form reconciliation ran: " & CStr(reconciliationRan) & vbCrLf & _
                        "UI_Frm_Registry: canonical generated rows registered/verified by D4; persistent/discovered form metadata reconciled dynamically by D4" & vbCrLf & _
                        "Form-only placement metadata changes: " & CStr(CLng(Nz(placementChangeCount, 0))) & vbCrLf & _
                        "Physical form descriptions: deferred to G1 repair and exact verification" & vbCrLf & _
                        proofDetail
    If Len(reconciliationSummary) > 0 Then detailsForMessage = detailsForMessage & vbCrLf & reconciliationSummary
    detailsForMessage = detailsForMessage & vbCrLf & "Elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(phaseTimer))
    LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "RepairManagedFormDomainForSetup", "Setup D4 managed-form domain completed.", detailsForMessage, "D4 managed-form domain", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitionsForms", "CodeDb", "ManagedObjectCatalog"
    If showMessage Then CoreShowMessage detailsForMessage, vbInformation, "Managed Object Catalog", "ShowADCMessage", "Tables"
    RepairManagedFormDomainForSetup = True
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    detailsForMessage = "Setup D4 managed-form domain failed." & vbCrLf & "Err.Number: " & CStr(savedErrNumber) & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
    LogTraceMessage TRACE_LEVEL_ERROR, "ManagedObjectCatalog", "RepairManagedFormDomainForSetup", "Setup D4 managed-form domain failed.", detailsForMessage, "D4 managed-form domain", savedErrNumber, savedErrSource, savedErrDescription, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitionsForms", "CodeDb", "ManagedObjectCatalog"
    If showMessage Then CoreShowErrorMessage detailsForMessage, vbCritical, "Managed Object Catalog", "RepairManagedFormDomainForSetup", "Tables": Exit Function
    Err.Raise savedErrNumber, "RepairManagedFormDomainForSetup", detailsForMessage
End Function

Private Sub AddConfiguredPhysicalObjectNames(ByRef targetNames As Collection, ByVal sourceNames As Collection)
    Dim item As Variant
    If sourceNames Is Nothing Then Exit Sub
    For Each item In sourceNames
        targetNames.Add CStr(item)
    Next item
End Sub

Private Sub EnsureAddInReviewPlacementDefinitionCache()
    Dim rowData As Variant
    Dim definitionKey As String
    If mAddInReviewPlacementDefinitionsCache Is Nothing Then
        mAddInReviewPlacementCacheMissCount = mAddInReviewPlacementCacheMissCount + 1
        Set mAddInReviewPlacementDefinitionsCache = AddInReviewFullPlacementDefinitions()
    Else
        mAddInReviewPlacementCacheHitCount = mAddInReviewPlacementCacheHitCount + 1
    End If
    If Not mAddInReviewPlacementDefinitionIndex Is Nothing Then Exit Sub
    Set mAddInReviewPlacementDefinitionIndex = CreateObject("Scripting.Dictionary")
    mAddInReviewPlacementDefinitionIndex.CompareMode = vbBinaryCompare
    For Each rowData In mAddInReviewPlacementDefinitionsCache
        definitionKey = UCase$(CStr(rowData(1))) & Chr$(30) & UCase$(CStr(rowData(0)))
        If mAddInReviewPlacementDefinitionIndex.Exists(definitionKey) Then
            Err.Raise vbObjectError + 9541, "EnsureAddInReviewPlacementDefinitionCache", "The authoritative Add-In Review placement provider contains a duplicate object identity." & vbCrLf & "Identity: " & definitionKey
        End If
        mAddInReviewPlacementDefinitionIndex.Add definitionKey, rowData
    Next rowData
End Sub

Private Function AddInReviewPlacementDefinitions() As Collection
    EnsureAddInReviewPlacementDefinitionCache
    Set AddInReviewPlacementDefinitions = mAddInReviewPlacementDefinitionsCache
End Function

Private Function TryResolveAddInReviewPlacementDefinition(ByVal objectName As String, ByVal objectTypeCode As String, ByRef logicalIdentity As String, ByRef navigationSettingKey As String, ByRef ribbonTabKey As String, ByRef ribbonTabLabel As String, ByRef ribbonGroupLabel As String, ByRef ribbonGroupSortOrder As Long, ByRef directlyExposedOnRibbon As Boolean, ByRef definitionSource As String) As Boolean
    Dim rowData As Variant
    Dim definitionKey As String
    logicalIdentity = vbNullString
    navigationSettingKey = vbNullString
    ribbonTabKey = vbNullString
    ribbonTabLabel = vbNullString
    ribbonGroupLabel = vbNullString
    ribbonGroupSortOrder = 0
    directlyExposedOnRibbon = False
    definitionSource = vbNullString
    objectTypeCode = Trim$(objectTypeCode)
    If Len(objectName) = 0 Or Len(objectTypeCode) = 0 Then Exit Function
    EnsureAddInReviewPlacementDefinitionCache
    definitionKey = UCase$(objectTypeCode) & Chr$(30) & UCase$(objectName)
    If mAddInReviewPlacementDefinitionIndex Is Nothing Then Err.Raise vbObjectError + 9542, "TryResolveAddInReviewPlacementDefinition", "The authoritative Add-In Review placement index was not initialized."
    If mAddInReviewPlacementDefinitionIndex.Exists(definitionKey) = False Then Exit Function
    rowData = mAddInReviewPlacementDefinitionIndex(definitionKey)
    logicalIdentity = CStr(rowData(2))
    navigationSettingKey = CStr(rowData(3))
    ribbonTabKey = CStr(rowData(4))
    ribbonTabLabel = CStr(rowData(5))
    ribbonGroupLabel = CStr(rowData(6))
    ribbonGroupSortOrder = CLng(rowData(7))
    directlyExposedOnRibbon = CBool(rowData(8))
    definitionSource = CStr(rowData(9))
    TryResolveAddInReviewPlacementDefinition = True
End Function

Private Sub ValidateCoreManagedDefinitionPlan(ByVal catalogTableDefinitions As Collection, ByVal reviewQueryDefinitions As Collection, ByVal reviewPayloadDefinitions As Collection, ByVal formDesignDefinitions As Collection, ByVal formDesignPayloadDefinitions As Collection, ByVal lookupTableDefinitions As Collection)
    Dim coreTableCount As Long
    Dim coreQueryCount As Long
    Dim corePayloadCount As Long
    Dim formDesignQueryCount As Long
    Dim formDesignPayloadCount As Long
    Dim lookupCount As Long
    Dim expectedCoreTableCount As Long
    Dim expectedCoreQueryCount As Long
    Dim expectedCorePayloadCount As Long
    Dim expectedFormDesignQueryCount As Long
    Dim expectedFormDesignPayloadCount As Long
    Dim expectedLookupCount As Long
    coreTableCount = ManagedDefinitionFamilyCount(mManagedDefinitionObjectPlan, MANAGED_DEFINITION_FAMILY_CORE_TABLES, MANAGED_DEFINITION_OBJECT_FAMILY)
    coreQueryCount = ManagedDefinitionFamilyCount(mManagedDefinitionObjectPlan, MANAGED_DEFINITION_FAMILY_CORE_QUERIES, MANAGED_DEFINITION_OBJECT_FAMILY)
    corePayloadCount = ManagedDefinitionFamilyCount(mManagedDefinitionPayloadPlan, MANAGED_DEFINITION_FAMILY_CORE_QUERIES, MANAGED_DEFINITION_PAYLOAD_FAMILY)
    formDesignQueryCount = ManagedDefinitionFamilyCount(mManagedDefinitionObjectPlan, MANAGED_DEFINITION_FAMILY_FORM_DESIGN, MANAGED_DEFINITION_OBJECT_FAMILY)
    formDesignPayloadCount = ManagedDefinitionFamilyCount(mManagedDefinitionPayloadPlan, MANAGED_DEFINITION_FAMILY_FORM_DESIGN, MANAGED_DEFINITION_PAYLOAD_FAMILY)
    lookupCount = ManagedDefinitionFamilyCount(mManagedDefinitionObjectPlan, MANAGED_DEFINITION_FAMILY_LOOKUP_TABLES, MANAGED_DEFINITION_OBJECT_FAMILY)
    expectedCoreTableCount = catalogTableDefinitions.count
    expectedCoreQueryCount = reviewQueryDefinitions.count
    expectedCorePayloadCount = reviewPayloadDefinitions.count
    expectedFormDesignQueryCount = formDesignDefinitions.count
    expectedFormDesignPayloadCount = formDesignPayloadDefinitions.count
    expectedLookupCount = lookupTableDefinitions.count
    If coreTableCount <> expectedCoreTableCount Or _
        coreQueryCount <> expectedCoreQueryCount Or _
        corePayloadCount <> expectedCorePayloadCount Or _
        formDesignQueryCount <> expectedFormDesignQueryCount Or _
        formDesignPayloadCount <> expectedFormDesignPayloadCount Or _
        lookupCount <> expectedLookupCount Then
        Err.Raise vbObjectError + 9524, "ValidateCoreManagedDefinitionPlan", _
            "The captured B3 definition-family count does not match the current canonical definition providers." & vbCrLf & _
            "Core tables: " & CStr(coreTableCount) & " of " & CStr(expectedCoreTableCount) & vbCrLf & _
            "Core queries: " & CStr(coreQueryCount) & " of " & CStr(expectedCoreQueryCount) & vbCrLf & _
            "Core query payloads: " & CStr(corePayloadCount) & " of " & CStr(expectedCorePayloadCount) & vbCrLf & _
            "FormDesign queries: " & CStr(formDesignQueryCount) & " of " & CStr(expectedFormDesignQueryCount) & vbCrLf & _
            "FormDesign query payloads: " & CStr(formDesignPayloadCount) & " of " & CStr(expectedFormDesignPayloadCount) & vbCrLf & _
            "Editable lookup tables: " & CStr(lookupCount) & " of " & CStr(expectedLookupCount)
    End If
End Sub

Private Sub CompleteAndVerifyB1ColdCreatedStructure(ByVal tdf As DAO.tableDef, ByVal fieldDefinitions As Collection, ByVal indexDefinitions As Collection)
    'Proves the exact field, order, datasheet ColumnOrder, and index contract once. G1 exclusively owns field descriptions.
    On Error GoTo ErrHandler
    Dim fieldDefinition As Variant
    Dim indexDefinition As Variant
    Dim fld As DAO.Field
    Dim tableName As String
    Dim expectedOrdinal As Long
    tableName = tdf.Name
    If fieldDefinitions Is Nothing Then Err.Raise vbObjectError + 9439, "CompleteAndVerifyB1ColdCreatedStructure", "The canonical field schema is unavailable for cold-create verification." & vbCrLf & "Table: " & tableName
    If indexDefinitions Is Nothing Then Err.Raise vbObjectError + 9443, "CompleteAndVerifyB1ColdCreatedStructure", "The canonical index schema is unavailable for cold-create verification." & vbCrLf & "Table: " & tableName
    If tdf.fields.count <> fieldDefinitions.count Then Err.Raise vbObjectError + 9439, "CompleteAndVerifyB1ColdCreatedStructure", "The cold-created table field count does not match its canonical schema." & vbCrLf & "Table: " & tableName & vbCrLf & "Expected: " & CStr(fieldDefinitions.count) & vbCrLf & "Actual: " & CStr(tdf.fields.count)
    expectedOrdinal = 0
    For Each fieldDefinition In fieldDefinitions
        If SharedDao_TableDefFieldExistsSafe(tdf, CStr(fieldDefinition(0))) = False Then Err.Raise vbObjectError + 9440, "CompleteAndVerifyB1ColdCreatedStructure", "A canonical field is missing from the cold-created table." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & CStr(fieldDefinition(0))
        Set fld = tdf.fields(CStr(fieldDefinition(0)))
        If SharedDao_FieldDefinitionMatches(fld, CLng(fieldDefinition(1)), CLng(fieldDefinition(2)), CBool(fieldDefinition(3))) = False Or CatalogFieldContractMatches(fld, fieldDefinition) = False Then Err.Raise vbObjectError + 9441, "CompleteAndVerifyB1ColdCreatedStructure", "A cold-created field does not match its canonical physical definition." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fld.Name
        If StrComp(tdf.fields(expectedOrdinal).Name, fld.Name, vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 9442, "CompleteAndVerifyB1ColdCreatedStructure", "The cold-created field order does not match the canonical schema." & vbCrLf & "Table: " & tableName & vbCrLf & "Expected ordinal " & CStr(expectedOrdinal) & ": " & fld.Name & vbCrLf & "Actual: " & tdf.fields(expectedOrdinal).Name
        If fld.ordinalPosition <> expectedOrdinal Then fld.ordinalPosition = expectedOrdinal
        Call EnsureFieldColumnOrder(fld, tableName, expectedOrdinal + 1)
        expectedOrdinal = expectedOrdinal + 1
    Next fieldDefinition
    If tdf.Indexes.count <> indexDefinitions.count Then Err.Raise vbObjectError + 9443, "CompleteAndVerifyB1ColdCreatedStructure", "The cold-created table index count does not match its canonical schema." & vbCrLf & "Table: " & tableName & vbCrLf & "Expected: " & CStr(indexDefinitions.count) & vbCrLf & "Actual: " & CStr(tdf.Indexes.count)
    For Each indexDefinition In indexDefinitions
        If CatalogIndexMatchesDefinition(tdf, indexDefinition) = False Then Err.Raise vbObjectError + 9444, "CompleteAndVerifyB1ColdCreatedStructure", "A cold-created index does not match its canonical definition." & vbCrLf & "Table: " & tableName & vbCrLf & "Index: " & CStr(indexDefinition(0))
    Next indexDefinition
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    Err.Raise savedErrNumber, "CompleteAndVerifyB1ColdCreatedStructure", "Could not complete or verify the canonical cold-created table structure." & vbCrLf & "Table: " & IIf(Len(tableName) = 0, "(unresolved)", tableName) & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Sub

Private Sub ValidateAddInReviewDefinitionSet(ByVal definitions As Collection)
    Dim physicalKeys As Object
    Dim logicalKeys As Object
    Dim definitionData As Variant
    Dim physicalKey As String
    Dim logicalKey As String
    Dim missingComponents As String
    ' INTENTIONAL KEYED LOOKUP: physicalKeys, logicalKeys provides keyed membership/lookup over source rows or state already read by ValidateAddInReviewDefinitionSet; it is a derived access path, not a second
    ' authority.
    Set physicalKeys = CreateObject("Scripting.Dictionary")
    Set logicalKeys = CreateObject("Scripting.Dictionary")
    physicalKeys.CompareMode = 1
    logicalKeys.CompareMode = 1
    If definitions Is Nothing Then Err.Raise vbObjectError + 9490, "ValidateAddInReviewDefinitionSet", "The authoritative Phase-B Add-Ins placement definition provider returned Nothing."
    If definitions.count <> 3 Then Err.Raise vbObjectError + 9490, "ValidateAddInReviewDefinitionSet", "The authoritative Phase-B Add-Ins placement definition must contain exactly 3 non-form review queries." & vbCrLf & "Definitions found: " & CStr(definitions.count)
    For Each definitionData In definitions
        If StrComp(CStr(definitionData(ADD_IN_REVIEW_DEF_OBJECT_TYPE)), ADCAT_OBJECT_TYPE_QUERY, vbTextCompare) <> 0 Then Err.Raise vbObjectError + 9492, "ValidateAddInReviewDefinitionSet", "Phase B may contain only the three non-form Add-In Review queries."
        physicalKey = UCase$(CStr(definitionData(ADD_IN_REVIEW_DEF_OBJECT_TYPE))) & "|" & UCase$(CStr(definitionData(ADD_IN_REVIEW_DEF_OBJECT_NAME)))
        logicalKey = UCase$(CStr(definitionData(ADD_IN_REVIEW_DEF_LOGICAL_IDENTITY))) & "|" & UCase$(ManagedObjectNamingCategory(CStr(definitionData(ADD_IN_REVIEW_DEF_OBJECT_TYPE)), CStr(definitionData(ADD_IN_REVIEW_DEF_CATEGORY)), CStr(definitionData(ADD_IN_REVIEW_DEF_OBJECT_NAME))))
        If physicalKeys.Exists(physicalKey) Then Err.Raise vbObjectError + 9491, "ValidateAddInReviewDefinitionSet", "Duplicate physical Phase-B Add-In review identity: " & physicalKey
        If logicalKeys.Exists(logicalKey) Then Err.Raise vbObjectError + 9491, "ValidateAddInReviewDefinitionSet", "Duplicate logical Phase-B Add-In review identity: " & logicalKey
        physicalKeys.Add physicalKey, True
        logicalKeys.Add logicalKey, True
        missingComponents = PlacementMissingComponentText("AddIns", True, CStr(definitionData(ADD_IN_REVIEW_DEF_RIBBON_TAB_KEY)), CStr(definitionData(ADD_IN_REVIEW_DEF_RIBBON_TAB_LABEL)), CStr(definitionData(ADD_IN_REVIEW_DEF_RIBBON_GROUP)), CLng(definitionData(ADD_IN_REVIEW_DEF_RIBBON_ORDER)))
        If Len(CStr(definitionData(ADD_IN_REVIEW_DEF_NAV_SETTING))) = 0 Or Len(CStr(definitionData(ADD_IN_REVIEW_DEF_CATEGORY))) = 0 Or Len(CStr(definitionData(ADD_IN_REVIEW_DEF_DESCRIPTION))) = 0 Or Len(CStr(definitionData(ADD_IN_REVIEW_DEF_OWNER))) = 0 Or Len(missingComponents) > 0 Then Err.Raise vbObjectError + 9492, "ValidateAddInReviewDefinitionSet", "An authoritative Phase-B Add-In review definition is incomplete." & vbCrLf & "Key: " & physicalKey
    Next definitionData
End Sub

Private Sub ClearManagedPlacementValidationSnapshot()
    Set mManagedPlacementValidationRows = Nothing
    mManagedPlacementValidationTraceRunID = vbNullString
    mManagedPlacementValidationIncludeForms = False
    mManagedPlacementValidationValid = False
End Sub

Private Function EnsureManagedPlacementValidationSnapshot(ByVal includeManagedForms As Boolean, ByRef timingDetail As String) As Collection
    On Error GoTo ErrHandler
    Dim currentTraceRunID As String
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim rows As Collection
    Dim canonicalGeneratedFormNames As Collection
    Dim authoritativeManagedUserForms As Collection
    Dim authoritativeManagedUserFormCount As Long
    Dim navigationPaneDefinitionIndex As Object
    Dim navigationPaneDefinitionCount As Long
    Dim navigationPaneDefinitionBuildCount As Long
    Dim navigationPaneApplicabilityIndexBuildCount As Long
    Dim navigationPaneApplicabilityLookupCount As Long
    Dim definitionLogicalIdentity As String
    Dim scopeCode As String
    Dim navigationSettingKey As String
    Dim ribbonTabKey As String
    Dim ribbonTabLabel As String
    Dim ribbonGroupLabel As String
    Dim ribbonGroupSortOrder As Long
    Dim directlyExposedOnRibbon As Boolean
    Dim definitionSource As String
    Dim definitionMatched As Boolean
    Dim missingComponents As String
    Dim definitionElapsedSeconds As Double
    Dim scopeElapsedSeconds As Double
    Dim navigationElapsedSeconds As Double
    Dim ribbonElapsedSeconds As Double
    Dim rowLoadElapsedSeconds As Double
    Dim rowTimer As Single
    Dim operationTimer As Single
    Dim lookupTimer As Single
    Dim stageTimer As Single
    Dim buildResolverCount As Long
    Dim currentObjectName As String
    Dim currentObjectTypeCode As String
    Dim totalPlacementRows As Long
    Dim currentPlacementRow As Long
    Dim rowElapsedSeconds As Double
    currentTraceRunID = CatalogSetupTraceIdentity()
    lookupTimer = Timer
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "EnsureManagedPlacementValidationSnapshot", "Managed-placement snapshot lookup starting.", "Trace run: " & currentTraceRunID & vbCrLf & "IncludeForms=" & CStr(includeManagedForms), "Managed-placement snapshot", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitions", "CodeDb", "Performance"
    If mManagedPlacementValidationValid Then
        If StrComp(mManagedPlacementValidationTraceRunID, currentTraceRunID, vbBinaryCompare) = 0 And mManagedPlacementValidationIncludeForms = includeManagedForms Then
            If Not mManagedPlacementValidationRows Is Nothing Then
                mManagedPlacementValidationReuseCount = mManagedPlacementValidationReuseCount + 1
                timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Managed-placement validation snapshot: reused; rows=" & CStr(mManagedPlacementValidationRows.count) & "; builds=" & CStr(mManagedPlacementValidationBuildCount) & "; reuses=" & CStr(mManagedPlacementValidationReuseCount) & "; resolver executions=" & CStr(mManagedPlacementResolverExecutionCount))
                LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "EnsureManagedPlacementValidationSnapshot", "Managed-placement snapshot reused.", "Rows=" & CStr(mManagedPlacementValidationRows.count) & vbCrLf & "Builds=" & CStr(mManagedPlacementValidationBuildCount) & vbCrLf & "Reuses=" & CStr(mManagedPlacementValidationReuseCount) & vbCrLf & "IncludeForms=" & CStr(includeManagedForms) & vbCrLf & "Lookup elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(lookupTimer)), "Managed-placement snapshot", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitions", "CodeDb", "Performance"
                Set EnsureManagedPlacementValidationSnapshot = mManagedPlacementValidationRows
                Exit Function
            End If
        End If
    End If
    ClearManagedPlacementValidationSnapshot
    operationTimer = Timer
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "EnsureManagedPlacementValidationSnapshot", "Managed-placement snapshot build starting.", "IncludeForms=" & CStr(includeManagedForms) & vbCrLf & "Trace run: " & currentTraceRunID, "Managed-placement snapshot", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitions", "CodeDb", "Performance"
    ' INTENTIONAL OPERATION SNAPSHOT: rows captures one coherent source state for this invocation of EnsureManagedPlacementValidationSnapshot; validity ends with the operation rather than becoming a live data
    ' authority.
    Set rows = New Collection
    Set db = ResolveCatalogDb()
    If includeManagedForms Then
        stageTimer = Timer
        LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "EnsureManagedPlacementValidationSnapshot", "Managed-placement snapshot: canonical generated-form authority starting.", vbNullString, "Managed-placement snapshot", 0, vbNullString, vbNullString, vbNullString, "GeneratedFormAuthority", "CodeDb", "Performance"
        Set canonicalGeneratedFormNames = CanonicalGeneratedManagedFormNames()
        RequireManagedFormIdentityUniquenessForBatch db, "EnsureManagedPlacementValidationSnapshot"
        LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "EnsureManagedPlacementValidationSnapshot", "Managed-placement snapshot: canonical generated-form authority completed.", "Count=" & CStr(canonicalGeneratedFormNames.count) & vbCrLf & "Elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)), "Managed-placement snapshot", 0, vbNullString, vbNullString, vbNullString, "GeneratedFormAuthority", "CodeDb", "Performance"
        stageTimer = Timer
        LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "EnsureManagedPlacementValidationSnapshot", "Managed-placement snapshot: physical ADC user-form inventory starting.", vbNullString, "Managed-placement snapshot", 0, vbNullString, vbNullString, MSYS_OBJECTS_TABLE, "FormInventory", "CodeDb", "Performance"
        Set authoritativeManagedUserForms = PhysicalManagedFormNames(db, canonicalGeneratedFormNames)
        authoritativeManagedUserFormCount = authoritativeManagedUserForms.count
        LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "EnsureManagedPlacementValidationSnapshot", "Managed-placement snapshot: physical ADC user-form inventory completed.", "Count=" & CStr(authoritativeManagedUserFormCount) & vbCrLf & "Elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)), "Managed-placement snapshot", 0, vbNullString, vbNullString, MSYS_OBJECTS_TABLE, "FormInventory", "CodeDb", "Performance"
    End If
    stageTimer = Timer
    Set navigationPaneDefinitionIndex = ManagedPlacementNavigationPaneDefinitionIndex(navigationPaneDefinitionCount)
    navigationPaneDefinitionBuildCount = 1
    navigationPaneApplicabilityIndexBuildCount = 1
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "EnsureManagedPlacementValidationSnapshot", "Managed-placement snapshot: Navigation Pane applicability index prepared once.", "Canonical definitions=" & CStr(navigationPaneDefinitionCount) & vbCrLf & "Definition builds for this projection=" & CStr(navigationPaneDefinitionBuildCount) & vbCrLf & "Applicability index builds=" & CStr(navigationPaneApplicabilityIndexBuildCount) & vbCrLf & "Elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)), "Managed-placement snapshot", 0, vbNullString, vbNullString, vbNullString, "NavigationPaneDefinitionIndex", "CodeDb", "Performance"
    stageTimer = Timer
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "EnsureManagedPlacementValidationSnapshot", "Managed-placement snapshot: opening active managed-object placement rows.", "IncludeForms=" & CStr(includeManagedForms), "Managed-placement snapshot", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitions", "CodeDb", "Performance"
    Set rs = db.OpenRecordset("SELECT " & SQL_FIELD_ID & "," & SQL_FIELD_OBJECT_NAME & ",[" & FIELD_LOGICAL_OBJECT_NAME & "]," & SQL_FIELD_OBJECT_TYPE & ",[" & FIELD_CATEGORY_CODE & "],[" & FIELD_CATALOG_OWNER & "]," & SQL_FIELD_DEFAULT_SOURCE & ",[" & FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY & "],[" & FIELD_RIBBON_TAB_KEY & "],[" & FIELD_RIBBON_TAB_LABEL & "],[" & FIELD_RIBBON_GROUP_LABEL & "],[" & FIELD_RIBBON_GROUP_SORT_ORDER & "],[" & FIELD_LAST_DEFAULT_REPAIR_ON & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] WHERE Nz([" & FIELD_MANAGED_OBJECT_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))<>'MACRO' AND UCase(Trim(Nz([" & FIELD_CATEGORY_CODE & "],'')))<>" & _
        SharedDao_SqlQuote(UCase$(ADCAT_CATEGORY_SYSTEM_MACRO)) & IIf(includeManagedForms, vbNullString, " AND UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))<>'FORM'") & " ORDER BY " & OrderByPolicyText("CATALOG_PLACEMENT_VALIDATION") & ";", dbOpenSnapshot)
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "EnsureManagedPlacementValidationSnapshot", "Managed-placement snapshot: active managed-object placement rows opened.", "Elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)), "Managed-placement snapshot", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitions", "CodeDb", "Performance"
    If rs.EOF = False Then
        rs.MoveLast
        totalPlacementRows = rs.RecordCount
        rs.MoveFirst
    End If
    Do While rs.EOF = False
        PumpSetupResponsiveness
        rowTimer = Timer
        currentPlacementRow = currentPlacementRow + 1
        currentObjectName = CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString))
        currentObjectTypeCode = Trim$(CStr(Nz(rs.fields(FIELD_OBJECT_TYPE).value, vbNullString)))
        CorePulseProgress "Validating managed placement " & CStr(currentPlacementRow) & " of " & CStr(totalPlacementRows) & ": " & IIf(Len(currentObjectName) = 0, "(blank)", currentObjectName)
        If rows.count = 0 Or ((rows.count + 1) Mod 10) = 0 Then
            LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "EnsureManagedPlacementValidationSnapshot", "Managed-placement snapshot: resolving row " & CStr(rows.count + 1) & ".", "Object=" & IIf(Len(currentObjectName) = 0, "(blank)", currentObjectName) & vbCrLf & "Type=" & IIf(Len(currentObjectTypeCode) = 0, "(blank)", currentObjectTypeCode) & vbCrLf & "Elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer)) & vbCrLf & "Resolver executions completed: " & CStr(buildResolverCount), "Managed-placement snapshot", 0, vbNullString, vbNullString, currentObjectName, currentObjectTypeCode, "CodeDb", "Performance"
        End If
        definitionLogicalIdentity = vbNullString
        scopeCode = vbNullString
        navigationSettingKey = vbNullString
        ribbonTabKey = vbNullString
        ribbonTabLabel = vbNullString
        ribbonGroupLabel = vbNullString
        ribbonGroupSortOrder = 0
        directlyExposedOnRibbon = True
        definitionSource = vbNullString
        definitionMatched = TryResolveManagedObjectPlacementDefinition(currentObjectName, currentObjectTypeCode, definitionLogicalIdentity, scopeCode, navigationSettingKey, ribbonTabKey, ribbonTabLabel, ribbonGroupLabel, ribbonGroupSortOrder, directlyExposedOnRibbon, definitionSource, authoritativeManagedUserForms, canonicalGeneratedFormNames, rs.fields(FIELD_RIBBON_TAB_KEY).value, rs.fields(FIELD_RIBBON_GROUP_LABEL).value, navigationPaneDefinitionIndex, navigationPaneApplicabilityLookupCount, definitionElapsedSeconds, scopeElapsedSeconds, navigationElapsedSeconds, ribbonElapsedSeconds)
        missingComponents = PlacementMissingComponentText(scopeCode, definitionMatched, ribbonTabKey, ribbonTabLabel, ribbonGroupLabel, ribbonGroupSortOrder)
        rows.Add Array(CLng(Nz(rs.fields(FIELD_ID).value, 0)), currentObjectName, Trim$(CStr(Nz(rs.fields(FIELD_LOGICAL_OBJECT_NAME).value, vbNullString))), _
            currentObjectTypeCode, Trim$(CStr(Nz(rs.fields(FIELD_CATEGORY_CODE).value, vbNullString))), Trim$(CStr(Nz(rs.fields(FIELD_CATALOG_OWNER).value, vbNullString))), _
            Trim$(CStr(Nz(rs.fields(FIELD_DEFAULT_SOURCE).value, vbNullString))), Trim$(CStr(Nz(rs.fields(FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY).value, vbNullString))), Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_TAB_KEY).value, vbNullString))), _
            Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_TAB_LABEL).value, vbNullString))), Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_GROUP_LABEL).value, vbNullString))), CLng(Nz(rs.fields(FIELD_RIBBON_GROUP_SORT_ORDER).value, 0)), _
            definitionLogicalIdentity, scopeCode, navigationSettingKey, ribbonTabKey, ribbonTabLabel, ribbonGroupLabel, ribbonGroupSortOrder, directlyExposedOnRibbon, definitionSource, definitionMatched, missingComponents, rs.fields(FIELD_LAST_DEFAULT_REPAIR_ON).value)
        buildResolverCount = buildResolverCount + 1
        rowElapsedSeconds = ElapsedSecondsFromTimer(rowTimer)
        rowLoadElapsedSeconds = rowLoadElapsedSeconds + rowElapsedSeconds
        If rowElapsedSeconds >= 0.5 Then
            LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "EnsureManagedPlacementValidationSnapshot", "Slow managed-placement row resolved.", "Row=" & CStr(currentPlacementRow) & " of " & CStr(totalPlacementRows) & vbCrLf & "Object=" & IIf(Len(currentObjectName) = 0, "(blank)", currentObjectName) & vbCrLf & "Type=" & IIf(Len(currentObjectTypeCode) = 0, "(blank)", currentObjectTypeCode) & vbCrLf & "Row elapsed=" & FormattedElapsedSeconds(rowElapsedSeconds) & vbCrLf & "Overall elapsed=" & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer)), "Managed-placement slow row", 0, vbNullString, vbNullString, currentObjectName, currentObjectTypeCode, "CodeDb", "Performance"
        End If
        If rows.count = 1 Or (rows.count Mod 10) = 0 Then
            LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "EnsureManagedPlacementValidationSnapshot", "Managed-placement snapshot resolver milestone completed.", "Rows=" & CStr(rows.count) & vbCrLf & "Current object=" & IIf(Len(currentObjectName) = 0, "(blank)", currentObjectName) & vbCrLf & "Type=" & IIf(Len(currentObjectTypeCode) = 0, "(blank)", currentObjectTypeCode) & vbCrLf & "Elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer)) & vbCrLf & "Accumulated resolver executions: " & CStr(buildResolverCount), "Managed-placement snapshot", 0, vbNullString, vbNullString, currentObjectName, currentObjectTypeCode, "CodeDb", "Performance"
        End If
        RequireSafeWorkContinue "EnsureManagedPlacementValidationSnapshot", CStr(rows.count) & " managed placement rows"
        rs.MoveNext
    Loop
    rs.Close
    Set rs = Nothing
    Set mManagedPlacementValidationRows = rows
    mManagedPlacementValidationTraceRunID = currentTraceRunID
    mManagedPlacementValidationIncludeForms = includeManagedForms
    mManagedPlacementValidationValid = True
    mManagedPlacementValidationBuildCount = mManagedPlacementValidationBuildCount + 1
    mManagedPlacementResolverExecutionCount = mManagedPlacementResolverExecutionCount + buildResolverCount
    If includeManagedForms Then AddTraceNote "D4 managed-placement validation reused the active batch row and one generated-form classification set for every managed Form; no per-Form Managed Objects reread was performed."
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Managed-placement validation snapshot: built once; rows=" & CStr(rows.count) & "; include forms=" & CStr(includeManagedForms) & "; dynamic managed user forms=" & CStr(authoritativeManagedUserFormCount) & "; build=" & CStr(mManagedPlacementValidationBuildCount) & "; resolver executions this build=" & CStr(buildResolverCount))
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Managed-placement snapshot row loading and row capture: " & FormattedElapsedSeconds(rowLoadElapsedSeconds))
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Managed-placement authoritative object-definition matching: " & FormattedElapsedSeconds(definitionElapsedSeconds))
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Managed-placement scope resolution: " & FormattedElapsedSeconds(scopeElapsedSeconds))
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Managed-placement Navigation Pane resolution: " & FormattedElapsedSeconds(navigationElapsedSeconds) & "; canonical definition builds=" & CStr(navigationPaneDefinitionBuildCount) & "; applicability index builds=" & CStr(navigationPaneApplicabilityIndexBuildCount) & "; applicability lookups=" & CStr(navigationPaneApplicabilityLookupCount))
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Managed-placement Ribbon resolution: " & FormattedElapsedSeconds(ribbonElapsedSeconds))
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Managed-placement snapshot total: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer)))
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "EnsureManagedPlacementValidationSnapshot", "Managed-placement snapshot build completed.", _
        "Rows=" & CStr(rows.count) & vbCrLf & "Builds=" & CStr(mManagedPlacementValidationBuildCount) & vbCrLf & "Reuses=" & CStr(mManagedPlacementValidationReuseCount) & vbCrLf & _
        "IncludeForms=" & CStr(includeManagedForms) & vbCrLf & "Resolver executions this build=" & CStr(buildResolverCount) & vbCrLf & _
        "Navigation Pane canonical definition builds=" & CStr(navigationPaneDefinitionBuildCount) & vbCrLf & "Navigation Pane applicability index builds=" & CStr(navigationPaneApplicabilityIndexBuildCount) & vbCrLf & _
        "Navigation Pane applicability lookups=" & CStr(navigationPaneApplicabilityLookupCount) & vbCrLf & "Elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer)), _
        "Managed-placement snapshot", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitions", "CodeDb", "Performance"
    Set EnsureManagedPlacementValidationSnapshot = mManagedPlacementValidationRows
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    ClearManagedPlacementValidationSnapshot
    Err.Raise savedErrNumber, "EnsureManagedPlacementValidationSnapshot", "Could not build the setup-scoped managed-placement validation snapshot." & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Function

Private Sub ValidateManagedRunCodeDefinition(ByVal managedRows As Object, ByVal payloadRows As Object, ByVal objectName As String, ByVal expectedRunCode As String, ByVal sourceLabel As String)
    Dim managedData As Variant
    Dim payloadCollection As Collection
    Dim payloadData As Variant
    Dim managedObjectID As Long
    Dim rowCount As Long
    Dim payloadCount As Long
    If managedRows.Exists(objectName) Then
        managedData = managedRows(objectName)
        rowCount = CLng(managedData(0))
        managedObjectID = CLng(managedData(1))
    End If
    If rowCount <> 1 Or managedObjectID <= 0 Then Err.Raise vbObjectError + 9565, "ValidateManagedRunCodeDefinition", sourceLabel & " command must have exactly one active MAC row." & vbCrLf & "Object: " & objectName & vbCrLf & "Rows: " & CStr(rowCount)
    If payloadRows.Exists(CStr(managedObjectID)) Then
        Set payloadCollection = payloadRows(CStr(managedObjectID))
        For Each payloadData In payloadCollection
            payloadCount = payloadCount + 1
            If StrComp(Trim$(CStr(payloadData(0))), ADCAT_PAYLOAD_ACCESS_MACRO_RUNCODE, vbTextCompare) <> 0 Then Err.Raise vbObjectError + 9566, "ValidateManagedRunCodeDefinition", sourceLabel & " command has an unexpected active payload kind." & vbCrLf & "Object: " & objectName
            If StrComp(Trim$(CStr(payloadData(1))), Trim$(expectedRunCode), vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 9567, "ValidateManagedRunCodeDefinition", sourceLabel & " command payload does not match its authoritative RunCode source." & vbCrLf & "Object: " & objectName & vbCrLf & "Expected: " & expectedRunCode & vbCrLf & "Actual: " & CStr(payloadData(1))
        Next payloadData
    End If
    If payloadCount <> 1 Then Err.Raise vbObjectError + 9568, "ValidateManagedRunCodeDefinition", sourceLabel & " command must have exactly one active RunCode payload." & vbCrLf & "Object: " & objectName & vbCrLf & "Payloads: " & CStr(payloadCount)
End Sub

' Purpose: Validates required UI manifest inventory for ribbon name.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   ribbonName (Input; String): Name of the Access Ribbon definition being created, selected, or validated.
' Returns: None (Sub). The procedure communicates its result through its database, UI, trace, or module-state side effects and raises errors where its implementation requires it.
Public Sub ValidateRequiredUIManifestInventory(ByVal ribbonName As String)
    'Intended use: require every active, directly exposed Catalog-mapped ADC UI object exactly once in one persisted ribbon manifest, including both UI_Frm_Registry and UI_Frm_Lookup_Types.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim targetRs As DAO.Recordset
    Dim targetCounts As Object
    Dim targetIdentity As String
    Dim objectName As String
    Dim objectTypeCode As String
    Dim expectedTabKey As String
    Dim expectedTabLabel As String
    Dim expectedGroupLabel As String
    Dim expectedGroupOrder As Long
    Dim expectedCount As Long
    Dim actualCount As Long
    Dim formDefinitionsFound As Boolean
    Dim formTypesFound As Boolean
    ribbonName = Trim$(ribbonName)
    If Len(ribbonName) = 0 Then Err.Raise vbObjectError + 9123, "ValidateRequiredUIManifestInventory", "No ribbon name was supplied."
    Set db = ResolveCatalogDb()
    ' INTENTIONAL KEYED LOOKUP: targetCounts is a fresh procedure-local projection of the authoritative runtime-manifest rows required by this proof.
    Set targetCounts = CreateObject("Scripting.Dictionary")
    targetCounts.CompareMode = vbTextCompare
    Set targetRs = db.OpenRecordset("SELECT " & SQL_FIELD_OBJECT_TYPE_CODE & "," & SQL_FIELD_OBJECT_NAME & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_RIBBON_BUTTON_TARGETS_TABLE_LOGICAL_ID) & "] WHERE " & SQL_FIELD_RIBBON_NAME & "=" & SharedDao_SqlQuote(ribbonName) & " AND UCase(Trim(Nz([" & FIELD_RIBBON_TAB_KEY & "],'')))=" & SharedDao_SqlQuote(DEFAULT_RIBBON_TAB_KEY_UI) & ";", dbOpenSnapshot)
    Do While targetRs.EOF = False
        targetIdentity = CStr(Nz(targetRs.fields(FIELD_OBJECT_TYPE_CODE).value, vbNullString)) & Chr$(30) & CStr(Nz(targetRs.fields(FIELD_OBJECT_NAME).value, vbNullString))
        If targetCounts.Exists(targetIdentity) Then
            targetCounts(targetIdentity) = CLng(targetCounts(targetIdentity)) + 1
        Else
            targetCounts.Add targetIdentity, CLng(1)
        End If
        targetRs.MoveNext
    Loop
    targetRs.Close
    Set targetRs = Nothing
    Set rs = db.OpenRecordset("SELECT " & SQL_FIELD_OBJECT_NAME & "," & SQL_FIELD_OBJECT_TYPE & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] WHERE Nz([" & FIELD_MANAGED_OBJECT_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " ORDER BY " & OrderByPolicyText("CATALOG_UI_MANIFEST_VALIDATION") & ";", dbOpenSnapshot)
    Do While rs.EOF = False
        PumpSetupResponsiveness
        objectName = CStr(Nz(rs!objectName, vbNullString))
        objectTypeCode = Trim$(CStr(Nz(rs!objectType, vbNullString)))
        expectedTabKey = vbNullString
        expectedTabLabel = vbNullString
        expectedGroupLabel = vbNullString
        expectedGroupOrder = 0
        If ManagedObjectIsRibbonExcludedByPolicy(objectName, objectTypeCode) = False Then
            If ManagedObjectPlacementRibbon(objectName, objectTypeCode, expectedTabKey, expectedTabLabel, expectedGroupLabel, expectedGroupOrder) Then
                If StrComp(expectedTabKey, DEFAULT_RIBBON_TAB_KEY_UI, vbTextCompare) = 0 Then
                    expectedCount = expectedCount + 1
                    targetIdentity = objectTypeCode & Chr$(30) & objectName
                    actualCount = 0
                    If targetCounts.Exists(targetIdentity) Then actualCount = CLng(targetCounts(targetIdentity))
                    If actualCount <> 1 Then Err.Raise vbObjectError + 9124, "ValidateRequiredUIManifestInventory", "A required active " & DEFAULT_UTILITY_SHORT_NAME & " UI object is not present exactly once in the persisted runtime manifest." & vbCrLf & "Ribbon: " & ribbonName & vbCrLf & "Object: " & objectTypeCode & " | " & objectName & vbCrLf & "Expected rows: 1" & vbCrLf & "Actual rows: " & CStr(actualCount)
                    If StrComp(objectName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_FormDefinitions"), vbTextCompare) = 0 Then formDefinitionsFound = True
                    If StrComp(objectName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_FormTypes"), vbTextCompare) = 0 Then formTypesFound = True
                End If
            End If
        End If
        rs.MoveNext
    Loop
    rs.Close
    If expectedCount = 0 Then Err.Raise vbObjectError + 9125, "ValidateRequiredUIManifestInventory", "No active Catalog-mapped " & DEFAULT_UTILITY_SHORT_NAME & " UI objects were found for manifest validation."
    If formDefinitionsFound = False Or formTypesFound = False Then Err.Raise vbObjectError + 9126, "ValidateRequiredUIManifestInventory", "The active " & DEFAULT_UTILITY_SHORT_NAME & " UI inventory does not contain both required Form Definitions objects." & vbCrLf & "UI_Frm_Registry found: " & CStr(formDefinitionsFound) & vbCrLf & "UI_Frm_Lookup_Types found: " & CStr(formTypesFound)
    AddTraceNote "Runtime UI manifest validation reused one RibbonButtonTargets identity/count index instead of issuing one count query per managed UI object."
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not targetRs Is Nothing Then targetRs.Close
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    Err.Raise savedErrNumber, "ValidateRequiredUIManifestInventory", "Could not verify the complete required " & DEFAULT_UTILITY_SHORT_NAME & " UI runtime-manifest inventory." & vbCrLf & "Ribbon: " & ribbonName & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Sub

' Purpose: Performs schema repair summary for message by coordinating `End` while preserving this module's existing validation and error semantics.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   schemaRepairNeeded (Input; Boolean): Boolean state describing whether schema repair needed applies to this invocation; True selects the named condition/path and False selects its complementary/default path.
'   schemaRepairSummary (Input; String): Caller-supplied schema-repair summary appended to the resulting diagnostics/message so later stages can report what changed.
' Returns: String: Returns formatted schema repair summary for message text intended for tracing, diagnostics, or user-facing reporting; vbNullString is returned when there is nothing applicable to report.
Public Function SchemaRepairSummaryForMessage(ByVal schemaRepairNeeded As Boolean, ByVal schemaRepairSummary As String) As String
    Dim valueText As String
    If schemaRepairNeeded = False Then Exit Function
    valueText = Trim$(schemaRepairSummary)
    If Len(valueText) = 0 Then Exit Function
    If Len(valueText) > 3000 Then
        valueText = Left$(valueText, 3000) & vbCrLf & "... additional schema details omitted from this message."
    End If
    SchemaRepairSummaryForMessage = vbCrLf & vbCrLf & "Schema changes made:" & vbCrLf & valueText
End Function

' Purpose: Resolves query parameter list for message from the supplied/current ADC state, using `ResolveCatalogDb` and `Next` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   queryName (Input; String): Canonical or physical name identifying the query targeted by this operation.
' Returns: String: Returns the formatted text produced by this routine. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not
'   resolved.
Public Function QueryParameterListForMessage(ByVal queryName As String) As String
    'Intended use: Returns the Access Development Console Query Parameter List For Message result for direct, query, form, or required cross-module callers.
    On Error GoTo ExitHere
    Dim db As DAO.Database
    Dim qdf As DAO.queryDef
    Dim prm As DAO.Parameter
    Dim resultText As String
    Set db = ResolveCatalogDb()
    Set qdf = db.QueryDefs(queryName)
    qdf.parameters.Refresh
    For Each prm In qdf.parameters
        PumpSetupResponsiveness
        If Len(resultText) > 0 Then resultText = resultText & ", "
        resultText = resultText & prm.Name
    Next prm
    QueryParameterListForMessage = resultText
ExitHere:
End Function

' Purpose: Resolves config form SQL from the supplied/current ADC state, using `OrderedTableSelectList` and `ConfigFormNeedsReviewSql` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
' Returns: String: Returns the SQL text produced by this routine. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not resolved.
Public Function ConfigFormSql() As String
    'Returns configuration-only MC_Records fields in authoritative table order, followed by calculated review/display compatibility fields.
    Dim sqlParts As Collection
    Set sqlParts = New Collection
    sqlParts.Add "SELECT " & OrderedTableSelectList(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Config"), "cfg") & ","
    sqlParts.Add SharedDao_SqlQuote(ROW_KIND_CONFIGURATION) & " AS " & SQL_FIELD_ROW_KIND & ","
    sqlParts.Add "IIf(Len(Nz(cfg." & SQL_FIELD_MACRO_TITLE & ",''))>0,cfg." & SQL_FIELD_MACRO_TITLE & ",Nz(cfg." & SQL_FIELD_MACRO_KEY & ",'')) AS " & FIELD_DISPLAY_TITLE & ","
    sqlParts.Add "Nz(cfg.[" & FIELD_CONFIG_OWNER_DATABASE_ROLE & "],'') & IIf(Len(Nz(cfg." & SQL_FIELD_TARGET_PROCEDURE_NAME & ",''))>0,': ' & cfg." & SQL_FIELD_TARGET_PROCEDURE_NAME & ",IIf(Len(Nz(cfg." & SQL_FIELD_TARGET_OBJECT_NAME & ",''))>0,': ' & cfg." & SQL_FIELD_TARGET_OBJECT_NAME & ",'')) AS " & FIELD_TARGET_SUMMARY & ","
    sqlParts.Add "Nz(cfg." & SQL_FIELD_LAST_VALIDATION_RESULT & ",'') & IIf(Len(Nz(cfg." & SQL_FIELD_LAST_VALIDATION_NOTES & ",''))>0,': ' & Left(cfg." & SQL_FIELD_LAST_VALIDATION_NOTES & ",255),'') AS " & FIELD_VALIDATION_SUMMARY & ","
    sqlParts.Add "Nz(cfg." & SQL_FIELD_LAST_GENERATED_RESULT & ",'') & IIf(Len(Nz(cfg." & SQL_FIELD_LAST_GENERATED_NOTES & ",''))>0,': ' & Left(cfg." & SQL_FIELD_LAST_GENERATED_NOTES & ",255),'') AS " & FIELD_GENERATION_SUMMARY & ","
    sqlParts.Add ConfigFormNeedsReviewSql() & " " & "AS " & SQL_FIELD_NEEDS_REVIEW_FLAG & ","
    sqlParts.Add ConfigFormObjectActionCodeDbSql() & " AS " & FIELD_OBJECT_ACTION_CODE_DB_FLAG & ","
    sqlParts.Add "IIf(Nz(cfg.[" & FIELD_CONFIG_OWNER_DATABASE_ROLE & "],'')<>'" & CONFIG_OWNER_DATABASE_ROLE_HOST_DB & "' And Nz(cfg.[" & FIELD_CONFIG_OWNER_DATABASE_ROLE & "],'')<>'" & CONFIG_OWNER_DATABASE_ROLE_CODE_DB & "', True, False) AS " & FIELD_CONFIG_OWNER_DATABASE_ROLE_INVALID_FLAG
    sqlParts.Add "FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Config") & "] AS cfg"
    sqlParts.Add "ORDER BY " & OrderByPolicyText("CATALOG_CONFIG_FORM") & ";"
    ConfigFormSql = SharedCollection_Join(sqlParts, " ")
End Function

Private Function ConfigFormNeedsReviewSql() As String
    Dim parts As Collection
    ' INTENTIONAL ORDERED VIEW: parts preserves the deterministic sequence required by ConfigFormNeedsReviewSql; keyed-only or unordered storage would not preserve the consumer semantics.
    Set parts = New Collection
    parts.Add "IIf(Nz(cfg." & SQL_FIELD_CONFIGURATION_STATUS & ",'')=" & SharedDao_SqlQuote(CONFIGURATION_STATUS_NEEDS_REVIEW)
    parts.Add "Or Nz(cfg." & SQL_FIELD_CONFIGURATION_STATUS & ",'')=" & SharedDao_SqlQuote(CONFIGURATION_STATUS_INVALID)
    parts.Add "Or Nz(cfg." & SQL_FIELD_MANUAL_REVIEW_STATUS & ",'')=" & SharedDao_SqlQuote(MANUAL_REVIEW_STATUS_NEEDS_REVIEW)
    parts.Add "Or Nz(cfg." & SQL_FIELD_MANUAL_REVIEW_STATUS & ",'')=" & SharedDao_SqlQuote(MANUAL_REVIEW_STATUS_BLOCKED)
    parts.Add "Or Nz(cfg." & SQL_FIELD_MANUAL_REVIEW_STATUS & ",'')=" & SharedDao_SqlQuote(MANUAL_REVIEW_STATUS_DEFERRED)
    parts.Add "Or Nz(cfg." & SQL_FIELD_LAST_VALIDATION_RESULT & ",'')=" & SharedDao_SqlQuote(VALIDATION_RESULT_INVALID)
    parts.Add "Or Nz(cfg." & SQL_FIELD_LAST_VALIDATION_RESULT & ",'')=" & SharedDao_SqlQuote(VALIDATION_RESULT_ERROR)
    parts.Add "Or Nz(cfg." & SQL_FIELD_LAST_VALIDATION_RESULT & ",'')=" & SharedDao_SqlQuote(VALIDATION_RESULT_NEEDS_REVIEW)
    parts.Add "Or Nz(cfg." & SQL_FIELD_LAST_GENERATED_RESULT & ",'')=" & SharedDao_SqlQuote(GENERATED_RESULT_FAILED)
    parts.Add "Or Nz(cfg." & SQL_FIELD_LAST_GENERATED_RESULT & ",'')=" & SharedDao_SqlQuote(GENERATED_RESULT_INVALID)
    parts.Add "Or Nz(cfg." & SQL_FIELD_LAST_GENERATED_RESULT & ",'')=" & SharedDao_SqlQuote(GENERATED_RESULT_NEEDS_REVIEW) & ", True, False)"
    ConfigFormNeedsReviewSql = SharedCollection_Join(parts, " ")
End Function

Private Function ConfigFormObjectActionCodeDbSql() As String
    Dim parts As Collection
    ' INTENTIONAL ORDERED VIEW: parts preserves the deterministic sequence required by ConfigFormObjectActionCodeDbSql; keyed-only or unordered storage would not preserve the consumer semantics.
    Set parts = New Collection
    parts.Add "IIf((Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_OPENFORM)
    parts.Add "Or Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_OPENTABLE)
    parts.Add "Or Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_OPENQUERY)
    parts.Add "Or Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_OPENREPORT)
    parts.Add "Or Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_RUNMACRO) & ")"
    parts.Add "And Nz(cfg.[" & FIELD_CONFIG_OWNER_DATABASE_ROLE & "],'')='" & CONFIG_OWNER_DATABASE_ROLE_CODE_DB & "', True, False)"
    ConfigFormObjectActionCodeDbSql = SharedCollection_Join(parts, " ")
End Function

' Purpose: Resolves target resolution form SQL from the supplied/current ADC state, using `SharedDao_SqlQuote` and `ManagedObjectPhysicalName` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
