' Purpose: Reconciles help document macro definitions.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   detailsForMessage (Output Optional; String): Receives detail text formatted for inclusion in the caller's user-facing message. Default: vbNullString.
'   mutationCountResult (Output Optional; Long): Receives the mutation count result produced by the operation so the caller can inspect the outcome without re-running the work. Default: 0.
'   dirtyDomainMaskResult (Output Optional; Long): Receives the dirty domain mask result produced by the operation so the caller can inspect the outcome without re-running the work. Default: 0.
' Returns: Boolean: True on the function's affirmative/success branch for reconcile help document macro definitions; False on its explicit negative, unavailable, rejected, or handled-failure branch.
'   not-applicable path.
Public Function ReconcileHelpDocumentMacroDefinitions(Optional ByRef detailsForMessage As String = vbNullString, Optional ByRef mutationCountResult As Long = 0, Optional ByRef dirtyDomainMaskResult As Long = 0) As Boolean
    'Operational Catalog entry point: reconciles active Help_Docs managed definitions only; built-in MC_Sys remain Setup B4-owned and are not rewritten by Build/Repair Help Document Macros.
    On Error GoTo ErrHandler
    Dim batchStarted As Boolean
    Dim managedDefinitionSnapshotOwned As Boolean
    Dim namingSnapshotOwned As Boolean
    Dim snapshotTimer As Single
    Dim mutationCountBefore As Long
    Dim executionDetail As String
    mutationCountResult = 0
    dirtyDomainMaskResult = 0
    RequireCatalogMutationRecoveryReady "ReconcileHelpDocumentMacroDefinitions"
    If mManagedDefinitionBatchActive Then Err.Raise vbObjectError + 9541, "ReconcileHelpDocumentMacroDefinitions", "A managed-definition batch is already active; standalone Help macro synchronization cannot share an unrelated in-progress batch."
    ClearManagedDefinitionReferenceSnapshots
    CorePulseProgress "Preparing operation snapshots..."
    snapshotTimer = Timer
    BeginManagedObjectDefinitionSnapshot
    managedDefinitionSnapshotOwned = True
    BeginNamingSnapshot
    namingSnapshotOwned = True
    LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "ReconcileHelpDocumentMacroDefinitions", "Build/Repair Help Document Macros operation snapshots prepared.", "Managed-object definition snapshot: armed" & vbCrLf & "System Macro definition snapshot: not acquired; operational scope is Help_Docs only" & vbCrLf & "Naming snapshot: built once for managed-definition reconciliation" & vbCrLf & "Elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(snapshotTimer)), "Build/Repair Help Document Macros managed definitions", 0, vbNullString, vbNullString, vbNullString, "ManagedObjectDefinitionsMacros", "CodeDb", "Performance"
    CorePulseProgress "Reconciling managed definitions..."
    BeginManagedDefinitionBatch True
    batchStarted = True
    mutationCountBefore = ManagedDefinitionBatchMutationCount()
    ReconcileSystemHelpMacroDefinitionsCore True, HelpDocumentScopeAllActive, executionDetail
    detailsForMessage = "Help-document managed definitions synchronized; unrelated built-in System Macro definitions were not reconciled." & vbCrLf & executionDetail
    detailsForMessage = detailsForMessage & vbCrLf & mPart14LastDeltaSummary
    mutationCountResult = ManagedDefinitionBatchMutationCount() - mutationCountBefore
    dirtyDomainMaskResult = mManagedDefinitionBatchDirtyMask
    detailsForMessage = detailsForMessage & vbCrLf & "Managed-definition mutations: " & CStr(mutationCountResult)
    detailsForMessage = detailsForMessage & vbCrLf & "Dirty fingerprint domains: " & CatalogDirtyDomainSummary(dirtyDomainMaskResult)
    EndManagedDefinitionBatch True, "System Macro and Help Document Macro managed-definition reconciliation"
    batchStarted = False
    ClearManagedDefinitionReferenceSnapshots
    If namingSnapshotOwned Then InvalidateNamingSnapshot
    namingSnapshotOwned = False
    If managedDefinitionSnapshotOwned Then EndManagedObjectDefinitionSnapshot
    managedDefinitionSnapshotOwned = False
    LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "ReconcileHelpDocumentMacroDefinitions", "Build/Repair Help Document Macros operation snapshots released.", "Managed-definition reconciliation completed; later physical macro, Navigation Pane, and Ribbon stages will not reuse potentially stale naming state.", "Build/Repair Help Document Macros managed definitions", 0, vbNullString, vbNullString, vbNullString, "ManagedObjectDefinitionsMacros", "CodeDb", "Performance"
    LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "ReconcileHelpDocumentMacroDefinitions", "Operational System Macro and Help Document Macro managed-definition reconciliation completed.", detailsForMessage, "Build/Repair Help Document Macros managed definitions", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitionsMacros", "CodeDb", "ManagedObjectCatalog"
    ReconcileHelpDocumentMacroDefinitions = True
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    If batchStarted Then EndManagedDefinitionBatch False, "System Macro and Help Document Macro managed-definition reconciliation"
    ClearManagedDefinitionReferenceSnapshots
    If namingSnapshotOwned Then InvalidateNamingSnapshot
    If managedDefinitionSnapshotOwned Then EndManagedObjectDefinitionSnapshot
    On Error GoTo 0
    detailsForMessage = "Operational System Macro and Help Document Macro managed-definition reconciliation failed." & vbCrLf & "Err.Number: " & CStr(savedErrNumber) & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
    LogTraceMessage TRACE_LEVEL_ERROR, "ManagedObjectCatalog", "ReconcileHelpDocumentMacroDefinitions", "Operational System Macro and Help Document Macro managed-definition reconciliation failed.", detailsForMessage, "Build/Repair Help Document Macros managed definitions", savedErrNumber, savedErrSource, savedErrDescription, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitionsMacros", "CodeDb", "ManagedObjectCatalog"
    Err.Raise savedErrNumber, "ReconcileHelpDocumentMacroDefinitions", detailsForMessage
End Function

' Purpose: Repairs system help macro definitions for setup.
' Public role: Public dynamic/form expression API. The name is referenced as text outside this module, so Public visibility is required for Access or generated-expression resolution.
' Parameters:
'   showMessage (Input Optional; Boolean): Controls whether the routine displays its normal user-facing status, completion, warning, or error message; False suppresses that presentation while preserving the
'   underlying operation. Default: False.
'   detailsForMessage (Output Optional; String): Receives detail text formatted for inclusion in the caller's user-facing message. Default: vbNullString.
'   namingInputsChanged (Output Optional; Boolean): Set True when the procedure determines that naming inputs changed applies; set False when that condition is not met. Default: False.
' Returns: Boolean: True on the function's affirmative/success branch for repair system help macro definitions for setup; False on its explicit negative, unavailable, rejected, or handled-failure branch.
'   not-applicable path.
Public Function RepairSystemHelpMacroDefinitionsForSetup(Optional ByVal showMessage As Boolean = False, Optional ByRef detailsForMessage As String = vbNullString, Optional ByRef namingInputsChanged As Boolean = False) As Boolean
    RequireSetupDomainMutationAllowed SETUP_DOMAIN_B4_MACRO_MANAGED_DEFINITIONS, "RepairSystemHelpMacroDefinitionsForSetup"
    'Consumes the active Part 11 snapshots, constructs only Part 14-owned definitions, compares them in memory, and applies only the resulting authoritative delta.
    On Error GoTo ErrHandler
    Dim phaseTimer As Single
    Dim mutationCountBefore As Long
    Dim managedMutationCountBefore As Long
    Dim executionDetail As String
    RequireManagedDefinitionSplitPhase MANAGED_DEFINITION_PHASE_UI, "RepairSystemHelpMacroDefinitionsForSetup"
    phaseTimer = Timer
    namingInputsChanged = False
    mutationCountBefore = ManagedDefinitionBatchMutationCount()
    managedMutationCountBefore = mManagedDefinitionBatchManagedInserted + mManagedDefinitionBatchManagedUpdated
    If mManagedDefinitionSplitMacrosRequired Then
        ReconcileSystemHelpMacroDefinitionsCore True, CoreSetupHelpDocumentSynchronizationScope(), executionDetail
        If mPart14ActualMutationCount > 0 Then
            mCatalogSetupSystemMacroInputsChanged = True
        End If
    Else
        executionDetail = "B4 clean fast path used; authoritative source preparation, plan construction, and macro delta execution were skipped."
        mPart14LastDeltaSummary = "System Macro and Help Document Macro family matched the B1 domain evidence."
    End If
    mManagedDefinitionSplitPhase = MANAGED_DEFINITION_PHASE_MACROS
    namingInputsChanged = ((mManagedDefinitionBatchManagedInserted + mManagedDefinitionBatchManagedUpdated) > managedMutationCountBefore)
    detailsForMessage = IIf(mManagedDefinitionSplitMacrosRequired, IIf(mPart14ActualMutationCount > 0, "System Macro and Help Document Macro definitions delta path: Repaired", "System Macro and Help Document Macro definitions delta path: Matched"), "System Macro and Help Document Macro definitions fast path: Used")
    detailsForMessage = detailsForMessage & vbCrLf & "B3 managed-row, payload, naming, and category evidence reused: " & CStr(mManagedDefinitionBatchActive And mManagedDefinitionReferenceSnapshotsReady)
    detailsForMessage = detailsForMessage & vbCrLf & executionDetail
    detailsForMessage = detailsForMessage & vbCrLf & mPart14LastDeltaSummary
    detailsForMessage = detailsForMessage & vbCrLf & "Managed-definition batch mutations added during B4: " & CStr(ManagedDefinitionBatchMutationCount() - mutationCountBefore)
    detailsForMessage = detailsForMessage & vbCrLf & "B4 total: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(phaseTimer))
    LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "RepairSystemHelpMacroDefinitionsForSetup", "B4 System Macro and Help Document Macro source and managed definitions completed.", detailsForMessage, "System Macro and Help Document Macro managed definitions", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitionsMacros", "CodeDb", "ManagedObjectCatalog"
    LogCatalogSetupSubstageTiming "RepairSystemHelpMacroDefinitionsForSetup", "Setup B4 object delta", detailsForMessage
    If showMessage Then CoreShowMessage detailsForMessage, vbInformation, "Managed Object Catalog", "ShowADCMessage", "Tables"
    RepairSystemHelpMacroDefinitionsForSetup = True
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    AbortManagedDefinitionSplit
    detailsForMessage = "B4 System Macro and Help Document Macro managed-definition phase failed." & vbCrLf & "Err.Number: " & CStr(savedErrNumber) & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
    LogTraceMessage TRACE_LEVEL_ERROR, "ManagedObjectCatalog", "RepairSystemHelpMacroDefinitionsForSetup", "B4 System Macro and Help Document Macro managed-definition phase failed.", detailsForMessage, "System Macro and Help Document Macro managed definitions", savedErrNumber, savedErrSource, savedErrDescription, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitionsMacros", "CodeDb", "ManagedObjectCatalog"
    If showMessage Then CoreShowErrorMessage detailsForMessage, vbCritical, "Managed Object Catalog", "RepairSystemHelpMacroDefinitionsForSetup", "Tables": Exit Function
    Err.Raise savedErrNumber, "RepairSystemHelpMacroDefinitionsForSetup", detailsForMessage
End Function

Private Sub RepairHelpDocumentsTable(Optional ByVal ensureDefaultRows As Boolean = False, Optional ByVal repairDefaultRows As Boolean = False, Optional ByVal showMessage As Boolean = True)
    RequireCatalogMutationRecoveryReady "RepairHelpDocumentsTable"
    'Intended use: Runs Repair Access Development Console Help Documents Table for direct, generated-macro, form-button, or required cross-module callers.
    On Error GoTo ErrHandler
    Dim defaultRow As Variant
    Dim tableName As String
    Dim fieldDefinitions As Collection
    Dim indexDefinitions As Collection
    tableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HelpDocuments")
    If B1ColdCreatedStructuralProofAvailable(tableName) Then
        RecordB1ColdCreateStructuralBypass tableName, 4
    Else
        Set fieldDefinitions = CatalogTableSchemaDefinitions(tableName)
        Set indexDefinitions = CatalogTableIndexDefinitions(tableName)
        CorePulseProgress "Ensuring help document catalog table exists."
        EnsureCatalogTableExists tableName
        CorePulseProgress "Ensuring help document catalog fields."
        EnsureCatalogFieldsFromSchema tableName, fieldDefinitions
        EnsureManagedTableFieldOrder tableName, fieldDefinitions
        CorePulseProgress "Repairing help document catalog indexes and lookup fields."
        EnsureCatalogIndexesFromSchema tableName, indexDefinitions
    End If
    ApplyDefaultsOwnedLookupDefinitions tableName
    If ensureDefaultRows Then
        CorePulseProgress "Reconciling default help document definitions."
        For Each defaultRow In HelpDocumentDefinitions()
            DefaultHelpDocument CStr(defaultRow(0)), CLng(defaultRow(1)), CStr(defaultRow(2)), CStr(defaultRow(3)), CStr(defaultRow(4)), repairDefaultRows
        Next defaultRow
    Else
        CorePulseProgress "Skipping default help document definition reconciliation."
    End If
    CorePulseProgress "Report help document catalog repair completion."
    ReportCoreActionSuccess "RepairHelpDocumentsTable", "Catalog", DEFAULT_UTILITY_SHORT_NAME & " help document catalog repair completed successfully.", DEFAULT_UTILITY_LONG_NAME & " help document catalog repair complete." & vbCrLf & vbCrLf & "Ensure default rows: " & CStr(ensureDefaultRows) & vbCrLf & "Repair default rows: " & CStr(repairDefaultRows) & vbCrLf & "Table: " & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HelpDocuments"), "Repair help document catalog", ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HelpDocuments"), "Table", "CodeDb", "HelpDocumentCatalog", showMessage, "Repair Help Document Catalog", vbInformation, True, "Tables", False, visibleStatusMessage:="Help document catalog repair completed successfully."
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    Dim messageText As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    messageText = "Could not repair " & DEFAULT_UTILITY_LONG_NAME & " help document catalog." & vbCrLf & vbCrLf & "Procedure: RepairHelpDocumentsTable" & vbCrLf & "EnsureDefaultRows: " & CStr(ensureDefaultRows) & vbCrLf & "RepairDefaultRows: " & CStr(repairDefaultRows) & vbCrLf & "Table: " & tableName & vbCrLf & "Err.Number: " & CStr(savedErrNumber) & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description:" & vbCrLf & savedErrDescription & TableReadinessDiagnosticsForMessage() & TraceBackendDiagnosticsForMessage()
    LogTraceMessage TRACE_LEVEL_ERROR, "ADC_HelpDocuments", "RepairHelpDocumentsTable", "Help document catalog repair failed.", messageText, "Repair help document catalog", savedErrNumber, savedErrSource, savedErrDescription, tableName, "Table", "CodeDb", "HelpDocumentCatalogRepair"
    If showMessage Then
        CoreShowErrorMessage messageText, vbCritical, "Repair Help Document Catalog", "RepairHelpDocumentsTable", "Tables"
        Exit Sub
    End If
    Err.Raise savedErrNumber, "RepairHelpDocumentsTable", messageText
End Sub

Private Sub DefaultHelpDocument(ByVal helpDocumentKey As String, ByVal helpDocumentNumber As Long, ByVal defaultTitleText As String, ByVal relativePath As String, ByVal ObjectDescription As String, ByVal repairDefaultRows As Boolean)
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim sqlText As String
    Dim isNewRow As Boolean
    Dim rowChanged As Boolean
    helpDocumentKey = Trim$(helpDocumentKey)
    defaultTitleText = Trim$(defaultTitleText)
    relativePath = Trim$(relativePath)
    If Len(helpDocumentKey) = 0 Then Exit Sub
    Set db = ResolveCatalogDb()
    sqlText = "SELECT * FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HelpDocuments") & "] WHERE [" & FIELD_HELP_DOCUMENT_KEY & "]=" & SharedDao_SqlQuote(helpDocumentKey) & ";"
    Set rs = db.OpenRecordset(sqlText, dbOpenDynaset)
    isNewRow = rs.EOF
    If isNewRow Then
        rs.AddNew
        rs.fields(FIELD_HELP_DOCUMENT_KEY).value = helpDocumentKey
        rs.fields(FIELD_HELP_DOCUMENT_NUMBER).value = helpDocumentNumber
        rs.fields(FIELD_DEFAULT_TITLE_TEXT).value = defaultTitleText
        rs.fields(FIELD_MACRO_TITLE_OVERRIDE).value = Null
        rs.fields(FIELD_RELATIVE_PATH).value = relativePath
        rs.fields(FIELD_OBJECT_DESCRIPTION).value = ObjectDescription
        rs.fields(FIELD_HELP_DOCUMENT_STATUS).value = ADCAT_STATUS_ACTIVE
        rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value = helpDocumentNumber
        SetRecordsetFieldValueWithSource rs, FIELD_DEFAULT_SOURCE, DEFAULT_CONSTANT_DEFINITION_SOURCE, "DEFAULT_CONSTANT_DEFINITION_SOURCE"
        rs.fields(FIELD_DEFAULTED_ON).value = Now
        rowChanged = True
    ElseIf repairDefaultRows Then
        rs.Edit
        If IsNull(rs.fields(FIELD_HELP_DOCUMENT_NUMBER).value) Then rs.fields(FIELD_HELP_DOCUMENT_NUMBER).value = helpDocumentNumber: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_DEFAULT_TITLE_TEXT).value, vbNullString)))) = 0 Then rs.fields(FIELD_DEFAULT_TITLE_TEXT).value = defaultTitleText: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_RELATIVE_PATH).value, vbNullString)))) = 0 Then rs.fields(FIELD_RELATIVE_PATH).value = relativePath: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_OBJECT_DESCRIPTION).value, vbNullString)))) = 0 Then rs.fields(FIELD_OBJECT_DESCRIPTION).value = ObjectDescription: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_HELP_DOCUMENT_STATUS).value, vbNullString)))) = 0 Then rs.fields(FIELD_HELP_DOCUMENT_STATUS).value = ADCAT_STATUS_ACTIVE: rowChanged = True
        If IsNull(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value) Then rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value = helpDocumentNumber: rowChanged = True
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_DEFAULT_SOURCE).value, vbNullString)))) = 0 Then
            SetRecordsetFieldValueWithSource rs, FIELD_DEFAULT_SOURCE, DEFAULT_CONSTANT_DEFINITION_SOURCE, "DEFAULT_CONSTANT_DEFINITION_SOURCE"
            rowChanged = True
        End If
        If rowChanged Then rs.fields(FIELD_LAST_DEFAULT_REPAIR_ON).value = Now
    Else
        rs.Close
        Exit Sub
    End If
    NormalizeZeroLengthOptionalTextFieldsForRecordsetUpdate rs
    rs.Update
    rs.Close
    Exit Sub
ErrHandler:
    Dim originalErrNumber As Long
    Dim originalErrDescription As String
    originalErrNumber = Err.Number
    originalErrDescription = Err.Description
    Err.Raise originalErrNumber, "DefaultHelpDocument", "Unable to default " & DEFAULT_UTILITY_LONG_NAME & " help-document row without overwriting existing user values." & vbCrLf & "HelpDocumentKey: " & helpDocumentKey & vbCrLf & "Table: " & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HelpDocuments") & vbCrLf & "Description: " & originalErrDescription
End Sub

' Purpose: Checks whether help document key belongs to the managed synchronization scope handled by the current build/repair operation.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   synchronizationScope (Input; HelpDocumentSynchronizationScope): Scope value limiting which synchronization items or operations are included in this call.
' Returns: Boolean: True when the condition represented by ResolveHelpDocumentMaterialization is present under the routine's documented inputs/current state; False when that condition is absent.
Public Function HelpDocumentKeyInSynchronizationScope(ByVal synchronizationScope As HelpDocumentSynchronizationScope) As Boolean
    'Setup owns all active Help_Docs rows when Help maintenance is enabled and none when it is disabled; Build/Repair Help Document Macros explicitly owns all active Help_Docs rows regardless of the Setup setting.
    Select Case synchronizationScope
        Case HelpDocumentScopeSetupSystemAndAllActive, HelpDocumentScopeAllActive
            HelpDocumentKeyInSynchronizationScope = True
        Case HelpDocumentScopeSetupSystemOnly
            HelpDocumentKeyInSynchronizationScope = False
        Case Else
            Err.Raise vbObjectError + 9801, "HelpDocumentKeyInSynchronizationScope", "Unsupported Help Document synchronization scope: " & CStr(synchronizationScope)
    End Select
End Function

' Purpose: Checks whether help document run code belongs to the managed synchronization scope handled by the current build/repair operation.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   runCodeExpression (Input; String): Expression text representing the run code calculation, RunCode target, SQL fragment, or UI binding interpreted by this routine.
'   synchronizationScope (Input; HelpDocumentSynchronizationScope): Scope value limiting which synchronization items or operations are included in this call.
' Returns: Boolean: True when the condition represented by HelpDocumentActualTitleFromValues is present under the routine's documented inputs/current state; False when that condition is absent.
Public Function HelpDocumentRunCodeInSynchronizationScope(ByVal runCodeExpression As String, ByVal synchronizationScope As HelpDocumentSynchronizationScope) As Boolean
    runCodeExpression = Trim$(runCodeExpression)
    Select Case synchronizationScope
        Case HelpDocumentScopeSetupSystemAndAllActive, HelpDocumentScopeAllActive
            HelpDocumentRunCodeInSynchronizationScope = (StrComp(Left$(runCodeExpression, Len("Run_OpenHelpDocument(")), "Run_OpenHelpDocument(", vbTextCompare) = 0)
        Case HelpDocumentScopeSetupSystemOnly
            HelpDocumentRunCodeInSynchronizationScope = False
        Case Else
            Err.Raise vbObjectError + 9803, "HelpDocumentRunCodeInSynchronizationScope", "Unsupported Help Document synchronization scope: " & CStr(synchronizationScope)
    End Select
End Function

' Purpose: Resolves help document materialization for help document key, help document number.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   helpDocumentKey (Input; String): Canonical key identifying the help document definition, setting, or managed item to use.
'   helpDocumentNumber (Input; Long): Numeric identifier or ordinal for the help document item processed or reported by this operation.
'   defaultTitleText (Input; String): Default title text text included in this procedure's user-facing or diagnostic output; blank handling follows the explicit branches in the routine.
'   macroTitleOverride (Input; String): Title text used as the macro title override shown, stored, compared, or resolved by this operation.
'   rowIdentity (Input; String): Stable row identity used to select or correlate the exact ADC definition/state handled by this procedure.
'   synchronizationScope (Input; HelpDocumentSynchronizationScope): Scope value limiting which synchronization items or operations are included in this call.
'   MacroTitle (Output; String): Receives the resolved macro title produced from this procedure's validated inputs and current ADC state.
'   runCodeExpression (Output; String): Receives the run code expression returned by `HelpDocumentRunCodeExpression` after this procedure completes its validation/resolution work.
' Returns: None (Sub). Results are returned through the documented ByRef parameters and/or the routine's database, UI, or module-state side effects.
Public Sub ResolveHelpDocumentMaterialization(ByVal helpDocumentKey As String, ByVal helpDocumentNumber As Long, ByVal defaultTitleText As String, ByVal macroTitleOverride As String, ByVal rowIdentity As String, ByVal synchronizationScope As HelpDocumentSynchronizationScope, ByRef MacroTitle As String, ByRef runCodeExpression As String)
    Dim invalidNameReason As String
    helpDocumentKey = Trim$(helpDocumentKey)
    rowIdentity = Trim$(rowIdentity)
    MacroTitle = vbNullString
    runCodeExpression = vbNullString
    If Len(helpDocumentKey) = 0 Then Err.Raise vbObjectError + 9804, "ResolveHelpDocumentMaterialization", HelpDocumentMaterializationErrorText(helpDocumentKey, rowIdentity, synchronizationScope, "HelpDocumentKey is blank.")
    If helpDocumentNumber <= 0 Then Err.Raise vbObjectError + 9805, "ResolveHelpDocumentMaterialization", HelpDocumentMaterializationErrorText(helpDocumentKey, rowIdentity, synchronizationScope, "HelpDocumentNumber must be greater than zero before the Help macro number and Ribbon tag can be derived.")
    MacroTitle = Trim$(HelpDocumentActualTitleFromValues(helpDocumentNumber, defaultTitleText, macroTitleOverride))
    If Len(MacroTitle) = 0 Then Err.Raise vbObjectError + 9806, "ResolveHelpDocumentMaterialization", HelpDocumentMaterializationErrorText(helpDocumentKey, rowIdentity, synchronizationScope, "The row does not resolve to a nonblank physical macro title. Check DefaultTitleText, MacroTitleOverride, and HelpDocumentNumber.")
    invalidNameReason = HelpDocumentMacroNameInvalidReason(MacroTitle)
    If Len(invalidNameReason) > 0 Then Err.Raise vbObjectError + 9807, "ResolveHelpDocumentMaterialization", HelpDocumentMaterializationErrorText(helpDocumentKey, rowIdentity, synchronizationScope, invalidNameReason)
    runCodeExpression = HelpDocumentRunCodeExpression(helpDocumentKey)
    If Len(runCodeExpression) = 0 Then Err.Raise vbObjectError + 9808, "ResolveHelpDocumentMaterialization", HelpDocumentMaterializationErrorText(helpDocumentKey, rowIdentity, synchronizationScope, "The row does not resolve to a nonblank RunCode expression.")
End Sub

Private Function HelpDocumentSynchronizationOperationName(ByVal synchronizationScope As HelpDocumentSynchronizationScope) As String
    Select Case synchronizationScope
        Case HelpDocumentScopeSetupSystemAndAllActive: HelpDocumentSynchronizationOperationName = "Setup (System + active Help Documents)"
        Case HelpDocumentScopeSetupSystemOnly: HelpDocumentSynchronizationOperationName = "Setup (System Macros only)"
        Case HelpDocumentScopeAllActive: HelpDocumentSynchronizationOperationName = "Build/Repair Help Document Macros"
        Case Else: HelpDocumentSynchronizationOperationName = "Unknown Help Document synchronization operation"
    End Select
End Function

Private Function HelpDocumentMaterializationErrorText(ByVal helpDocumentKey As String, ByVal rowIdentity As String, ByVal synchronizationScope As HelpDocumentSynchronizationScope, ByVal reasonText As String) As String
    HelpDocumentMaterializationErrorText = HelpDocumentSynchronizationOperationName(synchronizationScope) & " could not materialize an active Help_Docs row." & vbCrLf & "HelpDocumentKey: " & IIf(Len(helpDocumentKey) = 0, "(blank)", helpDocumentKey) & vbCrLf & "Row identity: " & IIf(Len(rowIdentity) = 0, "(unavailable)", rowIdentity) & vbCrLf & "Reason: " & reasonText
End Function

Private Function HelpDocumentMacroNameInvalidReason(ByVal MacroTitle As String) As String
    Dim i As Long
    Dim charCode As Long
    If Len(MacroTitle) > MAX_ACCESS_OBJECT_NAME_LENGTH Then HelpDocumentMacroNameInvalidReason = "The physical macro title exceeds the Access object-name limit of " & CStr(MAX_ACCESS_OBJECT_NAME_LENGTH) & " characters.": Exit Function
    If InStr(1, MacroTitle, ".", vbBinaryCompare) > 0 Or InStr(1, MacroTitle, "!", vbBinaryCompare) > 0 Or InStr(1, MacroTitle, "[", vbBinaryCompare) > 0 Or InStr(1, MacroTitle, "]", vbBinaryCompare) > 0 Or InStr(1, MacroTitle, "`", vbBinaryCompare) > 0 Then HelpDocumentMacroNameInvalidReason = "The physical macro title contains a character Access does not permit in an object name (. ! [ ] `).": Exit Function
    For i = 1 To Len(MacroTitle)
        charCode = AscW(Mid$(MacroTitle, i, 1))
        If charCode < 32 Or charCode = 127 Then HelpDocumentMacroNameInvalidReason = "The physical macro title contains a control character that Access does not permit in an object name.": Exit Function
    Next i
End Function

' Purpose: Resolves and returns help document actual title from values from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   helpDocumentNumber (Input; Long): Numeric identifier or ordinal for the help document item processed or reported by this operation.
'   defaultTitleText (Input; String): Default title text text included in this procedure's user-facing or diagnostic output; blank handling follows the explicit branches in the routine.
'   macroTitleOverride (Input; String): Title text used as the macro title override shown, stored, compared, or resolved by this operation.
' Returns: String: Returns the canonical display text for help document actual title from values after applying the title/caption/label rules owned by this module; vbNullString represents no applicable display
'   text where supported.
Public Function HelpDocumentActualTitleFromValues(ByVal helpDocumentNumber As Long, ByVal defaultTitleText As String, ByVal macroTitleOverride As String) As String
    'Intended use: Returns the Access Development Console Help Document Actual Title From Values result for direct, query, form, or required cross-module callers.
    macroTitleOverride = Trim$(macroTitleOverride)
    If Len(macroTitleOverride) > 0 Then
        HelpDocumentActualTitleFromValues = macroTitleOverride
    Else
        HelpDocumentActualTitleFromValues = SystemMacroCalculatedTitle(GetHelpDocumentMacroNumber(helpDocumentNumber), defaultTitleText)
    End If
End Function

Private Function HelpDocumentRunCodeExpression(ByVal helpDocumentKey As String) As String
    'Intended use: Returns the Access Development Console Help Document Run Code Expression result for direct, query, form, or required cross-module callers.
    HelpDocumentRunCodeExpression = "Run_OpenHelpDocument('" & Replace(helpDocumentKey, "'", "''") & "')"
End Function

' Purpose: Runs open help document for help document key.
' Public role: Macro-callable public entry point. The Function form and Public visibility allow Access macros/RunCode expressions to invoke the underlying ADC operation.
' Parameters:
'   helpDocumentKey (Input; String): Canonical key identifying the help document definition, setting, or managed item to use.
' Returns: Boolean: True on the function's affirmative/success branch for run open help document; False on its explicit negative, unavailable, rejected, or handled-failure branch.
Public Function Run_OpenHelpDocument(ByVal helpDocumentKey As String) As Boolean
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim sqlText As String
    Dim relativePath As String
    Dim fullPath As String
    helpDocumentKey = Trim$(helpDocumentKey)
    If Len(helpDocumentKey) = 0 Then Err.Raise vbObjectError + 9733, "Run_OpenHelpDocument", HELP_DOCUMENT_PATH_UNDEFINED_MESSAGE & vbCrLf & "HelpDocumentKey is blank."
    Set db = ResolveCatalogDb()
    If SharedDao_TableExists(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HelpDocuments")) = False Then Err.Raise vbObjectError + 9734, "Run_OpenHelpDocument", "B4 source [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HelpDocuments") & "] is missing. Runtime Help does not repair its source table."
    If TableCanOpen(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HelpDocuments")) = False Then Err.Raise vbObjectError + 9735, "Run_OpenHelpDocument", "B4 source [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HelpDocuments") & "] cannot be opened. Runtime Help does not repair its source table."
    sqlText = "SELECT TOP 1 " & SQL_FIELD_RELATIVE_PATH & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HelpDocuments") & "] WHERE [" & FIELD_HELP_DOCUMENT_KEY & "]=" & SharedDao_SqlQuote(helpDocumentKey) & " AND Nz(" & SQL_FIELD_HELP_DOCUMENT_STATUS & "," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ";"
    Set rs = db.OpenRecordset(sqlText, dbOpenSnapshot)
    If rs.EOF Then Err.Raise vbObjectError + 9736, "Run_OpenHelpDocument", "Help document row was not found or is inactive." & vbCrLf & "HelpDocumentKey: " & helpDocumentKey
    relativePath = Trim$(CStr(Nz(rs.fields(FIELD_RELATIVE_PATH).value, vbNullString)))
    rs.Close
    Set rs = Nothing
    If Len(relativePath) = 0 Then Err.Raise vbObjectError + 9737, "Run_OpenHelpDocument", HELP_DOCUMENT_PATH_UNDEFINED_MESSAGE & vbCrLf & "HelpDocumentKey: " & helpDocumentKey
    fullPath = HelpDocumentFullPathReadOnly(db, relativePath)
    If Len(fullPath) = 0 Then Err.Raise vbObjectError + 9738, "Run_OpenHelpDocument", HELP_DOCUMENT_PATH_UNDEFINED_MESSAGE & vbCrLf & "RelativePath: " & relativePath
    If Len(Dir$(fullPath)) = 0 Then Err.Raise vbObjectError + 9739, "Run_OpenHelpDocument", HELP_DOCUMENT_NOT_FOUND_MESSAGE & vbCrLf & vbCrLf & HELP_DOCUMENT_PATH_LABEL & fullPath & vbCrLf & HELP_DOCUMENT_RELATIVE_PATH_LABEL & relativePath
    Application.FollowHyperlink fullPath
    Run_OpenHelpDocument = True
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    Dim messageText As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    messageText = HELP_DOCUMENT_OPEN_FAILED_MESSAGE & vbCrLf & vbCrLf & _
                  "Procedure: Run_OpenHelpDocument" & vbCrLf & _
                  "HelpDocumentKey: " & helpDocumentKey & vbCrLf & _
                  "Err.Number: " & CStr(savedErrNumber) & vbCrLf & _
                  "Err.Source: " & savedErrSource & vbCrLf & _
                  "Err.Description:" & vbCrLf & savedErrDescription
    On Error Resume Next
    LogTraceMessage TRACE_LEVEL_ERROR, "HelpDocument", "Run_OpenHelpDocument", "Help document open failed.", messageText, "Open help document", savedErrNumber, savedErrSource, savedErrDescription, helpDocumentKey, "HelpDocument", "CodeDb", "HelpDocument"
    CoreShowErrorMessage messageText, vbCritical, HELP_DOCUMENT_ERROR_TITLE, "Run_OpenHelpDocument", "Tables"
    On Error GoTo 0
    Run_OpenHelpDocument = False
End Function

Private Function HelpDocumentFullPathReadOnly(ByVal db As DAO.Database, ByVal relativePath As String) As String
    Dim codeDbFolder As String
    Dim helpDocumentsFolder As String
    Dim normalizedRelativePath As String
    Dim dbPath As String
    Dim slashPos As Long
    normalizedRelativePath = Replace(relativePath, "/", HELP_DOCUMENT_BACKSLASH)
    Do While Left$(normalizedRelativePath, 1) = HELP_DOCUMENT_BACKSLASH
        normalizedRelativePath = Mid$(normalizedRelativePath, 2)
    Loop
    If Len(normalizedRelativePath) = 0 Then Exit Function
    helpDocumentsFolder = Replace(Trim$(SettingText(SETTING_HELP_DOCUMENTS_DIRECTORY, DEFAULT_HELP_DOCUMENTS_DIRECTORY)), "/", HELP_DOCUMENT_BACKSLASH)
    If Len(helpDocumentsFolder) = 0 Then helpDocumentsFolder = DEFAULT_HELP_DOCUMENTS_DIRECTORY
    Do While Left$(helpDocumentsFolder, 1) = HELP_DOCUMENT_BACKSLASH
        helpDocumentsFolder = Mid$(helpDocumentsFolder, 2)
    Loop
    Do While Right$(helpDocumentsFolder, 1) = HELP_DOCUMENT_BACKSLASH
        helpDocumentsFolder = Left$(helpDocumentsFolder, Len(helpDocumentsFolder) - 1)
    Loop
    If Len(helpDocumentsFolder) = 0 Then Exit Function
    On Error Resume Next
    dbPath = Trim$(db.Name)
    On Error GoTo 0
    slashPos = InStrRev(dbPath, HELP_DOCUMENT_BACKSLASH)
    If slashPos > 1 Then codeDbFolder = Left$(dbPath, slashPos - 1)
    If Len(codeDbFolder) = 0 Then codeDbFolder = Application.CurrentProject.Path
    If Len(codeDbFolder) = 0 Then Exit Function
    If Right$(codeDbFolder, 1) <> HELP_DOCUMENT_BACKSLASH Then codeDbFolder = codeDbFolder & HELP_DOCUMENT_BACKSLASH
    HelpDocumentFullPathReadOnly = codeDbFolder & helpDocumentsFolder & HELP_DOCUMENT_BACKSLASH & normalizedRelativePath
End Function

Private Sub ValidateSystemHelpManagedDefinitions(ByVal db As DAO.Database, ByVal synchronizationScope As HelpDocumentSynchronizationScope)
    On Error GoTo ErrHandler
    Dim rowData As Variant
    Dim rs As DAO.Recordset
    Dim MacroTitle As String
    Dim helpDocumentKey As String
    Dim runCodeExpression As String
    Dim objectName As String
    Dim managedObjectID As Long
    Dim managedData As Variant
    Dim payloadCollection As Collection
    Dim managedRows As Object
    Dim payloadRows As Object
    Dim managedRowCount As Long
    Dim payloadRowCount As Long
    Dim commandValidationCount As Long
    Dim operationTimer As Single
    Dim rowIdentity As String
    Dim helpDocumentNumber As Long
    operationTimer = Timer
    ' INTENTIONAL KEYED LOOKUP: managedRows, payloadRows provides keyed membership/lookup over source rows or state already read by ValidateSystemHelpManagedDefinitions; it is a derived access path, not a second
    ' authority.
    Set managedRows = CreateObject("Scripting.Dictionary")
    managedRows.CompareMode = vbTextCompare
    Set payloadRows = CreateObject("Scripting.Dictionary")
    payloadRows.CompareMode = vbBinaryCompare
    Set rs = db.OpenRecordset("SELECT " & SQL_FIELD_ID & "," & SQL_FIELD_OBJECT_NAME & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] WHERE UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))='MACRO' AND UCase(Trim(Nz([" & FIELD_CATEGORY_CODE & "],'')))=" & SharedDao_SqlQuote(UCase$(ADCAT_CATEGORY_SYSTEM_MACRO)) & " AND Nz([" & FIELD_MANAGED_OBJECT_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " ORDER BY " & SQL_FIELD_ID & ";", dbOpenSnapshot)
    Do While rs.EOF = False
        PumpSetupResponsiveness
        managedRowCount = managedRowCount + 1
        objectName = CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString))
        managedObjectID = CLng(Nz(rs.fields(FIELD_ID).value, 0))
        If managedRows.Exists(objectName) Then
            managedData = managedRows(objectName)
            managedData(0) = CLng(managedData(0)) + 1
            managedRows(objectName) = managedData
        Else
            managedRows.Add objectName, Array(1&, managedObjectID)
        End If
        rs.MoveNext
    Loop
    rs.Close
    Set rs = db.OpenRecordset("SELECT p.[" & FIELD_MANAGED_OBJECT_ID & "],p.[" & FIELD_PAYLOAD_KIND & "],p.[" & FIELD_RUN_CODE_WRAPPER_NAME & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads") & "] AS p INNER JOIN [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] AS m ON p.[" & FIELD_MANAGED_OBJECT_ID & "]=m." & SQL_FIELD_ID & " WHERE Nz(p.[" & FIELD_PAYLOAD_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND UCase(Trim(Nz(m." & SQL_FIELD_OBJECT_TYPE & ",'')))='MACRO' AND UCase(Trim(Nz(m.[" & FIELD_CATEGORY_CODE & "],'')))=" & SharedDao_SqlQuote(UCase$(ADCAT_CATEGORY_SYSTEM_MACRO)) & " AND Nz(m.[" & FIELD_MANAGED_OBJECT_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & _
                SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " ORDER BY p." & SQL_FIELD_ID & ";", dbOpenSnapshot)
    Do While rs.EOF = False
        PumpSetupResponsiveness
        payloadRowCount = payloadRowCount + 1
        managedObjectID = CLng(rs.fields(FIELD_MANAGED_OBJECT_ID).value)
        If payloadRows.Exists(CStr(managedObjectID)) Then
            Set payloadCollection = payloadRows(CStr(managedObjectID))
        Else
            ' INTENTIONAL FILTERED PARTITION: payloadCollection is a consumer-required subset/projection derived from the source enumerated by ValidateSystemHelpManagedDefinitions; its membership is not
            ' independently authoritative.
            Set payloadCollection = New Collection
            payloadRows.Add CStr(managedObjectID), payloadCollection
        End If
        payloadCollection.Add Array(CStr(Nz(rs.fields(FIELD_PAYLOAD_KIND).value, vbNullString)), CStr(Nz(rs.fields(FIELD_RUN_CODE_WRAPPER_NAME).value, vbNullString)))
        rs.MoveNext
    Loop
    rs.Close
    Set rs = Nothing
    For Each rowData In SystemMacroCatalog()
        PumpSetupResponsiveness
        ValidateManagedRunCodeDefinition managedRows, payloadRows, SystemMacroCatalogTitle(rowData), SystemMacroCatalogRunCodeFunctionName(rowData), "SystemMacroCatalog"
        commandValidationCount = commandValidationCount + 1
    Next rowData
    If synchronizationScope <> HelpDocumentScopeSetupSystemOnly Then
        Set rs = db.OpenRecordset("SELECT * FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HelpDocuments") & "] WHERE Nz(" & SQL_FIELD_HELP_DOCUMENT_STATUS & "," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " ORDER BY " & OrderByPolicyText("CATALOG_HELP_DOCUMENT") & ";", dbOpenSnapshot)
        Do While rs.EOF = False
            PumpSetupResponsiveness
            helpDocumentKey = CStr(Nz(rs.fields(FIELD_HELP_DOCUMENT_KEY).value, vbNullString))
            If HelpDocumentKeyInSynchronizationScope(synchronizationScope) Then
                rowIdentity = vbNullString
                If SharedDao_RecordsetHasFieldSafe(rs, FIELD_ID) Then rowIdentity = CStr(Nz(rs.fields(FIELD_ID).value, vbNullString))
                helpDocumentNumber = CLng(Nz(rs.fields(FIELD_HELP_DOCUMENT_NUMBER).value, 0))
                ResolveHelpDocumentMaterialization helpDocumentKey, helpDocumentNumber, CStr(Nz(rs.fields(FIELD_DEFAULT_TITLE_TEXT).value, vbNullString)), CStr(Nz(rs.fields(FIELD_MACRO_TITLE_OVERRIDE).value, vbNullString)), rowIdentity, synchronizationScope, MacroTitle, runCodeExpression
                ValidateManagedRunCodeDefinition managedRows, payloadRows, MacroTitle, runCodeExpression, "HelpDocCatalog"
                commandValidationCount = commandValidationCount + 1
            End If
            rs.MoveNext
        Loop
        rs.Close
        Set rs = Nothing
    End If
    AddTraceNote "B5 System Macro and Help Document Macro payload validation reused two bulk source snapshots. Managed macro rows=" & CStr(managedRowCount) & "; active payload rows=" & CStr(payloadRowCount) & "; authoritative commands checked=" & CStr(commandValidationCount) & "; per-command DAO lookups=0; elapsed=" & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer)) & "."
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    Err.Raise savedErrNumber, "ValidateSystemHelpManagedDefinitions", savedErrDescription
End Sub

