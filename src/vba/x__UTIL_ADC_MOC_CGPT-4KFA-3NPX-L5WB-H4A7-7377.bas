Private Sub DefaultDetailedManagedObject(ByVal objectName As String, ByVal categoryCode As String, ByVal objectTypeCode As String, ByVal descriptionText As String, ByVal SortOrder As Long, ByVal repairDefaultRows As Boolean)
    Dim defaultDescription As String
    Dim logicalIdentity As String
