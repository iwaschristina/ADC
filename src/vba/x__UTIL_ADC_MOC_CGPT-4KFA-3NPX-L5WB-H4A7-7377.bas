Private Function ActionPayloadDifferenceText(ByVal leftRow As DAO.Recordset, ByVal rightRow As DAO.Recordset) As String
    Dim fieldNames As Variant
    Dim fieldName As Variant
    Dim differenceText As String
    fieldNames = Array(FIELD_PAYLOAD_KIND, FIELD_PAYLOAD_STATUS, FIELD_ACTION_PROCEDURE_NAME, FIELD_RUN_CODE_WRAPPER_NAME, FIELD_MACRO_DESCRIPTION, FIELD_PAYLOAD_TEXT, FIELD_PAYLOAD_VERSION, FIELD_CATALOG_OWNER, FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER, FIELD_DEFAULT_SOURCE)
    For Each fieldName In fieldNames
        PumpSetupResponsiveness
        If StrComp(CStr(Nz(leftRow.fields(CStr(fieldName)).value, vbNullString)), CStr(Nz(rightRow.fields(CStr(fieldName)).value, vbNullString)), vbBinaryCompare) <> 0 Then
            If Len(differenceText) > 0 Then differenceText = differenceText & ", "
            differenceText = differenceText & CStr(fieldName)
        End If
    Next fieldName
    ActionPayloadDifferenceText = differenceText
End Function

Private Sub AddUniqueExactText(ByRef values As Collection, ByVal valueText As String)
    'Exact-name keyed view used for physical Access object identities. Preserve whitespace/case text exactly; Access membership remains case-insensitive.
    On Error Resume Next
    If Len(valueText) = 0 Then Exit Sub
    values.Add valueText, UCase$(valueText)
End Sub

Private Sub AddUniqueText(ByRef values As Collection, ByVal valueText As String)
    On Error Resume Next
    valueText = Trim$(valueText)
    If Len(valueText) = 0 Then Exit Sub
    values.Add valueText, UCase$(valueText)
End Sub


Private Function SortedTextCollection(ByVal values As Collection) As Collection
    Dim result As Collection
    Dim arr() As String
    Dim indexValue As Long
    ' INTENTIONAL ORDERED VIEW: result preserves the deterministic sequence required by SortedTextCollection; keyed-only or unordered storage would not preserve the consumer semantics.
    Set result = New Collection
    If values Is Nothing Then Set SortedTextCollection = result: Exit Function
    If values.count = 0 Then Set SortedTextCollection = result: Exit Function
    ReDim arr(0 To values.count - 1)
    For indexValue = 1 To values.count
        PumpSetupResponsiveness
        arr(indexValue - 1) = CStr(values(indexValue))
    Next indexValue
    SharedArray_SortStringArray arr
    For indexValue = LBound(arr) To UBound(arr)
        PumpSetupResponsiveness
        result.Add arr(indexValue), UCase$(arr(indexValue))
    Next indexValue
    Set SortedTextCollection = result
End Function

Private Function ExactTextCollectionContains(ByVal values As Collection, ByVal valueText As String) As Boolean
    'Exact physical-name membership: preserve the supplied text and do not Trim/normalize it before lookup.
    On Error GoTo ExitHere
    Dim ignored As Variant
    ignored = values(UCase$(valueText))
    ExactTextCollectionContains = True
ExitHere:
End Function

Private Function TextCollectionContains(ByVal values As Collection, ByVal valueText As String) As Boolean
    On Error GoTo ExitHere
    Dim ignored As Variant
    ignored = values(UCase$(Trim$(valueText)))
    TextCollectionContains = True
ExitHere:
End Function

