    sqlText = sqlText & "cfg." & SQL_FIELD_TARGET_ARGUMENTS & ", cfg." & SQL_FIELD_GENERATION_TARGET_DB_NAME & ", cfg." & SQL_FIELD_GENERATION_TARGET_DB_PATH & ", cfg." & SQL_FIELD_TARGET_REFERENCE_NAME & ", "
    sqlText = sqlText & "cfg." & SQL_FIELD_TARGET_VB_PROJECT_NAME & ", cfg." & SQL_FIELD_TARGET_OBJECT_NAME & ", cfg." & SQL_FIELD_LAST_VALIDATED_ON & ", cfg." & SQL_FIELD_LAST_VALIDATION_RESULT & ", "
    sqlText = sqlText & "cfg." & SQL_FIELD_LAST_VALIDATION_NOTES & ", cfg." & SQL_FIELD_MANUAL_REVIEW_STATUS & ", cfg." & SQL_FIELD_MANUAL_REVIEW_NOTES & ", "
    sqlText = sqlText & "IIf(Nz(cfg.[" & FIELD_CONFIG_OWNER_DATABASE_ROLE & "],'')<>'" & CONFIG_OWNER_DATABASE_ROLE_HOST_DB & "' And Nz(cfg.[" & FIELD_CONFIG_OWNER_DATABASE_ROLE & "],'')<>'" & CONFIG_OWNER_DATABASE_ROLE_CODE_DB & "', True, False) AS " & FIELD_CONFIG_OWNER_ROLE_INVALID_FLAG & ", "
    sqlText = sqlText & "IIf((Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_OPENFORM) & " Or Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_OPENTABLE) & " Or Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_OPENQUERY) & " Or Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_OPENREPORT) & " Or Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_RUNMACRO) & ") And Nz(cfg.[" & FIELD_CONFIG_OWNER_DATABASE_ROLE & "],'')='" & CONFIG_OWNER_DATABASE_ROLE_CODE_DB & "', True, False) AS " & FIELD_OBJECT_ACTION_CODE_DB_FLAG & ", "
    sqlText = sqlText & "IIf(Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_RUNCODE) & " And Len(Nz(cfg." & SQL_FIELD_TARGET_PROCEDURE_NAME & ",''))=0, True, False) AS " & FIELD_TARGET_PROCEDURE_MISSING_FLAG & ", "
    sqlText = sqlText & "IIf(Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_RUNCODE) & " And Len(Nz(cfg." & SQL_FIELD_TARGET_PROCEDURE_MODULE_NAME & ",''))=0, True, False) AS " & FIELD_TARGET_MODULE_MISSING_FLAG & ", "
    sqlText = sqlText & "IIf((Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_OPENFORM) & " Or Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_OPENTABLE) & " Or Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_OPENQUERY) & " Or Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_OPENREPORT) & " Or Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_RUNMACRO) & ") And Len(Nz(cfg." & SQL_FIELD_TARGET_OBJECT_NAME & ",''))=0, True, False) AS " & FIELD_OBJECT_NAME_MISSING_FLAG & ", "
    sqlText = sqlText & "IIf(Len(Nz(cfg.[" & FIELD_CONFIG_OWNER_DATABASE_ROLE & "],''))=0 Or (Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_RUNCODE) & " And Len(Nz(cfg." & SQL_FIELD_TARGET_PROCEDURE_NAME & ",''))=0) Or ((Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_OPENFORM) & " Or Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_OPENTABLE) & " Or Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_OPENQUERY) & " Or Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_OPENREPORT) & " Or Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_RUNMACRO) & ") And Len(Nz(cfg." & SQL_FIELD_TARGET_OBJECT_NAME & ",''))=0), True, False) AS " & FIELD_TARGET_METADATA_BLANK_FLAG & ", "
    sqlText = sqlText & "IIf((Nz(cfg.[" & FIELD_CONFIG_OWNER_DATABASE_ROLE & "],'')<>'" & CONFIG_OWNER_DATABASE_ROLE_HOST_DB & "' And Nz(cfg.[" & FIELD_CONFIG_OWNER_DATABASE_ROLE & "],'')<>'" & CONFIG_OWNER_DATABASE_ROLE_CODE_DB & "') Or ((Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_OPENFORM) & " Or Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_OPENTABLE) & " Or Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_OPENQUERY) & " Or Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_OPENREPORT) & " Or Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_RUNMACRO) & ") And Nz(cfg.[" & FIELD_CONFIG_OWNER_DATABASE_ROLE & "],'')='" & CONFIG_OWNER_DATABASE_ROLE_CODE_DB & "') Or (Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & _
        SharedDao_SqlQuote(ACTION_RUNCODE) & " And Len(Nz(cfg." & SQL_FIELD_TARGET_PROCEDURE_NAME & ",''))=0) Or ((Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_OPENFORM) & " Or Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_OPENTABLE) & " Or Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_OPENQUERY) & " Or Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_OPENREPORT) & " Or Nz(cfg." & SQL_FIELD_MACRO_ACTION & ",'')=" & SharedDao_SqlQuote(ACTION_RUNMACRO) & ") And Len(Nz(cfg." & SQL_FIELD_TARGET_OBJECT_NAME & ",''))=0), True, False) AS " & FIELD_NEEDS_TARGET_RESOLUTION_FLAG & " "
    sqlText = sqlText & "FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Config") & "] AS cfg "
    sqlText = sqlText & "WHERE cfg.[" & FIELD_ACTIVE & "]<>False "
    sqlText = sqlText & "AND Nz(cfg." & SQL_FIELD_CONFIGURATION_STATUS & "," & SharedDao_SqlQuote(CONFIGURATION_STATUS_ACTIVE) & ")<>" & SharedDao_SqlQuote(CONFIGURATION_STATUS_DISABLED) & ";"
