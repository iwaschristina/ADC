Private Function ManagedObjectCatalogReviewSql() As String
    Dim sqlText As String
    sqlText = "SELECT " & OrderedQuerySelectList(ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_ManagedObjectsResolved"), "r") & ", "
    sqlText = sqlText & "IIf(r." & SQL_FIELD_OBJECT_CATEGORY_STATUS & "<>" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " Or r.[" & FIELD_MANAGED_OBJECT_STATUS & "]<>" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & "," & SharedDao_SqlQuote(CATALOG_REVIEW_STATUS_INACTIVE_OR_REVIEW) & ",IIf(Len(Nz(r." & SQL_FIELD_RESOLVED_SETUP_ACTION & ",''))=0," & SharedDao_SqlQuote(CATALOG_REVIEW_STATUS_BLOCKING) & "," & SharedDao_SqlQuote(CATALOG_REVIEW_STATUS_READY) & ")) AS " & FIELD_CATALOG_REVIEW_STATUS & ", "
    sqlText = sqlText & "IIf(Len(Nz(r." & SQL_FIELD_RESOLVED_SETUP_ACTION & ",''))=0,'Missing resolved setup action',IIf(r." & SQL_FIELD_RESOLVED_NAV_PANE_VISIBILITY_POLICY & "=" & SharedDao_SqlQuote(ADCAT_NAV_POLICY_ADD_TO_CONFIGURED_GROUP) & " And r.[" & FIELD_CATEGORY_CODE & "]<>" & SharedDao_SqlQuote(ADCAT_CATEGORY_SYSTEM_MACRO) & " And Len(Nz(r." & SQL_FIELD_RESOLVED_NAVIGATION_PANE_GROUP_SETTING_KEY & ",''))=0,'Missing Navigation Pane group setting key','')) AS " & FIELD_CATALOG_REVIEW_MESSAGE & " "
    sqlText = sqlText & "FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_ManagedObjectsResolved") & "] AS r "
    sqlText = sqlText & "ORDER BY " & OrderByPolicyText("CATALOG_MANAGED_REVIEW") & ";"
    ManagedObjectCatalogReviewSql = sqlText
End Function

