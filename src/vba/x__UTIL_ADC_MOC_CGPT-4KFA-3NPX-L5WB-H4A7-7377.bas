'   detailText (Output; String): Receives human-readable proof/currentness details on success or the reason the persisted field-description proof is not current on handled failure.
'   publishSameRunProof (Input Optional; Boolean): Boolean state describing whether publish same run proof applies to this invocation; True selects the named condition/path and False selects its
'   complementary/default path. Default: True.
' Returns: Boolean: True when managed table field descriptions persisted proof matches the state required by the current setup/build contract; False when repair or refresh is still required.
Public Function ManagedTableFieldDescriptionsPersistedProofCurrent(ByRef exactToken As String, ByRef detailText As String, Optional ByVal publishSameRunProof As Boolean = True) As Boolean
    ' Wrapper purpose: MOC-owned facade for the normal persisted field-description proof against the current complete Catalog token.
    ' Why retained: Retained to bind the generalized proof core to the normal scope, hide its extra scope argument, and keep proof ownership in CATALOG.
    ' MOC-owned strict lightweight proof: verifies persisted field-description evidence against the current complete Catalog token.
    ManagedTableFieldDescriptionsPersistedProofCurrent = ManagedTableFieldDescriptionsPersistedProofCurrentCore(exactToken, detailText, publishSameRunProof, vbNullString)
End Function

' Purpose: Performs managed table field descriptions persisted proof current for build repair help document macros by coordinating `StrComp` and `ManagedTableFieldDescriptionsPersistedProofCurrentCore` while
'     preserving this module's existing validation and error semantics.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   exactToken (Output; String): Receives the resolved exact token produced from this procedure's validated inputs and current ADC state.
'   detailText (Output; String): Receives diagnostic detail text used to explain validation, lookup, recovery, or failure results to the caller.
' Returns: Boolean: True when the condition represented by ManagedTableFieldDescriptionsPersistedProofCurrentForBuildRepairHelpDocumentMacros is present under the routine's documented inputs/current state;
'   False when that condition is absent.
Public Function ManagedTableFieldDescriptionsPersistedProofCurrentForBuildRepairHelpDocumentMacros(ByRef exactToken As String, ByRef detailText As String) As Boolean
    ' Build/Repair Help Document Macros scoped predecessor proof: after Catalog has proven that only Help_Docs row content may differ, verify unchanged field-description evidence against that proven persisted D4
    ' predecessor token rather than the intentionally stale current complete token.
    On Error GoTo ErrHandler
    exactToken = vbNullString
    detailText = vbNullString
    If mBuildRepairHelpDocumentMacrosCatalogPredecessorScopeActive = False Then Err.Raise vbObjectError + 6741, "ManagedTableFieldDescriptionsPersistedProofCurrentForBuildRepairHelpDocumentMacros", "The Build/Repair Help Document Macros Catalog predecessor proof scope is not active."
    If StrComp(mBuildRepairHelpDocumentMacrosCatalogPredecessorTraceRunID, CatalogSetupTraceIdentity(), vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 6742, "ManagedTableFieldDescriptionsPersistedProofCurrentForBuildRepairHelpDocumentMacros", "The Build/Repair Help Document Macros Catalog predecessor proof scope belongs to a different trace run."
    If mBuildRepairHelpDocumentMacrosCatalogScopedProofCurrent = False Or Len(mBuildRepairHelpDocumentMacrosCatalogPredecessorPersistedValidationToken) = 0 Then Err.Raise vbObjectError + 6743, "ManagedTableFieldDescriptionsPersistedProofCurrentForBuildRepairHelpDocumentMacros", "The scoped Catalog predecessor proof has not established a persisted D4 binding token."
    If ManagedTableFieldDescriptionsPersistedProofCurrentCore(exactToken, detailText, False, mBuildRepairHelpDocumentMacrosCatalogPredecessorPersistedValidationToken) = False Then Exit Function
    detailText = detailText & vbCrLf & "Catalog binding=proven persisted D4 predecessor token; current Help_Docs row-content drift is intentionally excluded only by the preceding scoped Catalog proof."
    ManagedTableFieldDescriptionsPersistedProofCurrentForBuildRepairHelpDocumentMacros = True
    Exit Function
ErrHandler:
    If IsCancellationError(Err.Number) Then Err.Raise Err.Number, Err.Source, Err.Description
    exactToken = vbNullString
    detailText = "Build/Repair Help Document Macros managed-table field-description predecessor proof is not current. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
    ManagedTableFieldDescriptionsPersistedProofCurrentForBuildRepairHelpDocumentMacros = False
End Function

Private Function ManagedTableFieldDescriptionsPersistedProofCurrentCore(ByRef exactToken As String, ByRef detailText As String, ByVal publishSameRunProof As Boolean, ByVal catalogBindingToken As String) As Boolean
    ' MOC-owned persisted proof: keeps the zero-field fast path when per-table headers match, and on header drift performs targeted read-only physical verification before rebinding proof metadata. A real
    ' field-description defect still fails closed.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim tdf As DAO.tableDef
    Dim sqlText As String
    Dim tableName As String
    Dim proofPropertyName As String
    Dim proofHeader As String
    Dim storedProof As String
    Dim canonicalFieldOrderText As String
    Dim currentCatalogToken As String
    Dim storedCatalogToken As String
    Dim storedPhysicalToken As String
    Dim storedExactToken As String
    Dim priorExactToken As String
    Dim propertyExists As Boolean
    Dim fieldCount As Long
    Dim tableCount As Long
    Dim optionalAbsentCount As Long
    Dim proofMetadataRefreshCount As Long
    Dim state As CatalogHashState
    Dim priorState As CatalogHashState
    Dim optionalReason As String
    Dim activeTraceRunID As String
    Dim verifiedProof As Variant
    Dim proofReused As Variant
    Dim targetedFieldsInspected As Variant
    Dim targetedDescriptionsAlreadyCorrect As Variant
    Dim proofRefreshes As Object
    Dim proofRefreshPropertyName As Variant
    Dim descriptionShortIndex As Object
    exactToken = vbNullString
    detailText = vbNullString
    Set db = ResolveCatalogDb()
    Set descriptionShortIndex = BuildManagedTableFieldDescriptionShortIndex(db)
    Set proofRefreshes = CreateObject("Scripting.Dictionary")
    proofRefreshes.CompareMode = vbTextCompare
    InitializeFieldDescriptionProofCache
    CatalogHashInitialize state
    CatalogHashAppendText state, MANAGED_TABLE_FIELD_DESCRIPTION_PROOF_AGGREGATE_VERSION & "|"
    CatalogHashInitialize priorState
    CatalogHashAppendText priorState, MANAGED_TABLE_FIELD_DESCRIPTION_PROOF_AGGREGATE_VERSION & "|"
    sqlText = "SELECT DISTINCT " & SQL_FIELD_OBJECT_NAME & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] WHERE Nz([" & FIELD_MANAGED_OBJECT_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))='TABLE' ORDER BY " & SQL_FIELD_OBJECT_NAME & ";"
    Set rs = db.OpenRecordset(sqlText, dbOpenSnapshot)
    Do While rs.EOF = False
        tableName = CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString))
        If Len(Trim$(tableName)) > 0 Then
            tableCount = tableCount + 1
            If SharedDao_DatabaseTableExistsSafe(db, tableName) = False Then
                optionalReason = ManagedTableOptionalMissingReason(db, tableName)
                If Len(optionalReason) = 0 Then Err.Raise vbObjectError + 6730, "ManagedTableFieldDescriptionsPersistedProofCurrent", "A required active managed table is missing." & vbCrLf & "Table: " & tableName
                optionalAbsentCount = optionalAbsentCount + 1
                CatalogHashAppendText priorState, FingerprintTokenPart(tableName)
                CatalogHashAppendText priorState, FingerprintTokenPart("OptionalAbsent:" & optionalReason)
                CatalogHashAppendText state, FingerprintTokenPart(tableName)
                CatalogHashAppendText state, FingerprintTokenPart("OptionalAbsent:" & optionalReason)
            Else
                Set tdf = db.TableDefs(tableName)
                fieldCount = 0
                canonicalFieldOrderText = vbNullString
                proofHeader = FieldDescriptionProofText(tdf, descriptionShortIndex, fieldCount, canonicalFieldOrderText)
                proofPropertyName = FieldDescriptionProofPropertyName(tdf.Name)
                If mFieldDescriptionProofCache.Exists(proofPropertyName) = False Then Err.Raise vbObjectError + 6731, "ManagedTableFieldDescriptionsPersistedProofCurrent", "A persisted per-table field-description proof is missing." & vbCrLf & "Table: " & tableName
                storedProof = CStr(mFieldDescriptionProofCache(proofPropertyName))
                CatalogHashAppendText priorState, FingerprintTokenPart(tableName)
                CatalogHashAppendText priorState, FingerprintTokenPart(storedProof)
                If FieldDescriptionProofMatchesHeader(storedProof, proofHeader) = False Then
                    verifiedProof = vbNullString
                    proofReused = False
                    EnsureCatalogFieldDescriptions tableName, descriptionShortIndex, fieldsInspected:=targetedFieldsInspected, descriptionsAlreadyCorrect:=targetedDescriptionsAlreadyCorrect, verifiedProof:=verifiedProof, proofReused:=proofReused, readOnlyVerify:=True
                    If Len(CStr(verifiedProof)) = 0 Then Err.Raise vbObjectError + 6840, "ManagedTableFieldDescriptionsPersistedProofCurrent", "A stale per-table field-description proof header could not be revalidated read-only." & vbCrLf & "Table: " & tableName
                    storedProof = CStr(verifiedProof)
                    proofRefreshes(proofPropertyName) = storedProof
                    proofMetadataRefreshCount = proofMetadataRefreshCount + 1
                End If
                CatalogHashAppendText state, FingerprintTokenPart(tableName)
                CatalogHashAppendText state, FingerprintTokenPart(storedProof)
            End If
        End If
        If tableCount = 1 Or tableCount Mod 25 = 0 Then RequireSafeWorkContinue "ManagedTableFieldDescriptionsPersistedProofCurrent", "Table [" & tableName & "]"
        rs.MoveNext
    Loop
    rs.Close
    Set rs = Nothing
    tableName = DB_TABLE_USYS_RIBBONS
    tableCount = tableCount + 1
    Set tdf = db.TableDefs(tableName)
    fieldCount = 0
    canonicalFieldOrderText = vbNullString
    proofHeader = FieldDescriptionProofText(tdf, descriptionShortIndex, fieldCount, canonicalFieldOrderText)
    proofPropertyName = FieldDescriptionProofPropertyName(tdf.Name)
    If mFieldDescriptionProofCache.Exists(proofPropertyName) = False Then Err.Raise vbObjectError + 6731, "ManagedTableFieldDescriptionsPersistedProofCurrent", "A persisted per-table field-description proof is missing." & vbCrLf & "Table: " & tableName
    storedProof = CStr(mFieldDescriptionProofCache(proofPropertyName))
    CatalogHashAppendText priorState, FingerprintTokenPart(tableName)
    CatalogHashAppendText priorState, FingerprintTokenPart(storedProof)
    If FieldDescriptionProofMatchesHeader(storedProof, proofHeader) = False Then
        verifiedProof = vbNullString
        proofReused = False
        EnsureCatalogFieldDescriptions tableName, descriptionShortIndex, fieldsInspected:=targetedFieldsInspected, descriptionsAlreadyCorrect:=targetedDescriptionsAlreadyCorrect, verifiedProof:=verifiedProof, proofReused:=proofReused, readOnlyVerify:=True
        If Len(CStr(verifiedProof)) = 0 Then Err.Raise vbObjectError + 6841, "ManagedTableFieldDescriptionsPersistedProofCurrent", "The stale USysRibbons field-description proof header could not be revalidated read-only."
        storedProof = CStr(verifiedProof)
        proofRefreshes(proofPropertyName) = storedProof
        proofMetadataRefreshCount = proofMetadataRefreshCount + 1
    End If
    CatalogHashAppendText state, FingerprintTokenPart(tableName)
    CatalogHashAppendText state, FingerprintTokenPart(storedProof)
    priorExactToken = CatalogHashToken(priorState)
    exactToken = CatalogHashToken(state)
    If Len(catalogBindingToken) > 0 Then
        currentCatalogToken = catalogBindingToken
    Else
        currentCatalogToken = CurrentCatalogValidationToken()
    End If
    If Len(currentCatalogToken) = 0 Then Err.Raise vbObjectError + 6733, "ManagedTableFieldDescriptionsPersistedProofCurrent", "The required complete-catalog binding token is unavailable."
    storedCatalogToken = DatabaseTextPropertyValue(db, MANAGED_TABLE_FIELD_DESCRIPTION_CATALOG_TOKEN_PROPERTY, propertyExists)
    If propertyExists = False Or StrComp(storedCatalogToken, currentCatalogToken, vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 6734, "ManagedTableFieldDescriptionsPersistedProofCurrent", "The persisted managed-table field-description catalog proof is missing or stale."
    storedExactToken = DatabaseTextPropertyValue(db, MANAGED_TABLE_FIELD_DESCRIPTION_EXACT_TOKEN_PROPERTY, propertyExists)
    If propertyExists = False Or Len(storedExactToken) = 0 Or StrComp(storedExactToken, priorExactToken, vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 6735, "ManagedTableFieldDescriptionsPersistedProofCurrent", "The persisted managed-table field-description exact proof is missing, stale, or internally inconsistent with the persisted per-table proofs."
    storedPhysicalToken = DatabaseTextPropertyValue(db, MANAGED_TABLE_FIELD_DESCRIPTION_PHYSICAL_TOKEN_PROPERTY, propertyExists)
    If propertyExists = False Or StrComp(storedPhysicalToken, MANAGED_TABLE_FIELD_DESCRIPTION_PROOF_AGGREGATE_VERSION & "|" & priorExactToken, vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 6736, "ManagedTableFieldDescriptionsPersistedProofCurrent", "The persisted managed-table field-description physical proof is missing, stale, or internally inconsistent with the persisted per-table proofs."
    If proofMetadataRefreshCount > 0 Then
        For Each proofRefreshPropertyName In proofRefreshes.keys
            Call EnsureDaoPropertyValue(db, CStr(proofRefreshPropertyName), dbText, CStr(proofRefreshes(proofRefreshPropertyName)), "ManagedTableFieldDescriptionsPersistedProofCurrent")
            mFieldDescriptionProofCache(CStr(proofRefreshPropertyName)) = CStr(proofRefreshes(proofRefreshPropertyName))
        Next proofRefreshPropertyName
        Call EnsureDaoPropertyValue(db, MANAGED_TABLE_FIELD_DESCRIPTION_EXACT_TOKEN_PROPERTY, dbText, exactToken, "ManagedTableFieldDescriptionsPersistedProofCurrent")
        Call EnsureDaoPropertyValue(db, MANAGED_TABLE_FIELD_DESCRIPTION_PHYSICAL_TOKEN_PROPERTY, dbText, MANAGED_TABLE_FIELD_DESCRIPTION_PROOF_AGGREGATE_VERSION & "|" & exactToken, "ManagedTableFieldDescriptionsPersistedProofCurrent")
    End If
    activeTraceRunID = GetActiveTraceRunID()
    If publishSameRunProof And Len(activeTraceRunID) > 0 Then
        mManagedTableFieldDescriptionToken = exactToken
        mManagedTableFieldDescriptionTokenTraceRunID = activeTraceRunID
    End If
    detailText = "Managed-table field descriptions=current through persisted per-table proof headers and aggregate proof; tables=" & CStr(tableCount) & "; optional absent=" & CStr(optionalAbsentCount) & "; targeted stale-header revalidations=" & CStr(proofMetadataRefreshCount) & "; fields physically inspected=" & CStr(CLng(Nz(targetedFieldsInspected, 0))) & "; proof metadata rebound=" & CStr(proofMetadataRefreshCount > 0) & "."
    ManagedTableFieldDescriptionsPersistedProofCurrentCore = True
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    If IsCancellationError(savedErrNumber) Then Err.Raise savedErrNumber, savedErrSource, savedErrDescription
    exactToken = vbNullString
    detailText = "Persisted managed-table field-description proof is not current. Error " & CStr(savedErrNumber) & " from " & savedErrSource & ": " & savedErrDescription
    ManagedTableFieldDescriptionsPersistedProofCurrentCore = False
End Function

' Purpose: Performs rebind managed table field description proof after help document macro build repair by coordinating `TraceRunActive` and `CatalogSetupTraceIdentity` while preserving this module's existing
'     validation and error semantics.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   provenExactToken (Input; String): Proof/version token identifying the exact proven exact state that was previously validated in this setup run.
'   authoritativeCatalogToken (Input; String): Proof/version token identifying the exact authoritative catalog state that was previously validated in this setup run.
'   authoritativeCatalogTraceRunID (Input; String): Trace-run ID identifying the authoritative catalog proof whose exact-state token must be accepted by the dependent operation.
'   detailText (Output; String): Receives diagnostic detail text used to explain validation, lookup, recovery, or failure results to the caller.
' Returns: Boolean: True on the function's affirmative/success branch for rebind managed table field description proof after help document macro build repair; False on its explicit negative, unavailable, rejected,
'     or handled-failure branch.
'   cancellation, rejection, or not-applicable path.
Public Function RebindManagedTableFieldDescriptionProofAfterHelpDocumentMacroBuildRepair(ByVal provenExactToken As String, ByVal authoritativeCatalogToken As String, ByVal authoritativeCatalogTraceRunID As String, ByRef detailText As String) As Boolean
    ' MOC-owned proof advance for Build/Repair Help Document Macros: the operation does not mutate managed-table field descriptions, so the previously proven exact physical aggregate is rebound to the
    ' already-proven trace-bound complete-catalog token without reopening tables/fields or independently recalculating Catalog state.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim storedExactToken As String
    Dim storedPhysicalToken As String
    Dim storedCatalogToken As String
    Dim propertyExists As Boolean
    Dim activeTraceRunID As String
    provenExactToken = Trim$(provenExactToken)
    authoritativeCatalogToken = Trim$(authoritativeCatalogToken)
    authoritativeCatalogTraceRunID = Trim$(authoritativeCatalogTraceRunID)
    detailText = vbNullString
    If Len(provenExactToken) = 0 Then Err.Raise vbObjectError + 6737, "RebindManagedTableFieldDescriptionProofAfterHelpDocumentMacroBuildRepair", "The previously proven field-description exact token is blank."
    If Len(authoritativeCatalogToken) = 0 Then Err.Raise vbObjectError + 6830, "RebindManagedTableFieldDescriptionProofAfterHelpDocumentMacroBuildRepair", "The authoritative same-run complete-catalog token is blank."
    If TraceRunActive() = False Then Err.Raise vbObjectError + 6831, "RebindManagedTableFieldDescriptionProofAfterHelpDocumentMacroBuildRepair", "No active trace run exists for the authoritative complete-catalog token."
    activeTraceRunID = CatalogSetupTraceIdentity()
    If Len(authoritativeCatalogTraceRunID) = 0 Or StrComp(authoritativeCatalogTraceRunID, activeTraceRunID, vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 6832, "RebindManagedTableFieldDescriptionProofAfterHelpDocumentMacroBuildRepair", "The authoritative complete-catalog token does not belong to the active Build/Repair Help Document Macros trace run."
    Set db = ResolveCatalogDb()
    storedExactToken = DatabaseTextPropertyValue(db, MANAGED_TABLE_FIELD_DESCRIPTION_EXACT_TOKEN_PROPERTY, propertyExists)
    If propertyExists = False Or StrComp(storedExactToken, provenExactToken, vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 6738, "RebindManagedTableFieldDescriptionProofAfterHelpDocumentMacroBuildRepair", "The persisted field-description exact token no longer matches the pre-refresh proven token."
    storedPhysicalToken = DatabaseTextPropertyValue(db, MANAGED_TABLE_FIELD_DESCRIPTION_PHYSICAL_TOKEN_PROPERTY, propertyExists)
    If propertyExists = False Or StrComp(storedPhysicalToken, MANAGED_TABLE_FIELD_DESCRIPTION_PROOF_AGGREGATE_VERSION & "|" & provenExactToken, vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 6739, "RebindManagedTableFieldDescriptionProofAfterHelpDocumentMacroBuildRepair", "The persisted field-description physical aggregate no longer matches the pre-refresh proven token."
    storedCatalogToken = DatabaseTextPropertyValue(db, CATALOG_VALIDATION_TOKEN_PROPERTY, propertyExists)
    If propertyExists = False Or Len(storedCatalogToken) = 0 Or StrComp(storedCatalogToken, authoritativeCatalogToken, vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 6833, "RebindManagedTableFieldDescriptionProofAfterHelpDocumentMacroBuildRepair", "MOC's persisted complete-catalog token does not match the authoritative same-run token supplied for the field-proof rebind."
    Call EnsureDaoPropertyValue(db, MANAGED_TABLE_FIELD_DESCRIPTION_CATALOG_TOKEN_PROPERTY, dbText, authoritativeCatalogToken, "RebindManagedTableFieldDescriptionProofAfterHelpDocumentMacroBuildRepair")
    mManagedTableFieldDescriptionToken = provenExactToken
    mManagedTableFieldDescriptionTokenTraceRunID = activeTraceRunID
    detailText = "Managed-table field-description proof rebound to MOC's already-proven same-run complete-catalog token from the pre-refresh exact physical aggregate; tables physically inspected=0; fields physically inspected=0; complete-catalog recalculations=0."
    RebindManagedTableFieldDescriptionProofAfterHelpDocumentMacroBuildRepair = True
    Exit Function
ErrHandler:
    If IsCancellationError(Err.Number) Then Err.Raise Err.Number, Err.Source, Err.Description
    detailText = "Managed-table field-description proof could not be rebound after Build/Repair Help Document Macros. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
    RebindManagedTableFieldDescriptionProofAfterHelpDocumentMacroBuildRepair = False
End Function

' Purpose: Checks whether managed table field descriptions already satisfies the exact state required by the current Setup run so the owning phase can determine whether repair is necessary.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   exactToken (Output; String): Receives the resolved exact token produced from this procedure's validated inputs and current ADC state.
'   detailText (Output; String): Receives diagnostic detail text used to explain validation, lookup, recovery, or failure results to the caller.
' Returns: Boolean: True when managed table field descriptions matches the exact state required by the current Setup contract; False when the owning phase still needs repair, refresh, or reconciliation.
Public Function ManagedTableFieldDescriptionsCurrentForSetup(ByRef exactToken As String, ByRef detailText As String) As Boolean
    ' Read-only successor proof. Reuses G1's exact same-run field-description proof before any persisted or physical fallback.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim activeTraceRunID As String
    Dim rs As DAO.Recordset
    Dim sqlText As String
    Dim tableName As String
    Dim proofText As Variant
    Dim optionalReason As String
    Dim state As CatalogHashState
    Dim currentCatalogToken As String
    Dim storedCatalogToken As String
    Dim storedPhysicalToken As String
    Dim storedExactToken As String
    Dim catalogProofExists As Boolean
    Dim exactProofExists As Boolean
    Dim physicalProofExists As Boolean
    Dim tableCount As Long
    Dim optionalAbsentCount As Long
    Dim proofReused As Variant
    Dim proofsReused As Long
    Dim physicalProofFallbacks As Long
    Dim descriptionShortIndex As Object
    exactToken = vbNullString
    detailText = vbNullString
    activeTraceRunID = GetActiveTraceRunID()
    If Len(activeTraceRunID) > 0 And StrComp(mManagedTableFieldDescriptionTokenTraceRunID, activeTraceRunID, vbBinaryCompare) = 0 And Len(mManagedTableFieldDescriptionToken) > 0 Then
        exactToken = mManagedTableFieldDescriptionToken
        detailText = "Managed-table field descriptions=current through same-run G1 exact proof; per-table physical proof traversal=False."
        ManagedTableFieldDescriptionsCurrentForSetup = True
        Exit Function
    End If
    Set db = ResolveCatalogDb()
    storedCatalogToken = DatabaseTextPropertyValue(db, MANAGED_TABLE_FIELD_DESCRIPTION_CATALOG_TOKEN_PROPERTY, catalogProofExists)
    storedExactToken = DatabaseTextPropertyValue(db, MANAGED_TABLE_FIELD_DESCRIPTION_EXACT_TOKEN_PROPERTY, exactProofExists)
    storedPhysicalToken = DatabaseTextPropertyValue(db, MANAGED_TABLE_FIELD_DESCRIPTION_PHYSICAL_TOKEN_PROPERTY, physicalProofExists)
    If catalogProofExists = False Or Len(storedCatalogToken) = 0 Or exactProofExists = False Or Len(storedExactToken) = 0 Or physicalProofExists = False Or Len(storedPhysicalToken) = 0 Then
        detailText = "Managed-table field descriptions are not current for Part F because required persisted G1 proof is unavailable; catalog/physical field-description traversal skipped."
        Exit Function
    End If
    currentCatalogToken = CurrentCatalogValidationToken()
    Set descriptionShortIndex = BuildManagedTableFieldDescriptionShortIndex(db)
    CatalogHashInitialize state
    CatalogHashAppendText state, MANAGED_TABLE_FIELD_DESCRIPTION_PROOF_AGGREGATE_VERSION & "|"
    sqlText = "SELECT DISTINCT " & SQL_FIELD_OBJECT_NAME & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] WHERE Nz([" & FIELD_MANAGED_OBJECT_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))='TABLE' ORDER BY " & SQL_FIELD_OBJECT_NAME & ";"
    Set rs = db.OpenRecordset(sqlText, dbOpenSnapshot)
    Do While rs.EOF = False
        tableName = CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString))
        If Len(Trim$(tableName)) > 0 Then
            tableCount = tableCount + 1
            If SharedDao_DatabaseTableExistsSafe(db, tableName) = False Then
                optionalReason = ManagedTableOptionalMissingReason(db, tableName)
                If Len(optionalReason) = 0 Then Err.Raise vbObjectError + 6712, "ManagedTableFieldDescriptionsCurrentForSetup", "A required active managed table is missing." & vbCrLf & "Table: " & tableName
                optionalAbsentCount = optionalAbsentCount + 1
                CatalogHashAppendText state, FingerprintTokenPart(tableName)
                CatalogHashAppendText state, FingerprintTokenPart("OptionalAbsent:" & optionalReason)
            Else
                proofText = vbNullString
                proofReused = False
                EnsureCatalogFieldDescriptions tableName, descriptionShortIndex, verifiedProof:=proofText, proofReused:=proofReused, readOnlyVerify:=True
                If CBool(Nz(proofReused, False)) Then proofsReused = proofsReused + 1 Else physicalProofFallbacks = physicalProofFallbacks + 1
                If Len(CStr(proofText)) = 0 Then Err.Raise vbObjectError + 6713, "ManagedTableFieldDescriptionsCurrentForSetup", "A managed table did not produce a read-only verified field-description proof." & vbCrLf & "Table: " & tableName
                CatalogHashAppendText state, FingerprintTokenPart(tableName)
                CatalogHashAppendText state, FingerprintTokenPart(CStr(proofText))
            End If
        End If
        RequireSafeWorkContinue "ManagedTableFieldDescriptionsCurrentForSetup", "Table [" & tableName & "]"
        rs.MoveNext
    Loop
    rs.Close
    Set rs = Nothing
    exactToken = CatalogHashToken(state)
    If StrComp(storedCatalogToken, currentCatalogToken, vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 6714, "ManagedTableFieldDescriptionsCurrentForSetup", "The persisted G1 managed-table field-description catalog proof is stale."
    If StrComp(storedExactToken, exactToken, vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 6715, "ManagedTableFieldDescriptionsCurrentForSetup", "The persisted G1 managed-table field-description exact proof is stale."
    If StrComp(storedPhysicalToken, MANAGED_TABLE_FIELD_DESCRIPTION_PROOF_AGGREGATE_VERSION & "|" & exactToken, vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 6716, "ManagedTableFieldDescriptionsCurrentForSetup", "The persisted G1 managed-table field-description physical proof is stale."
    detailText = "Managed-table field descriptions=current; tables=" & CStr(tableCount) & "; optional absent=" & CStr(optionalAbsentCount) & "; persisted per-table proofs reused=" & CStr(proofsReused) & "; physical proof fallbacks=" & CStr(physicalProofFallbacks) & "."
    ManagedTableFieldDescriptionsCurrentForSetup = True
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    If IsCancellationError(savedErrNumber) Then Err.Raise savedErrNumber, savedErrSource, savedErrDescription
    exactToken = vbNullString
    detailText = "Managed-table field descriptions are not current for Part F. Error " & CStr(savedErrNumber) & " from " & savedErrSource & ": " & savedErrDescription
    ManagedTableFieldDescriptionsCurrentForSetup = False
End Function


' Purpose: Resolves and returns managed table field description post commit token from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   physicalChangeCount (Output Optional; Variant): When supplied, receives 0 when an existing same-run token can be reused or the verified number of physical field-description changes applied while establishing
'     a token.
' Returns: String: Returns the exact post-commit managed-table field-description proof token. A nonblank token means the current persisted/physical Description state was verified; an error is raised if an exact
'   token cannot be established.
Public Function ManagedTableFieldDescriptionPostCommitToken(Optional ByRef physicalChangeCount As Variant) As String
    On Error GoTo ErrHandler
    Dim activeTraceRunID As String
    Dim verifiedPhysicalChangeCount As Variant
    If Not isMissing(physicalChangeCount) Then physicalChangeCount = CLng(0)
    activeTraceRunID = GetActiveTraceRunID()
    If Len(activeTraceRunID) > 0 And StrComp(mManagedTableFieldDescriptionTokenTraceRunID, activeTraceRunID, vbBinaryCompare) = 0 And Len(mManagedTableFieldDescriptionToken) > 0 Then
        ManagedTableFieldDescriptionPostCommitToken = mManagedTableFieldDescriptionToken
        Exit Function
    End If
    verifiedPhysicalChangeCount = CLng(0)
    EnsureAllManagedTableFieldDescriptions False, verifiedPhysicalChangeCount
    If Not isMissing(physicalChangeCount) Then physicalChangeCount = CLng(Nz(verifiedPhysicalChangeCount, 0))
    If Len(mManagedTableFieldDescriptionToken) = 0 Then Err.Raise vbObjectError + 6709, "ManagedTableFieldDescriptionPostCommitToken", "Managed-table field-description proof verification completed without producing an exact token."
    ManagedTableFieldDescriptionPostCommitToken = mManagedTableFieldDescriptionToken
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrDescription = Err.Description
    Err.Raise savedErrNumber, "ManagedTableFieldDescriptionPostCommitToken", "Could not apply and verify managed-table field descriptions in the single G1 table pass. " & savedErrDescription
End Function

Private Sub EnsureAllManagedTableFieldDescriptions(Optional ByVal showMessage As Boolean = False, Optional ByRef physicalChangeCount As Variant)
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim sqlText As String
    Dim tableName As String
    Dim tableCount As Long
    Dim optionalAbsentCount As Long
    Dim tablesReused As Long
    Dim tablesPhysicallyInspected As Long
    Dim sameRunBypassStartCount As Long
    Dim sameRunFieldsStartCount As Long
    Dim descriptionsInspected As Variant
    Dim descriptionsAlreadyCorrect As Variant
    Dim descriptionsCreated As Variant
    Dim descriptionsRepaired As Variant
    Dim proofText As Variant
    Dim proofReused As Variant
    Dim activeTraceRunID As String
    Dim state As CatalogHashState
    Dim verifiedToken As String
    Dim optionalReason As String
    Dim verifiedPhysicalChangeCount As Long
    Dim descriptionShortIndex As Object
    If Not isMissing(physicalChangeCount) Then physicalChangeCount = CLng(0)
    Set db = ResolveCatalogDb()
    Set descriptionShortIndex = BuildManagedTableFieldDescriptionShortIndex(db)
    InitializeFieldDescriptionSameRunProofMap
    sameRunBypassStartCount = mFieldDescriptionSameRunProofBypassCount
    sameRunFieldsStartCount = mFieldDescriptionSameRunFieldsBypassed
    InitializeFieldDescriptionProofCache
    CatalogHashInitialize state
    CatalogHashAppendText state, MANAGED_TABLE_FIELD_DESCRIPTION_PROOF_AGGREGATE_VERSION & "|"
    sqlText = "SELECT DISTINCT " & SQL_FIELD_OBJECT_NAME & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] WHERE Nz([" & FIELD_MANAGED_OBJECT_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))='TABLE' ORDER BY " & SQL_FIELD_OBJECT_NAME & ";"
    Set rs = db.OpenRecordset(sqlText, dbOpenSnapshot)
    Do While rs.EOF = False
        tableName = CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString))
        If Len(Trim$(tableName)) > 0 Then
            tableCount = tableCount + 1
            If SharedDao_DatabaseTableExistsSafe(db, tableName) = False Then
                optionalReason = ManagedTableOptionalMissingReason(db, tableName)
                If Len(optionalReason) = 0 Then Err.Raise vbObjectError + 6705, "EnsureAllManagedTableFieldDescriptions", "A required active managed table is missing." & vbCrLf & "Table: " & tableName
                optionalAbsentCount = optionalAbsentCount + 1
                CatalogHashAppendText state, FingerprintTokenPart(tableName)
                CatalogHashAppendText state, FingerprintTokenPart("OptionalAbsent:" & optionalReason)
            Else
                proofText = vbNullString
                proofReused = False
                EnsureCatalogFieldDescriptions tableName, descriptionShortIndex, descriptionsInspected, descriptionsAlreadyCorrect, descriptionsCreated, descriptionsRepaired, proofText, proofReused
                If CBool(proofReused) Then
                    tablesReused = tablesReused + 1
                Else
                    tablesPhysicallyInspected = tablesPhysicallyInspected + 1
                End If
                If Len(CStr(proofText)) = 0 Then Err.Raise vbObjectError + 6678, "EnsureAllManagedTableFieldDescriptions", "A managed table did not produce a verified description proof." & vbCrLf & "Table: " & tableName
                CatalogHashAppendText state, FingerprintTokenPart(tableName)
                CatalogHashAppendText state, FingerprintTokenPart(CStr(proofText))
            End If
        End If
        RequireSafeWorkContinue "EnsureAllManagedTableFieldDescriptions", "Table [" & tableName & "]"
        rs.MoveNext
    Loop
    rs.Close
    Set rs = Nothing
    tableName = DB_TABLE_USYS_RIBBONS
    tableCount = tableCount + 1
    proofText = vbNullString
    proofReused = False
    EnsureCatalogFieldDescriptions tableName, descriptionShortIndex, descriptionsInspected, descriptionsAlreadyCorrect, descriptionsCreated, descriptionsRepaired, proofText, proofReused
    If CBool(proofReused) Then tablesReused = tablesReused + 1 Else tablesPhysicallyInspected = tablesPhysicallyInspected + 1
    CatalogHashAppendText state, FingerprintTokenPart(tableName)
    CatalogHashAppendText state, FingerprintTokenPart(CStr(proofText))
    activeTraceRunID = GetActiveTraceRunID()
    verifiedToken = CatalogHashToken(state)
    verifiedPhysicalChangeCount = CLng(Nz(descriptionsCreated, 0)) + CLng(Nz(descriptionsRepaired, 0))
    If Not isMissing(physicalChangeCount) Then physicalChangeCount = verifiedPhysicalChangeCount
    If verifiedPhysicalChangeCount > 0 Then CatalogMarkSetupDomainsDirty CATALOG_DIRTY_SCHEMA
    PersistManagedTableFieldDescriptionExactState db, CurrentCatalogValidationToken(), verifiedToken
    mManagedTableFieldDescriptionToken = verifiedToken
    mManagedTableFieldDescriptionTokenTraceRunID = activeTraceRunID
    LogTraceMessage _
        TRACE_LEVEL_INFO, _
        "FieldDescriptions", _
        "EnsureAllManagedTableFieldDescriptions", _
        "Managed-table field descriptions verified through reusable per-table proofs.", _
        "Managed tables considered: " & CStr(tableCount) & vbCrLf & _
            "Proofs reused: " & CStr(tablesReused) & vbCrLf & _
            "Same-run table opens bypassed: " & CStr(mFieldDescriptionSameRunProofBypassCount - sameRunBypassStartCount) & vbCrLf & _
            "Fields bypassed by same-run proof: " & CStr(mFieldDescriptionSameRunFieldsBypassed - sameRunFieldsStartCount) & vbCrLf & _
            "Tables physically inspected: " & CStr(tablesPhysicallyInspected) & vbCrLf & _
            "Optional absent tables: " & CStr(optionalAbsentCount) & vbCrLf & _
            "Fields physically inspected: " & CStr(CLng(Nz(descriptionsInspected, 0))) & vbCrLf & _
            "Descriptions already correct: " & CStr(CLng(Nz(descriptionsAlreadyCorrect, 0))) & vbCrLf & _
            "Descriptions created: " & CStr(CLng(Nz(descriptionsCreated, 0))) & vbCrLf & _
            "Descriptions repaired: " & CStr(CLng(Nz(descriptionsRepaired, 0))), _
        "Repair and verify managed-table field descriptions", _
        0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "Table", "CodeDb", "FieldDescriptions"
    If showMessage Then _
        ReportCoreActionSuccess _
            "EnsureAllManagedTableFieldDescriptions", _
            ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), _
            "Managed-table field descriptions verified.", _
            "Managed tables considered: " & CStr(tableCount) & vbCrLf & _
                "Proofs reused: " & CStr(tablesReused) & vbCrLf & _
                "Same-run table opens bypassed: " & CStr(mFieldDescriptionSameRunProofBypassCount - sameRunBypassStartCount) & vbCrLf & _
                "Fields bypassed by same-run proof: " & CStr(mFieldDescriptionSameRunFieldsBypassed - sameRunFieldsStartCount) & vbCrLf & _
                "Tables physically inspected: " & CStr(tablesPhysicallyInspected) & vbCrLf & _
                "Fields physically inspected: " & CStr(CLng(Nz(descriptionsInspected, 0))) & vbCrLf & _
                "Created: " & CStr(CLng(Nz(descriptionsCreated, 0))) & vbCrLf & _
                "Repaired: " & CStr(CLng(Nz(descriptionsRepaired, 0))), _
            "Repair and verify managed-table field descriptions", _
            ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "Table", "CodeDb", "FieldDescriptions", True, _
            DEFAULT_UTILITY_LONG_NAME & " Field Descriptions"
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    If IsCancellationError(savedErrNumber) Then
        If showMessage Then Exit Sub
        Err.Raise savedErrNumber, savedErrSource, savedErrDescription
    End If
    On Error Resume Next
    LogTraceMessage TRACE_LEVEL_ERROR, "FieldDescriptions", "EnsureAllManagedTableFieldDescriptions", "Managed-table field description repair or verification failed.", "Last table: " & tableName & vbCrLf & "Err.Number: " & CStr(savedErrNumber) & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription, "Repair and verify managed-table field descriptions", savedErrNumber, savedErrSource, savedErrDescription, tableName, "Table", "CodeDb", "FieldDescriptions"
    On Error GoTo 0
    If showMessage Then
        CoreShowErrorMessage "Managed-table field description repair or verification failed." & vbCrLf & vbCrLf & "Last table: " & tableName & vbCrLf & "Err.Number: " & CStr(savedErrNumber) & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription, vbCritical, "Managed Table Field Descriptions", "EnsureAllManagedTableFieldDescriptions", "Tables"
        Exit Sub
    End If
    Err.Raise savedErrNumber, "EnsureAllManagedTableFieldDescriptions", savedErrDescription
End Sub


Private Sub CaptureManagedObjectDefinition(ByVal objectName As String, ByVal categoryCode As String, ByVal objectTypeCode As String, ByVal descriptionText As String, ByVal SortOrder As Long, ByVal ribbonTabKey As String, ByVal ribbonTabLabel As String, ByVal ribbonGroupLabel As String, ByVal ribbonGroupSortOrder As Long, ByVal ribbonTitle As String, ByVal ribbonStaticTag As String)
    Dim keyText As String
    Dim namingCategory As String
    Dim logicalObjectName As String
    Dim definitionData As Variant
    Dim existingData As Variant
    Dim signatureText As String
    Dim timerValue As Single
    timerValue = Timer
    If Len(Trim$(categoryCode)) > 0 Then
        If mManagedDefinitionCategorySnapshot Is Nothing Then Err.Raise vbObjectError + 9528, "CaptureManagedObjectDefinition", "The setup-scoped category snapshot is unavailable while building the B3 definition plan."
        If mManagedDefinitionCategorySnapshot.Exists(Trim$(categoryCode)) = False Then Err.Raise vbObjectError + 9529, "CaptureManagedObjectDefinition", "An authoritative B3 definition references a category that is absent from the setup snapshot." & vbCrLf & "CategoryCode: " & categoryCode & vbCrLf & "Object: " & objectName
    End If
    namingCategory = ManagedObjectNamingCategory(objectTypeCode, categoryCode, objectName)
    If Len(namingCategory) > 0 Then logicalObjectName = LogicalObjectNameFromPhysicalName(namingCategory, objectName)
    mManagedDefinitionNamingResolutionElapsedSeconds = mManagedDefinitionNamingResolutionElapsedSeconds + ElapsedSecondsFromTimer(timerValue)
    keyText = ManagedDefinitionStableIdentityKey(logicalObjectName, namingCategory, objectTypeCode, objectName)
    definitionData = Array(mManagedDefinitionCaptureFamily, objectName, Trim$(categoryCode), Trim$(objectTypeCode), descriptionText, SortOrder, ribbonTabKey, ribbonTabLabel, ribbonGroupLabel, ribbonGroupSortOrder, ribbonTitle, Trim$(logicalObjectName), Trim$(namingCategory), Trim$(ribbonStaticTag), vbNullString)
    signatureText = ManagedDefinitionDefinitionSignature(Array(definitionData(MANAGED_DEFINITION_OBJECT_FAMILY), definitionData(MANAGED_DEFINITION_OBJECT_NAME), definitionData(MANAGED_DEFINITION_OBJECT_CATEGORY), definitionData(MANAGED_DEFINITION_OBJECT_TYPE), definitionData(MANAGED_DEFINITION_OBJECT_DESCRIPTION), definitionData(MANAGED_DEFINITION_OBJECT_SORT_ORDER), definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_TAB_KEY), definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_TAB_LABEL), definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_GROUP), definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_ORDER), definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_TITLE), definitionData(MANAGED_DEFINITION_OBJECT_LOGICAL_NAME), definitionData(MANAGED_DEFINITION_OBJECT_NAMING_CATEGORY), definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_STATIC_TAG)))
    definitionData(MANAGED_DEFINITION_OBJECT_SIGNATURE) = signatureText
    If mManagedDefinitionObjectPlan.Exists(keyText) Then
        existingData = mManagedDefinitionObjectPlan(keyText)
        If StrComp(CStr(existingData(MANAGED_DEFINITION_OBJECT_SIGNATURE)), signatureText, vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 9520, "CaptureManagedObjectDefinition", "Two authoritative B3 definitions use the same stable identity with different values." & vbCrLf & "Stable identity: " & keyText & vbCrLf & "First object: " & CStr(existingData(MANAGED_DEFINITION_OBJECT_NAME)) & vbCrLf & "Second object: " & objectName
        Exit Sub
    End If
    mManagedDefinitionObjectPlan.Add keyText, definitionData
    mManagedDefinitionObjectOrder.Add keyText
    If mManagedDefinitionObjectPhysicalIndex.Exists(objectName) Then
        If StrComp(CStr(mManagedDefinitionObjectPhysicalIndex(objectName)), keyText, vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 9521, "CaptureManagedObjectDefinition", "One physical B3 object name resolves to multiple stable identities." & vbCrLf & "Object: " & objectName
    Else
        mManagedDefinitionObjectPhysicalIndex.Add objectName, keyText
    End If
End Sub

' Purpose: Repairs core managed object definitions for setup.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   showMessage (Input Optional; Boolean): Controls whether the routine displays its normal user-facing status, completion, warning, or error message; False suppresses that presentation while preserving the
'   underlying operation. Default: False.
'   detailsForMessage (Output Optional; String): Receives detail text formatted for inclusion in the caller's user-facing message. Default: vbNullString.
'   namingInputsChanged (Output Optional; Boolean): Set True when the procedure determines that naming inputs changed applies; set False when that condition is not met. Default: False.
' Returns: Boolean: True on the function's affirmative/success branch for repair core managed object definitions for setup; False on its explicit negative, unavailable, rejected, or handled-failure branch.
'   not-applicable path.
Public Function RepairCoreManagedObjectDefinitionsForSetup(Optional ByVal showMessage As Boolean = False, Optional ByRef detailsForMessage As String = vbNullString, Optional ByRef namingInputsChanged As Boolean = False) As Boolean
    RequireSetupDomainMutationAllowed SETUP_DOMAIN_B3_NONFORM_MANAGED_DEFINITIONS, "RepairCoreManagedObjectDefinitionsForSetup"
    'Uses the normalized Part 11 definition set, one loaded current-state snapshot, and a dirty-object delta before any write transaction is opened.
    On Error GoTo ErrHandler
    Dim phaseTimer As Single
    Dim retiredRows As Long
    Dim executionDetail As String
    Dim managedMutationCountBefore As Long
    namingInputsChanged = False
    PrepareManagedDefinitionSplitForSetup
    RequireManagedDefinitionSplitPhase 0, "RepairCoreManagedObjectDefinitionsForSetup"
    phaseTimer = Timer
    managedMutationCountBefore = mManagedDefinitionBatchManagedInserted + mManagedDefinitionBatchManagedUpdated
    If mManagedDefinitionSplitCoreRequired Then
        retiredRows = RetireNoncanonicalSystemDefaultManagedTableRowsForSetup()
        retiredRows = retiredRows + RetireObsoleteGeneratedLookupQueryManagedRowsForSetup()
        ExecuteCoreManagedDefinitionDelta executionDetail
    Else
        executionDetail = "B3 exact in-memory delta was empty; matched definitions did not enter database defaulting and no write transaction was opened."
    End If
    namingInputsChanged = (retiredRows > 0 Or (mManagedDefinitionBatchManagedInserted + mManagedDefinitionBatchManagedUpdated) > managedMutationCountBefore)
    mManagedDefinitionSplitPhase = MANAGED_DEFINITION_PHASE_CORE
    detailsForMessage = IIf(mManagedDefinitionSplitCoreRequired, "Core managed-object definitions delta path evaluated", "Core managed-object definitions exact fast path used")
    detailsForMessage = detailsForMessage & vbCrLf & "Noncanonical/obsolete ADC-owned managed-object metadata rows retired: " & CStr(retiredRows)
    detailsForMessage = detailsForMessage & vbCrLf & executionDetail
    detailsForMessage = detailsForMessage & vbCrLf & ManagedDefinitionPart11TimingText()
    detailsForMessage = detailsForMessage & vbCrLf & "B3 total: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(phaseTimer))
    LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "RepairCoreManagedObjectDefinitionsForSetup", "Core managed-object definitions phase completed.", detailsForMessage, "Core managed-object definitions", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitionsCore", "CodeDb", "ManagedObjectCatalog"
    LogCatalogSetupSubstageTiming "RepairCoreManagedObjectDefinitionsForSetup", "Setup B3 managed-definition delta", detailsForMessage
    If showMessage Then CoreShowMessage detailsForMessage, vbInformation, "Managed Object Catalog", "ShowADCMessage", "Tables"
    RepairCoreManagedObjectDefinitionsForSetup = True
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number: savedErrSource = Err.Source: savedErrDescription = Err.Description
    AbortManagedDefinitionSplit
    detailsForMessage = "Core managed-object definitions phase failed." & vbCrLf & "Err.Number: " & CStr(savedErrNumber) & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
    LogTraceMessage TRACE_LEVEL_ERROR, "ManagedObjectCatalog", "RepairCoreManagedObjectDefinitionsForSetup", "Core managed-object definitions phase failed.", detailsForMessage, "Core managed-object definitions", savedErrNumber, savedErrSource, savedErrDescription, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "ManagedObjectDefinitionsCore", "CodeDb", "ManagedObjectCatalog"
    If showMessage Then CoreShowErrorMessage detailsForMessage, vbCritical, "Managed Object Catalog", "RepairCoreManagedObjectDefinitionsForSetup", "Tables": Exit Function
    Err.Raise savedErrNumber, "RepairCoreManagedObjectDefinitionsForSetup", detailsForMessage
End Function

Private Sub EvaluateAddInReviewManagedObjectDefinition(ByVal db As DAO.Database, ByVal definitionData As Variant, ByVal requirePlacement As Boolean, ByRef evaluation As TAddInReviewManagedObjectEvaluation)
    Dim rs As DAO.Recordset
    Dim sqlText As String
    Dim expectedName As String
    Dim expectedType As String
    Dim expectedLogical As String
    Dim expectedNamingCategory As String
    Dim rowID As Long
    Dim rowName As String
    Dim rowType As String
    Dim rowStatus As String
    Dim rowLogical As String
    Dim rowNamingCategory As String
    Dim rowSummary As String
    Dim rowIsActive As Boolean
    Dim selectedName As String
    Dim selectedType As String
    Dim selectedLogical As String
    Dim selectedNamingCategory As String
    Dim selectedCategory As String
    Dim selectedOwner As String
    Dim selectedNav As String
    Dim selectedNavPolicy As String
    Dim selectedTabKey As String
    Dim selectedTabLabel As String
    Dim selectedGroup As String
    Dim selectedGroupOrder As Long
    Dim selectedSortOrder As Long
    ResetAddInReviewManagedObjectEvaluation evaluation
    expectedName = CStr(definitionData(ADD_IN_REVIEW_DEF_OBJECT_NAME))
    expectedType = CStr(definitionData(ADD_IN_REVIEW_DEF_OBJECT_TYPE))
    expectedLogical = CStr(definitionData(ADD_IN_REVIEW_DEF_LOGICAL_IDENTITY))
    expectedNamingCategory = ManagedObjectNamingCategory(CStr(definitionData(ADD_IN_REVIEW_DEF_OBJECT_TYPE)), CStr(definitionData(ADD_IN_REVIEW_DEF_CATEGORY)), CStr(definitionData(ADD_IN_REVIEW_DEF_OBJECT_NAME)))
    sqlText = "SELECT " & SQL_FIELD_ID & "," & SQL_FIELD_OBJECT_NAME & ",[" & FIELD_LOGICAL_OBJECT_NAME & "],[" & FIELD_OBJECT_NAMING_CATEGORY & "]," & SQL_FIELD_OBJECT_TYPE & ",[" & FIELD_CATEGORY_CODE & "],[" & FIELD_MANAGED_OBJECT_STATUS & "],[" & FIELD_CATALOG_OWNER & "]," & SQL_FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER & ",[" & FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY & "],[" & FIELD_RIBBON_TAB_KEY & "],[" & FIELD_RIBBON_TAB_LABEL & "],[" & FIELD_RIBBON_GROUP_LABEL & "],[" & FIELD_RIBBON_GROUP_SORT_ORDER & "]," & SQL_FIELD_RIBBON_TITLE & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] WHERE UCase(Nz(" & SQL_FIELD_OBJECT_NAME & ",''))=" & SharedDao_SqlQuote(UCase$(expectedName)) & " OR (UCase(Trim(Nz([" & _
        FIELD_LOGICAL_OBJECT_NAME & "],'')))=" & SharedDao_SqlQuote(UCase$(expectedLogical)) & " AND UCase(Trim(Nz([" & FIELD_OBJECT_NAMING_CATEGORY & "],'')))=" & SharedDao_SqlQuote(UCase$(expectedNamingCategory)) & ") ORDER BY " & SQL_FIELD_ID & ";"
    Set rs = db.OpenRecordset(sqlText, dbOpenSnapshot)
    Do While Not rs.EOF
        PumpSetupResponsiveness
        evaluation.RowsFound = evaluation.RowsFound + 1
        rowID = CLng(Nz(rs.fields(FIELD_ID).value, 0))
        rowName = CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString))
        rowType = Trim$(CStr(Nz(rs.fields(FIELD_OBJECT_TYPE).value, vbNullString)))
        rowStatus = Trim$(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_STATUS).value, ADCAT_STATUS_ACTIVE)))
        rowLogical = Trim$(CStr(Nz(rs.fields(FIELD_LOGICAL_OBJECT_NAME).value, vbNullString)))
        rowNamingCategory = Trim$(CStr(Nz(rs.fields(FIELD_OBJECT_NAMING_CATEGORY).value, vbNullString)))
        rowIsActive = (StrComp(rowStatus, ADCAT_STATUS_ACTIVE, vbTextCompare) = 0)
        If rowIsActive Then
            evaluation.ActiveRowsFound = evaluation.ActiveRowsFound + 1
            evaluation.selectedRowID = rowID
        ElseIf evaluation.selectedRowID = 0 Then
            evaluation.selectedRowID = rowID
        End If
        If rowIsActive Or evaluation.ActiveRowsFound = 0 Then
            selectedName = rowName
            selectedType = rowType
            selectedLogical = rowLogical
            selectedNamingCategory = rowNamingCategory
            selectedCategory = Trim$(CStr(Nz(rs.fields(FIELD_CATEGORY_CODE).value, vbNullString)))
            selectedOwner = Trim$(CStr(Nz(rs.fields(FIELD_CATALOG_OWNER).value, vbNullString)))
            selectedSortOrder = CLng(Nz(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value, 0))
            selectedNav = Trim$(CStr(Nz(rs.fields(FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY).value, vbNullString)))
            selectedNavPolicy = Trim$(ManagedObjectOverrideTextValue(rowID, FIELD_NAV_PANE_VISIBILITY_POLICY_OVERRIDE))
            selectedTabKey = Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_TAB_KEY).value, vbNullString)))
            selectedTabLabel = Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_TAB_LABEL).value, vbNullString)))
            selectedGroup = Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_GROUP_LABEL).value, vbNullString)))
            selectedGroupOrder = CLng(Nz(rs.fields(FIELD_RIBBON_GROUP_SORT_ORDER).value, 0))
        End If
        If Len(evaluation.ExistingRowIDs) > 0 Then evaluation.ExistingRowIDs = evaluation.ExistingRowIDs & ","
        evaluation.ExistingRowIDs = evaluation.ExistingRowIDs & CStr(rowID)
        rowSummary = "ID=" & CStr(rowID) & "; Name=" & IIf(Len(rowName) = 0, "(blank)", rowName) & "; Type=" & IIf(Len(rowType) = 0, "(blank)", rowType) & "; Status=" & IIf(Len(rowStatus) = 0, "(blank)", rowStatus) & "; LogicalIdentity=" & IIf(Len(rowLogical) = 0, "(blank)", rowLogical) & "; NamingCategory=" & IIf(Len(rowNamingCategory) = 0, "(blank)", rowNamingCategory) & "; Category=" & Trim$(CStr(Nz(rs.fields(FIELD_CATEGORY_CODE).value, vbNullString))) & "; Owner=" & Trim$(CStr(Nz(rs.fields(FIELD_CATALOG_OWNER).value, vbNullString)))
        evaluation.ExistingRowSummary = SharedText_AppendNonBlankLine(evaluation.ExistingRowSummary, rowSummary)
        rs.MoveNext
    Loop
    rs.Close
    Set rs = Nothing
    evaluation.IdentityMatches = (evaluation.ActiveRowsFound = 1 And StrComp(selectedName, expectedName, vbTextCompare) = 0 And StrComp(selectedType, expectedType, vbTextCompare) = 0 And StrComp(selectedLogical, expectedLogical, vbTextCompare) = 0 And StrComp(selectedNamingCategory, expectedNamingCategory, vbTextCompare) = 0 And StrComp(selectedCategory, CStr(definitionData(ADD_IN_REVIEW_DEF_CATEGORY)), vbTextCompare) = 0 And StrComp(selectedOwner, CStr(definitionData(ADD_IN_REVIEW_DEF_OWNER)), vbTextCompare) = 0 And selectedSortOrder = CLng(definitionData(ADD_IN_REVIEW_DEF_SORT_ORDER)))
    evaluation.placementMatches = (evaluation.IdentityMatches And StrComp(selectedNav, CStr(definitionData(ADD_IN_REVIEW_DEF_NAV_SETTING)), vbTextCompare) = 0 And StrComp(selectedNavPolicy, ADCAT_NAV_POLICY_ADD_TO_CONFIGURED_GROUP, vbTextCompare) = 0 And StrComp(selectedTabKey, CStr(definitionData(ADD_IN_REVIEW_DEF_RIBBON_TAB_KEY)), vbTextCompare) = 0 And StrComp(selectedTabLabel, CStr(definitionData(ADD_IN_REVIEW_DEF_RIBBON_TAB_LABEL)), vbTextCompare) = 0 And StrComp(selectedGroup, CStr(definitionData(ADD_IN_REVIEW_DEF_RIBBON_GROUP)), vbTextCompare) = 0 And selectedGroupOrder = CLng(definitionData(ADD_IN_REVIEW_DEF_RIBBON_ORDER)))
    If evaluation.ActiveRowsFound > 1 Then
        evaluation.classification = ADD_IN_REVIEW_MATCH_DUPLICATE_ACTIVE
    ElseIf evaluation.RowsFound = 0 Then
        evaluation.classification = ADD_IN_REVIEW_MATCH_MISSING
    ElseIf evaluation.ActiveRowsFound = 0 Then
        If evaluation.RowsFound = 1 Then evaluation.classification = ADD_IN_REVIEW_MATCH_INACTIVE Else evaluation.classification = ADD_IN_REVIEW_MATCH_KEY_MISMATCH
    ElseIf StrComp(selectedName, expectedName, vbTextCompare) <> 0 Then
        evaluation.classification = ADD_IN_REVIEW_MATCH_NAME_MISMATCH
    ElseIf StrComp(selectedType, expectedType, vbTextCompare) <> 0 Then
        evaluation.classification = ADD_IN_REVIEW_MATCH_TYPE_MISMATCH
    ElseIf StrComp(selectedLogical, expectedLogical, vbTextCompare) <> 0 Or StrComp(selectedNamingCategory, expectedNamingCategory, vbTextCompare) <> 0 Or StrComp(selectedCategory, CStr(definitionData(ADD_IN_REVIEW_DEF_CATEGORY)), vbTextCompare) <> 0 Or StrComp(selectedOwner, CStr(definitionData(ADD_IN_REVIEW_DEF_OWNER)), vbTextCompare) <> 0 Or selectedSortOrder <> CLng(definitionData(ADD_IN_REVIEW_DEF_SORT_ORDER)) Then
        evaluation.classification = ADD_IN_REVIEW_MATCH_KEY_MISMATCH
    ElseIf requirePlacement And evaluation.placementMatches = False Then
        evaluation.classification = ADD_IN_REVIEW_MATCH_PLACEMENT_MISMATCH
    Else
        evaluation.classification = ADD_IN_REVIEW_MATCH_EXACT
    End If
End Sub

Private Sub CaptureManagedActionPayloadDefinition(ByVal objectName As String, ByVal payloadKind As String, ByVal actionProcedureName As String, ByVal runCodeWrapperName As String, ByVal macroDescription As String, ByVal payloadVersion As String, ByVal SortOrder As Long)
    Dim objectKey As String
    Dim payloadKey As String
    Dim definitionData As Variant
    Dim existingData As Variant
    Dim signatureText As String
    If mManagedDefinitionObjectPhysicalIndex.Exists(objectName) = False Then Err.Raise vbObjectError + 9522, "CaptureManagedActionPayloadDefinition", "An authoritative B3 action payload has no captured managed-object definition." & vbCrLf & "Object: " & objectName & vbCrLf & "PayloadKind: " & payloadKind
    objectKey = CStr(mManagedDefinitionObjectPhysicalIndex(objectName))
    payloadKey = ManagedDefinitionPayloadPlanKey(objectKey, payloadKind)
    definitionData = Array(mManagedDefinitionCaptureFamily, objectName, Trim$(payloadKind), Trim$(actionProcedureName), Trim$(runCodeWrapperName), macroDescription, Trim$(payloadVersion), SortOrder, objectKey, vbNullString)
    signatureText = ManagedDefinitionDefinitionSignature(Array(definitionData(MANAGED_DEFINITION_PAYLOAD_FAMILY), definitionData(MANAGED_DEFINITION_PAYLOAD_OBJECT_NAME), definitionData(MANAGED_DEFINITION_PAYLOAD_KIND), definitionData(MANAGED_DEFINITION_PAYLOAD_ACTION), definitionData(MANAGED_DEFINITION_PAYLOAD_WRAPPER), definitionData(MANAGED_DEFINITION_PAYLOAD_DESCRIPTION), definitionData(MANAGED_DEFINITION_PAYLOAD_VERSION), definitionData(MANAGED_DEFINITION_PAYLOAD_SORT_ORDER), objectKey))
    definitionData(MANAGED_DEFINITION_PAYLOAD_SIGNATURE) = signatureText
    If mManagedDefinitionPayloadPlan.Exists(payloadKey) Then
        existingData = mManagedDefinitionPayloadPlan(payloadKey)
        If StrComp(CStr(existingData(MANAGED_DEFINITION_PAYLOAD_SIGNATURE)), signatureText, vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 9523, "CaptureManagedActionPayloadDefinition", "Two authoritative B3 payload definitions use the same stable identity with different values." & vbCrLf & "Payload identity: " & payloadKey
        Exit Sub
    End If
    mManagedDefinitionPayloadPlan.Add payloadKey, definitionData
    mManagedDefinitionPayloadOrder.Add payloadKey
End Sub

Private Sub ApplyActionPayloadDefaultDefinitions(ByVal definitions As Collection, ByVal repairDefaultRows As Boolean)
    Dim rowData As Variant
    For Each rowData In definitions
        PumpSetupResponsiveness
        DefaultActionPayloadForObject CStr(rowData(0)), CStr(rowData(1)), CStr(rowData(2)), CStr(rowData(3)), CStr(rowData(4)), CStr(rowData(5)), CLng(rowData(6)), repairDefaultRows
    Next rowData
End Sub

Private Sub DefaultModuleUpdateGuardManagedObjectRows(ByVal repairDefaultRows As Boolean)
    Dim definitions As Collection
    Set definitions = ModuleGuardManagedObjectDefinitions()
    ApplyManagedObjectDefaultDefinitions definitions, repairDefaultRows
    ApplyActionPayloadDefaultDefinitions ModuleGuardActionPayloadDefinitions(definitions), repairDefaultRows
End Sub

Private Sub ApplyCorePayloadDeltaFromPlan()
    Dim keyValue As Variant
    Dim definitionData As Variant
    Dim deltaData As Variant
    Dim dirtyCount As Long
    Dim dirtyIndex As Long
    dirtyCount = mManagedDefinitionPayloadInsertCount + mManagedDefinitionPayloadUpdateCount
    For Each keyValue In mManagedDefinitionPayloadOrder
        deltaData = mManagedDefinitionPayloadDelta(CStr(keyValue))
        If StrComp(CStr(deltaData(0)), MANAGED_DEFINITION_STATUS_MATCHED, vbBinaryCompare) <> 0 Then
            dirtyIndex = dirtyIndex + 1
            definitionData = mManagedDefinitionPayloadPlan(CStr(keyValue))
            PulseProgressEvery dirtyIndex, 10, "B3 applying captured action payload " & CStr(dirtyIndex) & " of " & CStr(dirtyCount) & ": [" & CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_OBJECT_NAME)) & "].", dirtyCount, "CatalogB3PayloadDelta", "Catalog"
            DefaultActionPayloadForObject CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_OBJECT_NAME)), CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_KIND)), CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_ACTION)), CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_WRAPPER)), CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_DESCRIPTION)), CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_VERSION)), CLng(definitionData(MANAGED_DEFINITION_PAYLOAD_SORT_ORDER)), True
        End If
    Next keyValue
End Sub

Private Sub ClearManagedDefinitionReferenceSnapshots()
    Set mManagedDefinitionCategorySnapshot = Nothing
    Set mManagedDefinitionNamingSnapshot = Nothing
    Set mManagedDefinitionNavigationGroupSnapshot = Nothing
    Set mManagedDefinitionSnapshotFallbackCounts = Nothing
    mManagedDefinitionReferenceSnapshotsReady = False
    mManagedDefinitionReferenceSnapshotTraceRunID = vbNullString
End Sub

Private Sub InitializeManagedDefinitionReferenceSnapshots(Optional ByVal forceRefresh As Boolean = False, Optional ByVal deferManagedObjectNamingSnapshot As Boolean = False)
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim traceID As String
    Dim categoryCode As String
    Dim objectName As String
    Dim objectTypeCode As String
    Dim physicalKey As String
    Dim navigationKey As String
    traceID = CatalogSetupTraceIdentity()
    If forceRefresh = False And mManagedDefinitionReferenceSnapshotsReady And StrComp(traceID, mManagedDefinitionReferenceSnapshotTraceRunID, vbBinaryCompare) = 0 Then
        If deferManagedObjectNamingSnapshot Then
            Set mManagedDefinitionNamingSnapshot = CreateObject("Scripting.Dictionary")
            mManagedDefinitionNamingSnapshot.CompareMode = vbBinaryCompare
            mManagedDefinitionReferenceSnapshotsReady = False
        End If
        Exit Sub
    End If
    Set mManagedDefinitionCategorySnapshot = CreateObject("Scripting.Dictionary"): mManagedDefinitionCategorySnapshot.CompareMode = vbTextCompare
    Set mManagedDefinitionNamingSnapshot = CreateObject("Scripting.Dictionary"): mManagedDefinitionNamingSnapshot.CompareMode = vbBinaryCompare
    Set mManagedDefinitionNavigationGroupSnapshot = CreateObject("Scripting.Dictionary"): mManagedDefinitionNavigationGroupSnapshot.CompareMode = vbTextCompare
    Set mManagedDefinitionSnapshotFallbackCounts = CreateObject("Scripting.Dictionary"): mManagedDefinitionSnapshotFallbackCounts.CompareMode = vbTextCompare
    Set db = ResolveCatalogDb()
    If SharedDao_DatabaseTableExistsSafe(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ObjectCategories")) Then
        Set rs = db.OpenRecordset("SELECT * FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ObjectCategories") & "] ORDER BY [" & FIELD_CATEGORY_CODE & "];", dbOpenSnapshot)
        Do While rs.EOF = False
            categoryCode = Trim$(CStr(Nz(rs.fields(FIELD_CATEGORY_CODE).value, vbNullString)))
            If Len(categoryCode) > 0 Then mManagedDefinitionCategorySnapshot(categoryCode) = RecordsetRowSignature(rs)
            rs.MoveNext
        Loop
        rs.Close
    End If
    If deferManagedObjectNamingSnapshot = False Then
        If SharedDao_DatabaseTableExistsSafe(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID)) Then
            Set rs = db.OpenRecordset("SELECT " & SQL_FIELD_OBJECT_NAME & "," & SQL_FIELD_OBJECT_TYPE & ",[" & FIELD_LOGICAL_OBJECT_NAME & "],[" & FIELD_OBJECT_NAMING_CATEGORY & "],[" & FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] ORDER BY " & SQL_FIELD_ID & ";", dbOpenSnapshot)
            Do While rs.EOF = False
                objectName = CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString))
                objectTypeCode = Trim$(CStr(Nz(rs.fields(FIELD_OBJECT_TYPE).value, vbNullString)))
                physicalKey = ManagedDefinitionManagedBookmarkKey(objectName, objectTypeCode)
                If Len(objectName) > 0 And Len(objectTypeCode) > 0 Then mManagedDefinitionNamingSnapshot(physicalKey) = Array(CStr(Nz(rs.fields(FIELD_LOGICAL_OBJECT_NAME).value, vbNullString)), CStr(Nz(rs.fields(FIELD_OBJECT_NAMING_CATEGORY).value, vbNullString)), CStr(Nz(rs.fields(FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY).value, vbNullString)))
                rs.MoveNext
            Loop
            rs.Close
        End If
    End If
    If SharedDao_DatabaseTableExistsSafe(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_NavigationPaneGroups")) Then
        Set rs = db.OpenRecordset("SELECT [" & FIELD_SETTING_KEY & "],[" & FIELD_NAVIGATION_PANE_GROUP_NAME & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_NavigationPaneGroups") & "] WHERE Nz(" & SQL_FIELD_LOOKUP_ACTIVE & ",True)<>False ORDER BY " & OrderByPolicyText("NAVIGATION_GROUP_SETTING_MATCH") & ";", dbOpenSnapshot)
        Do While rs.EOF = False
            navigationKey = Trim$(CStr(Nz(rs.fields(FIELD_SETTING_KEY).value, vbNullString)))
            If Len(navigationKey) > 0 And mManagedDefinitionNavigationGroupSnapshot.Exists(navigationKey) = False Then mManagedDefinitionNavigationGroupSnapshot.Add navigationKey, Trim$(CStr(Nz(rs.fields(FIELD_NAVIGATION_PANE_GROUP_NAME).value, vbNullString)))
            rs.MoveNext
        Loop
        rs.Close
    End If
    mManagedDefinitionReferenceSnapshotTraceRunID = traceID
    mManagedDefinitionReferenceSnapshotsReady = Not deferManagedObjectNamingSnapshot
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number: savedErrSource = Err.Source: savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    ClearManagedDefinitionReferenceSnapshots
    On Error GoTo 0
    Err.Raise savedErrNumber, "InitializeManagedDefinitionReferenceSnapshots", "Could not create the setup-scoped naming, category, and Navigation Pane snapshots." & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Sub

Private Function RecordsetRowSignature(ByVal rs As DAO.Recordset) As String
    Dim fld As DAO.Field
    Dim signatureText As String
    For Each fld In rs.fields
        signatureText = signatureText & LengthPrefixedVariant(fld.Name) & LengthPrefixedVariant(fld.value)
    Next fld
    RecordsetRowSignature = FingerprintFromPayload(signatureText)
End Function

Private Function NoncanonicalSystemDefaultManagedTableRowExists() As Boolean
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim definitionData As Variant
    Dim objectName As String
    Dim objectTypeCode As String
    Set db = ResolveCatalogDb()
    Set rs = db.OpenRecordset("SELECT " & SQL_FIELD_OBJECT_NAME & "," & SQL_FIELD_OBJECT_TYPE & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] WHERE Nz([" & FIELD_MANAGED_OBJECT_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))=" & SharedDao_SqlQuote(UCase$(ADCAT_OBJECT_TYPE_TABLE)) & " AND UCase(Trim(Nz([" & FIELD_CATALOG_OWNER & "],'')))=" & SharedDao_SqlQuote(UCase$(ADCAT_OWNER_SYSTEM_DEFAULT)) & " ORDER BY " & SQL_FIELD_ID & ";", dbOpenSnapshot)
    Do While rs.EOF = False
        objectName = CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString))
        objectTypeCode = Trim$(CStr(rs.fields(FIELD_OBJECT_TYPE).value))
        If TryGetManagedObjectDefinition(objectName, objectTypeCode, definitionData) = False Then
            NoncanonicalSystemDefaultManagedTableRowExists = True
            Exit Do
        End If
        rs.MoveNext
    Loop
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    Set rs = Nothing
    Set db = Nothing
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    Resume CleanRaise
CleanRaise:
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    Set rs = Nothing
    Set db = Nothing
    On Error GoTo 0
    Err.Raise savedErrNumber, IIf(Len(savedErrSource) > 0, savedErrSource, "NoncanonicalSystemDefaultManagedTableRowExists"), savedErrDescription
End Function

