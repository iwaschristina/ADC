End Sub

Private Function SystemRibbonGroupedPlacementSql() As String
    Dim sqlText As String
    sqlText = "SELECT Nz([" & FIELD_RIBBON_TAB_KEY & "],'') AS " & SQL_FIELD_TAB_KEY & ", Nz([" & FIELD_RIBBON_TAB_LABEL & "],'') AS " & SQL_FIELD_TAB_LABEL & ", "
    sqlText = sqlText & "Nz([" & FIELD_RIBBON_GROUP_LABEL & "],'') AS " & SQL_FIELD_GROUP_LABEL & ", Nz([" & FIELD_RIBBON_GROUP_SORT_ORDER & "],0) AS " & SQL_FIELD_GROUP_ORDER & ", Count(*) AS " & SQL_FIELD_ROW_COUNT & " "
    sqlText = sqlText & "FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] "
    sqlText = sqlText & "WHERE Nz([" & FIELD_MANAGED_OBJECT_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE)
    sqlText = sqlText & " AND UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))=" & SharedDao_SqlQuote(UCase$(ADCAT_OBJECT_TYPE_MACRO))
    sqlText = sqlText & " AND UCase(Trim(Nz([" & FIELD_CATEGORY_CODE & "],'')))=" & SharedDao_SqlQuote(UCase$(ADCAT_CATEGORY_SYSTEM_MACRO))
    sqlText = sqlText & " GROUP BY Nz([" & FIELD_RIBBON_TAB_KEY & "],''), Nz([" & FIELD_RIBBON_TAB_LABEL & "],''), Nz([" & FIELD_RIBBON_GROUP_LABEL & "],''), Nz([" & FIELD_RIBBON_GROUP_SORT_ORDER & "],0)"
    sqlText = sqlText & " ORDER BY " & OrderByPolicyText("CATALOG_SYSTEM_RIBBON_GROUPED") & ";"
    SystemRibbonGroupedPlacementSql = sqlText
End Function

' Purpose: Resolves and returns system ribbon group override diagnostic text from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   maxRows (Input Optional; Long): Upper bound limiting the max rows quantity scanned, displayed, or processed by this call. Default: 50.
' Returns: String: Returns formatted system ribbon group override diagnostic text text intended for tracing, diagnostics, or user-facing reporting; vbNullString is returned when there is nothing applicable to
'   report.
Public Function SystemRibbonGroupOverrideDiagnosticText(Optional ByVal maxRows As Long = 50) As String
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim sqlText As String
    Dim tabKey As String
    Dim tabLabel As String
    Dim groupLabel As String
    Dim groupOrder As Long
    Dim rowCount As Long
    Dim counts As Object
    Dim canonicalCounts As Object
    Dim groupDefinitions As Collection
    Dim systemMacroDefinitions As Collection
    Dim unexpectedCount As Long
    Dim groupedText As String
    If maxRows < 1 Then maxRows = 1
    Set groupDefinitions = GetSystemRibbonGroupDefinitions()
    Set systemMacroDefinitions = x__UTIL_ADC_DEFAULTS.GetSystemMacroDefinitions()
    Set canonicalCounts = SystemMacroCountsByRibbonGroupIdentity(systemMacroDefinitions)
    Set counts = NewSystemRibbonGroupCountMap(groupDefinitions)
    Set db = ResolveCatalogDb()
    sqlText = SystemRibbonGroupedPlacementSql()
    Set rs = db.OpenRecordset(sqlText, dbOpenSnapshot)
    Do While rs.EOF = False
        PumpSetupResponsiveness
        tabKey = Trim$(CStr(rs.fields(FIELD_TAB_KEY).value))
        tabLabel = Trim$(CStr(rs.fields(FIELD_TAB_LABEL).value))
        groupLabel = Trim$(CStr(rs.fields(FIELD_GROUP_LABEL).value))
        groupOrder = CLng(rs.fields(FIELD_GROUP_ORDER).value)
        rowCount = CLng(rs.fields(FIELD_ROW_COUNT).value)
        groupedText = groupedText & vbCrLf & " - TabKey=" & IIf(Len(tabKey) = 0, "(blank)", tabKey) & "; TabLabel=" & IIf(Len(tabLabel) = 0, "(blank)", tabLabel) & "; Group=" & IIf(Len(groupLabel) = 0, "(blank)", groupLabel) & "; Order=" & CStr(groupOrder) & "; Rows=" & CStr(rowCount)
        AccumulateSystemRibbonOverrideCount counts, unexpectedCount, tabKey, groupLabel, groupOrder, rowCount, groupDefinitions
        rs.MoveNext
    Loop
    rs.Close
    Set rs = Nothing
    SystemRibbonGroupOverrideDiagnosticText = "Canonical System Ribbon group counts:" & vbCrLf & SystemRibbonOverrideCountSummary(counts, unexpectedCount, groupDefinitions, canonicalCounts) & vbCrLf & vbCrLf & "Actual grouped placement rows:" & IIf(Len(groupedText) = 0, vbCrLf & " - (none)", groupedText) & vbCrLf & vbCrLf & "Individual active System Macro and Help Document Macro rows:" & vbCrLf & SystemRibbonOverrideRowDiagnostics(maxRows)
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    SystemRibbonGroupOverrideDiagnosticText = DEFAULT_UTILITY_SHORT_NAME & " System Ribbon diagnostic snapshot failed. Error " & CStr(savedErrNumber) & " from " & savedErrSource & ": " & savedErrDescription & vbCrLf & "Last SQL: " & sqlText
End Function

Private Sub ValidateSystemRibbonGroupOverrides(ByRef ValidationSummary As String, ByVal systemMacroTitleMap As Object, Optional ByVal suppliedSystemMacroDefinitions As Variant)
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim Definition As Variant
    Dim systemMacroDefinition As Variant
    Dim tabKey As String
    Dim tabLabel As String
    Dim groupLabel As String
    Dim groupOrder As Long
    Dim rowCount As Long
    Dim sqlText As String
    Dim counts As Object
    Dim canonicalCounts As Object
    Dim groupDefinitionIndex As Object
    Dim groupDefinitions As Collection
    Dim systemMacroDefinitions As Collection
    Dim unexpectedCount As Long
    Dim actualLayoutText As String
    Dim rowDiagnosticText As String
    Dim failureText As String
    Dim groupIdentity As String
    Dim expectedStaticCount As Long
    Dim actualGroupCount As Long
    Dim systemMacroKey As String
    Set groupDefinitions = GetSystemRibbonGroupDefinitions()
    Set groupDefinitionIndex = SystemRibbonGroupDefinitionIndex(groupDefinitions)
    If isMissing(suppliedSystemMacroDefinitions) = False Then
        If IsObject(suppliedSystemMacroDefinitions) Then Set systemMacroDefinitions = suppliedSystemMacroDefinitions
    End If
    If systemMacroDefinitions Is Nothing Then Set systemMacroDefinitions = x__UTIL_ADC_DEFAULTS.GetSystemMacroDefinitions()
    Set canonicalCounts = SystemMacroCountsByRibbonGroupIdentity(systemMacroDefinitions)
    Set counts = NewSystemRibbonGroupCountMap(groupDefinitions)
    Set db = ResolveCatalogDb()
    sqlText = SystemRibbonGroupedPlacementSql()
    Set rs = db.OpenRecordset(sqlText, dbOpenSnapshot)
    Do While rs.EOF = False
        PumpSetupResponsiveness
        tabKey = Trim$(CStr(rs.fields(FIELD_TAB_KEY).value))
        tabLabel = Trim$(CStr(rs.fields(FIELD_TAB_LABEL).value))
        groupLabel = Trim$(CStr(rs.fields(FIELD_GROUP_LABEL).value))
        groupOrder = CLng(rs.fields(FIELD_GROUP_ORDER).value)
        rowCount = CLng(rs.fields(FIELD_ROW_COUNT).value)
        actualLayoutText = actualLayoutText & vbCrLf & " - TabKey=" & IIf(Len(tabKey) = 0, "(blank)", tabKey) & "; TabLabel=" & IIf(Len(tabLabel) = 0, "(blank)", tabLabel) & "; Group=" & IIf(Len(groupLabel) = 0, "(blank)", groupLabel) & "; Order=" & CStr(groupOrder) & "; Rows=" & CStr(rowCount)
        AccumulateSystemRibbonOverrideCount counts, unexpectedCount, tabKey, groupLabel, groupOrder, rowCount, groupDefinitions
        rs.MoveNext
    Loop
    rs.Close
    Set rs = Nothing
    ValidationSummary = SystemRibbonOverrideCountSummary(counts, unexpectedCount, groupDefinitions, canonicalCounts)
    If unexpectedCount > 0 Then
        rowDiagnosticText = SystemRibbonOverrideRowDiagnostics(50)
        failureText = ValidationSummary & vbCrLf & vbCrLf & "Actual grouped placement rows:" & IIf(Len(actualLayoutText) = 0, vbCrLf & " - (none)", actualLayoutText) & vbCrLf & vbCrLf & "Individual active System Macro and Help Document Macro rows:" & vbCrLf & rowDiagnosticText
        Err.Raise vbObjectError + 9095, "ValidateSystemRibbonGroupOverrides", "Active managed System Macro and Help Document Macro rows remain outside the canonical System Ribbon group definitions." & vbCrLf & failureText
    End If
    For Each Definition In groupDefinitions
        groupIdentity = CStr(Definition(0))
        expectedStaticCount = 0
        If canonicalCounts.Exists(groupIdentity) Then expectedStaticCount = CLng(canonicalCounts(groupIdentity))
        actualGroupCount = SystemRibbonGroupCount(counts, groupIdentity)
        If expectedStaticCount > 0 And actualGroupCount = 0 Then
            rowDiagnosticText = SystemRibbonOverrideRowDiagnostics(50)
            failureText = ValidationSummary & vbCrLf & vbCrLf & "Actual grouped placement rows:" & IIf(Len(actualLayoutText) = 0, vbCrLf & " - (none)", actualLayoutText) & vbCrLf & vbCrLf & "Individual active System Macro and Help Document Macro rows:" & vbCrLf & rowDiagnosticText
            Err.Raise vbObjectError + 9096, "ValidateSystemRibbonGroupOverrides", "A canonical System Ribbon group with assigned System Macros has no active managed rows." & vbCrLf & "RibbonGroupIdentity: " & groupIdentity & vbCrLf & failureText
        End If
    Next Definition
    For Each systemMacroDefinition In systemMacroDefinitions
        systemMacroKey = CStr(systemMacroDefinition(0))
        ValidateRequiredSystemMacroPlacement db, systemMacroTitleMap, systemMacroKey, groupDefinitionIndex, systemMacroDefinition
    Next systemMacroDefinition
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    Err.Raise savedErrNumber, "ValidateSystemRibbonGroupOverrides", "Could not verify the canonical System Ribbon assignment." & vbCrLf & "Last tab: " & IIf(Len(tabKey) = 0, "(blank)", tabKey) & vbCrLf & "Last tab label: " & IIf(Len(tabLabel) = 0, "(blank)", tabLabel) & vbCrLf & "Last group: " & IIf(Len(groupLabel) = 0, "(blank)", groupLabel) & vbCrLf & "Last order: " & CStr(groupOrder) & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description:" & vbCrLf & savedErrDescription
End Sub

Private Function NewSystemRibbonGroupCountMap(ByVal groupDefinitions As Collection) As Object
    Dim counts As Object
    Dim Definition As Variant
    ' INTENTIONAL KEYED LOOKUP: counts provides keyed membership/lookup over source rows or state already read by NewSystemRibbonGroupCountMap; it is a derived access path, not a second authority.
    Set counts = CreateObject("Scripting.Dictionary")
    counts.CompareMode = vbTextCompare
    For Each Definition In groupDefinitions
        counts(CStr(Definition(0))) = CLng(0)
    Next Definition
    Set NewSystemRibbonGroupCountMap = counts
End Function

Private Function SystemRibbonGroupCount(ByVal counts As Object, ByVal groupIdentity As String) As Long
    If counts Is Nothing Then Exit Function
    If Len(groupIdentity) = 0 Then Exit Function
    If counts.Exists(groupIdentity) Then SystemRibbonGroupCount = CLng(counts(groupIdentity))
End Function

Private Sub AccumulateSystemRibbonOverrideCount(ByVal counts As Object, ByRef unexpectedCount As Long, ByVal tabKey As String, ByVal groupLabel As String, ByVal groupOrder As Long, ByVal rowCount As Long, ByVal groupDefinitions As Collection)
    Dim groupIdentity As String
    groupIdentity = SystemRibbonGroupIdentityForPlacement(tabKey, groupLabel, groupOrder, groupDefinitions)
    If Len(groupIdentity) = 0 Then
        unexpectedCount = unexpectedCount + rowCount
        Exit Sub
    End If
    If counts.Exists(groupIdentity) = False Then Err.Raise vbObjectError + 9097, "AccumulateSystemRibbonOverrideCount", "The canonical System Ribbon group count map is missing a defined group identity." & vbCrLf & "RibbonGroupIdentity: " & groupIdentity
    counts(groupIdentity) = CLng(counts(groupIdentity)) + rowCount
End Sub

Private Function SystemRibbonOverrideCountSummary(ByVal counts As Object, ByVal unexpectedCount As Long, ByVal groupDefinitions As Collection, ByVal canonicalCounts As Object) As String
    Dim Definition As Variant
    Dim groupIdentity As String
    Dim tabKey As String
    Dim tabLabel As String
    Dim groupLabel As String
    Dim groupOrder As Long
    Dim actualCount As Long
    Dim canonicalMacroCount As Long
    Dim summaryText As String
    For Each Definition In groupDefinitions
        groupIdentity = CStr(Definition(0))
        groupLabel = CStr(Definition(1))
        groupOrder = CLng(Definition(2))
        tabKey = CStr(Definition(3))
        tabLabel = GetRibbonTabLabelDefault(tabKey)
        actualCount = SystemRibbonGroupCount(counts, groupIdentity)
        canonicalMacroCount = 0
        If canonicalCounts.Exists(groupIdentity) Then canonicalMacroCount = CLng(canonicalCounts(groupIdentity))
        If Len(summaryText) > 0 Then summaryText = summaryText & vbCrLf
        summaryText = summaryText & tabLabel & " > " & groupLabel & " (" & CStr(groupOrder) & "): " & CStr(actualCount) & " managed rows; " & CStr(canonicalMacroCount) & " canonical System Macros"
    Next Definition
    If Len(summaryText) > 0 Then summaryText = summaryText & vbCrLf
    summaryText = summaryText & "Rows outside canonical System Ribbon tab/group/order combinations: " & CStr(unexpectedCount)
    SystemRibbonOverrideCountSummary = summaryText
End Function

Private Function SystemRibbonOverrideRowDiagnostics(Optional ByVal maxRows As Long = 50) As String
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim sqlText As String
    Dim detailText As String
    Dim rowText As String
    Dim objectText As String
    Dim ribbonTitleText As String
    Dim tabKeyText As String
    Dim tabLabelText As String
    Dim groupLabelText As String
    Dim lastRepairText As String
    Dim rowNumber As Long
    Dim totalRows As Long
    If maxRows < 1 Then maxRows = 1
    Set db = ResolveCatalogDb()
    sqlText = "SELECT " & SQL_FIELD_ID & ", " & SQL_FIELD_OBJECT_NAME & ", Nz(" & SQL_FIELD_RIBBON_TITLE & ",'') AS " & SQL_FIELD_RIBBON_TITLE_VALUE & ", Nz([" & FIELD_RIBBON_TAB_KEY & "],'') AS " & SQL_FIELD_TAB_KEY & ", Nz([" & FIELD_RIBBON_TAB_LABEL & "],'') AS " & SQL_FIELD_TAB_LABEL & ", Nz([" & FIELD_RIBBON_GROUP_LABEL & "],'') AS " & SQL_FIELD_GROUP_LABEL & ", Nz([" & FIELD_RIBBON_GROUP_SORT_ORDER & "],0) AS " & SQL_FIELD_GROUP_ORDER & ", [" & FIELD_LAST_DEFAULT_REPAIR_ON & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] WHERE Nz([" & FIELD_MANAGED_OBJECT_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))=" & SharedDao_SqlQuote(UCase$(ADCAT_OBJECT_TYPE_MACRO)) & " AND UCase(Trim(Nz([" & _
                FIELD_CATEGORY_CODE & "],'')))=" & _
        SharedDao_SqlQuote(UCase$(ADCAT_CATEGORY_SYSTEM_MACRO)) & " ORDER BY " & OrderByPolicyText("CATALOG_SYSTEM_RIBBON_DIAGNOSTIC") & ";"
    Set rs = db.OpenRecordset(sqlText, dbOpenSnapshot)
    Do While rs.EOF = False
        PumpSetupResponsiveness
        totalRows = totalRows + 1
        If rowNumber < maxRows Then
            rowNumber = rowNumber + 1
            objectText = Trim$(CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString)))
            ribbonTitleText = CStr(rs.fields(FIELD_RIBBON_TITLE_VALUE).value)
            tabKeyText = Trim$(CStr(rs.fields(FIELD_TAB_KEY).value))
            tabLabelText = Trim$(CStr(rs.fields(FIELD_TAB_LABEL).value))
            groupLabelText = Trim$(CStr(rs.fields(FIELD_GROUP_LABEL).value))
            If IsNull(rs.fields(FIELD_LAST_DEFAULT_REPAIR_ON).value) Then lastRepairText = "(null)" Else lastRepairText = CStr(rs.fields(FIELD_LAST_DEFAULT_REPAIR_ON).value)
            rowText = " - ID=" & CStr(Nz(rs.fields(FIELD_ID).value, 0)) & "; Object=" & IIf(Len(objectText) = 0, "(blank)", objectText)
            rowText = rowText & "; RibbonTitle=" & IIf(Len(ribbonTitleText) = 0, "(blank)", ribbonTitleText)
            rowText = rowText & "; TabKey=" & IIf(Len(tabKeyText) = 0, "(blank)", tabKeyText) & "; TabLabel=" & IIf(Len(tabLabelText) = 0, "(blank)", tabLabelText)
            rowText = rowText & "; Group=" & IIf(Len(groupLabelText) = 0, "(blank)", groupLabelText) & "; Order=" & CStr(rs.fields(FIELD_GROUP_ORDER).value) & "; LastDefaultRepairOn=" & lastRepairText
            detailText = detailText & IIf(Len(detailText) = 0, vbNullString, vbCrLf) & rowText
        End If
        rs.MoveNext
    Loop
    rs.Close
    If totalRows = 0 Then detailText = " - (none)"
    If totalRows > maxRows Then detailText = detailText & vbCrLf & " - Additional rows omitted: " & CStr(totalRows - maxRows)
    SystemRibbonOverrideRowDiagnostics = detailText
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    SystemRibbonOverrideRowDiagnostics = " - Row-level diagnostic query failed. Error " & CStr(savedErrNumber) & ": " & savedErrDescription & vbCrLf & " - SQL: " & sqlText
End Function

Private Function RibbonGroupsFormSql() As String
    Dim sqlText As String
    sqlText = "SELECT " & SQL_FIELD_ID & ", [" & FIELD_NAVIGATION_PANE_GROUP_KEY & "], [" & FIELD_NAVIGATION_PANE_GROUP_NAME & "], " & SQL_FIELD_GROUP_PURPOSE & ", " & SQL_FIELD_LOOKUP_ACTIVE & ", " & SQL_FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER & ", [" & FIELD_SHOW_ON_RIBBON & "], [" & FIELD_RIBBON_TAB_KEY & "], [" & FIELD_RIBBON_TAB_LABEL & "], [" & FIELD_RIBBON_GROUP_LABEL & "], [" & FIELD_RIBBON_GROUP_SORT_ORDER & "], [" & FIELD_RIBBON_GROUP_VISIBLE & "], [" & FIELD_OBJECT_TYPE_SCOPE & "], [" & FIELD_CONFIG_OWNER_DATABASE_ROLE & "], [" & FIELD_SETTING_KEY & "], [" & FIELD_CREATE_IF_MISSING & "], " & SQL_FIELD_GROUP_DESCRIPTION & ", " & SQL_FIELD_DEFAULT_SOURCE & ", [" & FIELD_DEFAULTED_ON & "], [" & FIELD_LAST_DEFAULT_REPAIR_ON & "], " & SQL_FIELD_MANAGED_OBJECT_DEPENDENCY_NOTES & " "
    sqlText = sqlText & "FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_NavigationPaneGroups") & "] ORDER BY " & OrderByPolicyText("CATALOG_RIBBON_GROUP") & ";"
    RibbonGroupsFormSql = sqlText
End Function

Private Function RibbonButtonTargetsReviewSql() As String
    RibbonButtonTargetsReviewSql = "SELECT DISTINCT " & SQL_FIELD_ID & ", " & SQL_FIELD_RIBBON_NAME & ", [" & FIELD_RIBBON_TAB_KEY & "], [" & FIELD_RIBBON_TAB_LABEL & "], [" & FIELD_RIBBON_GROUP_LABEL & "], " & SQL_FIELD_BUTTON_KEY & ", " & SQL_FIELD_BUTTON_LABEL & ", " & SQL_FIELD_SCREEN_TIP_CAPTION & ", " & SQL_FIELD_IMAGE_MSO & ", " & SQL_FIELD_OBJECT_TYPE_CODE & ", " & SQL_FIELD_OBJECT_NAME & ", " & SQL_FIELD_UPDATED_AT & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_RIBBON_BUTTON_TARGETS_TABLE_LOGICAL_ID) & "] ORDER BY " & OrderByPolicyText("CATALOG_RIBBON_BUTTON_TARGETS_REVIEW") & ";"
End Function

Private Function FormIsGeneratedForRibbon(ByVal formName As String) As Boolean
    'Returns canonical generated ownership for Ribbon placement, including ordinary Generated and protected PersistentGenerated forms.
    Dim canonicalGeneratedNames As Collection
    If Len(formName) = 0 Then Err.Raise vbObjectError + 9111, "FormIsGeneratedForRibbon", "A blank form name cannot be classified."
    Set canonicalGeneratedNames = CanonicalGeneratedManagedFormNames()
    If TextCollectionContains(canonicalGeneratedNames, formName) Then
        FormIsGeneratedForRibbon = True
        Exit Function
    End If
    FormIsGeneratedForRibbon = ManagedPersistentGeneratedFormIsDefined(formName)
End Function

Private Sub RequireManagedFormIdentityUniquenessForBatch(ByVal db As DAO.Database, ByVal sourceProcedure As String)
    Dim duplicateRs As DAO.Recordset
    On Error GoTo ErrHandler
    Set duplicateRs = db.OpenRecordset("SELECT " & SQL_FIELD_OBJECT_NAME & ", Count(*) AS " & SQL_FIELD_ROW_COUNT & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] WHERE UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))='FORM' GROUP BY " & SQL_FIELD_OBJECT_NAME & " HAVING Count(*)>1 ORDER BY " & SQL_FIELD_OBJECT_NAME & ";", dbOpenSnapshot)
    If duplicateRs.EOF = False Then Err.Raise vbObjectError + 9127, sourceProcedure, "More than one managed Form row exists for the same final forms-group resolution." & vbCrLf & "Form: " & CStr(Nz(duplicateRs.fields(FIELD_OBJECT_NAME).value, vbNullString)) & vbCrLf & "Rows: " & CStr(duplicateRs.fields(FIELD_ROW_COUNT).value)
    duplicateRs.Close
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not duplicateRs Is Nothing Then duplicateRs.Close
    On Error GoTo 0
    Err.Raise savedErrNumber, sourceProcedure, savedErrDescription
End Sub

Private Sub EnsureFormsRibbonPlacementCurrent(Optional ByRef placementChangeCount As Variant)
    'Converges every active managed Form to an explicitly authored permanent ADC Forms group while preserving supported user-owned X Forms/X Combo Forms/X Sort choices.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim objectName As String
    Dim objectTypeCode As String
    Dim isGenerated As Boolean
    Dim expectedTabKey As String
    Dim expectedTabLabel As String
    Dim expectedGroupLabel As String
    Dim expectedGroupOrder As Long
    Dim changedCount As Long
    Dim canonicalGeneratedNames As Collection
    If Not isMissing(placementChangeCount) Then placementChangeCount = CLng(0)
    Set db = ResolveCatalogDb()
    RequireManagedFormIdentityUniquenessForBatch db, "EnsureFormsRibbonPlacementCurrent"
    Set canonicalGeneratedNames = CanonicalGeneratedManagedFormNames()
    Set rs = db.OpenRecordset("SELECT * FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] WHERE Nz([" & FIELD_MANAGED_OBJECT_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))='FORM' ORDER BY " & SQL_FIELD_OBJECT_NAME & "," & SQL_FIELD_ID & ";", dbOpenDynaset)
    Do While rs.EOF = False
        PumpSetupResponsiveness
        objectName = CStr(Nz(rs!objectName, vbNullString))
        objectTypeCode = Trim$(CStr(rs!objectType))
        If ManagedObjectIsRibbonExcludedByPolicy(objectName, objectTypeCode) Then
            If ManagedObjectPlacementRibbon(objectName, objectTypeCode, expectedTabKey, expectedTabLabel, expectedGroupLabel, expectedGroupOrder) = False Then Err.Raise vbObjectError + 9428, "EnsureFormsRibbonPlacementCurrent", "A canonical hidden-form definition has no resolvable Ribbon group assignment." & vbCrLf & "Form: " & objectName
            If StrComp(Trim$(CStr(Nz(rs.fields(FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY).value, vbNullString))), ManagedObjectNavigationPaneSettingKey(objectName, objectTypeCode), vbTextCompare) <> 0 Or StrComp(Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_TAB_KEY).value, vbNullString))), expectedTabKey, vbTextCompare) <> 0 Or StrComp(Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_TAB_LABEL).value, vbNullString))), expectedTabLabel, vbTextCompare) <> 0 Or StrComp(Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_GROUP_LABEL).value, vbNullString))), expectedGroupLabel, vbTextCompare) <> 0 Or CLng(Nz(rs.fields(FIELD_RIBBON_GROUP_SORT_ORDER).value, 0)) <> expectedGroupOrder Or Len(Trim$(CStr(Nz(rs!ribbonTitle, vbNullString)))) > 0 Then
                rs.Edit
                SetRecordsetFieldValueWithSource rs, FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY, ManagedObjectNavigationPaneSettingKey(objectName, objectTypeCode), "ManagedObjectNavigationPaneSettingKey"
                rs.fields(FIELD_RIBBON_TAB_KEY).value = expectedTabKey
                rs.fields(FIELD_RIBBON_TAB_LABEL).value = expectedTabLabel
                rs.fields(FIELD_RIBBON_GROUP_LABEL).value = expectedGroupLabel
                rs.fields(FIELD_RIBBON_GROUP_SORT_ORDER).value = expectedGroupOrder
                rs!ribbonTitle = Null
                SetRecordsetFieldValueIfExists rs, FIELD_LAST_DEFAULT_REPAIR_ON, Now
                rs.Update
                changedCount = changedCount + 1
            End If
        ElseIf TryResolveFormsRibbonPlacement(objectName, objectTypeCode, isGenerated, expectedGroupLabel, expectedGroupOrder, rs.fields(FIELD_RIBBON_TAB_KEY).value, rs.fields(FIELD_RIBBON_GROUP_LABEL).value, canonicalGeneratedNames) Then
            If StrComp(Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_TAB_KEY).value, vbNullString))), DEFAULT_RIBBON_TAB_KEY_FORMS, vbTextCompare) <> 0 Or StrComp(Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_TAB_LABEL).value, vbNullString))), DEFAULT_RIBBON_TAB_LABEL_FORMS, vbTextCompare) <> 0 Or StrComp(Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_GROUP_LABEL).value, vbNullString))), expectedGroupLabel, vbTextCompare) <> 0 Or CLng(Nz(rs.fields(FIELD_RIBBON_GROUP_SORT_ORDER).value, 0)) <> expectedGroupOrder Then
                rs.Edit
                SetRecordsetFieldValueWithSource rs, FIELD_RIBBON_TAB_KEY, DEFAULT_RIBBON_TAB_KEY_FORMS, "DEFAULT_RIBBON_TAB_KEY_FORMS"
                SetRecordsetFieldValueWithSource rs, FIELD_RIBBON_TAB_LABEL, DEFAULT_RIBBON_TAB_LABEL_FORMS, "DEFAULT_RIBBON_TAB_LABEL_FORMS"
                rs.fields(FIELD_RIBBON_GROUP_LABEL).value = expectedGroupLabel
                rs.fields(FIELD_RIBBON_GROUP_SORT_ORDER).value = expectedGroupOrder
                SetRecordsetFieldValueIfExists rs, FIELD_LAST_DEFAULT_REPAIR_ON, Now
                rs.Update
                changedCount = changedCount + 1
            End If
        End If
        rs.MoveNext
    Loop
    rs.Close
    Set rs = Nothing
    If Not isMissing(placementChangeCount) Then placementChangeCount = changedCount
    AddTraceNote "D4 reused one active managed-Form rowset and one generated-form classification set for Ribbon placement; no per-user-Form Managed Objects reread was performed."
    If changedCount > 0 Then CoreAddOperationNote "Converged " & DEFAULT_RIBBON_TAB_LABEL_FORMS & " placement to explicitly authored permanent groups. Rows changed=" & CStr(changedCount) & "."
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    On Error GoTo 0
    Err.Raise savedErrNumber, "EnsureFormsRibbonPlacementCurrent", "Could not converge managed " & DEFAULT_RIBBON_TAB_LABEL_FORMS & " ribbon placement." & vbCrLf & "Last form: " & objectName & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Sub

Private Sub ReconcileManagedFormsForRibbon(Optional ByVal showMessage As Boolean = False, Optional ByRef reconciliationSummary As String = vbNullString, Optional ByRef reconciliationRan As Boolean = False, Optional ByRef verifiedStateToken As String = vbNullString, Optional ByVal suppliedCanonicalGeneratedNames As Variant, Optional ByVal suppliedDiscoveredUserFormNames As Variant, Optional ByVal suppliedAuthoritativeNames As Variant, Optional ByVal suppliedPhysicalInventory As Variant)
    RequireCatalogMutationRecoveryReady "ReconcileManagedFormsForRibbon"
    RequireSetupDomainMutationAllowed SETUP_DOMAIN_D4_MANAGED_FORM_LOGICAL_STATE, "ReconcileManagedFormsForRibbon"
    'Intended use: synchronize MAC to active metadata/configuration-generated definitions and the current physical ADC-prefixed user-form set before validation, optionally returning the reconciliation audit summary
    'to the caller.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim canonicalGeneratedNames As Collection
    Dim discoveredUserFormNames As Collection
    Dim authoritativeNames As Collection
    Dim physicalInventory As Collection
    Dim currentStateToken As String
    Dim refreshedStateToken As String
    Dim storedStateToken As String
    Dim statePropertyExists As Boolean
    Dim stateFailureDetail As String
    reconciliationRan = False
    verifiedStateToken = vbNullString
    Set db = ResolveCatalogDb()
    If isMissing(suppliedCanonicalGeneratedNames) = False Then
        If IsObject(suppliedCanonicalGeneratedNames) Then Set canonicalGeneratedNames = suppliedCanonicalGeneratedNames
    End If
    If canonicalGeneratedNames Is Nothing Then Set canonicalGeneratedNames = CanonicalGeneratedManagedFormNames()
    If isMissing(suppliedPhysicalInventory) = False Then
        If IsObject(suppliedPhysicalInventory) Then Set physicalInventory = suppliedPhysicalInventory
    End If
    If physicalInventory Is Nothing Then Set physicalInventory = PhysicalManagedFormInventory(db, canonicalGeneratedNames)
    If isMissing(suppliedDiscoveredUserFormNames) = False Then
        If IsObject(suppliedDiscoveredUserFormNames) Then Set discoveredUserFormNames = suppliedDiscoveredUserFormNames
    End If
    If discoveredUserFormNames Is Nothing Then Set discoveredUserFormNames = DiscoveredUserFormNamesFromInventory(physicalInventory)
    If isMissing(suppliedAuthoritativeNames) = False Then
        If IsObject(suppliedAuthoritativeNames) Then Set authoritativeNames = suppliedAuthoritativeNames
    End If
    If authoritativeNames Is Nothing Then Set authoritativeNames = AuthoritativeManagedFormNames(canonicalGeneratedNames, discoveredUserFormNames)
    storedStateToken = DatabaseTextPropertyValue(db, MANAGED_FORM_RECONCILIATION_TOKEN_PROPERTY, statePropertyExists)
    If statePropertyExists And Len(storedStateToken) > 0 Then
        currentStateToken = ManagedFormReconciliationStateToken(db, stateFailureDetail, canonicalGeneratedNames, discoveredUserFormNames, authoritativeNames, physicalInventory)
        If Len(currentStateToken) > 0 And StrComp(currentStateToken, storedStateToken, vbBinaryCompare) = 0 Then
            reconciliationSummary = "Managed-form compact reconciliation fast path: Used" & vbCrLf & "The exact D4-owned catalog state and current generated/" & DEFAULT_UTILITY_SHORT_NAME & "-prefixed physical form identity inventory match the last verified reconciliation." & vbCrLf & "Later-owned Description/DateUpdate state is intentionally excluded. Full transactional managed-form metadata reconciliation skipped."
            LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "ReconcileManagedFormsForRibbon", "Managed-form metadata reconciliation skipped by exact compact state.", reconciliationSummary, "Reconcile managed forms", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "Table", "CodeDb", "ManagedFormReconciliation"
            verifiedStateToken = currentStateToken
            If showMessage Then CoreShowMessage "Managed form membership verified current." & vbCrLf & vbCrLf & reconciliationSummary, vbInformation, "Reconcile Managed Forms", "ShowADCMessage", "Tables"
            Exit Sub
        End If
    Else
        stateFailureDetail = "Persisted managed-form reconciliation proof is unavailable; compact current-state calculation was skipped."
    End If
    If Len(stateFailureDetail) > 0 Then CoreAddOperationNote "The compact managed-form reconciliation gate was unavailable; the full fail-closed reconciliation will run. " & stateFailureDetail
    ReconcileManagedFormRowsCore True, False, reconciliationSummary, canonicalGeneratedNames, discoveredUserFormNames, authoritativeNames, physicalInventory
    reconciliationRan = True
    Set db = Nothing
    Set db = ResolveCatalogDb()
    stateFailureDetail = vbNullString
    refreshedStateToken = ManagedFormReconciliationStateToken(db, stateFailureDetail, canonicalGeneratedNames, discoveredUserFormNames, authoritativeNames, physicalInventory)
    If Len(refreshedStateToken) = 0 Then Err.Raise vbObjectError + 9123, "ReconcileManagedFormsForRibbon", IIf(Len(stateFailureDetail) = 0, "The exact post-reconciliation managed-form state token was blank.", stateFailureDetail)
    PersistManagedFormReconciliationStateToken db, refreshedStateToken
    verifiedStateToken = refreshedStateToken
    If showMessage Then CoreShowMessage "Managed form membership reconciled successfully." & IIf(Len(reconciliationSummary) > 0, vbCrLf & vbCrLf & reconciliationSummary, vbNullString), vbInformation, "Reconcile Managed Forms", "ShowADCMessage", "Tables"
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    If showMessage Then
        CoreShowErrorMessage "Could not reconcile managed forms." & vbCrLf & vbCrLf & savedErrDescription, vbCritical, "Reconcile Managed Forms", "ReconcileManagedFormsForRibbon", "Tables"
        Exit Sub
    End If
    Err.Raise savedErrNumber, "ReconcileManagedFormsForRibbon", "Could not reconcile managed forms before ribbon validation." & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Sub

' Purpose: Returns the authoritative Forms-tab placement only when the supplied managed-object type is Form; non-Form callers receive False without a fallback group. Batch callers may supply already-read
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   objectName (Input; String): Physical Access object name identifying the database object targeted by the operation.
'   objectTypeCode (Input; String): Access object-type code identifying the class of database object targeted by the operation.
'   isGenerated (Output; Boolean): Set True when the procedure determines that is generated applies; set False when that condition is not met.
'   groupLabel (Output; String): Receives the resolved group label produced from this procedure's validated inputs and current ADC state.
'   groupSortOrder (Output; Long): Receives the resolved group sort order produced from this procedure's validated inputs and current ADC state.
'   suppliedStoredRibbonTabKey (Input Optional; Variant): Canonical key identifying the supplied stored ribbon tab definition, setting, or managed item to use.
'   suppliedStoredRibbonGroupLabel (Input Optional; Variant): Display or grouping label used as the supplied stored ribbon group label for the UI, Ribbon, progress, or definition item being processed.
'   suppliedCanonicalGeneratedNames (Input Optional; Variant): Optional array/list of canonical generated object names already resolved by the caller; supplying it avoids recomputing the set.
' Returns: Boolean: True when the attempt to resolve forms ribbon placement completes successfully; False for the routine's defined normal unsuccessful/not-applicable outcome.
Public Function TryResolveFormsRibbonPlacement(ByVal objectName As String, ByVal objectTypeCode As String, ByRef isGenerated As Boolean, ByRef groupLabel As String, ByRef groupSortOrder As Long, Optional ByVal suppliedStoredRibbonTabKey As Variant, Optional ByVal suppliedStoredRibbonGroupLabel As Variant, Optional ByVal suppliedCanonicalGeneratedNames As Variant) As Boolean
    'Returns the authoritative Forms-tab placement only when the supplied managed-object type is Form; non-Form callers receive False without a fallback group. Batch callers may supply already-read
    'row/classification evidence; standalone callers retain the authoritative catalog lookup path.
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim storedGroup As String
    Dim storedTabKey As String
    Dim matchCount As Long
    Dim canonicalTabKey As String
    Dim canonicalTabLabel As String
    Dim canonicalGroupLabel As String
    Dim canonicalGroupSortOrder As Long
    Dim canonicalGeneratedNames As Collection
    objectTypeCode = UCase$(Trim$(objectTypeCode))
    isGenerated = False
    groupLabel = vbNullString
    groupSortOrder = 0
    If StrComp(objectTypeCode, UCase$(ADCAT_OBJECT_TYPE_FORM), vbBinaryCompare) <> 0 Then Exit Function
    If Len(objectName) = 0 Then Err.Raise vbObjectError + 9121, "TryResolveFormsRibbonPlacement", "A blank Form name cannot be resolved to an " & DEFAULT_RIBBON_TAB_LABEL_FORMS & " group."
    If isMissing(suppliedCanonicalGeneratedNames) = False Then
        If IsObject(suppliedCanonicalGeneratedNames) Then Set canonicalGeneratedNames = suppliedCanonicalGeneratedNames
    End If
    If canonicalGeneratedNames Is Nothing Then
        isGenerated = FormIsGeneratedForRibbon(objectName)
    Else
        isGenerated = TextCollectionContains(canonicalGeneratedNames, objectName)
        If isGenerated = False Then isGenerated = ManagedPersistentGeneratedFormIsDefined(objectName)
    End If
    If isGenerated Then
        If ManagedObjectIsRibbonExcludedByPolicy(objectName, objectTypeCode) Then Exit Function
        If ManagedObjectPlacementRibbon(objectName, objectTypeCode, canonicalTabKey, canonicalTabLabel, canonicalGroupLabel, canonicalGroupSortOrder) = False Then Err.Raise vbObjectError + 9128, "TryResolveFormsRibbonPlacement", "A generated Form does not have a canonical Ribbon placement." & vbCrLf & "Form: " & objectName
        If StrComp(canonicalTabKey, DEFAULT_RIBBON_TAB_KEY_FORMS, vbTextCompare) <> 0 Then Exit Function
        groupLabel = GeneratedFormRibbonGroupLabel(objectName)
        groupSortOrder = GeneratedFormRibbonGroupSortOrder(groupLabel)
    Else
        If isMissing(suppliedStoredRibbonTabKey) = False And isMissing(suppliedStoredRibbonGroupLabel) = False Then
            storedTabKey = Trim$(CStr(Nz(suppliedStoredRibbonTabKey, vbNullString)))
            If StrComp(storedTabKey, DEFAULT_RIBBON_TAB_KEY_FORMS, vbTextCompare) = 0 Then storedGroup = Trim$(CStr(Nz(suppliedStoredRibbonGroupLabel, vbNullString)))
        Else
            Set db = ResolveCatalogDb()
            Set rs = db.OpenRecordset("SELECT [" & FIELD_RIBBON_TAB_KEY & "],[" & FIELD_RIBBON_GROUP_LABEL & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] WHERE UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))='FORM' AND " & SQL_FIELD_OBJECT_NAME & "=" & SharedDao_SqlQuote(objectName) & ";", dbOpenSnapshot)
            Do While rs.EOF = False
                PumpSetupResponsiveness
                matchCount = matchCount + 1
                If StrComp(Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_TAB_KEY).value, vbNullString))), DEFAULT_RIBBON_TAB_KEY_FORMS, vbTextCompare) = 0 Then storedGroup = Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_GROUP_LABEL).value, vbNullString)))
                rs.MoveNext
            Loop
            rs.Close
            If matchCount > 1 Then Err.Raise vbObjectError + 9127, "TryResolveFormsRibbonPlacement", "More than one managed Form row exists for the same final forms-group resolution." & vbCrLf & "Form: " & objectName & vbCrLf & "Rows: " & CStr(matchCount)
        End If
        If TryResolveUserFormRibbonGroupPlacement(storedGroup, groupLabel, groupSortOrder) = False Then
            groupLabel = DEFAULT_USER_FORM_RIBBON_GROUP_FORMS
            groupSortOrder = UserFormRibbonGroupSortOrder(groupLabel)
        End If
    End If
    TryResolveFormsRibbonPlacement = True
End Function

' Purpose: Validates system ribbon group overrides for ribbon build for validation stage.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   validationStage (Input Optional; String): Diagnostic label naming the validation stage at which this check runs; included in errors/traces to identify the failing boundary. Default: "Immediately before
'   ribbon-row snapshot collection".
' Returns: None (Sub). The procedure communicates its result through its database, UI, trace, or module-state side effects and raises errors where its implementation requires it.
Public Sub ValidateSystemRibbonGroupOverridesForRibbonBuild(Optional ByVal validationStage As String = "Immediately before ribbon-row snapshot collection")
    On Error GoTo ErrHandler
    Dim ValidationSummary As String
    Dim navigationPaneDefinitions As Collection
    Dim systemMacroGroupDefinitions As Collection
    Dim systemMacroGroupKeyIndex As Object
    Dim systemMacroDefinitions As Collection
    Dim systemMacroDefaultCatalog As Collection
    Dim systemMacroCatalogRows As Collection
    Dim systemMacroTitleMap As Object
    validationStage = Trim$(validationStage)
    If Len(validationStage) = 0 Then validationStage = "Immediately before ribbon-row snapshot collection"
    Set navigationPaneDefinitions = NavigationPaneGroupDefinitions()
    Set systemMacroGroupDefinitions = SystemMacroNavigationPaneGroupDefinitions(navigationPaneDefinitions)
    Set systemMacroGroupKeyIndex = SystemMacroNavigationPaneGroupKeyIndex(systemMacroGroupDefinitions)
    Set systemMacroDefinitions = x__UTIL_ADC_DEFAULTS.GetSystemMacroDefinitions()
    Set systemMacroDefaultCatalog = BuildSystemMacroDefaultCatalog(systemMacroGroupKeyIndex, systemMacroDefinitions)
    Set systemMacroCatalogRows = SystemMacroCatalog(systemMacroDefaultCatalog, systemMacroGroupKeyIndex, systemMacroDefinitions)
    Set systemMacroTitleMap = BuildSystemMacroTitleMap(systemMacroCatalogRows)
    ValidateSystemRibbonGroupOverrides ValidationSummary, systemMacroTitleMap, systemMacroDefinitions
    LogTraceMessage TRACE_LEVEL_INFO, "RibbonPresentation", "ValidateSystemRibbonGroupOverridesForRibbonBuild", "Authoritative ADC1/ADC2 System Macro and Help Document Macro placement verified before ribbon-row collection.", "Validation stage: " & validationStage & vbCrLf & ValidationSummary, validationStage, 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "Table", "CodeDb", "RibbonPresentation"
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    Dim diagnosticText As String
    Dim messageText As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    diagnosticText = SystemRibbonGroupOverrideDiagnosticText(50)
    On Error GoTo 0
    messageText = "The authoritative ADC1/ADC2 System Macro and Help Document Macro placement failed verification before ribbon-row collection." & vbCrLf & "Validation stage: " & validationStage & vbCrLf & "Original source: " & savedErrSource & vbCrLf & "Original description:" & vbCrLf & savedErrDescription & vbCrLf & vbCrLf & "Fresh catalog placement snapshot:" & vbCrLf & diagnosticText
    LogTraceMessage TRACE_LEVEL_ERROR, "RibbonPresentation", "ValidateSystemRibbonGroupOverridesForRibbonBuild", "Authoritative ADC1/ADC2 pre-ribbon verification failed.", messageText, validationStage, savedErrNumber, savedErrSource, savedErrDescription, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "Table", "CodeDb", "RibbonPresentation"
    Err.Raise savedErrNumber, "ValidateSystemRibbonGroupOverridesForRibbonBuild", messageText
End Sub

Private Function F1ManagedDependencyIdentityKey(ByVal managedObjectID As Long, ByVal dependsOnManagedObjectID As Long, ByVal dependencyName As String, ByVal dependencyObjectType As String, ByVal dependencyType As String, ByVal dependencyDatabaseRole As String) As String
    F1ManagedDependencyIdentityKey = CStr(managedObjectID) & Chr$(30) & CStr(dependsOnManagedObjectID) & Chr$(30) & UCase$(Trim$(dependencyName)) & Chr$(30) & UCase$(Trim$(dependencyObjectType)) & Chr$(30) & UCase$(Trim$(dependencyType)) & Chr$(30) & UCase$(Trim$(dependencyDatabaseRole))
End Function

Private Function F1AppendUniqueEvidence(ByVal existingEvidence As String, ByVal evidenceText As String) As String
    existingEvidence = Trim$(existingEvidence)
    evidenceText = Trim$(evidenceText)
    If Len(evidenceText) = 0 Then F1AppendUniqueEvidence = existingEvidence: Exit Function
    If Len(existingEvidence) = 0 Then F1AppendUniqueEvidence = evidenceText: Exit Function
    If InStr(1, ";" & existingEvidence & ";", ";" & evidenceText & ";", vbTextCompare) > 0 Then F1AppendUniqueEvidence = existingEvidence Else F1AppendUniqueEvidence = existingEvidence & ";" & evidenceText
End Function

Private Function F1UnwrapObjectReference(ByVal referenceText As String) As String
    referenceText = Trim$(referenceText)
    If InStr(1, referenceText, "Form.", vbTextCompare) = 1 Then referenceText = Mid$(referenceText, 6)
    If InStr(1, referenceText, "Report.", vbTextCompare) = 1 Then referenceText = Mid$(referenceText, 8)
    If Left$(referenceText, 1) = "[" And Right$(referenceText, 1) = "]" And Len(referenceText) >= 2 Then referenceText = Replace(Mid$(referenceText, 2, Len(referenceText) - 2), "]]", "]")
    F1UnwrapObjectReference = Trim$(referenceText)
End Function

Private Function F1LooksLikeSqlSource(ByVal sourceText As String) As Boolean
    Dim upperText As String
    upperText = UCase$(Trim$(sourceText))
    F1LooksLikeSqlSource = (Left$(upperText, 7) = "SELECT " Or Left$(upperText, 10) = "TRANSFORM " Or Left$(upperText, 11) = "PARAMETERS " Or InStr(1, upperText, " FROM ", vbBinaryCompare) > 0)
End Function

Private Function F1SimpleEventProcedureName(ByVal expressionText As String) As String
    Dim candidateName As String
    Dim openParen As Long
    Dim charIndex As Long
    Dim currentChar As String
    expressionText = Trim$(expressionText)
    If Left$(expressionText, 1) <> "=" Then Exit Function
    candidateName = Trim$(Mid$(expressionText, 2))
    openParen = InStr(1, candidateName, "(", vbBinaryCompare)
    If openParen <= 1 Then Exit Function
    candidateName = Trim$(Left$(candidateName, openParen - 1))
    If Len(candidateName) = 0 Then Exit Function
    For charIndex = 1 To Len(candidateName)
        currentChar = Mid$(candidateName, charIndex, 1)
        If Not ((currentChar >= "A" And currentChar <= "Z") Or (currentChar >= "a" And currentChar <= "z") Or (currentChar >= "0" And currentChar <= "9") Or currentChar = "_") Then Exit Function
    Next charIndex
    F1SimpleEventProcedureName = candidateName
End Function

Private Function F1ManagedDependencyTargetDatabaseRole(ByVal dependencyName As String, ByVal dependencyObjectType As String, ByVal fallbackRole As String) As String
    On Error GoTo UseFallback
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Set db = ResolveCatalogDb()
    Set rs = db.OpenRecordset("SELECT TOP 1 [" & FIELD_RESOLVED_OBJECT_SOURCE_DB_ROLE & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_ManagedObjectsResolved") & "] WHERE " & SQL_FIELD_OBJECT_NAME & "=" & SharedDao_SqlQuote(dependencyName) & " AND [" & FIELD_RESOLVED_OBJECT_TYPE & "]=" & SharedDao_SqlQuote(dependencyObjectType) & " AND [" & FIELD_MANAGED_OBJECT_STATUS & "]=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ";", dbOpenSnapshot)
    If rs.EOF = False Then F1ManagedDependencyTargetDatabaseRole = Trim$(CStr(Nz(rs.fields(0).value, vbNullString)))
    rs.Close
    If Len(F1ManagedDependencyTargetDatabaseRole) = 0 Then F1ManagedDependencyTargetDatabaseRole = fallbackRole
    Exit Function
UseFallback:
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    F1ManagedDependencyTargetDatabaseRole = fallbackRole
End Function

Private Sub F1AddExpectedManagedDependency(ByVal expectedRows As Object, ByVal managedObjectID As Long, ByVal managedObjectName As String, ByVal managedObjectType As String, ByVal dependencyName As String, ByVal dependencyObjectType As String, ByVal dependencyType As String, ByVal dependencyDatabaseRole As String, ByVal evidenceText As String)
    Dim dependsOnManagedObjectID As Long
    Dim dependencyKey As String
    Dim rowData As Variant
    dependencyName = F1UnwrapObjectReference(dependencyName)
    dependencyObjectType = Trim$(dependencyObjectType)
    dependencyType = Trim$(dependencyType)
    dependencyDatabaseRole = Trim$(dependencyDatabaseRole)
    evidenceText = Trim$(evidenceText)
    If managedObjectID <= 0 Or Len(dependencyName) = 0 Or Len(dependencyType) = 0 Then Exit Sub
    If Len(dependencyObjectType) > 0 Then
        dependsOnManagedObjectID = ManagedObjectIDByName(dependencyName, dependencyObjectType)
        If dependsOnManagedObjectID = managedObjectID Then Exit Sub
        If dependsOnManagedObjectID > 0 Then dependencyType = ADCAT_DEPENDENCY_TYPE_CATALOG_OBJECT
        dependencyDatabaseRole = F1ManagedDependencyTargetDatabaseRole(dependencyName, dependencyObjectType, dependencyDatabaseRole)
    End If
    dependencyKey = F1ManagedDependencyIdentityKey(managedObjectID, dependsOnManagedObjectID, dependencyName, dependencyObjectType, dependencyType, dependencyDatabaseRole)
    If expectedRows.Exists(dependencyKey) Then
        rowData = expectedRows(dependencyKey)
        rowData(6) = F1AppendUniqueEvidence(CStr(rowData(6)), evidenceText)
        expectedRows(dependencyKey) = rowData
    Else
        expectedRows.Add dependencyKey, Array(managedObjectID, dependsOnManagedObjectID, dependencyName, dependencyObjectType, dependencyType, dependencyDatabaseRole, evidenceText, managedObjectName, managedObjectType, 0&)
    End If
End Sub

Private Sub F1CollectParsedSqlDependencies(ByVal expectedRows As Object, ByVal managedObjectID As Long, ByVal managedObjectName As String, ByVal managedObjectType As String, ByVal sourceDbRole As String, ByVal sqlText As String, ByVal evidenceText As String, ByRef skippedEvidence As String)
    On Error GoTo UnsupportedSql
    Dim dependencyRows As Object
    Dim dependencyKey As Variant
    Dim dependencyData As Variant
    Set dependencyRows = CreateObject("Scripting.Dictionary")
    dependencyRows.CompareMode = vbTextCompare
    B2CollectSqlSourceNames sqlText, dependencyRows
    For Each dependencyKey In dependencyRows.keys
        dependencyData = dependencyRows(CStr(dependencyKey))
        F1AddExpectedManagedDependency expectedRows, managedObjectID, managedObjectName, managedObjectType, CStr(dependencyData(1)), CStr(dependencyData(0)), ADCAT_DEPENDENCY_TYPE_ACCESS_OBJECT, sourceDbRole, evidenceText
    Next dependencyKey
    Exit Sub
UnsupportedSql:
    skippedEvidence = SharedText_AppendNonBlankLine(skippedEvidence, managedObjectType & " [" & managedObjectName & "] " & evidenceText & " was not persisted because an exact SQL-source proof was unavailable. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description)
    Err.Clear
End Sub

Private Sub F1CollectTableQuerySourceExpression(ByVal expectedRows As Object, ByVal managedObjectID As Long, ByVal managedObjectName As String, ByVal managedObjectType As String, ByVal sourceDbRole As String, ByVal sourceText As String, ByVal evidenceText As String, ByVal skipValueList As Boolean, ByRef skippedEvidence As String)
    On Error GoTo SourceError
    Dim sourceDb As DAO.Database
    Dim sourceName As String
    sourceText = Trim$(sourceText)
    If Len(sourceText) = 0 Then Exit Sub
    If skipValueList And InStr(1, sourceText, ";", vbBinaryCompare) > 0 And F1LooksLikeSqlSource(sourceText) = False Then Exit Sub
    If F1LooksLikeSqlSource(sourceText) Then
        F1CollectParsedSqlDependencies expectedRows, managedObjectID, managedObjectName, managedObjectType, sourceDbRole, sourceText, evidenceText, skippedEvidence
        Exit Sub
    End If
    sourceName = F1UnwrapObjectReference(sourceText)
    If Len(sourceName) = 0 Then Exit Sub
    Set sourceDb = DatabaseForRole(sourceDbRole)
    If SharedDao_TableExists(sourceDb, sourceName) Then
        F1AddExpectedManagedDependency expectedRows, managedObjectID, managedObjectName, managedObjectType, sourceName, ADCAT_OBJECT_TYPE_TABLE, ADCAT_DEPENDENCY_TYPE_ACCESS_OBJECT, sourceDbRole, evidenceText
    ElseIf SharedDao_QueryExists(sourceDb, sourceName) Then
        F1AddExpectedManagedDependency expectedRows, managedObjectID, managedObjectName, managedObjectType, sourceName, ADCAT_OBJECT_TYPE_QUERY, ADCAT_DEPENDENCY_TYPE_ACCESS_OBJECT, sourceDbRole, evidenceText
    Else
        skippedEvidence = SharedText_AppendNonBlankLine(skippedEvidence, managedObjectType & " [" & managedObjectName & "] " & evidenceText & " references an unresolved table/query source [" & sourceName & "]; no dependency row was generated for that source.")
    End If
    Exit Sub
SourceError:
    skippedEvidence = SharedText_AppendNonBlankLine(skippedEvidence, managedObjectType & " [" & managedObjectName & "] " & evidenceText & " could not be inspected. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description)
    Err.Clear
End Sub

Private Sub F1CollectEventDependencies(ByVal expectedRows As Object, ByVal managedObjectID As Long, ByVal managedObjectName As String, ByVal managedObjectType As String, ByVal sourceDbRole As String, ByVal ownerName As String, ByVal targetObject As Object, ByRef skippedEvidence As String)
    On Error Resume Next
    Dim propertyItem As Object
    Dim propertyValue As String
    Dim ProcedureName As String
    Dim macroName As String
    Dim sourceDb As DAO.Database
    Set sourceDb = DatabaseForRole(sourceDbRole)
    For Each propertyItem In targetObject.properties
        PumpSetupResponsiveness
        If Left$(CStr(propertyItem.Name), 2) = "On" Then
            Err.Clear
            propertyValue = Trim$(CStr(Nz(propertyItem.value, vbNullString)))
            If Err.Number = 0 And Len(propertyValue) > 0 Then
                If StrComp(propertyValue, "[Event Procedure]", vbTextCompare) <> 0 And StrComp(propertyValue, "[Embedded Macro]", vbTextCompare) <> 0 Then
                    If Left$(propertyValue, 1) = "=" Then
                        ProcedureName = F1SimpleEventProcedureName(propertyValue)
                        If Len(ProcedureName) > 0 Then F1AddExpectedManagedDependency expectedRows, managedObjectID, managedObjectName, managedObjectType, ProcedureName, vbNullString, ADCAT_DEPENDENCY_TYPE_VBA_PROCEDURE, sourceDbRole, ownerName & "." & CStr(propertyItem.Name)
                    Else
                        macroName = F1UnwrapObjectReference(propertyValue)
                        If DatabaseAccessObjectExistsByName(sourceDb, acMacro, macroName) = False And InStr(1, macroName, ".", vbBinaryCompare) > 0 Then
                            If DatabaseAccessObjectExistsByName(sourceDb, acMacro, Left$(macroName, InStr(1, macroName, ".", vbBinaryCompare) - 1)) Then macroName = Left$(macroName, InStr(1, macroName, ".", vbBinaryCompare) - 1)
                        End If
                        If DatabaseAccessObjectExistsByName(sourceDb, acMacro, macroName) Then F1AddExpectedManagedDependency expectedRows, managedObjectID, managedObjectName, managedObjectType, macroName, ADCAT_OBJECT_TYPE_MACRO, ADCAT_DEPENDENCY_TYPE_ACCESS_OBJECT, sourceDbRole, ownerName & "." & CStr(propertyItem.Name)
                    End If
                End If
            End If
        End If
    Next propertyItem
    On Error GoTo 0
End Sub

Private Sub F1CollectControlDependencies(ByVal expectedRows As Object, ByVal managedObjectID As Long, ByVal managedObjectName As String, ByVal managedObjectType As String, ByVal sourceDbRole As String, ByVal ctl As Object, ByRef skippedEvidence As String)
    On Error Resume Next
    Dim rowSourceText As String
    Dim sourceObjectText As String
    Dim targetName As String
    Dim targetType As String
    Err.Clear
    rowSourceText = CStr(Nz(ctl.rowSource, vbNullString))
    If Err.Number = 0 Then F1CollectTableQuerySourceExpression expectedRows, managedObjectID, managedObjectName, managedObjectType, sourceDbRole, rowSourceText, ctl.Name & ".RowSource", True, skippedEvidence
    Err.Clear
    sourceObjectText = Trim$(CStr(Nz(ctl.sourceObject, vbNullString)))
    If Err.Number = 0 And Len(sourceObjectText) > 0 Then
        If InStr(1, sourceObjectText, "Form.", vbTextCompare) = 1 Then
            targetType = ADCAT_OBJECT_TYPE_FORM
        ElseIf InStr(1, sourceObjectText, "Report.", vbTextCompare) = 1 Then
            targetType = ADCAT_OBJECT_TYPE_REPORT
        Else
            targetType = vbNullString
        End If
        targetName = F1UnwrapObjectReference(sourceObjectText)
        If Len(targetType) > 0 And Len(targetName) > 0 Then F1AddExpectedManagedDependency expectedRows, managedObjectID, managedObjectName, managedObjectType, targetName, targetType, ADCAT_DEPENDENCY_TYPE_ACCESS_OBJECT, sourceDbRole, ctl.Name & ".SourceObject"
    End If
    F1CollectEventDependencies expectedRows, managedObjectID, managedObjectName, managedObjectType, sourceDbRole, ctl.Name, ctl, skippedEvidence
    On Error GoTo 0
End Sub

Private Sub F1CollectFormOrReportDependencies(ByVal expectedRows As Object, ByVal managedObjectID As Long, ByVal managedObjectName As String, ByVal managedObjectType As String, ByVal sourceDbRole As String, ByRef skippedEvidence As String)
    On Error GoTo InspectError
    Dim targetObject As Object
    Dim ctl As Object
    Dim openedForInspection As Boolean
    If StrComp(sourceDbRole, CONFIG_OWNER_DATABASE_ROLE_CODE_DB, vbTextCompare) = 0 And CodeDbIsHostDb() = False Then
        skippedEvidence = SharedText_AppendNonBlankLine(skippedEvidence, managedObjectType & " [" & managedObjectName & "] live Form/Report property inspection was skipped because CodeDb is not the active Access CurrentProject. Query, catalog-field, configured-macro, and action-payload dependency evidence remains available.")
        Exit Sub
    End If
    If StrComp(managedObjectType, ADCAT_OBJECT_TYPE_FORM, vbTextCompare) = 0 Then
        If SharedAccess_ObjectIsOpen(acForm, managedObjectName) Then
            Set targetObject = forms(managedObjectName)
        Else
            DoCmd.OpenForm managedObjectName, acDesign, , , , acHidden
            openedForInspection = True
            Set targetObject = forms(managedObjectName)
        End If
        F1CollectTableQuerySourceExpression expectedRows, managedObjectID, managedObjectName, managedObjectType, sourceDbRole, CStr(Nz(targetObject.recordSource, vbNullString)), "RecordSource", False, skippedEvidence
    Else
        If SharedAccess_ObjectIsOpen(acReport, managedObjectName) Then
            Set targetObject = reports(managedObjectName)
        Else
            DoCmd.OpenReport managedObjectName, acViewDesign, , , acHidden
            openedForInspection = True
            Set targetObject = reports(managedObjectName)
        End If
        F1CollectTableQuerySourceExpression expectedRows, managedObjectID, managedObjectName, managedObjectType, sourceDbRole, CStr(Nz(targetObject.recordSource, vbNullString)), "RecordSource", False, skippedEvidence
    End If
    F1CollectEventDependencies expectedRows, managedObjectID, managedObjectName, managedObjectType, sourceDbRole, managedObjectType, targetObject, skippedEvidence
    For Each ctl In targetObject.Controls
        PumpSetupResponsiveness
        F1CollectControlDependencies expectedRows, managedObjectID, managedObjectName, managedObjectType, sourceDbRole, ctl, skippedEvidence
    Next ctl
CleanExit:
    On Error Resume Next
    If openedForInspection Then
        If StrComp(managedObjectType, ADCAT_OBJECT_TYPE_FORM, vbTextCompare) = 0 Then
            If SharedAccess_ObjectIsOpen(acForm, managedObjectName) Then DoCmd.Close acForm, managedObjectName, acSaveNo
        Else
            If SharedAccess_ObjectIsOpen(acReport, managedObjectName) Then DoCmd.Close acReport, managedObjectName, acSaveNo
        End If
    End If
    On Error GoTo 0
    Exit Sub
InspectError:
    skippedEvidence = SharedText_AppendNonBlankLine(skippedEvidence, managedObjectType & " [" & managedObjectName & "] could not be inspected for exact form/report dependency evidence. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description)
    Resume CleanExit
End Sub

Private Sub F1CollectQueryDependencies(ByVal expectedRows As Object, ByVal managedObjectID As Long, ByVal managedObjectName As String, ByVal sourceDbRole As String, ByRef skippedEvidence As String)
    On Error GoTo QueryError
    Dim sourceDb As DAO.Database
    Dim sqlText As String
    Set sourceDb = DatabaseForRole(sourceDbRole)
    If SharedDao_QueryExists(sourceDb, managedObjectName) = False Then skippedEvidence = SharedText_AppendNonBlankLine(skippedEvidence, "Query [" & managedObjectName & "] is not present in database role " & sourceDbRole & "; no query-source dependencies were generated."): Exit Sub
    sqlText = CStr(sourceDb.QueryDefs(managedObjectName).sql)
    F1CollectParsedSqlDependencies expectedRows, managedObjectID, managedObjectName, ADCAT_OBJECT_TYPE_QUERY, sourceDbRole, sqlText, "QuerySource", skippedEvidence
    Exit Sub
QueryError:
    skippedEvidence = SharedText_AppendNonBlankLine(skippedEvidence, "Query [" & managedObjectName & "] could not be inspected for exact source dependencies. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description)
    Err.Clear
End Sub

Private Sub F1AddCanonicalGeneratedFormCallback(ByVal expectedRows As Object, ByVal ownerID As Long, ByVal formName As String, ByVal expressionText As String, ByVal evidenceText As String)
    Dim ProcedureName As String
    ProcedureName = F1SimpleEventProcedureName(expressionText)
    If Len(ProcedureName) > 0 Then F1AddExpectedManagedDependency expectedRows, ownerID, formName, ADCAT_OBJECT_TYPE_FORM, ProcedureName, vbNullString, ADCAT_DEPENDENCY_TYPE_VBA_PROCEDURE, CONFIG_OWNER_DATABASE_ROLE_CODE_DB, evidenceText
End Sub

Private Sub F1CollectCanonicalGeneratedFormDependencies(ByVal expectedRows As Object, ByRef skippedEvidence As String)
    On Error GoTo CanonicalFormError
    Dim formNames As Variant
    Dim formItem As Variant
    Dim formName As String
    Dim ownerID As Long
    Dim sourceName As String
    Dim callbacks As Collection
    Dim callbackItem As Variant
    Dim childNames As Variant
    Dim childItem As Variant
    Dim parentFormName As String
    Dim parentID As Long
    formNames = GeneratedFormNames()
    If IsArray(formNames) Then
        For Each formItem In formNames
            PumpSetupResponsiveness
            formName = CStr(formItem)
            ownerID = ManagedObjectIDByName(formName, ADCAT_OBJECT_TYPE_FORM)
            If ownerID > 0 Then
                sourceName = x__UTIL_ADC_UI_FORMS.GeneratedFormSourceNameForSignature(formName)
                If Len(sourceName) > 0 Then F1CollectTableQuerySourceExpression expectedRows, ownerID, formName, ADCAT_OBJECT_TYPE_FORM, CONFIG_OWNER_DATABASE_ROLE_CODE_DB, sourceName, "CanonicalForm.RecordSource", False, skippedEvidence
                F1AddCanonicalGeneratedFormCallback expectedRows, ownerID, formName, GeneratedFormOnCurrentExpression(formName), "CanonicalForm.OnCurrent"
                F1AddCanonicalGeneratedFormCallback expectedRows, ownerID, formName, GeneratedFormContractOnOpenExpression(formName), "CanonicalForm.OnOpen"
                F1AddCanonicalGeneratedFormCallback expectedRows, ownerID, formName, GeneratedFormContractOnLoadExpression(formName), "CanonicalForm.OnLoad"
                Set callbacks = GeneratedFormContractCallbackExpressions(formName)
                For Each callbackItem In callbacks
                    F1AddCanonicalGeneratedFormCallback expectedRows, ownerID, formName, CStr(callbackItem), "CanonicalForm.ControlCallback"
                Next callbackItem
                Set callbacks = Nothing
            End If
        Next formItem
    End If
    parentFormName = ManagedObjectPhysicalName(NAMING_CATEGORY_GENERATED_FORM, "Add_In_Review")
    parentID = ManagedObjectIDByName(parentFormName, ADCAT_OBJECT_TYPE_FORM)
    If parentID > 0 Then
        childNames = AddInReviewChildFormNames()
        If IsArray(childNames) Then
            For Each childItem In childNames
                F1AddExpectedManagedDependency expectedRows, parentID, parentFormName, ADCAT_OBJECT_TYPE_FORM, CStr(childItem), ADCAT_OBJECT_TYPE_FORM, ADCAT_DEPENDENCY_TYPE_ACCESS_OBJECT, CONFIG_OWNER_DATABASE_ROLE_CODE_DB, "CanonicalForm.SourceObject"
            Next childItem
        End If
    End If
    Exit Sub
CanonicalFormError:
    skippedEvidence = SharedText_AppendNonBlankLine(skippedEvidence, "Canonical generated-form dependencies could not be fully inspected. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description)
    Err.Clear
End Sub

Private Sub F1CollectCanonicalManagedReportDependencies(ByVal expectedRows As Object, ByRef skippedEvidence As String)
    On Error GoTo CanonicalReportError
    Dim definitions As Collection
    Dim definitionData As Variant
    Dim reportName As String
    Dim sourceName As String
    Dim sourceKind As String
    Dim ownerID As Long
    Set definitions = x__UTIL_ADC_REPORTS.ManagedReportDependencyDefinitionsForSetup()
    For Each definitionData In definitions
        PumpSetupResponsiveness
        reportName = CStr(definitionData(0))
        sourceName = CStr(definitionData(1))
        sourceKind = CStr(definitionData(2))
        ownerID = ManagedObjectIDByName(reportName, ADCAT_OBJECT_TYPE_REPORT)
        If ownerID > 0 Then F1AddExpectedManagedDependency expectedRows, ownerID, reportName, ADCAT_OBJECT_TYPE_REPORT, sourceName, sourceKind, ADCAT_DEPENDENCY_TYPE_ACCESS_OBJECT, CONFIG_OWNER_DATABASE_ROLE_CODE_DB, "CanonicalReport.RecordSource"
    Next definitionData
    Exit Sub
CanonicalReportError:
    skippedEvidence = SharedText_AppendNonBlankLine(skippedEvidence, "Canonical managed-report dependencies could not be fully inspected. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description)
    Err.Clear
End Sub

Private Sub F1CollectManagedObjectDependenciesFromFinalizedObjects(ByVal expectedRows As Object, ByRef skippedEvidence As String)
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim managedObjectID As Long
    Dim managedObjectName As String
    Dim managedObjectType As String
    Dim sourceDbRole As String
    Set db = ResolveCatalogDb()
    Set rs = db.OpenRecordset("SELECT [" & FIELD_MANAGED_OBJECT_ID & "]," & SQL_FIELD_OBJECT_NAME & ",[" & FIELD_RESOLVED_OBJECT_TYPE & "],[" & FIELD_RESOLVED_OBJECT_SOURCE_DB_ROLE & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_ManagedObjectsResolved") & "] WHERE [" & FIELD_MANAGED_OBJECT_STATUS & "]=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND " & SQL_FIELD_OBJECT_CATEGORY_STATUS & "=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " ORDER BY " & SQL_FIELD_RESOLVED_OBJECT_TYPE & "," & SQL_FIELD_OBJECT_NAME & ";", dbOpenSnapshot)
    Do While rs.EOF = False
        PumpSetupResponsiveness
        managedObjectID = CLng(rs.fields(FIELD_MANAGED_OBJECT_ID).value)
        managedObjectName = Trim$(CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString)))
        managedObjectType = Trim$(CStr(Nz(rs.fields(FIELD_RESOLVED_OBJECT_TYPE).value, vbNullString)))
        sourceDbRole = Trim$(CStr(Nz(rs.fields(FIELD_RESOLVED_OBJECT_SOURCE_DB_ROLE).value, vbNullString)))
        If Len(sourceDbRole) = 0 Then sourceDbRole = CONFIG_OWNER_DATABASE_ROLE_HOST_DB
        Select Case UCase$(managedObjectType)
            Case UCase$(ADCAT_OBJECT_TYPE_QUERY)
                F1CollectQueryDependencies expectedRows, managedObjectID, managedObjectName, sourceDbRole, skippedEvidence
            Case UCase$(ADCAT_OBJECT_TYPE_FORM), UCase$(ADCAT_OBJECT_TYPE_REPORT)
                F1CollectFormOrReportDependencies expectedRows, managedObjectID, managedObjectName, managedObjectType, sourceDbRole, skippedEvidence
        End Select
        rs.MoveNext
    Loop
    rs.Close
End Sub

Private Sub F1CollectManagedFieldLookupDependencies(ByVal expectedRows As Object, ByRef skippedEvidence As String)
    On Error GoTo LookupError
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim sqlText As String
    Dim rowSourceText As String
    Dim rowSourceType As String
    Dim ownerID As Long
    Dim ownerName As String
    Dim ownerType As String
    Dim sourceDbRole As String
    Dim fieldName As String
    Set db = ResolveCatalogDb()
    sqlText = "SELECT f.[" & FIELD_MANAGED_OBJECT_ID & "],f.[" & FIELD_MANAGED_OBJECT_FIELD_NAME & "],f.[" & FIELD_MANAGED_OBJECT_FIELD_LOOKUP_ROW_SOURCE_TYPE & "],f.[" & FIELD_MANAGED_OBJECT_FIELD_LOOKUP_ROW_SOURCE & "],r." & SQL_FIELD_OBJECT_NAME & ",r.[" & FIELD_RESOLVED_OBJECT_TYPE & "],r.[" & FIELD_RESOLVED_OBJECT_SOURCE_DB_ROLE & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectFields") & "] AS f INNER JOIN [" & ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_ManagedObjectsResolved") & "] AS r ON f.[" & FIELD_MANAGED_OBJECT_ID & "]=r.[" & FIELD_MANAGED_OBJECT_ID & "] WHERE Nz(f.[" & FIELD_MANAGED_OBJECT_FIELD_IS_ACTIVE & "],False)<>False AND Len(Trim(Nz(f.[" & FIELD_MANAGED_OBJECT_FIELD_LOOKUP_ROW_SOURCE & "],'')))>0 AND r.[" & FIELD_MANAGED_OBJECT_STATUS & "]=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ";"
    Set rs = db.OpenRecordset(sqlText, dbOpenSnapshot)
    Do While rs.EOF = False
        PumpSetupResponsiveness
        ownerID = CLng(rs.fields(FIELD_MANAGED_OBJECT_ID).value)
        fieldName = Trim$(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_FIELD_NAME).value, vbNullString)))
        rowSourceType = Trim$(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_FIELD_LOOKUP_ROW_SOURCE_TYPE).value, vbNullString)))
        rowSourceText = Trim$(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_FIELD_LOOKUP_ROW_SOURCE).value, vbNullString)))
        ownerName = Trim$(CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString)))
        ownerType = Trim$(CStr(Nz(rs.fields(FIELD_RESOLVED_OBJECT_TYPE).value, vbNullString)))
        sourceDbRole = Trim$(CStr(Nz(rs.fields(FIELD_RESOLVED_OBJECT_SOURCE_DB_ROLE).value, vbNullString)))
        If Len(sourceDbRole) = 0 Then sourceDbRole = CONFIG_OWNER_DATABASE_ROLE_HOST_DB
        If InStr(1, rowSourceType, "Value List", vbTextCompare) = 0 Then F1CollectTableQuerySourceExpression expectedRows, ownerID, ownerName, ownerType, sourceDbRole, rowSourceText, fieldName & ".LookupRowSource", True, skippedEvidence
        rs.MoveNext
    Loop
    rs.Close
    Exit Sub
LookupError:
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    skippedEvidence = SharedText_AppendNonBlankLine(skippedEvidence, "Managed-field lookup dependencies could not be fully inspected. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description)
    On Error GoTo 0
End Sub

Private Sub F1CollectConfiguredMacroDependencies(ByVal expectedRows As Object, ByRef skippedEvidence As String)
    On Error GoTo ConfigError
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim tableName As String
    Dim generatedMacroName As String
    Dim MacroAction As String
    Dim targetName As String
    Dim dependencyObjectType As String
    Dim dependencyType As String
    Dim databaseRole As String
    Dim ownerID As Long
    Set db = ResolveCatalogDb()
    tableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Config")
    If SharedDao_TableExists(db, tableName) = False Then Exit Sub
    If SharedDao_TableFieldExists(db, tableName, FIELD_GENERATED_MACRO_OBJECT_NAME) = False Or SharedDao_TableFieldExists(db, tableName, FIELD_MACRO_ACTION) = False Or SharedDao_TableFieldExists(db, tableName, FIELD_CONFIG_OWNER_DATABASE_ROLE) = False Then skippedEvidence = SharedText_AppendNonBlankLine(skippedEvidence, "Configured macro dependencies were skipped because ADC_Config lacks required target fields."): Exit Sub
    Set rs = db.OpenRecordset("SELECT * FROM [" & tableName & "] WHERE Nz([" & FIELD_ACTIVE & "],False)<>False AND Len(Trim(Nz([" & FIELD_GENERATED_MACRO_OBJECT_NAME & "],'')))>0 ORDER BY [" & FIELD_GENERATED_MACRO_OBJECT_NAME & "];", dbOpenSnapshot)
    Do While rs.EOF = False
        PumpSetupResponsiveness
        generatedMacroName = Trim$(CStr(Nz(rs.fields(FIELD_GENERATED_MACRO_OBJECT_NAME).value, vbNullString)))
        ownerID = ManagedObjectIDByName(generatedMacroName, ADCAT_OBJECT_TYPE_MACRO)
        If ownerID > 0 Then
            MacroAction = Trim$(CStr(Nz(rs.fields(FIELD_MACRO_ACTION).value, vbNullString)))
            databaseRole = Trim$(CStr(Nz(rs.fields(FIELD_CONFIG_OWNER_DATABASE_ROLE).value, vbNullString)))
            If Len(databaseRole) = 0 Then databaseRole = CONFIG_OWNER_DATABASE_ROLE_HOST_DB
            targetName = vbNullString
            dependencyObjectType = vbNullString
            dependencyType = ADCAT_DEPENDENCY_TYPE_ACCESS_OBJECT
            Select Case UCase$(MacroAction)
                Case UCase$(ACTION_RUNCODE)
                    If SharedDao_TableFieldExists(db, tableName, FIELD_TARGET_PROCEDURE_NAME) Then targetName = Trim$(CStr(Nz(rs.fields(FIELD_TARGET_PROCEDURE_NAME).value, vbNullString)))
                    dependencyType = ADCAT_DEPENDENCY_TYPE_VBA_PROCEDURE
                Case UCase$(ACTION_OPENFORM)
                    If SharedDao_TableFieldExists(db, tableName, FIELD_TARGET_OBJECT_NAME) Then targetName = Trim$(CStr(Nz(rs.fields(FIELD_TARGET_OBJECT_NAME).value, vbNullString)))
                    dependencyObjectType = ADCAT_OBJECT_TYPE_FORM
                Case UCase$(ACTION_OPENTABLE)
                    If SharedDao_TableFieldExists(db, tableName, FIELD_TARGET_OBJECT_NAME) Then targetName = Trim$(CStr(Nz(rs.fields(FIELD_TARGET_OBJECT_NAME).value, vbNullString)))
                    dependencyObjectType = ADCAT_OBJECT_TYPE_TABLE
                Case UCase$(ACTION_OPENQUERY)
                    If SharedDao_TableFieldExists(db, tableName, FIELD_TARGET_OBJECT_NAME) Then targetName = Trim$(CStr(Nz(rs.fields(FIELD_TARGET_OBJECT_NAME).value, vbNullString)))
                    dependencyObjectType = ADCAT_OBJECT_TYPE_QUERY
                Case UCase$(ACTION_OPENREPORT)
                    If SharedDao_TableFieldExists(db, tableName, FIELD_TARGET_OBJECT_NAME) Then targetName = Trim$(CStr(Nz(rs.fields(FIELD_TARGET_OBJECT_NAME).value, vbNullString)))
                    dependencyObjectType = ADCAT_OBJECT_TYPE_REPORT
                Case UCase$(ACTION_RUNMACRO)
                    If SharedDao_TableFieldExists(db, tableName, FIELD_TARGET_OBJECT_NAME) Then targetName = Trim$(CStr(Nz(rs.fields(FIELD_TARGET_OBJECT_NAME).value, vbNullString)))
                    dependencyObjectType = ADCAT_OBJECT_TYPE_MACRO
            End Select
            If Len(targetName) > 0 Then F1AddExpectedManagedDependency expectedRows, ownerID, generatedMacroName, ADCAT_OBJECT_TYPE_MACRO, targetName, dependencyObjectType, dependencyType, databaseRole, "ConfiguredMacro." & MacroAction
        End If
        rs.MoveNext
    Loop
    rs.Close
    Exit Sub
ConfigError:
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    skippedEvidence = SharedText_AppendNonBlankLine(skippedEvidence, "Configured macro dependencies could not be fully inspected. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description)
    On Error GoTo 0
End Sub

Private Sub F1CollectManagedActionPayloadDependencies(ByVal expectedRows As Object, ByRef skippedEvidence As String)
    On Error GoTo PayloadError
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim tableName As String
    Dim ownerID As Long
    Dim ownerName As String
    Dim ownerType As String
    Dim ProcedureName As String
    Set db = ResolveCatalogDb()
    tableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads")
    If SharedDao_TableExists(db, tableName) = False Then Exit Sub
    Set rs = db.OpenRecordset("SELECT p.[" & FIELD_MANAGED_OBJECT_ID & "],p.[" & FIELD_ACTION_PROCEDURE_NAME & "],p.[" & FIELD_RUN_CODE_WRAPPER_NAME & "],m." & SQL_FIELD_OBJECT_NAME & ",m." & SQL_FIELD_OBJECT_TYPE & " FROM [" & tableName & "] AS p INNER JOIN [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] AS m ON p.[" & FIELD_MANAGED_OBJECT_ID & "]=m." & SQL_FIELD_ID & " WHERE Nz(p.[" & FIELD_PAYLOAD_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND Nz(m.[" & FIELD_MANAGED_OBJECT_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ";", dbOpenSnapshot)
    Do While rs.EOF = False
        PumpSetupResponsiveness
        ownerID = CLng(rs.fields(FIELD_MANAGED_OBJECT_ID).value)
        ownerName = Trim$(CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString)))
        ownerType = Trim$(CStr(Nz(rs.fields(FIELD_OBJECT_TYPE).value, vbNullString)))
        ProcedureName = Trim$(CStr(Nz(rs.fields(FIELD_RUN_CODE_WRAPPER_NAME).value, vbNullString)))
        If Len(ProcedureName) = 0 Then ProcedureName = Trim$(CStr(Nz(rs.fields(FIELD_ACTION_PROCEDURE_NAME).value, vbNullString)))
        If Len(ProcedureName) > 0 Then F1AddExpectedManagedDependency expectedRows, ownerID, ownerName, ownerType, ProcedureName, vbNullString, ADCAT_DEPENDENCY_TYPE_VBA_PROCEDURE, CONFIG_OWNER_DATABASE_ROLE_CODE_DB, "ManagedActionPayload"
        rs.MoveNext
    Loop
    rs.Close
    Exit Sub
PayloadError:
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    skippedEvidence = SharedText_AppendNonBlankLine(skippedEvidence, "Managed action-payload dependencies could not be fully inspected. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description)
    On Error GoTo 0
End Sub

Private Sub F1AssignManagedDependencySortOrders(ByVal expectedRows As Object)
    Dim keys As Variant
    Dim itemIndex As Long
    Dim rowData As Variant
    Dim priorOwnerID As Long
    Dim currentOwnerID As Long
    Dim nextSortOrder As Long
    If expectedRows.count = 0 Then Exit Sub
    keys = SortedDictionaryKeys(expectedRows)
    priorOwnerID = -1
    For itemIndex = LBound(keys) To UBound(keys)
        rowData = expectedRows(CStr(keys(itemIndex)))
        currentOwnerID = CLng(rowData(0))
        If currentOwnerID <> priorOwnerID Then nextSortOrder = 10 Else nextSortOrder = nextSortOrder + 10
        rowData(9) = nextSortOrder
        expectedRows(CStr(keys(itemIndex))) = rowData
        priorOwnerID = currentOwnerID
    Next itemIndex
End Sub

Private Function F1ExpectedManagedDependencyDescription(ByVal rowData As Variant) As String
    Dim targetKind As String
    targetKind = CStr(rowData(4))
    If Len(CStr(rowData(3))) > 0 Then targetKind = CStr(rowData(3))
    F1ExpectedManagedDependencyDescription = CStr(rowData(8)) & " [" & CStr(rowData(7)) & "] depends on " & targetKind & " [" & CStr(rowData(2)) & "] through " & Replace(CStr(rowData(6)), ";", ", ") & "."
End Function

Private Function F1ExpectedManagedDependencyPayloadPart(ByVal rowData As Variant) As String
    F1ExpectedManagedDependencyPayloadPart = FingerprintTokenPart(CStr(rowData(0))) & FingerprintTokenPart(CStr(rowData(1))) & FingerprintTokenPart(CStr(rowData(2))) & FingerprintTokenPart(CStr(rowData(3))) & FingerprintTokenPart(CStr(rowData(4))) & FingerprintTokenPart(CStr(rowData(5))) & FingerprintTokenPart(ADCAT_STATUS_ACTIVE) & FingerprintTokenPart(CStr(rowData(9))) & FingerprintTokenPart(F1ExpectedManagedDependencyDescription(rowData)) & FingerprintTokenPart(Left$(CStr(rowData(6)), 255)) & FingerprintTokenPart("True") & FingerprintTokenPart("The owning managed object may not operate as designed when this dependency is unavailable.") & FingerprintTokenPart(DOCUMENTATION_STATUS_COMPLETE) & FingerprintTokenPart(PHASE_F_MANAGED_DEPENDENCY_DEFAULT_SOURCE) & FingerprintTokenPart("Generated by Setup F1 from authoritative finalized object/configuration evidence. Evidence: " & CStr(rowData(6)))
End Function

Private Function F1ManagedDependencyRecordPayloadPart(ByVal rs As DAO.Recordset) As String
    F1ManagedDependencyRecordPayloadPart = _
        FingerprintTokenPart(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_ID).value, 0))) & _
        FingerprintTokenPart(CStr(Nz(rs.fields(FIELD_DEPENDS_ON_MANAGED_OBJECT_ID).value, 0))) & _
        FingerprintTokenPart(CStr(Nz(rs.fields(FIELD_DEPENDENCY_NAME).value, vbNullString))) & _
        FingerprintTokenPart(CStr(Nz(rs.fields(FIELD_DEPENDENCY_OBJECT_TYPE).value, vbNullString))) & _
        FingerprintTokenPart(CStr(Nz(rs.fields(FIELD_DEPENDENCY_TYPE).value, vbNullString))) & _
        FingerprintTokenPart(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_DATABASE_ROLE).value, vbNullString))) & _
        FingerprintTokenPart(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_STATUS).value, vbNullString))) & _
        FingerprintTokenPart(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value, 0))) & _
        FingerprintTokenPart(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_DETAIL_DESCRIPTION).value, vbNullString))) & _
        FingerprintTokenPart(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_PURPOSE).value, vbNullString))) & _
        FingerprintTokenPart(CStr(CBool(Nz(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_IS_REQUIRED).value, False)))) & _
        FingerprintTokenPart(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_FAILURE_IMPACT).value, vbNullString))) & _
        FingerprintTokenPart(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_DOCUMENTATION_STATUS).value, vbNullString))) & _
        FingerprintTokenPart(CStr(Nz(rs.fields(FIELD_DEFAULT_SOURCE).value, vbNullString))) & _
        FingerprintTokenPart(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_NOTES).value, vbNullString)))
End Function

Private Function F1BuildExpectedManagedDependencies(ByRef skippedEvidence As String) As Object
    Dim expectedRows As Object
    Set expectedRows = CreateObject("Scripting.Dictionary")
    expectedRows.CompareMode = vbBinaryCompare
    skippedEvidence = vbNullString
    F1CollectCanonicalGeneratedFormDependencies expectedRows, skippedEvidence
    F1CollectCanonicalManagedReportDependencies expectedRows, skippedEvidence
    F1CollectManagedObjectDependenciesFromFinalizedObjects expectedRows, skippedEvidence
    F1CollectManagedFieldLookupDependencies expectedRows, skippedEvidence
    F1CollectConfiguredMacroDependencies expectedRows, skippedEvidence
    F1CollectManagedActionPayloadDependencies expectedRows, skippedEvidence
    F1AssignManagedDependencySortOrders expectedRows
    Set F1BuildExpectedManagedDependencies = expectedRows
End Function

Private Function F1ActiveManualManagedDependencyIdentities(ByVal db As DAO.Database) As Object
    Dim identities As Object
    Dim rs As DAO.Recordset
    Dim identityKey As String
    Set identities = CreateObject("Scripting.Dictionary")
    identities.CompareMode = vbBinaryCompare
    Set rs = db.OpenRecordset("SELECT * FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies") & "] WHERE Nz([" & FIELD_DEFAULT_SOURCE & "],'')<>" & SharedDao_SqlQuote(PHASE_F_MANAGED_DEPENDENCY_DEFAULT_SOURCE) & " AND (Len(Trim(Nz([" & FIELD_MANAGED_OBJECT_DEPENDENCY_STATUS & "],'')))=0 OR UCase(Trim(Nz([" & FIELD_MANAGED_OBJECT_DEPENDENCY_STATUS & "],'')))=" & SharedDao_SqlQuote(UCase$(ADCAT_STATUS_ACTIVE)) & ");", dbOpenSnapshot)
    Do While rs.EOF = False
        identityKey = F1ManagedDependencyIdentityKey(CLng(Nz(rs.fields(FIELD_MANAGED_OBJECT_ID).value, 0)), CLng(Nz(rs.fields(FIELD_DEPENDS_ON_MANAGED_OBJECT_ID).value, 0)), CStr(Nz(rs.fields(FIELD_DEPENDENCY_NAME).value, vbNullString)), CStr(Nz(rs.fields(FIELD_DEPENDENCY_OBJECT_TYPE).value, vbNullString)), CStr(Nz(rs.fields(FIELD_DEPENDENCY_TYPE).value, vbNullString)), CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_DATABASE_ROLE).value, vbNullString)))
        If identities.Exists(identityKey) = False Then identities.Add identityKey, True
        rs.MoveNext
    Loop
    rs.Close
    Set F1ActiveManualManagedDependencyIdentities = identities
End Function

Private Function F1ExpectedManagedDependencyToken(ByVal expectedRows As Object, ByVal manualIdentities As Object, ByRef expectedRowCount As Long) As String
    Dim keys As Variant
    Dim itemIndex As Long
    Dim dependencyKey As String
    Dim payloadText As String
    expectedRowCount = 0
    payloadText = FingerprintTokenPart(PHASE_F_MANAGED_DEPENDENCY_PROOF_VERSION)
    If expectedRows.count > 0 Then
        keys = SortedDictionaryKeys(expectedRows)
        For itemIndex = LBound(keys) To UBound(keys)
            dependencyKey = CStr(keys(itemIndex))
            If manualIdentities.Exists(dependencyKey) = False Then
                payloadText = payloadText & F1ExpectedManagedDependencyPayloadPart(expectedRows(dependencyKey))
                expectedRowCount = expectedRowCount + 1
            End If
        Next itemIndex
    End If
    F1ExpectedManagedDependencyToken = FingerprintFromPayload(payloadText)
End Function

Private Function F1ActualManagedDependencyToken(ByVal db As DAO.Database, ByRef actualRowCount As Long) As String
    Dim rs As DAO.Recordset
    Dim actualPayloadByIdentity As Object
    Dim identityKey As String
    Dim keys As Variant
    Dim itemIndex As Long
    Dim payloadText As String
    actualRowCount = 0
    payloadText = FingerprintTokenPart(PHASE_F_MANAGED_DEPENDENCY_PROOF_VERSION)
    Set actualPayloadByIdentity = CreateObject("Scripting.Dictionary")
    actualPayloadByIdentity.CompareMode = vbBinaryCompare
    Set rs = db.OpenRecordset("SELECT * FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies") & "] WHERE [" & FIELD_DEFAULT_SOURCE & "]=" & SharedDao_SqlQuote(PHASE_F_MANAGED_DEPENDENCY_DEFAULT_SOURCE) & ";", dbOpenSnapshot)
    Do While rs.EOF = False
        identityKey = F1ManagedDependencyIdentityKey(CLng(Nz(rs.fields(FIELD_MANAGED_OBJECT_ID).value, 0)), CLng(Nz(rs.fields(FIELD_DEPENDS_ON_MANAGED_OBJECT_ID).value, 0)), CStr(Nz(rs.fields(FIELD_DEPENDENCY_NAME).value, vbNullString)), CStr(Nz(rs.fields(FIELD_DEPENDENCY_OBJECT_TYPE).value, vbNullString)), CStr(Nz(rs.fields(FIELD_DEPENDENCY_TYPE).value, vbNullString)), CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_DATABASE_ROLE).value, vbNullString)))
        If actualPayloadByIdentity.Exists(identityKey) Then Err.Raise vbObjectError + 9617, "F1ActualManagedDependencyToken", "Duplicate Setup F1-owned dependency identity remains in MAC_Deps." & vbCrLf & "Identity: " & Replace(identityKey, Chr$(30), " | ")
        actualPayloadByIdentity.Add identityKey, F1ManagedDependencyRecordPayloadPart(rs)
        actualRowCount = actualRowCount + 1
        rs.MoveNext
    Loop
    rs.Close
    If actualPayloadByIdentity.count > 0 Then
        keys = SortedDictionaryKeys(actualPayloadByIdentity)
        For itemIndex = LBound(keys) To UBound(keys)
            payloadText = payloadText & CStr(actualPayloadByIdentity(CStr(keys(itemIndex))))
        Next itemIndex
    End If
    F1ActualManagedDependencyToken = FingerprintFromPayload(payloadText)
End Function

Private Function F1ManagedDependencyRollbackSql(ByVal db As DAO.Database) As String
    Dim rs As DAO.Recordset
    Dim tdf As DAO.tableDef
    Dim fieldNames As Variant
    Dim fieldName As Variant
    Dim columnText As String
    Dim valueText As String
    Dim insertSql As String
    Dim resultText As String
    Dim tableName As String
    tableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies")
    resultText = "DELETE FROM [" & tableName & "] WHERE [" & FIELD_DEFAULT_SOURCE & "]=" & SharedDao_SqlQuote(PHASE_F_MANAGED_DEPENDENCY_DEFAULT_SOURCE) & ";"
    Set tdf = db.TableDefs(tableName)
    fieldNames = Split(CanonicalTableFieldOrderText(tableName), "|")
    Set rs = db.OpenRecordset("SELECT * FROM [" & tableName & "] WHERE [" & FIELD_DEFAULT_SOURCE & "]=" & SharedDao_SqlQuote(PHASE_F_MANAGED_DEPENDENCY_DEFAULT_SOURCE) & " ORDER BY " & SQL_FIELD_ID & ";", dbOpenSnapshot)
    Do While rs.EOF = False
        columnText = vbNullString
        valueText = vbNullString
        For Each fieldName In fieldNames
            If StrComp(CStr(fieldName), FIELD_ID, vbTextCompare) <> 0 Then
                If Len(columnText) > 0 Then columnText = columnText & ",": valueText = valueText & ","
                columnText = columnText & "[" & CStr(fieldName) & "]"
                valueText = valueText & ManagedObjectSqlLiteralForField(rs.fields(CStr(fieldName)).value, tdf.fields(CStr(fieldName)).Type)
            End If
        Next fieldName
        insertSql = "INSERT INTO [" & tableName & "] (" & columnText & ") VALUES (" & valueText & ");"
        resultText = resultText & PHASE_F_MANAGED_DEPENDENCY_ROLLBACK_DELIMITER & insertSql
        rs.MoveNext
    Loop
    rs.Close
    F1ManagedDependencyRollbackSql = resultText
End Function

Public Sub RestoreManagedObjectDependenciesFromSetupRollback(ByVal rollbackSql As String)
    Dim db As DAO.Database
    Dim statements As Variant
    Dim statementItem As Variant
    Set db = ResolveCatalogDb()
    statements = Split(rollbackSql, PHASE_F_MANAGED_DEPENDENCY_ROLLBACK_DELIMITER)
    For Each statementItem In statements
        If Len(Trim$(CStr(statementItem))) > 0 Then db.Execute CStr(statementItem), dbFailOnError
    Next statementItem
    CatalogMarkSetupDomainsDirty CATALOG_DIRTY_DEPENDENCIES
End Sub

Private Sub F1InsertExpectedManagedDependencies(ByVal db As DAO.Database, ByVal expectedRows As Object, ByVal manualIdentities As Object, ByRef insertedCount As Long)
    Dim rs As DAO.Recordset
    Dim keys As Variant
    Dim itemIndex As Long
    Dim dependencyKey As String
    Dim rowData As Variant
    Set rs = db.OpenRecordset(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies"), dbOpenDynaset)
    insertedCount = 0
    If expectedRows.count > 0 Then
        keys = SortedDictionaryKeys(expectedRows)
        For itemIndex = LBound(keys) To UBound(keys)
            dependencyKey = CStr(keys(itemIndex))
            If manualIdentities.Exists(dependencyKey) = False Then
                rowData = expectedRows(dependencyKey)
                rs.AddNew
                rs.fields(FIELD_MANAGED_OBJECT_ID).value = CLng(rowData(0))
                If CLng(rowData(1)) > 0 Then rs.fields(FIELD_DEPENDS_ON_MANAGED_OBJECT_ID).value = CLng(rowData(1)) Else rs.fields(FIELD_DEPENDS_ON_MANAGED_OBJECT_ID).value = Null
                rs.fields(FIELD_DEPENDENCY_NAME).value = CStr(rowData(2))
                If Len(CStr(rowData(3))) > 0 Then rs.fields(FIELD_DEPENDENCY_OBJECT_TYPE).value = CStr(rowData(3)) Else rs.fields(FIELD_DEPENDENCY_OBJECT_TYPE).value = Null
                rs.fields(FIELD_DEPENDENCY_TYPE).value = CStr(rowData(4))
                If Len(CStr(rowData(5))) > 0 Then rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_DATABASE_ROLE).value = CStr(rowData(5)) Else rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_DATABASE_ROLE).value = Null
                rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_STATUS).value = ADCAT_STATUS_ACTIVE
                rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value = CLng(rowData(9))
                rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_DETAIL_DESCRIPTION).value = F1ExpectedManagedDependencyDescription(rowData)
                rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_PURPOSE).value = Left$(CStr(rowData(6)), 255)
                rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_IS_REQUIRED).value = True
                rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_FAILURE_IMPACT).value = "The owning managed object may not operate as designed when this dependency is unavailable."
                rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_DOCUMENTATION_STATUS).value = DOCUMENTATION_STATUS_COMPLETE
                rs.fields(FIELD_DEFAULT_SOURCE).value = PHASE_F_MANAGED_DEPENDENCY_DEFAULT_SOURCE
                rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_NOTES).value = "Generated by Setup F1 from authoritative finalized object/configuration evidence. Evidence: " & CStr(rowData(6))
                rs.Update
                insertedCount = insertedCount + 1
            End If
        Next itemIndex
    End If
    rs.Close
End Sub

Public Function ManagedObjectDependenciesCurrentForSetup(ByRef detailText As String, Optional ByRef dependencyToken As String = vbNullString) As Boolean
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim expectedRows As Object
    Dim manualIdentities As Object
    Dim skippedEvidence As String
    Dim expectedToken As String
    Dim actualToken As String
    Dim expectedCount As Long
    Dim actualCount As Long
    detailText = vbNullString
    dependencyToken = vbNullString
    Set db = ResolveCatalogDb()
    If SharedDao_TableFieldExists(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies"), FIELD_DEFAULT_SOURCE) = False Then detailText = "MAC_Deps is missing the B1-owned DefaultSource field required for safe Phase F reconciliation.": Exit Function
    Set expectedRows = F1BuildExpectedManagedDependencies(skippedEvidence)
    Set manualIdentities = F1ActiveManualManagedDependencyIdentities(db)
    expectedToken = F1ExpectedManagedDependencyToken(expectedRows, manualIdentities, expectedCount)
    actualToken = F1ActualManagedDependencyToken(db, actualCount)
    If StrComp(expectedToken, actualToken, vbBinaryCompare) <> 0 Then
        detailText = "Phase F generated dependency rows are not current. Expected generated rows: " & CStr(expectedCount) & "; actual generated rows: " & CStr(actualCount) & "."
        If Len(skippedEvidence) > 0 Then detailText = detailText & vbCrLf & skippedEvidence
        Exit Function
    End If
    dependencyToken = expectedToken
    detailText = "Phase F managed-object dependencies are current. Generated rows: " & CStr(actualCount) & "; preserved active manual identities: " & CStr(manualIdentities.count) & "."
    If Len(skippedEvidence) > 0 Then detailText = detailText & vbCrLf & "Exact dependency evidence intentionally skipped where it could not be proven:" & vbCrLf & skippedEvidence
    ManagedObjectDependenciesCurrentForSetup = True
    Exit Function
ErrHandler:
    dependencyToken = vbNullString
    detailText = "Could not verify Phase F managed-object dependencies. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
End Function

Public Function ReconcileManagedObjectDependenciesForSetup(ByRef detailText As String, Optional ByRef dependencyToken As String = vbNullString) As Boolean
    RequireSetupDomainMutationAllowed SETUP_DOMAIN_F1_MANAGED_DEPENDENCIES, "ReconcileManagedObjectDependenciesForSetup"
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim ws As DAO.workspace
    Dim expectedRows As Object
    Dim manualIdentities As Object
    Dim skippedEvidence As String
    Dim expectedToken As String
    Dim actualToken As String
    Dim rollbackSql As String
    Dim refreshDetail As String
    Dim refreshedCatalogToken As String
    Dim expectedCount As Long
    Dim actualCount As Long
    Dim insertedCount As Long
    Dim deletedCount As Long
    Dim transactionStarted As Boolean
    detailText = vbNullString
    dependencyToken = vbNullString
    Set db = ResolveCatalogDb()
    If SharedDao_TableFieldExists(db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies"), FIELD_DEFAULT_SOURCE) = False Then Err.Raise vbObjectError + 9614, "ReconcileManagedObjectDependenciesForSetup", "MAC_Deps is missing the B1-owned DefaultSource field required by Setup F1."
    Set expectedRows = F1BuildExpectedManagedDependencies(skippedEvidence)
    Set manualIdentities = F1ActiveManualManagedDependencyIdentities(db)
    expectedToken = F1ExpectedManagedDependencyToken(expectedRows, manualIdentities, expectedCount)
    actualToken = F1ActualManagedDependencyToken(db, actualCount)
    If StrComp(expectedToken, actualToken, vbBinaryCompare) <> 0 Then
        rollbackSql = F1ManagedDependencyRollbackSql(db)
        TrackSetupManagedObjectDependenciesRollback rollbackSql
        Set ws = DBEngine.Workspaces(0)
        ws.BeginTrans
        transactionStarted = True
        db.Execute "DELETE FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies") & "] WHERE [" & FIELD_DEFAULT_SOURCE & "]=" & SharedDao_SqlQuote(PHASE_F_MANAGED_DEPENDENCY_DEFAULT_SOURCE) & ";", dbFailOnError
        deletedCount = db.RecordsAffected
        F1InsertExpectedManagedDependencies db, expectedRows, manualIdentities, insertedCount
        ws.CommitTrans
        transactionStarted = False
        CatalogMarkSetupDomainsDirty CATALOG_DIRTY_DEPENDENCIES
    End If
    ' Verify the persisted F1-owned rows against the exact expected snapshot used for this reconciliation; do not rebuild live dependency evidence between write and immediate verification.
    actualToken = F1ActualManagedDependencyToken(db, actualCount)
    If StrComp(expectedToken, actualToken, vbBinaryCompare) <> 0 Then
        detailText = "Phase F persisted generated dependency rows do not match the authoritative reconciliation snapshot. Expected generated rows: " & CStr(expectedCount) & "; actual generated rows: " & CStr(actualCount) & "."
        If Len(skippedEvidence) > 0 Then detailText = detailText & vbCrLf & skippedEvidence
        Err.Raise vbObjectError + 9615, "ReconcileManagedObjectDependenciesForSetup", detailText
    End If
    dependencyToken = expectedToken
    If RefreshCompleteCatalogStateAfterDependencyWorkForSetup(refreshDetail, refreshedCatalogToken) = False Then Err.Raise vbObjectError + 9616, "ReconcileManagedObjectDependenciesForSetup", refreshDetail
    detailText = "F1 reconciled managed-object dependencies from finalized authoritative evidence. Generated rows expected/current: " & CStr(expectedCount) & "; replaced generated rows: " & CStr(deletedCount) & "; inserted generated rows: " & CStr(insertedCount) & "; preserved active manual identities: " & CStr(manualIdentities.count) & "." & vbCrLf & "DependencyToken=" & dependencyToken & vbCrLf & refreshDetail
    If Len(skippedEvidence) > 0 Then detailText = detailText & vbCrLf & "Exact dependency evidence intentionally skipped where it could not be proven:" & vbCrLf & skippedEvidence
    ReconcileManagedObjectDependenciesForSetup = True
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    If transactionStarted Then ws.Rollback
    On Error GoTo 0
    dependencyToken = vbNullString
    detailText = "Could not reconcile Setup F1 managed-object dependencies. Error " & CStr(savedErrNumber) & " from " & savedErrSource & ": " & savedErrDescription
End Function

Private Sub EnsureManagedObjectDependenciesTable()
    Dim tableName As String
    Dim fieldDefinitions As Collection
    Dim indexDefinitions As Collection
    tableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies")
    If B1ColdCreatedStructuralProofAvailable(tableName) Then
        RecordB1ColdCreateStructuralBypass tableName, 4
    Else
        Set fieldDefinitions = CatalogTableSchemaDefinitions(tableName)
        Set indexDefinitions = CatalogTableIndexDefinitions(tableName)
        EnsureCatalogTableExists tableName
        EnsureCatalogFieldsFromSchema tableName, fieldDefinitions
        EnsureManagedTableFieldOrder tableName, fieldDefinitions
        EnsureCatalogIndexesFromSchema tableName, indexDefinitions
    End If
    ApplyDefaultsOwnedLookupDefinitions tableName
End Sub

Private Function ManagedObjectDependencyIdentitySignature(ByVal rs As DAO.Recordset) As String
    'Identifies the dependency relationship without treating descriptive/policy content as identity.
    Dim fieldNames As Variant
    Dim fieldName As Variant
    Dim signatureText As String
    fieldNames = Array(FIELD_MANAGED_OBJECT_ID, FIELD_DEPENDS_ON_MANAGED_OBJECT_ID, FIELD_DEPENDENCY_NAME, FIELD_DEPENDENCY_OBJECT_TYPE, FIELD_DEPENDENCY_TYPE, FIELD_MANAGED_OBJECT_DEPENDENCY_DATABASE_ROLE)
    For Each fieldName In fieldNames
        PumpSetupResponsiveness
        signatureText = signatureText & LengthPrefixedVariant(rs.fields(CStr(fieldName)).value)
    Next fieldName
    ManagedObjectDependencyIdentitySignature = signatureText
End Function

Private Function ManagedObjectDependencyContentSignature(ByVal rs As DAO.Recordset) As String
    'Uses the canonical dependency schema authority so exact-row equality cannot drift from the current table contract.
    Dim canonicalFieldOrderText As String
    Dim fieldNames As Variant
    Dim fieldName As Variant
    Dim signatureText As String
    canonicalFieldOrderText = CanonicalTableFieldOrderText(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies"))
    If Len(canonicalFieldOrderText) = 0 Then Err.Raise vbObjectError + 9569, "ManagedObjectDependencyContentSignature", "The canonical MAC_Deps field-order authority is blank."
    fieldNames = Split(canonicalFieldOrderText, "|")
    For Each fieldName In fieldNames
        PumpSetupResponsiveness
        If StrComp(CStr(fieldName), FIELD_ID, vbTextCompare) <> 0 Then
            signatureText = signatureText & LengthPrefixedVariant(rs.fields(CStr(fieldName)).value)
        End If
    Next fieldName
    ManagedObjectDependencyContentSignature = signatureText
End Function

Private Function ManagedObjectDependenciesResolvedSql() As String
    Dim sqlText As String
    sqlText = "SELECT d." & SQL_FIELD_ID & " AS " & FIELD_DEPENDENCY_ID & ", d.[" & FIELD_MANAGED_OBJECT_ID & "], m." & SQL_FIELD_OBJECT_NAME & ", "
    sqlText = sqlText & "d.[" & FIELD_DEPENDS_ON_MANAGED_OBJECT_ID & "], dm." & SQL_FIELD_OBJECT_NAME & " AS " & FIELD_DEPENDS_ON_OBJECT_NAME & ", "
    sqlText = sqlText & "d.[" & FIELD_DEPENDENCY_NAME & "], d.[" & FIELD_DEPENDENCY_OBJECT_TYPE & "], d.[" & FIELD_DEPENDENCY_TYPE & "], "
    sqlText = sqlText & "d.[" & FIELD_MANAGED_OBJECT_DEPENDENCY_DATABASE_ROLE & "], d.[" & FIELD_MANAGED_OBJECT_DEPENDENCY_STATUS & "], "
    sqlText = sqlText & "d.[" & FIELD_MANAGED_OBJECT_DEPENDENCY_DETAIL_DESCRIPTION & "], "
    sqlText = sqlText & "d.[" & FIELD_MANAGED_OBJECT_DEPENDENCY_PURPOSE & "], d.[" & FIELD_MANAGED_OBJECT_DEPENDENCY_IS_REQUIRED & "], "
    sqlText = sqlText & "d.[" & FIELD_MANAGED_OBJECT_DEPENDENCY_FAILURE_IMPACT & "], d.[" & FIELD_MANAGED_OBJECT_DEPENDENCY_DOCUMENTATION_STATUS & "], "
    sqlText = sqlText & "d.[" & FIELD_DEFAULT_SOURCE & "], d.[" & FIELD_MANAGED_OBJECT_DEPENDENCY_NOTES & "] "
    sqlText = sqlText & "FROM ([" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies") & "] AS d LEFT JOIN [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] AS m ON d.[" & FIELD_MANAGED_OBJECT_ID & "]=m." & SQL_FIELD_ID & ") LEFT JOIN [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] AS dm ON d.[" & FIELD_DEPENDS_ON_MANAGED_OBJECT_ID & "]=dm." & SQL_FIELD_ID & " "
    sqlText = sqlText & "ORDER BY " & OrderByPolicyText("CATALOG_DEPENDENCIES_RESOLVED") & ";"
    ManagedObjectDependenciesResolvedSql = sqlText
End Function

Private Function ManagedObjectDependencyWhereText(ByVal managedObjectIDList As String) As String
    If Len(Trim$(managedObjectIDList)) = 0 Then ManagedObjectDependencyWhereText = "False" Else ManagedObjectDependencyWhereText = "[" & FIELD_MANAGED_OBJECT_ID & "] IN (" & managedObjectIDList & ") OR [" & FIELD_DEPENDS_ON_MANAGED_OBJECT_ID & "] IN (" & managedObjectIDList & ")"
End Function

Private Sub RemoveExactManagedObjectDependencyDuplicates(ByVal db As DAO.Database, ByVal canonicalIDs As Collection, ByRef removedCount As Long)
    'Removes only byte-for-byte equivalent dependency rows after duplicate IDs have been redirected to their canonical rows.
    Dim seen As Object
    Dim rs As DAO.Recordset
    Dim canonicalIDList As String
    Dim signatureText As String
    Dim dependencyID As Long
    removedCount = 0
    canonicalIDList = LongCollectionList(canonicalIDs)
    If Len(canonicalIDList) = 0 Then Exit Sub
    ' INTENTIONAL KEYED LOOKUP: seen provides keyed membership/lookup over source rows or state already read by RemoveExactManagedObjectDependencyDuplicates; it is a derived access path, not a second authority.
    Set seen = CreateObject("Scripting.Dictionary")
    seen.CompareMode = vbBinaryCompare
    Set rs = db.OpenRecordset("SELECT * FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies") & "] WHERE [" & FIELD_MANAGED_OBJECT_ID & "] IN (" & canonicalIDList & ") OR [" & FIELD_DEPENDS_ON_MANAGED_OBJECT_ID & "] IN (" & canonicalIDList & ") ORDER BY " & SQL_FIELD_ID & ";", dbOpenSnapshot)
    Do While Not rs.EOF
        PumpSetupResponsiveness
        dependencyID = CLng(rs.fields(FIELD_ID))
        signatureText = ManagedObjectDependencyContentSignature(rs)
        If seen.Exists(signatureText) Then
            db.Execute "DELETE FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies") & "] WHERE " & SQL_FIELD_ID & "=" & CStr(dependencyID) & ";", dbFailOnError
            removedCount = removedCount + db.RecordsAffected
        Else
            seen.Add signatureText, dependencyID
        End If
        rs.MoveNext
    Loop
    rs.Close
End Sub

Private Sub ValidateManagedObjectDependencyAudit(ByVal db As DAO.Database, ByVal auditedIDList As String)
    'Verifies that active incoming dependencies are Form-compatible and that the audited dependency set contains no exact duplicate rows.
    Dim rs As DAO.Recordset
    Dim seenContent As Object
    Dim seenIdentity As Object
    Dim contentSignatureText As String
    Dim identitySignatureText As String
    Dim dependencyStatusText As String
    Dim mismatchCount As Long
    Dim sqlText As String
    auditedIDList = Trim$(auditedIDList)
    If Len(auditedIDList) = 0 Then Exit Sub
    sqlText = "SELECT Count(*) AS " & SQL_FIELD_MISMATCH_COUNT & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies") & "] AS d INNER JOIN [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] AS m ON d.[" & FIELD_DEPENDS_ON_MANAGED_OBJECT_ID & "]=m." & SQL_FIELD_ID & " WHERE d.[" & FIELD_DEPENDS_ON_MANAGED_OBJECT_ID & "] IN (" & auditedIDList & ") AND (Len(Trim(Nz(d.[" & FIELD_MANAGED_OBJECT_DEPENDENCY_STATUS & "],'')))=0 OR UCase(Trim(Nz(d.[" & FIELD_MANAGED_OBJECT_DEPENDENCY_STATUS & "],'')))=" & SharedDao_SqlQuote(UCase$(ADCAT_STATUS_ACTIVE)) & ") AND (Nz(d.[" & FIELD_DEPENDENCY_NAME & "],'')<>Nz(m." & SQL_FIELD_OBJECT_NAME & ",'') OR UCase(Trim(Nz(d.[" & FIELD_DEPENDENCY_OBJECT_TYPE & "],'')))<>'FORM' OR UCase(Trim(Nz(d.[" & FIELD_DEPENDENCY_TYPE & "],''))) Not In (" & _
                FormCompatibleDependencyTypeSqlList() & "));"
    mismatchCount = ManagedFormAuditCount(db, sqlText)
    If mismatchCount <> 0 Then Err.Raise vbObjectError + 9061, "ValidateManagedObjectDependencyAudit", "Active incoming dependency rows retain stale or incompatible metadata after managed-form reconciliation." & vbCrLf & "Mismatch rows: " & CStr(mismatchCount)
    ' INTENTIONAL KEYED LOOKUP: seenContent, seenIdentity provides keyed membership/lookup over source rows or state already read by ValidateManagedObjectDependencyAudit; it is a derived access path, not a second
    ' authority.
    Set seenContent = CreateObject("Scripting.Dictionary")
    seenContent.CompareMode = vbBinaryCompare
    Set seenIdentity = CreateObject("Scripting.Dictionary")
    seenIdentity.CompareMode = vbBinaryCompare
    Set rs = db.OpenRecordset("SELECT * FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectDependencies") & "] WHERE [" & FIELD_MANAGED_OBJECT_ID & "] IN (" & auditedIDList & ") OR [" & FIELD_DEPENDS_ON_MANAGED_OBJECT_ID & "] IN (" & auditedIDList & ") ORDER BY " & SQL_FIELD_ID & ";", dbOpenSnapshot)
    Do While Not rs.EOF
        PumpSetupResponsiveness
        contentSignatureText = ManagedObjectDependencyContentSignature(rs)
        If seenContent.Exists(contentSignatureText) Then Err.Raise vbObjectError + 9095, "ValidateManagedObjectDependencyAudit", "An exact duplicate managed-object dependency remains after canonical reassignment." & vbCrLf & "Dependency row ID: " & CStr(CLng(rs.fields(FIELD_ID))) & vbCrLf & "Matching dependency row ID: " & CStr(CLng(seenContent(contentSignatureText)))
        seenContent.Add contentSignatureText, CLng(rs.fields(FIELD_ID))
        dependencyStatusText = Trim$(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_STATUS).value, vbNullString)))
        If Len(dependencyStatusText) = 0 Or StrComp(dependencyStatusText, ADCAT_STATUS_ACTIVE, vbTextCompare) = 0 Then
            identitySignatureText = ManagedObjectDependencyIdentitySignature(rs)
            If seenIdentity.Exists(identitySignatureText) Then Err.Raise vbObjectError + 9098, "ValidateManagedObjectDependencyAudit", "Conflicting active managed-object dependency definitions share the same dependency identity after canonical reassignment." & vbCrLf & "Dependency row ID: " & CStr(CLng(rs.fields(FIELD_ID))) & vbCrLf & "Conflicting dependency row ID: " & CStr(CLng(seenIdentity(identitySignatureText)))
            seenIdentity.Add identitySignatureText, CLng(rs.fields(FIELD_ID))
        End If
        rs.MoveNext
    Loop
    rs.Close
End Sub


Private Sub DefaultLookupRow(ByVal tableName As String, ByVal codeFieldName As String, ByVal displayFieldName As String, ByVal codeValue As String, ByVal displayName As String, ByVal descriptionText As String, ByVal SortOrder As Long, ByVal repairDefaultRows As Boolean, Optional ByVal notesText As String = vbNullString)
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim sqlText As String
    Dim isNewRow As Boolean
    Set db = ResolveCatalogDb()
    sqlText = "SELECT * FROM [" & tableName & "] WHERE [" & codeFieldName & "]=" & SharedDao_SqlQuote(codeValue) & ";"
    Set rs = db.OpenRecordset(sqlText, dbOpenDynaset)
    isNewRow = rs.EOF
    If isNewRow Then
        rs.AddNew
        rs.fields(codeFieldName).value = codeValue
        rs.fields(displayFieldName).value = displayName
        rs.fields(FIELD_DESCRIPTION).value = descriptionText
        SetRecordsetFieldValueWithSource rs, FIELD_LOOKUP_ACTIVE, DEFAULT_NAVIGATION_PANE_GROUP_LOOKUP_ACTIVE, "DEFAULT_NAVIGATION_PANE_GROUP_LOOKUP_ACTIVE"
        rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value = SortOrder
        If Len(Trim$(notesText)) > 0 Then rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_NOTES).value = notesText
    ElseIf repairDefaultRows Then
        rs.Edit
        If Len(Trim$(CStr(Nz(rs.fields(displayFieldName).value, vbNullString)))) = 0 Then rs.fields(displayFieldName).value = displayName
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_DESCRIPTION).value, vbNullString)))) = 0 Then rs.fields(FIELD_DESCRIPTION).value = descriptionText
        If IsNull(rs.fields(FIELD_LOOKUP_ACTIVE).value) Then SetRecordsetFieldValueWithSource rs, FIELD_LOOKUP_ACTIVE, DEFAULT_NAVIGATION_PANE_GROUP_LOOKUP_ACTIVE, "DEFAULT_NAVIGATION_PANE_GROUP_LOOKUP_ACTIVE"
        If IsNull(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value) Then rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value = SortOrder
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_NOTES).value, vbNullString)))) = 0 And Len(Trim$(notesText)) > 0 Then rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_NOTES).value = notesText
    Else
        rs.Close
        Exit Sub
    End If
    rs.Update
    rs.Close
    Exit Sub
ErrHandler:
    Dim originalErrNumber As Long
    Dim originalErrDescription As String
    originalErrNumber = Err.Number
    originalErrDescription = Err.Description
    Err.Raise originalErrNumber, "DefaultLookupRow", "Unable to default managed object catalog lookup row without overwriting existing user values." & vbCrLf & "Table: " & tableName & vbCrLf & "Code field: " & codeFieldName & vbCrLf & "Code: " & codeValue & vbCrLf & "Description: " & originalErrDescription
End Sub

Private Sub DefaultObjectCategory(ByVal categoryCode As String, ByVal categoryName As String, ByVal descriptionText As String, ByVal SortOrder As Long, ByVal defaultObjectType As String, ByVal defaultSetupAction As String, ByVal defaultObjectSourceDbRole As String, ByVal defaultConfigOwnerDatabaseRole As String, ByVal defaultEnvironmentScope As String, ByVal defaultSetupStage As String, ByVal defaultManagedObjectPurpose As String, ByVal defaultNavPaneVisibilityPolicy As String, ByVal repairDefaultRows As Boolean)
