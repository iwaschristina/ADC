    Dim ribbonTitleDefault As String
    Dim resolutionTimer As Single
    resolutionTimer = Timer
    defaultDescription = ManagedObjectDefaultDescriptionForSetup(objectName, categoryCode, objectTypeCode, descriptionText)
    ribbonTitleDefault = ManagedObjectAuthoritativeRibbonTitle(objectName)
    If TryResolveAddInReviewPlacementDefinition(objectName, objectTypeCode, logicalIdentity, navigationSettingKey, ribbonTabKey, ribbonTabLabel, ribbonGroupLabel, ribbonGroupSortOrder, directlyExposedOnRibbon, definitionSource) Then
        mManagedDefinitionCategoryResolutionElapsedSeconds = mManagedDefinitionCategoryResolutionElapsedSeconds + ElapsedSecondsFromTimer(resolutionTimer)
        DefaultManagedObject objectName, categoryCode, objectTypeCode, defaultDescription, SortOrder, repairDefaultRows, ribbonTabKey, ribbonTabLabel, ribbonGroupLabel, ribbonGroupSortOrder, ribbonTitleDefault
    Else
        mManagedDefinitionCategoryResolutionElapsedSeconds = mManagedDefinitionCategoryResolutionElapsedSeconds + ElapsedSecondsFromTimer(resolutionTimer)
        DefaultManagedObject objectName, categoryCode, objectTypeCode, defaultDescription, SortOrder, repairDefaultRows, vbNullString, vbNullString, vbNullString, 0, ribbonTitleDefault
    End If
End Sub

' Purpose: Resolves managed object default description for setup from the supplied/current ADC state, using `CreateObject` and `End` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   objectName (Input; String): Canonical or physical name identifying the object targeted by this operation.
'   categoryCode (Input; String): Canonical code used to classify or select the category code behavior.
'   objectTypeCode (Input; String): Canonical code used to classify or select the object type code behavior.
'   fallbackDescription (Input Optional; String): Fallback description text included in this procedure's user-facing or diagnostic output; blank handling follows the explicit branches in the routine. Default:
'     vbNullString.
' Returns: String: Returns the description text produced by this routine. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not
'   resolved.
Public Function ManagedObjectDefaultDescriptionForSetup(ByVal objectName As String, ByVal categoryCode As String, ByVal objectTypeCode As String, Optional ByVal fallbackDescription As String = vbNullString) As String
    'Returns the authoritative setup default description for one managed object without changing catalog ownership, placement, status, or other metadata.
    Dim descriptionText As String
    Dim cacheKey As String
    categoryCode = Trim$(categoryCode)
    objectTypeCode = Trim$(objectTypeCode)
    cacheKey = UCase$(objectTypeCode) & Chr$(30) & UCase$(objectName)
    If mManagedDefinitionDescriptionCache Is Nothing Then
        Set mManagedDefinitionDescriptionCache = CreateObject("Scripting.Dictionary")
        mManagedDefinitionDescriptionCache.CompareMode = vbBinaryCompare
    End If
    If mManagedDefinitionDescriptionCache.Exists(cacheKey) Then
        descriptionText = CStr(mManagedDefinitionDescriptionCache(cacheKey))
        mManagedDefinitionDescriptionCacheHitCount = mManagedDefinitionDescriptionCacheHitCount + 1
    Else
        descriptionText = ManagedObjectCanonicalDescription(objectName, objectTypeCode)
        mManagedDefinitionDescriptionCache.Add cacheKey, descriptionText
        mManagedDefinitionDescriptionCacheMissCount = mManagedDefinitionDescriptionCacheMissCount + 1
    End If
    If Len(descriptionText) = 0 Then descriptionText = fallbackDescription
    If Len(descriptionText) = 0 Then descriptionText = CategoryManagedObjectDescription(objectName, categoryCode, objectTypeCode)
    If Len(descriptionText) = 0 Then descriptionText = "UNMAPPED MANAGED OBJECT DESCRIPTION: " & objectTypeCode & " [" & objectName & "]"
    ManagedObjectDefaultDescriptionForSetup = descriptionText
End Function

Private Function AddInReviewMatchClassificationText(ByVal classification As AddInReviewMatchClassification) As String
    Select Case classification
        Case ADD_IN_REVIEW_MATCH_EXACT: AddInReviewMatchClassificationText = "exact active match"
        Case ADD_IN_REVIEW_MATCH_MISSING: AddInReviewMatchClassificationText = "missing row"
        Case ADD_IN_REVIEW_MATCH_INACTIVE: AddInReviewMatchClassificationText = "inactive-only match"
        Case ADD_IN_REVIEW_MATCH_DUPLICATE_ACTIVE: AddInReviewMatchClassificationText = "duplicate active rows"
        Case ADD_IN_REVIEW_MATCH_NAME_MISMATCH: AddInReviewMatchClassificationText = "object-name mismatch"
        Case ADD_IN_REVIEW_MATCH_TYPE_MISMATCH: AddInReviewMatchClassificationText = "object-type mismatch"
        Case ADD_IN_REVIEW_MATCH_KEY_MISMATCH: AddInReviewMatchClassificationText = "managed-key mismatch"
        Case ADD_IN_REVIEW_MATCH_PLACEMENT_MISMATCH: AddInReviewMatchClassificationText = "placement-metadata mismatch"
        Case Else: AddInReviewMatchClassificationText = "unknown"
    End Select
End Function

