Private Function CatalogSetupTraceIdentity() As String
    If TraceRunActive() Then
        CatalogSetupTraceIdentity = GetActiveOrLastTraceRunID()
    Else
        CatalogSetupTraceIdentity = "NoActiveTrace"
    End If
End Function

Private Function CatalogCurrentSetupHelpOwnershipToken() As String
    Select Case CoreSetupHelpDocumentSynchronizationScope()
        Case HelpDocumentScopeSetupSystemAndAllActive
            CatalogCurrentSetupHelpOwnershipToken = "SystemAndAllActive"
        Case HelpDocumentScopeSetupSystemOnly
            CatalogCurrentSetupHelpOwnershipToken = "SystemOnly"
        Case Else
            Err.Raise vbObjectError + 9612, "CatalogCurrentSetupHelpOwnershipToken", "Normal Setup resolved an unsupported Help Document synchronization scope."
    End Select
End Function

Private Sub InitializeCatalogSetupPhaseState()
    Dim db As DAO.Database
    Dim schemaExists As Boolean
    Dim defaultsExists As Boolean
    Dim inventoryExists As Boolean
    Dim coreInventoryExists As Boolean
    Dim formsInventoryExists As Boolean
    Dim uiInventoryExists As Boolean
    Dim macroInventoryExists As Boolean
    Dim dependencyExists As Boolean
    Dim payloadExists As Boolean
    Dim corePayloadExists As Boolean
    Dim formsPayloadExists As Boolean
    Dim uiPayloadExists As Boolean
    Dim macroPayloadExists As Boolean
    Dim uiExists As Boolean
    Dim formsExists As Boolean
    Dim queryFingerprintExists As Boolean
    Dim validationExists As Boolean
    Dim helpSetupOwnershipExists As Boolean
    Dim helpSetupOwnershipMatches As Boolean
    Dim storedValidationToken As String
    Dim storedHelpSetupOwnershipToken As String
    Dim currentHelpSetupOwnershipToken As String
    Dim compactFastPathUsed As Boolean
    Dim compactDetail As String
    Dim compactTiming As String
    Dim exhaustiveTiming As String
    Dim timingText As String
    Dim snapshotReady As Boolean
    Dim comparisonLevel As String
    Dim operationTimer As Single
    Dim stageTimer As Single
    operationTimer = Timer
    stageTimer = Timer
    ResetCatalogSetupPhaseState
    mCatalogSetupTraceRunID = CatalogSetupTraceIdentity()
    PulseCatalogSetupPart7 "opening catalog database metadata."
    Set db = ResolveCatalogDb()
    timingText = SharedText_AppendNonBlankLine(timingText, "Catalog database context and trace identity initialization: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    stageTimer = Timer
    PulseCatalogSetupPart7 "checking the compact exact-state gate."
    compactFastPathUsed = TryCatalogCompactSnapshotFastPath(mCatalogSetupSnapshot, compactDetail, mCatalogSetupCompactStateToken, snapshotReady, compactTiming)
    timingText = SharedText_AppendNonBlankLine(timingText, compactTiming)
    timingText = SharedText_AppendNonBlankLine(timingText, "Compact snapshot decision boundary: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    If compactFastPathUsed Then comparisonLevel = TRACE_LEVEL_INFO Else comparisonLevel = TRACE_LEVEL_WARNING
    If Len(compactDetail) > 0 Then LogTraceMessage comparisonLevel, "ManagedObjectCatalog", "InitializeCatalogSetupPhaseState", "B1 compact-state comparison completed.", compactDetail, "B1 compact state", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogState", "CodeDb", "Performance"
    If compactFastPathUsed Then
        PulseCatalogSetupPart7 "all exact catalog domains matched; persisted evidence is being reused."
    ElseIf snapshotReady Then
        PulseCatalogSetupPart7 "changed catalog domains were identified without a second exhaustive pass."
    Else
        stageTimer = Timer
        PulseCatalogSetupPart7 "incremental domain calculation failed; calculating the fail-closed exhaustive snapshot."
        snapshotReady = CalculateCatalogDomainSnapshot(mCatalogSetupSnapshot, exhaustiveTiming)
        timingText = SharedText_AppendNonBlankLine(timingText, exhaustiveTiming)
        timingText = SharedText_AppendNonBlankLine(timingText, "Fail-closed exhaustive fallback boundary: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    End If
    If snapshotReady Then
        stageTimer = Timer
        PulseCatalogSetupPart7 "comparing current domain fingerprints with persisted catalog properties."
        mCatalogSetupSchemaMatches = DatabaseTextPropertyMatches(db, CATALOG_SCHEMA_FINGERPRINT_PROPERTY, mCatalogSetupSnapshot.SchemaFingerprint, schemaExists)
        mCatalogSetupDefaultsMatches = DatabaseTextPropertyMatches(db, CATALOG_DEFAULTS_FINGERPRINT_PROPERTY, mCatalogSetupSnapshot.DefaultsFingerprint, defaultsExists)
        mCatalogSetupInventoryMatches = DatabaseTextPropertyMatches(db, CATALOG_INVENTORY_FINGERPRINT_PROPERTY, mCatalogSetupSnapshot.InventoryFingerprint, inventoryExists)
        mCatalogSetupCoreInventoryMatches = DatabaseTextPropertyMatches(db, CATALOG_CORE_INVENTORY_FINGERPRINT_PROPERTY, mCatalogSetupSnapshot.CoreInventoryFingerprint, coreInventoryExists)
        mCatalogSetupFormsInventoryMatches = DatabaseTextPropertyMatches(db, CATALOG_FORMS_INVENTORY_FINGERPRINT_PROPERTY, mCatalogSetupSnapshot.FormsInventoryFingerprint, formsInventoryExists)
        mCatalogSetupUiInventoryMatches = DatabaseTextPropertyMatches(db, CATALOG_UI_INVENTORY_FINGERPRINT_PROPERTY, mCatalogSetupSnapshot.UiInventoryFingerprint, uiInventoryExists)
        mCatalogSetupMacroInventoryMatches = DatabaseTextPropertyMatches(db, CATALOG_MACRO_INVENTORY_FINGERPRINT_PROPERTY, mCatalogSetupSnapshot.MacroInventoryFingerprint, macroInventoryExists)
        mCatalogSetupDependencyMatches = DatabaseTextPropertyMatches(db, CATALOG_DEPENDENCY_FINGERPRINT_PROPERTY, mCatalogSetupSnapshot.DependencyFingerprint, dependencyExists)
        mCatalogSetupPayloadMatches = DatabaseTextPropertyMatches(db, CATALOG_PAYLOAD_FINGERPRINT_PROPERTY, mCatalogSetupSnapshot.PayloadFingerprint, payloadExists)
        mCatalogSetupCorePayloadMatches = DatabaseTextPropertyMatches(db, CATALOG_CORE_PAYLOAD_FINGERPRINT_PROPERTY, mCatalogSetupSnapshot.CorePayloadFingerprint, corePayloadExists)
        mCatalogSetupFormsPayloadMatches = DatabaseTextPropertyMatches(db, CATALOG_FORMS_PAYLOAD_FINGERPRINT_PROPERTY, mCatalogSetupSnapshot.FormsPayloadFingerprint, formsPayloadExists)
        mCatalogSetupUiPayloadMatches = DatabaseTextPropertyMatches(db, CATALOG_UI_PAYLOAD_FINGERPRINT_PROPERTY, mCatalogSetupSnapshot.UiPayloadFingerprint, uiPayloadExists)
        mCatalogSetupMacroPayloadMatches = DatabaseTextPropertyMatches(db, CATALOG_MACRO_PAYLOAD_FINGERPRINT_PROPERTY, mCatalogSetupSnapshot.MacroPayloadFingerprint, macroPayloadExists)
        mCatalogSetupUiMatches = DatabaseTextPropertyMatches(db, CATALOG_UI_FINGERPRINT_PROPERTY, mCatalogSetupSnapshot.UiFingerprint, uiExists)
        mCatalogSetupFormsMatches = DatabaseTextPropertyMatches(db, CATALOG_FORMS_FINGERPRINT_PROPERTY, mCatalogSetupSnapshot.FormsFingerprint, formsExists)
        mCatalogSetupQueryMatches = DatabaseTextPropertyMatches(db, CATALOG_QUERY_FINGERPRINT_PROPERTY, mCatalogSetupSnapshot.QueryFingerprint, queryFingerprintExists)
        currentHelpSetupOwnershipToken = CatalogCurrentSetupHelpOwnershipToken()
        storedHelpSetupOwnershipToken = DatabaseTextPropertyValue(db, CATALOG_HELP_SETUP_OWNERSHIP_PROPERTY, helpSetupOwnershipExists)
        helpSetupOwnershipMatches = (helpSetupOwnershipExists And StrComp(storedHelpSetupOwnershipToken, currentHelpSetupOwnershipToken, vbBinaryCompare) = 0)
        storedValidationToken = DatabaseTextPropertyValue(db, CATALOG_VALIDATION_TOKEN_PROPERTY, validationExists)
        If validationExists Then mCatalogSetupValidationMatches = (StrComp(storedValidationToken, CatalogValidationToken(mCatalogSetupSnapshot), vbBinaryCompare) = 0)
        timingText = SharedText_AppendNonBlankLine(timingText, "Persisted domain and validation-state comparison: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
        stageTimer = Timer
        mCatalogSetupInitialDetail = "Schema=" & CatalogDomainState(mCatalogSetupSchemaMatches, schemaExists)
        mCatalogSetupInitialDetail = mCatalogSetupInitialDetail & "; Defaults=" & CatalogDomainState(mCatalogSetupDefaultsMatches, defaultsExists)
        mCatalogSetupInitialDetail = mCatalogSetupInitialDetail & "; HelpSetupOwnership=" & IIf(helpSetupOwnershipMatches, "matched", IIf(helpSetupOwnershipExists, "changed", "unseeded")) & "(" & currentHelpSetupOwnershipToken & ")"
        mCatalogSetupInitialDetail = mCatalogSetupInitialDetail & "; Inventory=" & CatalogDomainState(mCatalogSetupInventoryMatches, inventoryExists)
        mCatalogSetupInitialDetail = mCatalogSetupInitialDetail & "; CoreInventory=" & CatalogDomainState(mCatalogSetupCoreInventoryMatches, coreInventoryExists)
        mCatalogSetupInitialDetail = mCatalogSetupInitialDetail & "; FormsInventory=" & CatalogDomainState(mCatalogSetupFormsInventoryMatches, formsInventoryExists)
        mCatalogSetupInitialDetail = mCatalogSetupInitialDetail & "; UiInventory=" & CatalogDomainState(mCatalogSetupUiInventoryMatches, uiInventoryExists)
        mCatalogSetupInitialDetail = mCatalogSetupInitialDetail & "; MacroInventory=" & CatalogDomainState(mCatalogSetupMacroInventoryMatches, macroInventoryExists)
        mCatalogSetupInitialDetail = mCatalogSetupInitialDetail & "; Dependencies=" & CatalogDomainState(mCatalogSetupDependencyMatches, dependencyExists)
        mCatalogSetupInitialDetail = mCatalogSetupInitialDetail & "; ActionPayloads=" & CatalogDomainState(mCatalogSetupPayloadMatches, payloadExists)
        mCatalogSetupInitialDetail = mCatalogSetupInitialDetail & "; CorePayloads=" & CatalogDomainState(mCatalogSetupCorePayloadMatches, corePayloadExists)
        mCatalogSetupInitialDetail = mCatalogSetupInitialDetail & "; FormsPayloads=" & CatalogDomainState(mCatalogSetupFormsPayloadMatches, formsPayloadExists)
        mCatalogSetupInitialDetail = mCatalogSetupInitialDetail & "; UiPayloads=" & CatalogDomainState(mCatalogSetupUiPayloadMatches, uiPayloadExists)
        mCatalogSetupInitialDetail = mCatalogSetupInitialDetail & "; MacroPayloads=" & CatalogDomainState(mCatalogSetupMacroPayloadMatches, macroPayloadExists)
        mCatalogSetupInitialDetail = mCatalogSetupInitialDetail & "; UI=" & CatalogDomainState(mCatalogSetupUiMatches, uiExists)
        mCatalogSetupInitialDetail = mCatalogSetupInitialDetail & "; Forms=" & CatalogDomainState(mCatalogSetupFormsMatches, formsExists)
        mCatalogSetupInitialDetail = mCatalogSetupInitialDetail & "; Queries=" & CatalogDomainState(mCatalogSetupQueryMatches, queryFingerprintExists)
        mCatalogSetupInitialDetail = mCatalogSetupInitialDetail & "; Validation=" & CatalogDomainState(mCatalogSetupValidationMatches, validationExists)
        If Len(mCatalogSetupSnapshot.operationalHistoryFingerprint) > 0 Then
            mCatalogSetupInitialDetail = mCatalogSetupInitialDetail & "; OperationalHistory=persisted-nonblocking"
        Else
            mCatalogSetupInitialDetail = mCatalogSetupInitialDetail & "; OperationalHistory=unseeded-nonblocking"
        End If
        If Len(mCatalogSetupSnapshot.diagnosticHistoryFingerprint) > 0 Then
            mCatalogSetupInitialDetail = mCatalogSetupInitialDetail & "; DiagnosticHistory=persisted-nonblocking"
        Else
            mCatalogSetupInitialDetail = mCatalogSetupInitialDetail & "; DiagnosticHistory=unseeded-nonblocking"
        End If
        If compactFastPathUsed Then
            mCatalogSetupInitialDetail = mCatalogSetupInitialDetail & "; SnapshotGate=all-domains-matched"
        Else
            mCatalogSetupInitialDetail = mCatalogSetupInitialDetail & "; SnapshotGate=incremental-domain-comparison"
        End If
        mCatalogSetupSystemMacroInputsChanged = (mCatalogSetupDefaultsMatches = False Or mCatalogSetupMacroInventoryMatches = False Or mCatalogSetupMacroPayloadMatches = False Or mCatalogSetupUiMatches = False Or (CoreSetupHelpDocumentSynchronizationScope() = HelpDocumentScopeSetupSystemAndAllActive And helpSetupOwnershipMatches = False))
        timingText = SharedText_AppendNonBlankLine(timingText, "Domain-state summary serialization: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
        PulseCatalogSetupPart7 "domain comparison is complete."
    Else
        mCatalogSetupInitialDetail = mCatalogSetupSnapshot.failureDetail
        PulseCatalogSetupPart7 "catalog snapshot calculation did not complete; failure diagnostics are being prepared."
    End If
    mCatalogSetupStateInitialized = True
    timingText = SharedText_AppendNonBlankLine(timingText, "B1 catalog-state initialization total: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer)))
    LogCatalogSetupSubstageTiming "InitializeCatalogSetupPhaseState", "Setup B1 catalog context", timingText
End Sub

Private Sub EnsureCatalogSetupPhaseState()
    If mCatalogSetupStateInitialized = False Then
        InitializeCatalogSetupPhaseState
    ElseIf StrComp(mCatalogSetupTraceRunID, CatalogSetupTraceIdentity(), vbBinaryCompare) <> 0 Then
        InitializeCatalogSetupPhaseState
    End If
End Sub

' Purpose: Runs the canonical catalog repair stack owned by this module for deferred/direct callers.
' Public role: Public dynamic/form expression API. The name is referenced as text outside this module, so Public visibility is required for Access or generated-expression resolution.
' Parameters:
'   showMessage (Input Optional; Boolean): Controls whether the routine displays its normal user-facing status, completion, warning, or error message; False suppresses that presentation while preserving the
'   underlying operation. Default: True.
' Returns: None (Sub). The procedure communicates its result through its database, UI, trace, or module-state side effects and raises errors where its implementation requires it.
Public Sub RepairManagedObjectCatalog(Optional ByVal showMessage As Boolean = True)
    'Runs the canonical catalog repair stack owned by this module for deferred/direct callers.
    RequireNoUnfinishedCatalogRecovery "RepairManagedObjectCatalog"
    On Error GoTo ErrHandler
    Dim progressStarted As Boolean
    Dim catalogContextStarted As Boolean
    Dim phaseDetails As String
    Dim messageText As String
    Dim namingInputsChanged As Boolean
    Dim presentationNamingInputsChanged As Boolean
    Dim macroNamingInputsChanged As Boolean
    Dim objectDescriptionChanges As Long
    Dim fieldDescriptionChanges As Long
    Dim descriptionDetail As String
    LogTraceMessage "Info", "ManagedObjectCatalog", "RepairManagedObjectCatalog", "Managed Object Catalog repair started.", vbNullString, vbNullString, 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "Table", "CodeDb", "ManagedObjectCatalog"
    progressStarted = CoreBeginOperationProgressIfNeeded("Repair managed object catalog", 8)
    BeginCatalogSetupContext
    catalogContextStarted = True
    CorePulseProgress "Repair catalog structure"
    phaseDetails = vbNullString
    If RepairCatalogStructureForSetup(False, phaseDetails, namingInputsChanged) = False Then Err.Raise vbObjectError + 9600, "RepairManagedObjectCatalog", phaseDetails
    If namingInputsChanged Then CoreMarkSetupNamingSnapshotDirty "Repair managed object catalog B1"
    CoreEnsureSetupNamingSnapshotCurrent
    CorePulseProgress "Repair catalog reference/default data"
    phaseDetails = vbNullString
    If RepairCatalogReferenceDataForSetup(False, phaseDetails) = False Then Err.Raise vbObjectError + 9601, "RepairManagedObjectCatalog", phaseDetails
    CorePulseProgress "Reconcile canonical non-form managed definitions"
    phaseDetails = vbNullString
    If RepairCoreManagedObjectDefinitionsForSetup(False, phaseDetails, namingInputsChanged) = False Then Err.Raise vbObjectError + 9602, "RepairManagedObjectCatalog", phaseDetails
    phaseDetails = vbNullString
    If RepairNonFormPresentationDefinitionsForSetup(False, phaseDetails, presentationNamingInputsChanged) = False Then Err.Raise vbObjectError + 9603, "RepairManagedObjectCatalog", phaseDetails
    If namingInputsChanged Or presentationNamingInputsChanged Then CoreMarkSetupNamingSnapshotDirty "Repair managed object catalog B3"
    CoreEnsureSetupNamingSnapshotCurrent
    CorePulseProgress "Reconcile System Macro and Help Document Macro managed definitions"
    phaseDetails = vbNullString
    If RepairSystemHelpMacroDefinitionsForSetup(False, phaseDetails, macroNamingInputsChanged) = False Then Err.Raise vbObjectError + 9604, "RepairManagedObjectCatalog", phaseDetails
    If macroNamingInputsChanged Then CoreMarkSetupNamingSnapshotDirty "Repair managed object catalog B4"
    CoreEnsureSetupNamingSnapshotCurrent
    CorePulseProgress "Finalize and validate non-form catalog"
    phaseDetails = vbNullString
    If RepairManagedDefinitionSupportQueriesForSetup(False, phaseDetails) = False Then Err.Raise vbObjectError + 9605, "RepairManagedObjectCatalog", phaseDetails
    phaseDetails = vbNullString
    If ValidateManagedObjectPlacementResolverCoveragePhase(False, phaseDetails, False) = False Then Err.Raise vbObjectError + 9606, "RepairManagedObjectCatalog", phaseDetails
    phaseDetails = vbNullString
    If ValidateManagedObjectCatalogForSetup(False, phaseDetails) = False Then Err.Raise vbObjectError + 9607, "RepairManagedObjectCatalog", phaseDetails
    CorePulseProgress "Reconcile canonical managed-form domain"
    phaseDetails = vbNullString
    If RepairManagedFormDomainForSetup(False, phaseDetails) = False Then Err.Raise vbObjectError + 9608, "RepairManagedObjectCatalog", phaseDetails
    CorePulseProgress "Validate repaired catalog"
    If ValidateManagedObjectCatalog(False, True) = False Then Err.Raise vbObjectError + 9609, "RepairManagedObjectCatalog", "Canonical catalog validation returned False."
    EndCatalogSetupContext
    catalogContextStarted = False
    CorePulseProgress "Reconcile standalone managed catalog descriptions"
    ReconcileManagedObjectCatalogStandaloneDescriptions objectDescriptionChanges, fieldDescriptionChanges, descriptionDetail
    messageText = "Access Development Console managed object catalog was repaired and validated." & vbCrLf & vbCrLf & "Schema version: " & MANAGED_OBJECT_CATALOG_SCHEMA_VERSION & vbCrLf & descriptionDetail & CoreOperationSummaryForMessage() & TableDiagnosticsLocationForMessage() & TraceBackendDiagnosticsForMessage()
    ReportCoreActionSuccess "RepairManagedObjectCatalog", "ManagedObjectCatalog", "Managed Object Catalog repair completed successfully.", messageText, "Repair managed object catalog", ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "Table", "CodeDb", "ManagedObjectCatalog", showMessage, "Repair Managed Object Catalog", vbInformation, True, "Tables", False
    If progressStarted Then CoreCompleteSetupProgress
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    If catalogContextStarted Then
        On Error Resume Next
        EndCatalogSetupContext
        On Error GoTo 0
    End If
    If progressStarted Then CoreFailSetupProgress
    messageText = "Access Development Console managed object catalog repair failed." & vbCrLf & vbCrLf & "Procedure: RepairManagedObjectCatalog" & vbCrLf & "Schema version: " & MANAGED_OBJECT_CATALOG_SCHEMA_VERSION & vbCrLf & "Error number: " & CStr(savedErrNumber) & vbCrLf & "Source: " & savedErrSource & vbCrLf & "Description:" & vbCrLf & savedErrDescription & TableDiagnosticsLocationForMessage() & CoreOperationSummaryForMessage()
    LogTraceMessage "Error", "ManagedObjectCatalog", "RepairManagedObjectCatalog", "Managed Object Catalog repair failed.", messageText, vbNullString, savedErrNumber, savedErrSource, savedErrDescription, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "Table", "CodeDb", "ManagedObjectCatalog"
    If showMessage Then
        CoreShowErrorMessage messageText, vbCritical, "Repair Managed Object Catalog", "RepairManagedObjectCatalog", "Tables"
        Exit Sub
    End If
    Err.Raise savedErrNumber, "RepairManagedObjectCatalog", messageText
End Sub

Private Sub ReconcileManagedObjectCatalogStandaloneDescriptions(ByRef objectDescriptionChanges As Long, ByRef fieldDescriptionChanges As Long, ByRef detailText As String)
    'Standalone completion is intentionally limited to physical objects this RepairManagedObjectCatalog stack can create: B1-owned catalog tables plus B1/B5 catalog-support queries.
    'A2-owned macro-classification tables are predecessor-owned and are therefore excluded; managed forms/macros are logical catalog work here and are not physically created by this routine.
    On Error GoTo ErrHandler
    Dim lookupTableNames As Variant
    Dim coreTableNames As Variant
    Dim macroClassificationTableNames As Variant
    Dim systemMacroTableNames As Variant
    Dim helpDocumentTableNames As Variant
    Dim structuralFamilyCount As Long
    Dim tableNames As New Collection
    Dim tableNameValue As Variant
    Dim queryNames As New Collection
    Dim queryDefinitions As Collection
    Dim queryDefinition As Variant
    Dim queryNameValue As Variant
    Dim descriptionChanged As Variant
    Dim fieldDescriptionChangeCount As Variant
    Dim fieldDetail As String
    objectDescriptionChanges = 0
    fieldDescriptionChanges = 0
    detailText = vbNullString
    ResolvePart8FamilyTableNames lookupTableNames, coreTableNames, macroClassificationTableNames, systemMacroTableNames, helpDocumentTableNames, structuralFamilyCount
    For Each tableNameValue In lookupTableNames
        tableNames.Add CStr(tableNameValue)
    Next tableNameValue
    For Each tableNameValue In coreTableNames
        tableNames.Add CStr(tableNameValue)
    Next tableNameValue
    For Each tableNameValue In systemMacroTableNames
        tableNames.Add CStr(tableNameValue)
    Next tableNameValue
    For Each tableNameValue In helpDocumentTableNames
        tableNames.Add CStr(tableNameValue)
    Next tableNameValue
    For Each tableNameValue In tableNames
        descriptionChanged = False
        If ApplyAndVerifyManagedObjectDescriptionForStandaloneRepair(CStr(tableNameValue), ADCAT_OBJECT_TYPE_TABLE, descriptionChanged) = False Then Err.Raise vbObjectError + 10117, "ReconcileManagedObjectCatalogStandaloneDescriptions", "Managed catalog table Description reconciliation returned False." & vbCrLf & "Table: " & CStr(tableNameValue)
        If CBool(descriptionChanged) Then objectDescriptionChanges = objectDescriptionChanges + 1
        fieldDescriptionChangeCount = CLng(0)
        fieldDetail = vbNullString
        If ApplyAndVerifyManagedTableFieldDescriptionsForStandaloneRepair(CStr(tableNameValue), fieldDescriptionChangeCount, fieldDetail) = False Then Err.Raise vbObjectError + 10118, "ReconcileManagedObjectCatalogStandaloneDescriptions", fieldDetail
        fieldDescriptionChanges = fieldDescriptionChanges + CLng(Nz(fieldDescriptionChangeCount, 0))
    Next tableNameValue
    queryNames.Add ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_Terminology_Review")
    queryNames.Add ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_ManagedObjectsResolved")
    queryNames.Add ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_ManagedObjectDependenciesResolved")
    queryNames.Add ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_ManagedObjects_Review")
    Set queryDefinitions = NavigationRibbonManagementManagedObjectDefinitions()
    For Each queryDefinition In queryDefinitions
        queryNames.Add CStr(queryDefinition(0))
    Next queryDefinition
    For Each queryNameValue In queryNames
        descriptionChanged = False
        If ApplyAndVerifyManagedObjectDescriptionForStandaloneRepair(CStr(queryNameValue), ADCAT_OBJECT_TYPE_QUERY, descriptionChanged) = False Then Err.Raise vbObjectError + 10119, "ReconcileManagedObjectCatalogStandaloneDescriptions", "Managed catalog support-query Description reconciliation returned False." & vbCrLf & "Query: " & CStr(queryNameValue)
        If CBool(descriptionChanged) Then objectDescriptionChanges = objectDescriptionChanges + 1
    Next queryNameValue
    detailText = "Standalone managed catalog descriptions reconciled." & vbCrLf & "Object descriptions changed: " & CStr(objectDescriptionChanges) & vbCrLf & "Field descriptions changed: " & CStr(fieldDescriptionChanges)
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    detailText = "Standalone managed catalog Description reconciliation failed." & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
    Err.Raise savedErrNumber, "ReconcileManagedObjectCatalogStandaloneDescriptions", detailText
End Sub

' Purpose: Repairs catalog table and query families.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   showMessage (Input Optional; Boolean): Controls whether the routine displays its normal user-facing status, completion, warning, or error message; False suppresses that presentation while preserving the
'   underlying operation. Default: False.
'   detailsForMessage (Output Optional; String): Receives detail text formatted for inclusion in the caller's user-facing message. Default: vbNullString.
' Returns: Boolean: True on the function's affirmative/success branch for repair catalog table and query families; False on its explicit negative, unavailable, rejected, or handled-failure branch.
'   path.
Public Function RepairCatalogTableAndQueryFamilies(Optional ByVal showMessage As Boolean = False, Optional ByRef detailsForMessage As String = vbNullString) As Boolean
    'Operational #71/#72 authority boundary: reuse the Catalog B1-B5 table/query authorities without taking over managed-form reconciliation, which remains a separate owner.
    RequireNoUnfinishedCatalogRecovery "RepairCatalogTableAndQueryFamilies"
    On Error GoTo ErrHandler
    Dim catalogContextStarted As Boolean
    Dim phaseDetails As String
    Dim namingInputsChanged As Boolean
    Dim presentationNamingInputsChanged As Boolean
    Dim macroNamingInputsChanged As Boolean
    detailsForMessage = vbNullString
    BeginCatalogSetupContext
    catalogContextStarted = True
    phaseDetails = vbNullString
    If RepairCatalogStructureForSetup(False, phaseDetails, namingInputsChanged) = False Then Err.Raise vbObjectError + 9953, "RepairCatalogTableAndQueryFamilies", phaseDetails
    If namingInputsChanged Then CoreMarkSetupNamingSnapshotDirty "Operational Catalog B1 table/query repair"
    CoreEnsureSetupNamingSnapshotCurrent
    detailsForMessage = SharedText_AppendNonBlankLine(detailsForMessage, phaseDetails)
    phaseDetails = vbNullString
    If RepairCatalogReferenceDataForSetup(False, phaseDetails) = False Then Err.Raise vbObjectError + 9954, "RepairCatalogTableAndQueryFamilies", phaseDetails
    detailsForMessage = SharedText_AppendNonBlankLine(detailsForMessage, phaseDetails)
    phaseDetails = vbNullString
    If RepairCoreManagedObjectDefinitionsForSetup(False, phaseDetails, namingInputsChanged) = False Then Err.Raise vbObjectError + 9955, "RepairCatalogTableAndQueryFamilies", phaseDetails
    detailsForMessage = SharedText_AppendNonBlankLine(detailsForMessage, phaseDetails)
    phaseDetails = vbNullString
    If RepairNonFormPresentationDefinitionsForSetup(False, phaseDetails, presentationNamingInputsChanged) = False Then Err.Raise vbObjectError + 9956, "RepairCatalogTableAndQueryFamilies", phaseDetails
    If namingInputsChanged Or presentationNamingInputsChanged Then CoreMarkSetupNamingSnapshotDirty "Operational Catalog B3 table/query repair"
    CoreEnsureSetupNamingSnapshotCurrent
    detailsForMessage = SharedText_AppendNonBlankLine(detailsForMessage, phaseDetails)
    phaseDetails = vbNullString
    If RepairSystemHelpMacroDefinitionsForSetup(False, phaseDetails, macroNamingInputsChanged) = False Then Err.Raise vbObjectError + 9957, "RepairCatalogTableAndQueryFamilies", phaseDetails
    If macroNamingInputsChanged Then CoreMarkSetupNamingSnapshotDirty "Operational Catalog B4 table/query repair"
    CoreEnsureSetupNamingSnapshotCurrent
    detailsForMessage = SharedText_AppendNonBlankLine(detailsForMessage, phaseDetails)
    phaseDetails = vbNullString
    If RepairManagedDefinitionSupportQueriesForSetup(False, phaseDetails) = False Then Err.Raise vbObjectError + 9958, "RepairCatalogTableAndQueryFamilies", phaseDetails
    detailsForMessage = SharedText_AppendNonBlankLine(detailsForMessage, phaseDetails)
    phaseDetails = vbNullString
    If ValidateManagedObjectPlacementResolverCoveragePhase(False, phaseDetails, False) = False Then Err.Raise vbObjectError + 9959, "RepairCatalogTableAndQueryFamilies", phaseDetails
    detailsForMessage = SharedText_AppendNonBlankLine(detailsForMessage, phaseDetails)
    phaseDetails = vbNullString
    If ValidateManagedObjectCatalogForSetup(False, phaseDetails) = False Then Err.Raise vbObjectError + 9960, "RepairCatalogTableAndQueryFamilies", phaseDetails
    detailsForMessage = SharedText_AppendNonBlankLine(detailsForMessage, phaseDetails)
    EndCatalogSetupContext
    catalogContextStarted = False
    RepairCatalogTableAndQueryFamilies = True
    If showMessage Then CoreShowMessage "Catalog-owned ADC table/query families are current.", vbInformation, "Build/Repair All ADC Tables and Queries", "RepairCatalogTableAndQueryFamilies", "Catalog"
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    If catalogContextStarted Then
        On Error Resume Next
        EndCatalogSetupContext
        On Error GoTo 0
    End If
    detailsForMessage = SharedText_AppendNonBlankLine(detailsForMessage, "Catalog table/query-family repair failed. Error " & CStr(savedErrNumber) & " from " & savedErrSource & ": " & savedErrDescription)
    If showMessage Then
        CoreShowErrorMessage detailsForMessage, vbCritical, "Build/Repair All ADC Tables and Queries", "RepairCatalogTableAndQueryFamilies", "Catalog"
        Exit Function
    End If
    Err.Raise savedErrNumber, "RepairCatalogTableAndQueryFamilies", detailsForMessage
End Function

' Purpose: Clears and reinitializes catalog user data table for operational reset, coordinating `StrComp` and `End` as the implementation requires.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   logicalIdentity (Input; String): Stable logical identity used to select or correlate the exact ADC definition/state handled by this procedure.
'   tableName (Input; String): Physical Access table name identifying the table whose schema, data, or metadata the routine processes.
' Returns: None (Sub). The procedure communicates its result through its database, UI, trace, or module-state side effects and raises errors where its implementation requires it.
Public Sub ResetCatalogUserDataTableForOperationalReset(ByVal logicalIdentity As String, ByVal tableName As String)
    ' Operational #72 authority boundary: CATALOG approves/destructively resets only the explicit persistent Catalog-owned user-data stores in the centralized scope. TABLES supplies the neutral physical drop
    ' primitive.
    logicalIdentity = Trim$(logicalIdentity)
    tableName = Trim$(tableName)
    Select Case UCase$(logicalIdentity)
        Case UCase$("ADC_NavigationPaneGroups"), UCase$("ADC_SystemMacros"), UCase$(CANON_TABLE_LOGICAL_ID_HELPDOCUMENTS)
            If StrComp(tableName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, logicalIdentity), vbTextCompare) <> 0 Then Err.Raise vbObjectError + 9951, "ResetCatalogUserDataTableForOperationalReset", "The centralized ADC user-data scope resolved a Catalog-owned table name that does not match the authoritative logical identity." & vbCrLf & "Logical identity: " & logicalIdentity & vbCrLf & "Expected table: " & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, logicalIdentity) & vbCrLf & "Supplied table: " & tableName
            SafeDropTableIfExists tableName, "Reset Catalog-owned ADC user-data table [" & tableName & "] under its authoritative Catalog contract."
        Case Else
            Err.Raise vbObjectError + 9952, "ResetCatalogUserDataTableForOperationalReset", "The centralized ADC user-data scope requested a table that is not an approved Catalog-owned reset store." & vbCrLf & "Logical identity: " & logicalIdentity & vbCrLf & "Table: " & tableName
    End Select
End Sub

' Purpose: Repairs catalog structure for setup.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   showMessage (Input Optional; Boolean): Controls whether the routine displays its normal user-facing status, completion, warning, or error message; False suppresses that presentation while preserving the
'   underlying operation. Default: False.
'   detailsForMessage (Output Optional; String): Receives detail text formatted for inclusion in the caller's user-facing message. Default: vbNullString.
'   namingInputsChanged (Output Optional; Boolean): Set True when the procedure determines that naming inputs changed applies; set False when that condition is not met. Default: False.
' Returns: Boolean: True on the function's affirmative/success branch for repair catalog structure for setup; False on its explicit negative, unavailable, rejected, or handled-failure branch.
Public Function RepairCatalogStructureForSetup(Optional ByVal showMessage As Boolean = False, Optional ByRef detailsForMessage As String = vbNullString, Optional ByRef namingInputsChanged As Boolean = False) As Boolean
    RequireCatalogSetupPhaseReady "RepairCatalogStructureForSetup"
    RequireSetupDomainMutationAllowed SETUP_DOMAIN_B1_CATALOG_STRUCTURE, "RepairCatalogStructureForSetup"
    On Error GoTo ErrHandler
    Dim phaseTimer As Single
    Dim messageText As String
    Dim part8Metrics As TPart8Metrics
    detailsForMessage = vbNullString
    namingInputsChanged = False
    EnsureCatalogSetupPhaseState
    phaseTimer = Timer
    CorePulseProgress "Comparing B1 structural family proofs before opening table design collections."
    RepairManagedObjectCatalogStructureCore part8Metrics
    If part8Metrics.FamiliesRepaired > 0 Then
        namingInputsChanged = True
        CatalogMarkSetupDomainsDirty CATALOG_DIRTY_ALL
        mCatalogSetupSystemMacroInputsChanged = True
        mCatalogSetupDefaultsMatches = False
        mCatalogSetupInventoryMatches = False
        mCatalogSetupCoreInventoryMatches = False
        mCatalogSetupFormsInventoryMatches = False
        mCatalogSetupUiInventoryMatches = False
        mCatalogSetupMacroInventoryMatches = False
        mCatalogSetupDependencyMatches = False
        mCatalogSetupPayloadMatches = False
        mCatalogSetupCorePayloadMatches = False
        mCatalogSetupFormsPayloadMatches = False
        mCatalogSetupUiPayloadMatches = False
        mCatalogSetupMacroPayloadMatches = False
        mCatalogSetupUiMatches = False
        mCatalogSetupFormsMatches = False
        mCatalogSetupQueryMatches = False
        mCatalogSetupValidationMatches = False
        detailsForMessage = "Catalog structure family path: Repaired dirty families" & vbCrLf & "Initial state: " & mCatalogSetupInitialDetail
    Else
        mCatalogSetupSchemaMatches = True
        detailsForMessage = "Catalog structure family fast path: Used; all B1 structural family proofs matched" & vbCrLf & "Initial state: " & mCatalogSetupInitialDetail
    End If
    If Len(part8Metrics.FamilyDetail) > 0 Then detailsForMessage = detailsForMessage & vbCrLf & part8Metrics.FamilyDetail
    mCatalogSetupPart4TimingText = "B1 catalog structure elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(phaseTimer))
    detailsForMessage = detailsForMessage & vbCrLf & mCatalogSetupPart4TimingText
    mCatalogSetupStructureComplete = True
    LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "RepairCatalogStructureForSetup", "Catalog structure phase completed.", detailsForMessage, "Catalog structure", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogStructure", "CodeDb", "ManagedObjectCatalog"
    If showMessage Then
        messageText = "Catalog structure phase completed." & vbCrLf & vbCrLf & detailsForMessage
        CoreShowMessage messageText, vbInformation, "Managed Object Catalog", "ShowADCMessage", "Tables"
    End If
    RepairCatalogStructureForSetup = True
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    detailsForMessage = "Catalog structure phase failed." & vbCrLf & "Err.Number: " & CStr(savedErrNumber) & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
    LogTraceMessage TRACE_LEVEL_ERROR, "ManagedObjectCatalog", "RepairCatalogStructureForSetup", "Catalog structure phase failed.", detailsForMessage, "Catalog structure", savedErrNumber, savedErrSource, savedErrDescription, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogStructure", "CodeDb", "ManagedObjectCatalog"
    If showMessage Then
        CoreShowErrorMessage detailsForMessage, vbCritical, "Managed Object Catalog", "RepairCatalogStructureForSetup", "Tables"
        Exit Function
    End If
    Err.Raise savedErrNumber, "RepairCatalogStructureForSetup", detailsForMessage
End Function

Private Function RetireNoncanonicalSystemDefaultManagedTableRowsForSetup() As Long
    'Retires ADC-owned table metadata that is no longer present in the canonical managed-object registry. Physical Access tables are never deleted here.
    Dim rs As DAO.Recordset
    Dim definitionData As Variant
    Dim objectName As String
    Dim objectTypeCode As String
    Dim objectStatus As String
    Dim catalogOwner As String
    Dim retiredNames As String
    If mManagedDefinitionBatchActive = False Then Err.Raise vbObjectError + 9527, "RetireNoncanonicalSystemDefaultManagedTableRowsForSetup", "The reusable managed-definition batch must be active before noncanonical table metadata can be retired."
    Set rs = mManagedDefinitionBatchManagedRs
    If Not (rs.BOF And rs.EOF) Then rs.MoveFirst
    Do While rs.EOF = False
        PumpSetupResponsiveness
        objectName = CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString))
        objectTypeCode = Trim$(CStr(Nz(rs.fields(FIELD_OBJECT_TYPE).value, vbNullString)))
        objectStatus = Trim$(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_STATUS).value, ADCAT_STATUS_ACTIVE)))
        catalogOwner = Trim$(CStr(Nz(rs.fields(FIELD_CATALOG_OWNER).value, vbNullString)))
        If StrComp(objectTypeCode, ADCAT_OBJECT_TYPE_TABLE, vbTextCompare) = 0 And StrComp(objectStatus, ADCAT_STATUS_ACTIVE, vbTextCompare) = 0 And StrComp(catalogOwner, ADCAT_OWNER_SYSTEM_DEFAULT, vbTextCompare) = 0 Then
            If TryGetManagedObjectDefinition(objectName, objectTypeCode, definitionData) = False Then
                If SetupRollbackTrackingActive() Then
                    If TrackSetupManagedObjectRowRollback(CLng(rs.fields(FIELD_ID).value), True, ManagedObjectRollbackSql(rs)) Then mManagedDefinitionRollbackRegistrationCount = mManagedDefinitionRollbackRegistrationCount + 1
                End If
                rs.Edit
                rs.fields(FIELD_MANAGED_OBJECT_STATUS).value = ADCAT_STATUS_INACTIVE
                If SharedDao_RecordsetHasFieldSafe(rs, FIELD_LAST_DEFAULT_REPAIR_ON) Then rs.fields(FIELD_LAST_DEFAULT_REPAIR_ON).value = Now()
                rs.Update
                RetireNoncanonicalSystemDefaultManagedTableRowsForSetup = RetireNoncanonicalSystemDefaultManagedTableRowsForSetup + 1
                mManagedDefinitionBatchManagedUpdated = mManagedDefinitionBatchManagedUpdated + 1
                retiredNames = SharedText_AppendNonBlankLine(retiredNames, objectName)
                MarkManagedDefinitionMutation CATALOG_DIRTY_INVENTORY Or CATALOG_DIRTY_UI
            End If
        End If
        rs.MoveNext
    Loop
    If RetireNoncanonicalSystemDefaultManagedTableRowsForSetup > 0 Then AddTraceNote "Retired " & CStr(RetireNoncanonicalSystemDefaultManagedTableRowsForSetup) & " active ADC-owned managed-table row(s) because their identities are no longer present in the canonical managed-object registry. Physical Access tables were not deleted." & vbCrLf & retiredNames
End Function

Private Function RetireObsoleteGeneratedLookupQueryManagedRowsForSetup() As Long
    'Retires the prior Query-type managed identities for all lookup vocabularies converted or retired by this build. Physical query retirement/replacement is owned by A2.
    Dim rs As DAO.Recordset
    Dim editableLookupNames As Collection
    Dim obsoleteLookupQueryNames As Object
    Dim lookupTableName As Variant
    Dim objectName As String
    Dim objectTypeCode As String
    Dim objectStatus As String
    Dim catalogOwner As String
    Dim retiredNames As String
    If mManagedDefinitionBatchActive = False Then Err.Raise vbObjectError + 9528, "RetireObsoleteGeneratedLookupQueryManagedRowsForSetup", "The reusable managed-definition batch must be active before obsolete lookup-query metadata can be retired."
    Set obsoleteLookupQueryNames = CreateObject("Scripting.Dictionary")
    obsoleteLookupQueryNames.CompareMode = vbTextCompare
    Set editableLookupNames = EditableLookupTableNames()
    For Each lookupTableName In editableLookupNames
        If obsoleteLookupQueryNames.Exists(CStr(lookupTableName)) = False Then obsoleteLookupQueryNames.Add CStr(lookupTableName), True
    Next lookupTableName
    If obsoleteLookupQueryNames.Exists(RETIRED_CONFIG_OWNER_DATABASE_ROLE_LOOKUP_QUERY) = False Then obsoleteLookupQueryNames.Add RETIRED_CONFIG_OWNER_DATABASE_ROLE_LOOKUP_QUERY, True
    Set rs = mManagedDefinitionBatchManagedRs
    If Not (rs.BOF And rs.EOF) Then rs.MoveFirst
    Do While rs.EOF = False
        PumpSetupResponsiveness
        objectName = CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString))
        objectTypeCode = Trim$(CStr(Nz(rs.fields(FIELD_OBJECT_TYPE).value, vbNullString)))
        objectStatus = Trim$(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_STATUS).value, ADCAT_STATUS_ACTIVE)))
        catalogOwner = Trim$(CStr(Nz(rs.fields(FIELD_CATALOG_OWNER).value, vbNullString)))
        If obsoleteLookupQueryNames.Exists(objectName) And _
           StrComp(objectTypeCode, ADCAT_OBJECT_TYPE_QUERY, vbTextCompare) = 0 And _
           StrComp(objectStatus, ADCAT_STATUS_ACTIVE, vbTextCompare) = 0 And _
           StrComp(catalogOwner, ADCAT_OWNER_SYSTEM_DEFAULT, vbTextCompare) = 0 Then
            If SetupRollbackTrackingActive() Then
                If TrackSetupManagedObjectRowRollback(CLng(rs.fields(FIELD_ID).value), True, ManagedObjectRollbackSql(rs)) Then mManagedDefinitionRollbackRegistrationCount = mManagedDefinitionRollbackRegistrationCount + 1
            End If
            rs.Edit
            rs.fields(FIELD_MANAGED_OBJECT_STATUS).value = ADCAT_STATUS_INACTIVE
            If SharedDao_RecordsetHasFieldSafe(rs, FIELD_LAST_DEFAULT_REPAIR_ON) Then rs.fields(FIELD_LAST_DEFAULT_REPAIR_ON).value = Now()
            rs.Update
            RetireObsoleteGeneratedLookupQueryManagedRowsForSetup = RetireObsoleteGeneratedLookupQueryManagedRowsForSetup + 1
            mManagedDefinitionBatchManagedUpdated = mManagedDefinitionBatchManagedUpdated + 1
            retiredNames = SharedText_AppendNonBlankLine(retiredNames, objectName)
            MarkManagedDefinitionMutation CATALOG_DIRTY_INVENTORY Or CATALOG_DIRTY_UI
        End If
        rs.MoveNext
    Loop
    If RetireObsoleteGeneratedLookupQueryManagedRowsForSetup > 0 Then AddTraceNote "Retired " & CStr(RetireObsoleteGeneratedLookupQueryManagedRowsForSetup) & " obsolete generated lookup-query managed-object row(s). Physical query retirement/replacement is owned by A2." & vbCrLf & retiredNames
End Function

' Purpose: Repairs catalog reference data for setup.
' Public role: Public dynamic/form expression API. The name is referenced as text outside this module, so Public visibility is required for Access or generated-expression resolution.
' Parameters:
'   showMessage (Input Optional; Boolean): Controls whether the routine displays its normal user-facing status, completion, warning, or error message; False suppresses that presentation while preserving the
'   underlying operation. Default: False.
'   detailsForMessage (Output Optional; String): Receives detail text formatted for inclusion in the caller's user-facing message. Default: vbNullString.
' Returns: Boolean: True on the function's affirmative/success branch for repair catalog reference data for setup; False on its explicit negative, unavailable, rejected, or handled-failure branch.
'   path.
Public Function RepairCatalogReferenceDataForSetup(Optional ByVal showMessage As Boolean = False, Optional ByRef detailsForMessage As String = vbNullString) As Boolean
    'Owns B2 reference/default readiness and freshly verifies B1-owned Help_Docs structure without repairing it; generated Help artifact ownership is setting-aware in B4/C.
    RequireCatalogSetupPhaseReady "RepairCatalogReferenceDataForSetup"
    RequireSetupDomainMutationAllowed SETUP_DOMAIN_B2_CATALOG_REFERENCE_DEFAULTS, "RepairCatalogReferenceDataForSetup"
    On Error GoTo ErrHandler
    Dim phaseTimer As Single
    Dim db As DAO.Database
    Dim helpStructureCurrent As Boolean
    Dim helpStructureToken As String
    Dim metadataDetails As String
    Dim part8Metrics As TPart8Metrics
    detailsForMessage = vbNullString
    EnsureCatalogSetupPhaseState
    If mCatalogSetupStructureComplete = False Then Err.Raise vbObjectError + 9634, "RepairCatalogReferenceDataForSetup", "B2 refused to run because required predecessor B1 catalog structure is not current. B2 does not repair B1."
    Set db = ResolveCatalogDb()
    helpStructureCurrent = Part8FamilyProofMatches(db, PART8_HELP_DOCUMENT_PROOF_PROPERTY, PART8_HELP_DOCUMENT_CONTRACT, Part8ManagedObjectFamilyTableNames(ManagedObjectNamesByB1Family(ManagedObjectB1HelpDocumentFamilyCode())), False, helpStructureToken, part8Metrics)
    If helpStructureCurrent = False Then Err.Raise vbObjectError + 9637, "RepairCatalogReferenceDataForSetup", "B2 requires the B1-owned Help_Docs physical structure to remain current. B2 does not repair B1-owned structure."
    AddTraceNote "B2 freshly verified the B1-owned Help_Docs structural proof before B2 reference/default work. Table headers inspected=" & CStr(part8Metrics.TableHeadersInspected) & "; relationship definitions inspected=" & CStr(part8Metrics.RelationshipDefinitionsInspected) & "."
    phaseTimer = Timer
    If mCatalogSetupDefaultsMatches Then
        detailsForMessage = "Authoritative catalog reference/default data fast path: Used" & vbCrLf & "Initial state: " & mCatalogSetupInitialDetail
    Else
        CorePulseProgress "Repairing authoritative catalog lookup, policy, category, and Navigation Pane group defaults."
        DefaultManagedObjectCatalogLookups False
        RepairTerminologyDefaultRowsForSetup
        DefaultNavigationPaneGroupRows False
        DefaultManagedObjectCatalogCategories False
        CatalogMarkSetupDomainsDirty CATALOG_DIRTY_DEFAULTS Or CATALOG_DIRTY_UI
        mCatalogSetupSystemMacroInputsChanged = True
        mCatalogSetupDefaultsMatches = True
        mCatalogSetupValidationMatches = False
        detailsForMessage = "Authoritative catalog reference/default data path: Repaired" & vbCrLf & "Initial state: " & mCatalogSetupInitialDetail
    End If
    CorePulseProgress "Reconciling B2-owned persistent lookup-editor intent rows and proof state."
    RepairLookupEditorPolicyRowsForSetup metadataDetails
    detailsForMessage = detailsForMessage & vbCrLf & metadataDetails
    CorePulseProgress "Applying the single B2-owned shared lookup and caption metadata pass."
    RepairSharedFieldMetadataForSetup metadataDetails
    detailsForMessage = detailsForMessage & vbCrLf & metadataDetails
    detailsForMessage = detailsForMessage & vbCrLf & "Reference/default data and shared metadata elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(phaseTimer))
    LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "RepairCatalogReferenceDataForSetup", "Authoritative catalog reference/default data phase completed.", detailsForMessage, "Catalog reference/default data", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogReferenceData", "CodeDb", "ManagedObjectCatalog"
    If showMessage Then CoreShowMessage "Catalog reference/default data phase completed." & vbCrLf & vbCrLf & detailsForMessage, vbInformation, "Managed Object Catalog", "ShowADCMessage", "Tables"
    RepairCatalogReferenceDataForSetup = True
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    detailsForMessage = "Authoritative catalog reference/default data phase failed." & vbCrLf & "Err.Number: " & CStr(savedErrNumber) & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
    LogTraceMessage TRACE_LEVEL_ERROR, "ManagedObjectCatalog", "RepairCatalogReferenceDataForSetup", "Authoritative catalog reference/default data phase failed.", detailsForMessage, "Catalog reference/default data", savedErrNumber, savedErrSource, savedErrDescription, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogReferenceData", "CodeDb", "ManagedObjectCatalog"
    If showMessage Then CoreShowErrorMessage detailsForMessage, vbCritical, "Managed Object Catalog", "RepairCatalogReferenceDataForSetup", "Tables": Exit Function
    Err.Raise savedErrNumber, "RepairCatalogReferenceDataForSetup", detailsForMessage
End Function

Private Sub PrepareOpenCatalogTablesForDesignChange(ByVal actionText As String, ByVal lookupTableNames As Variant, ByVal coreTableNames As Variant, ByVal macroClassificationTableNames As Variant, ByVal systemMacroTableNames As Variant, ByVal helpDocumentTableNames As Variant)
    Dim seen As Object
    Dim familyNames As Variant
    Dim tableName As Variant
    Dim familyIndex As Long
    Dim families As Variant
    ' INTENTIONAL KEYED LOOKUP: seen provides keyed membership/lookup over source rows or state already read by PrepareOpenCatalogTablesForDesignChange; it is a derived access path, not a second authority.
    Set seen = CreateObject("Scripting.Dictionary")
    seen.CompareMode = vbTextCompare
    families = Array(lookupTableNames, coreTableNames, macroClassificationTableNames, systemMacroTableNames, helpDocumentTableNames)
    For familyIndex = LBound(families) To UBound(families)
        familyNames = families(familyIndex)
        For Each tableName In familyNames
            If Len(Trim$(CStr(tableName))) > 0 Then
                If seen.Exists(CStr(tableName)) = False Then
                    seen.Add CStr(tableName), True
                    If CodeDbTableExists(CStr(tableName)) Then
                        If SharedAccess_PrepareOpenObjectForDesignChange(acTable, CStr(tableName), actionText & " [" & CStr(tableName) & "]") = False Then
                            MarkSystemCommandCancelled
                            Err.Raise vbObjectError + 8994, "PrepareOpenCatalogTablesForDesignChange", "Catalog table design preparation was cancelled." & vbCrLf & "Table: " & CStr(tableName)
                        End If
                    End If
                End If
            End If
        Next tableName
        RequireSafeWorkContinue "PrepareOpenCatalogTablesForDesignChange", "Catalog table family " & CStr(familyIndex + 1) & " of " & CStr(UBound(families) - LBound(families) + 1)
    Next familyIndex
End Sub

Private Function CatalogSimpleLookupDefinitionIndex() As Object
    Dim indexByTable As Object
    Dim rowData As Variant
    Dim tableName As String
    Dim fieldNames As Variant
    ' INTENTIONAL KEYED LOOKUP: indexByTable provides keyed membership/lookup over source rows or state already read by CatalogSimpleLookupDefinitionIndex; it is a derived access path, not a second authority.
    Set indexByTable = CreateObject("Scripting.Dictionary")
    indexByTable.CompareMode = vbTextCompare
    For Each rowData In CatalogLookupDefinitions()
        tableName = CStr(rowData(0))
        If Len(tableName) > 0 Then
            If indexByTable.Exists(tableName) Then
                fieldNames = indexByTable(tableName)
                If StrComp(CStr(fieldNames(0)), CStr(rowData(1)), vbTextCompare) <> 0 Or StrComp(CStr(fieldNames(1)), CStr(rowData(2)), vbTextCompare) <> 0 Then Err.Raise vbObjectError + 9498, "CatalogSimpleLookupDefinitionIndex", "Canonical lookup definitions for one table disagree on the code/display field identity." & vbCrLf & "Table: " & tableName
            Else
                indexByTable.Add tableName, Array(CStr(rowData(1)), CStr(rowData(2)))
            End If
        End If
    Next rowData
    Set CatalogSimpleLookupDefinitionIndex = indexByTable
End Function

Private Function CatalogSimpleLookupFieldNames(ByVal tableName As String, ByRef codeFieldName As String, ByRef displayFieldName As String, Optional ByVal lookupDefinitionIndex As Variant) As Boolean
    Dim indexByTable As Object
    Dim fieldNames As Variant
    codeFieldName = vbNullString
    displayFieldName = vbNullString
    Select Case tableName
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SetupActions")
            codeFieldName = FIELD_SETUP_ACTION_CODE
            displayFieldName = FIELD_SETUP_ACTION_NAME
            CatalogSimpleLookupFieldNames = True
            Exit Function
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_FormTypes")
            codeFieldName = FIELD_FORM_TYPE_CODE
            displayFieldName = FIELD_FORM_TYPE_NAME
            CatalogSimpleLookupFieldNames = True
            Exit Function
    End Select
    If isMissing(lookupDefinitionIndex) Then
        Set indexByTable = CatalogSimpleLookupDefinitionIndex()
    ElseIf IsObject(lookupDefinitionIndex) Then
        Set indexByTable = lookupDefinitionIndex
    End If
    If indexByTable Is Nothing Then Set indexByTable = CatalogSimpleLookupDefinitionIndex()
    If indexByTable.Exists(tableName) Then
        fieldNames = indexByTable(tableName)
        codeFieldName = CStr(fieldNames(0))
        displayFieldName = CStr(fieldNames(1))
        CatalogSimpleLookupFieldNames = True
    End If
End Function

' Purpose: Resolves catalog table field order text from the supplied/current ADC state, using `CatalogTableSchemaDefinitions` and `Next` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   tableName (Input; String): Canonical or physical name identifying the table targeted by this operation.
' Returns: String: Returns the formatted text produced by this routine. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not
'   resolved.
Public Function CatalogTableFieldOrderText(ByVal tableName As String) As String
    'Returns canonical field order derived only from the Catalog-owned physical schema definitions.
    Dim definitions As Collection
    Dim fieldDefinition As Variant
    Set definitions = CatalogTableSchemaDefinitions(tableName)
    For Each fieldDefinition In definitions
        If Len(CatalogTableFieldOrderText) > 0 Then CatalogTableFieldOrderText = CatalogTableFieldOrderText & "|"
        CatalogTableFieldOrderText = CatalogTableFieldOrderText & CStr(fieldDefinition(0))
    Next fieldDefinition
End Function

