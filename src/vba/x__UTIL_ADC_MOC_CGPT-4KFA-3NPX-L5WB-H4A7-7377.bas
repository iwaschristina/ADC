Private Function SystemHelpManagedDefinitionMatchKey(ByVal objectName As String, ByVal ribbonTabKey As String, ByVal ribbonTabLabel As String, ByVal ribbonGroupLabel As String, ByVal ribbonGroupOrder As Long, ByVal ribbonStaticTag As String) As String
    SystemHelpManagedDefinitionMatchKey = UCase$(objectName) & Chr$(30) & UCase$(Trim$(ribbonTabKey)) & Chr$(30) & UCase$(Trim$(ribbonTabLabel)) & Chr$(30) & UCase$(Trim$(ribbonGroupLabel)) & Chr$(30) & CStr(ribbonGroupOrder) & Chr$(30) & UCase$(Trim$(ribbonStaticTag))
End Function

Private Function SystemHelpExpectedManagedDefinitionCurrent(ByVal managedDefinitionRows As Object, ByVal payloadRowsByManagedID As Object, ByVal expectedObjectName As String, ByVal expectedRibbonTabKey As String, ByVal expectedRibbonTabLabel As String, ByVal expectedRibbonGroup As String, ByVal expectedRibbonGroupOrder As Long, ByVal expectedRibbonStaticTag As String, ByVal expectedRunCode As String, ByVal sourceIdentity As String, ByRef detailText As String) As Boolean
    Dim definitionKey As String
    Dim managedRows As Collection
    Dim payloadRows As Collection
    Dim payloadData As Variant
    Dim managedObjectID As Long
    Dim managedRowCount As Long
    Dim payloadRowCount As Long
    Dim actualPayloadKind As String
    Dim actualRunCode As String
    definitionKey = SystemHelpManagedDefinitionMatchKey(expectedObjectName, expectedRibbonTabKey, expectedRibbonTabLabel, expectedRibbonGroup, expectedRibbonGroupOrder, expectedRibbonStaticTag)
    If managedDefinitionRows.Exists(definitionKey) Then
        Set managedRows = managedDefinitionRows(definitionKey)
        managedRowCount = managedRows.count
        If managedRowCount > 0 Then managedObjectID = CLng(managedRows(1))
    End If
    If managedRowCount <> 1 Or managedObjectID <= 0 Then
        detailText = "Current System Macro and Help Document Macro managed definition is missing or does not exactly match its authoritative permanent Ribbon identity." & vbCrLf & sourceIdentity & vbCrLf & "Expected object: " & expectedObjectName & vbCrLf & "Expected Ribbon: " & expectedRibbonTabKey & " / " & expectedRibbonGroup & " / " & CStr(expectedRibbonGroupOrder) & vbCrLf & "Expected permanent tag: " & expectedRibbonStaticTag & vbCrLf & "Matching managed rows: " & CStr(managedRowCount)
        Exit Function
    End If
    If payloadRowsByManagedID.Exists(CStr(managedObjectID)) Then
        Set payloadRows = payloadRowsByManagedID(CStr(managedObjectID))
        payloadRowCount = payloadRows.count
        If payloadRowCount = 1 Then
            payloadData = payloadRows(1)
            actualPayloadKind = Trim$(CStr(payloadData(0)))
            actualRunCode = Trim$(CStr(payloadData(1)))
            If StrComp(actualPayloadKind, ADCAT_PAYLOAD_ACCESS_MACRO_RUNCODE, vbTextCompare) <> 0 Or StrComp(actualRunCode, Trim$(expectedRunCode), vbBinaryCompare) <> 0 Then
                detailText = "Current System Macro and Help Document Macro managed payload is not exact." & vbCrLf & sourceIdentity & vbCrLf & "Expected object: " & expectedObjectName
                Exit Function
            End If
        End If
    End If
    If payloadRowCount <> 1 Then
        detailText = "Current System Macro and Help Document Macro managed definition does not have exactly one active RunCode payload." & vbCrLf & sourceIdentity & vbCrLf & "Expected object: " & expectedObjectName & vbCrLf & "Active payload rows: " & CStr(payloadRowCount)
        Exit Function
    End If
    SystemHelpExpectedManagedDefinitionCurrent = True
End Function

Private Function SystemHelpMacroManagedDefinitionsCurrent(ByRef detailText As String) As Boolean
    On Error GoTo NotCurrentError
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim catalogRows As Collection
    Dim rowData As Variant
    Dim systemMacroKey As String
    Dim MacroTitle As String
    Dim expectedRunCode As String
    Dim expectedRibbonGroup As String
    Dim expectedRibbonGroupOrder As Long
    Dim expectedRibbonTabKey As String
    Dim expectedRibbonTabLabel As String
    Dim expectedRibbonStaticTag As String
    Dim groupDefinitionIndex As Object
    Dim systemMacroDefinitions As Collection
    Dim systemMacroDefinitionIndex As Object
    Dim systemMacroDefinition As Variant
    Dim definitionData As Variant
    Dim definitionKey As String
    Dim managedDefinitionRows As Object
    Dim managedRows As Collection
    Dim payloadRowsByManagedID As Object
    Dim payloadRows As Collection
    Dim synchronizationScope As HelpDocumentSynchronizationScope
    Dim helpDocumentKey As String
    Dim helpDocumentNumber As Long
    Dim rowIdentity As String
    Dim runCodeExpression As String
    Dim systemDefinitionCount As Long
    Dim helpDefinitionCount As Long
    detailText = vbNullString
    Set db = ResolveCatalogDb()
    Set systemMacroDefinitions = x__UTIL_ADC_DEFAULTS.GetSystemMacroDefinitions()
    Set systemMacroDefinitionIndex = CreateObject("Scripting.Dictionary")
    systemMacroDefinitionIndex.CompareMode = vbTextCompare
    For Each definitionData In systemMacroDefinitions
        definitionKey = Trim$(CStr(definitionData(0)))
        If Len(definitionKey) > 0 Then
            If systemMacroDefinitionIndex.Exists(definitionKey) = False Then systemMacroDefinitionIndex.Add definitionKey, definitionData
        End If
    Next definitionData
    ' INTENTIONAL KEYED LOOKUPS: these procedure-local indexes are fresh projections of one active System Macro and Help Document Macro MAC read and one active payload read; all expected definitions reuse them
    ' without per-command DAO lookups.
    Set managedDefinitionRows = CreateObject("Scripting.Dictionary")
    managedDefinitionRows.CompareMode = vbTextCompare
    Set payloadRowsByManagedID = CreateObject("Scripting.Dictionary")
    payloadRowsByManagedID.CompareMode = vbTextCompare
    Set rs = db.OpenRecordset("SELECT " & SQL_FIELD_ID & "," & SQL_FIELD_OBJECT_NAME & ",[" & FIELD_RIBBON_TAB_KEY & "],[" & FIELD_RIBBON_TAB_LABEL & "],[" & FIELD_RIBBON_GROUP_LABEL & "],[" & FIELD_RIBBON_GROUP_SORT_ORDER & "],[" & FIELD_RIBBON_STATIC_TAG & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] WHERE Nz([" & FIELD_MANAGED_OBJECT_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND UCase(Trim(Nz(" & SQL_FIELD_OBJECT_TYPE & ",'')))=" & SharedDao_SqlQuote(UCase$(ADCAT_OBJECT_TYPE_MACRO)) & " AND UCase(Trim(Nz([" & FIELD_CATEGORY_CODE & "],'')))=" & SharedDao_SqlQuote(UCase$(ADCAT_CATEGORY_SYSTEM_MACRO)) & " AND UCase(Trim(Nz([" & FIELD_CATALOG_OWNER & "],'')))=" & SharedDao_SqlQuote(UCase$(ADCAT_OWNER_SYSTEM_DEFAULT)) & _
                ";", dbOpenSnapshot)
    Do While rs.EOF = False
        definitionKey = SystemHelpManagedDefinitionMatchKey(CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString)), CStr(Nz(rs.fields(FIELD_RIBBON_TAB_KEY).value, vbNullString)), CStr(Nz(rs.fields(FIELD_RIBBON_TAB_LABEL).value, vbNullString)), CStr(Nz(rs.fields(FIELD_RIBBON_GROUP_LABEL).value, vbNullString)), CLng(Nz(rs.fields(FIELD_RIBBON_GROUP_SORT_ORDER).value, 0)), CStr(Nz(rs.fields(FIELD_RIBBON_STATIC_TAG).value, vbNullString)))
        If managedDefinitionRows.Exists(definitionKey) Then
            Set managedRows = managedDefinitionRows(definitionKey)
        Else
            Set managedRows = New Collection
            managedDefinitionRows.Add definitionKey, managedRows
        End If
        managedRows.Add CLng(Nz(rs.fields(FIELD_ID).value, 0))
        rs.MoveNext
    Loop
    rs.Close
    Set rs = Nothing
    Set rs = db.OpenRecordset("SELECT [" & FIELD_MANAGED_OBJECT_ID & "],[" & FIELD_PAYLOAD_KIND & "],[" & FIELD_RUN_CODE_WRAPPER_NAME & "] FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads") & "] WHERE Nz([" & FIELD_PAYLOAD_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ";", dbOpenSnapshot)
    Do While rs.EOF = False
        definitionKey = CStr(CLng(Nz(rs.fields(FIELD_MANAGED_OBJECT_ID).value, 0)))
        If payloadRowsByManagedID.Exists(definitionKey) Then
            Set payloadRows = payloadRowsByManagedID(definitionKey)
        Else
            Set payloadRows = New Collection
            payloadRowsByManagedID.Add definitionKey, payloadRows
        End If
        payloadRows.Add Array(CStr(Nz(rs.fields(FIELD_PAYLOAD_KIND).value, vbNullString)), CStr(Nz(rs.fields(FIELD_RUN_CODE_WRAPPER_NAME).value, vbNullString)))
        rs.MoveNext
    Loop
    rs.Close
    Set rs = Nothing
    Set catalogRows = SystemMacroCatalog(suppliedSystemMacroDefinitions:=systemMacroDefinitions)
    Set groupDefinitionIndex = SystemRibbonGroupDefinitionIndex()
    For Each rowData In catalogRows
        systemMacroKey = SystemMacroCatalogKey(rowData)
        MacroTitle = SystemMacroCatalogTitle(rowData)
        expectedRunCode = SystemMacroCatalogRunCodeFunctionName(rowData)
        If systemMacroDefinitionIndex.Exists(systemMacroKey) Then
            systemMacroDefinition = systemMacroDefinitionIndex(systemMacroKey)
            SystemRibbonPlacementForKey systemMacroKey, expectedRibbonTabKey, expectedRibbonTabLabel, expectedRibbonGroup, expectedRibbonGroupOrder, groupDefinitionIndex, systemMacroDefinition
            expectedRibbonStaticTag = SystemMacroRibbonStaticTag(systemMacroKey, systemMacroDefinition)
        Else
            SystemRibbonPlacementForKey systemMacroKey, expectedRibbonTabKey, expectedRibbonTabLabel, expectedRibbonGroup, expectedRibbonGroupOrder, groupDefinitionIndex
            expectedRibbonStaticTag = SystemMacroRibbonStaticTag(systemMacroKey)
        End If
        If SystemHelpExpectedManagedDefinitionCurrent(managedDefinitionRows, payloadRowsByManagedID, MacroTitle, expectedRibbonTabKey, expectedRibbonTabLabel, expectedRibbonGroup, expectedRibbonGroupOrder, expectedRibbonStaticTag, expectedRunCode, "SystemMacroKey: " & systemMacroKey, detailText) = False Then Exit Function
        systemDefinitionCount = systemDefinitionCount + 1
    Next rowData
    synchronizationScope = CoreSetupHelpDocumentSynchronizationScope()
    If synchronizationScope <> HelpDocumentScopeSetupSystemOnly Then
        HelpDocumentSystemRibbonPlacement expectedRibbonTabKey, expectedRibbonTabLabel, expectedRibbonGroup, expectedRibbonGroupOrder, groupDefinitionIndex
        Set rs = db.OpenRecordset("SELECT * FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HelpDocuments") & "] WHERE Nz(" & SQL_FIELD_HELP_DOCUMENT_STATUS & "," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " ORDER BY " & OrderByPolicyText("CATALOG_HELP_DOCUMENT") & ";", dbOpenSnapshot)
        Do While rs.EOF = False
            helpDocumentKey = CStr(Nz(rs.fields(FIELD_HELP_DOCUMENT_KEY).value, vbNullString))
            If HelpDocumentKeyInSynchronizationScope(synchronizationScope) Then
                rowIdentity = vbNullString
                If SharedDao_RecordsetHasFieldSafe(rs, FIELD_ID) Then rowIdentity = CStr(Nz(rs.fields(FIELD_ID).value, vbNullString))
                helpDocumentNumber = CLng(Nz(rs.fields(FIELD_HELP_DOCUMENT_NUMBER).value, 0))
                ResolveHelpDocumentMaterialization helpDocumentKey, helpDocumentNumber, CStr(Nz(rs.fields(FIELD_DEFAULT_TITLE_TEXT).value, vbNullString)), CStr(Nz(rs.fields(FIELD_MACRO_TITLE_OVERRIDE).value, vbNullString)), rowIdentity, synchronizationScope, MacroTitle, runCodeExpression
                expectedRibbonStaticTag = GetHelpDocumentRibbonStaticTag(helpDocumentNumber)
                If SystemHelpExpectedManagedDefinitionCurrent(managedDefinitionRows, payloadRowsByManagedID, MacroTitle, expectedRibbonTabKey, expectedRibbonTabLabel, expectedRibbonGroup, expectedRibbonGroupOrder, expectedRibbonStaticTag, runCodeExpression, "HelpDocumentKey: " & helpDocumentKey, detailText) = False Then Exit Function
                helpDefinitionCount = helpDefinitionCount + 1
            End If
            rs.MoveNext
        Loop
        rs.Close
        Set rs = Nothing
    End If
    AddTraceNote "System Macro and Help Document Macro managed-definition authority proof reused one active System Macro and Help Document Macro MAC index and one active payload index. Built-in System Macros checked=" & CStr(systemDefinitionCount) & "; active in-scope Help Documents checked=" & CStr(helpDefinitionCount) & "."
    detailText = "Current System Macro and Help Document Macro managed definitions, permanent Ribbon identities, and RunCode payloads are exact. Built-in System Macros=" & CStr(systemDefinitionCount) & "; Help Documents=" & CStr(helpDefinitionCount) & "."
    SystemHelpMacroManagedDefinitionsCurrent = True
    Exit Function
NotCurrentError:
    detailText = "Could not prove the current System Macro and Help Document Macro managed definitions." & vbCrLf & "Err.Number: " & CStr(Err.Number) & vbCrLf & "Err.Source: " & Err.Source & vbCrLf & "Err.Description: " & Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    Set rs = Nothing
End Function

Private Sub MarkManagedDefinitionMutation(ByVal domainMask As Long)
    Dim timingStarted As Single
    If domainMask = 0 Then Exit Sub
    If (domainMask And (CATALOG_DIRTY_INVENTORY Or CATALOG_DIRTY_UI Or CATALOG_DIRTY_FORMS)) <> 0 Then
        ClearManagedPlacementValidationSnapshot
    End If
    If mPhase13TimingActive Then timingStarted = Timer
    If mManagedDefinitionBatchActive Then
        mManagedDefinitionBatchDirtyMask = mManagedDefinitionBatchDirtyMask Or domainMask
    Else
        CatalogMarkSetupDomainsDirty domainMask
    End If
    If mPhase13TimingActive Then mPhase13FingerprintInvalidationElapsedSeconds = mPhase13FingerprintInvalidationElapsedSeconds + ElapsedSecondsFromTimer(timingStarted)
End Sub

Private Function ManagedDefinitionBatchMutationCount() As Long
    ManagedDefinitionBatchMutationCount = mManagedDefinitionBatchManagedInserted + mManagedDefinitionBatchManagedUpdated + mManagedDefinitionBatchPayloadInserted + mManagedDefinitionBatchPayloadUpdated
End Function

Private Function ManagedDefinitionObjectPlanKey(ByVal objectName As String, ByVal categoryCode As String, ByVal objectTypeCode As String) As String
    Dim namingCategory As String
    Dim logicalObjectName As String
    namingCategory = ManagedObjectNamingCategory(objectTypeCode, categoryCode, objectName)
    If Len(namingCategory) > 0 Then logicalObjectName = LogicalObjectNameFromPhysicalName(namingCategory, objectName)
    ManagedDefinitionObjectPlanKey = ManagedDefinitionStableIdentityKey(logicalObjectName, namingCategory, objectTypeCode, objectName)
End Function

Private Function ManagedDefinitionPayloadPlanKey(ByVal objectPlanKey As String, ByVal payloadKind As String) As String
    ManagedDefinitionPayloadPlanKey = objectPlanKey & Chr$(29) & UCase$(Trim$(payloadKind))
End Function

Private Sub ManagedDefinitionAddLongToIndex(ByVal indexDictionary As Object, ByVal indexKey As String, ByVal rowID As Long)
    Dim rows As Collection
    If Len(indexKey) = 0 Or rowID <= 0 Then Exit Sub
    If indexDictionary.Exists(indexKey) Then
        Set rows = indexDictionary(indexKey)
    Else
        ' INTENTIONAL FILTERED PARTITION: rows is a consumer-required subset/projection derived from the source enumerated by ManagedDefinitionAddLongToIndex; its membership is not independently authoritative.
        Set rows = New Collection
        indexDictionary.Add indexKey, rows
    End If
    rows.Add rowID
End Sub

Private Function ManagedDefinitionRowsForKey(ByVal indexDictionary As Object, ByVal indexKey As String) As Collection
    Dim rows As Collection
    ' INTENTIONAL FILTERED PARTITION: rows is a consumer-required subset/projection derived from the source enumerated by ManagedDefinitionRowsForKey; its membership is not independently authoritative.
    Set rows = New Collection
    If Not indexDictionary Is Nothing Then
        If indexDictionary.Exists(indexKey) Then Set rows = indexDictionary(indexKey)
    End If
    Set ManagedDefinitionRowsForKey = rows
End Function

Private Function ManagedDefinitionDefinitionSignature(ByVal values As Variant) As String
    Dim item As Variant
    Dim signatureText As String
    Dim signatureTimer As Single
    signatureTimer = Timer
    For Each item In values
        signatureText = signatureText & LengthPrefixedVariant(item)
    Next item
    ManagedDefinitionDefinitionSignature = FingerprintFromPayload(signatureText)
    mManagedDefinitionSignatureElapsedSeconds = mManagedDefinitionSignatureElapsedSeconds + ElapsedSecondsFromTimer(signatureTimer)
End Function

Private Sub BeginManagedDefinitionPlanCapture()
    Set mManagedDefinitionObjectPlan = CreateObject("Scripting.Dictionary")
    mManagedDefinitionObjectPlan.CompareMode = vbBinaryCompare
    Set mManagedDefinitionPayloadPlan = CreateObject("Scripting.Dictionary")
    mManagedDefinitionPayloadPlan.CompareMode = vbBinaryCompare
    Set mManagedDefinitionObjectPhysicalIndex = CreateObject("Scripting.Dictionary")
    mManagedDefinitionObjectPhysicalIndex.CompareMode = vbTextCompare
    Set mManagedDefinitionObjectOrder = New Collection
    Set mManagedDefinitionPayloadOrder = New Collection
    mManagedDefinitionCaptureFamily = MANAGED_DEFINITION_FAMILY_SUPPORT
    mManagedDefinitionCaptureActive = True
    mManagedDefinitionTableConstructionElapsedSeconds = 0
    mManagedDefinitionQueryConstructionElapsedSeconds = 0
    mManagedDefinitionLookupConstructionElapsedSeconds = 0
    mManagedDefinitionPayloadConstructionElapsedSeconds = 0
    mManagedDefinitionNamingResolutionElapsedSeconds = 0
    mManagedDefinitionCategoryResolutionElapsedSeconds = 0
    mManagedDefinitionSignatureElapsedSeconds = 0
    mManagedDefinitionInitialDeltaComparisonElapsedSeconds = 0
    mManagedDefinitionInitialObjectMatchedCount = 0
    mManagedDefinitionInitialObjectInsertCount = 0
    mManagedDefinitionInitialObjectUpdateCount = 0
    mManagedDefinitionInitialObjectConflictCount = 0
    mManagedDefinitionInitialPayloadMatchedCount = 0
    mManagedDefinitionInitialPayloadInsertCount = 0
    mManagedDefinitionInitialPayloadUpdateCount = 0
    mManagedDefinitionInitialPayloadConflictCount = 0
    mManagedDefinitionInitialDirtyCount = 0
    mManagedDefinitionInitialDirtyObjectList = vbNullString
    mManagedDefinitionInitialDirtyPayloadList = vbNullString
End Sub

Private Sub EndManagedDefinitionPlanCapture()
    mManagedDefinitionCaptureActive = False
    mManagedDefinitionCaptureFamily = vbNullString
End Sub

Private Function ManagedDefinitionFamilyCount(ByVal planDictionary As Object, ByVal familyName As String, ByVal familyIndex As Long) As Long
    Dim keyValue As Variant
    Dim definitionData As Variant
    For Each keyValue In planDictionary.keys
        definitionData = planDictionary(CStr(keyValue))
        If StrComp(CStr(definitionData(familyIndex)), familyName, vbBinaryCompare) = 0 Then ManagedDefinitionFamilyCount = ManagedDefinitionFamilyCount + 1
    Next keyValue
End Function

Private Sub BuildCoreManagedDefinitionPlan()
    Dim planTimer As Single
    Dim catalogTableDefinitions As Collection
    Dim reviewQueryDefinitions As Collection
    Dim reviewPayloadDefinitions As Collection
    Dim lookupTableDefinitions As Collection
    Dim formDesignDefinitions As Collection
    Dim formDesignPayloadDefinitions As Collection
    planTimer = Timer
    Set catalogTableDefinitions = ManagedObjectCatalogTableDefinitions()
    Set reviewQueryDefinitions = ManagedObjectReviewQueryDefinitions()
    Set reviewPayloadDefinitions = ManagedObjectReviewActionPayloadDefinitions(reviewQueryDefinitions)
    Set lookupTableDefinitions = EditableLookupTableManagedObjectDefinitions()
    Set formDesignDefinitions = FormDesignManagedObjectDefinitions()
    Set formDesignPayloadDefinitions = FormDesignActionPayloadDefinitions(formDesignDefinitions)
    BeginManagedDefinitionPlanCapture
    On Error GoTo ErrHandler
    DefaultCoreManagedObjectRowsFromCurrentUtility False, catalogTableDefinitions, reviewQueryDefinitions, reviewPayloadDefinitions, lookupTableDefinitions, formDesignDefinitions, formDesignPayloadDefinitions
    EndManagedDefinitionPlanCapture
    ValidateCoreManagedDefinitionPlan catalogTableDefinitions, reviewQueryDefinitions, reviewPayloadDefinitions, formDesignDefinitions, formDesignPayloadDefinitions, lookupTableDefinitions
    mManagedDefinitionPlanPreparationElapsedSeconds = ElapsedSecondsFromTimer(planTimer)
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    EndManagedDefinitionPlanCapture
    Err.Raise savedErrNumber, "BuildCoreManagedDefinitionPlan", "Could not build the normalized authoritative B3 definition set." & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Sub

Private Function ManagedDefinitionObjectNeedsUpdate(ByVal definitionData As Variant, ByVal rs As DAO.Recordset, ByRef reasonText As String) As Boolean
    Dim ownerCode As String
    Dim expectedText As String
    Dim actualText As String
    Dim expectedChatGPTUIReport As Boolean
    ownerCode = Trim$(CStr(Nz(rs.fields(FIELD_CATALOG_OWNER).value, vbNullString)))
    If Len(ownerCode) = 0 Then reasonText = "CatalogOwner blank": ManagedDefinitionObjectNeedsUpdate = True: Exit Function
    If StrComp(ownerCode, ADCAT_OWNER_SYSTEM_DEFAULT, vbTextCompare) <> 0 Then
        reasonText = "CatalogOwner conflict: " & ownerCode
        ManagedDefinitionObjectNeedsUpdate = True
        Exit Function
    End If
    expectedText = CStr(definitionData(MANAGED_DEFINITION_OBJECT_NAME)): actualText = CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString)): If StrComp(actualText, expectedText, vbBinaryCompare) <> 0 Then reasonText = FIELD_OBJECT_NAME: ManagedDefinitionObjectNeedsUpdate = True: Exit Function
    expectedText = CStr(definitionData(MANAGED_DEFINITION_OBJECT_LOGICAL_NAME)): actualText = Trim$(CStr(Nz(rs.fields(FIELD_LOGICAL_OBJECT_NAME).value, vbNullString))): If StrComp(actualText, expectedText, vbTextCompare) <> 0 Then reasonText = FIELD_LOGICAL_OBJECT_NAME: ManagedDefinitionObjectNeedsUpdate = True: Exit Function
    expectedText = CStr(definitionData(MANAGED_DEFINITION_OBJECT_NAMING_CATEGORY)): actualText = Trim$(CStr(Nz(rs.fields(FIELD_OBJECT_NAMING_CATEGORY).value, vbNullString))): If StrComp(actualText, expectedText, vbTextCompare) <> 0 Then reasonText = FIELD_OBJECT_NAMING_CATEGORY: ManagedDefinitionObjectNeedsUpdate = True: Exit Function
    expectedText = CStr(definitionData(MANAGED_DEFINITION_OBJECT_TYPE)): actualText = Trim$(CStr(Nz(rs.fields(FIELD_OBJECT_TYPE).value, vbNullString))): If StrComp(actualText, expectedText, vbTextCompare) <> 0 Then reasonText = FIELD_OBJECT_TYPE: ManagedDefinitionObjectNeedsUpdate = True: Exit Function
    expectedChatGPTUIReport = ExpectedChatGPTUIReportForManagedObject(CStr(definitionData(MANAGED_DEFINITION_OBJECT_NAME)), CStr(definitionData(MANAGED_DEFINITION_OBJECT_TYPE)))
    If IsNull(rs.fields(FIELD_CHAT_GPTUI_REPORT).value) Or CBool(Nz(rs.fields(FIELD_CHAT_GPTUI_REPORT).value, False)) <> expectedChatGPTUIReport Then reasonText = FIELD_CHAT_GPTUI_REPORT: ManagedDefinitionObjectNeedsUpdate = True: Exit Function
    expectedText = CStr(definitionData(MANAGED_DEFINITION_OBJECT_CATEGORY)): actualText = Trim$(CStr(Nz(rs.fields(FIELD_CATEGORY_CODE).value, vbNullString))): If StrComp(actualText, expectedText, vbTextCompare) <> 0 Then reasonText = FIELD_CATEGORY_CODE: ManagedDefinitionObjectNeedsUpdate = True: Exit Function
    actualText = Trim$(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_STATUS).value, vbNullString))): If StrComp(actualText, ADCAT_STATUS_ACTIVE, vbTextCompare) <> 0 Then reasonText = FIELD_MANAGED_OBJECT_STATUS: ManagedDefinitionObjectNeedsUpdate = True: Exit Function
    If CLng(Nz(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value, 0)) <> CLng(definitionData(MANAGED_DEFINITION_OBJECT_SORT_ORDER)) Then reasonText = FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER: ManagedDefinitionObjectNeedsUpdate = True: Exit Function
    expectedText = CStr(definitionData(MANAGED_DEFINITION_OBJECT_NAME)): actualText = CStr(Nz(rs.fields(FIELD_OBJECT_DISPLAY_NAME).value, vbNullString)): If StrComp(actualText, expectedText, vbBinaryCompare) <> 0 Then reasonText = FIELD_OBJECT_DISPLAY_NAME: ManagedDefinitionObjectNeedsUpdate = True: Exit Function
    ' During Setup, G1 is the sole authority for MAC.ObjectDescription. B3/B4 carry authoritative description metadata but must not classify the physical description as dirty while their write path is intentionally
    ' gated off.
    If SetupDomainMutationWritesAllowedForCurrentPart(SETUP_DOMAIN_G1_DESCRIPTIONS) Then
        expectedText = CStr(definitionData(MANAGED_DEFINITION_OBJECT_DESCRIPTION))
        actualText = CStr(Nz(rs.fields(FIELD_OBJECT_DESCRIPTION).value, vbNullString))
        If StrComp(actualText, expectedText, vbBinaryCompare) <> 0 Then reasonText = FIELD_OBJECT_DESCRIPTION: ManagedDefinitionObjectNeedsUpdate = True: Exit Function
    End If
    If StrComp(Trim$(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_VERSION).value, vbNullString))), MANAGED_OBJECT_CATALOG_SCHEMA_VERSION, vbBinaryCompare) <> 0 Then reasonText = FIELD_MANAGED_OBJECT_VERSION: ManagedDefinitionObjectNeedsUpdate = True: Exit Function
    If StrComp(Trim$(CStr(Nz(rs.fields(FIELD_DEFAULT_SOURCE).value, vbNullString))), DEFAULT_CATALOG_SOURCE, vbBinaryCompare) <> 0 Then reasonText = FIELD_DEFAULT_SOURCE: ManagedDefinitionObjectNeedsUpdate = True: Exit Function
    expectedText = CStr(definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_TITLE))
    If Len(expectedText) > 0 Then If StrComp(CStr(Nz(rs.fields(FIELD_RIBBON_TITLE).value, vbNullString)), expectedText, vbBinaryCompare) <> 0 Then reasonText = FIELD_RIBBON_TITLE: ManagedDefinitionObjectNeedsUpdate = True: Exit Function
    expectedText = CStr(definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_STATIC_TAG))
    If Len(expectedText) > 0 Then
        actualText = Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_STATIC_TAG).value, vbNullString)))
        If StrComp(actualText, expectedText, vbBinaryCompare) <> 0 Then reasonText = FIELD_RIBBON_STATIC_TAG: ManagedDefinitionObjectNeedsUpdate = True: Exit Function
    End If
    If Len(CStr(definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_TAB_KEY))) > 0 And Len(CStr(definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_TAB_LABEL))) > 0 And Len(CStr(definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_GROUP))) > 0 And CLng(definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_ORDER)) > 0 Then
        expectedText = CStr(definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_TAB_KEY)): actualText = Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_TAB_KEY).value, vbNullString))): If StrComp(actualText, expectedText, vbTextCompare) <> 0 Then reasonText = FIELD_RIBBON_TAB_KEY: ManagedDefinitionObjectNeedsUpdate = True: Exit Function
        expectedText = CStr(definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_TAB_LABEL)): actualText = Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_TAB_LABEL).value, vbNullString))): If StrComp(actualText, expectedText, vbTextCompare) <> 0 Then reasonText = FIELD_RIBBON_TAB_LABEL: ManagedDefinitionObjectNeedsUpdate = True: Exit Function
        expectedText = CStr(definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_GROUP)): actualText = Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_GROUP_LABEL).value, vbNullString))): If StrComp(actualText, expectedText, vbTextCompare) <> 0 Then reasonText = FIELD_RIBBON_GROUP_LABEL: ManagedDefinitionObjectNeedsUpdate = True: Exit Function
        If CLng(Nz(rs.fields(FIELD_RIBBON_GROUP_SORT_ORDER).value, 0)) <> CLng(definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_ORDER)) Then reasonText = FIELD_RIBBON_GROUP_SORT_ORDER: ManagedDefinitionObjectNeedsUpdate = True: Exit Function
    End If
    If ManagedObjectNeedsNewObjectPlacementRepair(rs, CStr(definitionData(MANAGED_DEFINITION_OBJECT_NAME)), CStr(definitionData(MANAGED_DEFINITION_OBJECT_TYPE))) Then reasonText = "Placement metadata": ManagedDefinitionObjectNeedsUpdate = True
End Function

Private Function ManagedDefinitionPayloadNeedsUpdate(ByVal definitionData As Variant, ByVal rs As DAO.Recordset, ByRef reasonText As String) As Boolean
    Dim ownerCode As String
    ownerCode = Trim$(CStr(Nz(rs.fields(FIELD_CATALOG_OWNER).value, vbNullString)))
    If Len(ownerCode) = 0 Then reasonText = "CatalogOwner blank": ManagedDefinitionPayloadNeedsUpdate = True: Exit Function
    If StrComp(ownerCode, ADCAT_OWNER_SYSTEM_DEFAULT, vbTextCompare) <> 0 Then
        reasonText = "CatalogOwner conflict: " & ownerCode
        ManagedDefinitionPayloadNeedsUpdate = True
        Exit Function
    End If
    If StrComp(Trim$(CStr(Nz(rs.fields(FIELD_PAYLOAD_KIND).value, vbNullString))), CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_KIND)), vbTextCompare) <> 0 Then reasonText = FIELD_PAYLOAD_KIND: ManagedDefinitionPayloadNeedsUpdate = True: Exit Function
    If StrComp(Trim$(CStr(Nz(rs.fields(FIELD_PAYLOAD_STATUS).value, vbNullString))), ADCAT_STATUS_ACTIVE, vbTextCompare) <> 0 Then reasonText = FIELD_PAYLOAD_STATUS: ManagedDefinitionPayloadNeedsUpdate = True: Exit Function
    If StrComp(Trim$(CStr(Nz(rs.fields(FIELD_ACTION_PROCEDURE_NAME).value, vbNullString))), CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_ACTION)), vbBinaryCompare) <> 0 Then reasonText = FIELD_ACTION_PROCEDURE_NAME: ManagedDefinitionPayloadNeedsUpdate = True: Exit Function
    If StrComp(Trim$(CStr(Nz(rs.fields(FIELD_RUN_CODE_WRAPPER_NAME).value, vbNullString))), CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_WRAPPER)), vbBinaryCompare) <> 0 Then reasonText = FIELD_RUN_CODE_WRAPPER_NAME: ManagedDefinitionPayloadNeedsUpdate = True: Exit Function
    If StrComp(CStr(Nz(rs.fields(FIELD_MACRO_DESCRIPTION).value, vbNullString)), CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_DESCRIPTION)), vbBinaryCompare) <> 0 Then reasonText = FIELD_MACRO_DESCRIPTION: ManagedDefinitionPayloadNeedsUpdate = True: Exit Function
    If StrComp(Trim$(CStr(Nz(rs.fields(FIELD_PAYLOAD_VERSION).value, vbNullString))), CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_VERSION)), vbBinaryCompare) <> 0 Then reasonText = FIELD_PAYLOAD_VERSION: ManagedDefinitionPayloadNeedsUpdate = True: Exit Function
    If CLng(Nz(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value, 0)) <> CLng(definitionData(MANAGED_DEFINITION_PAYLOAD_SORT_ORDER)) Then reasonText = FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER: ManagedDefinitionPayloadNeedsUpdate = True: Exit Function
    If StrComp(Trim$(CStr(Nz(rs.fields(FIELD_DEFAULT_SOURCE).value, vbNullString))), DEFAULT_CATALOG_SOURCE, vbBinaryCompare) <> 0 Then reasonText = FIELD_DEFAULT_SOURCE: ManagedDefinitionPayloadNeedsUpdate = True
End Function

Private Function ManagedDefinitionSelectedRowID(ByVal definitionKey As String, ByVal definitionData As Variant, ByRef classification As String, ByRef reasonText As String) As Long
    Dim rows As Collection
    Dim physicalKey As String
    Dim ribbonStaticTag As String
    Set rows = ManagedDefinitionRowsForKey(mManagedDefinitionRowsByStableKey, definitionKey)
    If rows.count = 0 Then
        physicalKey = ManagedDefinitionManagedBookmarkKey(CStr(definitionData(MANAGED_DEFINITION_OBJECT_NAME)), CStr(definitionData(MANAGED_DEFINITION_OBJECT_TYPE)))
        Set rows = ManagedDefinitionRowsForKey(mManagedDefinitionRowsByPhysicalKey, physicalKey)
    End If
    If rows.count = 0 Then
        ribbonStaticTag = CStr(definitionData(MANAGED_DEFINITION_OBJECT_RIBBON_STATIC_TAG))
        If Len(ribbonStaticTag) > 0 Then Set rows = ManagedDefinitionRowsForKey(mManagedDefinitionRowsByRibbonStaticTag, ribbonStaticTag)
    End If
    If rows.count = 0 Then classification = MANAGED_DEFINITION_STATUS_INSERT: reasonText = "No current row": Exit Function
    If rows.count > 1 Then classification = MANAGED_DEFINITION_STATUS_CONFLICT: reasonText = "Multiple current rows use the same stable, physical, or permanent Ribbon-tag identity": Exit Function
    ManagedDefinitionSelectedRowID = CLng(rows(1))
End Function

Private Sub BuildManagedDefinitionDelta(Optional ByVal captureInitialEvidence As Boolean = False)
    Dim comparisonTimer As Single
    Dim keyValue As Variant
    Dim definitionData As Variant
    Dim payloadData As Variant
    Dim classification As String
    Dim reasonText As String
    Dim rowID As Long
    Dim rows As Collection
    Dim payloadKey As String
    Dim objectKey As String
    Dim currentSignatureText As String
    Dim planSignatureText As String
    Dim failureDetail As String
    comparisonTimer = Timer
    Set mManagedDefinitionObjectDelta = CreateObject("Scripting.Dictionary")
    mManagedDefinitionObjectDelta.CompareMode = vbBinaryCompare
    Set mManagedDefinitionPayloadDelta = CreateObject("Scripting.Dictionary")
    mManagedDefinitionPayloadDelta.CompareMode = vbBinaryCompare
    Set mManagedDefinitionSelectedObjectIDs = CreateObject("Scripting.Dictionary")
    mManagedDefinitionSelectedObjectIDs.CompareMode = vbBinaryCompare
    mManagedDefinitionObjectMatchedCount = 0
    mManagedDefinitionObjectInsertCount = 0
    mManagedDefinitionObjectUpdateCount = 0
    mManagedDefinitionObjectConflictCount = 0
    mManagedDefinitionPayloadMatchedCount = 0
    mManagedDefinitionPayloadInsertCount = 0
    mManagedDefinitionPayloadUpdateCount = 0
    mManagedDefinitionPayloadConflictCount = 0
    mManagedDefinitionDirtyObjectList = vbNullString
    mManagedDefinitionDirtyPayloadList = vbNullString
    For Each keyValue In mManagedDefinitionObjectOrder
        definitionData = mManagedDefinitionObjectPlan(CStr(keyValue))
        classification = vbNullString
        reasonText = vbNullString
        rowID = ManagedDefinitionSelectedRowID(CStr(keyValue), definitionData, classification, reasonText)
        If Len(classification) = 0 Then
            mManagedDefinitionBatchManagedRs.Bookmark = mManagedDefinitionManagedBookmarksByID(CStr(rowID))
            If ManagedDefinitionObjectNeedsUpdate(definitionData, mManagedDefinitionBatchManagedRs, reasonText) Then
                If Left$(reasonText, Len("CatalogOwner conflict:")) = "CatalogOwner conflict:" Then classification = MANAGED_DEFINITION_STATUS_CONFLICT Else classification = MANAGED_DEFINITION_STATUS_UPDATE
            Else
                classification = MANAGED_DEFINITION_STATUS_MATCHED
            End If
        End If
        mManagedDefinitionObjectDelta.Add CStr(keyValue), Array(classification, reasonText, rowID)
        If rowID > 0 Then mManagedDefinitionSelectedObjectIDs.Add CStr(keyValue), rowID
        Select Case classification
            Case MANAGED_DEFINITION_STATUS_MATCHED
                mManagedDefinitionObjectMatchedCount = mManagedDefinitionObjectMatchedCount + 1
            Case MANAGED_DEFINITION_STATUS_INSERT
                mManagedDefinitionObjectInsertCount = mManagedDefinitionObjectInsertCount + 1
                mManagedDefinitionDirtyObjectList = SharedText_AppendNonBlankLine(mManagedDefinitionDirtyObjectList, CStr(definitionData(MANAGED_DEFINITION_OBJECT_TYPE)) & " " & CStr(definitionData(MANAGED_DEFINITION_OBJECT_NAME)) & " | Insert | " & reasonText)
            Case MANAGED_DEFINITION_STATUS_UPDATE
                mManagedDefinitionObjectUpdateCount = mManagedDefinitionObjectUpdateCount + 1
                mManagedDefinitionDirtyObjectList = SharedText_AppendNonBlankLine(mManagedDefinitionDirtyObjectList, CStr(definitionData(MANAGED_DEFINITION_OBJECT_TYPE)) & " " & CStr(definitionData(MANAGED_DEFINITION_OBJECT_NAME)) & " | Update | " & reasonText)
            Case Else
                mManagedDefinitionObjectConflictCount = mManagedDefinitionObjectConflictCount + 1
                failureDetail = SharedText_AppendNonBlankLine(failureDetail, CStr(definitionData(MANAGED_DEFINITION_OBJECT_TYPE)) & " " & CStr(definitionData(MANAGED_DEFINITION_OBJECT_NAME)) & " | " & classification & " | " & reasonText)
        End Select
        planSignatureText = planSignatureText & LengthPrefixedVariant(CStr(definitionData(MANAGED_DEFINITION_OBJECT_SIGNATURE)))
        currentSignatureText = currentSignatureText & LengthPrefixedVariant(classification & ":" & CStr(rowID) & ":" & reasonText)
    Next keyValue
    For Each keyValue In mManagedDefinitionPayloadOrder
        payloadData = mManagedDefinitionPayloadPlan(CStr(keyValue))
        objectKey = CStr(payloadData(MANAGED_DEFINITION_PAYLOAD_OBJECT_KEY))
        classification = vbNullString
        reasonText = vbNullString
        rowID = 0
        If mManagedDefinitionSelectedObjectIDs.Exists(objectKey) = False Then
            classification = MANAGED_DEFINITION_STATUS_INSERT
            reasonText = "Managed object will be inserted"
        Else
            payloadKey = ManagedDefinitionPayloadBookmarkKey(CLng(mManagedDefinitionSelectedObjectIDs(objectKey)), CStr(payloadData(MANAGED_DEFINITION_PAYLOAD_KIND)))
            Set rows = ManagedDefinitionRowsForKey(mManagedDefinitionPayloadRowsByKey, payloadKey)
            If rows.count = 0 Then
                classification = MANAGED_DEFINITION_STATUS_INSERT
                reasonText = "No current payload row"
            ElseIf rows.count > 1 Then
                classification = MANAGED_DEFINITION_STATUS_CONFLICT
                reasonText = "Multiple current payload rows use the same managed-object and payload-kind identity"
            Else
                rowID = CLng(rows(1))
                mManagedDefinitionBatchPayloadRs.Bookmark = mManagedDefinitionPayloadBookmarksByID(CStr(rowID))
                If ManagedDefinitionPayloadNeedsUpdate(payloadData, mManagedDefinitionBatchPayloadRs, reasonText) Then
                    If Left$(reasonText, Len("CatalogOwner conflict:")) = "CatalogOwner conflict:" Then classification = MANAGED_DEFINITION_STATUS_CONFLICT Else classification = MANAGED_DEFINITION_STATUS_UPDATE
                Else
                    classification = MANAGED_DEFINITION_STATUS_MATCHED
                End If
            End If
        End If
        mManagedDefinitionPayloadDelta.Add CStr(keyValue), Array(classification, reasonText, rowID)
        Select Case classification
            Case MANAGED_DEFINITION_STATUS_MATCHED
                mManagedDefinitionPayloadMatchedCount = mManagedDefinitionPayloadMatchedCount + 1
            Case MANAGED_DEFINITION_STATUS_INSERT
                mManagedDefinitionPayloadInsertCount = mManagedDefinitionPayloadInsertCount + 1
                mManagedDefinitionDirtyPayloadList = SharedText_AppendNonBlankLine(mManagedDefinitionDirtyPayloadList, CStr(payloadData(MANAGED_DEFINITION_PAYLOAD_OBJECT_NAME)) & " / " & CStr(payloadData(MANAGED_DEFINITION_PAYLOAD_KIND)) & " | Insert | " & reasonText)
            Case MANAGED_DEFINITION_STATUS_UPDATE
                mManagedDefinitionPayloadUpdateCount = mManagedDefinitionPayloadUpdateCount + 1
                mManagedDefinitionDirtyPayloadList = SharedText_AppendNonBlankLine(mManagedDefinitionDirtyPayloadList, CStr(payloadData(MANAGED_DEFINITION_PAYLOAD_OBJECT_NAME)) & " / " & CStr(payloadData(MANAGED_DEFINITION_PAYLOAD_KIND)) & " | Update | " & reasonText)
            Case Else
                mManagedDefinitionPayloadConflictCount = mManagedDefinitionPayloadConflictCount + 1
                failureDetail = SharedText_AppendNonBlankLine(failureDetail, CStr(payloadData(MANAGED_DEFINITION_PAYLOAD_OBJECT_NAME)) & " / " & CStr(payloadData(MANAGED_DEFINITION_PAYLOAD_KIND)) & " | " & classification & " | " & reasonText)
        End Select
        planSignatureText = planSignatureText & LengthPrefixedVariant(CStr(payloadData(MANAGED_DEFINITION_PAYLOAD_SIGNATURE)))
        currentSignatureText = currentSignatureText & LengthPrefixedVariant(classification & ":" & CStr(rowID) & ":" & reasonText)
    Next keyValue
    mManagedDefinitionPlanSignature = FingerprintFromPayload(planSignatureText)
    mManagedDefinitionCurrentSignature = FingerprintFromPayload(currentSignatureText)
    mManagedDefinitionDeltaComparisonElapsedSeconds = ElapsedSecondsFromTimer(comparisonTimer)
    If captureInitialEvidence Then
        mManagedDefinitionInitialDeltaComparisonElapsedSeconds = mManagedDefinitionDeltaComparisonElapsedSeconds
        mManagedDefinitionInitialObjectMatchedCount = mManagedDefinitionObjectMatchedCount
        mManagedDefinitionInitialObjectInsertCount = mManagedDefinitionObjectInsertCount
        mManagedDefinitionInitialObjectUpdateCount = mManagedDefinitionObjectUpdateCount
        mManagedDefinitionInitialObjectConflictCount = mManagedDefinitionObjectConflictCount
        mManagedDefinitionInitialPayloadMatchedCount = mManagedDefinitionPayloadMatchedCount
        mManagedDefinitionInitialPayloadInsertCount = mManagedDefinitionPayloadInsertCount
        mManagedDefinitionInitialPayloadUpdateCount = mManagedDefinitionPayloadUpdateCount
        mManagedDefinitionInitialPayloadConflictCount = mManagedDefinitionPayloadConflictCount
        mManagedDefinitionInitialDirtyCount = ManagedDefinitionCoreDirtyCount()
        mManagedDefinitionInitialDirtyObjectList = mManagedDefinitionDirtyObjectList
        mManagedDefinitionInitialDirtyPayloadList = mManagedDefinitionDirtyPayloadList
    End If
    If Len(failureDetail) > 0 Then Err.Raise vbObjectError + 9525, "BuildManagedDefinitionDelta", "The B3 managed-definition delta contains conflicts. No definition mutation was started." & vbCrLf & failureDetail
End Sub

Private Function ManagedDefinitionObjectIsDirty(ByVal objectName As String, ByVal categoryCode As String, ByVal objectTypeCode As String) As Boolean
    Dim keyText As String
    Dim deltaData As Variant
    If mManagedDefinitionDeltaExecutionActive = False Then ManagedDefinitionObjectIsDirty = True: Exit Function
    keyText = ManagedDefinitionObjectPlanKey(objectName, categoryCode, objectTypeCode)
    If mManagedDefinitionObjectDelta Is Nothing Then Exit Function
    If mManagedDefinitionObjectDelta.Exists(keyText) = False Then Exit Function
    deltaData = mManagedDefinitionObjectDelta(keyText)
    ManagedDefinitionObjectIsDirty = (StrComp(CStr(deltaData(0)), MANAGED_DEFINITION_STATUS_MATCHED, vbBinaryCompare) <> 0)
End Function

Private Function ManagedDefinitionPayloadIsDirty(ByVal objectName As String, ByVal payloadKind As String) As Boolean
    Dim objectKey As String
    Dim payloadKey As String
    Dim deltaData As Variant
    If mManagedDefinitionDeltaExecutionActive = False Then ManagedDefinitionPayloadIsDirty = True: Exit Function
    If mManagedDefinitionObjectPhysicalIndex.Exists(objectName) = False Then Exit Function
    objectKey = CStr(mManagedDefinitionObjectPhysicalIndex(objectName))
    payloadKey = ManagedDefinitionPayloadPlanKey(objectKey, payloadKind)
    If mManagedDefinitionPayloadDelta.Exists(payloadKey) = False Then Exit Function
    deltaData = mManagedDefinitionPayloadDelta(payloadKey)
    ManagedDefinitionPayloadIsDirty = (StrComp(CStr(deltaData(0)), MANAGED_DEFINITION_STATUS_MATCHED, vbBinaryCompare) <> 0)
End Function

Private Sub ApplyManagedDefinitionExactObjectValues(ByVal rs As DAO.Recordset, ByVal objectName As String, ByVal categoryCode As String, ByVal objectTypeCode As String, ByVal descriptionText As String, ByVal SortOrder As Long, ByVal logicalObjectName As String, ByVal namingCategory As String, ByVal ribbonTabKey As String, ByVal ribbonTabLabel As String, ByVal ribbonGroupLabel As String, ByVal ribbonGroupSortOrder As Long, ByVal ribbonTitle As String, ByVal expectedRibbonStaticTag As String, ByRef rowChanged As Boolean, ByRef repairedDefaultCount As Long)
    Dim actualRibbonStaticTag As String
    Dim expectedChatGPTUIReport As Boolean
    If StrComp(CStr(Nz(rs.fields(FIELD_OBJECT_NAME).value, vbNullString)), objectName, vbBinaryCompare) <> 0 Then rs.fields(FIELD_OBJECT_NAME).value = objectName: rowChanged = True
    If StrComp(CStr(Nz(rs.fields(FIELD_LOGICAL_OBJECT_NAME).value, vbNullString)), logicalObjectName, vbTextCompare) <> 0 Then rs.fields(FIELD_LOGICAL_OBJECT_NAME).value = Shared_String_ConvertToNullIfBlank(logicalObjectName): rowChanged = True
    If StrComp(CStr(Nz(rs.fields(FIELD_OBJECT_NAMING_CATEGORY).value, vbNullString)), namingCategory, vbTextCompare) <> 0 Then rs.fields(FIELD_OBJECT_NAMING_CATEGORY).value = Shared_String_ConvertToNullIfBlank(namingCategory): rowChanged = True
    If StrComp(CStr(Nz(rs.fields(FIELD_OBJECT_TYPE).value, vbNullString)), objectTypeCode, vbTextCompare) <> 0 Then rs.fields(FIELD_OBJECT_TYPE).value = objectTypeCode: rowChanged = True
    expectedChatGPTUIReport = ExpectedChatGPTUIReportForManagedObject(objectName, objectTypeCode)
    If IsNull(rs.fields(FIELD_CHAT_GPTUI_REPORT).value) Or CBool(Nz(rs.fields(FIELD_CHAT_GPTUI_REPORT).value, False)) <> expectedChatGPTUIReport Then rs.fields(FIELD_CHAT_GPTUI_REPORT).value = expectedChatGPTUIReport: rowChanged = True
    If StrComp(CStr(Nz(rs.fields(FIELD_CATEGORY_CODE).value, vbNullString)), categoryCode, vbTextCompare) <> 0 Then rs.fields(FIELD_CATEGORY_CODE).value = categoryCode: rowChanged = True
    If StrComp(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_STATUS).value, vbNullString)), ADCAT_STATUS_ACTIVE, vbTextCompare) <> 0 Then rs.fields(FIELD_MANAGED_OBJECT_STATUS).value = ADCAT_STATUS_ACTIVE: rowChanged = True
    If StrComp(CStr(Nz(rs.fields(FIELD_CATALOG_OWNER).value, vbNullString)), ADCAT_OWNER_SYSTEM_DEFAULT, vbTextCompare) <> 0 Then
        SetRecordsetFieldValueWithSource rs, FIELD_CATALOG_OWNER, ADCAT_OWNER_SYSTEM_DEFAULT, "ADCAT_OWNER_SYSTEM_DEFAULT"
        rowChanged = True
    End If
    If CLng(Nz(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value, 0)) <> SortOrder Then rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value = SortOrder: rowChanged = True
    If StrComp(CStr(Nz(rs.fields(FIELD_MANAGED_OBJECT_VERSION).value, vbNullString)), MANAGED_OBJECT_CATALOG_SCHEMA_VERSION, vbBinaryCompare) <> 0 Then rs.fields(FIELD_MANAGED_OBJECT_VERSION).value = MANAGED_OBJECT_CATALOG_SCHEMA_VERSION: rowChanged = True
    If StrComp(CStr(Nz(rs.fields(FIELD_DEFAULT_SOURCE).value, vbNullString)), DEFAULT_CATALOG_SOURCE, vbBinaryCompare) <> 0 Then
        SetRecordsetFieldValueWithSource rs, FIELD_DEFAULT_SOURCE, DEFAULT_CATALOG_SOURCE, "DEFAULT_CATALOG_SOURCE"
        rowChanged = True
    End If
    If StrComp(CStr(Nz(rs.fields(FIELD_OBJECT_DISPLAY_NAME).value, vbNullString)), objectName, vbBinaryCompare) <> 0 Then rs.fields(FIELD_OBJECT_DISPLAY_NAME).value = objectName: repairedDefaultCount = repairedDefaultCount + 1: rowChanged = True
    If SetupDomainMutationWritesAllowedForCurrentPart(SETUP_DOMAIN_G1_DESCRIPTIONS) Then
        If StrComp(CStr(Nz(rs.fields(FIELD_OBJECT_DESCRIPTION).value, vbNullString)), descriptionText, vbBinaryCompare) <> 0 Then rs.fields(FIELD_OBJECT_DESCRIPTION).value = descriptionText: repairedDefaultCount = repairedDefaultCount + 1: rowChanged = True
    End If
    ApplyManagedObjectPlacementDefaultsToRecordset rs, objectName, objectTypeCode, categoryCode, True
    If Len(ribbonTabKey) > 0 And Len(ribbonTabLabel) > 0 And Len(ribbonGroupLabel) > 0 And ribbonGroupSortOrder > 0 Then
        SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_TAB_KEY, ribbonTabKey
        SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_TAB_LABEL, ribbonTabLabel
        SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_GROUP_LABEL, ribbonGroupLabel
        SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_GROUP_SORT_ORDER, ribbonGroupSortOrder
    End If
    If Len(ribbonTitle) > 0 Then SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_TITLE, ribbonTitle
    expectedRibbonStaticTag = Trim$(expectedRibbonStaticTag)
    If Len(expectedRibbonStaticTag) > 0 Then
        actualRibbonStaticTag = Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_STATIC_TAG).value, vbNullString)))
        If Len(actualRibbonStaticTag) = 0 Or (Len(actualRibbonStaticTag) = 11 And Left$(actualRibbonStaticTag, 1) = "U" And TextContainsDecimalDigitsOnly(Mid$(actualRibbonStaticTag, 2))) Then
            rs.fields(FIELD_RIBBON_STATIC_TAG).value = expectedRibbonStaticTag
            rowChanged = True
        ElseIf StrComp(actualRibbonStaticTag, expectedRibbonStaticTag, vbBinaryCompare) <> 0 Then
            Err.Raise vbObjectError + 9564, "ApplyManagedDefinitionExactObjectValues", "A canonical Ribbon item already has a different permanent tag. The stored tag will not be silently changed." & vbCrLf & "Object: " & objectName & vbCrLf & "Stored tag: " & actualRibbonStaticTag & vbCrLf & "Authored tag: " & expectedRibbonStaticTag
        End If
    End If
    rowChanged = True
End Sub

Private Sub ApplyManagedDefinitionExactPayloadValues(ByVal rs As DAO.Recordset, ByVal definitionData As Variant, ByRef rowChanged As Boolean)
    If StrComp(CStr(Nz(rs.fields(FIELD_PAYLOAD_KIND).value, vbNullString)), CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_KIND)), vbTextCompare) <> 0 Then rs.fields(FIELD_PAYLOAD_KIND).value = CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_KIND)): rowChanged = True
    If StrComp(CStr(Nz(rs.fields(FIELD_PAYLOAD_STATUS).value, vbNullString)), ADCAT_STATUS_ACTIVE, vbTextCompare) <> 0 Then rs.fields(FIELD_PAYLOAD_STATUS).value = ADCAT_STATUS_ACTIVE: rowChanged = True
    If StrComp(CStr(Nz(rs.fields(FIELD_ACTION_PROCEDURE_NAME).value, vbNullString)), CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_ACTION)), vbBinaryCompare) <> 0 Then rs.fields(FIELD_ACTION_PROCEDURE_NAME).value = Shared_String_ConvertToNullIfBlank(CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_ACTION))): rowChanged = True
    If StrComp(CStr(Nz(rs.fields(FIELD_RUN_CODE_WRAPPER_NAME).value, vbNullString)), CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_WRAPPER)), vbBinaryCompare) <> 0 Then rs.fields(FIELD_RUN_CODE_WRAPPER_NAME).value = Shared_String_ConvertToNullIfBlank(CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_WRAPPER))): rowChanged = True
    If StrComp(CStr(Nz(rs.fields(FIELD_MACRO_DESCRIPTION).value, vbNullString)), CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_DESCRIPTION)), vbBinaryCompare) <> 0 Then rs.fields(FIELD_MACRO_DESCRIPTION).value = CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_DESCRIPTION)): rowChanged = True
    If StrComp(CStr(Nz(rs.fields(FIELD_PAYLOAD_VERSION).value, vbNullString)), CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_VERSION)), vbBinaryCompare) <> 0 Then rs.fields(FIELD_PAYLOAD_VERSION).value = CStr(definitionData(MANAGED_DEFINITION_PAYLOAD_VERSION)): rowChanged = True
    If StrComp(CStr(Nz(rs.fields(FIELD_CATALOG_OWNER).value, vbNullString)), ADCAT_OWNER_SYSTEM_DEFAULT, vbTextCompare) <> 0 Then
        SetRecordsetFieldValueWithSource rs, FIELD_CATALOG_OWNER, ADCAT_OWNER_SYSTEM_DEFAULT, "ADCAT_OWNER_SYSTEM_DEFAULT"
        rowChanged = True
    End If
    If CLng(Nz(rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value, 0)) <> CLng(definitionData(MANAGED_DEFINITION_PAYLOAD_SORT_ORDER)) Then rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value = CLng(definitionData(MANAGED_DEFINITION_PAYLOAD_SORT_ORDER)): rowChanged = True
    If StrComp(CStr(Nz(rs.fields(FIELD_DEFAULT_SOURCE).value, vbNullString)), DEFAULT_CATALOG_SOURCE, vbBinaryCompare) <> 0 Then
        SetRecordsetFieldValueWithSource rs, FIELD_DEFAULT_SOURCE, DEFAULT_CATALOG_SOURCE, "DEFAULT_CATALOG_SOURCE"
        rowChanged = True
    End If
End Sub

Private Function ManagedDefinitionCoreDirtyCount() As Long
    ManagedDefinitionCoreDirtyCount = mManagedDefinitionObjectInsertCount + mManagedDefinitionObjectUpdateCount + mManagedDefinitionPayloadInsertCount + mManagedDefinitionPayloadUpdateCount
End Function

Private Sub ExecuteCoreManagedDefinitionDelta(ByRef executionDetail As String)
    On Error GoTo ErrHandler
    Dim ws As DAO.workspace
    Dim transactionStarted As Boolean
    Dim transactionTimer As Single
    Dim mutationTimer As Single
    Dim postconditionTimer As Single
    Dim mutationCountBefore As Long
    Dim dirtyBefore As Long
    dirtyBefore = mManagedDefinitionInitialDirtyCount
    If dirtyBefore = 0 Then executionDetail = "B3 definition delta is empty; no defaulting loop or write transaction was opened.": Exit Sub
    transactionTimer = Timer
    Set ws = DBEngine.Workspaces(0)
    ws.BeginTrans
    transactionStarted = True
    mManagedDefinitionTransactionStartupElapsedSeconds = ElapsedSecondsFromTimer(transactionTimer)
    mutationCountBefore = ManagedDefinitionBatchMutationCount()
    mutationTimer = Timer
    mManagedDefinitionDeltaExecutionActive = True
    ApplyCoreManagedObjectDeltaFromPlan
    ApplyCorePayloadDeltaFromPlan
    mManagedDefinitionDeltaExecutionActive = False
    mManagedDefinitionMutationElapsedSeconds = ElapsedSecondsFromTimer(mutationTimer)
    postconditionTimer = Timer
    RefreshManagedDefinitionBatchIndexes
    BuildManagedDefinitionDelta False
    mManagedDefinitionPostconditionElapsedSeconds = ElapsedSecondsFromTimer(postconditionTimer)
    If ManagedDefinitionCoreDirtyCount() <> 0 Then Err.Raise vbObjectError + 9526, "ExecuteCoreManagedDefinitionDelta", "B3 postcondition verification still found dirty definitions after mutation." & vbCrLf & mManagedDefinitionDirtyObjectList & vbCrLf & mManagedDefinitionDirtyPayloadList
    ws.CommitTrans
    transactionStarted = False
    executionDetail = "Dirty definitions processed: " & CStr(dirtyBefore) & vbCrLf & "Actual DAO mutations: " & CStr(ManagedDefinitionBatchMutationCount() - mutationCountBefore) & vbCrLf & "Write transaction opened: True" & vbCrLf & "Captured authoritative plan reused for mutation: True" & vbCrLf & "Postcondition: all authoritative B3 definitions matched."
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    mManagedDefinitionDeltaExecutionActive = False
    If transactionStarted Then RollbackCatalogWorkspaceOrRaise ws, "ExecuteCoreManagedDefinitionDelta", savedErrNumber, savedErrSource, savedErrDescription
    Err.Raise savedErrNumber, "ExecuteCoreManagedDefinitionDelta", "Could not execute the B3 managed-definition delta." & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Sub

Private Sub BeginManagedDefinitionBatch(Optional ByVal forceReferenceSnapshotRefresh As Boolean = False, Optional ByVal includeFormRegistry As Boolean = False)
    On Error GoTo ErrHandler
    Dim preparationTimer As Single
    Dim stageTimer As Single
    Dim objectName As String
    Dim exactObjectName As String
    Dim objectTypeCode As String
    Dim logicalObjectName As String
    Dim namingCategory As String
    Dim payloadKind As String
    Dim managedObjectID As Long
    Dim rowID As Long
    Dim rowKey As String
    Dim stableKey As String
    Dim ribbonStaticTag As String
    Dim rowCount As Long
    preparationTimer = Timer
    If mManagedDefinitionBatchActive Then Err.Raise vbObjectError + 9490, "BeginManagedDefinitionBatch", "A managed-definition default batch is already active."
    stageTimer = Timer
    InitializeManagedDefinitionReferenceSnapshots forceReferenceSnapshotRefresh, True
    mManagedDefinitionReferenceSnapshotElapsedSeconds = ElapsedSecondsFromTimer(stageTimer)
    mManagedDefinitionReferenceSnapshotsReady = False
    stageTimer = Timer
    Set mManagedDefinitionBatchDb = ResolveCatalogDb()
    Set mManagedDefinitionBatchManagedRs = mManagedDefinitionBatchDb.OpenRecordset("SELECT * FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] ORDER BY " & SQL_FIELD_ID & ";", dbOpenDynaset)
    Set mManagedDefinitionBatchPayloadRs = mManagedDefinitionBatchDb.OpenRecordset("SELECT * FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads") & "] ORDER BY " & SQL_FIELD_ID & ";", dbOpenDynaset)
    If includeFormRegistry Then
        If SharedDao_DatabaseTableExistsSafe(mManagedDefinitionBatchDb, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_FormDefinitions")) = False Then Err.Raise vbObjectError + 9825, "BeginManagedDefinitionBatch", "UI_Frm_Registry is unavailable for the requested reusable form-metadata batch."
        Set mManagedDefinitionBatchFormsRs = mManagedDefinitionBatchDb.OpenRecordset("SELECT * FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_FormDefinitions") & "] ORDER BY " & SQL_FIELD_ID & ";", dbOpenDynaset)
        Set mManagedDefinitionBatchFormBookmarks = CreateObject("Scripting.Dictionary"): mManagedDefinitionBatchFormBookmarks.CompareMode = vbBinaryCompare
    Else
        Set mManagedDefinitionBatchFormsRs = Nothing
        Set mManagedDefinitionBatchFormBookmarks = Nothing
    End If
    Set mManagedDefinitionBatchManagedBookmarks = CreateObject("Scripting.Dictionary"): mManagedDefinitionBatchManagedBookmarks.CompareMode = vbBinaryCompare
    Set mManagedDefinitionBatchPayloadBookmarks = CreateObject("Scripting.Dictionary"): mManagedDefinitionBatchPayloadBookmarks.CompareMode = vbBinaryCompare
    Set mManagedDefinitionBatchObjectIDs = CreateObject("Scripting.Dictionary"): mManagedDefinitionBatchObjectIDs.CompareMode = vbTextCompare
    Set mManagedDefinitionRowsByStableKey = CreateObject("Scripting.Dictionary"): mManagedDefinitionRowsByStableKey.CompareMode = vbBinaryCompare
    Set mManagedDefinitionRowsByPhysicalKey = CreateObject("Scripting.Dictionary"): mManagedDefinitionRowsByPhysicalKey.CompareMode = vbBinaryCompare
    Set mManagedDefinitionRowsByRibbonStaticTag = CreateObject("Scripting.Dictionary"): mManagedDefinitionRowsByRibbonStaticTag.CompareMode = vbTextCompare
    Set mManagedDefinitionManagedBookmarksByID = CreateObject("Scripting.Dictionary"): mManagedDefinitionManagedBookmarksByID.CompareMode = vbTextCompare
    Set mManagedDefinitionPayloadRowsByKey = CreateObject("Scripting.Dictionary"): mManagedDefinitionPayloadRowsByKey.CompareMode = vbBinaryCompare
    Set mManagedDefinitionPayloadBookmarksByID = CreateObject("Scripting.Dictionary"): mManagedDefinitionPayloadBookmarksByID.CompareMode = vbTextCompare
    mManagedDefinitionBatchOpenElapsedSeconds = ElapsedSecondsFromTimer(stageTimer)
    stageTimer = Timer
    Do While mManagedDefinitionBatchManagedRs.EOF = False
        rowCount = rowCount + 1
        If rowCount Mod 25 = 0 Then PumpSetupResponsiveness
        exactObjectName = CStr(Nz(mManagedDefinitionBatchManagedRs.fields(FIELD_OBJECT_NAME).value, vbNullString))
        objectName = exactObjectName
        objectTypeCode = Trim$(CStr(Nz(mManagedDefinitionBatchManagedRs.fields(FIELD_OBJECT_TYPE).value, vbNullString)))
        logicalObjectName = Trim$(CStr(Nz(mManagedDefinitionBatchManagedRs.fields(FIELD_LOGICAL_OBJECT_NAME).value, vbNullString)))
        namingCategory = Trim$(CStr(Nz(mManagedDefinitionBatchManagedRs.fields(FIELD_OBJECT_NAMING_CATEGORY).value, vbNullString)))
        ribbonStaticTag = Trim$(CStr(Nz(mManagedDefinitionBatchManagedRs.fields(FIELD_RIBBON_STATIC_TAG).value, vbNullString)))
        managedObjectID = CLng(Nz(mManagedDefinitionBatchManagedRs.fields(FIELD_ID).value, 0))
        If Len(objectName) > 0 And Len(objectTypeCode) > 0 Then
            rowKey = ManagedDefinitionManagedBookmarkKey(objectName, objectTypeCode)
            mManagedDefinitionNamingSnapshot(rowKey) = Array(CStr(Nz(mManagedDefinitionBatchManagedRs.fields(FIELD_LOGICAL_OBJECT_NAME).value, vbNullString)), CStr(Nz(mManagedDefinitionBatchManagedRs.fields(FIELD_OBJECT_NAMING_CATEGORY).value, vbNullString)), CStr(Nz(mManagedDefinitionBatchManagedRs.fields(FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY).value, vbNullString)))
        End If
        If Len(objectName) > 0 And Len(objectTypeCode) > 0 And managedObjectID > 0 Then
            rowKey = ManagedDefinitionManagedBookmarkKey(objectName, objectTypeCode)
            stableKey = ManagedDefinitionStableIdentityKey(logicalObjectName, namingCategory, objectTypeCode, objectName)
            If mManagedDefinitionBatchManagedBookmarks.Exists(rowKey) = False Then mManagedDefinitionBatchManagedBookmarks.Add rowKey, mManagedDefinitionBatchManagedRs.Bookmark
            rowKey = ManagedDefinitionExactManagedBookmarkKey(exactObjectName, objectTypeCode)
            If mManagedDefinitionBatchManagedBookmarks.Exists(rowKey) = False Then mManagedDefinitionBatchManagedBookmarks.Add rowKey, mManagedDefinitionBatchManagedRs.Bookmark
            rowKey = ManagedDefinitionManagedBookmarkKey(objectName, objectTypeCode)
            If mManagedDefinitionBatchObjectIDs.Exists(objectName) = False Then mManagedDefinitionBatchObjectIDs.Add objectName, managedObjectID
            mManagedDefinitionManagedBookmarksByID.Add CStr(managedObjectID), mManagedDefinitionBatchManagedRs.Bookmark
            ManagedDefinitionAddLongToIndex mManagedDefinitionRowsByPhysicalKey, rowKey, managedObjectID
            ManagedDefinitionAddLongToIndex mManagedDefinitionRowsByStableKey, stableKey, managedObjectID
            If Len(ribbonStaticTag) > 0 Then ManagedDefinitionAddLongToIndex mManagedDefinitionRowsByRibbonStaticTag, ribbonStaticTag, managedObjectID
        End If
        mManagedDefinitionBatchManagedRs.MoveNext
    Loop
    mManagedDefinitionReferenceSnapshotsReady = True
    mManagedDefinitionManagedLoadElapsedSeconds = ElapsedSecondsFromTimer(stageTimer)
    stageTimer = Timer
    rowCount = 0
    Do While mManagedDefinitionBatchPayloadRs.EOF = False
        rowCount = rowCount + 1
        If rowCount Mod 25 = 0 Then PumpSetupResponsiveness
        managedObjectID = CLng(Nz(mManagedDefinitionBatchPayloadRs.fields(FIELD_MANAGED_OBJECT_ID).value, 0))
        payloadKind = Trim$(CStr(Nz(mManagedDefinitionBatchPayloadRs.fields(FIELD_PAYLOAD_KIND).value, vbNullString)))
        rowID = CLng(Nz(mManagedDefinitionBatchPayloadRs.fields(FIELD_ID).value, 0))
        If managedObjectID > 0 And Len(payloadKind) > 0 And rowID > 0 Then
            rowKey = ManagedDefinitionPayloadBookmarkKey(managedObjectID, payloadKind)
            If mManagedDefinitionBatchPayloadBookmarks.Exists(rowKey) = False Then mManagedDefinitionBatchPayloadBookmarks.Add rowKey, mManagedDefinitionBatchPayloadRs.Bookmark
            mManagedDefinitionPayloadBookmarksByID.Add CStr(rowID), mManagedDefinitionBatchPayloadRs.Bookmark
            ManagedDefinitionAddLongToIndex mManagedDefinitionPayloadRowsByKey, rowKey, rowID
        End If
        mManagedDefinitionBatchPayloadRs.MoveNext
    Loop
    If Not mManagedDefinitionBatchFormsRs Is Nothing Then
        rowCount = 0
        If Not (mManagedDefinitionBatchFormsRs.BOF And mManagedDefinitionBatchFormsRs.EOF) Then mManagedDefinitionBatchFormsRs.MoveFirst
        Do While mManagedDefinitionBatchFormsRs.EOF = False
            rowCount = rowCount + 1
            If rowCount Mod 25 = 0 Then PumpSetupResponsiveness
            objectName = CStr(Nz(mManagedDefinitionBatchFormsRs.fields(FIELD_FORM_OBJECT_NAME).value, vbNullString))
            If Len(objectName) > 0 Then
                If mManagedDefinitionBatchFormBookmarks.Exists(objectName) = False Then mManagedDefinitionBatchFormBookmarks.Add objectName, mManagedDefinitionBatchFormsRs.Bookmark
            End If
            mManagedDefinitionBatchFormsRs.MoveNext
        Loop
    End If
    mManagedDefinitionPayloadLoadElapsedSeconds = ElapsedSecondsFromTimer(stageTimer)
    mManagedDefinitionBatchManagedInserted = 0
    mManagedDefinitionBatchManagedUpdated = 0
    mManagedDefinitionBatchPayloadInserted = 0
    mManagedDefinitionBatchPayloadUpdated = 0
    mManagedDefinitionBatchRibbonPlacementsInserted = 0
    mManagedDefinitionBatchDirtyMask = 0
    mManagedDefinitionRollbackRegistrationCount = 0
    mManagedDefinitionTransactionStartupElapsedSeconds = 0
    mManagedDefinitionMutationElapsedSeconds = 0
    mManagedDefinitionPostconditionElapsedSeconds = 0
    mManagedDefinitionBatchActive = True
    mManagedDefinitionBatchPreparationElapsedSeconds = ElapsedSecondsFromTimer(preparationTimer)
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number: savedErrSource = Err.Source: savedErrDescription = Err.Description
    On Error Resume Next
    If Not mManagedDefinitionBatchManagedRs Is Nothing Then mManagedDefinitionBatchManagedRs.Close
    If Not mManagedDefinitionBatchPayloadRs Is Nothing Then mManagedDefinitionBatchPayloadRs.Close
    If Not mManagedDefinitionBatchFormsRs Is Nothing Then mManagedDefinitionBatchFormsRs.Close
    Set mManagedDefinitionBatchManagedRs = Nothing: Set mManagedDefinitionBatchPayloadRs = Nothing: Set mManagedDefinitionBatchFormsRs = Nothing
    Set mManagedDefinitionBatchManagedBookmarks = Nothing: Set mManagedDefinitionBatchPayloadBookmarks = Nothing: Set mManagedDefinitionBatchObjectIDs = Nothing
    Set mManagedDefinitionBatchFormBookmarks = Nothing
    Set mManagedDefinitionRowsByStableKey = Nothing: Set mManagedDefinitionRowsByPhysicalKey = Nothing: Set mManagedDefinitionRowsByRibbonStaticTag = Nothing: Set mManagedDefinitionManagedBookmarksByID = Nothing
    Set mManagedDefinitionPayloadRowsByKey = Nothing: Set mManagedDefinitionPayloadBookmarksByID = Nothing
    Set mManagedDefinitionBatchDb = Nothing
    ClearManagedDefinitionReferenceSnapshots
    mManagedDefinitionBatchActive = False
    On Error GoTo 0
    Err.Raise savedErrNumber, "BeginManagedDefinitionBatch", "Could not prepare the reusable managed-definition DAO batch and in-memory indexes." & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Sub

Private Sub RefreshManagedDefinitionBatchIndexes(Optional ByVal refreshReferenceSnapshots As Boolean = True, Optional ByVal requeryRecordsets As Boolean = False)
    Dim objectName As String
    Dim exactObjectName As String
    Dim objectTypeCode As String
    Dim logicalObjectName As String
    Dim namingCategory As String
    Dim managedObjectID As Long
    Dim payloadKind As String
    Dim rowID As Long
    Dim rowKey As String
    Dim stableKey As String
    Dim ribbonStaticTag As String
    If requeryRecordsets Then
        mManagedDefinitionBatchManagedRs.Requery
        mManagedDefinitionBatchPayloadRs.Requery
        If Not mManagedDefinitionBatchFormsRs Is Nothing Then mManagedDefinitionBatchFormsRs.Requery
    End If
    If refreshReferenceSnapshots Then
        InitializeManagedDefinitionReferenceSnapshots True, True
        mManagedDefinitionReferenceSnapshotsReady = False
    End If
    Set mManagedDefinitionBatchManagedBookmarks = CreateObject("Scripting.Dictionary"): mManagedDefinitionBatchManagedBookmarks.CompareMode = vbBinaryCompare
    Set mManagedDefinitionBatchPayloadBookmarks = CreateObject("Scripting.Dictionary"): mManagedDefinitionBatchPayloadBookmarks.CompareMode = vbBinaryCompare
    If Not mManagedDefinitionBatchFormsRs Is Nothing Then
        Set mManagedDefinitionBatchFormBookmarks = CreateObject("Scripting.Dictionary"): mManagedDefinitionBatchFormBookmarks.CompareMode = vbBinaryCompare
    Else
        Set mManagedDefinitionBatchFormBookmarks = Nothing
    End If
    Set mManagedDefinitionBatchObjectIDs = CreateObject("Scripting.Dictionary"): mManagedDefinitionBatchObjectIDs.CompareMode = vbTextCompare
    Set mManagedDefinitionRowsByStableKey = CreateObject("Scripting.Dictionary"): mManagedDefinitionRowsByStableKey.CompareMode = vbBinaryCompare
    Set mManagedDefinitionRowsByPhysicalKey = CreateObject("Scripting.Dictionary"): mManagedDefinitionRowsByPhysicalKey.CompareMode = vbBinaryCompare
    Set mManagedDefinitionRowsByRibbonStaticTag = CreateObject("Scripting.Dictionary"): mManagedDefinitionRowsByRibbonStaticTag.CompareMode = vbTextCompare
    Set mManagedDefinitionManagedBookmarksByID = CreateObject("Scripting.Dictionary"): mManagedDefinitionManagedBookmarksByID.CompareMode = vbTextCompare
    Set mManagedDefinitionPayloadRowsByKey = CreateObject("Scripting.Dictionary"): mManagedDefinitionPayloadRowsByKey.CompareMode = vbBinaryCompare
    Set mManagedDefinitionPayloadBookmarksByID = CreateObject("Scripting.Dictionary"): mManagedDefinitionPayloadBookmarksByID.CompareMode = vbTextCompare
    If Not (mManagedDefinitionBatchManagedRs.BOF And mManagedDefinitionBatchManagedRs.EOF) Then mManagedDefinitionBatchManagedRs.MoveFirst
    Do While mManagedDefinitionBatchManagedRs.EOF = False
        exactObjectName = CStr(Nz(mManagedDefinitionBatchManagedRs.fields(FIELD_OBJECT_NAME).value, vbNullString))
        objectName = exactObjectName
        objectTypeCode = Trim$(CStr(Nz(mManagedDefinitionBatchManagedRs.fields(FIELD_OBJECT_TYPE).value, vbNullString)))
        logicalObjectName = Trim$(CStr(Nz(mManagedDefinitionBatchManagedRs.fields(FIELD_LOGICAL_OBJECT_NAME).value, vbNullString)))
        namingCategory = Trim$(CStr(Nz(mManagedDefinitionBatchManagedRs.fields(FIELD_OBJECT_NAMING_CATEGORY).value, vbNullString)))
        ribbonStaticTag = Trim$(CStr(Nz(mManagedDefinitionBatchManagedRs.fields(FIELD_RIBBON_STATIC_TAG).value, vbNullString)))
        managedObjectID = CLng(Nz(mManagedDefinitionBatchManagedRs.fields(FIELD_ID).value, 0))
        If refreshReferenceSnapshots And Len(objectName) > 0 And Len(objectTypeCode) > 0 Then
            rowKey = ManagedDefinitionManagedBookmarkKey(objectName, objectTypeCode)
            mManagedDefinitionNamingSnapshot(rowKey) = Array(CStr(Nz(mManagedDefinitionBatchManagedRs.fields(FIELD_LOGICAL_OBJECT_NAME).value, vbNullString)), CStr(Nz(mManagedDefinitionBatchManagedRs.fields(FIELD_OBJECT_NAMING_CATEGORY).value, vbNullString)), CStr(Nz(mManagedDefinitionBatchManagedRs.fields(FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY).value, vbNullString)))
        End If
        If Len(objectName) > 0 And Len(objectTypeCode) > 0 And managedObjectID > 0 Then
            rowKey = ManagedDefinitionManagedBookmarkKey(objectName, objectTypeCode)
            stableKey = ManagedDefinitionStableIdentityKey(logicalObjectName, namingCategory, objectTypeCode, objectName)
            If mManagedDefinitionBatchManagedBookmarks.Exists(rowKey) = False Then mManagedDefinitionBatchManagedBookmarks.Add rowKey, mManagedDefinitionBatchManagedRs.Bookmark
            rowKey = ManagedDefinitionExactManagedBookmarkKey(exactObjectName, objectTypeCode)
            If mManagedDefinitionBatchManagedBookmarks.Exists(rowKey) = False Then mManagedDefinitionBatchManagedBookmarks.Add rowKey, mManagedDefinitionBatchManagedRs.Bookmark
            rowKey = ManagedDefinitionManagedBookmarkKey(objectName, objectTypeCode)
            If mManagedDefinitionBatchObjectIDs.Exists(objectName) = False Then mManagedDefinitionBatchObjectIDs.Add objectName, managedObjectID
            mManagedDefinitionManagedBookmarksByID.Add CStr(managedObjectID), mManagedDefinitionBatchManagedRs.Bookmark
            ManagedDefinitionAddLongToIndex mManagedDefinitionRowsByPhysicalKey, rowKey, managedObjectID
            ManagedDefinitionAddLongToIndex mManagedDefinitionRowsByStableKey, stableKey, managedObjectID
            If Len(ribbonStaticTag) > 0 Then ManagedDefinitionAddLongToIndex mManagedDefinitionRowsByRibbonStaticTag, ribbonStaticTag, managedObjectID
        End If
        mManagedDefinitionBatchManagedRs.MoveNext
    Loop
    If Not (mManagedDefinitionBatchPayloadRs.BOF And mManagedDefinitionBatchPayloadRs.EOF) Then mManagedDefinitionBatchPayloadRs.MoveFirst
    Do While mManagedDefinitionBatchPayloadRs.EOF = False
        managedObjectID = CLng(Nz(mManagedDefinitionBatchPayloadRs.fields(FIELD_MANAGED_OBJECT_ID).value, 0))
        payloadKind = Trim$(CStr(Nz(mManagedDefinitionBatchPayloadRs.fields(FIELD_PAYLOAD_KIND).value, vbNullString)))
        rowID = CLng(Nz(mManagedDefinitionBatchPayloadRs.fields(FIELD_ID).value, 0))
        If managedObjectID > 0 And Len(payloadKind) > 0 And rowID > 0 Then
            rowKey = ManagedDefinitionPayloadBookmarkKey(managedObjectID, payloadKind)
            If mManagedDefinitionBatchPayloadBookmarks.Exists(rowKey) = False Then mManagedDefinitionBatchPayloadBookmarks.Add rowKey, mManagedDefinitionBatchPayloadRs.Bookmark
            mManagedDefinitionPayloadBookmarksByID.Add CStr(rowID), mManagedDefinitionBatchPayloadRs.Bookmark
            ManagedDefinitionAddLongToIndex mManagedDefinitionPayloadRowsByKey, rowKey, rowID
        End If
        mManagedDefinitionBatchPayloadRs.MoveNext
    Loop
    If Not mManagedDefinitionBatchFormsRs Is Nothing Then
        If Not (mManagedDefinitionBatchFormsRs.BOF And mManagedDefinitionBatchFormsRs.EOF) Then mManagedDefinitionBatchFormsRs.MoveFirst
        Do While mManagedDefinitionBatchFormsRs.EOF = False
            objectName = CStr(Nz(mManagedDefinitionBatchFormsRs.fields(FIELD_FORM_OBJECT_NAME).value, vbNullString))
            If Len(objectName) > 0 Then
                If mManagedDefinitionBatchFormBookmarks.Exists(objectName) = False Then mManagedDefinitionBatchFormBookmarks.Add objectName, mManagedDefinitionBatchFormsRs.Bookmark
            End If
            mManagedDefinitionBatchFormsRs.MoveNext
        Loop
    End If
    If refreshReferenceSnapshots Then mManagedDefinitionReferenceSnapshotsReady = True
End Sub

Private Sub EndManagedDefinitionBatch(ByVal completedSuccessfully As Boolean, Optional ByVal operationContext As String = "non-form managed-object and action-payload reconciliation")
    Dim summaryText As String
    Dim completedDirtyMask As Long
    completedDirtyMask = mManagedDefinitionBatchDirtyMask
    On Error Resume Next
    If Not mManagedDefinitionBatchManagedRs Is Nothing Then mManagedDefinitionBatchManagedRs.Close
    If Not mManagedDefinitionBatchPayloadRs Is Nothing Then mManagedDefinitionBatchPayloadRs.Close
    If Not mManagedDefinitionBatchFormsRs Is Nothing Then mManagedDefinitionBatchFormsRs.Close
    Set mManagedDefinitionBatchManagedRs = Nothing: Set mManagedDefinitionBatchPayloadRs = Nothing: Set mManagedDefinitionBatchFormsRs = Nothing
    Set mManagedDefinitionBatchManagedBookmarks = Nothing: Set mManagedDefinitionBatchPayloadBookmarks = Nothing: Set mManagedDefinitionBatchObjectIDs = Nothing
    Set mManagedDefinitionBatchFormBookmarks = Nothing
    Set mManagedDefinitionRowsByStableKey = Nothing: Set mManagedDefinitionRowsByPhysicalKey = Nothing: Set mManagedDefinitionRowsByRibbonStaticTag = Nothing: Set mManagedDefinitionManagedBookmarksByID = Nothing
    Set mManagedDefinitionPayloadRowsByKey = Nothing: Set mManagedDefinitionPayloadBookmarksByID = Nothing
    Set mManagedDefinitionBatchDb = Nothing
    mManagedDefinitionBatchActive = False
    mManagedDefinitionBatchDirtyMask = 0
    On Error GoTo 0
    If completedSuccessfully Then
        CatalogMarkSetupDomainsDirty completedDirtyMask
        summaryText = "Managed-object rows inserted=" & CStr(mManagedDefinitionBatchManagedInserted)
        summaryText = summaryText & "; managed-object rows updated=" & CStr(mManagedDefinitionBatchManagedUpdated)
        summaryText = summaryText & "; action payload rows inserted=" & CStr(mManagedDefinitionBatchPayloadInserted)
        summaryText = summaryText & "; action payload rows updated=" & CStr(mManagedDefinitionBatchPayloadUpdated)
        summaryText = summaryText & "; new System Macro and Help Document Macro rows receiving final Ribbon placement in the insert=" & CStr(mManagedDefinitionBatchRibbonPlacementsInserted)
        summaryText = summaryText & "; durable managed-row rollback registrations=" & CStr(mManagedDefinitionRollbackRegistrationCount) & "."
        summaryText = summaryText & " Dirty fingerprint domains=" & CatalogDirtyDomainSummary(completedDirtyMask) & "."
        AddTraceNote "Reusable managed-definition snapshot/write batch completed. " & summaryText
        CoreAddOperationNote "Batched " & operationContext & " completed. " & summaryText
    End If
End Sub

