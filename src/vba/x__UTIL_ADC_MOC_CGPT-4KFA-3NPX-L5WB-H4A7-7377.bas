' Purpose: Ensures live object lookup field for tdf, field name.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   tdf (Input; DAO.tableDef): DAO.TableDef representing the table whose fields, indexes, properties, or metadata are being inspected or modified.
'   fieldName (Input; String): Field name identifying the table/query field or bound control source the routine evaluates or modifies.
'   rowSourceText (Input; String): SQL/row-source text consumed by this procedure; it is parsed, compared, or assigned as coded without changing the caller's original string.
'   LimitToList (Input; Boolean): True restricts the Access lookup control/field to values present in its row source; False permits values outside the listed choices when Access allows them.
'   columnCount (Input; Long): Supplies the column count used to bound, report, or validate the number of items processed by this operation.
'   BoundColumn (Input; Long): One-based Access lookup column number whose value is stored as the control/field value.
'   columnWidthsText (Input; String): Input column widths text for ensure live object lookup field; is tested by If Len(columnWidthsText) = 0.
' Returns: Long: Returns the number/result code produced while applying the requested field/lookup metadata; callers use it to detect whether physical metadata required creation or repair.
Public Function EnsureLiveObjectLookupField(ByVal tdf As DAO.tableDef, ByVal fieldName As String, ByVal rowSourceText As String, ByVal LimitToList As Boolean, ByVal columnCount As Long, ByVal BoundColumn As Long, ByVal columnWidthsText As String) As Long
    RequireCatalogMutationRecoveryReady "EnsureLiveObjectLookupField"
    On Error GoTo ErrHandler
    Dim fld As DAO.Field
    Dim changed As Boolean
    If SharedDao_TableDefFieldExistsSafe(tdf, fieldName) = False Then Exit Function
    rowSourceText = Trim$(rowSourceText)
    columnWidthsText = Trim$(columnWidthsText)
    If Len(rowSourceText) = 0 Then Exit Function
    If columnCount < 1 Then columnCount = 1
    If BoundColumn < 1 Then BoundColumn = 1
    If Len(columnWidthsText) = 0 Then columnWidthsText = "2.5"
    columnWidthsText = NormalizeLookupColumnWidthsForAccess(columnWidthsText, columnCount, BoundColumn, LimitToList)
    Set fld = tdf.fields(fieldName)
    changed = ApplyLookupFieldProperties(fld, "Table/Query", rowSourceText, LimitToList, columnCount, BoundColumn, columnWidthsText, "EnsureLiveObjectLookupField", vbObjectError + 7750, vbObjectError + 7751)
    If changed Then
        EnsureLiveObjectLookupField = 1
        CoreAddOperationNote "Updated live-object lookup metadata. Table=" & SafeDaoTableDefName(tdf) & "; Field=" & fieldName & "."
    End If
    Exit Function
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    If savedErrNumber = 0 Then
        CoreAddOperationNote "Skipped live-object lookup metadata because the property update did not complete, but no active VBA error remained for diagnosis. Table=" & SafeDaoTableDefName(tdf) & "; Field=" & fieldName & "."
    Else
        CoreAddOperationNote "Skipped live-object lookup metadata after Access rejected the lookup property update. Table=" & SafeDaoTableDefName(tdf) & "; Field=" & fieldName & "; Error=" & CStr(savedErrNumber) & " from " & savedErrSource & " - " & savedErrDescription
    End If
    EnsureLiveObjectLookupField = -1
    Err.Clear
End Function

Private Function B2MetadataFieldStatePayload(ByVal tdf As DAO.tableDef, ByVal definitions As Collection, ByRef allFieldsPresent As Boolean) As String
    Dim schemaFields As Object
    Dim Definition As Variant
    Dim definitionKind As String
    Dim fieldName As String
    Dim fld As DAO.Field
    Dim propertyName As Variant
    Dim propertyNames As Variant
    Dim payloadText As String
    ' INTENTIONAL KEYED LOOKUP: schemaFields provides keyed membership/lookup over source rows or state already read by B2MetadataFieldStatePayload; it is a derived access path, not a second authority.
    Set schemaFields = CreateObject("Scripting.Dictionary")
    schemaFields.CompareMode = vbTextCompare
    payloadText = FingerprintTokenPart(UCase$(tdf.Name))
    allFieldsPresent = True
    For Each Definition In definitions
        definitionKind = UCase$(CStr(Definition(0)))
        fieldName = CStr(Definition(1))
        payloadText = payloadText & FingerprintTokenPart(definitionKind)
        payloadText = payloadText & FingerprintTokenPart(fieldName)
        Set fld = Nothing
        On Error Resume Next
        Set fld = tdf.fields(fieldName)
        Err.Clear
        On Error GoTo 0
        If fld Is Nothing Then
            payloadText = payloadText & FingerprintTokenPart("<missing>")
            allFieldsPresent = False
        Else
            If schemaFields.Exists(fieldName) = False Then
                schemaFields.Add fieldName, True
                payloadText = payloadText & FingerprintTokenPart(CStr(fld.Type))
                payloadText = payloadText & FingerprintTokenPart(CStr(fld.Size))
                payloadText = payloadText & FingerprintTokenPart(CStr(fld.Attributes))
            End If
            Select Case definitionKind
                Case UCase$(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_VALUE_LIST)
                    propertyNames = Array("DisplayControl", "RowSourceType", "RowSource", "BoundColumn", "ColumnCount", "LimitToList")
                Case UCase$(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_TABLE)
                    propertyNames = Array("DisplayControl", "RowSourceType", "RowSource", "BoundColumn", "ColumnCount", "ColumnWidths", "LimitToList")
                Case UCase$(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_LIVE)
                    propertyNames = Array("DisplayControl", "RowSourceType", "RowSource", "BoundColumn", "ColumnCount", "ColumnWidths", "LimitToList")
                Case "CAPTION"
                    propertyNames = Array("Caption")
                Case Else
                    Err.Raise vbObjectError + 9517, "B2MetadataFieldStatePayload", "Unknown B2 metadata definition kind while calculating the exact field-state proof." & vbCrLf & "Table: " & tdf.Name & vbCrLf & "Field: " & fieldName & vbCrLf & "Kind: " & definitionKind
            End Select
            For Each propertyName In propertyNames
                payloadText = payloadText & FingerprintTokenPart(CStr(propertyName))
                payloadText = payloadText & FingerprintTokenPart(DaoObjectPropertyFingerprintText(fld, CStr(propertyName)))
            Next propertyName
        End If
    Next Definition
    B2MetadataFieldStatePayload = payloadText
End Function

Private Sub PreseedB1ColdFieldProperties(ByVal fld As DAO.Field, ByVal expectedColumnOrder As Long)
    'Best-effort detached-Field ColumnOrder seeding reduces post-append Access property writes. G1 exclusively owns field descriptions.
    On Error Resume Next
    Err.Clear
    Call EnsureDaoPropertyValue(fld, "ColumnOrder", dbInteger, CInt(expectedColumnOrder))
    Err.Clear
    On Error GoTo 0
End Sub

