Private Sub RepairManagedObjectCatalogSystemMacroTables(ByVal tableNames As Variant)
    Dim tableName As Variant
    For Each tableName In tableNames
        Select Case CStr(tableName)
            Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros")
                EnsureSystemMacrosTable
            Case Else
                Err.Raise vbObjectError + 9499, "RepairManagedObjectCatalogSystemMacroTables", "The canonical B1 system-macro family contains a table with no repair implementation mapping." & vbCrLf & "Table: " & CStr(tableName)
        End Select
    Next tableName
End Sub

Private Sub RepairSystemMacroSourceRowsForSetup(ByVal defaultCatalog As Collection)
    'B4 owns only canonical MC_Sys source-row reconciliation. B1 owns table structure and B2 owns shared lookup/caption metadata during numbered Setup.
    RequireSetupDomainMutationAllowed SETUP_DOMAIN_B4_MACRO_MANAGED_DEFINITIONS, "RepairSystemMacroSourceRowsForSetup"
    If SystemMacroCatalogTableCanOpen() = False Then Err.Raise vbObjectError + 10042, "RepairSystemMacroSourceRowsForSetup", "The B1-owned [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & "] table is unavailable during B4. B4 does not repair B1-owned table structure."
    DefaultSystemMacros False, defaultCatalog
    RepairSystemMacroDesignatorConflictsFromDefaultCatalog True
End Sub

Private Sub RepairSystemMacroCatalogTable(ByVal repairDefaultRows As Boolean, Optional ByVal showMessage As Boolean = True, Optional ByVal defaultCatalog As Variant)
    RequireCatalogMutationRecoveryReady "RepairSystemMacroCatalogTable"
    'Intended use: Runs Repair Access Development Console System Macro Catalog Table for direct, generated-macro, form-button, or required cross-module callers.
    On Error GoTo ErrHandler
    If SharedAccess_PrepareOpenObjectForDesignChange(acTable, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros"), "repairing the [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & "] catalog table and lookup metadata") = False Then
        MarkSystemCommandCancelled
        Err.Raise vbObjectError + 9005, "RepairSystemMacroCatalogTable", "[" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & "] repair was cancelled because the affected open table was not approved for save and close."
    End If
    CorePulseProgress "Ensuring system macro catalog table exists."
    EnsureSystemMacrosTable
    CorePulseProgress "Repairing current canonical system macro rows."
    DefaultSystemMacros False, defaultCatalog
    CorePulseProgress "Preserving existing system macro descriptions, including blank or Null values."
    CorePulseProgress "Repairing system macro designator conflicts."
    RepairSystemMacroDesignatorConflictsFromDefaultCatalog repairDefaultRows
    CorePulseProgress "Report system macro catalog repair completion."
    ReportCoreActionSuccess "RepairSystemMacroCatalogTable", "Catalog", DEFAULT_UTILITY_SHORT_NAME & " system macro catalog repair completed successfully.", DEFAULT_UTILITY_LONG_NAME & " system macro catalog repair complete." & vbCrLf & vbCrLf & "Default-row repair requested: " & CStr(repairDefaultRows) & vbCrLf & "Designator-conflict validation: Completed" & vbCrLf & "Table: " & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros"), "Repair system macro catalog", ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros"), "Table", "CodeDb", "SystemMacroCatalog", showMessage, "Repair System Macro Catalog", vbInformation, False, "Tables", False, visibleStatusMessage:="System macro catalog repair completed successfully."
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    Dim messageText As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    messageText = "Could not repair " & DEFAULT_UTILITY_LONG_NAME & " system macro catalog." & vbCrLf & vbCrLf & "Procedure: RepairSystemMacroCatalogTable" & vbCrLf & "RepairDefaultRows: " & CStr(repairDefaultRows) & vbCrLf & "Table: " & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & vbCrLf & "Err.Number: " & CStr(savedErrNumber) & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description:" & vbCrLf & savedErrDescription & TableReadinessDiagnosticsForMessage() & TraceBackendDiagnosticsForMessage()
    LogTraceMessage TRACE_LEVEL_ERROR, ADCAT_SETUP_STAGE_SYSTEM_MACROS, "RepairSystemMacroCatalogTable", "System macro catalog repair failed.", messageText, "Repair system macro catalog", savedErrNumber, savedErrSource, savedErrDescription, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros"), "Table", "CodeDb", "SystemMacroCatalogRepair"
    If showMessage Then
        CoreShowErrorMessage messageText, vbCritical, "Repair System Macro Catalog", "RepairSystemMacroCatalogTable", "Tables"
        Exit Sub
    End If
    Err.Raise savedErrNumber, "RepairSystemMacroCatalogTable", messageText
End Sub

Private Sub EnsureSystemMacrosTable()
    Dim tableName As String
    Dim fieldDefinitions As Collection
    Dim indexDefinitions As Collection
    tableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros")
    If B1ColdCreatedStructuralProofAvailable(tableName) Then
