' Purpose: Resolves and returns system macro catalog title by key from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   systemMacroKey (Input; String): Canonical system-macro key that identifies the system macro definition or Ribbon command being resolved.
'   useDefaultCatalog (Input Optional; Boolean): True selects/uses default catalog; False follows the routine's alternate or default source/path. Default: False.
' Returns: String: Returns the canonical display text for system macro catalog title by key after applying the title/caption/label rules owned by this module; vbNullString represents no applicable display text
'   where supported.
Public Function SystemMacroCatalogTitleByKey(ByVal systemMacroKey As String, Optional ByVal useDefaultCatalog As Boolean = False) As String
    'Intended use: Resolves one System Macro title by key without materializing the complete catalog or its description/group caches.
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim tdf As DAO.tableDef
    Dim definitionData As Variant
    Dim tableName As String
    Dim sqlText As String
    Dim defaultSource As String
    Dim persistedTitle As String
    Dim hasCurrentDefaultDefinition As Boolean
    Dim hasDefaultSourceField As Boolean
    systemMacroKey = Trim$(systemMacroKey)
    If Len(systemMacroKey) = 0 Then Exit Function
    definitionData = SystemMacroDefinitionByKey(systemMacroKey)
    hasCurrentDefaultDefinition = Not IsEmpty(definitionData)
    If useDefaultCatalog Then
        If hasCurrentDefaultDefinition = False Then Exit Function
        SystemMacroCatalogTitleByKey = SystemMacroCalculatedTitle(CStr(definitionData(1)), CStr(definitionData(2)), CStr(definitionData(0)), definitionData)
        Exit Function
    End If
    tableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros")
    If CodeDbTableExists(tableName) = False Then GoTo DefaultLookup
    If TableCanOpen(tableName) = False Then GoTo DefaultLookup
    Set db = ResolveCatalogDb()
    Set tdf = db.TableDefs(tableName)
    hasDefaultSourceField = DAOFieldExists(tdf, FIELD_DEFAULT_SOURCE)
    sqlText = "SELECT [" & FIELD_SYSTEM_MACRO_DESIGNATOR & "],[" & FIELD_DEFAULT_TITLE_TEXT & "],[" & FIELD_MACRO_TITLE_OVERRIDE & "]"
    If hasDefaultSourceField Then sqlText = sqlText & "," & SQL_FIELD_DEFAULT_SOURCE
    sqlText = sqlText & " FROM [" & tableName & "] WHERE [" & FIELD_SYSTEM_MACRO_KEY & "]=" & SharedDao_SqlQuote(systemMacroKey)
    sqlText = sqlText & " AND Nz([" & FIELD_SYSTEM_MACRO_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE)
    sqlText = sqlText & " AND Len(Nz([" & FIELD_RUN_CODE_WRAPPER_NAME & "],''))>0;"
    Set rs = db.OpenRecordset(sqlText, dbOpenSnapshot)
    If rs.EOF = False Then
        If hasDefaultSourceField Then defaultSource = Trim$(CStr(Nz(rs.fields(FIELD_DEFAULT_SOURCE).value, vbNullString)))
        If StrComp(defaultSource, DEFAULT_CONSTANT_DEFINITION_SOURCE, vbTextCompare) <> 0 Or hasCurrentDefaultDefinition Then
            persistedTitle = SystemMacroActualTitleFromValues( _
                CStr(Nz(rs.fields(FIELD_SYSTEM_MACRO_DESIGNATOR).value, vbNullString)), _
                CStr(Nz(rs.fields(FIELD_DEFAULT_TITLE_TEXT).value, vbNullString)), _
                CStr(Nz(rs.fields(FIELD_MACRO_TITLE_OVERRIDE).value, vbNullString)), _
                systemMacroKey, _
                definitionData)
            If Len(Trim$(persistedTitle)) > 0 Then
                SystemMacroCatalogTitleByKey = persistedTitle
                rs.Close
                Exit Function
            End If
        End If
    End If
    rs.Close
DefaultLookup:
    If hasCurrentDefaultDefinition Then SystemMacroCatalogTitleByKey = SystemMacroCalculatedTitle(CStr(definitionData(1)), CStr(definitionData(2)), CStr(definitionData(0)), definitionData)
End Function

Private Sub AddCatalogSingleSystemMacroWrapperFinding(ByRef findings As Collection, ByVal wrapperName As String, ByVal sourceName As String)
    On Error GoTo ErrHandler
    Dim procedureKind As String
    Dim procedureLocation As String
    Dim argumentSignature As String
    Dim RequiredArgumentCount As Long
    Dim OptionalArgumentCount As Long
    Dim hasParamArray As Boolean
    Dim ExpectedReturnType As String
    Dim procedureNameToValidate As String
    Dim wrapperIsExpression As Boolean
    wrapperIsExpression = (InStr(1, wrapperName, "(", vbBinaryCompare) > 0)
    If wrapperIsExpression Then
        procedureNameToValidate = ProcedureNameFromRunCodeExpression(wrapperName)
    Else
        procedureNameToValidate = wrapperName
    End If
    x__UTIL_ADC_MACRO_RUNTIME.ClearVBEProcedureSearchError
    If x__UTIL_ADC_MACRO_RUNTIME.PublicCallableProcedureInfoInStandardModule(procedureNameToValidate, CONFIG_OWNER_DATABASE_ROLE_CODE_DB, procedureKind, procedureLocation, argumentSignature, RequiredArgumentCount, OptionalArgumentCount, hasParamArray, ExpectedReturnType) = False Then
        If x__UTIL_ADC_MACRO_RUNTIME.VBEProcedureSearchAmbiguityOccurred() Then
            findings.Add "System macro RunCode wrapper is ambiguous: " & wrapperName & vbCrLf & "Source: " & sourceName & vbCrLf & x__UTIL_ADC_MACRO_RUNTIME.VBEProcedureSearchAmbiguityText()
        ElseIf x__UTIL_ADC_MACRO_RUNTIME.VBEProcedureSearchErrorOccurred() Then
            findings.Add "System macro RunCode wrapper could not be validated: " & wrapperName & vbCrLf & "Source: " & sourceName & vbCrLf & x__UTIL_ADC_MACRO_RUNTIME.VBEProcedureSearchErrorText()
        Else
            findings.Add "System macro RunCode wrapper was not found as a public callable procedure: " & wrapperName & vbCrLf & "Source: " & sourceName
        End If
        Exit Sub
    End If
    If StrComp(procedureKind, TARGET_PROCEDURE_KIND_FUNCTION, vbTextCompare) <> 0 Then
        findings.Add "System macro RunCode wrapper is not a Function: " & wrapperName & vbCrLf & "Resolved kind: " & procedureKind & vbCrLf & "Resolved location: " & procedureLocation & vbCrLf & "Source: " & sourceName
    End If
    If RequiredArgumentCount > 0 And wrapperIsExpression = False Then
        findings.Add "System macro RunCode wrapper requires arguments and cannot be called by a no-argument system macro: " & wrapperName & vbCrLf & "Required arguments: " & CStr(RequiredArgumentCount) & vbCrLf & "Signature: " & argumentSignature & vbCrLf & "Source: " & sourceName
    End If
    Exit Sub
ErrHandler:
    findings.Add "System macro RunCode wrapper validation errored for wrapper: " & wrapperName & vbCrLf & "Source: " & sourceName & vbCrLf & "Description: " & Err.Description
End Sub

Private Sub AddCatalogSystemMacroWrapperFindings(ByRef findings As Collection, Optional ByRef validationDetail As String = vbNullString)
    On Error GoTo ErrHandler
    Dim vbeAccessDetail As String
    Dim validatedWrappers As Collection
    Dim sqlText As String
    Dim lookupScopeStarted As Boolean
    Dim distinctProcedureNamesIndexed As Long
    Dim vbComponentsEnumerated As Long
    Dim completeProjectEnumerationPasses As Long
    Dim fallbackSourceTextScans As Long
    Dim validationTimer As Single
    validationTimer = Timer
    If x__UTIL_ADC_MACRO_RUNTIME.CanAccessVBEProjectModel(vbeAccessDetail) = False Then
        findings.Add "System macro RunCode wrapper validation could not run because the VBE project model is unavailable." & vbCrLf & vbeAccessDetail
        Exit Sub
    End If
    x__UTIL_ADC_MACRO_RUNTIME.BeginPublicCallableProcedureLookupScope CONFIG_OWNER_DATABASE_ROLE_CODE_DB
    lookupScopeStarted = True
    ' INTENTIONAL KEYED LOOKUP: validatedWrappers provides keyed membership/lookup over source rows or state already read by AddCatalogSystemMacroWrapperFindings; it is a derived access path, not a second authority.
    Set validatedWrappers = New Collection
    sqlText = "SELECT DISTINCT [" & FIELD_RUN_CODE_WRAPPER_NAME & "] AS " & FIELD_WRAPPER_NAME & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros") & "] WHERE Nz([" & FIELD_SYSTEM_MACRO_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " AND Len(Nz([" & FIELD_RUN_CODE_WRAPPER_NAME & "],''))>0;"
    AddCatalogSystemMacroWrapperFindingsFromSql findings, validatedWrappers, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros"), sqlText
    sqlText = "SELECT DISTINCT p.[" & FIELD_RUN_CODE_WRAPPER_NAME & "] AS " & FIELD_WRAPPER_NAME & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_ManagedObjectsResolved") & "] AS r INNER JOIN [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads") & "] AS p ON r.[" & FIELD_MANAGED_OBJECT_ID & "]=p.[" & FIELD_MANAGED_OBJECT_ID & "] "
    sqlText = sqlText & "WHERE r.[" & FIELD_CATEGORY_CODE & "]=" & SharedDao_SqlQuote(ADCAT_CATEGORY_SYSTEM_MACRO)
    sqlText = sqlText & " AND r.[" & FIELD_MANAGED_OBJECT_STATUS & "]=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE)
    sqlText = sqlText & " AND r." & SQL_FIELD_OBJECT_CATEGORY_STATUS & "=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE)
    sqlText = sqlText & " AND p.[" & FIELD_PAYLOAD_STATUS & "]=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE)
    sqlText = sqlText & " AND p.[" & FIELD_PAYLOAD_KIND & "]=" & SharedDao_SqlQuote(ADCAT_PAYLOAD_ACCESS_MACRO_RUNCODE)
    sqlText = sqlText & " AND Len(Nz(p.[" & FIELD_RUN_CODE_WRAPPER_NAME & "],''))>0;"
    AddCatalogSystemMacroWrapperFindingsFromSql findings, validatedWrappers, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ManagedObjectActionPayloads"), sqlText
    x__UTIL_ADC_MACRO_RUNTIME.GetPublicCallableProcedureLookupScopeStats distinctProcedureNamesIndexed, vbComponentsEnumerated, completeProjectEnumerationPasses, fallbackSourceTextScans
    validationDetail = "Distinct RunCode wrapper names validated: " & CStr(validatedWrappers.count) & vbCrLf & _
        "Callable procedure names indexed: " & CStr(distinctProcedureNamesIndexed) & vbCrLf & _
        "VB components enumerated: " & CStr(vbComponentsEnumerated) & vbCrLf & _
        "Complete VBProject enumeration passes: " & CStr(completeProjectEnumerationPasses) & vbCrLf & _
        "Fallback standard-module source-text scans: " & CStr(fallbackSourceTextScans) & vbCrLf & _
        "Wrapper validation elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(validationTimer))
ExitHere:
    On Error Resume Next
    If lookupScopeStarted Then x__UTIL_ADC_MACRO_RUNTIME.EndPublicCallableProcedureLookupScope
    On Error GoTo 0
    Exit Sub
ErrHandler:
    findings.Add "System macro RunCode wrapper validation failed." & vbCrLf & "Description: " & Err.Description
    Resume ExitHere
End Sub

Private Sub AddCatalogSystemMacroWrapperFindingsFromSql(ByRef findings As Collection, ByRef validatedWrappers As Collection, ByVal sourceName As String, ByVal sqlText As String)
    On Error GoTo ErrHandler
    Dim rs As DAO.Recordset
    Dim wrapperName As String
    Dim wrapperKey As String
    Set rs = ResolveCatalogDb().OpenRecordset(sqlText, dbOpenSnapshot)
    Do While rs.EOF = False
        PumpSetupResponsiveness
        wrapperName = Trim$(CStr(rs.fields(FIELD_WRAPPER_NAME).value))
        wrapperKey = LCase$(ProcedureNameFromRunCodeExpression(wrapperName))
        If Len(wrapperKey) = 0 Then wrapperKey = LCase$(wrapperName)
        If Len(wrapperName) > 0 Then
            If SharedCollection_KeyExists(validatedWrappers, wrapperKey) = False Then
                MarkCollectionTextKey validatedWrappers, wrapperKey
                AddCatalogSingleSystemMacroWrapperFinding findings, wrapperName, sourceName
            End If
        End If
        rs.MoveNext
    Loop
ExitHere:
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    Exit Sub
ErrHandler:
    findings.Add "System macro RunCode wrapper rows could not be loaded for validation." & vbCrLf & "Source: " & sourceName & vbCrLf & "Description: " & Err.Description
    Resume ExitHere
End Sub

