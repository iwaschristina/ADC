    Dim sqlText As String
    sqlText = ""
    sqlText = sqlText & "SELECT cfg." & SQL_FIELD_ID & ", cfg." & SQL_FIELD_MACRO_KEY & ", cfg." & SQL_FIELD_MACRO_TITLE & ", cfg." & SQL_FIELD_MACRO_ACTION & ", cfg." & SQL_FIELD_CONFIGURATION_STATUS & ", "
