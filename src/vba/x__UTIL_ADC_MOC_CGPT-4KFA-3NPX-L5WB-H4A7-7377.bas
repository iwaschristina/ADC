    Select Case UCase$(domainName)
        Case "SCHEMA": CatalogDomainSeed = CATALOG_HASH_FORMAT_VERSION & "|Schema|" & CATALOG_SCHEMA_CONTRACT_VERSION
        Case "DEFAULTS": CatalogDomainSeed = CATALOG_HASH_FORMAT_VERSION & "|Defaults|" & CATALOG_DEFAULTS_CONTRACT_VERSION
        Case "DEFAULTSNONHELP": CatalogDomainSeed = CATALOG_HASH_FORMAT_VERSION & "|DefaultsNonHelp|" & CATALOG_DEFAULTS_CONTRACT_VERSION
        Case "DEFAULTSHELPDOCUMENTS": CatalogDomainSeed = CATALOG_HASH_FORMAT_VERSION & "|DefaultsHelpDocuments|" & CATALOG_DEFAULTS_CONTRACT_VERSION
        Case "INVENTORY": CatalogDomainSeed = CATALOG_HASH_FORMAT_VERSION & "|Inventory|" & CatalogInventoryContractSignature()
        Case "INVENTORYCORE": CatalogDomainSeed = CATALOG_HASH_FORMAT_VERSION & "|InventoryCore|" & CATALOG_CORE_INVENTORY_CONTRACT_VERSION
        Case "INVENTORYFORMS": CatalogDomainSeed = CATALOG_HASH_FORMAT_VERSION & "|InventoryForms|" & CATALOG_FORMS_INVENTORY_CONTRACT_VERSION
        Case "INVENTORYUI": CatalogDomainSeed = CATALOG_HASH_FORMAT_VERSION & "|InventoryUI|" & CATALOG_UI_INVENTORY_CONTRACT_VERSION
        Case "INVENTORYMACROS": CatalogDomainSeed = CATALOG_HASH_FORMAT_VERSION & "|InventoryMacros|" & CATALOG_MACRO_INVENTORY_CONTRACT_VERSION
        Case "DEPENDENCIES": CatalogDomainSeed = CATALOG_HASH_FORMAT_VERSION & "|Dependencies|" & CATALOG_DEPENDENCY_CONTRACT_VERSION
        Case "PAYLOADS": CatalogDomainSeed = CATALOG_HASH_FORMAT_VERSION & "|Payloads|" & CatalogPayloadContractSignature()
        Case "PAYLOADSCORE": CatalogDomainSeed = CATALOG_HASH_FORMAT_VERSION & "|PayloadsCore|" & CATALOG_CORE_PAYLOAD_CONTRACT_VERSION
        Case "PAYLOADSFORMS": CatalogDomainSeed = CATALOG_HASH_FORMAT_VERSION & "|PayloadsForms|" & CATALOG_FORMS_PAYLOAD_CONTRACT_VERSION
        Case "PAYLOADSUI": CatalogDomainSeed = CATALOG_HASH_FORMAT_VERSION & "|PayloadsUI|" & CATALOG_UI_PAYLOAD_CONTRACT_VERSION
        Case "PAYLOADSMACROS": CatalogDomainSeed = CATALOG_HASH_FORMAT_VERSION & "|PayloadsMacros|" & CATALOG_MACRO_PAYLOAD_CONTRACT_VERSION
        Case "UI": CatalogDomainSeed = CATALOG_HASH_FORMAT_VERSION & "|UI|" & CATALOG_UI_CONTRACT_VERSION
        Case "FORMS": CatalogDomainSeed = CATALOG_HASH_FORMAT_VERSION & "|Forms|" & CATALOG_FORMS_CONTRACT_VERSION
        Case "QUERIES": CatalogDomainSeed = CATALOG_HASH_FORMAT_VERSION & "|Queries|" & CATALOG_QUERY_CONTRACT_VERSION
        Case "OPERATIONALHISTORY": CatalogDomainSeed = CATALOG_OPERATIONAL_HISTORY_CONTRACT_VERSION
        Case "DIAGNOSTICHISTORY": CatalogDomainSeed = CATALOG_DIAGNOSTIC_HISTORY_CONTRACT_VERSION
        Case Else: Err.Raise vbObjectError + 9494, "CatalogDomainSeed", "Unsupported catalog fingerprint domain: " & domainName
    End Select
End Function

Private Function CatalogObservedPropertySetComplete(ByVal db As DAO.Database, ByVal expectedKey As String, ByVal keyProperty As String, ByVal coreProperty As String, ByVal formsProperty As String, ByVal uiProperty As String, ByVal macroProperty As String, ByRef coreValue As String, ByRef formsValue As String, ByRef uiValue As String, ByRef macroValue As String) As Boolean
    Dim propertyExists As Boolean
    Dim storedKey As String
    storedKey = DatabaseTextPropertyValue(db, keyProperty, propertyExists)
    If propertyExists = False Or StrComp(storedKey, expectedKey, vbBinaryCompare) <> 0 Then Exit Function
    coreValue = DatabaseTextPropertyValue(db, coreProperty, propertyExists): If propertyExists = False Or Len(coreValue) = 0 Then Exit Function
    formsValue = DatabaseTextPropertyValue(db, formsProperty, propertyExists): If propertyExists = False Or Len(formsValue) = 0 Then Exit Function
    uiValue = DatabaseTextPropertyValue(db, uiProperty, propertyExists): If propertyExists = False Or Len(uiValue) = 0 Then Exit Function
    macroValue = DatabaseTextPropertyValue(db, macroProperty, propertyExists): If propertyExists = False Or Len(macroValue) = 0 Then Exit Function
    CatalogObservedPropertySetComplete = True
End Function

Private Sub PersistCatalogObservedPropertySet(ByVal db As DAO.Database, ByVal cacheKey As String, ByVal keyProperty As String, ByVal coreProperty As String, ByVal formsProperty As String, ByVal uiProperty As String, ByVal macroProperty As String, ByVal coreValue As String, ByVal formsValue As String, ByVal uiValue As String, ByVal macroValue As String)
    On Error GoTo CacheWarning
    Call EnsureDaoPropertyValue(db, keyProperty, dbText, cacheKey, "PersistCatalogObservedPropertySet")
    Call EnsureDaoPropertyValue(db, coreProperty, dbText, coreValue, "PersistCatalogObservedPropertySet")
    Call EnsureDaoPropertyValue(db, formsProperty, dbText, formsValue, "PersistCatalogObservedPropertySet")
    Call EnsureDaoPropertyValue(db, uiProperty, dbText, uiValue, "PersistCatalogObservedPropertySet")
    Call EnsureDaoPropertyValue(db, macroProperty, dbText, macroValue, "PersistCatalogObservedPropertySet")
    Exit Sub
CacheWarning:
    AddTraceNote "Optional B1 interrupted-run observation cache could not be persisted. Current validation continues without weakening any postcondition. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
End Sub

Private Function ResolveCatalogInventorySubdomains(ByVal db As DAO.Database, ByRef currentSnapshot As CatalogDomainSnapshot, ByRef persistedSnapshot As CatalogDomainSnapshot, ByVal persistedAvailable As Boolean, ByVal inventoryPartitionToken As String, Optional ByRef timingDetail As String = vbNullString) As Boolean
    On Error GoTo ErrHandler
    Dim persistedPartitionExists As Boolean
    Dim persistedPartitionToken As String
    Dim cacheKey As String
    Dim allState As CatalogHashState
    Dim coreState As CatalogHashState
    Dim formsState As CatalogHashState
    Dim uiState As CatalogHashState
    Dim macroState As CatalogHashState
    Dim operationTimer As Single
    operationTimer = Timer
    cacheKey = currentSnapshot.InventoryFingerprint & "|" & inventoryPartitionToken
    If persistedAvailable Then
        persistedPartitionToken = DatabaseTextPropertyValue(db, CATALOG_INVENTORY_PARTITION_TOKEN_PROPERTY, persistedPartitionExists)
        If StrComp(currentSnapshot.InventoryFingerprint, persistedSnapshot.InventoryFingerprint, vbBinaryCompare) = 0 And StrComp(currentSnapshot.UiFingerprint, persistedSnapshot.UiFingerprint, vbBinaryCompare) = 0 Then
            If persistedPartitionExists = False Or StrComp(persistedPartitionToken, inventoryPartitionToken, vbBinaryCompare) = 0 Then
                currentSnapshot.CoreInventoryFingerprint = persistedSnapshot.CoreInventoryFingerprint
                currentSnapshot.FormsInventoryFingerprint = persistedSnapshot.FormsInventoryFingerprint
                currentSnapshot.UiInventoryFingerprint = persistedSnapshot.UiInventoryFingerprint
                currentSnapshot.MacroInventoryFingerprint = persistedSnapshot.MacroInventoryFingerprint
                timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Inventory subdomains reused from authoritative persisted evidence: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer)))
                ResolveCatalogInventorySubdomains = True
                Exit Function
            End If
        End If
    End If
    If CatalogObservedPropertySetComplete(db, cacheKey, CATALOG_OBSERVED_INVENTORY_KEY_PROPERTY, CATALOG_OBSERVED_CORE_INVENTORY_PROPERTY, CATALOG_OBSERVED_FORMS_INVENTORY_PROPERTY, CATALOG_OBSERVED_UI_INVENTORY_PROPERTY, CATALOG_OBSERVED_MACRO_INVENTORY_PROPERTY, currentSnapshot.CoreInventoryFingerprint, currentSnapshot.FormsInventoryFingerprint, currentSnapshot.UiInventoryFingerprint, currentSnapshot.MacroInventoryFingerprint) Then
        timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Inventory subdomains reused from the nonauthoritative interrupted-run observation cache: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer)))
        ResolveCatalogInventorySubdomains = True
        Exit Function
    End If
    CatalogHashInitialize allState: CatalogHashAppendText allState, FingerprintTokenPart(CatalogDomainSeed("Inventory"))
    CatalogHashInitialize coreState: CatalogHashAppendText coreState, FingerprintTokenPart(CatalogDomainSeed("InventoryCore"))
    CatalogHashInitialize formsState: CatalogHashAppendText formsState, FingerprintTokenPart(CatalogDomainSeed("InventoryForms"))
    CatalogHashInitialize uiState: CatalogHashAppendText uiState, FingerprintTokenPart(CatalogDomainSeed("InventoryUI"))
    CatalogHashInitialize macroState: CatalogHashAppendText macroState, FingerprintTokenPart(CatalogDomainSeed("InventoryMacros"))
    CatalogHashAppendManagedObjectInventory db, allState, coreState, formsState, uiState, macroState, currentSnapshot.failureDetail
    If Len(currentSnapshot.failureDetail) > 0 Then Exit Function
    If StrComp(CatalogHashToken(allState), currentSnapshot.InventoryFingerprint, vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 9760, "ResolveCatalogInventorySubdomains", "The broad inventory token changed while inventory subdomains were being calculated."
    currentSnapshot.CoreInventoryFingerprint = CatalogHashToken(coreState)
    currentSnapshot.FormsInventoryFingerprint = CatalogHashToken(formsState)
    currentSnapshot.UiInventoryFingerprint = CatalogHashToken(uiState)
    currentSnapshot.MacroInventoryFingerprint = CatalogHashToken(macroState)
    PersistCatalogObservedPropertySet db, cacheKey, CATALOG_OBSERVED_INVENTORY_KEY_PROPERTY, CATALOG_OBSERVED_CORE_INVENTORY_PROPERTY, CATALOG_OBSERVED_FORMS_INVENTORY_PROPERTY, CATALOG_OBSERVED_UI_INVENTORY_PROPERTY, CATALOG_OBSERVED_MACRO_INVENTORY_PROPERTY, currentSnapshot.CoreInventoryFingerprint, currentSnapshot.FormsInventoryFingerprint, currentSnapshot.UiInventoryFingerprint, currentSnapshot.MacroInventoryFingerprint
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Inventory subdomains calculated once and cached for interrupted-run reuse: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer)))
    ResolveCatalogInventorySubdomains = True
    Exit Function
ErrHandler:
    currentSnapshot.failureDetail = "Could not resolve B1 inventory subdomains. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
End Function

Private Function ResolveCatalogPayloadSubdomains(ByVal db As DAO.Database, ByRef currentSnapshot As CatalogDomainSnapshot, ByRef persistedSnapshot As CatalogDomainSnapshot, ByVal persistedAvailable As Boolean, ByVal inventoryPartitionToken As String, Optional ByRef timingDetail As String = vbNullString) As Boolean
    On Error GoTo ErrHandler
    Dim cacheKey As String
    Dim allState As CatalogHashState
    Dim coreState As CatalogHashState
    Dim formsState As CatalogHashState
    Dim uiState As CatalogHashState
    Dim macroState As CatalogHashState
    Dim operationTimer As Single
    operationTimer = Timer
    cacheKey = currentSnapshot.PayloadFingerprint & "|" & inventoryPartitionToken
    If persistedAvailable Then
        If StrComp(currentSnapshot.PayloadFingerprint, persistedSnapshot.PayloadFingerprint, vbBinaryCompare) = 0 And StrComp(currentSnapshot.InventoryFingerprint, persistedSnapshot.InventoryFingerprint, vbBinaryCompare) = 0 And StrComp(currentSnapshot.UiFingerprint, persistedSnapshot.UiFingerprint, vbBinaryCompare) = 0 Then
            currentSnapshot.CorePayloadFingerprint = persistedSnapshot.CorePayloadFingerprint
            currentSnapshot.FormsPayloadFingerprint = persistedSnapshot.FormsPayloadFingerprint
            currentSnapshot.UiPayloadFingerprint = persistedSnapshot.UiPayloadFingerprint
            currentSnapshot.MacroPayloadFingerprint = persistedSnapshot.MacroPayloadFingerprint
            timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Payload subdomains reused from authoritative persisted evidence: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer)))
            ResolveCatalogPayloadSubdomains = True
            Exit Function
        End If
    End If
    If CatalogObservedPropertySetComplete(db, cacheKey, CATALOG_OBSERVED_PAYLOAD_KEY_PROPERTY, CATALOG_OBSERVED_CORE_PAYLOAD_PROPERTY, CATALOG_OBSERVED_FORMS_PAYLOAD_PROPERTY, CATALOG_OBSERVED_UI_PAYLOAD_PROPERTY, CATALOG_OBSERVED_MACRO_PAYLOAD_PROPERTY, currentSnapshot.CorePayloadFingerprint, currentSnapshot.FormsPayloadFingerprint, currentSnapshot.UiPayloadFingerprint, currentSnapshot.MacroPayloadFingerprint) Then
        timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Payload subdomains reused from the nonauthoritative interrupted-run observation cache: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer)))
        ResolveCatalogPayloadSubdomains = True
        Exit Function
    End If
    CatalogHashInitialize allState: CatalogHashAppendText allState, FingerprintTokenPart(CatalogDomainSeed("Payloads"))
    CatalogHashInitialize coreState: CatalogHashAppendText coreState, FingerprintTokenPart(CatalogDomainSeed("PayloadsCore"))
    CatalogHashInitialize formsState: CatalogHashAppendText formsState, FingerprintTokenPart(CatalogDomainSeed("PayloadsForms"))
    CatalogHashInitialize uiState: CatalogHashAppendText uiState, FingerprintTokenPart(CatalogDomainSeed("PayloadsUI"))
    CatalogHashInitialize macroState: CatalogHashAppendText macroState, FingerprintTokenPart(CatalogDomainSeed("PayloadsMacros"))
    CatalogHashAppendManagedPayloads db, allState, coreState, formsState, uiState, macroState, currentSnapshot.failureDetail
    If Len(currentSnapshot.failureDetail) > 0 Then Exit Function
    If StrComp(CatalogHashToken(allState), currentSnapshot.PayloadFingerprint, vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 9761, "ResolveCatalogPayloadSubdomains", "The broad payload token changed while payload subdomains were being calculated."
    currentSnapshot.CorePayloadFingerprint = CatalogHashToken(coreState)
    currentSnapshot.FormsPayloadFingerprint = CatalogHashToken(formsState)
    currentSnapshot.UiPayloadFingerprint = CatalogHashToken(uiState)
    currentSnapshot.MacroPayloadFingerprint = CatalogHashToken(macroState)
    PersistCatalogObservedPropertySet db, cacheKey, CATALOG_OBSERVED_PAYLOAD_KEY_PROPERTY, CATALOG_OBSERVED_CORE_PAYLOAD_PROPERTY, CATALOG_OBSERVED_FORMS_PAYLOAD_PROPERTY, CATALOG_OBSERVED_UI_PAYLOAD_PROPERTY, CATALOG_OBSERVED_MACRO_PAYLOAD_PROPERTY, currentSnapshot.CorePayloadFingerprint, currentSnapshot.FormsPayloadFingerprint, currentSnapshot.UiPayloadFingerprint, currentSnapshot.MacroPayloadFingerprint
    timingDetail = SharedText_AppendNonBlankLine(timingDetail, "Payload subdomains calculated once and cached for interrupted-run reuse: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer)))
    ResolveCatalogPayloadSubdomains = True
    Exit Function
ErrHandler:
    currentSnapshot.failureDetail = "Could not resolve B1 payload subdomains. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
End Function

Private Function CatalogFingerprintMismatchLine(ByVal domainName As String, ByVal storedValue As String, ByVal currentValue As String) As String
    If StrComp(storedValue, currentValue, vbBinaryCompare) = 0 Then
        CatalogFingerprintMismatchLine = domainName & "=matched"
    Else
        CatalogFingerprintMismatchLine = domainName & "=changed | Stored=" & IIf(Len(storedValue) = 0, "<unseeded>", storedValue) & " | Current=" & IIf(Len(currentValue) = 0, "<unavailable>", currentValue)
    End If
End Function

Private Function CatalogIncrementalComparisonDetail(ByRef currentSnapshot As CatalogDomainSnapshot, ByRef persistedSnapshot As CatalogDomainSnapshot, ByVal persistedAvailable As Boolean, ByVal storedRootToken As String, ByVal currentRootToken As String) As String
    Dim detailText As String
    detailText = "B1 compact-state comparison." & vbCrLf & "Stored root token: " & IIf(Len(storedRootToken) = 0, "<unseeded>", storedRootToken) & vbCrLf & "Current root token: " & IIf(Len(currentRootToken) = 0, "<unavailable>", currentRootToken)
    If persistedAvailable = False Then
        CatalogIncrementalComparisonDetail = detailText & vbCrLf & "Persisted exact domain snapshot: unavailable; current domains were calculated without translating that condition into an automatic second full pass."
        Exit Function
    End If
    detailText = detailText & vbCrLf & CatalogFingerprintMismatchLine("Schema", persistedSnapshot.SchemaFingerprint, currentSnapshot.SchemaFingerprint)
    detailText = detailText & vbCrLf & CatalogFingerprintMismatchLine("Defaults", persistedSnapshot.DefaultsFingerprint, currentSnapshot.DefaultsFingerprint)
    detailText = detailText & vbCrLf & CatalogFingerprintMismatchLine("NonHelpDefaults", persistedSnapshot.NonHelpDefaultsFingerprint, currentSnapshot.NonHelpDefaultsFingerprint)
    detailText = detailText & vbCrLf & CatalogFingerprintMismatchLine("HelpDocumentsRows", persistedSnapshot.HelpDocumentsFingerprint, currentSnapshot.HelpDocumentsFingerprint)
    detailText = detailText & vbCrLf & CatalogFingerprintMismatchLine("Inventory", persistedSnapshot.InventoryFingerprint, currentSnapshot.InventoryFingerprint)
    detailText = detailText & vbCrLf & CatalogFingerprintMismatchLine("CoreInventory", persistedSnapshot.CoreInventoryFingerprint, currentSnapshot.CoreInventoryFingerprint)
    detailText = detailText & vbCrLf & CatalogFingerprintMismatchLine("FormsInventory", persistedSnapshot.FormsInventoryFingerprint, currentSnapshot.FormsInventoryFingerprint)
    detailText = detailText & vbCrLf & CatalogFingerprintMismatchLine("UiInventory", persistedSnapshot.UiInventoryFingerprint, currentSnapshot.UiInventoryFingerprint)
    detailText = detailText & vbCrLf & CatalogFingerprintMismatchLine("MacroInventory", persistedSnapshot.MacroInventoryFingerprint, currentSnapshot.MacroInventoryFingerprint)
    detailText = detailText & vbCrLf & CatalogFingerprintMismatchLine("Dependencies", persistedSnapshot.DependencyFingerprint, currentSnapshot.DependencyFingerprint)
    detailText = detailText & vbCrLf & CatalogFingerprintMismatchLine("Payloads", persistedSnapshot.PayloadFingerprint, currentSnapshot.PayloadFingerprint)
    detailText = detailText & vbCrLf & CatalogFingerprintMismatchLine("CorePayloads", persistedSnapshot.CorePayloadFingerprint, currentSnapshot.CorePayloadFingerprint)
    detailText = detailText & vbCrLf & CatalogFingerprintMismatchLine("FormsPayloads", persistedSnapshot.FormsPayloadFingerprint, currentSnapshot.FormsPayloadFingerprint)
    detailText = detailText & vbCrLf & CatalogFingerprintMismatchLine("UiPayloads", persistedSnapshot.UiPayloadFingerprint, currentSnapshot.UiPayloadFingerprint)
    detailText = detailText & vbCrLf & CatalogFingerprintMismatchLine("MacroPayloads", persistedSnapshot.MacroPayloadFingerprint, currentSnapshot.MacroPayloadFingerprint)
    detailText = detailText & vbCrLf & CatalogFingerprintMismatchLine("UI", persistedSnapshot.UiFingerprint, currentSnapshot.UiFingerprint)
    detailText = detailText & vbCrLf & CatalogFingerprintMismatchLine("Forms", persistedSnapshot.FormsFingerprint, currentSnapshot.FormsFingerprint)
    detailText = detailText & vbCrLf & CatalogFingerprintMismatchLine("Queries", persistedSnapshot.QueryFingerprint, currentSnapshot.QueryFingerprint)
    CatalogIncrementalComparisonDetail = detailText
End Function

Private Function CalculateCatalogSchemaDomain(ByVal db As DAO.Database, ByRef SchemaFingerprint As String, ByRef SchemaTableCount As Long, ByRef failureDetail As String, Optional ByVal refreshMetadata As Boolean = True) As Boolean
    'Calculates the exact schema-domain token used by complete and selective snapshots from one shared implementation.
    On Error GoTo ErrHandler
    Dim schemaTables As Collection
    Dim item As Variant
    Dim itemText As String
    Dim itemIndex As Long
    Dim schemaState As CatalogHashState
    failureDetail = vbNullString
    SchemaFingerprint = vbNullString
    SchemaTableCount = 0
    If refreshMetadata Then
        db.TableDefs.Refresh
        db.Relations.Refresh
    End If
    Set schemaTables = CatalogFastPathSchemaTableNames()
    CatalogHashInitialize schemaState
    CatalogHashAppendText schemaState, FingerprintTokenPart(CatalogDomainSeed("Schema"))
    For Each item In schemaTables
        PumpSetupResponsiveness
        itemIndex = itemIndex + 1
        PulseCatalogSetupPart7 "exact schema " & CStr(itemIndex) & " of " & CStr(schemaTables.count) & ": " & CStr(item)
        itemText = CatalogFastPathTableDefinitionText(db, CStr(item), failureDetail)
        If Len(failureDetail) > 0 Then Exit Function
        CatalogHashAppendText schemaState, itemText
        SchemaTableCount = SchemaTableCount + 1
    Next item
    PulseCatalogSetupPart7 "exact relationship fingerprint."
    CatalogHashAppendText schemaState, CatalogFastPathRelationshipText(db, schemaTables)
    SchemaFingerprint = CatalogHashToken(schemaState)
    CalculateCatalogSchemaDomain = True
    Exit Function
ErrHandler:
    failureDetail = "Could not calculate the managed-catalog schema-domain fingerprint. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
End Function

Private Function CalculateCatalogUiFingerprint(ByVal db As DAO.Database, ByRef failureDetail As String) As String
    'Calculates the exact UI-domain fingerprint used by the complete and selective catalog snapshots.
    On Error GoTo ErrHandler
    Dim uiState As CatalogHashState
    failureDetail = vbNullString
    CatalogHashInitialize uiState
    CatalogHashAppendText uiState, FingerprintTokenPart(CatalogDomainSeed("UI"))
    CatalogHashAppendTableData db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "UI", uiState, failureDetail
    If Len(failureDetail) > 0 Then Exit Function
    CatalogHashAppendTableData db, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_NavigationPaneGroups"), "UI", uiState, failureDetail
    If Len(failureDetail) > 0 Then Exit Function
    CalculateCatalogUiFingerprint = CatalogHashToken(uiState)
    Exit Function
ErrHandler:
    failureDetail = "Could not calculate the managed-catalog UI-domain fingerprint. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
End Function

Private Function CatalogDomainState(ByVal matched As Boolean, ByVal propertyExists As Boolean) As String
    If matched Then
        CatalogDomainState = "matched"
    ElseIf propertyExists Then
        CatalogDomainState = "changed"
    Else
        CatalogDomainState = "unseeded"
    End If
End Function

Private Sub LogCatalogSetupSubstageTiming(ByVal sourceProcedure As String, ByVal phaseName As String, ByVal timingDetail As String)
    On Error Resume Next
    timingDetail = Trim$(timingDetail)
    If Len(timingDetail) = 0 Then Exit Sub
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", sourceProcedure, phaseName & " substage timing captured.", timingDetail, phaseName & " timing", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "SetupTiming", "CodeDb", "Performance"
    On Error GoTo 0
End Sub

' Purpose: Initializes catalog setup context, coordinating `StrComp` and `End` as the implementation requires.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
' Returns: None (Sub). The procedure communicates its result through its database, UI, trace, or module-state side effects and raises errors where its implementation requires it.
Public Sub BeginCatalogSetupContext()
    'Intended use: Establish one safe setup-scoped catalog context for Parts 8 through 18.
    On Error GoTo ErrHandler
    Dim operationTimer As Single
    Dim stageTimer As Single
    Dim timingText As String
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    operationTimer = Timer
    If mCatalogSetupContextActive Then
        If StrComp(mCatalogSetupTraceRunID, CatalogSetupTraceIdentity(), vbBinaryCompare) = 0 Then Exit Sub
        EndCatalogSetupContext
    End If
    mCatalogSetupPart7HeartbeatActive = True
    mCatalogSetupPart7StartedTimer = Timer
    stageTimer = Timer
    PulseCatalogSetupPart7 "checking unfinished recovery state."
    RequireNoUnfinishedCatalogRecovery "BeginCatalogSetupContext"
    timingText = SharedText_AppendNonBlankLine(timingText, "Catalog recovery-state preflight: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    stageTimer = Timer
    PulseCatalogSetupPart7 "opening the CodeDb catalog workspace."
    Set mCatalogSetupContextDb = codeDb
    'Phase A may have created or repaired tables, saved queries, and relationships through TABLES' Workspace database handle. Synchronize the retained Catalog handle once before its first authoritative snapshot.
    mCatalogSetupContextDb.TableDefs.Refresh
    mCatalogSetupContextDb.QueryDefs.Refresh
    mCatalogSetupContextDb.Relations.Refresh
    timingText = SharedText_AppendNonBlankLine(timingText, "Catalog workspace acquisition and DAO collection synchronization: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    stageTimer = Timer
    PulseCatalogSetupPart7 "reading current catalog schema, data, query, and fingerprint state."
    InitializeCatalogSetupPhaseState
    timingText = SharedText_AppendNonBlankLine(timingText, "Catalog phase-state initialization call: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    stageTimer = Timer
    InitializeManagedDefinitionReferenceSnapshots True
    mManagedDefinitionReferenceSnapshotElapsedSeconds = ElapsedSecondsFromTimer(stageTimer)
    timingText = SharedText_AppendNonBlankLine(timingText, "Setup-scoped naming, category, and Navigation Pane snapshots: " & FormattedElapsedSeconds(mManagedDefinitionReferenceSnapshotElapsedSeconds))
    mCatalogSetupContextActive = True
    PulseCatalogSetupPart7 "setup-scoped catalog context is ready."
    mCatalogSetupPart7HeartbeatActive = False
    mCatalogSetupPart7StartedTimer = 0
    stageTimer = Timer
    LogTraceMessage TRACE_LEVEL_INFO, "ManagedObjectCatalog", "BeginCatalogSetupContext", "Setup-scoped catalog context initialized.", "Trace run: " & mCatalogSetupTraceRunID & vbCrLf & "Initial domain state: " & mCatalogSetupInitialDetail, "Catalog setup context", 0, vbNullString, vbNullString, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), "CatalogContext", "CodeDb", "ManagedObjectCatalog"
    timingText = SharedText_AppendNonBlankLine(timingText, "Catalog-context completion trace serialization/write: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(stageTimer)))
    timingText = SharedText_AppendNonBlankLine(timingText, "Setup B1 boundary total: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(operationTimer)))
    LogCatalogSetupSubstageTiming "BeginCatalogSetupContext", "Setup B1 catalog context boundary", timingText
    Exit Sub
ErrHandler:
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    mCatalogSetupPart7HeartbeatActive = False
    mCatalogSetupPart7StartedTimer = 0
    On Error Resume Next
    EndCatalogSetupContext
    On Error GoTo 0
    Err.Raise savedErrNumber, "BeginCatalogSetupContext", "Could not initialize the setup-scoped Managed Object Catalog context." & vbCrLf & "Original source: " & savedErrSource & vbCrLf & "Original description: " & savedErrDescription
End Sub

' Purpose: Closes catalog setup context, coordinating `End` as the implementation requires.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
' Returns: None (Sub). The procedure communicates its result through its database, UI, trace, or module-state side effects and raises errors where its implementation requires it.
Public Sub EndCatalogSetupContext()
    'Intended use: Release all setup-scoped catalog state after the final catalog phase or on setup failure.
    On Error Resume Next
    mCatalogSetupPart7HeartbeatActive = False
    mCatalogSetupPart7StartedTimer = 0
    AbortManagedDefinitionSplit
    ClearManagedDefinitionReferenceSnapshots
    ClearManagedPlacementValidationSnapshot
    Set mFieldDescriptionProofCache = Nothing
    mFieldDescriptionProofTraceRunID = vbNullString
    Set mCatalogSetupContextDb = Nothing
    mCatalogSetupContextActive = False
    ResetCatalogSetupPhaseState
    On Error GoTo 0
End Sub

Private Sub RequireCatalogSetupPhaseReady(ByVal sourceProcedure As String)
    If mCatalogSetupContextActive Then
        If StrComp(mCatalogSetupTraceRunID, CatalogSetupTraceIdentity(), vbBinaryCompare) <> 0 Then
            EndCatalogSetupContext
            BeginCatalogSetupContext
        End If
        Exit Sub
    End If
    RequireCatalogMutationRecoveryReady sourceProcedure
    EnsureCatalogSetupPhaseState
End Sub

Private Sub CatalogMarkSetupDomainsDirty(ByVal domainMask As Long)
    If domainMask = 0 Then Exit Sub
    mCompleteCatalogSameRunRibbonHandoffToken = vbNullString
    mCompleteCatalogSameRunRibbonHandoffTraceRunID = vbNullString
    If (domainMask And (CATALOG_DIRTY_INVENTORY Or CATALOG_DIRTY_UI Or CATALOG_DIRTY_FORMS)) <> 0 Then
        ClearManagedPlacementValidationSnapshot
    End If
    mCatalogSetupDirtyDomainMask = mCatalogSetupDirtyDomainMask Or domainMask
    mCatalogSetupCompactStateToken = vbNullString
    mCatalogSetupValidationMatches = False
End Sub

Private Function CatalogDirtyDomainSummary(ByVal domainMask As Long) As String
    Dim summaryText As String
    If domainMask = 0 Then
        CatalogDirtyDomainSummary = "none"
        Exit Function
    End If
    If (domainMask And CATALOG_DIRTY_SCHEMA) <> 0 Then summaryText = SharedText_AppendNonBlankLine(summaryText, "Schema")
    If (domainMask And CATALOG_DIRTY_DEFAULTS) <> 0 Then summaryText = SharedText_AppendNonBlankLine(summaryText, "Defaults")
    If (domainMask And CATALOG_DIRTY_INVENTORY) <> 0 Then summaryText = SharedText_AppendNonBlankLine(summaryText, "Inventory")
    If (domainMask And CATALOG_DIRTY_DEPENDENCIES) <> 0 Then summaryText = SharedText_AppendNonBlankLine(summaryText, "Dependencies")
    If (domainMask And CATALOG_DIRTY_PAYLOADS) <> 0 Then summaryText = SharedText_AppendNonBlankLine(summaryText, "Action payloads")
    If (domainMask And CATALOG_DIRTY_UI) <> 0 Then summaryText = SharedText_AppendNonBlankLine(summaryText, "UI placement/presentation")
    If (domainMask And CATALOG_DIRTY_FORMS) <> 0 Then summaryText = SharedText_AppendNonBlankLine(summaryText, "Forms")
    If (domainMask And CATALOG_DIRTY_QUERIES) <> 0 Then summaryText = SharedText_AppendNonBlankLine(summaryText, "Support queries")
    CatalogDirtyDomainSummary = Replace(summaryText, vbCrLf, ", ")
End Function

Private Function CatalogDirtyDomainCount(ByVal domainMask As Long) As Long
    Dim bitValue As Long
    bitValue = 1
    Do While bitValue <= CATALOG_DIRTY_QUERIES
        If (domainMask And bitValue) <> 0 Then CatalogDirtyDomainCount = CatalogDirtyDomainCount + 1
        bitValue = bitValue * 2
    Loop
End Function

