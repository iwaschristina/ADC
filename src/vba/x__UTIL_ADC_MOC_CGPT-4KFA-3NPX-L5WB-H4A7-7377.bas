Private Function ManagedObjectOverrideTextValue(ByVal managedObjectID As Long, ByVal fieldName As String) As String
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim tableName As String
    If managedObjectID <= 0 Or Len(fieldName) = 0 Then Exit Function
    Set db = ResolveCatalogDb()
    tableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECT_OVERRIDES_TABLE_LOGICAL_ID)
    If SharedDao_DatabaseTableExistsSafe(db, tableName) = False Then Exit Function
    Set rs = db.OpenRecordset("SELECT [" & fieldName & "] FROM [" & tableName & "] WHERE [" & FIELD_MANAGED_OBJECT_ID & "]=" & CStr(managedObjectID) & ";", dbOpenSnapshot)
    If rs.EOF = False Then ManagedObjectOverrideTextValue = CStr(Nz(rs.fields(fieldName).value, vbNullString))
    rs.Close
End Function

Private Sub SetManagedObjectOverrideTextValue(ByVal managedObjectID As Long, ByVal fieldName As String, ByVal fieldValue As String)
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim tableName As String
    Dim rowExisted As Boolean
    If managedObjectID <= 0 Then Err.Raise vbObjectError + 9016, "SetManagedObjectOverrideTextValue", "A positive ManagedObjectID is required for a managed-object override."
    Set db = ResolveCatalogDb()
    tableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECT_OVERRIDES_TABLE_LOGICAL_ID)
    Set rs = db.OpenRecordset("SELECT * FROM [" & tableName & "] WHERE [" & FIELD_MANAGED_OBJECT_ID & "]=" & CStr(managedObjectID) & ";", dbOpenDynaset)
    rowExisted = Not rs.EOF
    If rowExisted = False And Len(fieldValue) = 0 Then
        rs.Close
        Exit Sub
    End If
    If rowExisted Then
        rs.Edit
    Else
        rs.AddNew
        rs.fields(FIELD_MANAGED_OBJECT_ID).value = managedObjectID
    End If
    rs.fields(fieldName).value = IIf(Len(fieldValue) = 0, Null, fieldValue)
    rs.Update
    rs.Close
    If Len(fieldValue) = 0 Then DeleteEmptyManagedObjectOverrideRow managedObjectID
End Sub

Private Sub DeleteEmptyManagedObjectOverrideRow(ByVal managedObjectID As Long)
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim fieldNames As Variant
    Dim fieldName As Variant
    Dim tableName As String
    Dim hasOverride As Boolean
    Set db = ResolveCatalogDb()
    tableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECT_OVERRIDES_TABLE_LOGICAL_ID)
    If SharedDao_DatabaseTableExistsSafe(db, tableName) = False Then Exit Sub
    Set rs = db.OpenRecordset("SELECT * FROM [" & tableName & "] WHERE [" & FIELD_MANAGED_OBJECT_ID & "]=" & CStr(managedObjectID) & ";", dbOpenSnapshot)
    If rs.EOF Then
        rs.Close
        Exit Sub
    End If
    fieldNames = ManagedObjectOverrideFieldNames()
    For Each fieldName In fieldNames
        If Len(CStr(Nz(rs.fields(CStr(fieldName)).value, vbNullString))) > 0 Then
            hasOverride = True
            Exit For
        End If
    Next fieldName
    rs.Close
    If hasOverride = False Then db.Execute "DELETE FROM [" & tableName & "] WHERE [" & FIELD_MANAGED_OBJECT_ID & "]=" & CStr(managedObjectID) & ";", dbFailOnError
End Sub

