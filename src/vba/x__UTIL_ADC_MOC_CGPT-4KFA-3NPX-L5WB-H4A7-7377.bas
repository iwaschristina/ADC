' Purpose: Returns the complete rollback payload needed to restore the mutable MAC row and its sparse managed-object override row.
' Public role: Inter-module Catalog service used by Database Reference synchronization when it registers setup rollback for an existing managed-object row; Catalog remains the rollback-payload authority.
' Parameters:
'   rs (Input; DAO.Recordset): Positioned managed-object catalog row whose current restorable parent and override values are encoded into the rollback payload.
' Returns: String: Parent-row UPDATE plus the override-row restore action encoded as one rollback payload; raises when no restorable managed-object fields are available.
Public Function ManagedObjectRollbackSql(ByVal rs As DAO.Recordset) As String
    Dim fieldNames As Variant
    Dim fieldName As Variant
    Dim setText As String
    Dim managedObjectID As Long
    Dim parentRollbackSql As String
    Dim overrideRollbackSql As String
    fieldNames = Array(FIELD_OBJECT_NAME, FIELD_LOGICAL_OBJECT_NAME, FIELD_OBJECT_NAMING_CATEGORY, FIELD_OBJECT_DISPLAY_NAME, FIELD_OBJECT_DESCRIPTION, FIELD_OBJECT_TYPE, FIELD_CHAT_GPTUI_REPORT, FIELD_CATEGORY_CODE, FIELD_MANAGED_OBJECT_STATUS, FIELD_CATALOG_OWNER, FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER, FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY, FIELD_RIBBON_TAB_KEY, FIELD_RIBBON_TAB_LABEL, FIELD_RIBBON_GROUP_LABEL, FIELD_RIBBON_GROUP_SORT_ORDER, FIELD_RIBBON_TITLE, FIELD_RIBBON_TOOLTIP, FIELD_MANAGED_OBJECT_VERSION, FIELD_DEFAULT_SOURCE, FIELD_DEFAULTED_ON, FIELD_LAST_DEFAULT_REPAIR_ON, FIELD_COMMON_NAME, FIELD_MANAGED_OBJECT_FIELD_SEARCH_KEYWORDS, FIELD_MANAGED_OBJECT_FIELD_USAGE_GUIDANCE, FIELD_EDIT_POLICY, FIELD_LIFECYCLE_POLICY, FIELD_REPAIR_OWNER, FIELD_DELETION_POLICY, _
        FIELD_PRIMARY_WORKFLOW, FIELD_MANAGED_OBJECT_DEPENDENCY_DOCUMENTATION_STATUS, FIELD_MANAGED_OBJECT_FIELD_DOCUMENTATION_SOURCE, FIELD_MANAGED_OBJECT_FIELD_DOCUMENTATION_UPDATED_ON, FIELD_MANAGED_OBJECT_FIELD_SCHEMA_FINGERPRINT, FIELD_MANAGED_OBJECT_FIELD_SCHEMA_VERIFIED_ON, FIELD_IS_DOCUMENTATION_ACTIVE)
    For Each fieldName In fieldNames
        If SharedDao_RecordsetHasFieldSafe(rs, CStr(fieldName)) Then
            If Len(setText) > 0 Then setText = setText & ","
            setText = setText & "[" & Replace(CStr(fieldName), "]", "]]") & "]=" & ManagedObjectSqlLiteralForField(rs.fields(CStr(fieldName)).value, rs.fields(CStr(fieldName)).Type)
        End If
    Next fieldName
    If Len(setText) = 0 Then Err.Raise vbObjectError + 9500, "ManagedObjectRollbackSql", "No restorable MAC fields were available."
    managedObjectID = CLng(rs.fields(FIELD_ID).value)
    parentRollbackSql = "UPDATE [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] SET " & setText & " WHERE " & SQL_FIELD_ID & "=" & CStr(managedObjectID) & ";"
    overrideRollbackSql = ManagedObjectOverrideRollbackSql(managedObjectID)
    ManagedObjectRollbackSql = parentRollbackSql & MANAGED_OBJECT_ROLLBACK_OVERRIDE_DELIMITER & overrideRollbackSql
End Function

Private Function ManagedObjectOverrideRollbackSql(ByVal managedObjectID As Long) As String
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim tableName As String
    Dim fieldNames As Variant
    Dim fieldName As Variant
    Dim setText As String
    Set db = ResolveCatalogDb()
    tableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECT_OVERRIDES_TABLE_LOGICAL_ID)
    If SharedDao_DatabaseTableExistsSafe(db, tableName) = False Then Exit Function
    Set rs = db.OpenRecordset("SELECT * FROM [" & tableName & "] WHERE [" & FIELD_MANAGED_OBJECT_ID & "]=" & CStr(managedObjectID) & ";", dbOpenSnapshot)
    If rs.EOF Then
        rs.Close
        ManagedObjectOverrideRollbackSql = "DELETE FROM [" & tableName & "] WHERE [" & FIELD_MANAGED_OBJECT_ID & "]=" & CStr(managedObjectID) & ";"
        Exit Function
    End If
    fieldNames = ManagedObjectOverrideFieldNames()
    For Each fieldName In fieldNames
        If Len(setText) > 0 Then setText = setText & ","
        setText = setText & "[" & Replace(CStr(fieldName), "]", "]]") & "]=" & ManagedObjectSqlLiteralForField(rs.fields(CStr(fieldName)).value, rs.fields(CStr(fieldName)).Type)
    Next fieldName
    rs.Close
    ManagedObjectOverrideRollbackSql = "UPDATE [" & tableName & "] SET " & setText & " WHERE [" & FIELD_MANAGED_OBJECT_ID & "]=" & CStr(managedObjectID) & ";"
End Function

Private Function ManagedObjectNeedsNewObjectPlacementRepair(ByVal rs As DAO.Recordset, ByVal objectName As String, ByVal objectTypeCode As String) As Boolean
    Dim ownerCode As String
    Dim currentTabKey As String
    Dim currentTabLabel As String
    Dim currentGroupLabel As String
    Dim currentGroupOrder As Long
    Dim expectedTabKey As String
    Dim expectedTabLabel As String
    Dim expectedGroupLabel As String
    Dim expectedGroupOrder As Long
    Dim currentNavigationSettingKey As String
    Dim currentNavPaneVisibilityPolicy As String
    Dim expectedNavigationSettingKey As String
    Dim placementIncomplete As Boolean
    Dim ignoredLogicalIdentity As String
    Dim ignoredNavigationSettingKey As String
    Dim ignoredRibbonTabKey As String
    Dim ignoredRibbonTabLabel As String
    Dim ignoredRibbonGroupLabel As String
    Dim ignoredRibbonGroupSortOrder As Long
    Dim ignoredDirectlyExposedOnRibbon As Boolean
    Dim ignoredDefinitionSource As String
    ownerCode = Trim$(CStr(Nz(FieldValueIfExists(rs, FIELD_CATALOG_OWNER), vbNullString)))
    If StrComp(ownerCode, ADCAT_OWNER_SYSTEM_DEFAULT, vbTextCompare) <> 0 Then Exit Function
    If ManagedObjectPlacementRibbon(objectName, objectTypeCode, expectedTabKey, expectedTabLabel, expectedGroupLabel, expectedGroupOrder) = False Then Exit Function
    currentTabKey = Trim$(CStr(Nz(FieldValueIfExists(rs, FIELD_RIBBON_TAB_KEY), vbNullString)))
    currentTabLabel = Trim$(CStr(Nz(FieldValueIfExists(rs, FIELD_RIBBON_TAB_LABEL), vbNullString)))
    currentGroupLabel = Trim$(CStr(Nz(FieldValueIfExists(rs, FIELD_RIBBON_GROUP_LABEL), vbNullString)))
    currentGroupOrder = SharedValue_NzLong(FieldValueIfExists(rs, FIELD_RIBBON_GROUP_SORT_ORDER))
    expectedNavigationSettingKey = ManagedObjectNavigationPaneSettingKey(objectName, objectTypeCode)
    currentNavigationSettingKey = Trim$(CStr(Nz(FieldValueIfExists(rs, FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY), vbNullString)))
    If TryResolveAddInReviewPlacementDefinition(objectName, objectTypeCode, ignoredLogicalIdentity, ignoredNavigationSettingKey, ignoredRibbonTabKey, ignoredRibbonTabLabel, ignoredRibbonGroupLabel, ignoredRibbonGroupSortOrder, ignoredDirectlyExposedOnRibbon, ignoredDefinitionSource) Then
        currentNavPaneVisibilityPolicy = Trim$(ManagedObjectOverrideTextValue(CLng(Nz(FieldValueIfExists(rs, FIELD_ID), 0)), FIELD_NAV_PANE_VISIBILITY_POLICY_OVERRIDE))
        ManagedObjectNeedsNewObjectPlacementRepair = (StrComp(currentNavigationSettingKey, expectedNavigationSettingKey, vbTextCompare) <> 0 Or StrComp(currentNavPaneVisibilityPolicy, ADCAT_NAV_POLICY_ADD_TO_CONFIGURED_GROUP, vbTextCompare) <> 0 Or StrComp(currentTabKey, expectedTabKey, vbTextCompare) <> 0 Or StrComp(currentTabLabel, expectedTabLabel, vbTextCompare) <> 0 Or StrComp(currentGroupLabel, expectedGroupLabel, vbTextCompare) <> 0 Or currentGroupOrder <> expectedGroupOrder)
        Exit Function
    End If
    placementIncomplete = (Len(currentTabKey) = 0 Or Len(currentTabLabel) = 0 Or Len(currentGroupLabel) = 0 Or currentGroupOrder <= 0)
    If placementIncomplete Then
        ManagedObjectNeedsNewObjectPlacementRepair = True
        Exit Function
    End If
    ' SystemDefault non-form placement is canonical. Unknown current tab/group text can represent a stale former built-in identity and must converge rather than be preserved.
    ManagedObjectNeedsNewObjectPlacementRepair = (StrComp(currentNavigationSettingKey, expectedNavigationSettingKey, vbTextCompare) <> 0 Or StrComp(currentTabKey, expectedTabKey, vbTextCompare) <> 0 Or StrComp(currentTabLabel, expectedTabLabel, vbTextCompare) <> 0 Or StrComp(currentGroupLabel, expectedGroupLabel, vbTextCompare) <> 0 Or currentGroupOrder <> expectedGroupOrder)
End Function

Private Function ExpectedChatGPTUIReportForManagedObject(ByVal objectName As String, ByVal objectTypeCode As String) As Boolean
    'Derives the persisted classification from the sole canonical report naming authority; non-report and noncanonical report rows are False.
    Dim isCanonicalReport As Boolean
    If StrComp(Trim$(objectTypeCode), ADCAT_OBJECT_TYPE_REPORT, vbTextCompare) <> 0 Then Exit Function
    ExpectedChatGPTUIReportForManagedObject = ManagedReportChatGPTUIClassification(objectName, isCanonicalReport)
    If isCanonicalReport = False Then ExpectedChatGPTUIReportForManagedObject = False
End Function

Private Function ApplyExistingManagedObjectDefaults( _
    ByVal rs As DAO.Recordset, ByVal objectName As String, ByVal categoryCode As String, ByVal objectTypeCode As String, ByVal descriptionText As String, _
    ByVal SortOrder As Long, ByVal repairDefaultRows As Boolean, ByVal ribbonTabKeyDefault As String, ByVal RibbonTabLabelDefault As String, ByVal ribbonGroupLabelDefault As String, _
    ByVal ribbonGroupSortOrderDefault As Long, ByVal ribbonTitleDefault As String, ByVal navigationPaneGroupSettingKeyDefault As String, ByVal catalogOwnerDefault As String, _
    ByVal ribbonStaticTagDefault As String, ByVal deriveUserOwnedFormRibbonKeyFromObjectTitle As Boolean, ByVal hasExplicitPlacementDefaults As Boolean, ByVal namingCategory As String, _
    ByVal logicalObjectName As String, ByVal expectedChatGPTUIReport As Boolean, ByVal repairTimestamp As Date, ByRef managedObjectID As Long, ByRef placementRepairRequired As Boolean, _
    ByRef repairedDefaultCount As Long) As Boolean
    'Applies the complete repair/default contract to one already-selected existing MAC row; the caller retains recordset ownership, final Update, batch bookkeeping, and trace reporting.
    Dim rowChanged As Boolean
    Dim namingIdentityRepairRequired As Boolean
    Dim currentRibbonStaticTag As String
    Dim userOwnedFormRibbonTitleRepairRequired As Boolean
    Dim ribbonStaticTagRepairRequired As Boolean
    Dim chatGPTUIReportRepairRequired As Boolean
    managedObjectID = CLng(Nz(rs.fields(FIELD_ID).value, 0))
    If hasExplicitPlacementDefaults Then
        placementRepairRequired = ExplicitManagedObjectPlacementNeedsDefault(rs)
    Else
        placementRepairRequired = ManagedObjectNeedsNewObjectPlacementRepair(rs, objectName, objectTypeCode)
    End If
    namingIdentityRepairRequired = False
    chatGPTUIReportRepairRequired = (IsNull(rs.fields(FIELD_CHAT_GPTUI_REPORT).value) Or CBool(Nz(rs.fields(FIELD_CHAT_GPTUI_REPORT).value, False)) <> expectedChatGPTUIReport)
    If deriveUserOwnedFormRibbonKeyFromObjectTitle And Len(ribbonTitleDefault) > 0 Then userOwnedFormRibbonTitleRepairRequired = (StrComp(CStr(Nz(rs.fields(FIELD_RIBBON_TITLE).value, vbNullString)), ribbonTitleDefault, vbBinaryCompare) <> 0)
    If Len(namingCategory) > 0 Then
        If Len(CStr(Nz(rs.fields(FIELD_LOGICAL_OBJECT_NAME).value, vbNullString))) = 0 Or Len(CStr(Nz(rs.fields(FIELD_OBJECT_NAMING_CATEGORY).value, vbNullString))) = 0 Then namingIdentityRepairRequired = True
    End If
    If Len(Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_TAB_KEY).value, vbNullString)))) > 0 And Len(Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_TAB_LABEL).value, vbNullString)))) > 0 And Len(Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_GROUP_LABEL).value, vbNullString)))) > 0 And CLng(Nz(rs.fields(FIELD_RIBBON_GROUP_SORT_ORDER).value, 0)) > 0 Then
        currentRibbonStaticTag = Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_STATIC_TAG).value, vbNullString)))
        ribbonStaticTagRepairRequired = (Len(currentRibbonStaticTag) = 0)
        If Len(ribbonStaticTagDefault) > 0 And Len(currentRibbonStaticTag) > 0 Then
            If StrComp(currentRibbonStaticTag, ribbonStaticTagDefault, vbBinaryCompare) <> 0 Then
                If deriveUserOwnedFormRibbonKeyFromObjectTitle Then
                    ' User-owned form keys intentionally follow canonical ObjectDisplayName, so an edited title refreshes the derived key in D4.
                    ribbonStaticTagRepairRequired = True
                ElseIf Len(currentRibbonStaticTag) = 11 And Left$(currentRibbonStaticTag, 1) = "U" And TextContainsDecimalDigitsOnly(Mid$(currentRibbonStaticTag, 2)) Then
                    ribbonStaticTagRepairRequired = True
                Else
                    Err.Raise vbObjectError + 9564, "DefaultManagedObject", "A canonical Ribbon item already has a different permanent tag. The stored tag will not be silently changed." & vbCrLf & "Object: " & objectName & vbCrLf & "Stored tag: " & currentRibbonStaticTag & vbCrLf & "Authored tag: " & ribbonStaticTagDefault
                End If
            End If
        End If
    End If
    If repairDefaultRows = False And placementRepairRequired = False And namingIdentityRepairRequired = False And ribbonStaticTagRepairRequired = False And chatGPTUIReportRepairRequired = False And userOwnedFormRibbonTitleRepairRequired = False Then
        Exit Function
    End If
    If mManagedDefinitionDeltaExecutionActive Then
        If SetupRollbackTrackingActive() Then
            If TrackSetupManagedObjectRowRollback(CLng(rs.fields(FIELD_ID).value), True, ManagedObjectRollbackSql(rs)) Then mManagedDefinitionRollbackRegistrationCount = mManagedDefinitionRollbackRegistrationCount + 1
        End If
    End If
    rs.Edit
    If mManagedDefinitionDeltaExecutionActive Then
        ApplyManagedDefinitionExactObjectValues rs, objectName, categoryCode, objectTypeCode, descriptionText, SortOrder, logicalObjectName, namingCategory, ribbonTabKeyDefault, RibbonTabLabelDefault, ribbonGroupLabelDefault, ribbonGroupSortOrderDefault, ribbonTitleDefault, ribbonStaticTagDefault, rowChanged, repairedDefaultCount
    End If
    If chatGPTUIReportRepairRequired Then
        rs.fields(FIELD_CHAT_GPTUI_REPORT).value = expectedChatGPTUIReport
        rowChanged = True
    End If
    If userOwnedFormRibbonTitleRepairRequired Then
        'Discovered User RibbonTitle follows the physical object-name rule exactly; existing blank or stale values are repaired during D4 reconciliation.
        SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_TITLE, ribbonTitleDefault
        rowChanged = True
    End If
    If namingIdentityRepairRequired Then
        If Len(CStr(Nz(rs.fields(FIELD_LOGICAL_OBJECT_NAME).value, vbNullString))) = 0 Then rs.fields(FIELD_LOGICAL_OBJECT_NAME).value = logicalObjectName
        If Len(CStr(Nz(rs.fields(FIELD_OBJECT_NAMING_CATEGORY).value, vbNullString))) = 0 Then rs.fields(FIELD_OBJECT_NAMING_CATEGORY).value = namingCategory
        rowChanged = True
    End If
    If repairDefaultRows Then
        If SetManagedObjectFieldIfBlank(rs, FIELD_OBJECT_DISPLAY_NAME, objectName) Then repairedDefaultCount = repairedDefaultCount + 1
        If SetupDomainMutationWritesAllowedForCurrentPart(SETUP_DOMAIN_G1_DESCRIPTIONS) Then
            If SetManagedObjectFieldIfBlank(rs, FIELD_OBJECT_DESCRIPTION, descriptionText) Then repairedDefaultCount = repairedDefaultCount + 1
        End If
        If SetManagedObjectFieldIfBlank(rs, FIELD_CATEGORY_CODE, categoryCode) Then repairedDefaultCount = repairedDefaultCount + 1
        If SetManagedObjectFieldIfBlank(rs, FIELD_MANAGED_OBJECT_STATUS, ADCAT_STATUS_ACTIVE) Then repairedDefaultCount = repairedDefaultCount + 1
        If SetManagedObjectFieldIfBlank(rs, FIELD_CATALOG_OWNER, catalogOwnerDefault) Then repairedDefaultCount = repairedDefaultCount + 1
        If SetManagedObjectFieldIfBlank(rs, FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER, SortOrder) Then repairedDefaultCount = repairedDefaultCount + 1
        If SetManagedObjectFieldIfBlank(rs, FIELD_MANAGED_OBJECT_VERSION, MANAGED_OBJECT_CATALOG_SCHEMA_VERSION) Then repairedDefaultCount = repairedDefaultCount + 1
        If SetManagedObjectFieldIfBlank(rs, FIELD_DEFAULT_SOURCE, DEFAULT_CATALOG_SOURCE) Then repairedDefaultCount = repairedDefaultCount + 1
        If SetManagedObjectFieldIfBlank(rs, FIELD_DEFAULTED_ON, repairTimestamp) Then repairedDefaultCount = repairedDefaultCount + 1
        If repairedDefaultCount > 0 Then rowChanged = True
    End If
    If placementRepairRequired Then
        If hasExplicitPlacementDefaults Then
            ApplyExplicitManagedObjectPlacementDefaultsToRecordset rs, navigationPaneGroupSettingKeyDefault, ribbonTabKeyDefault, RibbonTabLabelDefault, ribbonGroupLabelDefault, ribbonGroupSortOrderDefault, True
        Else
            ApplyManagedObjectPlacementDefaultsToRecordset rs, objectName, objectTypeCode, categoryCode, True
        End If
        rowChanged = True
    End If
    If Len(Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_TAB_KEY).value, vbNullString)))) > 0 And Len(Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_TAB_LABEL).value, vbNullString)))) > 0 And Len(Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_GROUP_LABEL).value, vbNullString)))) > 0 And CLng(Nz(rs.fields(FIELD_RIBBON_GROUP_SORT_ORDER).value, 0)) > 0 Then
        currentRibbonStaticTag = Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_STATIC_TAG).value, vbNullString)))
        If Len(currentRibbonStaticTag) = 0 Or (Len(ribbonStaticTagDefault) > 0 And deriveUserOwnedFormRibbonKeyFromObjectTitle And StrComp(currentRibbonStaticTag, ribbonStaticTagDefault, vbBinaryCompare) <> 0) Or (Len(ribbonStaticTagDefault) > 0 And Len(currentRibbonStaticTag) = 11 And Left$(currentRibbonStaticTag, 1) = "U" And TextContainsDecimalDigitsOnly(Mid$(currentRibbonStaticTag, 2))) Then
            If Len(ribbonStaticTagDefault) > 0 Then currentRibbonStaticTag = ribbonStaticTagDefault Else currentRibbonStaticTag = "U" & Right$("0000000000" & CStr(managedObjectID), 10)
            rs.fields(FIELD_RIBBON_STATIC_TAG).value = currentRibbonStaticTag
            rowChanged = True
        End If
    End If
    If rowChanged Then
        SetRecordsetFieldValueIfExists rs, FIELD_LAST_DEFAULT_REPAIR_ON, repairTimestamp
        ApplyExistingManagedObjectDefaults = True
    Else
        rs.CancelUpdate
    End If
End Function



Private Sub DefaultManagedObject(ByVal objectName As String, ByVal categoryCode As String, ByVal objectTypeCode As String, ByVal descriptionText As String, ByVal SortOrder As Long, ByVal repairDefaultRows As Boolean, Optional ByVal ribbonTabKeyDefault As String = vbNullString, Optional ByVal RibbonTabLabelDefault As String = vbNullString, Optional ByVal ribbonGroupLabelDefault As String = vbNullString, Optional ByVal ribbonGroupSortOrderDefault As Long = 0, Optional ByVal ribbonTitleDefault As String = vbNullString, Optional ByVal descriptionAlreadyResolved As Boolean = False, Optional ByVal navigationPaneGroupSettingKeyDefault As String = vbNullString, Optional ByVal catalogOwnerDefault As String = vbNullString, Optional ByVal ribbonStaticTagOverride As String = vbNullString, Optional ByVal deriveUserOwnedFormRibbonKeyFromObjectTitle As Boolean = False, Optional ByVal preserveExactObjectName As Boolean = False)
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim sqlText As String
    Dim isNewRow As Boolean
    Dim placementRepairRequired As Boolean
    Dim repairedDefaultCount As Long
    Dim repairTimestamp As Date
    Dim ownsRecordset As Boolean
    Dim managedObjectID As Long
    Dim hasCompleteRibbonPlacement As Boolean
    Dim hasExplicitPlacementDefaults As Boolean
    Dim namingCategory As String
    Dim logicalObjectName As String
    Dim batchRowKey As String
    Dim batchBookmark As Variant
    Dim candidateKey As Variant
    Dim exactKeyPrefix As String
    Dim definitionPlanKey As String
    Dim selectedManagedObjectID As Long
    Dim ribbonStaticTagDefault As String
    Dim userOwnedFormObjectTitle As String
    Dim assignDynamicRibbonStaticTagAfterInsert As Boolean
    Dim expectedChatGPTUIReport As Boolean
    If Len(objectName) = 0 Then Exit Sub
    If descriptionAlreadyResolved = False Then descriptionText = ManagedObjectDefaultDescriptionForSetup(objectName, categoryCode, objectTypeCode, descriptionText)
    ribbonTabKeyDefault = Trim$(ribbonTabKeyDefault)
    RibbonTabLabelDefault = Trim$(RibbonTabLabelDefault)
    ribbonGroupLabelDefault = Trim$(ribbonGroupLabelDefault)
    navigationPaneGroupSettingKeyDefault = Trim$(navigationPaneGroupSettingKeyDefault)
    ribbonStaticTagOverride = Trim$(ribbonStaticTagOverride)
    If Len(catalogOwnerDefault) = 0 Then catalogOwnerDefault = ADCAT_OWNER_SYSTEM_DEFAULT
    hasCompleteRibbonPlacement = (Len(ribbonTabKeyDefault) > 0 And Len(RibbonTabLabelDefault) > 0 And Len(ribbonGroupLabelDefault) > 0 And ribbonGroupSortOrderDefault > 0)
    If Len(navigationPaneGroupSettingKeyDefault) > 0 And hasCompleteRibbonPlacement = False Then Err.Raise vbObjectError + 9560, "DefaultManagedObject", "Explicit user-form placement requires both a Navigation Pane setting key and complete Ribbon placement values." & vbCrLf & "Object: " & objectName
    hasExplicitPlacementDefaults = (Len(navigationPaneGroupSettingKeyDefault) > 0 And hasCompleteRibbonPlacement)
    namingCategory = ManagedObjectNamingCategory(objectTypeCode, categoryCode, objectName)
    If Len(namingCategory) > 0 Then logicalObjectName = LogicalObjectNameFromPhysicalName(namingCategory, objectName)
    expectedChatGPTUIReport = ExpectedChatGPTUIReportForManagedObject(objectName, objectTypeCode)
    If Len(ribbonStaticTagOverride) > 0 Then ribbonStaticTagDefault = ribbonStaticTagOverride Else TryRibbonStaticButtonTagDefault objectTypeCode, objectName, ribbonStaticTagDefault
    If mManagedDefinitionCaptureActive Then
        CaptureManagedObjectDefinition objectName, categoryCode, objectTypeCode, descriptionText, SortOrder, ribbonTabKeyDefault, RibbonTabLabelDefault, ribbonGroupLabelDefault, ribbonGroupSortOrderDefault, ribbonTitleDefault, ribbonStaticTagDefault
        Exit Sub
    End If
    If mManagedDefinitionDeltaExecutionActive Then
        If ManagedDefinitionObjectIsDirty(objectName, categoryCode, objectTypeCode) = False Then Exit Sub
        repairDefaultRows = True
        definitionPlanKey = ManagedDefinitionObjectPlanKey(objectName, categoryCode, objectTypeCode)
        If Not mManagedDefinitionSelectedObjectIDs Is Nothing Then
            If mManagedDefinitionSelectedObjectIDs.Exists(definitionPlanKey) Then selectedManagedObjectID = CLng(mManagedDefinitionSelectedObjectIDs(definitionPlanKey))
        End If
    End If
    PumpSetupResponsiveness
    repairTimestamp = Now()
    If mManagedDefinitionBatchActive Then
        Set db = mManagedDefinitionBatchDb
        Set rs = mManagedDefinitionBatchManagedRs
        If preserveExactObjectName Then
            batchRowKey = ManagedDefinitionExactManagedBookmarkKey(objectName, objectTypeCode)
        Else
            batchRowKey = ManagedDefinitionManagedBookmarkKey(objectName, objectTypeCode)
        End If
        If selectedManagedObjectID > 0 And mManagedDefinitionManagedBookmarksByID.Exists(CStr(selectedManagedObjectID)) Then
            rs.Bookmark = mManagedDefinitionManagedBookmarksByID(CStr(selectedManagedObjectID))
        ElseIf mManagedDefinitionBatchManagedBookmarks.Exists(batchRowKey) Then
            batchBookmark = mManagedDefinitionBatchManagedBookmarks(batchRowKey)
            rs.Bookmark = batchBookmark
        ElseIf preserveExactObjectName Then
            exactKeyPrefix = UCase$(Trim$(objectTypeCode)) & Chr$(30)
            For Each candidateKey In mManagedDefinitionBatchManagedBookmarks.keys
                If Left$(CStr(candidateKey), Len(exactKeyPrefix)) = exactKeyPrefix Then
                    If StrComp(Mid$(CStr(candidateKey), Len(exactKeyPrefix) + 1), objectName, vbTextCompare) = 0 Then
                        batchBookmark = mManagedDefinitionBatchManagedBookmarks(candidateKey)
                        rs.Bookmark = batchBookmark
                        Exit For
                    End If
                End If
            Next candidateKey
            If IsEmpty(batchBookmark) Then isNewRow = True
        Else
            isNewRow = True
        End If
    Else
        Set db = ResolveCatalogDb()
        sqlText = "SELECT * FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] WHERE " & SQL_FIELD_OBJECT_NAME & "=" & SharedDao_SqlQuote(objectName) & " AND " & SQL_FIELD_OBJECT_TYPE & "=" & SharedDao_SqlQuote(objectTypeCode) & ";"
        Set rs = db.OpenRecordset(sqlText, dbOpenDynaset)
        ownsRecordset = True
        isNewRow = rs.EOF
    End If
    If deriveUserOwnedFormRibbonKeyFromObjectTitle Then
        ' User-owned Ribbon identity is derived once from canonical MAC.ObjectDisplayName.
        ' Spaces are removed; the persisted RibbonStaticTag and Ribbon CustomID consume this same key.
        ' Do not independently reconstruct either value in Ribbon consumers.
        If isNewRow Then
            userOwnedFormObjectTitle = objectName
        Else
            userOwnedFormObjectTitle = Trim$(CStr(Nz(rs.fields(FIELD_OBJECT_DISPLAY_NAME).value, vbNullString)))
            If Len(userOwnedFormObjectTitle) = 0 And repairDefaultRows Then userOwnedFormObjectTitle = objectName
        End If
        ribbonStaticTagDefault = UserOwnedFormRibbonKeyFromObjectTitle(userOwnedFormObjectTitle, objectName)
        If isNewRow Then
            managedObjectID = 0
        Else
            managedObjectID = CLng(Nz(rs.fields(FIELD_ID).value, 0))
        End If
        ValidateUserOwnedFormRibbonKeyCollision db, managedObjectID, objectName, userOwnedFormObjectTitle, ribbonStaticTagDefault
    End If
    If isNewRow Then
        rs.AddNew
        rs.fields(FIELD_OBJECT_NAME).value = objectName
        SetRecordsetFieldValueIfExists rs, FIELD_LOGICAL_OBJECT_NAME, IIf(Len(logicalObjectName) = 0, Null, logicalObjectName)
        SetRecordsetFieldValueIfExists rs, FIELD_OBJECT_NAMING_CATEGORY, IIf(Len(namingCategory) = 0, Null, namingCategory)
        rs.fields(FIELD_OBJECT_TYPE).value = objectTypeCode
        rs.fields(FIELD_CHAT_GPTUI_REPORT).value = expectedChatGPTUIReport
        rs.fields(FIELD_OBJECT_DISPLAY_NAME).value = objectName
        If SetupDomainMutationWritesAllowedForCurrentPart(SETUP_DOMAIN_G1_DESCRIPTIONS) Then rs.fields(FIELD_OBJECT_DESCRIPTION).value = descriptionText
        rs.fields(FIELD_CATEGORY_CODE).value = categoryCode
        rs.fields(FIELD_MANAGED_OBJECT_STATUS).value = ADCAT_STATUS_ACTIVE
        rs.fields(FIELD_CATALOG_OWNER).value = catalogOwnerDefault
        rs.fields(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER).value = SortOrder
        rs.fields(FIELD_MANAGED_OBJECT_VERSION).value = MANAGED_OBJECT_CATALOG_SCHEMA_VERSION
        SetRecordsetFieldValueWithSource rs, FIELD_DEFAULT_SOURCE, DEFAULT_CATALOG_SOURCE, "DEFAULT_CATALOG_SOURCE"
        rs.fields(FIELD_DEFAULTED_ON).value = repairTimestamp
        If Len(ribbonTitleDefault) > 0 Then
            SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_TITLE, ribbonTitleDefault
        Else
            SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_TITLE, Null
        End If
        SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_TOOLTIP, Null
        If hasExplicitPlacementDefaults Then
            ApplyExplicitManagedObjectPlacementDefaultsToRecordset rs, navigationPaneGroupSettingKeyDefault, ribbonTabKeyDefault, RibbonTabLabelDefault, ribbonGroupLabelDefault, ribbonGroupSortOrderDefault, False
        Else
            ApplyManagedObjectPlacementDefaultsToRecordset rs, objectName, objectTypeCode, categoryCode, False
        End If
        If hasCompleteRibbonPlacement Then
            SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_TAB_KEY, ribbonTabKeyDefault
            SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_TAB_LABEL, RibbonTabLabelDefault
            SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_GROUP_LABEL, ribbonGroupLabelDefault
            SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_GROUP_SORT_ORDER, ribbonGroupSortOrderDefault
            If mManagedDefinitionBatchActive Then mManagedDefinitionBatchRibbonPlacementsInserted = mManagedDefinitionBatchRibbonPlacementsInserted + 1
        End If
        If Len(Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_TAB_KEY).value, vbNullString)))) > 0 And Len(Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_TAB_LABEL).value, vbNullString)))) > 0 And Len(Trim$(CStr(Nz(rs.fields(FIELD_RIBBON_GROUP_LABEL).value, vbNullString)))) > 0 And CLng(Nz(rs.fields(FIELD_RIBBON_GROUP_SORT_ORDER).value, 0)) > 0 Then
            If Len(ribbonStaticTagDefault) > 0 Then
                SetRecordsetFieldValueIfExists rs, FIELD_RIBBON_STATIC_TAG, ribbonStaticTagDefault
            Else
                assignDynamicRibbonStaticTagAfterInsert = True
            End If
        End If
    Else
        If ApplyExistingManagedObjectDefaults(rs, objectName, categoryCode, objectTypeCode, descriptionText, SortOrder, repairDefaultRows, _
            ribbonTabKeyDefault, RibbonTabLabelDefault, ribbonGroupLabelDefault, ribbonGroupSortOrderDefault, ribbonTitleDefault, navigationPaneGroupSettingKeyDefault, _
            catalogOwnerDefault, ribbonStaticTagDefault, deriveUserOwnedFormRibbonKeyFromObjectTitle, hasExplicitPlacementDefaults, namingCategory, logicalObjectName, _
            expectedChatGPTUIReport, repairTimestamp, managedObjectID, placementRepairRequired, repairedDefaultCount) = False Then
            If ownsRecordset Then rs.Close
            Exit Sub
        End If
    End If
    NormalizeZeroLengthOptionalTextFieldsForRecordsetUpdate rs
    rs.Update
    MarkManagedDefinitionMutation CATALOG_DIRTY_INVENTORY Or CATALOG_DIRTY_UI
    If isNewRow Then
        rs.Bookmark = rs.LastModified
        managedObjectID = CLng(rs.fields(FIELD_ID).value)
        If assignDynamicRibbonStaticTagAfterInsert Then
            rs.Edit
            rs.fields(FIELD_RIBBON_STATIC_TAG).value = "U" & Right$("0000000000" & CStr(managedObjectID), 10)
            rs.Update
        End If
        If mManagedDefinitionDeltaExecutionActive Then
            If SetupRollbackTrackingActive() Then
                If TrackSetupManagedObjectRowRollback(managedObjectID, False, vbNullString) Then mManagedDefinitionRollbackRegistrationCount = mManagedDefinitionRollbackRegistrationCount + 1
            End If
        End If
        If mManagedDefinitionBatchActive Then
            If mManagedDefinitionBatchObjectIDs.Exists(objectName) = False Then mManagedDefinitionBatchObjectIDs.Add objectName, managedObjectID
            If mManagedDefinitionBatchManagedBookmarks.Exists(batchRowKey) = False Then
                mManagedDefinitionBatchManagedBookmarks.Add batchRowKey, rs.Bookmark
            End If
            mManagedDefinitionBatchManagedInserted = mManagedDefinitionBatchManagedInserted + 1
        End If
    ElseIf mManagedDefinitionBatchActive Then
        mManagedDefinitionBatchManagedUpdated = mManagedDefinitionBatchManagedUpdated + 1
        If mManagedDefinitionBatchObjectIDs.Exists(objectName) Then mManagedDefinitionBatchObjectIDs(objectName) = managedObjectID Else mManagedDefinitionBatchObjectIDs.Add objectName, managedObjectID
        If mManagedDefinitionBatchManagedBookmarks.Exists(batchRowKey) Then mManagedDefinitionBatchManagedBookmarks(batchRowKey) = rs.Bookmark Else mManagedDefinitionBatchManagedBookmarks.Add batchRowKey, rs.Bookmark
    End If
    If mManagedDefinitionDeltaExecutionActive And Len(definitionPlanKey) > 0 And managedObjectID > 0 Then
        If mManagedDefinitionSelectedObjectIDs.Exists(definitionPlanKey) Then mManagedDefinitionSelectedObjectIDs(definitionPlanKey) = managedObjectID Else mManagedDefinitionSelectedObjectIDs.Add definitionPlanKey, managedObjectID
    End If
    If isNewRow = False And managedObjectID = 0 Then managedObjectID = CLng(Nz(rs.fields(FIELD_ID).value, 0))
    If hasExplicitPlacementDefaults = False Then
        If isNewRow Or placementRepairRequired Then ApplyManagedObjectPlacementOverrideDefaults managedObjectID, objectName, objectTypeCode
    End If
    If repairedDefaultCount > 0 Then CoreAddOperationNote "Defaulted " & CStr(repairedDefaultCount) & " blank or Null managed-object metadata field(s): " & objectTypeCode & " " & objectName & "."
    If mManagedDefinitionBatchActive = False Then AddTraceNote "Managed object catalog default processed without replacing nonblank values: ObjectName=" & objectName & "; ObjectType=" & objectTypeCode & "; CategoryCode=" & categoryCode & "; IsNewRow=" & CStr(isNewRow) & "; BlankDefaultsRepaired=" & CStr(repairedDefaultCount) & "; PlacementRepaired=" & CStr(placementRepairRequired) & "."
    If ownsRecordset Then rs.Close
    Exit Sub
ErrHandler:
    Dim originalErrNumber As Long
    Dim originalErrSource As String
    Dim originalErrDescription As String
    originalErrNumber = Err.Number
    originalErrSource = Err.Source
    originalErrDescription = Err.Description
    On Error Resume Next
    If Not rs Is Nothing Then
        If rs.EditMode <> dbEditNone Then rs.CancelUpdate
        If ownsRecordset Then rs.Close
    End If
    On Error GoTo 0
    Err.Raise originalErrNumber, "DefaultManagedObject", "Unable to default managed object catalog row without overwriting existing user values." & vbCrLf & "ObjectName: " & objectName & vbCrLf & "ObjectType: " & objectTypeCode & vbCrLf & "CategoryCode: " & categoryCode & vbCrLf & "Original source: " & originalErrSource & vbCrLf & "Description: " & originalErrDescription
End Sub

Private Function SetManagedObjectFieldIfBlank(ByVal rs As DAO.Recordset, ByVal fieldName As String, ByVal DefaultValue As Variant) As Boolean
    'Applies one managed-object default only when the field exists and its current value is Null, zero-length, or whitespace-only text. ObjectDescription is protected by the G1 Setup ownership boundary.
    Dim currentValue As Variant
    If StrComp(fieldName, FIELD_OBJECT_DESCRIPTION, vbTextCompare) = 0 Then
        If SetupDomainMutationWritesAllowedForCurrentPart(SETUP_DOMAIN_G1_DESCRIPTIONS) = False Then Exit Function
    End If
    If SharedDao_RecordsetFieldExists(rs, fieldName) = False Then Exit Function
    currentValue = rs.fields(fieldName).value
    If IsNull(currentValue) Then
        rs.fields(fieldName).value = DefaultValue
        SetManagedObjectFieldIfBlank = True
    ElseIf VarType(currentValue) = vbString Then
        If Len(Trim$(CStr(currentValue))) = 0 Then
            rs.fields(fieldName).value = DefaultValue
            SetManagedObjectFieldIfBlank = True
        End If
    End If
End Function

Private Function ManagedObjectIDByName(ByVal objectName As String, Optional ByVal objectTypeCode As String = vbNullString) As Long
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim sqlText As String
    Dim definitionPlanKey As String
    If Len(objectName) = 0 Then Exit Function
    If mManagedDefinitionDeltaExecutionActive And Len(objectTypeCode) = 0 Then
        If Not mManagedDefinitionObjectPhysicalIndex Is Nothing And Not mManagedDefinitionSelectedObjectIDs Is Nothing Then
            If mManagedDefinitionObjectPhysicalIndex.Exists(objectName) Then
                definitionPlanKey = CStr(mManagedDefinitionObjectPhysicalIndex(objectName))
                If mManagedDefinitionSelectedObjectIDs.Exists(definitionPlanKey) Then
                    ManagedObjectIDByName = CLng(mManagedDefinitionSelectedObjectIDs(definitionPlanKey))
                    Exit Function
                End If
            End If
        End If
    End If
    If mManagedDefinitionBatchActive And Len(objectTypeCode) = 0 Then
        If Not mManagedDefinitionBatchObjectIDs Is Nothing Then
            If mManagedDefinitionBatchObjectIDs.Exists(objectName) Then
                ManagedObjectIDByName = CLng(mManagedDefinitionBatchObjectIDs(objectName))
                Exit Function
            End If
        End If
    End If
    Set db = ResolveCatalogDb()
    sqlText = "SELECT TOP 1 " & SQL_FIELD_ID & " FROM [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] WHERE " & SQL_FIELD_OBJECT_NAME & "=" & SharedDao_SqlQuote(objectName)
    If Len(objectTypeCode) > 0 Then sqlText = sqlText & " AND " & SQL_FIELD_OBJECT_TYPE & "=" & SharedDao_SqlQuote(objectTypeCode)
    sqlText = sqlText & " ORDER BY " & OrderByPolicyText("CATALOG_MANAGED_OBJECT_ID_BY_NAME") & ";"
    Set rs = db.OpenRecordset(sqlText, dbOpenSnapshot)
    If rs.EOF = False Then ManagedObjectIDByName = CLng(rs.fields(FIELD_ID).value)
    rs.Close
    Exit Function
ErrHandler:
    ManagedObjectIDByName = 0
End Function

' Purpose: Performs managed report catalog classification current by coordinating `ManagedReportChatGPTUIClassification` and `ManagedObjectPhysicalName` while preserving this module's existing validation and error
'     semantics.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   reportName (Input; String): Physical Access report name identifying the report to open, inspect, verify, or manage.
'   detailText (Output Optional; String): Receives diagnostic detail text used to explain validation, lookup, recovery, or failure results to the caller. Default: vbNullString.
' Returns: Boolean: True when managed report catalog classification matches the state required by the current setup/build contract; False when repair or refresh is still required.
Public Function ManagedReportCatalogClassificationCurrent(ByVal reportName As String, Optional ByRef detailText As String = vbNullString) As Boolean
    'Read-only report-domain verifier: the Catalog owns persisted ChatGPTUIReport and must agree with the canonical report naming classification.
    On Error GoTo ErrHandler
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim isCanonicalReport As Boolean
    Dim expectedChatGPTUIReport As Boolean
    Dim managedObjectsTableName As String
    detailText = vbNullString
    expectedChatGPTUIReport = ManagedReportChatGPTUIClassification(reportName, isCanonicalReport)
    If isCanonicalReport = False Then detailText = "Report name is not a canonical generated-report physical identity: " & reportName: Exit Function
    managedObjectsTableName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID)
    Set db = ResolveCatalogDb()
    Set rs = db.OpenRecordset("SELECT " & SQL_FIELD_ID & "," & SQL_FIELD_CHAT_GPTUI_REPORT & " FROM [" & managedObjectsTableName & "] WHERE " & SQL_FIELD_OBJECT_NAME & "=" & SharedDao_SqlQuote(reportName) & " AND " & SQL_FIELD_OBJECT_TYPE & "=" & SharedDao_SqlQuote(ADCAT_OBJECT_TYPE_REPORT) & " AND Nz([" & FIELD_MANAGED_OBJECT_STATUS & "]," & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & ")=" & SharedDao_SqlQuote(ADCAT_STATUS_ACTIVE) & " ORDER BY " & SQL_FIELD_ID & ";", dbOpenSnapshot)
    If rs.EOF Then detailText = "Missing active managed-report catalog row: " & reportName: GoTo ExitHere
    If IsNull(rs.fields(FIELD_CHAT_GPTUI_REPORT).value) Then detailText = "Managed-report catalog classification is Null: " & reportName: GoTo ExitHere
    If CBool(rs.fields(FIELD_CHAT_GPTUI_REPORT).value) <> expectedChatGPTUIReport Then detailText = "Managed-report ChatGPTUIReport classification mismatch: " & reportName & "; expected=" & CStr(expectedChatGPTUIReport) & "; actual=" & CStr(CBool(rs.fields(FIELD_CHAT_GPTUI_REPORT).value)): GoTo ExitHere
    rs.MoveNext
    If rs.EOF = False Then detailText = "Multiple active managed-report catalog rows exist for: " & reportName: GoTo ExitHere
    ManagedReportCatalogClassificationCurrent = True
ExitHere:
    On Error Resume Next
    If Not rs Is Nothing Then rs.Close
    Exit Function
ErrHandler:
    detailText = "Could not verify managed-report ChatGPTUIReport classification [" & reportName & "]. Error " & CStr(Err.Number) & " from " & Err.Source & ": " & Err.Description
    Resume ExitHere
End Function

Private Function ManagedObjectsResolvedSql() As String
    Dim sqlText As String
    sqlText = "SELECT m." & SQL_FIELD_ID & " AS " & FIELD_MANAGED_OBJECT_ID & ", m." & SQL_FIELD_OBJECT_NAME & ", m." & SQL_FIELD_OBJECT_DISPLAY_NAME & ", m." & SQL_FIELD_OBJECT_DESCRIPTION & ", m." & SQL_FIELD_CHAT_GPTUI_REPORT & ", "
    sqlText = sqlText & "IIf(Len(Nz(m." & SQL_FIELD_OBJECT_TYPE & ",''))>0,m." & SQL_FIELD_OBJECT_TYPE & ",c." & SQL_FIELD_DEFAULT_OBJECT_TYPE & ") AS " & FIELD_RESOLVED_OBJECT_TYPE & ", "
    sqlText = sqlText & "m.[" & FIELD_CATEGORY_CODE & "], c." & SQL_FIELD_CATEGORY_NAME & ", c." & SQL_FIELD_OBJECT_CATEGORY_STATUS & ", m.[" & FIELD_MANAGED_OBJECT_STATUS & "], m.[" & FIELD_CATALOG_OWNER & "] AS " & FIELD_OBJECT_CATALOG_OWNER & ", c.[" & FIELD_CATALOG_OWNER & "] AS " & FIELD_CATEGORY_CATALOG_OWNER & ", c." & SQL_FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER & " AS " & FIELD_CATEGORY_SORT_ORDER & ", m." & SQL_FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER & " AS " & FIELD_OBJECT_SORT_ORDER & ", "
    sqlText = sqlText & "IIf(Len(Nz(o.[" & FIELD_SOURCE_OBJECT_NAME_OVERRIDE & "],''))>0,o.[" & FIELD_SOURCE_OBJECT_NAME_OVERRIDE & "],m." & SQL_FIELD_OBJECT_NAME & ") AS " & FIELD_MANAGED_OBJECT_FIELD_SOURCE_OBJECT_NAME & ", "
    sqlText = sqlText & "IIf(Len(Nz(o.[" & FIELD_TARGET_OBJECT_NAME_OVERRIDE & "],''))>0,o.[" & FIELD_TARGET_OBJECT_NAME_OVERRIDE & "],m." & SQL_FIELD_OBJECT_NAME & ") AS " & FIELD_TARGET_OBJECT_NAME & ", "
    sqlText = sqlText & ResolvedSetupActionSql("o", "c") & " AS " & FIELD_RESOLVED_SETUP_ACTION & ", "
    sqlText = sqlText & "IIf(Len(Nz(o.[" & FIELD_OBJECT_SOURCE_DB_ROLE_OVERRIDE & "],''))>0,o.[" & FIELD_OBJECT_SOURCE_DB_ROLE_OVERRIDE & "],c." & SQL_FIELD_DEFAULT_OBJECT_SOURCE_DB_ROLE & ") AS " & FIELD_RESOLVED_OBJECT_SOURCE_DB_ROLE & ", "
    sqlText = sqlText & "IIf(Len(Nz(o.[" & FIELD_CONFIG_OWNER_DATABASE_ROLE_OVERRIDE & "],''))>0,o.[" & FIELD_CONFIG_OWNER_DATABASE_ROLE_OVERRIDE & "],c." & SQL_FIELD_DEFAULT_CONFIG_OWNER_DATABASE_ROLE & ") AS " & FIELD_RESOLVED_CONFIG_OWNER_DATABASE_ROLE & ", "
    sqlText = sqlText & "IIf(Len(Nz(o.[" & FIELD_ENVIRONMENT_SCOPE_OVERRIDE & "],''))>0,o.[" & FIELD_ENVIRONMENT_SCOPE_OVERRIDE & "],c." & SQL_FIELD_DEFAULT_ENVIRONMENT_SCOPE & ") AS " & FIELD_RESOLVED_ENVIRONMENT_SCOPE & ", "
    sqlText = sqlText & "IIf(Len(Nz(o.[" & FIELD_SETUP_STAGE_OVERRIDE & "],''))>0,o.[" & FIELD_SETUP_STAGE_OVERRIDE & "],c." & SQL_FIELD_DEFAULT_SETUP_STAGE & ") AS " & FIELD_RESOLVED_SETUP_STAGE & ", "
    sqlText = sqlText & "IIf(Len(Nz(o.[" & FIELD_MANAGED_OBJECT_PURPOSE_OVERRIDE & "],''))>0,o.[" & FIELD_MANAGED_OBJECT_PURPOSE_OVERRIDE & "],c." & SQL_FIELD_DEFAULT_MANAGED_OBJECT_PURPOSE & ") AS " & FIELD_RESOLVED_MANAGED_OBJECT_PURPOSE & ", "
    sqlText = sqlText & "IIf(Len(Nz(o.[" & FIELD_NAV_PANE_VISIBILITY_POLICY_OVERRIDE & "],''))>0,o.[" & FIELD_NAV_PANE_VISIBILITY_POLICY_OVERRIDE & "],c." & SQL_FIELD_DEFAULT_NAV_PANE_VISIBILITY_POLICY & ") AS " & FIELD_RESOLVED_NAV_PANE_VISIBILITY_POLICY & ", "
    sqlText = sqlText & "m.[" & FIELD_NAVIGATION_PANE_GROUP_SETTING_KEY & "] AS " & FIELD_RESOLVED_NAVIGATION_PANE_GROUP_SETTING_KEY & ", "
    sqlText = sqlText & "m." & SQL_FIELD_RIBBON_TITLE & ", m." & SQL_FIELD_RIBBON_TOOLTIP & ", m.[" & FIELD_RIBBON_STATIC_TAG & "], m.[" & FIELD_RIBBON_TAB_KEY & "], m.[" & FIELD_RIBBON_TAB_LABEL & "], m.[" & FIELD_RIBBON_GROUP_LABEL & "], m.[" & FIELD_RIBBON_GROUP_SORT_ORDER & "], "
    sqlText = sqlText & ResolvedExpectedExistencePolicySql("o", "c") & " " & "AS " & SQL_FIELD_RESOLVED_EXPECTED_EXISTENCE_POLICY & ", "
    sqlText = sqlText & "m.[" & FIELD_MANAGED_OBJECT_VERSION & "], m.[" & FIELD_MANAGED_OBJECT_SIGNATURE & "], m." & SQL_FIELD_LAST_VALIDATED_ON & ", m." & SQL_FIELD_LAST_SETUP_ACTION_ON & ", m." & SQL_FIELD_LAST_SETUP_RESULT & ", m." & SQL_FIELD_LAST_SETUP_MESSAGE & ", m." & SQL_FIELD_MANUAL_REVIEW_NOTES & ", m." & SQL_FIELD_MANAGED_OBJECT_DEPENDENCY_NOTES & " "
    sqlText = sqlText & "FROM ([" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID) & "] AS m INNER JOIN [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ObjectCategories") & "] AS c ON m.[" & FIELD_CATEGORY_CODE & "]=c.[" & FIELD_CATEGORY_CODE & "]) LEFT JOIN [" & ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECT_OVERRIDES_TABLE_LOGICAL_ID) & "] AS o ON m." & SQL_FIELD_ID & "=o.[" & FIELD_MANAGED_OBJECT_ID & "] "
    sqlText = sqlText & "ORDER BY " & OrderByPolicyText("CATALOG_MANAGED_RESOLVED") & ";"
    ManagedObjectsResolvedSql = sqlText
End Function

