    resultText = SharedText_AppendNonBlankLine(resultText, "Authoritative description cache: hits=" & CStr(mManagedDefinitionDescriptionCacheHitCount) & "; misses=" & CStr(mManagedDefinitionDescriptionCacheMissCount))
    resultText = SharedText_AppendNonBlankLine(resultText, "Add-In Review placement-definition cache: hits=" & CStr(mAddInReviewPlacementCacheHitCount) & "; misses=" & CStr(mAddInReviewPlacementCacheMissCount))
    ManagedDefinitionPart11TimingText = resultText
End Function

