        Case LCase$(FIELD_OBJECT_NAME): HealthReviewFieldDescription = FIELD_DESC_LONG_HEALTH_REVIEW_OBJECTNAME
        Case LCase$(FIELD_PROCEDURE_NAME): HealthReviewFieldDescription = FIELD_DESC_LONG_HEALTH_REVIEW_PROCEDURENAME
