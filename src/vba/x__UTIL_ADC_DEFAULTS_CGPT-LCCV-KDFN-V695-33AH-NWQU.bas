    definitionData = GetGeneratedFormDefinition(formName)
    If IsArray(definitionData) = False Then Err.Raise vbObjectError + 7392, "GeneratedFormContractControlDefinitions", "No canonical generated-form definition exists." & vbCrLf & "Form: " & formName
    Select Case UCase$(formName)
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_GENERATED_FORM, CANON_GENERATED_FORM_LOGICAL_ID_HELP))
