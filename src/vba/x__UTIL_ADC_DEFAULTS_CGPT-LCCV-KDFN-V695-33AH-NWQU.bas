' Purpose: Determines whether physical form is discovery meets the discovery/classification rules required to be processed as a candidate.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   formName (Input; String): Physical Access form name identifying the form to create, open, configure, validate, or inspect.
' Returns: Boolean: True when the condition represented by FormDesignManagedObjectDefinitions is present under the routine's documented inputs/current state; False when that condition is absent.
Public Function PhysicalFormIsDiscoveryCandidate(ByVal formName As String) As Boolean
    'Exact physical-name boundary: no Trim/normalization is allowed before testing the canonical "ADC " prefix.
    Dim prefixText As String
    prefixText = DEFAULT_UTILITY_SHORT_NAME & " "
    If Len(formName) < Len(prefixText) Then Exit Function
    PhysicalFormIsDiscoveryCandidate = (StrComp(Left$(formName, Len(prefixText)), prefixText, vbTextCompare) = 0)
End Function

