' Purpose: Resolves canonical table field order text from the supplied/current ADC state, using `EditableLookupTableName` and `End` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   tableName (Input; String): Canonical or physical name identifying the table targeted by this operation.
' Returns: String: Returns the formatted text produced by this routine. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not
'   resolved.
Public Function CanonicalTableFieldOrderText(ByVal tableName As String) As String
    'Intended use: Returns the current live canonical physical field order without consulting the frozen initial audit snapshot.
    Dim canonicalText As String
    If EditableLookupTableName(tableName) Then
        CanonicalTableFieldOrderText = FIELD_VALUE_TEXT & "|" & FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER & "|" & FIELD_DESCRIPTION
        Exit Function
    End If
    canonicalText = SimpleLookupCanonicalFieldOrderText(tableName)
    If Len(canonicalText) > 0 Then CanonicalTableFieldOrderText = canonicalText: Exit Function
    canonicalText = CatalogTableFieldOrderText(tableName)
    If Len(canonicalText) > 0 Then CanonicalTableFieldOrderText = canonicalText: Exit Function
    canonicalText = FoundationOwnedTableFieldOrderText(tableName)
    If Len(canonicalText) > 0 Then CanonicalTableFieldOrderText = canonicalText: Exit Function
    Select Case tableName
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ActiveReferences")
            CanonicalTableFieldOrderText = ReferenceTableFieldOrderText(tableName)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_AvailableReferences")
            CanonicalTableFieldOrderText = ReferenceTableFieldOrderText(tableName)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Config")
            CanonicalTableFieldOrderText = ConfigFieldOrderText()
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Candidates")
            CanonicalTableFieldOrderText = CandidateFieldOrderText()
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HealthReview")
            CanonicalTableFieldOrderText = HealthReviewFieldOrderText()
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_LauncherControlsReview")
            CanonicalTableFieldOrderText = CustomMacroLauncherReviewFieldOrderText()
        Case "ListDBFormsForFieldDescriptionTool"
            CanonicalTableFieldOrderText = Replace(FIELD_ID & " | " & FIELD_FORM & " | " & FIELD_UPDATE_FIELD_DESCRIPTIONS, " | ", "|")
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ReferenceManager")
            CanonicalTableFieldOrderText = ReferenceTableFieldOrderText(tableName)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_SETTINGS_TABLE_LOGICAL_ID)
            CanonicalTableFieldOrderText = SettingsFieldOrderText()
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SetupActions")
            CanonicalTableFieldOrderText = Replace(FIELD_ID & " | " & FIELD_SETUP_ACTION_CODE & " | " & FIELD_SETUP_ACTION_NAME & " | " & FIELD_DESCRIPTION & " | " & FIELD_LOOKUP_ACTIVE & " | " & FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER & " | " & FIELD_MANAGED_OBJECT_DEPENDENCY_NOTES, " | ", "|")
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ModuleUpdateHistory")
            CanonicalTableFieldOrderText = ModuleUpdateHistoryFieldOrderText()
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ModuleVersionManifest")
            CanonicalTableFieldOrderText = ModuleVersionManifestFieldOrderText()
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ModuleVersionVerification")
            CanonicalTableFieldOrderText = ModuleVersionVerificationFieldOrderText()
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_VBEAddIns"), ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_AccessAddIns"), ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_COMAddIns")
            CanonicalTableFieldOrderText = ReferenceTableFieldOrderText(tableName)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_LoadedVBAProjectReferences")
            CanonicalTableFieldOrderText = ReferenceTableFieldOrderText(tableName)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_LoadedVBAModules")
            CanonicalTableFieldOrderText = ReferenceTableFieldOrderText(tableName)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_LoadedVBAProcedures")
            CanonicalTableFieldOrderText = ReferenceTableFieldOrderText(tableName)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_LoadedVBADependencies")
            CanonicalTableFieldOrderText = ReferenceTableFieldOrderText(tableName)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_LoadedVBAProjects")
            CanonicalTableFieldOrderText = ReferenceTableFieldOrderText(tableName)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ActiveReferenceProjectLinks")
            CanonicalTableFieldOrderText = ReferenceTableFieldOrderText(tableName)
    End Select
End Function

Private Function SimpleLookupCanonicalFieldOrderText(ByVal tableName As String) As String
    Dim definitions As Collection
    Dim rowData As Variant
    Set definitions = CatalogLookupDefinitions()
    For Each rowData In definitions
        If StrComp(CStr(rowData(0)), tableName, vbTextCompare) = 0 Then
            SimpleLookupCanonicalFieldOrderText = FIELD_ID & "|" & CStr(rowData(1)) & "|" & CStr(rowData(2)) & "|" & FIELD_DESCRIPTION & "|" & FIELD_LOOKUP_ACTIVE & "|" & FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER & "|" & FIELD_MANAGED_OBJECT_DEPENDENCY_NOTES
            Exit Function
        End If
    Next rowData
End Function

' Purpose: Resolves live target objects lookup row source from the supplied/current ADC state, using `In` and `End` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
' Returns: String: Returns the live target objects lookup row source text value. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not
'   resolved.
Public Function LiveTargetObjectsLookupRowSource() As String
    LiveTargetObjectsLookupRowSource = _
        "SELECT [Name] " & "AS " & SQL_FIELD_OBJECT_NAME & ", 'Form: ' & [Name] " & "AS " & SQL_FIELD_OBJECT_DISPLAY_NAME & " FROM [" & MSYS_OBJECTS_TABLE & "] WHERE [Type]=" & CStr(MSYS_OBJECT_TYPE_FORM) & " AND Left([Name],1)<>'~' " & _
        "UNION SELECT [Name] " & "AS " & SQL_FIELD_OBJECT_NAME & ", 'Table: ' & [Name] " & "AS " & SQL_FIELD_OBJECT_DISPLAY_NAME & " FROM [" & MSYS_OBJECTS_TABLE & "] WHERE [Type] In (" & CStr(MSYS_OBJECT_TYPE_LOCAL_TABLE) & "," & CStr(MSYS_OBJECT_TYPE_ODBC_TABLE) & "," & CStr(MSYS_OBJECT_TYPE_LINKED_TABLE) & ") AND Left([Name],1)<>'~' AND Left([Name],4)<>'MSys' " & _
        "UNION SELECT [Name] " & "AS " & SQL_FIELD_OBJECT_NAME & ", 'Query: ' & [Name] " & "AS " & SQL_FIELD_OBJECT_DISPLAY_NAME & " FROM [" & MSYS_OBJECTS_TABLE & "] WHERE [Type]=" & CStr(MSYS_OBJECT_TYPE_QUERY) & " AND Left([Name],1)<>'~' AND Left([Name],4)<>'MSys' " & _
        "UNION SELECT [Name] " & "AS " & SQL_FIELD_OBJECT_NAME & ", 'Report: ' & [Name] " & "AS " & SQL_FIELD_OBJECT_DISPLAY_NAME & " FROM [" & MSYS_OBJECTS_TABLE & "] WHERE [Type]=" & CStr(MSYS_OBJECT_TYPE_REPORT) & " AND Left([Name],1)<>'~' " & _
        "UNION SELECT [Name] " & "AS " & SQL_FIELD_OBJECT_NAME & ", 'Macro: ' & [Name] " & "AS " & SQL_FIELD_OBJECT_DISPLAY_NAME & " FROM [" & MSYS_OBJECTS_TABLE & "] WHERE [Type]=" & CStr(MSYS_OBJECT_TYPE_MACRO) & " AND Left([Name],1)<>'~' ORDER BY [ObjectDisplayName], [ObjectName];"
End Function

