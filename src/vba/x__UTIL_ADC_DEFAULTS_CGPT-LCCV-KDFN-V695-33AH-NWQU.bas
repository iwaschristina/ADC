' Purpose: Resolves and returns system ribbon group identity for placement from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   ribbonTabKey (Input; String): Canonical key identifying the ribbon tab definition, setting, or managed item to use.
'   ribbonGroupLabel (Input; String): Display or grouping label used as the ribbon group label for the UI, Ribbon, progress, or definition item being processed.
'   ribbonGroupSortOrder (Input; Long): Numeric sort position that determines the generated Ribbon group’s ordering relative to sibling groups.
'   groupDefinitions (Input Optional; Variant): Caller-supplied group definitions data used as the authoritative definition input for this call, avoiding an unnecessary reload when already available.
' Returns: String: Returns the resolved system ribbon group identity for placement text in the canonical representation consumed by this module's caller; vbNullString represents no applicable value where the
'   existing contract permits it.
Public Function SystemRibbonGroupIdentityForPlacement(ByVal ribbonTabKey As String, ByVal ribbonGroupLabel As String, ByVal ribbonGroupSortOrder As Long, Optional ByVal groupDefinitions As Variant) As String
    Dim definitions As Collection
    Dim Definition As Variant
    ribbonTabKey = Trim$(ribbonTabKey)
    ribbonGroupLabel = Trim$(ribbonGroupLabel)
    If isMissing(groupDefinitions) Then
        Set definitions = GetSystemRibbonGroupDefinitions()
    ElseIf IsObject(groupDefinitions) Then
        Set definitions = groupDefinitions
    End If
    If definitions Is Nothing Then Set definitions = GetSystemRibbonGroupDefinitions()
    For Each Definition In definitions
        If StrComp(Trim$(CStr(Definition(3))), ribbonTabKey, vbTextCompare) = 0 And StrComp(Trim$(CStr(Definition(1))), ribbonGroupLabel, vbTextCompare) = 0 And CLng(Definition(2)) = ribbonGroupSortOrder Then
            SystemRibbonGroupIdentityForPlacement = CStr(Definition(0))
            Exit Function
        End If
    Next Definition
End Function

' Purpose: Performs system ribbon placement for key as the module's public orchestration step using the established ADC state and validation contract.
