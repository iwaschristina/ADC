End Sub

' Purpose: Resolves table field lookup value list from the supplied/current ADC state, using `ManagedObjectPhysicalName` and `End` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   tableName (Input; String): Canonical or physical name identifying the table targeted by this operation.
'   fieldName (Input; String): Canonical or physical name identifying the field targeted by this operation.
' Returns: String: Returns the table field lookup value list text value. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not
'   resolved.
Public Function TableFieldLookupValueList(ByVal tableName As String, ByVal fieldName As String) As String
    Dim tableKey As String
    Dim fieldKey As String
    tableKey = UCase$(tableName)
    fieldKey = LCase$(Trim$(fieldName))
    Select Case tableKey
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_TERMINOLOGY_TABLE_LOGICAL_ID))
            Select Case fieldKey
                Case LCase$(FIELD_TERM_STATUS): TableFieldLookupValueList = "Approved;Conditional;Banned;Retired;Deferred"
                Case LCase$(FIELD_TERM_CATEGORY): TableFieldLookupValueList = "DatabaseRole;WorkflowRole;WorkflowVerb;RowStatusVerb;ObjectOwnership;SchemaField;ObjectName;DeprecatedTerm;DocumentationLanguage;NamingRule"
                Case LCase$(FIELD_DECISION_SCOPE): TableFieldLookupValueList = "NamingCleanup;TerminologyReference;SchemaDecision;RoutingDecision;AddInHardening"
                Case LCase$(FIELD_DECISION_STATUS): TableFieldLookupValueList = "Approved;NeedsDecision;Deferred;Retired"
            End Select
            Select Case fieldKey
                Case LCase$(FIELD_OBJECT_TYPE): TableFieldLookupValueList = ADCAT_OBJECT_TYPE_TABLE & ";" & ADCAT_OBJECT_TYPE_QUERY
            End Select
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros"))
            If fieldKey = LCase$(FIELD_SYSTEM_MACRO_GROUP_KEY) Then TableFieldLookupValueList = DefinitionCodeValueList(SystemMacroNavigationPaneGroupDefinitions())
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_TraceLog"))
            If fieldKey = LCase$(FIELD_TRACE_LEVEL) Then TableFieldLookupValueList = TRACE_LEVEL_DETAIL & ";" & TRACE_LEVEL_INFO & ";" & TRACE_LEVEL_WARNING & ";" & TRACE_LEVEL_ERROR & ";" & TRACE_LEVEL_STATUS
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID)), UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_RibbonButtonTargets"))
            If fieldKey = LCase$(FIELD_OBJECT_NAMING_CATEGORY) Then TableFieldLookupValueList = NAMING_CATEGORY_TABLE & ";" & NAMING_CATEGORY_QUERY & ";" & NAMING_CATEGORY_REPORT & ";" & NAMING_CATEGORY_GENERATED_FORM & ";" & NAMING_CATEGORY_GENERATED_MACRO & ";" & NAMING_CATEGORY_SYSTEM_MACRO & ";" & NAMING_CATEGORY_CUSTOM_FORM
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_NavigationPaneGroups"))
            If fieldKey = LCase$(FIELD_SETTING_KEY) Then
                TableFieldLookupValueList = NavigationPaneGroupSettingKeyValueList()
            Else
                TableFieldLookupValueList = ValueListForField(fieldName)
            End If
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_SETTINGS_TABLE_LOGICAL_ID)), UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Config")), UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Candidates")), UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HealthReview")), UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_LauncherControlsReview"))
            TableFieldLookupValueList = ValueListForField(fieldName)
    End Select
End Function

' Purpose: Resolves sortable field order expression from the supplied/current ADC state, using `StrComp` and `SharedDao_BracketName` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   sourceName (Input; String): Canonical or physical name identifying the source targeted by this operation.
'   fieldName (Input; String): Canonical or physical name identifying the field targeted by this operation.
' Returns: String: Returns the sortable field order expression text value. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not
'   resolved.
Public Function SortableFieldOrderExpression(ByVal sourceName As String, ByVal fieldName As String) As String
    sourceName = Trim$(sourceName)
    fieldName = Trim$(fieldName)
    If Len(fieldName) = 0 Then Err.Raise vbObjectError + 7850, "SortableFieldOrderExpression", "A sortable field expression cannot be built for a blank field name."
    If StrComp(sourceName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_FormDefinitions"), vbTextCompare) = 0 And _
       StrComp(fieldName, FIELD_FORM_DISPLAY_NAME_CALC, vbTextCompare) = 0 Then
        SortableFieldOrderExpression = "Left(" & SharedDao_BracketName(fieldName) & ",255)"
    Else
        SortableFieldOrderExpression = SharedDao_BracketName(fieldName)
    End If
End Function

' Purpose: Resolves and returns table lookup row source from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   lookupTableName (Input; String): Physical Access lookup-table name whose rows/fields supply the lookup definition or validation target.
'   codeFieldName (Input; String): Field name containing the stored lookup code/key value used as the bound value for the generated lookup editor.
'   displayFieldName (Input; String): Field name containing the user-facing lookup text shown by the generated lookup editor/list.
'   hasLookupActive (Input; Boolean): Indicates whether the caller/source already has lookup active; True tells the routine to treat that prerequisite/value as present, while False tells it to handle the absent
'   case.
'   requireNonblankSettingKey (Input; Boolean): True requires nonblank setting key before the operation may proceed; False allows the operation to continue without making that condition mandatory.
'   hasSortOrder (Input; Boolean): Indicates whether the caller/source already has sort order; True tells the routine to treat that prerequisite/value as present, while False tells it to handle the absent case.
'   externalDatabasePath (Input Optional; String): Filesystem or database path identifying the external database path location used by the operation. Default: vbNullString.
' Returns: String: Returns the resolved table lookup row source text in the canonical representation consumed by this module's caller; vbNullString represents no applicable value where the existing contract
'   permits it.
Public Function TableLookupRowSource(ByVal lookupTableName As String, ByVal codeFieldName As String, ByVal displayFieldName As String, ByVal hasLookupActive As Boolean, ByVal requireNonblankSettingKey As Boolean, ByVal hasSortOrder As Boolean, Optional ByVal externalDatabasePath As String = vbNullString) As String
    Dim resultText As String
    Dim whereText As String
    Dim displayOrderExpression As String
    resultText = "SELECT [" & codeFieldName & "], [" & displayFieldName & "] FROM [" & lookupTableName & "]"
    externalDatabasePath = Trim$(externalDatabasePath)
    If Len(externalDatabasePath) > 0 Then resultText = resultText & " IN '" & Replace(externalDatabasePath, "'", "''") & "'"
    If hasLookupActive Then whereText = " WHERE (" & SQL_FIELD_LOOKUP_ACTIVE & "<>False OR " & SQL_FIELD_LOOKUP_ACTIVE & " Is Null)"
    If requireNonblankSettingKey Then
        If Len(whereText) = 0 Then
            whereText = " WHERE Len(Nz([" & FIELD_SETTING_KEY & "],''))>0"
        Else
            whereText = whereText & " AND Len(Nz([" & FIELD_SETTING_KEY & "],''))>0"
        End If
    End If
    displayOrderExpression = SortableFieldOrderExpression(lookupTableName, displayFieldName)
    If hasSortOrder Then
        resultText = resultText & whereText & " ORDER BY " & SQL_FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER & ", " & displayOrderExpression & ";"
    Else
        resultText = resultText & whereText & " ORDER BY " & displayOrderExpression & ";"
    End If
    TableLookupRowSource = resultText
End Function

