' Purpose: Performs lookup editor code field locked by coordinating `LookupEditorGeneratedFormDefinition` and `IsArray` while preserving this module's existing validation and error semantics.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   formName (Input; String): Physical Access form name identifying the form to create, open, configure, validate, or inspect.
'   fieldName (Input; String): Field name identifying the table/query field or bound control source the routine evaluates or modifies.
' Returns: Boolean: True when the lookup editor code field locked condition is satisfied for the supplied or current ADC context; False otherwise.
Public Function LookupEditorCodeFieldLocked(ByVal formName As String, ByVal fieldName As String) As Boolean
    Dim definitionData As Variant
    definitionData = LookupEditorGeneratedFormDefinition(formName)
    If IsArray(definitionData) = False Then Exit Function
    If CBool(definitionData(LOOKUP_EDITOR_DEF_ALLOW_CODE_EDIT)) Then Exit Function
    LookupEditorCodeFieldLocked = (StrComp(Trim$(fieldName), CStr(definitionData(LOOKUP_EDITOR_DEF_CODE_FIELD)), vbTextCompare) = 0)
End Function

