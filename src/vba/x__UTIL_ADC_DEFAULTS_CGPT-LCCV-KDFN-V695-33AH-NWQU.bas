Private Function ConvertedValueLookupSeedDefinitions(ByVal sourceKind As String) As Collection
    Dim r As New Collection, s As String, v As Variant
    Select Case LCase$(sourceKind)
        Case "settingdatatype_lookup": s = ValueListForField(FIELD_MANAGED_OBJECT_FIELD_DATA_TYPE)
        Case "settinggroup_lookup": s = ValueListForField(FIELD_SETTING_GROUP)
        Case "targetprocedurekind_lookup": s = ValueListForField(FIELD_TARGET_PROCEDURE_KIND)
        Case "resulthandling_lookup": s = ValueListForField(FIELD_RESULT_HANDLING)
        Case "expectedreturntype_lookup": s = ValueListForField(FIELD_EXPECTED_RETURN_TYPE)
        Case "confirmationmode_lookup": s = ValueListForField(FIELD_CONFIRMATION_MODE)
        Case "entrypointmatchconfidence_lookup": s = ValueListForField(FIELD_ENTRY_POINT_MATCH_CONFIDENCE)
        Case "termcategory_lookup": s = "DatabaseRole;WorkflowRole;WorkflowVerb;RowStatusVerb;ObjectOwnership;SchemaField;ObjectName;DeprecatedTerm;DocumentationLanguage;NamingRule"
        Case "termstatus_lookup": s = "Approved;Conditional;Banned;Retired;Deferred"
        Case "decisionscope_lookup": s = "NamingCleanup;TerminologyReference;SchemaDecision;RoutingDecision;AddInHardening"
        Case "decisionstatus_lookup": s = "Approved;NeedsDecision;Deferred;Retired"
        Case "launcherissuetype_lookup": s = ValueListForField(FIELD_ISSUE_TYPE)
        Case "systemmacrogroup_lookup": s = DefinitionCodeValueList(SystemMacroNavigationPaneGroupDefinitions())
        Case "tracelevel_lookup": s = "Detail;Info;Warning;Error;Status"
        Case "objectnamingcategory_lookup": s = "Table;Query;Report;GeneratedForm;GeneratedMacro;SystemMacro;CustomForm"
        Case "navigationpanegrouppurpose_lookup": s = NavigationPaneGroupPurposeValueList()
        Case "vbacomponenttype_lookup": s = ModuleGuardLookupValueList(vbNullString, FIELD_COMPONENT_TYPE)
        Case "moduleupdaterecordedby_lookup": s = ModuleGuardLookupValueList(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ModuleUpdateHistory"), FIELD_RECORDED_BY)
        Case "moduleverificationresult_lookup": s = ModuleGuardLookupValueList(vbNullString, FIELD_VERIFICATION_RESULT)
        Case "lookupeditormode_lookup": s = "Editable;ReadOnly"
    End Select
    For Each v In Split(s, ";"): If Len(Trim$(CStr(v))) > 0 Then r.Add Array(Trim$(CStr(v)), vbNullString)
    Next v
    Set ConvertedValueLookupSeedDefinitions = r
End Function

' Purpose: Resolves editable lookup table definitions for setup from the supplied/current ADC state, using `IsObject` and `EditableLookupTableDefinitions` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   suppliedDefinitions (Input Optional; Variant): Variant input representing supplied definitions; the routine accepts the caller-provided value in the form required by its existing validation and
'   conversion logic.
' Returns: Collection: Returns the ordered Collection assembled by the routine; callers receive the object reference and should treat its membership/order according to the routine contract.
Public Function EditableLookupTableDefinitionsForSetup(Optional ByVal suppliedDefinitions As Variant) As Collection
    ' Projection of the authoritative editable lookup-table definitions in first-creation/verification order.
    Dim rows As New Collection
    Dim definitions As Collection
    Dim rowData As Variant
    Dim setupOrder As Long
    Dim minimumSetupOrder As Long
    Dim maximumSetupOrder As Long
    Dim hasSetupOrder As Boolean
    If IsObject(suppliedDefinitions) Then Set definitions = suppliedDefinitions
    If definitions Is Nothing Then Set definitions = EditableLookupTableDefinitions()
    For Each rowData In definitions
        setupOrder = CLng(rowData(2))
        If hasSetupOrder = False Then
            minimumSetupOrder = setupOrder
            maximumSetupOrder = setupOrder
            hasSetupOrder = True
        ElseIf setupOrder < minimumSetupOrder Then
            minimumSetupOrder = setupOrder
        ElseIf setupOrder > maximumSetupOrder Then
            maximumSetupOrder = setupOrder
        End If
    Next rowData
    If hasSetupOrder Then
        For setupOrder = minimumSetupOrder To maximumSetupOrder
            For Each rowData In definitions
                If CLng(rowData(2)) = setupOrder Then
                    rows.Add rowData
                    Exit For
                End If
            Next rowData
        Next setupOrder
    End If
    If rows.count <> definitions.count Or (hasSetupOrder And maximumSetupOrder - minimumSetupOrder + 1 <> definitions.count) Then Err.Raise vbObjectError + 7721, "EditableLookupTableDefinitionsForSetup", "The authoritative editable lookup-table definitions do not contain one unique Setup order for every table. Expected " & CStr(definitions.count) & " rows but resolved " & CStr(rows.count) & "."
    Set EditableLookupTableDefinitionsForSetup = rows
End Function

