' Purpose: Resolves module guard action payload definitions from the supplied/current ADC state, using `isMissing` and `IsObject` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   suppliedDefinitions (Input Optional; Variant): Variant input representing supplied definitions; the routine accepts the caller-provided value in the form required by its existing validation and
'   conversion logic.
' Returns: Collection: Returns the ordered Collection assembled by the routine; callers receive the object reference and should treat its membership/order according to the routine contract.
Public Function ModuleGuardActionPayloadDefinitions(Optional ByVal suppliedDefinitions As Variant) As Collection
    'Payload membership and sort order are derived from ModuleGuardManagedObjectDefinitions; payload-specific behavior is added here.
    ' INTENTIONAL SEPARATE CANONICAL PROJECTION: rows derives Module Guard action-payload rows from canonical managed-object definitions while adding payload behavior; managed-object membership remains upstream
    ' authority.
    Dim rows As New Collection
    Dim definitions As Collection
    Dim Definition As Variant
    If isMissing(suppliedDefinitions) = False Then
        If IsObject(suppliedDefinitions) Then Set definitions = suppliedDefinitions
    End If
    If definitions Is Nothing Then Set definitions = ModuleGuardManagedObjectDefinitions()
    For Each Definition In definitions
        If StrComp(CStr(Definition(2)), ADCAT_OBJECT_TYPE_QUERY, vbTextCompare) = 0 Then
            rows.Add Array(CStr(Definition(0)), ADCAT_PAYLOAD_QUERY_SQL_BUILDER, "RepairModuleUpdateGuard", vbNullString, "Creates or repairs this canonical Module Guard query. " & CStr(Definition(3)), "1.0", CLng(Definition(4)))
        End If
    Next Definition
    Set ModuleGuardActionPayloadDefinitions = rows
End Function

