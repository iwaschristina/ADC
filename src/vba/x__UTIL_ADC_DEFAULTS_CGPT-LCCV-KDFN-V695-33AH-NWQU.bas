' Purpose: Resolves and returns foundation table field description from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Public ADC API. The routine is intentionally callable outside its defining procedure/module and may be used directly by Access/VBA or late-bound callers when that API surface is needed.
' Parameters:
'   tableName (Input; String): Physical Access table name identifying the table whose schema, data, or metadata the routine processes.
'   fieldName (Input; String): Field name identifying the table/query field or bound control source the routine evaluates or modifies.
' Returns: String: Returns the canonical description text for foundation table field description, suitable for the managed catalog/field/object metadata destination; vbNullString indicates that no description
'   applies where allowed.
Public Function FoundationTableFieldDescription(ByVal tableName As String, ByVal fieldName As String) As String
    If EditableLookupTableName(tableName) Then
        FoundationTableFieldDescription = EditableLookupTableFieldDescription(fieldName)
        Exit Function
    End If
    Select Case tableName
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Config"), ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Candidates")
            FoundationTableFieldDescription = ConfigFieldDescription(fieldName)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_SETTINGS_TABLE_LOGICAL_ID)
            FoundationTableFieldDescription = SettingsFieldDescription(fieldName)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HealthReview")
            FoundationTableFieldDescription = HealthReviewFieldDescription(fieldName)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_LauncherControlsReview")
            FoundationTableFieldDescription = CustomMacroLauncherReviewFieldDescription(fieldName)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_TERMINOLOGY_TABLE_LOGICAL_ID)
            FoundationTableFieldDescription = TerminologyFieldDescription(fieldName)
        Case ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_LookupDefinitions")
            FoundationTableFieldDescription = LookupDefinitionRegistryFieldDescription(fieldName)
    End Select
End Function

Private Function FoundationTableFieldDescriptionShort(ByVal tableName As String, ByVal fieldName As String) As String
