' Purpose: Resolves ribbon default group label from the supplied/current ADC state, using `RibbonVisibleSeparatorDefault` and `End` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   groupLabel (Input; String): Input group label used by this procedure to perform ribbon default group label; validation and accepted values are enforced by this routine before dependent work proceeds.
' Returns: String: Returns the formatted text produced by this routine. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not
'   resolved.
Public Function RibbonDefaultGroupLabel(ByVal groupLabel As String) As String
    'Canonical Ribbon group-label normalization policy for DEFAULTS and Ribbon-generation consumers.
    groupLabel = Trim$(groupLabel)
    If Len(groupLabel) > 0 Then groupLabel = RibbonRemoveDefaultGroupPrefix(groupLabel)
    groupLabel = Replace(groupLabel, "_", " ")
    groupLabel = RibbonVisibleSeparatorDefault(groupLabel)
    If Len(groupLabel) = 0 Then groupLabel = DEFAULT_RIBBON_GROUP_LABEL
    RibbonDefaultGroupLabel = groupLabel
End Function

Private Function RibbonRemoveDefaultGroupPrefix(ByVal groupLabel As String) As String
    'Intended use: Single Navigation Pane-to-Ribbon group-prefix normalization policy for DEFAULTS and UI consumers.
    If NavigationPaneGroupUsesConfiguredAffixes(groupLabel, True) Then
        RibbonRemoveDefaultGroupPrefix = Trim$(NavigationPaneLogicalGroupName(groupLabel, True))
    ElseIf NavigationPaneGroupUsesConfiguredAffixes(groupLabel, False) Then
        RibbonRemoveDefaultGroupPrefix = Trim$(NavigationPaneLogicalGroupName(groupLabel, False))
    Else
        groupLabel = Trim$(groupLabel)
        If StrComp(Left$(groupLabel, Len(DEFAULT_UTILITY_LONG_NAME & " -")), DEFAULT_UTILITY_LONG_NAME & " -", vbTextCompare) = 0 Then
            RibbonRemoveDefaultGroupPrefix = Trim$(Mid$(groupLabel, Len(DEFAULT_UTILITY_LONG_NAME & " -") + 1))
        Else
            RibbonRemoveDefaultGroupPrefix = groupLabel
        End If
    End If
End Function

