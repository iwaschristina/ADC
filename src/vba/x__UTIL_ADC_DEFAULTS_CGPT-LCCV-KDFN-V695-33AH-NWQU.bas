' Purpose: Resolves system ribbon group definition index from the supplied/current ADC state, using `isMissing` and `GetSystemRibbonGroupDefinitions` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   groupDefinitions (Input Optional; Variant): Variant input representing group definitions; the routine accepts the caller-provided value in the form required by its existing validation and conversion
'   logic.
' Returns: Object: Returns the resolved object reference. `Nothing` remains the no-object result where the existing routine permits an unresolved or unavailable object.
Public Function SystemRibbonGroupDefinitionIndex(Optional ByVal groupDefinitions As Variant) As Object
    Dim indexByIdentity As Object
    Dim definitions As Collection
    Dim Definition As Variant
    Dim groupIdentity As String
    If isMissing(groupDefinitions) Then
        Set definitions = GetSystemRibbonGroupDefinitions()
    ElseIf IsObject(groupDefinitions) Then
        Set definitions = groupDefinitions
    Else
        Err.Raise vbObjectError + 6874, "SystemRibbonGroupDefinitionIndex", "The supplied System Ribbon group definitions are not an object."
    End If
    If definitions Is Nothing Then Set definitions = GetSystemRibbonGroupDefinitions()
    ' INTENTIONAL KEYED LOOKUP: indexByIdentity provides keyed membership/lookup over source rows or state already read by SystemRibbonGroupDefinitionIndex; it is a derived access path, not a second authority.
    Set indexByIdentity = CreateObject("Scripting.Dictionary")
    indexByIdentity.CompareMode = vbTextCompare
    For Each Definition In definitions
        groupIdentity = Trim$(CStr(Definition(0)))
        If Len(groupIdentity) = 0 Then Err.Raise vbObjectError + 6872, "SystemRibbonGroupDefinitionIndex", "A canonical System Ribbon group definition has a blank identity."
        If indexByIdentity.Exists(groupIdentity) Then Err.Raise vbObjectError + 6873, "SystemRibbonGroupDefinitionIndex", "The canonical System Ribbon group definitions contain a duplicate identity." & vbCrLf & "RibbonGroupIdentity: " & groupIdentity
        indexByIdentity.Add groupIdentity, Definition
    Next Definition
    Set SystemRibbonGroupDefinitionIndex = indexByIdentity
End Function

Private Function SystemRibbonGroupDefinitionByIdentity(ByVal groupIdentity As String, Optional ByVal groupDefinitionIndex As Variant) As Variant
    Dim indexByIdentity As Object
    groupIdentity = Trim$(groupIdentity)
    If isMissing(groupDefinitionIndex) Then
        Set indexByIdentity = SystemRibbonGroupDefinitionIndex()
    ElseIf IsObject(groupDefinitionIndex) Then
        Set indexByIdentity = groupDefinitionIndex
    Else
        Err.Raise vbObjectError + 6874, "SystemRibbonGroupDefinitionByIdentity", "The supplied System Ribbon group-definition index is not an object."
    End If
    If indexByIdentity Is Nothing Then Exit Function
    If indexByIdentity.Exists(groupIdentity) Then SystemRibbonGroupDefinitionByIdentity = indexByIdentity(groupIdentity)
End Function

