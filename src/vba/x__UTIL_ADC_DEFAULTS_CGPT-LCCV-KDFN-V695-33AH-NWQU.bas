' Purpose: Resolves category managed object description from the supplied/current ADC state, using `ReadableDisplayName` and `End` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   objectName (Input; String): Canonical or physical name identifying the object targeted by this operation.
'   categoryCode (Input; String): Canonical code used to classify or select the category code behavior.
'   objectTypeCode (Input; String): Canonical code used to classify or select the object type code behavior.
' Returns: String: Returns the description text produced by this routine. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not
'   resolved.
Public Function CategoryManagedObjectDescription(ByVal objectName As String, ByVal categoryCode As String, ByVal objectTypeCode As String) As String
    Dim readableName As String
    readableName = ReadableDisplayName(objectName)
    If Len(readableName) = 0 Then readableName = objectName
    Select Case UCase$(Trim$(categoryCode))
        Case UCase$(ADCAT_CATEGORY_REVIEW_QUERY)
            CategoryManagedObjectDescription = readableName & " is a generated review query that presents workflow-specific catalog, configuration, validation, generation, or cleanup records in a stable form/query source. " & DEFAULT_UTILITY_LONG_NAME & " setup repairs its SQL, verifies its expected fields, and places it in the configured review group."
        Case UCase$(ADCAT_CATEGORY_FORM_QUERY)
            CategoryManagedObjectDescription = readableName & " is a generated form-design or form-source query used to derive fields, rules, groups, tabs, or control layout for " & DEFAULT_UTILITY_LONG_NAME & " utility forms. Setup repairs the query before form generation and validates it as part of the managed form foundation."
        Case UCase$(ADCAT_CATEGORY_CATALOG_TABLE)
            CategoryManagedObjectDescription = readableName & " is a CodeDb-owned " & DEFAULT_UTILITY_LONG_NAME & " catalog or lookup table. It stores controlled metadata used by setup, validation, generated forms, managed-object review, Navigation Pane placement, or ribbon generation rather than HostDb runtime business data."
        Case UCase$(ADCAT_CATEGORY_RUNTIME_TABLE)
            CategoryManagedObjectDescription = readableName & " is a " & DEFAULT_UTILITY_LONG_NAME & " runtime support table used by active configuration, candidate, validation, generation, or review workflows. Table repair validates its schema and preserves user-editable runtime values."
        Case UCase$(ADCAT_CATEGORY_REVIEW_TABLE)
            CategoryManagedObjectDescription = readableName & " is a non-destructive " & DEFAULT_UTILITY_LONG_NAME & " review-output table. Review workflows write structured findings here so issues can be inspected, filtered, and resolved before cleanup or repair actions are run."
        Case UCase$(ADCAT_CATEGORY_MANAGED_QUERY)
            CategoryManagedObjectDescription = readableName & " is a utility-managed query used by " & DEFAULT_UTILITY_LONG_NAME & " setup, validation, catalog review, generated forms, Navigation Pane management, or ribbon generation. Its SQL and expected fields are repaired and verified by the CodeDb utility."
        Case UCase$(ADCAT_CATEGORY_MANAGED_TABLE)
            CategoryManagedObjectDescription = readableName & " is a utility-managed CodeDb support table. " & DEFAULT_UTILITY_LONG_NAME & " setup validates its schema, indexes, lookup metadata, descriptions, and catalog placement while preserving supported user-maintained values."
        Case UCase$(ADCAT_CATEGORY_MANAGED_FORM)
            CategoryManagedObjectDescription = readableName & " is a managed " & DEFAULT_UTILITY_LONG_NAME & " utility form. The catalog records its authoritative form identity, generated/user-managed status, Navigation Pane placement, ribbon placement, and description metadata for setup verification."
        Case UCase$(ADCAT_CATEGORY_MANAGED_REPORT)
            CategoryManagedObjectDescription = readableName & " is a managed " & DEFAULT_UTILITY_LONG_NAME & " report used to present catalog, validation, generation, or diagnostic information. Setup tracks its existence, type, placement, and description metadata without treating it as a generated macro target."
        Case UCase$(ADCAT_CATEGORY_SYSTEM_MACRO)
            CategoryManagedObjectDescription = readableName & " is a built-in " & DEFAULT_UTILITY_LONG_NAME & " system shortcut macro generated from the MC_Sys catalog. It routes a table-driven command to RunSystemCommand and is refreshed, described, and grouped during CodeDb setup."
        Case Else
            Select Case UCase$(Trim$(objectTypeCode))
                Case UCase$(ADCAT_OBJECT_TYPE_QUERY)
                    CategoryManagedObjectDescription = readableName & " is a managed " & DEFAULT_UTILITY_LONG_NAME & " query used by setup, review, validation, generation, or generated-form workflows."
                Case UCase$(ADCAT_OBJECT_TYPE_TABLE)
                    CategoryManagedObjectDescription = readableName & " is a managed " & DEFAULT_UTILITY_LONG_NAME & " table whose schema and metadata are validated by CodeDb setup."
                Case UCase$(ADCAT_OBJECT_TYPE_FORM)
                    CategoryManagedObjectDescription = readableName & " is a managed " & DEFAULT_UTILITY_LONG_NAME & " form tracked for row-source validity, generated-form ownership, Navigation Pane placement, and ribbon placement."
                Case UCase$(ADCAT_OBJECT_TYPE_MACRO)
                    CategoryManagedObjectDescription = readableName & " is a managed Access macro tracked for command routing, generation status, Navigation Pane placement, and descriptive metadata."
                Case UCase$(ADCAT_OBJECT_TYPE_REPORT)
                    CategoryManagedObjectDescription = readableName & " is a managed " & DEFAULT_UTILITY_LONG_NAME & " report tracked for existence, type, placement, and descriptive metadata."
            End Select
    End Select
End Function

' Purpose: Resolves managed object placement scope from the supplied/current ADC state, using `TryGetManagedObjectDefinition` and `End` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   objectName (Input; String): Canonical or physical name identifying the object targeted by this operation.
'   objectTypeCode (Input; String): Canonical code used to classify or select the object type code behavior.
' Returns: String: Returns the managed object placement scope text value. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not
'   resolved.
Public Function ManagedObjectPlacementScope(ByVal objectName As String, ByVal objectTypeCode As String) As String
    'Returns only the explicit scope stored in the canonical managed-object definition. Missing definitions are errors, never type-based placement fallbacks.
    Dim definitionData As Variant
    objectTypeCode = Trim$(objectTypeCode)
    If TryGetManagedObjectDefinition(objectName, objectTypeCode, definitionData) = False Then Err.Raise vbObjectError + 6883, "ManagedObjectPlacementScope", "The canonical managed-object registry does not contain the requested placement identity." & vbCrLf & "ObjectName: " & objectName & vbCrLf & "ObjectType: " & objectTypeCode
    ManagedObjectPlacementScope = CStr(definitionData(MANAGED_DEF_PLACEMENT_SCOPE))
    If Len(ManagedObjectPlacementScope) = 0 Then Err.Raise vbObjectError + 6884, "ManagedObjectPlacementScope", "The canonical managed-object definition has a blank Navigation Pane placement scope." & vbCrLf & "ObjectName: " & objectName & vbCrLf & "ObjectType: " & objectTypeCode
End Function

' Purpose: Performs managed object placement ribbon by coordinating `TryGetManagedObjectDefinition` and `GetRibbonTabLabelDefault` while preserving this module's existing validation and error semantics.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   objectName (Input; String): Physical Access object name identifying the database object targeted by the operation.
'   objectTypeCode (Input; String): Access object-type code identifying the class of database object targeted by the operation.
'   ribbonTabKey (Output; String): Receives the ribbon tab key returned by `CStr` after this procedure completes its validation/resolution work.
'   ribbonTabLabel (Output; String): Receives the ribbon tab label returned by `GetRibbonTabLabelDefault` after this procedure completes its validation/resolution work.
'   ribbonGroupLabel (Output; String): Receives the ribbon group label returned by `RibbonManagedGroupLabel` after this procedure completes its validation/resolution work.
'   ribbonGroupSortOrder (Output; Long): Receives the ribbon group sort order returned by `RibbonManagedGroupSortOrder` after this procedure completes its validation/resolution work.
' Returns: Boolean: True when the condition represented by ManagedObjectPlacementRibbon is present under the routine's documented inputs/current state; False when that condition is absent.
Public Function ManagedObjectPlacementRibbon(ByVal objectName As String, ByVal objectTypeCode As String, ByRef ribbonTabKey As String, ByRef ribbonTabLabel As String, ByRef ribbonGroupLabel As String, ByRef ribbonGroupSortOrder As Long) As Boolean
    Dim definitionData As Variant
    Dim ribbonGroupKey As String
    ribbonTabKey = vbNullString
    ribbonTabLabel = vbNullString
    ribbonGroupLabel = vbNullString
    ribbonGroupSortOrder = 0
    If TryGetManagedObjectDefinition(objectName, objectTypeCode, definitionData) = False Then Exit Function
    ribbonTabKey = CStr(definitionData(MANAGED_DEF_RIBBON_TAB_KEY))
    ribbonGroupKey = CStr(definitionData(MANAGED_DEF_RIBBON_GROUP_KEY))
    If Len(ribbonTabKey) = 0 Or Len(ribbonGroupKey) = 0 Then Exit Function
    ribbonTabLabel = GetRibbonTabLabelDefault(ribbonTabKey)
    ribbonGroupLabel = RibbonManagedGroupLabel(ribbonGroupKey)
    ribbonGroupSortOrder = RibbonManagedGroupSortOrder(ribbonGroupKey)
    ManagedObjectPlacementRibbon = (Len(ribbonTabLabel) > 0 And Len(ribbonGroupLabel) > 0 And ribbonGroupSortOrder > 0)
End Function

