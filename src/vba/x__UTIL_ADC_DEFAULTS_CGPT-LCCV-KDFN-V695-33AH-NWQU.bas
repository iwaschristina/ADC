Private Function NavigationPaneGroupPurposeValueList() As String
    'Derives legal GroupPurpose choices from the same NavigationPaneGroupDefinitions rows that setup inserts.
    Dim seen As Object
    Dim rowData As Variant
    Dim purposeText As String
    Dim valueListText As String
    ' INTENTIONAL KEYED LOOKUP: seen provides keyed membership/lookup over source rows or state already read by NavigationPaneGroupPurposeValueList; it is a derived access path, not a second authority.
    Set seen = CreateObject("Scripting.Dictionary")
    seen.CompareMode = vbTextCompare
    For Each rowData In NavigationPaneGroupDefinitions()
        purposeText = Trim$(CStr(rowData(6)))
        If Len(purposeText) > 0 And seen.Exists(purposeText) = False Then
            seen.Add purposeText, True
            If Len(valueListText) > 0 Then valueListText = valueListText & ";"
            valueListText = valueListText & purposeText
        End If
    Next rowData
    NavigationPaneGroupPurposeValueList = valueListText
End Function

' Purpose: Resolves and returns managed object optional missing reason from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   expectedExistencePolicy (Input; String): Expected-existence policy token describing whether the managed object must exist, may be absent, or follows the module’s defined conditional policy.
'   setupAction (Input; String): Action value selecting the setup behavior the routine validates, dispatches, or persists.
' Returns: String: Returns the resolved managed object optional missing reason text in the canonical representation consumed by this module's caller; vbNullString represents no applicable value where the
'   existing contract permits it.
Public Function ManagedObjectOptionalMissingReason(ByVal expectedExistencePolicy As String, ByVal setupAction As String) As String
    'Intended use: Resolves the single authoritative reason that a managed object may legitimately be absent.
    If StrComp(Trim$(expectedExistencePolicy), ADCAT_EXPECT_MAY_EXIST, vbTextCompare) = 0 Then
        ManagedObjectOptionalMissingReason = "ExpectedExistencePolicy=MayExist"
    ElseIf StrComp(Trim$(setupAction), ADCAT_SETUP_GROUP_EXISTING, vbTextCompare) = 0 Then
        ManagedObjectOptionalMissingReason = "SetupAction=GroupExisting"
    ElseIf StrComp(Trim$(setupAction), ADCAT_SETUP_REFERENCE_ONLY, vbTextCompare) = 0 Then
        ManagedObjectOptionalMissingReason = "SetupAction=ReferenceOnly"
    End If
End Function

' Purpose: Performs managed object may be missing by coordinating `End` while preserving this module's existing validation and error semantics.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   expectedExistencePolicy (Input; String): Expected-existence policy token describing whether the managed object must exist, may be absent, or follows the module’s defined conditional policy.
'   setupAction (Input; String): Action value selecting the setup behavior the routine validates, dispatches, or persists.
' Returns: Boolean: True when the managed object may be missing condition is satisfied for the supplied or current ADC context; False otherwise.
Public Function ManagedObjectMayBeMissing(ByVal expectedExistencePolicy As String, ByVal setupAction As String) As Boolean
    'Intended use: Returns True when the authoritative managed-object policy permits the object to be absent.
    ManagedObjectMayBeMissing = (Len(ManagedObjectOptionalMissingReason(expectedExistencePolicy, setupAction)) > 0)
End Function

