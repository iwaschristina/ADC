' Purpose: Resolves managed object catalog field description long from the supplied/current ADC state, using `isMissing` and `LogicalObjectNameFromPhysicalName` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   tableName (Input; String): Canonical or physical name identifying the table targeted by this operation.
'   fieldName (Input; String): Canonical or physical name identifying the field targeted by this operation.
'   resolutionSource (Output Optional; Variant): When supplied, receives the authoritative resolver/function name that produced the returned long field Description, or vbNullString when no Description is
'     resolved.
' Returns: String: Returns the description text produced by this routine. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not
'   resolved.
Public Function ManagedObjectCatalogFieldDescriptionLong(ByVal tableName As String, ByVal fieldName As String, Optional ByRef resolutionSource As Variant) As String
    Dim tableKey As String
    Dim fieldKey As String
    Dim lookupPurpose As String
    Dim resolvedSource As String
    If Not isMissing(resolutionSource) Then resolutionSource = vbNullString
    tableKey = LCase$(LogicalObjectNameFromPhysicalName(NAMING_CATEGORY_TABLE, tableName))
    fieldKey = LCase$(Trim$(fieldName))
    ManagedObjectCatalogFieldDescriptionLong = FoundationTableFieldDescription(tableName, fieldName)
    If Len(ManagedObjectCatalogFieldDescriptionLong) > 0 Then
        If Not isMissing(resolutionSource) Then resolutionSource = "FoundationTableFieldDescription"
        Exit Function
    End If
    ManagedObjectCatalogFieldDescriptionLong = ReferenceInventoryFieldDescription(tableName, fieldName)
    If Len(ManagedObjectCatalogFieldDescriptionLong) > 0 Then
        If Not isMissing(resolutionSource) Then resolutionSource = "ReferenceInventoryFieldDescription"
        Exit Function
    End If
    ManagedObjectCatalogFieldDescriptionLong = ModuleGuardFieldDescription(tableName, fieldName)
    If Len(ManagedObjectCatalogFieldDescriptionLong) > 0 Then
        If Not isMissing(resolutionSource) Then resolutionSource = "ModuleGuardFieldDescription"
        Exit Function
    End If
    If StrComp(tableName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SetupRecoveryState"), vbTextCompare) = 0 Then
        ManagedObjectCatalogFieldDescriptionLong = SetupRecoveryStateFieldDescription(fieldName)
        If Len(ManagedObjectCatalogFieldDescriptionLong) > 0 Then
            If Not isMissing(resolutionSource) Then resolutionSource = "SetupRecoveryStateFieldDescription"
            Exit Function
        End If
    End If
    Select Case tableKey
        Case LCase$(DB_TABLE_USYS_RIBBONS)
            ManagedObjectCatalogFieldDescriptionLong = RibbonTableFieldDescription(fieldName)
            If Len(ManagedObjectCatalogFieldDescriptionLong) > 0 Then
                If Not isMissing(resolutionSource) Then resolutionSource = "RibbonTableFieldDescription"
                Exit Function
            End If
        Case "adc_navigationpanegroups"
            Select Case fieldKey
                Case LCase$(FIELD_ID): ManagedObjectCatalogFieldDescriptionLong = BuildManagedObjectCatalogAdcNavigationpanegroupsIdLongFieldDescription()
                Case LCase$(FIELD_NAVIGATION_PANE_GROUP_KEY): ManagedObjectCatalogFieldDescriptionLong = FIELD_DESC_LONG_MANAGED_OBJECT_CATALOG_ADC_NAVIGATIONPANEGROUPS_NAVIGATIONPANEGROUPKEY
                Case LCase$(FIELD_NAVIGATION_PANE_GROUP_NAME): ManagedObjectCatalogFieldDescriptionLong = BuildManagedObjectCatalogAdcNavigationpanegroupsNavigationpanegroupnameLongFieldDescription()
                Case LCase$(FIELD_GROUP_DESCRIPTION): ManagedObjectCatalogFieldDescriptionLong = FIELD_DESC_LONG_MANAGED_OBJECT_CATALOG_ADC_NAVIGATIONPANEGROUPS_GROUPDESCRIPTION
                Case LCase$(FIELD_SETTING_KEY): ManagedObjectCatalogFieldDescriptionLong = FIELD_DESC_LONG_MANAGED_OBJECT_CATALOG_ADC_NAVIGATIONPANEGROUPS_FIELD_SETTING_KEY
                Case LCase$(FIELD_CONFIG_OWNER_DATABASE_ROLE): ManagedObjectCatalogFieldDescriptionLong = FIELD_DESC_LONG_MANAGED_OBJECT_CATALOG_ADC_NAVIGATIONPANEGROUPS_CONFIGOWNERDATABASEROLE
                Case LCase$(FIELD_OBJECT_TYPE_SCOPE): ManagedObjectCatalogFieldDescriptionLong = FIELD_DESC_LONG_MANAGED_OBJECT_CATALOG_ADC_NAVIGATIONPANEGROUPS_OBJECTTYPESCOPE
                Case LCase$(FIELD_GROUP_PURPOSE): ManagedObjectCatalogFieldDescriptionLong = FIELD_DESC_LONG_MANAGED_OBJECT_CATALOG_ADC_NAVIGATIONPANEGROUPS_GROUPPURPOSE
                Case LCase$(FIELD_LOOKUP_ACTIVE): ManagedObjectCatalogFieldDescriptionLong = FIELD_DESC_LONG_MANAGED_OBJECT_CATALOG_ADC_NAVIGATIONPANEGROUPS_LOOKUPACTIVE
                Case LCase$(FIELD_CREATE_IF_MISSING): ManagedObjectCatalogFieldDescriptionLong = FIELD_DESC_LONG_MANAGED_OBJECT_CATALOG_ADC_NAVIGATIONPANEGROUPS_CREATEIFMISSING
                Case LCase$(FIELD_SHOW_ON_RIBBON): ManagedObjectCatalogFieldDescriptionLong = BuildManagedObjectCatalogAdcNavigationpanegroupsShowonribbonLongFieldDescription()
                Case LCase$(FIELD_RIBBON_TAB_KEY): ManagedObjectCatalogFieldDescriptionLong = BuildManagedObjectCatalogAdcNavigationpanegroupsRibbontabkeyLongFieldDescription()
                Case LCase$(FIELD_RIBBON_TAB_LABEL): ManagedObjectCatalogFieldDescriptionLong = FIELD_DESC_LONG_MANAGED_OBJECT_CATALOG_ADC_NAVIGATIONPANEGROUPS_RIBBONTABLABEL
                Case LCase$(FIELD_RIBBON_GROUP_LABEL): ManagedObjectCatalogFieldDescriptionLong = FIELD_DESC_LONG_MANAGED_OBJECT_CATALOG_ADC_NAVIGATIONPANEGROUPS_RIBBONGROUPLABEL
                Case LCase$(FIELD_RIBBON_GROUP_SORT_ORDER): ManagedObjectCatalogFieldDescriptionLong = FIELD_DESC_LONG_MANAGED_OBJECT_CATALOG_ADC_NAVIGATIONPANEGROUPS_RIBBONGROUPSORTORDER
