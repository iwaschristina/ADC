' Purpose: Resolves and returns module guard field description from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Public ADC API. The routine is intentionally callable outside its defining procedure/module and may be used directly by Access/VBA or late-bound callers when that API surface is needed.
' Parameters:
'   tableName (Input; String): Physical Access table name identifying the table whose schema, data, or metadata the routine processes.
'   fieldName (Input; String): Field name identifying the table/query field or bound control source the routine evaluates or modifies.
' Returns: String: Returns the canonical description text for module guard field description, suitable for the managed catalog/field/object metadata destination; vbNullString indicates that no description
'   applies where allowed.
Public Function ModuleGuardFieldDescription(ByVal tableName As String, ByVal fieldName As String) As String
    Dim descriptionRows As Variant
    If StrComp(tableName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ModuleUpdateHistory"), vbTextCompare) = 0 Then
        descriptionRows = ModuleUpdateHistoryFieldDescriptions()
    ElseIf StrComp(tableName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ModuleVersionManifest"), vbTextCompare) = 0 Then
        descriptionRows = ModuleVersionManifestFieldDescriptions()
    ElseIf StrComp(tableName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ModuleVersionVerification"), vbTextCompare) = 0 Then
        descriptionRows = ModuleVersionVerificationFieldDescriptions()
    Else
        Exit Function
    End If
    ModuleGuardFieldDescription = ModuleGuardFieldDescriptionFromRows(descriptionRows, fieldName)
End Function

Private Function ModuleGuardFieldDescriptionShort(ByVal tableName As String, ByVal fieldName As String) As String
    Dim descriptionRows As Variant
    If StrComp(tableName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ModuleUpdateHistory"), vbTextCompare) = 0 Then
        descriptionRows = ModuleUpdateHistoryFieldDescriptionsShort()
    ElseIf StrComp(tableName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ModuleVersionManifest"), vbTextCompare) = 0 Then
        descriptionRows = ModuleVersionManifestFieldDescriptionsShort()
    ElseIf StrComp(tableName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ModuleVersionVerification"), vbTextCompare) = 0 Then
        descriptionRows = ModuleVersionVerificationFieldDescriptionsShort()
    Else
        Exit Function
    End If
    ModuleGuardFieldDescriptionShort = ModuleGuardFieldDescriptionFromRowsShort(descriptionRows, fieldName)
End Function


Private Function ModuleGuardFieldDescriptionFromRows(ByVal descriptionRows As Variant, ByVal fieldName As String) As String
    Dim descriptionRow As Variant
    Dim separatorPosition As Long
    For Each descriptionRow In descriptionRows
                separatorPosition = InStr(1, CStr(descriptionRow), "|", vbBinaryCompare)
        If separatorPosition > 1 Then
            If StrComp(Left$(CStr(descriptionRow), separatorPosition - 1), fieldName, vbTextCompare) = 0 Then
                ModuleGuardFieldDescriptionFromRows = Mid$(CStr(descriptionRow), separatorPosition + 1)
                Exit Function
            End If
        End If
    Next descriptionRow
End Function

Private Function ModuleGuardFieldDescriptionFromRowsShort(ByVal descriptionRows As Variant, ByVal fieldName As String) As String
    Dim descriptionRow As Variant
    Dim separatorPosition As Long
    For Each descriptionRow In descriptionRows
                separatorPosition = InStr(1, CStr(descriptionRow), "|", vbBinaryCompare)
        If separatorPosition > 1 Then
            If StrComp(Left$(CStr(descriptionRow), separatorPosition - 1), fieldName, vbTextCompare) = 0 Then
                ModuleGuardFieldDescriptionFromRowsShort = Mid$(CStr(descriptionRow), separatorPosition + 1)
                Exit Function
            End If
        End If
    Next descriptionRow
End Function


Private Function ModuleGuardLookupValueList(ByVal tableName As String, ByVal fieldName As String) As String
