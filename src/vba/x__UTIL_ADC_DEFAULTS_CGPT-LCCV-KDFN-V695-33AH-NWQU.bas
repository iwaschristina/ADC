Private Function CloneTextCollection(ByVal sourceRows As Collection) As Collection
    ' INTENTIONAL DEFENSIVE COPY: rows isolates caller-visible mutable membership from a shared/module-owned source Collection.
    Dim rows As New Collection
    Dim rowItem As Variant
    If Not sourceRows Is Nothing Then
        For Each rowItem In sourceRows
            rows.Add CStr(rowItem)
        Next rowItem
    End If
    Set CloneTextCollection = rows
End Function

