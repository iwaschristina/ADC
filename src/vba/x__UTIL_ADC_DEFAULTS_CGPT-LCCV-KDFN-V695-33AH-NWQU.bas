End Function


Private Function CanonicalQueryActionPayloadDefinitions(ByVal definitions As Collection, ByVal repairProcedureName As String, ByVal payloadDescription As String, ByVal payloadVersion As String) As Collection
    ' INTENTIONAL SEPARATE CANONICAL PROJECTION: rows transforms canonical managed-query definitions into action-payload rows for the payload consumer; the supplied definition collection remains the
    ' object-membership authority.
    Dim rows As New Collection
    Dim Definition As Variant
    If definitions Is Nothing Then Err.Raise vbObjectError + 7804, "CanonicalQueryActionPayloadDefinitions", "The canonical managed-query definition collection is missing."
    For Each Definition In definitions
        If StrComp(CStr(Definition(MANAGED_DEF_OBJECT_TYPE)), ADCAT_OBJECT_TYPE_QUERY, vbTextCompare) <> 0 Then Err.Raise vbObjectError + 7805, "CanonicalQueryActionPayloadDefinitions", "A query action-payload definition collection contains a non-query canonical managed object." & vbCrLf & "Object: " & CStr(Definition(MANAGED_DEF_OBJECT_NAME)) & vbCrLf & "ObjectType: " & CStr(Definition(MANAGED_DEF_OBJECT_TYPE))
        rows.Add Array(CStr(Definition(MANAGED_DEF_OBJECT_NAME)), ADCAT_PAYLOAD_QUERY_SQL_BUILDER, repairProcedureName, vbNullString, payloadDescription, payloadVersion, CLng(Definition(MANAGED_DEF_SORT_ORDER)))
    Next Definition
    Set CanonicalQueryActionPayloadDefinitions = rows
End Function

' Purpose: Adds in review full placement definitions.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
' Returns: Collection: Returns the collection/object containing the canonical add in review full placement definitions selected by the supplied filters/context; an empty collection/object is used where the
'   implementation defines no matches.
Public Function AddInReviewFullPlacementDefinitions() As Collection
    'Derived Add-In Review projection; membership and placement metadata come directly from one canonical managed-object traversal.
    ' INTENTIONAL FILTERED PROJECTION: rows selects Add-In Review managed objects and joins their canonical Navigation Pane/Ribbon placement metadata for consumers; source registries remain authoritative.
    Dim rows As New Collection
    Dim definitionData As Variant
    Dim navigationPaneDefinitions As Collection
    Dim navigationPaneDefinitionIndex As Object
    Dim navigationPaneDefinition As Variant
    Dim logicalIdentity As String
    Dim placementScope As String
    Dim navigationPaneSettingKey As String
    Dim ribbonTabKey As String
    Dim ribbonTabLabel As String
    Dim ribbonGroupKey As String
    Dim ribbonGroupLabel As String
    Dim ribbonGroupSortOrder As Long
    Set navigationPaneDefinitions = NavigationPaneGroupDefinitions()
    Set navigationPaneDefinitionIndex = NavigationPaneGroupDefinitionIndexByApplicability(navigationPaneDefinitions, 8)
    For Each definitionData In ManagedObjectDefinitionRowsForRead()
        If StrComp(CStr(definitionData(MANAGED_DEF_GROUP)), MANAGED_GROUP_ADD_IN_REVIEW, vbTextCompare) = 0 Then
            logicalIdentity = CStr(definitionData(MANAGED_DEF_LOGICAL_IDENTITY))
            If Len(logicalIdentity) = 0 Then Err.Raise vbObjectError + 7793, "AddInReviewFullPlacementDefinitions", "A canonical Add-In Review managed object is missing its logical identity." & vbCrLf & "Object: " & CStr(definitionData(MANAGED_DEF_OBJECT_NAME))
            placementScope = CStr(definitionData(MANAGED_DEF_PLACEMENT_SCOPE))
            If Len(placementScope) = 0 Then Err.Raise vbObjectError + 6884, "AddInReviewFullPlacementDefinitions", "The canonical managed-object definition has a blank Navigation Pane placement scope." & vbCrLf & "Object: " & CStr(definitionData(MANAGED_DEF_OBJECT_NAME))
            navigationPaneSettingKey = vbNullString
            If navigationPaneDefinitionIndex.Exists(placementScope) Then
                navigationPaneDefinition = navigationPaneDefinitionIndex(placementScope)
                navigationPaneSettingKey = CStr(navigationPaneDefinition(3))
            End If
            ribbonTabKey = CStr(definitionData(MANAGED_DEF_RIBBON_TAB_KEY))
            ribbonGroupKey = CStr(definitionData(MANAGED_DEF_RIBBON_GROUP_KEY))
            If Len(ribbonTabKey) = 0 Or Len(ribbonGroupKey) = 0 Then Err.Raise vbObjectError + 6879, "AddInReviewFullPlacementDefinitions", "A canonical Add-In Review managed object has no static Ribbon placement." & vbCrLf & "Object: " & CStr(definitionData(MANAGED_DEF_OBJECT_NAME))
            ribbonTabLabel = GetRibbonTabLabelDefault(ribbonTabKey)
            ribbonGroupLabel = RibbonManagedGroupLabel(ribbonGroupKey, ribbonGroupSortOrder)
            If Len(ribbonTabLabel) = 0 Or Len(ribbonGroupLabel) = 0 Or ribbonGroupSortOrder <= 0 Then Err.Raise vbObjectError + 6879, "AddInReviewFullPlacementDefinitions", "A canonical Add-In Review managed object has no static Ribbon placement." & vbCrLf & "Object: " & CStr(definitionData(MANAGED_DEF_OBJECT_NAME))
            rows.Add Array(CStr(definitionData(MANAGED_DEF_OBJECT_NAME)), CStr(definitionData(MANAGED_DEF_OBJECT_TYPE)), logicalIdentity, navigationPaneSettingKey, ribbonTabKey, ribbonTabLabel, ribbonGroupLabel, ribbonGroupSortOrder, True, "ADCManagedObjectDefinitions", CStr(definitionData(MANAGED_DEF_CATEGORY)), CLng(definitionData(MANAGED_DEF_SORT_ORDER)), CStr(definitionData(MANAGED_DEF_DESCRIPTION)), ADCAT_OWNER_SYSTEM_DEFAULT)
        End If
    Next definitionData
    Set AddInReviewFullPlacementDefinitions = rows
End Function

