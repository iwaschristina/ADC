Private Sub InsertGeneratedFormBuildNameOrdered(ByVal targetRows As Collection, ByVal targetBuildOrders As Collection, ByVal formName As String, ByVal buildOrder As Long)
    Dim insertIndex As Long
    For insertIndex = 1 To targetBuildOrders.count
        If buildOrder < CLng(targetBuildOrders(insertIndex)) Then
            targetRows.Add formName, Before:=insertIndex
            targetBuildOrders.Add buildOrder, Before:=insertIndex
            Exit Sub
        End If
    Next insertIndex
    targetRows.Add formName
    targetBuildOrders.Add buildOrder
End Sub

Private Function GeneratedFormLookupEditorDependencies(ByVal sourceLogicalID As String, ByVal currentFormName As String, ByVal editorSourceLogicalByForm As Object) As Collection
    'Derived dependency projection only: B2 lookup definitions and the source-level editor policy remain authoritative.
    Dim rows As New Collection
    Dim seen As Object
    Dim definitions As Collection
    Dim definitionData As Variant
    Dim policyData As Variant
    Dim policyCode As String
    Dim editorLogicalID As String
    Dim editorPhysicalName As String
    Dim sourcePhysicalName As String
    Set seen = CreateObject("Scripting.Dictionary")
    seen.CompareMode = vbTextCompare
    sourcePhysicalName = ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, sourceLogicalID)
    Set definitions = B2SharedFieldMetadataDefinitions(sourcePhysicalName)
    For Each definitionData In definitions
        If StrComp(CStr(definitionData(0)), CATALOG_FIELD_LOOKUP_DEFINITION_KIND_TABLE, vbTextCompare) = 0 Then
            policyData = LookupEditorPolicyForPhysicalSource(CStr(definitionData(2)))
            policyCode = CStr(policyData(LOOKUP_EDITOR_DEF_POLICY))
            If StrComp(policyCode, LOOKUP_EDITOR_POLICY_NONE, vbTextCompare) <> 0 Then
                editorLogicalID = CStr(policyData(LOOKUP_EDITOR_DEF_EDITOR_LOGICAL_ID))
                If Len(editorLogicalID) > 0 Then
                    editorPhysicalName = ManagedObjectPhysicalName(NAMING_CATEGORY_GENERATED_FORM, editorLogicalID)
                    If StrComp(editorPhysicalName, currentFormName, vbTextCompare) <> 0 Then
                        If editorSourceLogicalByForm.Exists(editorPhysicalName) Then
                            If seen.Exists(editorPhysicalName) = False Then
                                seen.Add editorPhysicalName, True
                                rows.Add editorPhysicalName
                            End If
                        End If
                    End If
                End If
            End If
        End If
    Next definitionData
    Set GeneratedFormLookupEditorDependencies = rows
End Function

Private Sub AppendDependencyOrderedLookupEditorForms(ByVal editorRows As Collection, ByVal editorSourceLogicalByForm As Object, ByRef targetRows As Collection)
    'Topological ordering is derived from authoritative B2 lookup definitions; original generated-form build order is the stable tie-breaker.
    Dim scheduled As Object
    Dim dependencyRows As Collection
    Dim rowItem As Variant
    Dim dependencyItem As Variant
    Dim formName As String
    Dim dependencyName As String
    Dim progressMade As Boolean
    Dim unresolvedText As String
    Set scheduled = CreateObject("Scripting.Dictionary")
    scheduled.CompareMode = vbTextCompare
    Do While scheduled.count < editorRows.count
        progressMade = False
        For Each rowItem In editorRows
            formName = CStr(rowItem)
            If scheduled.Exists(formName) = False Then
                Set dependencyRows = GeneratedFormLookupEditorDependencies(CStr(editorSourceLogicalByForm(formName)), formName, editorSourceLogicalByForm)
                dependencyName = vbNullString
                For Each dependencyItem In dependencyRows
                    If scheduled.Exists(CStr(dependencyItem)) = False Then
                        dependencyName = CStr(dependencyItem)
                        Exit For
                    End If
                Next dependencyItem
                If Len(dependencyName) = 0 Then
                    targetRows.Add formName
                    scheduled.Add formName, True
                    progressMade = True
                End If
            End If
        Next rowItem
        If progressMade = False Then
            unresolvedText = vbNullString
            For Each rowItem In editorRows
                formName = CStr(rowItem)
                If scheduled.Exists(formName) = False Then unresolvedText = SharedText_AppendNonBlankLine(unresolvedText, formName)
            Next rowItem
            Err.Raise vbObjectError + 7819, "AppendDependencyOrderedLookupEditorForms", "The authoritative lookup-editor form dependencies contain a cycle or unresolved prerequisite." & vbCrLf & unresolvedText
        End If
    Loop
End Sub

' Purpose: Builds the deterministic generated-form build order from canonical managed-form and lookup-editor definitions, placing editor forms first in dependency-safe order before ordinary forms.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
' Returns: Collection: Returns the build generated form name list object/collection resolved by this routine for direct use by the caller; the routine's documented absence/error path applies when no such object
'   can be resolved.
Public Function BuildGeneratedFormNameList() As Collection
    ' INTENTIONAL FILTERED PARTITION: all build groups are derived only from canonical managed-form and lookup-editor authorities.
    ' Forms that serve as lookup editors build first in dependency-safe order, then ordinary generated forms. Canonical build order is the stable tie-breaker among simultaneously eligible editor forms and within the
    ' ordinary group.
    Dim rows As New Collection
    Dim editorRows As New Collection
    Dim editorBuildOrders As New Collection
    Dim ordinaryRows As New Collection
    Dim ordinaryBuildOrders As New Collection
    Dim seenBuildOrders As Object
    Dim editorSourceLogicalByForm As Object
    Dim rowData As Variant
    Dim rowItem As Variant
    Dim policyData As Variant
    Dim policyCode As String
    Dim sourceLogicalID As String
    Dim editorLogicalID As String
    Dim editorPhysicalName As String
    Dim buildOrder As Long
    Dim formName As String
    Set seenBuildOrders = CreateObject("Scripting.Dictionary")
    seenBuildOrders.CompareMode = vbTextCompare
    Set editorSourceLogicalByForm = CreateObject("Scripting.Dictionary")
    editorSourceLogicalByForm.CompareMode = vbTextCompare
    For Each policyData In LookupEditorPolicyDefinitions()
        policyCode = CStr(policyData(LOOKUP_EDITOR_DEF_POLICY))
        sourceLogicalID = CStr(policyData(LOOKUP_EDITOR_DEF_SOURCE_LOGICAL_ID))
        editorLogicalID = CStr(policyData(LOOKUP_EDITOR_DEF_EDITOR_LOGICAL_ID))
        If StrComp(policyCode, LOOKUP_EDITOR_POLICY_NONE, vbTextCompare) <> 0 And Len(editorLogicalID) > 0 Then
            editorPhysicalName = ManagedObjectPhysicalName(NAMING_CATEGORY_GENERATED_FORM, editorLogicalID)
            editorSourceLogicalByForm(editorPhysicalName) = sourceLogicalID
        End If
    Next policyData
    For Each rowData In ManagedObjectDefinitionRowsForRead()
        If StrComp(CStr(rowData(MANAGED_DEF_GROUP)), MANAGED_GROUP_GENERATED_FORM, vbTextCompare) = 0 Then
            formName = CStr(rowData(MANAGED_DEF_OBJECT_NAME))
            buildOrder = CLng(rowData(MANAGED_DEF_GENERATED_FORM_BUILD_ORDER))
            If buildOrder <= 0 Then Err.Raise vbObjectError + 7817, "BuildGeneratedFormNameList", "A canonical generated form is missing its physical build order." & vbCrLf & "Form: " & formName
            If seenBuildOrders.Exists(CStr(buildOrder)) Then Err.Raise vbObjectError + 7818, "BuildGeneratedFormNameList", "The canonical generated-form registry contains a duplicate physical build order." & vbCrLf & "BuildOrder: " & CStr(buildOrder) & vbCrLf & "Form: " & formName
            seenBuildOrders.Add CStr(buildOrder), formName
            If editorSourceLogicalByForm.Exists(formName) Then
                InsertGeneratedFormBuildNameOrdered editorRows, editorBuildOrders, formName, buildOrder
            Else
                InsertGeneratedFormBuildNameOrdered ordinaryRows, ordinaryBuildOrders, formName, buildOrder
            End If
        End If
    Next rowData
    AppendDependencyOrderedLookupEditorForms editorRows, editorSourceLogicalByForm, rows
    For Each rowItem In ordinaryRows
        rows.Add CStr(rowItem)
    Next rowItem
    Set BuildGeneratedFormNameList = rows
End Function

' Purpose: Performs generated form open after setup by coordinating `GetGeneratedFormDefinition` and `IsArray` while preserving this module's existing validation and error semantics.
