' Purpose: Resolves display caption from the supplied/current ADC state, using `End` and `If` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   fieldName (Input; String): Canonical or physical name identifying the field targeted by this operation.
' Returns: String: Returns the formatted text produced by this routine. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not
'   resolved.
Public Function DisplayCaption(ByVal fieldName As String) As String
    Dim index As Long
    Dim ch As String
    Dim previousChar As String
    Dim nextChar As String
    Dim previousCode As Long
    Dim currentCode As Long
    Dim nextCode As Long
    Dim resultText As String
    fieldName = Trim$(fieldName)
    For index = 1 To Len(fieldName)
        ch = Mid$(fieldName, index, 1)
        If ch = "_" Or ch = "-" Or ch = " " Or ch = vbTab Then
            If Len(resultText) > 0 Then
                If Right$(resultText, 1) <> " " Then resultText = resultText & " "
            End If
        Else
            previousChar = vbNullString
            nextChar = vbNullString
            previousCode = 0
            currentCode = AscW(ch)
            nextCode = 0
            If index > 1 Then
                previousChar = Mid$(fieldName, index - 1, 1)
                previousCode = AscW(previousChar)
            End If
            If index < Len(fieldName) Then
                nextChar = Mid$(fieldName, index + 1, 1)
                nextCode = AscW(nextChar)
            End If
            If currentCode >= 65 And currentCode <= 90 Then
                If (previousCode >= 97 And previousCode <= 122) Or (previousCode >= 48 And previousCode <= 57) Then
                    If Len(resultText) > 0 And Right$(resultText, 1) <> " " Then resultText = resultText & " "
                ElseIf previousCode >= 65 And previousCode <= 90 And nextCode >= 97 And nextCode <= 122 Then
                    If Len(resultText) > 0 And Right$(resultText, 1) <> " " Then resultText = resultText & " "
                End If
            End If
            resultText = resultText & ch
        End If
    Next index
    DisplayCaption = Trim$(resultText)
End Function

