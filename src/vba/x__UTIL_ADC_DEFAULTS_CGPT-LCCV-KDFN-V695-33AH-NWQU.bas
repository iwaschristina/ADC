Private Function NavigationPaneSettingKeyByApplicability(ByVal applicabilityValue As String, ByVal applicabilityIndex As Long) As String
    Dim rowData As Variant
    rowData = NavigationPaneGroupDefinitionByApplicability(applicabilityValue, applicabilityIndex)
    If IsArray(rowData) Then NavigationPaneSettingKeyByApplicability = CStr(rowData(3))
End Function

Private Function NavigationPaneGroupDefinitionIndexByApplicability(ByVal definitions As Collection, ByVal applicabilityIndex As Long) As Object
    Dim indexByApplicability As Object
    Dim rowValues As Object
    Dim rowData As Variant
    Dim itemValue As Variant
    Dim applicabilityKey As String
    ' INTENTIONAL KEYED LOOKUP: indexByApplicability, rowValues provides keyed membership/lookup over source rows or state already read by NavigationPaneGroupDefinitionIndexByApplicability; it is a derived access
    ' path, not a second authority.
    Set indexByApplicability = CreateObject("Scripting.Dictionary")
    indexByApplicability.CompareMode = vbTextCompare
    For Each rowData In definitions
        Set rowValues = CreateObject("Scripting.Dictionary")
        rowValues.CompareMode = vbTextCompare
        For Each itemValue In Split(CStr(rowData(applicabilityIndex)), "|")
            applicabilityKey = Trim$(CStr(itemValue))
            If Len(applicabilityKey) > 0 And rowValues.Exists(applicabilityKey) = False Then
                rowValues.Add applicabilityKey, True
                If indexByApplicability.Exists(applicabilityKey) Then Err.Raise vbObjectError + 7799, "NavigationPaneGroupDefinitionIndexByApplicability", "More than one authoritative Navigation Pane group definition matches the requested applicability value." & vbCrLf & "Value: " & applicabilityKey
                indexByApplicability.Add applicabilityKey, rowData
            End If
        Next itemValue
    Next rowData
    Set NavigationPaneGroupDefinitionIndexByApplicability = indexByApplicability
End Function

Private Function NavigationPaneGroupDefinitionByApplicability(ByVal applicabilityValue As String, ByVal applicabilityIndex As Long) As Variant
    Dim rowData As Variant
    Dim matched As Boolean
    applicabilityValue = Trim$(applicabilityValue)
    If Len(applicabilityValue) = 0 Then Exit Function
    For Each rowData In NavigationPaneGroupDefinitions()
        If NavigationPaneApplicabilityContains(CStr(rowData(applicabilityIndex)), applicabilityValue) Then
            If matched Then Err.Raise vbObjectError + 7799, "NavigationPaneGroupDefinitionByApplicability", "More than one authoritative Navigation Pane group definition matches the requested applicability value." & vbCrLf & "Value: " & applicabilityValue
            matched = True
            NavigationPaneGroupDefinitionByApplicability = rowData
        End If
    Next rowData
End Function

Private Function NavigationPaneApplicabilityContains(ByVal applicabilityList As String, ByVal requestedValue As String) As Boolean
    Dim itemValue As Variant
    applicabilityList = Trim$(applicabilityList)
    If Len(applicabilityList) = 0 Or Len(requestedValue) = 0 Then Exit Function
    For Each itemValue In Split(applicabilityList, "|")
        If StrComp(Trim$(CStr(itemValue)), requestedValue, vbTextCompare) = 0 Then
            NavigationPaneApplicabilityContains = True
            Exit Function
        End If
    Next itemValue
End Function

' Purpose: Resolves system macro navigation pane group definitions from the supplied/current ADC state, using `IsObject` and `NavigationPaneGroupDefinitions` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   navigationPaneDefinitions (Input Optional; Variant): Variant input representing navigation pane definitions; the routine accepts the caller-provided value in the form required by its existing
'   validation and conversion logic.
' Returns: Collection: Returns the ordered Collection assembled by the routine; callers receive the object reference and should treat its membership/order according to the routine contract.
Public Function SystemMacroNavigationPaneGroupDefinitions(Optional ByVal navigationPaneDefinitions As Variant) As Collection
    'Derived projection of the canonical NavigationPaneGroupDefinitions rows, ordered by the canonical Navigation Pane sort order.
    ' INTENTIONAL SORTED PROJECTION: rows filters canonical NavigationPaneGroupDefinitions to System Macro groups and preserves canonical Navigation Pane sort order without becoming a second group authority.
    Dim rows As New Collection
    Dim sourceDefinitions As Collection
    Dim rowData As Variant
    Dim existingRow As Variant
    Dim insertAt As Long
    Dim inserted As Boolean
    If IsObject(navigationPaneDefinitions) Then Set sourceDefinitions = navigationPaneDefinitions
    If sourceDefinitions Is Nothing Then Set sourceDefinitions = NavigationPaneGroupDefinitions()
    For Each rowData In sourceDefinitions
        If StrComp(Trim$(CStr(rowData(5))), ADCAT_OBJECT_TYPE_MACRO, vbTextCompare) = 0 Then
            If StrComp(Trim$(CStr(rowData(6))), NAVIGATION_PANE_GROUP_PURPOSE_SYSTEM_MACROS, vbTextCompare) = 0 Then
                inserted = False
                For insertAt = 1 To rows.count
                    existingRow = rows(insertAt)
                    If CLng(rowData(7)) < CLng(existingRow(7)) Then rows.Add rowData, Before:=insertAt: inserted = True: Exit For
                Next insertAt
                If Not inserted Then rows.Add rowData
            End If
        End If
    Next rowData
    Set SystemMacroNavigationPaneGroupDefinitions = rows
End Function

