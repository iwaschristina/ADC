        If StrComp(logicalTableName, CStr(d(0)), vbTextCompare) = 0 Then EditableLookupTableImplementationDefinition = Array(tableName, "Converted:" & CStr(d(2)), CLng(d(3)), "create/verify " & CStr(d(1)) & " editable lookup table", CLng(d(4))): Exit Function
