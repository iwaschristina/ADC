' Purpose: Resolves the built-in seed value/description collection used only when one editable lookup table is first created.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   tableName (Input; String): Physical Access table name identifying the table whose schema, data, or metadata the routine processes.
'   sourceKind (Input Optional; String): Kind discriminator identifying the source variant handled by this operation. Default: vbNullString.
' Returns: Collection: Returns the collection/object containing the canonical editable lookup table seed definitions selected by the supplied filters/context; an empty collection/object is used where the
'   implementation defines no matches.
Public Function EditableLookupTableSeedDefinitions(ByVal tableName As String, Optional ByVal sourceKind As String = vbNullString) As Collection
    ' Resolves the built-in seed value/description collection used only when one editable lookup table is first created.
    Dim rowData As Variant
    sourceKind = Trim$(sourceKind)
    If Len(sourceKind) = 0 Then
        For Each rowData In EditableLookupTableDefinitions()
            If StrComp(CStr(rowData(0)), tableName, vbTextCompare) = 0 Then
                sourceKind = CStr(rowData(1))
                Exit For
            End If
        Next rowData
    End If
    If Len(sourceKind) = 0 Then Err.Raise vbObjectError + 7722, "EditableLookupTableSeedDefinitions", "No initial seed definition exists for editable lookup table '" & tableName & "'."
    If Left$(UCase$(sourceKind), 10) = "CONVERTED:" Then Set EditableLookupTableSeedDefinitions = ConvertedValueLookupSeedDefinitions(Mid$(sourceKind, 11)): Exit Function
    Select Case UCase$(sourceKind)
        Case "ACCEPTANCESTATUS": Set EditableLookupTableSeedDefinitions = AcceptanceStatusDefinitions()
        Case "CANDIDATESTATUS": Set EditableLookupTableSeedDefinitions = CandidateStatusDefinitions()
        Case "CONFIGURATIONSTATUS": Set EditableLookupTableSeedDefinitions = ConfigurationStatusDefinitions()
        Case "GENERATEDRESULT": Set EditableLookupTableSeedDefinitions = GeneratedResultDefinitions()
        Case "HEALTHREVIEWAREA": Set EditableLookupTableSeedDefinitions = HealthReviewAreaDefinitions()
        Case "HEALTHSEVERITY": Set EditableLookupTableSeedDefinitions = HealthSeverityDefinitions()
        Case "MACROACTION": Set EditableLookupTableSeedDefinitions = MacroActionDefinitions()
        Case "MANUALREVIEWSTATUS": Set EditableLookupTableSeedDefinitions = ManualReviewStatusDefinitions()
        Case "VALIDATIONRESULT": Set EditableLookupTableSeedDefinitions = ValidationResultDefinitions()
        Case "PROJECTROLE": Set EditableLookupTableSeedDefinitions = ProjectRoleDefinitions()
        Case "PROJECTPROTECTIONSTATE": Set EditableLookupTableSeedDefinitions = ProjectProtectionStateDefinitions()
        Case "REFERENCESCANSTATUS": Set EditableLookupTableSeedDefinitions = ReferenceScanStatusDefinitions()
        Case "REFERENCEMATCHSTATUS": Set EditableLookupTableSeedDefinitions = ReferenceMatchStatusDefinitions()
        Case "REFERENCEMATCHMETHOD": Set EditableLookupTableSeedDefinitions = ReferenceMatchMethodDefinitions()
        Case "PROCEDUREKIND": Set EditableLookupTableSeedDefinitions = ProcedureKindDefinitions()
        Case "PROCEDURESCOPE": Set EditableLookupTableSeedDefinitions = ProcedureScopeDefinitions()
        Case "REFERENCEDEPENDENCYTYPE": Set EditableLookupTableSeedDefinitions = ReferenceDependencyTypeDefinitions()
        Case "DOCUMENTATIONSTATUS": Set EditableLookupTableSeedDefinitions = DocumentationStatusDefinitions()
        Case "VBAPROJECTTYPE": Set EditableLookupTableSeedDefinitions = VBAProjectTypeDefinitions()
        Case "REFERENCEKIND": Set EditableLookupTableSeedDefinitions = ReferenceKindDefinitions()
        Case "VBCOMPONENTTYPE": Set EditableLookupTableSeedDefinitions = VBComponentTypeDefinitions()
        Case "INVENTORYSTATUS": Set EditableLookupTableSeedDefinitions = InventoryStatusDefinitions()
        Case "REGISTRATIONSCOPE": Set EditableLookupTableSeedDefinitions = RegistrationScopeDefinitions()
        Case "REGISTRATIONVIEW": Set EditableLookupTableSeedDefinitions = RegistrationViewDefinitions()
        Case "REFERENCEPLATFORM": Set EditableLookupTableSeedDefinitions = ReferencePlatformDefinitions()
        Case "REFERENCESOURCE": Set EditableLookupTableSeedDefinitions = ReferenceSourceDefinitions()
        Case "REFERENCEHEALTHSTATUS": Set EditableLookupTableSeedDefinitions = ReferenceHealthStatusDefinitions()
        Case Else: Err.Raise vbObjectError + 7723, "EditableLookupTableSeedDefinitions", "Editable lookup table '" & tableName & "' has unsupported seed source kind '" & sourceKind & "'."
    End Select
End Function

Private Function ConvertedValueLookupDefinitions() As Collection
    Static r As Collection
    Dim names As Variant, labels As Variant, physicalNames As Variant, editorPhysicalNames As Variant, ribbonTitles As Variant, editorRibbonTitles As Variant, sizes As Variant, i As Long
