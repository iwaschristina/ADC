' Intended use: Returns the execution kind stored by the authoritative built-in SystemMacro definition; unknown keys return blank.
' Purpose: Resolves system macro execution kind from the supplied/current ADC state, using `isMissing` and `SystemMacroDefinitionByKey` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   systemMacroKey (Input; String): Stable identity/key used to select the system macro key definition, row, workflow part, or managed object without relying on display text.
'   suppliedSystemMacroDefinition (Input Optional; Variant): Variant input representing supplied system macro definition; the routine accepts the caller-provided value in the form required by its existing
'   validation and conversion logic.
' Returns: String: Returns the system macro execution kind text value. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not resolved.
Public Function SystemMacroExecutionKind(ByVal systemMacroKey As String, Optional ByVal suppliedSystemMacroDefinition As Variant) As String
    Dim Definition As Variant
    Dim executionKind As String
    If isMissing(suppliedSystemMacroDefinition) Then
        Definition = SystemMacroDefinitionByKey(systemMacroKey)
    Else
        Definition = suppliedSystemMacroDefinition
    End If
    If IsEmpty(Definition) Then Exit Function
    If UBound(Definition) < 8 Then Err.Raise vbObjectError + 8802, "SystemMacroExecutionKind", "The authoritative SystemMacro definition is missing execution-kind metadata." & vbCrLf & "Key: " & systemMacroKey
    executionKind = Trim$(CStr(Definition(8)))
    Select Case UCase$(executionKind)
        Case UCase$(SYSTEM_MACRO_EXECUTION_OPERATIONAL), UCase$(SYSTEM_MACRO_EXECUTION_FULL_SETUP), UCase$(SYSTEM_MACRO_EXECUTION_VERIFY_MODULE_GUARD), UCase$(SYSTEM_MACRO_EXECUTION_SETUP_PART), UCase$(SYSTEM_MACRO_EXECUTION_SETUP_PHASE)
            SystemMacroExecutionKind = executionKind
        Case Else
            Err.Raise vbObjectError + 8803, "SystemMacroExecutionKind", "The authoritative SystemMacro definition contains an unsupported execution kind." & vbCrLf & "Key: " & systemMacroKey & vbCrLf & "Execution kind: " & executionKind
    End Select
End Function

