' Purpose: Resolves module guard field descriptions from the supplied/current ADC state, using `StrComp` and `ModuleUpdateHistoryFieldDescriptions` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   tableName (Input; String): Canonical or physical name identifying the table targeted by this operation.
' Returns: Variant: Returns the module guard field descriptions value in the scalar, array, object, Empty, or Null form produced by the routine's existing contract.
Public Function ModuleGuardFieldDescriptions(ByVal tableName As String) As Variant
    If StrComp(tableName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ModuleUpdateHistory"), vbTextCompare) = 0 Then
        ModuleGuardFieldDescriptions = ModuleUpdateHistoryFieldDescriptions()
    ElseIf StrComp(tableName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ModuleVersionManifest"), vbTextCompare) = 0 Then
        ModuleGuardFieldDescriptions = ModuleVersionManifestFieldDescriptions()
    ElseIf StrComp(tableName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ModuleVersionVerification"), vbTextCompare) = 0 Then
        ModuleGuardFieldDescriptions = ModuleVersionVerificationFieldDescriptions()
    Else
        ModuleGuardFieldDescriptions = Empty
    End If
End Function

' Purpose: Resolves and returns reference inventory field description from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Public ADC API. The routine is intentionally callable outside its defining procedure/module and may be used directly by Access/VBA or late-bound callers when that API surface is needed.
' Parameters:
'   tableName (Input; String): Physical Access table name identifying the table whose schema, data, or metadata the routine processes.
'   fieldName (Input; String): Field name identifying the table/query field or bound control source the routine evaluates or modifies.
' Returns: String: Returns the canonical description text for reference inventory field description, suitable for the managed catalog/field/object metadata destination; vbNullString indicates that no
'   description applies where allowed.
Public Function ReferenceInventoryFieldDescription(ByVal tableName As String, ByVal fieldName As String) As String
    If StrComp(tableName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ActiveReferences"), vbTextCompare) = 0 Then
        ReferenceInventoryFieldDescription = ReferenceFieldDescription(fieldName, True)
    ElseIf StrComp(tableName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_AvailableReferences"), vbTextCompare) = 0 Then
        ReferenceInventoryFieldDescription = ReferenceFieldDescription(fieldName, False)
    ElseIf StrComp(tableName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_LoadedVBAProjects"), vbTextCompare) = 0 Then
        ReferenceInventoryFieldDescription = LoadedVBAProjectFieldDescription(fieldName)
    ElseIf StrComp(tableName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_VBEAddIns"), vbTextCompare) = 0 Or StrComp(tableName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_COMAddIns"), vbTextCompare) = 0 Then
        ReferenceInventoryFieldDescription = AddInInventoryFieldDescription(fieldName)
    ElseIf StrComp(tableName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_AccessAddIns"), vbTextCompare) = 0 Then
        ReferenceInventoryFieldDescription = AccessAddInInventoryFieldDescription(fieldName)
    ElseIf StrComp(tableName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_LoadedVBAProjectReferences"), vbTextCompare) = 0 Or StrComp(tableName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_LoadedVBAModules"), vbTextCompare) = 0 Or StrComp(tableName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_LoadedVBAProcedures"), vbTextCompare) = 0 Or StrComp(tableName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_LoadedVBADependencies"), vbTextCompare) = 0 Then
        ReferenceInventoryFieldDescription = SourceAnalysisFieldDescription(tableName, fieldName)
    ElseIf StrComp(tableName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ActiveReferenceProjectLinks"), vbTextCompare) = 0 Then
        ReferenceInventoryFieldDescription = ActiveReferenceProjectLinkFieldDescription(fieldName)
    ElseIf StrComp(tableName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ReferenceManager"), vbTextCompare) = 0 Then
        ReferenceInventoryFieldDescription = ReferenceManagerFieldDescription(fieldName)
    End If
End Function

