        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_GENERATED_FORM, CANON_GENERATED_FORM_LOGICAL_ID_SCAN_PROGRESS))
            AddGeneratedFormImplementationDefinition rows, canonicalDefinition, CANON_GENERATED_FORM_TITLE_SCAN_PROGRESS, DEFAULT_FORM_TYPE_SINGLE, GeneratedFormCanonicalRibbonGroupLabel(canonicalDefinition)
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_GENERATED_FORM, CANON_GENERATED_FORM_LOGICAL_ID_UTILITY))
