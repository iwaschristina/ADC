' Purpose: Resolves and returns generated form expected source type from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   formName (Input; String): Physical Access form name identifying the form to create, open, configure, validate, or inspect.
' Returns: String: Returns the canonical generated form expected source type value used by downstream policy/dispatch logic; vbNullString indicates that no managed value applies where the API permits absence.
Public Function GeneratedFormExpectedSourceType(ByVal formName As String) As String
    Dim definitionData As Variant
    Dim sourceCandidates As Variant
    definitionData = GetGeneratedFormDefinition(formName)
    If IsArray(definitionData) = False Then Exit Function
    GeneratedFormExpectedSourceType = CStr(definitionData(GENERATED_FORM_DEF_EXPECTED_SOURCE_TYPE_OVERRIDE))
    If Len(Trim$(GeneratedFormExpectedSourceType)) > 0 Then Exit Function
    sourceCandidates = definitionData(GENERATED_FORM_DEF_SOURCE_CANDIDATES)
    If IsArray(sourceCandidates) = False Then GeneratedFormExpectedSourceType = GENERATED_FORM_SOURCE_TYPE_UNBOUND Else GeneratedFormExpectedSourceType = GENERATED_FORM_SOURCE_TYPE_TABLE_OR_QUERY
End Function

