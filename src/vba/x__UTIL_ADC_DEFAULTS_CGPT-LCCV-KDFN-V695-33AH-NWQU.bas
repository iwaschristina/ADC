' Intended use: Return the canonical implemented Setup Part identity explicitly referenced by a Setup Part SystemMacro definition; malformed canonical definitions fail closed.
' Purpose: Resolves system macro setup part identity from the supplied/current ADC state, using `isMissing` and `SystemMacroDefinitionByKey` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   systemMacroKey (Input; String): Stable identity/key used to select the system macro key definition, row, workflow part, or managed object without relying on display text.
'   suppliedSystemMacroDefinition (Input Optional; Variant): Variant input representing supplied system macro definition; the routine accepts the caller-provided value in the form required by its existing
'   validation and conversion logic.
' Returns: String: Returns the system macro setup part identity text value. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not
'   resolved.
Public Function SystemMacroSetupPartIdentity(ByVal systemMacroKey As String, Optional ByVal suppliedSystemMacroDefinition As Variant) As String
    Dim Definition As Variant
    Dim targetIdentity As String
    Dim canonicalIdentity As String
    If isMissing(suppliedSystemMacroDefinition) Then
        Definition = SystemMacroDefinitionByKey(systemMacroKey)
    Else
        Definition = suppliedSystemMacroDefinition
    End If
    If IsEmpty(Definition) Then Exit Function
    If StrComp(SystemMacroExecutionKind(systemMacroKey, Definition), SYSTEM_MACRO_EXECUTION_SETUP_PART, vbTextCompare) <> 0 Then Exit Function
    targetIdentity = SystemMacroExecutionTargetIdentity(systemMacroKey, Definition)
    If Len(targetIdentity) = 0 Then Err.Raise vbObjectError + 9110, "SystemMacroSetupPartIdentity", "The authoritative Setup Part SystemMacro definition is missing its execution-target identity." & vbCrLf & "Key: " & systemMacroKey
    canonicalIdentity = ImplementedSetupPartIdentity(targetIdentity)
    If Len(canonicalIdentity) = 0 Then Err.Raise vbObjectError + 9111, "SystemMacroSetupPartIdentity", "The authoritative Setup Part SystemMacro definition references an unsupported Setup Part identity." & vbCrLf & "Key: " & systemMacroKey & vbCrLf & "Execution target: " & targetIdentity
    SystemMacroSetupPartIdentity = canonicalIdentity
End Function

' Purpose: Resolves system macro setup phase identity from the supplied/current ADC state, using `isMissing` and `SystemMacroDefinitionByKey` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   systemMacroKey (Input; String): Stable identity/key used to select the system macro key definition, row, workflow part, or managed object without relying on display text.
'   suppliedSystemMacroDefinition (Input Optional; Variant): Variant input representing supplied system macro definition; the routine accepts the caller-provided value in the form required by its existing
'   validation and conversion logic.
' Returns: String: Returns the system macro setup phase identity text value. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not
'   resolved.
Public Function SystemMacroSetupPhaseIdentity(ByVal systemMacroKey As String, Optional ByVal suppliedSystemMacroDefinition As Variant) As String
    Dim Definition As Variant
    Dim targetIdentity As String
    If isMissing(suppliedSystemMacroDefinition) Then
        Definition = SystemMacroDefinitionByKey(systemMacroKey)
    Else
        Definition = suppliedSystemMacroDefinition
    End If
    If IsEmpty(Definition) Then Exit Function
    If StrComp(SystemMacroExecutionKind(systemMacroKey, Definition), SYSTEM_MACRO_EXECUTION_SETUP_PHASE, vbTextCompare) <> 0 Then Exit Function
    targetIdentity = UCase$(SystemMacroExecutionTargetIdentity(systemMacroKey, Definition))
    If Len(targetIdentity) <> 1 Or InStr(1, "ABCDEFGHIJ", targetIdentity, vbBinaryCompare) = 0 Then Err.Raise vbObjectError + 9112, "SystemMacroSetupPhaseIdentity", "The authoritative Setup Phase SystemMacro definition references an unsupported phase identity." & vbCrLf & "Key: " & systemMacroKey & vbCrLf & "Execution target: " & targetIdentity
    SystemMacroSetupPhaseIdentity = targetIdentity
End Function

' Purpose: Resolves and returns system macro calculated title from resolved values from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   systemMacroDesignator (Input; String): System-macro designator text (for example its numeric/prefix marker) used when constructing or validating the displayed Ribbon title.
'   defaultTitleText (Input; String): Default title text text included in this procedure's user-facing or diagnostic output; blank handling follows the explicit branches in the routine.
' Returns: String: Returns the canonical display text for system macro calculated title from resolved values after applying the title/caption/label rules owned by this module; vbNullString represents no
'   applicable display text where supported.
Public Function SystemMacroCalculatedTitleFromResolvedValues(ByVal systemMacroDesignator As String, ByVal defaultTitleText As String) As String
    'Canonical physical-title formatter shared by Setup Part and non-Setup System Macros.
    Dim logicalTitle As String
    If Len(defaultTitleText) = 0 Then Exit Function
    If Len(systemMacroDesignator) = 0 Then Exit Function
