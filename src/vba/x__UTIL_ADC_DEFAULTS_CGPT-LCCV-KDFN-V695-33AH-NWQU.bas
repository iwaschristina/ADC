    If Len(ribbonStaticTag) = 0 Then Err.Raise vbObjectError + 7797, "AddManagedObjectDefinition", "A canonical managed-object definition has no explicitly assigned permanent Ribbon tag." & vbCrLf & "Identity: " & identityKey
    If StrComp(ribbonTitleOverride, Trim$(ribbonTitleOverride), vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 7820, "AddManagedObjectDefinition", "A canonical managed-object definition has noncanonical outer whitespace in RibbonTitle." & vbCrLf & "Identity: " & identityKey & vbCrLf & "RibbonTitle: [" & ribbonTitleOverride & "]"
    If directlyExposedOnRibbon And Len(ribbonTitleOverride) = 0 Then Err.Raise vbObjectError + 7821, "AddManagedObjectDefinition", "A Ribbon-visible canonical managed-object definition has no explicitly assigned Ribbon title." & vbCrLf & "Identity: " & identityKey
    If InStr(1, ribbonStaticTag, "|", vbBinaryCompare) > 0 Or InStr(1, ribbonStaticTag, ";", vbBinaryCompare) > 0 Then Err.Raise vbObjectError + 7798, "AddManagedObjectDefinition", "A canonical managed-object permanent Ribbon tag contains a reserved AccessUI tag delimiter." & vbCrLf & "Identity: " & identityKey & vbCrLf & "Ribbon tag: " & ribbonStaticTag
    If seen.Exists("RIBBONTAG|" & ribbonStaticTag) Then Err.Raise vbObjectError + 7799, "AddManagedObjectDefinition", "The canonical managed-object registry reuses an explicitly assigned permanent Ribbon tag." & vbCrLf & "Identity: " & identityKey & vbCrLf & "Ribbon tag: " & ribbonStaticTag
    seen.Add identityKey, True
    seen.Add "RIBBONTAG|" & ribbonStaticTag, True
    rows.Add Array(objectName, categoryCode, objectTypeCode, descriptionText, SortOrder, ownerSubsystem, definitionGroup, b1Family, foundationTable, foundationNonFormQuery, b1RepairOrder, referenceFamily, referenceRepairOrder, formDesignBuildFamily, formDesignBuildOrder, generatedFormBuildOrder, placementScope, ribbonTabKey, ribbonGroupKey, ribbonTitleOverride, logicalIdentity, directlyExposedOnRibbon, ribbonStaticTag)
End Sub

Private Function ManagedObjectDefinitionsByGroup(ByVal definitionGroup As String) As Collection
    ' INTENTIONAL FILTERED PARTITION: rows is a consumer-required subset/projection derived from the source enumerated by ManagedObjectDefinitionsByGroup; its membership is not independently authoritative.
    Dim rows As New Collection
    Dim rowData As Variant
    For Each rowData In ManagedObjectDefinitionRowsForRead()
        If StrComp(CStr(rowData(MANAGED_DEF_GROUP)), definitionGroup, vbTextCompare) = 0 Then rows.Add Array(CStr(rowData(MANAGED_DEF_OBJECT_NAME)), CStr(rowData(MANAGED_DEF_CATEGORY)), CStr(rowData(MANAGED_DEF_OBJECT_TYPE)), CStr(rowData(MANAGED_DEF_DESCRIPTION)), CLng(rowData(MANAGED_DEF_SORT_ORDER)))
    Next rowData
    Set ManagedObjectDefinitionsByGroup = rows
End Function

' Purpose: Attempts to get managed object definition; expected negative outcomes are returned through the function result and/or ByRef outputs rather than changing this routine's public contract.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   objectName (Input; String): Canonical or physical name identifying the object targeted by this operation.
'   objectTypeCode (Input; String): Canonical code used to classify or select the object type code behavior.
'   definitionData (Output; Variant): Receives the canonical managed-object definition row when objectName/objectTypeCode is found; it is not populated when the Function returns False.
' Returns: Boolean: True when the attempted operation completes and its required outputs/state are valid; False when the routine follows its normal non-success path. VBA errors may still be raised where
'   the existing code treats a condition as exceptional.
Public Function TryGetManagedObjectDefinition(ByVal objectName As String, ByVal objectTypeCode As String, ByRef definitionData As Variant) As Boolean
    Dim rowData As Variant
    Dim identityKey As String
    objectTypeCode = Trim$(objectTypeCode)
    If Len(objectName) = 0 Or Len(objectTypeCode) = 0 Then Exit Function
    identityKey = ManagedObjectDefinitionIdentityKey(objectName, objectTypeCode)
    If mManagedObjectDefinitionSnapshotDepth > 0 Then EnsureManagedObjectDefinitionSnapshot
    If Not mManagedObjectDefinitionSnapshotIndex Is Nothing Then
        If mManagedObjectDefinitionSnapshotIndex.Exists(identityKey) Then
            definitionData = mManagedObjectDefinitionSnapshotIndex(identityKey)
            TryGetManagedObjectDefinition = True
        End If
        Exit Function
    End If
    For Each rowData In ManagedObjectDefinitionRowsForRead()
        If StrComp(CStr(rowData(MANAGED_DEF_OBJECT_NAME)), objectName, vbTextCompare) = 0 Then
            If StrComp(CStr(rowData(MANAGED_DEF_OBJECT_TYPE)), objectTypeCode, vbTextCompare) = 0 Then
                definitionData = rowData
                TryGetManagedObjectDefinition = True
                Exit Function
            End If
        End If
    Next rowData
End Function

