Private Sub AddB1ResolvedFamilyName(ByRef familyNames As Collection, ByRef repairOrders As Collection, ByVal familyCode As String, ByVal objectName As String, ByVal repairOrder As Long)
    'Intended use: Preserves the existing canonical B1 repair-order and duplicate-order rules while one registry pass fills all family rosters.
    Dim insertIndex As Long
    If repairOrder <= 0 Then Err.Raise vbObjectError + 7792, "AddB1ResolvedFamilyName", "A B1 managed object is missing its canonical repair order." & vbCrLf & "Family: " & familyCode & vbCrLf & "Object: " & objectName
    For insertIndex = 1 To repairOrders.count
        If repairOrder < CLng(repairOrders(insertIndex)) Then
            familyNames.Add objectName, Before:=insertIndex
            repairOrders.Add repairOrder, Before:=insertIndex
            Exit Sub
        End If
        If repairOrder = CLng(repairOrders(insertIndex)) Then Err.Raise vbObjectError + 7793, "AddB1ResolvedFamilyName", "A B1 family contains a duplicate canonical repair order." & vbCrLf & "Family: " & familyCode & vbCrLf & "RepairOrder: " & CStr(repairOrder)
    Next insertIndex
    familyNames.Add objectName
    repairOrders.Add repairOrder
End Sub

' Purpose: Partitions the canonical managed-object registry into the ordered B1 lookup, core, macro-classification, System Macro, and Help Document table families and returns their structural-family count.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   lookupNames (Output; Collection): Receives the collection of lookup names assembled by this procedure; callers own the returned collection reference.
'   coreNames (Output; Collection): Receives the collection of core names assembled by this procedure; callers own the returned collection reference.
'   macroClassificationNames (Output; Collection): Receives the collection of macro classification names assembled by this procedure; callers own the returned collection reference.
'   systemMacroNames (Output; Collection): Receives the collection of system macro names assembled by this procedure; callers own the returned collection reference.
'   helpDocumentNames (Output; Collection): Receives the collection of help document names assembled by this procedure; callers own the returned collection reference.
'   structuralFamilyCount (Output; Long): Receives the structural family count produced by this operation.
' Returns: None (Sub). Results are returned through the documented ByRef parameters and/or the routine's database, UI, or module-state side effects.
Public Sub ResolveB1TableFamilies(ByRef lookupNames As Collection, ByRef coreNames As Collection, ByRef macroClassificationNames As Collection, ByRef systemMacroNames As Collection, ByRef helpDocumentNames As Collection, ByRef structuralFamilyCount As Long)
    'Intended use: Derives every B1 table family from one canonical managed-object registry pass for a caller-owned setup operation snapshot.
    ' INTENTIONAL ORDERED VIEW: lookupOrders, coreOrders, macroClassificationOrders, systemMacroOrders, helpDocumentOrders preserves the deterministic sequence required by ResolveB1TableFamilies; keyed-only or
    ' unordered storage would not preserve the consumer semantics.
    Dim lookupOrders As New Collection
    Dim coreOrders As New Collection
    Dim macroClassificationOrders As New Collection
    Dim systemMacroOrders As New Collection
    Dim helpDocumentOrders As New Collection
    Dim definitions As Collection
    Dim families As Object
    Dim rowData As Variant
    Dim familyCode As String
    Dim objectName As String
    Dim repairOrder As Long
    ' INTENTIONAL FILTERED PARTITION: lookupNames, coreNames, macroClassificationNames, systemMacroNames, helpDocumentNames is a consumer-required subset/projection derived from the source enumerated by
    ' ResolveB1TableFamilies; its membership is not independently authoritative.
    ' INTENTIONAL KEYED LOOKUP: families provides keyed membership/lookup over source rows or state already read by ResolveB1TableFamilies; it is a derived access path, not a second authority.
    Set lookupNames = New Collection
    Set coreNames = New Collection
    Set macroClassificationNames = New Collection
    Set systemMacroNames = New Collection
    Set helpDocumentNames = New Collection
    Set families = CreateObject("Scripting.Dictionary")
    families.CompareMode = vbTextCompare
    Set definitions = ManagedObjectDefinitionRowsForRead()
    For Each rowData In definitions
        familyCode = Trim$(CStr(rowData(MANAGED_DEF_B1_FAMILY)))
        If Len(familyCode) > 0 Then
            objectName = CStr(rowData(MANAGED_DEF_OBJECT_NAME))
            repairOrder = CLng(rowData(MANAGED_DEF_B1_REPAIR_ORDER))
            If families.Exists(familyCode) = False Then families.Add familyCode, True
            Select Case familyCode
                Case MANAGED_B1_FAMILY_LOOKUP
                    AddB1ResolvedFamilyName lookupNames, lookupOrders, familyCode, objectName, repairOrder
                Case MANAGED_B1_FAMILY_CORE
                    AddB1ResolvedFamilyName coreNames, coreOrders, familyCode, objectName, repairOrder
                Case MANAGED_B1_FAMILY_MACRO_CLASSIFICATION
                    AddB1ResolvedFamilyName macroClassificationNames, macroClassificationOrders, familyCode, objectName, repairOrder
                Case MANAGED_B1_FAMILY_SYSTEM_MACRO
                    AddB1ResolvedFamilyName systemMacroNames, systemMacroOrders, familyCode, objectName, repairOrder
                Case MANAGED_B1_FAMILY_HELP_DOCUMENT
                    AddB1ResolvedFamilyName helpDocumentNames, helpDocumentOrders, familyCode, objectName, repairOrder
                Case Else
