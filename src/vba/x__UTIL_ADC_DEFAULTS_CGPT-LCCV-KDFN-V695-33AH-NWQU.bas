Private Sub AddManagedObjectDefinition(ByVal rows As Collection, ByVal seen As Object, ByVal navigationPaneDefinitionByPlacementScope As Object, ByVal objectName As String, ByVal categoryCode As String, ByVal objectTypeCode As String, ByVal descriptionText As String, ByVal SortOrder As Long, ByVal ownerSubsystem As String, ByVal definitionGroup As String, ByVal b1Family As String, ByVal foundationTable As Boolean, ByVal foundationNonFormQuery As Boolean, _
    Optional ByVal b1RepairOrder As Long = 0, Optional ByVal referenceFamily As String = vbNullString, Optional ByVal referenceRepairOrder As Long = 0, Optional ByVal formDesignBuildFamily As String = vbNullString, Optional ByVal formDesignBuildOrder As Long = 0, Optional ByVal generatedFormBuildOrder As Long = 0, _
    Optional ByVal placementScope As String = vbNullString, Optional ByVal ribbonTabKey As String = vbNullString, Optional ByVal ribbonGroupKey As String = vbNullString, Optional ByVal ribbonTitleOverride As String = vbNullString, Optional ByVal logicalIdentity As String = vbNullString, Optional ByVal directlyExposedOnRibbon As Boolean = True, Optional ByVal ribbonStaticTag As String = vbNullString)
    Dim identityKey As String
    Dim navigationSettingKey As String
    Dim navigationDefinition As Variant
    Dim resolvedRibbonTabLabel As String
    Dim resolvedRibbonGroupLabel As String
    Dim resolvedRibbonGroupSortOrder As Long
    Dim ribbonTabRecognized As Boolean
    If StrComp(objectName, Trim$(objectName), vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 10137, "AddManagedObjectDefinition", "A canonical managed-object definition has noncanonical outer whitespace in ObjectName." & vbCrLf & "ObjectName: [" & objectName & "]"
    ' ADC-owned managed-object definitions are canonical source data. Validate canonical form here; do not normalize or repair definition text.
    If StrComp(objectTypeCode, Trim$(objectTypeCode), vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 7784, "AddManagedObjectDefinition", "A canonical managed-object definition has noncanonical outer whitespace in ObjectTypeCode." & vbCrLf & "ObjectTypeCode: [" & objectTypeCode & "]"
    If StrComp(placementScope, Trim$(placementScope), vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 7785, "AddManagedObjectDefinition", "A canonical managed-object definition has noncanonical outer whitespace in PlacementScope." & vbCrLf & "PlacementScope: [" & placementScope & "]"
    If StrComp(ribbonTabKey, Trim$(ribbonTabKey), vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 7786, "AddManagedObjectDefinition", "A canonical managed-object definition has noncanonical outer whitespace in RibbonTabKey." & vbCrLf & "RibbonTabKey: [" & ribbonTabKey & "]"
    If StrComp(ribbonGroupKey, Trim$(ribbonGroupKey), vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 7787, "AddManagedObjectDefinition", "A canonical managed-object definition has noncanonical outer whitespace in RibbonGroupKey." & vbCrLf & "RibbonGroupKey: [" & ribbonGroupKey & "]"
    If StrComp(ribbonStaticTag, Trim$(ribbonStaticTag), vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 7788, "AddManagedObjectDefinition", "A canonical managed-object definition has noncanonical outer whitespace in RibbonStaticTag." & vbCrLf & "RibbonStaticTag: [" & ribbonStaticTag & "]"
    If StrComp(ribbonStaticTag, UCase$(ribbonStaticTag), vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 7789, "AddManagedObjectDefinition", "A canonical managed-object permanent Ribbon tag must already be uppercase." & vbCrLf & "RibbonStaticTag: [" & ribbonStaticTag & "]"
    If Len(objectName) = 0 Or Len(objectTypeCode) = 0 Then Err.Raise vbObjectError + 7790, "AddManagedObjectDefinition", "A canonical managed-object definition has a blank identity." & vbCrLf & "ObjectName: " & objectName & vbCrLf & "ObjectType: " & objectTypeCode
    identityKey = UCase$(objectTypeCode) & "|" & UCase$(objectName)
    If seen.Exists(identityKey) Then Err.Raise vbObjectError + 7791, "AddManagedObjectDefinition", "The canonical managed-object registry contains a duplicate identity." & vbCrLf & "Identity: " & identityKey & vbCrLf & "Group: " & definitionGroup
    If Len(placementScope) = 0 Then Err.Raise vbObjectError + 7792, "AddManagedObjectDefinition", "A canonical managed-object definition has no Navigation Pane placement scope." & vbCrLf & "Identity: " & identityKey
    If Not navigationPaneDefinitionByPlacementScope Is Nothing Then
        If navigationPaneDefinitionByPlacementScope.Exists(placementScope) Then navigationDefinition = navigationPaneDefinitionByPlacementScope(placementScope)
    End If
    If IsArray(navigationDefinition) Then navigationSettingKey = CStr(navigationDefinition(3))
    If Len(navigationSettingKey) = 0 Then Err.Raise vbObjectError + 7793, "AddManagedObjectDefinition", "A canonical managed-object definition has an unrecognized Navigation Pane placement scope." & vbCrLf & "Identity: " & identityKey & vbCrLf & "PlacementScope: " & placementScope
    If Len(ribbonTabKey) = 0 Or Len(ribbonGroupKey) = 0 Then Err.Raise vbObjectError + 7794, "AddManagedObjectDefinition", "A canonical managed-object definition has incomplete Ribbon placement." & vbCrLf & "Identity: " & identityKey & vbCrLf & "RibbonTabKey: " & IIf(Len(ribbonTabKey) = 0, "(blank)", ribbonTabKey) & vbCrLf & "RibbonGroupKey: " & IIf(Len(ribbonGroupKey) = 0, "(blank)", ribbonGroupKey)
    resolvedRibbonTabLabel = GetRibbonTabLabelDefault(ribbonTabKey, ribbonTabRecognized)
    If ribbonTabRecognized = False Then Err.Raise vbObjectError + 7795, "AddManagedObjectDefinition", "A canonical managed-object definition has an unrecognized Ribbon tab assignment." & vbCrLf & "Identity: " & identityKey & vbCrLf & "RibbonTabKey: " & ribbonTabKey
    resolvedRibbonGroupLabel = RibbonManagedGroupLabel(ribbonGroupKey, resolvedRibbonGroupSortOrder)
    If Len(resolvedRibbonTabLabel) = 0 Or Len(resolvedRibbonGroupLabel) = 0 Or resolvedRibbonGroupSortOrder <= 0 Then Err.Raise vbObjectError + 7796, "AddManagedObjectDefinition", "A canonical managed-object definition has unresolvable Ribbon placement." & vbCrLf & "Identity: " & identityKey & vbCrLf & "RibbonTabKey: " & ribbonTabKey & vbCrLf & "RibbonGroupKey: " & ribbonGroupKey
