' Parameters:
'   tabKeyExpression (Input; String): Expression text representing the tab key calculation, RunCode target, SQL fragment, or UI binding interpreted by this routine.
' Returns: String: Returns the exact Access/VBA expression text for ribbon configured group sort bucket expression, including the quoting/callback syntax required by its generated UI or query consumer.
Public Function RibbonConfiguredGroupSortBucketExpression(ByVal tabKeyExpression As String) As String
    Dim normalizedExpression As String
    normalizedExpression = "UCase(Nz(" & tabKeyExpression & ",''))"
    RibbonConfiguredGroupSortBucketExpression = "IIf(" & normalizedExpression & "='" & UCase$(DEFAULT_RIBBON_TAB_KEY_SYSTEM_LOGICAL) & "' Or " & normalizedExpression & "='" & DEFAULT_RIBBON_TAB_KEY_SYSTEM_1 & "',0,IIf(" & normalizedExpression & "='" & DEFAULT_RIBBON_TAB_KEY_SYSTEM_2 & "',1,IIf(" & normalizedExpression & "='" & UCase$(DEFAULT_RIBBON_TAB_KEY_OBJECTS) & "',2,3)))"
End Function

' Purpose: Resolves ribbon configured group order by text from the supplied/current ADC state, using `RibbonConfiguredGroupSortBucketExpression` and `End` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
' Returns: String: Returns the formatted text produced by this routine. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not
'   resolved.
Public Function RibbonConfiguredGroupOrderByText() As String
    RibbonConfiguredGroupOrderByText = RibbonConfiguredGroupSortBucketExpression("G.[" & FIELD_RIBBON_TAB_KEY & "]") & ", Nz(G.[" & FIELD_RIBBON_TAB_KEY & "],''), Nz(G.[" & FIELD_RIBBON_GROUP_SORT_ORDER & "],Nz(G." & SQL_FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER & ",9999)), Nz(G." & SQL_FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER & ",9999), G.[" & FIELD_NAVIGATION_PANE_GROUP_NAME & "], Nz(G.[" & FIELD_NAVIGATION_PANE_GROUP_KEY & "],''), Nz(G." & SQL_FIELD_ID & ",0)"
End Function

' Purpose: Resolves ribbon compare tab order from the supplied/current ADC state, using `RibbonTabSortRank` and `StrComp` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   leftRow (Input; Variant): Variant input representing left row; the routine accepts the caller-provided value in the form required by its existing validation and conversion logic.
'   rightRow (Input; Variant): Variant input representing right row; the routine accepts the caller-provided value in the form required by its existing validation and conversion logic.
' Returns: Long: Returns the numeric ribbon compare tab order result; zero and other sentinel values retain the meanings established by the routine's existing implementation.
Public Function RibbonCompareTabOrder(ByVal leftRow As Variant, ByVal rightRow As Variant) As Long
    Dim leftKey As String
    Dim rightKey As String
    Dim compareValue As Long
    leftKey = UCase$(Trim$(CStr(leftRow(0))))
    rightKey = UCase$(Trim$(CStr(rightRow(0))))
    If RibbonTabSortRank(leftKey) < RibbonTabSortRank(rightKey) Then RibbonCompareTabOrder = -1: Exit Function
    If RibbonTabSortRank(leftKey) > RibbonTabSortRank(rightKey) Then RibbonCompareTabOrder = 1: Exit Function
    compareValue = StrComp(leftKey, rightKey, vbBinaryCompare)
    If compareValue <> 0 Then RibbonCompareTabOrder = Sgn(compareValue): Exit Function
    If CLng(leftRow(6)) < CLng(rightRow(6)) Then RibbonCompareTabOrder = -1: Exit Function
    If CLng(leftRow(6)) > CLng(rightRow(6)) Then RibbonCompareTabOrder = 1: Exit Function
    compareValue = StrComp(UCase$(Trim$(CStr(leftRow(2)))), UCase$(Trim$(CStr(rightRow(2)))), vbBinaryCompare)
    If compareValue <> 0 Then RibbonCompareTabOrder = Sgn(compareValue): Exit Function
    If CLng(leftRow(7)) < CLng(rightRow(7)) Then RibbonCompareTabOrder = -1: Exit Function
    If CLng(leftRow(7)) > CLng(rightRow(7)) Then RibbonCompareTabOrder = 1: Exit Function
    compareValue = StrComp(UCase$(Trim$(CStr(leftRow(3)))), UCase$(Trim$(CStr(rightRow(3)))), vbBinaryCompare)
    If compareValue <> 0 Then RibbonCompareTabOrder = Sgn(compareValue): Exit Function
    compareValue = StrComp(UCase$(Trim$(CStr(leftRow(4)))), UCase$(Trim$(CStr(rightRow(4)))), vbBinaryCompare)
    If compareValue <> 0 Then RibbonCompareTabOrder = Sgn(compareValue)
End Function

