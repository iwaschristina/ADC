' Purpose: Resolves default object name comparison key from the supplied/current ADC state, using `If` and `Next` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   objectName (Input; String): Canonical or physical name identifying the object targeted by this operation.
' Returns: String: Returns the resolved name produced by this routine. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not resolved.
Public Function DefaultObjectNameComparisonKey(ByVal objectName As String) As String
    'Intended use: Returns the canonical comparison key used by default Ribbon title and naming logic.
    Dim characterIndex As Long
    Dim characterText As String
    Dim characterCode As Long
    Dim keyText As String
    objectName = UCase$(Trim$(objectName))
    For characterIndex = 1 To Len(objectName)
        characterText = Mid$(objectName, characterIndex, 1)
        characterCode = AscW(characterText)
        If (characterCode >= 65 And characterCode <= 90) Or (characterCode >= 48 And characterCode <= 57) Then keyText = keyText & characterText
    Next characterIndex
    If Left$(keyText, Len(DEFAULT_UTILITY_SHORT_NAME)) = DEFAULT_UTILITY_SHORT_NAME Then keyText = Mid$(keyText, Len(DEFAULT_UTILITY_SHORT_NAME) + 1)
    DefaultObjectNameComparisonKey = keyText
End Function

' Purpose: Performs health severity sort expression by coordinating `End` while preserving this module's existing validation and error semantics.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   fieldExpression (Input; String): Expression text representing the field calculation, RunCode target, SQL fragment, or UI binding interpreted by this routine.
' Returns: String: Returns the exact Access/VBA expression text for health severity sort expression, including the quoting/callback syntax required by its generated UI or query consumer.
Public Function HealthSeveritySortExpression(ByVal fieldExpression As String) As String
    HealthSeveritySortExpression = "IIf(Nz(" & fieldExpression & ",'')='" & HEALTH_SEVERITY_CRITICAL & "',1,IIf(Nz(" & fieldExpression & ",'')='" & HEALTH_SEVERITY_ERROR & "',2,IIf(Nz(" & fieldExpression & ",'')='" & HEALTH_SEVERITY_WARNING & "',3,IIf(Nz(" & fieldExpression & ",'')='" & HEALTH_SEVERITY_INFO & "',4,9))))"
End Function

' Purpose: Performs manual review sort expression by coordinating `End` while preserving this module's existing validation and error semantics.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   manualReviewStatusExpression (Input; String): Status value describing the manual review expression lifecycle/review/result state consumed or emitted by the routine.
'   configurationStatusExpression (Input; String): Status value describing the configuration expression lifecycle/review/result state consumed or emitted by the routine.
' Returns: String: Returns the exact Access/VBA expression text for manual review sort expression, including the quoting/callback syntax required by its generated UI or query consumer.
Public Function ManualReviewSortExpression(ByVal manualReviewStatusExpression As String, ByVal configurationStatusExpression As String) As String
    ManualReviewSortExpression = "IIf(Nz(" & manualReviewStatusExpression & ",'')='" & MANUAL_REVIEW_STATUS_BLOCKED & "',1,IIf(Nz(" & configurationStatusExpression & ",'')='" & CONFIGURATION_STATUS_INVALID & "',2,IIf(Nz(" & manualReviewStatusExpression & ",'')='" & MANUAL_REVIEW_STATUS_NEEDS_REVIEW & "',3,9)))"
End Function

' Purpose: Resolves and returns ribbon metadata candidate order by text from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   objectName (Input; String): Physical Access object name identifying the database object targeted by the operation.
'   includeSortOrder (Input; Boolean): True includes sort order in this operation; False excludes that optional content while leaving the rest of the operation unchanged.
' Returns: String: Returns the resolved ribbon metadata candidate order by text text in the canonical representation consumed by this module's caller; vbNullString represents no applicable value where the
'   existing contract permits it.
Public Function RibbonMetadataCandidateOrderByText(ByVal objectName As String, ByVal includeSortOrder As Boolean) As String
    Dim quotedName As String
    quotedName = "'" & Replace(objectName, "'", "''") & "'"
    RibbonMetadataCandidateOrderByText = "IIf(" & SQL_FIELD_OBJECT_NAME & "=" & quotedName & ",0,1)"
    If includeSortOrder Then RibbonMetadataCandidateOrderByText = RibbonMetadataCandidateOrderByText & ", Nz(" & SQL_FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER & ",9999)"
End Function

