        Case LCase$(FIELD_ROW_KIND)
            GeneratedFormLookupDefinition = Array(GENERATED_FORM_LOOKUP_KIND_VALUE_LIST, ROW_KIND_CONFIGURATION & ";" & ROW_KIND_CANDIDATE, vbNullString, vbNullString, vbNullString, Empty, vbNullString, True)
        Case LCase$(FIELD_CONFIGURATION_STATUS)
            GeneratedFormLookupDefinition = Array(GENERATED_FORM_LOOKUP_KIND_TWO_COLUMN, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, CANON_TABLE_LOGICAL_ID_CONFIGURATIONSTATUS_LOOKUP), FIELD_VALUE_TEXT, FIELD_VALUE_TEXT, vbNullString, Split(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER & "|" & FIELD_VALUE_TEXT, "|"), "0;2", True)
        Case LCase$(FIELD_CANDIDATE_STATUS)
            GeneratedFormLookupDefinition = Array(GENERATED_FORM_LOOKUP_KIND_TWO_COLUMN, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, CANON_TABLE_LOGICAL_ID_CANDIDATESTATUS_LOOKUP), FIELD_VALUE_TEXT, FIELD_VALUE_TEXT, vbNullString, Split(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER & "|" & FIELD_VALUE_TEXT, "|"), "0;2", True)
        Case LCase$(FIELD_MACRO_ACTION)
