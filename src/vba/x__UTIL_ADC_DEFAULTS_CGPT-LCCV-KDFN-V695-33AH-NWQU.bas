' Purpose: Performs custom macro launcher review field description by coordinating `BuildCustomMacroLauncherReviewConfigidLongFieldDescription` and `BuildCustomMacroLauncherReviewMacrokeyLongFieldDescription` while
'     preserving this module's existing validation and error semantics.
' Public role: Public ADC API. The routine is intentionally callable outside its defining procedure/module and may be used directly by Access/VBA or late-bound callers when that API surface is needed.
' Parameters:
'   fieldName (Input; String): Field name identifying the table/query field or bound control source the routine evaluates or modifies.
' Returns: String: Returns the canonical description text for custom macro launcher review field description, suitable for the managed catalog/field/object metadata destination; vbNullString indicates that no
'   description applies where allowed.
Public Function CustomMacroLauncherReviewFieldDescription(ByVal fieldName As String) As String
    Select Case LCase$(Trim$(fieldName))
        Case LCase$(FIELD_ID): CustomMacroLauncherReviewFieldDescription = FIELD_DESC_LONG_CUSTOM_MACRO_LAUNCHER_REVIEW_ID
        Case LCase$(FIELD_REVIEW_BATCH_ID): CustomMacroLauncherReviewFieldDescription = FIELD_DESC_LONG_CUSTOM_MACRO_LAUNCHER_REVIEW_REVIEWBATCHID
        Case LCase$(FIELD_REVIEWED_ON): CustomMacroLauncherReviewFieldDescription = FIELD_DESC_LONG_CUSTOM_MACRO_LAUNCHER_REVIEW_REVIEWEDON
        Case LCase$(FIELD_SEVERITY): CustomMacroLauncherReviewFieldDescription = FIELD_DESC_LONG_CUSTOM_MACRO_LAUNCHER_REVIEW_SEVERITY
        Case LCase$(FIELD_ISSUE_TYPE): CustomMacroLauncherReviewFieldDescription = FIELD_DESC_LONG_CUSTOM_MACRO_LAUNCHER_REVIEW_ISSUETYPE
        Case LCase$(FIELD_CONFIG_ID): CustomMacroLauncherReviewFieldDescription = BuildCustomMacroLauncherReviewConfigidLongFieldDescription()
        Case LCase$(FIELD_MACRO_KEY): CustomMacroLauncherReviewFieldDescription = BuildCustomMacroLauncherReviewMacrokeyLongFieldDescription()
        Case LCase$(FIELD_MACRO_TITLE): CustomMacroLauncherReviewFieldDescription = FIELD_DESC_LONG_CUSTOM_MACRO_LAUNCHER_REVIEW_MACROTITLE
        Case LCase$(FIELD_GENERATED_MACRO_OBJECT_NAME): CustomMacroLauncherReviewFieldDescription = FIELD_DESC_LONG_CUSTOM_MACRO_LAUNCHER_REVIEW_GENERATEDMACROOBJECTNAME
        Case LCase$(FIELD_CONTROL_NAME): CustomMacroLauncherReviewFieldDescription = FIELD_DESC_LONG_CUSTOM_MACRO_LAUNCHER_REVIEW_CONTROLNAME
        Case LCase$(FIELD_CONTROL_CAPTION): CustomMacroLauncherReviewFieldDescription = FIELD_DESC_LONG_CUSTOM_MACRO_LAUNCHER_REVIEW_CONTROLCAPTION
        Case LCase$(FIELD_EXPECTED_CAPTION): CustomMacroLauncherReviewFieldDescription = BuildCustomMacroLauncherReviewExpectedcaptionLongFieldDescription()
