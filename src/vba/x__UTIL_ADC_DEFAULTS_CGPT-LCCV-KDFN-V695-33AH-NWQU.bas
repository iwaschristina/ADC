Private Function BuildSystemMacroDefinitions() As Collection
    ' AUTHORITATIVE DEFINITION/CACHE OWNER: rows owns the complete System Macro definition set; editable names/captions come from the centralized naming constants above.
    Dim rows As New Collection
    Dim a2TableNames As String
    Dim a3QueryNames As String
    Dim a4TableNames As String
    Dim a4QueryNames As String
    Dim b1TableNames As String
    Dim managedDefinitionSnapshotAcquired As Boolean
    'One nested managed-definition snapshot owns every source projection needed by this build. Existing outer operation snapshots are preserved by the depth-counted lifecycle.
    BeginManagedObjectDefinitionSnapshot
    managedDefinitionSnapshotAcquired = True
    On Error GoTo SourceMetadataErrHandler
    a2TableNames = PipeDelimitedCollectionNames(FoundationRequiredTableNames())
    a3QueryNames = PipeDelimitedCollectionNames(FoundationRequiredNonFormQueryNames())
    A4MaterialTargetNames a4TableNames, a4QueryNames
    b1TableNames = B1MaterialTargetTableNames()
    EndManagedObjectDefinitionSnapshot
    managedDefinitionSnapshotAcquired = False
    On Error GoTo 0
    AddSystemMacroDefinitionsPart1 rows, a4TableNames, a4QueryNames
    AddSystemMacroDefinitionsPart2 rows
    AddSystemMacroDefinitionsPart3 rows, a2TableNames, a3QueryNames
    AddSystemMacroDefinitionsPart4 rows, a4TableNames, a4QueryNames, b1TableNames
    AddSystemMacroDefinitionsSetupPhases rows
    ValidateSystemMacroSetupPartRawTitles rows
    Set rows = SystemMacroDefinitionsWithCompositeSources(rows)
    ValidateSystemMacroRibbonStaticTags rows
    Set BuildSystemMacroDefinitions = rows
    Exit Function
SourceMetadataErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    On Error Resume Next
    If managedDefinitionSnapshotAcquired Then EndManagedObjectDefinitionSnapshot
    On Error GoTo 0
    Err.Raise savedErrNumber, savedErrSource, savedErrDescription
End Function

Private Sub A4MaterialTargetNames(ByRef tableNames As String, ByRef queryNames As String)
    Dim inventoryNames As Collection
    Dim loadedVbaAnalysisNames As Collection
    Dim crosswalkNames As Collection
    Dim referenceQueryNames As Collection
    ResolveReferenceFamilies inventoryNames, loadedVbaAnalysisNames, crosswalkNames, referenceQueryNames
    tableNames = PipeDelimitedCollectionNames(inventoryNames)
    tableNames = AppendUniquePipeDelimitedNames(tableNames, PipeDelimitedCollectionNames(loadedVbaAnalysisNames))
    tableNames = AppendUniquePipeDelimitedNames(tableNames, PipeDelimitedCollectionNames(crosswalkNames))
    queryNames = PipeDelimitedCollectionNames(referenceQueryNames)
End Sub

Private Function B1MaterialTargetTableNames() As String
    Dim lookupNames As Collection
    Dim coreNames As Collection
    Dim macroClassificationNames As Collection
    Dim systemMacroNames As Collection
    Dim helpDocumentNames As Collection
    Dim structuralFamilyCount As Long
    ResolveB1TableFamilies lookupNames, coreNames, macroClassificationNames, systemMacroNames, helpDocumentNames, structuralFamilyCount
    B1MaterialTargetTableNames = PipeDelimitedCollectionNames(lookupNames)
    B1MaterialTargetTableNames = AppendUniquePipeDelimitedNames(B1MaterialTargetTableNames, PipeDelimitedCollectionNames(coreNames))
    B1MaterialTargetTableNames = AppendUniquePipeDelimitedNames(B1MaterialTargetTableNames, PipeDelimitedCollectionNames(macroClassificationNames))
    B1MaterialTargetTableNames = AppendUniquePipeDelimitedNames(B1MaterialTargetTableNames, PipeDelimitedCollectionNames(systemMacroNames))
    B1MaterialTargetTableNames = AppendUniquePipeDelimitedNames(B1MaterialTargetTableNames, PipeDelimitedCollectionNames(helpDocumentNames))
End Function

Private Function SystemMacroDefinitionsWithCompositeSources(ByVal sourceRows As Collection) As Collection
    'Composite Setup and Phase commands materially execute their child Setup Parts. Derive their table/query source lists from those exact child definitions so the lists cannot drift independently.
    Dim phaseTables As Object
    Dim phaseQueries As Object
    Dim resultRows As New Collection
    Dim definitionData As Variant
    Dim copiedDefinition As Variant
    Dim executionKind As String
    Dim phaseIdentity As String
    Dim allSetupTables As String
    Dim allSetupQueries As String
    Set phaseTables = CreateObject("Scripting.Dictionary")
    phaseTables.CompareMode = vbTextCompare
    Set phaseQueries = CreateObject("Scripting.Dictionary")
    phaseQueries.CompareMode = vbTextCompare
    For Each definitionData In sourceRows
        executionKind = Trim$(CStr(definitionData(SYSTEM_MACRO_DEF_EXECUTION_KIND)))
        If StrComp(executionKind, SYSTEM_MACRO_EXECUTION_SETUP_PART, vbTextCompare) = 0 Then
            phaseIdentity = Left$(Trim$(CStr(definitionData(SYSTEM_MACRO_DEF_EXECUTION_TARGET_IDENTITY))), 1)
            If phaseTables.Exists(phaseIdentity) = False Then phaseTables.Add phaseIdentity, vbNullString
            If phaseQueries.Exists(phaseIdentity) = False Then phaseQueries.Add phaseIdentity, vbNullString
            phaseTables(phaseIdentity) = AppendUniquePipeDelimitedNames(CStr(phaseTables(phaseIdentity)), CStr(definitionData(SYSTEM_MACRO_DEF_TARGET_TABLE_NAMES)))
            phaseQueries(phaseIdentity) = AppendUniquePipeDelimitedNames(CStr(phaseQueries(phaseIdentity)), CStr(definitionData(SYSTEM_MACRO_DEF_TARGET_QUERY_NAMES)))
            allSetupTables = AppendUniquePipeDelimitedNames(allSetupTables, CStr(definitionData(SYSTEM_MACRO_DEF_TARGET_TABLE_NAMES)))
            allSetupQueries = AppendUniquePipeDelimitedNames(allSetupQueries, CStr(definitionData(SYSTEM_MACRO_DEF_TARGET_QUERY_NAMES)))
        End If
    Next definitionData
    For Each definitionData In sourceRows
        copiedDefinition = definitionData
        executionKind = Trim$(CStr(copiedDefinition(SYSTEM_MACRO_DEF_EXECUTION_KIND)))
        If StrComp(executionKind, SYSTEM_MACRO_EXECUTION_FULL_SETUP, vbTextCompare) = 0 Then
            copiedDefinition(SYSTEM_MACRO_DEF_TARGET_TABLE_NAMES) = allSetupTables
            copiedDefinition(SYSTEM_MACRO_DEF_TARGET_QUERY_NAMES) = allSetupQueries
        ElseIf StrComp(executionKind, SYSTEM_MACRO_EXECUTION_SETUP_PHASE, vbTextCompare) = 0 Then
            phaseIdentity = Trim$(CStr(copiedDefinition(SYSTEM_MACRO_DEF_EXECUTION_TARGET_IDENTITY)))
            copiedDefinition(SYSTEM_MACRO_DEF_TARGET_TABLE_NAMES) = CStr(phaseTables(phaseIdentity))
            copiedDefinition(SYSTEM_MACRO_DEF_TARGET_QUERY_NAMES) = CStr(phaseQueries(phaseIdentity))
        End If
        resultRows.Add copiedDefinition
    Next definitionData
    Set SystemMacroDefinitionsWithCompositeSources = resultRows
End Function

Private Sub ValidateSystemMacroSetupPartRawTitles(ByVal rows As Collection)
    Dim definitionData As Variant
    Dim systemMacroKey As String
    Dim rawTitle As String
    For Each definitionData In rows
        If StrComp(Trim$(CStr(definitionData(SYSTEM_MACRO_DEF_EXECUTION_KIND))), SYSTEM_MACRO_EXECUTION_SETUP_PART, vbTextCompare) = 0 Then
            systemMacroKey = Trim$(CStr(definitionData(0)))
            rawTitle = CStr(definitionData(2))
            If Len(rawTitle) > MAX_ACCESS_OBJECT_NAME_LENGTH Then Err.Raise vbObjectError + 9113, "ValidateSystemMacroSetupPartRawTitles", "The authoritative raw Setup Part title exceeds the Access object-name limit." & vbCrLf & "SystemMacroKey: " & systemMacroKey & vbCrLf & "Raw title: " & rawTitle & vbCrLf & "Length: " & CStr(Len(rawTitle)) & vbCrLf & "Maximum: " & CStr(MAX_ACCESS_OBJECT_NAME_LENGTH)
        End If
    Next definitionData
End Sub

Private Sub ValidateSystemMacroRibbonStaticTags(ByVal rows As Collection)
    'Permanent System Macro Ribbon tags are authored data. Never derive, renumber, or reuse them automatically.
    Dim usedTags As Object
    Dim definitionData As Variant
    Dim systemMacroKey As String
    Dim staticTag As String
    ' INTENTIONAL KEYED LOOKUP: usedTags provides keyed membership/lookup over source rows or state already read by ValidateSystemMacroRibbonStaticTags; it is a derived access path, not a second authority.
    Set usedTags = CreateObject("Scripting.Dictionary")
    usedTags.CompareMode = vbTextCompare
    For Each definitionData In rows
        systemMacroKey = Trim$(CStr(definitionData(0)))
        If UBound(definitionData) < SYSTEM_MACRO_DEF_RIBBON_STATIC_TAG Then Err.Raise vbObjectError + 7812, "ValidateSystemMacroRibbonStaticTags", "A canonical System Macro definition has no explicitly assigned permanent Ribbon tag." & vbCrLf & "SystemMacroKey: " & systemMacroKey
        staticTag = Trim$(CStr(definitionData(SYSTEM_MACRO_DEF_RIBBON_STATIC_TAG)))
        If Len(staticTag) = 0 Then Err.Raise vbObjectError + 7813, "ValidateSystemMacroRibbonStaticTags", "A canonical System Macro definition has a blank permanent Ribbon tag." & vbCrLf & "SystemMacroKey: " & systemMacroKey
        If InStr(1, staticTag, "|", vbBinaryCompare) > 0 Or InStr(1, staticTag, ";", vbBinaryCompare) > 0 Then Err.Raise vbObjectError + 7814, "ValidateSystemMacroRibbonStaticTags", "A canonical System Macro permanent Ribbon tag contains a reserved AccessUI tag delimiter." & vbCrLf & "SystemMacroKey: " & systemMacroKey & vbCrLf & "Ribbon tag: " & staticTag
        If usedTags.Exists(staticTag) Then Err.Raise vbObjectError + 7815, "ValidateSystemMacroRibbonStaticTags", "Two canonical System Macros reuse the same explicitly assigned permanent Ribbon tag." & vbCrLf & "SystemMacroKey: " & systemMacroKey & vbCrLf & "Ribbon tag: " & staticTag
        usedTags.Add staticTag, systemMacroKey
    Next definitionData
End Sub

' Purpose: Initializes system macro definition snapshot, coordinating `End` as the implementation requires.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
' Returns: None (Sub). The procedure communicates its result through its database, UI, trace, or module-state side effects and raises errors where its implementation requires it.
Public Sub BeginSystemMacroDefinitionSnapshot()
    'Arms a lazy operation-scoped index so early Setup phases do not pay the full System Macro construction cost before any System Macro metadata is needed.
    mSystemMacroDefinitionSnapshotEnabled = True
End Sub

Private Sub EnsureSystemMacroDefinitionSnapshotBuilt()
    ' INTENTIONAL ROW + INDEX PAIR: Rows preserve deterministic System Macro enumeration; the case-insensitive index provides keyed lookup over that same operation snapshot.
    If mSystemMacroDefinitionSnapshotEnabled = False Then Exit Sub
    If Not mSystemMacroDefinitionSnapshotRows Is Nothing Then Exit Sub
    On Error GoTo ErrHandler
    Dim rows As Collection
    Dim indexByKey As Object
    Dim indexByDesignator As Object
    Dim definitionData As Variant
    Dim systemMacroKey As String
    Dim systemMacroDesignator As String
    Set rows = BuildSystemMacroDefinitions()
    ' INTENTIONAL KEYED LOOKUP: indexByKey provides keyed membership/lookup over source rows or state already read by EnsureSystemMacroDefinitionSnapshotBuilt; it is a derived access path, not a second authority.
    Set indexByKey = CreateObject("Scripting.Dictionary")
    indexByKey.CompareMode = vbTextCompare
    Set indexByDesignator = CreateObject("Scripting.Dictionary")
    indexByDesignator.CompareMode = vbTextCompare
    For Each definitionData In rows
        systemMacroKey = Trim$(CStr(definitionData(0)))
        If Len(systemMacroKey) = 0 Then Err.Raise vbObjectError + 7808, "EnsureSystemMacroDefinitionSnapshotBuilt", "A canonical System Macro definition has a blank key."
        If indexByKey.Exists(systemMacroKey) Then Err.Raise vbObjectError + 7809, "EnsureSystemMacroDefinitionSnapshotBuilt", "The canonical System Macro definition snapshot contains a duplicate key." & vbCrLf & "SystemMacroKey: " & systemMacroKey
        If UBound(definitionData) < SYSTEM_MACRO_DEF_SORT_ORDER Then Err.Raise vbObjectError + 7810, "EnsureSystemMacroDefinitionSnapshotBuilt", "A canonical System Macro definition is missing table/query target or independent SortOrder metadata fields." & vbCrLf & "SystemMacroKey: " & systemMacroKey
        systemMacroDesignator = CStr(definitionData(1))
        If Len(systemMacroDesignator) = 0 Then Err.Raise vbObjectError + 7811, "EnsureSystemMacroDefinitionSnapshotBuilt", "A canonical System Macro definition has a blank SystemMacroDesignator." & vbCrLf & "SystemMacroKey: " & systemMacroKey
        If indexByDesignator.Exists(systemMacroDesignator) Then Err.Raise vbObjectError + 7812, "EnsureSystemMacroDefinitionSnapshotBuilt", "The canonical System Macro definition snapshot contains a duplicate SystemMacroDesignator." & vbCrLf & "SystemMacroDesignator: " & systemMacroDesignator
        If Len(CStr(definitionData(SYSTEM_MACRO_DEF_RIBBON_TITLE))) = 0 Then Err.Raise vbObjectError + 7813, "EnsureSystemMacroDefinitionSnapshotBuilt", "A canonical System Macro definition has a blank Ribbon title." & vbCrLf & "SystemMacroKey: " & systemMacroKey
        If StrComp(CStr(definitionData(SYSTEM_MACRO_DEF_RIBBON_TITLE)), Trim$(CStr(definitionData(SYSTEM_MACRO_DEF_RIBBON_TITLE))), vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 7823, "EnsureSystemMacroDefinitionSnapshotBuilt", "A canonical System Macro definition has noncanonical outer whitespace in its explicit Ribbon title." & vbCrLf & "SystemMacroKey: " & systemMacroKey & vbCrLf & "RibbonTitle: [" & CStr(definitionData(SYSTEM_MACRO_DEF_RIBBON_TITLE)) & "]"
        indexByKey.Add systemMacroKey, definitionData
        indexByDesignator.Add systemMacroDesignator, True
    Next definitionData
    Set mSystemMacroDefinitionSnapshotRows = rows
    Set mSystemMacroDefinitionSnapshotIndex = indexByKey
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    Set mSystemMacroDefinitionSnapshotIndex = Nothing
    Set mSystemMacroDefinitionSnapshotRows = Nothing
    Err.Raise savedErrNumber, "EnsureSystemMacroDefinitionSnapshotBuilt", "Could not build the operation-scoped System Macro definition index." & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Sub

' Purpose: Closes system macro definition snapshot, coordinating `End` as the implementation requires.
