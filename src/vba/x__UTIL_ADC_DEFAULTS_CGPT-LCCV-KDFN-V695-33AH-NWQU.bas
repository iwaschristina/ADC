Public Function HelpDocumentDefinitions() As Collection
    ' CANONICAL AUTHORITY: rows owns the optional Defaults-defined Help Document seed set. The default set is intentionally empty; normal Setup does not seed Help_Docs from this collection, and user-created
    ' Help_Docs rows remain authoritative operational inputs when Setup Help maintenance is enabled.
    Dim rows As New Collection
    Set HelpDocumentDefinitions = rows
End Function

' Purpose: Resolves and returns help document macro number from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   helpDocumentNumber (Input; Long): Numeric identifier or ordinal for the help document item processed or reported by this operation.
' Returns: Long: Returns the canonical numeric identifier/number for help document macro number as defined by Defaults/current managed metadata.
Public Function GetHelpDocumentMacroNumber(ByVal helpDocumentNumber As Long) As Long
    GetHelpDocumentMacroNumber = CLng(CStr(DEFAULT_HELP_DOCUMENT_MACRO_PREFIX) & Format$(helpDocumentNumber, "00"))
End Function

' Purpose: Resolves and returns help document ribbon static tag from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   helpDocumentNumber (Input; Long): Numeric identifier or ordinal for the help document item processed or reported by this operation.
' Returns: String: Returns the resolved help document ribbon static tag text in the canonical representation consumed by this module's caller; vbNullString represents no applicable value where the existing
'   contract permits it.
Public Function GetHelpDocumentRibbonStaticTag(ByVal helpDocumentNumber As Long) As String
    If helpDocumentNumber <= 0 Then Err.Raise vbObjectError + 6889, "GetHelpDocumentRibbonStaticTag", "HelpDocumentNumber must be greater than zero before a permanent Ribbon tag can be derived." & vbCrLf & "HelpDocumentNumber: " & CStr(helpDocumentNumber)
    GetHelpDocumentRibbonStaticTag = "H" & Format$(helpDocumentNumber, "000")
End Function

' Purpose: Resolves catalog setup action definitions from the supplied/current ADC state, using `End` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
' Returns: Collection: Returns the ordered Collection assembled by the routine; callers receive the object reference and should treat its membership/order according to the routine contract.
Public Function CatalogSetupActionDefinitions() As Collection
    ' CANONICAL AUTHORITY: rows owns the in-memory definition set constructed by CatalogSetupActionDefinitions; downstream consumers derive views from this set rather than create a competing authority.
    Dim rows As New Collection
    rows.Add Array(ADCAT_SETUP_VERIFY_CODEDB_OBJECT, "Verify CodeDb object", _
        "Verify a CodeDb-owned managed object and group it only when CodeDb is the active database.", 10)
    rows.Add Array(ADCAT_SETUP_CREATE_OR_REPAIR_CODEDB, "Create or repair CodeDb", _
        "Create or repair a CodeDb-owned object, table, or saved query used by the " & DEFAULT_UTILITY_LONG_NAME & " utility.", 20)
    rows.Add Array(ADCAT_SETUP_GENERATE_FROM_CONFIG, "Generate from config", _
        "Generate an Access object from catalog/config data and action payload rows.", 30)
    rows.Add Array(ADCAT_SETUP_GROUP_EXISTING, "Group existing", _
        "Only copy or add an existing object shortcut into the configured Navigation Pane group.", 40)
    rows.Add Array(ADCAT_SETUP_REFERENCE_ONLY, "Reference only", _
        "Catalog row documents a CodeDb-owned object or callable target that is not generated as HostDb macro output.", 50)
    rows.Add Array(ADCAT_SETUP_DATA_TABLE, "Data table", _
        "Runtime/config/catalog data table behavior. Setup may create/repair schema separately and group the table.", 60)
    Set CatalogSetupActionDefinitions = rows
End Function

Private Function LookupEditorGeneratedLogicalID(ByVal sourceLogicalID As String) As String
    If Len(sourceLogicalID) = 0 Then Exit Function
    If StrComp(Left$(sourceLogicalID, 4), "ADC_", vbTextCompare) = 0 Then sourceLogicalID = Mid$(sourceLogicalID, 5)
    LookupEditorGeneratedLogicalID = "Lookup_Edit_" & sourceLogicalID
End Function

Private Sub AddLookupEditorPolicyDefinition(ByVal rows As Collection, ByVal sourceLogicalID As String, ByVal policyCode As String, ByVal displayName As String, ByVal codeFieldName As String, ByVal listFieldsText As String, ByVal orderFieldsText As String, ByVal allowAdditions As Boolean, ByVal allowDeletions As Boolean, ByVal allowCodeEdit As Boolean, Optional ByVal existingEditorLogicalID As String = vbNullString, Optional ByVal generatedPhysicalName As String = vbNullString, Optional ByVal ribbonTitle As String = vbNullString)
    Dim editorLogicalID As String
    If StrComp(policyCode, LOOKUP_EDITOR_POLICY_GENERATED, vbTextCompare) = 0 Then
        editorLogicalID = LookupEditorGeneratedLogicalID(sourceLogicalID)
        If Len(generatedPhysicalName) = 0 Then Err.Raise vbObjectError + 7906, "AddLookupEditorPolicyDefinition", "Generated lookup-editor physical name is required." & vbCrLf & "Source logical ID: " & sourceLogicalID
        If Len(ribbonTitle) = 0 Then Err.Raise vbObjectError + 7824, "AddLookupEditorPolicyDefinition", "Generated lookup-editor Ribbon title must be explicitly assigned in Defaults." & vbCrLf & "Source logical ID: " & sourceLogicalID
        If StrComp(ribbonTitle, Trim$(ribbonTitle), vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 7825, "AddLookupEditorPolicyDefinition", "Generated lookup-editor Ribbon title contains outer whitespace." & vbCrLf & "Source logical ID: " & sourceLogicalID & vbCrLf & "RibbonTitle: [" & ribbonTitle & "]"
    ElseIf StrComp(policyCode, LOOKUP_EDITOR_POLICY_EXISTING_MANAGED_FRM, vbTextCompare) = 0 Then
        editorLogicalID = existingEditorLogicalID
    End If
    rows.Add Array(sourceLogicalID, policyCode, editorLogicalID, displayName, codeFieldName, listFieldsText, orderFieldsText, allowAdditions, allowDeletions, allowCodeEdit, generatedPhysicalName, ribbonTitle)
End Sub

