' Purpose: Resolves user data table scope definitions from the supplied/current ADC state, using `CreateObject` and `ManagedObjectPhysicalName` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
' Returns: Collection: Returns the ordered Collection assembled by the routine; callers receive the object reference and should treat its membership/order according to the routine contract.
Public Function UserDataTableScopeDefinitions() As Collection
    ' CANONICAL USER-DATA AUTHORITY: Backup All ADC User Data and Reset All ADC User Data must consume this exact set.
    ' Row: logical identity, physical table name, authoritative owner, backup behavior, reset contract, canonical post-reset owner.
    ' Backup copies are intentionally absent so backup scope cannot recurse.
    Dim rows As New Collection
    Dim seen As Object
    Dim lookupTableName As Variant
    Dim lookupLogicalID As String
    Set seen = CreateObject("Scripting.Dictionary")
    seen.CompareMode = vbTextCompare
    AddUserDataTableScopeDefinition rows, seen, CANON_TABLE_LOGICAL_ID_CONFIG, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, CANON_TABLE_LOGICAL_ID_CONFIG), "TABLES", "FullDataCopy", "CoreTable", "RepairCoreDataTableFoundationForSetup"
    AddUserDataTableScopeDefinition rows, seen, CANON_TABLE_LOGICAL_ID_CANDIDATES, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, CANON_TABLE_LOGICAL_ID_CANDIDATES), "TABLES", "FullDataCopy", "CoreTable", "RepairCoreDataTableFoundationForSetup"
    AddUserDataTableScopeDefinition rows, seen, DEFAULT_SETTINGS_TABLE_LOGICAL_ID, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_SETTINGS_TABLE_LOGICAL_ID), "TABLES", "FullDataCopy", "CoreTable", "RepairCoreDataTableFoundationForSetup"
    AddUserDataTableScopeDefinition rows, seen, CANON_TABLE_LOGICAL_ID_MACROCATEGORIES, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, CANON_TABLE_LOGICAL_ID_MACROCATEGORIES), "TABLES", "FullDataCopy", "CoreTable", "RepairCoreDataTableFoundationForSetup"
    AddUserDataTableScopeDefinition rows, seen, CANON_TABLE_LOGICAL_ID_MACROSUBCATEGORIES, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, CANON_TABLE_LOGICAL_ID_MACROSUBCATEGORIES), "TABLES", "FullDataCopy", "CoreTable", "RepairCoreDataTableFoundationForSetup"
    AddUserDataTableScopeDefinition rows, seen, "ADC_NavigationPaneGroups", ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_NavigationPaneGroups"), "CATALOG", "FullDataCopy", "CatalogTable", "RepairCatalogReferenceDataForSetup"
    AddUserDataTableScopeDefinition rows, seen, "ADC_SystemMacros", ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros"), "CATALOG", "FullDataCopy", "CatalogTable", "RepairSystemHelpMacroDefinitionsForSetup"
    AddUserDataTableScopeDefinition rows, seen, CANON_TABLE_LOGICAL_ID_HELPDOCUMENTS, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, CANON_TABLE_LOGICAL_ID_HELPDOCUMENTS), "CATALOG", "FullDataCopy", "CatalogTable", "RepairSystemHelpMacroDefinitionsForSetup"
    AddUserDataTableScopeDefinition rows, seen, DEFAULT_TERMINOLOGY_TABLE_LOGICAL_ID, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_TERMINOLOGY_TABLE_LOGICAL_ID), "TABLES", "FullDataCopy", "CoreTable", "RepairCoreDataTableFoundationForSetup"
    AddUserDataTableScopeDefinition rows, seen, CANON_TABLE_LOGICAL_ID_LOOKUPDEFINITIONS, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, CANON_TABLE_LOGICAL_ID_LOOKUPDEFINITIONS), "TABLES", "FullDataCopy", "LookupDefinitionRegistry", "RepairCoreDataTableFoundationForSetup"
    For Each lookupTableName In EditableLookupTableNames()
        lookupLogicalID = LogicalObjectNameFromPhysicalName(NAMING_CATEGORY_TABLE, CStr(lookupTableName))
        AddUserDataTableScopeDefinition rows, seen, lookupLogicalID, CStr(lookupTableName), "TABLES", "FullDataCopy", "EditableLookupTable", "RepairCoreDataTableFoundationForSetup"
    Next lookupTableName
    Set UserDataTableScopeDefinitions = rows
End Function

Private Sub AddUserDataTableScopeDefinition(ByVal rows As Collection, ByVal seen As Object, ByVal logicalIdentity As String, ByVal tableName As String, ByVal authoritativeOwner As String, ByVal backupBehavior As String, ByVal resetContract As String, ByVal postResetOwner As String)
    logicalIdentity = Trim$(logicalIdentity)
    If StrComp(tableName, Trim$(tableName), vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 10138, "AddUserDataTableScopeDefinition", "The canonical ADC user-data scope has noncanonical outer whitespace in its physical table name." & vbCrLf & "Table: [" & tableName & "]"
    If Len(logicalIdentity) = 0 Or Len(tableName) = 0 Then Err.Raise vbObjectError + 7835, "AddUserDataTableScopeDefinition", "The canonical ADC user-data scope contains a blank logical or physical table identity."
    If Len(authoritativeOwner) = 0 Or Len(backupBehavior) = 0 Or Len(resetContract) = 0 Or Len(postResetOwner) = 0 Then Err.Raise vbObjectError + 7836, "AddUserDataTableScopeDefinition", "The canonical ADC user-data scope contains an incomplete ownership/reset contract." & vbCrLf & "Logical identity: " & logicalIdentity & vbCrLf & "Table: " & tableName
    If seen.Exists(tableName) Then Exit Sub
    seen.Add tableName, True
    rows.Add Array(logicalIdentity, tableName, authoritativeOwner, backupBehavior, resetContract, postResetOwner)
End Sub

