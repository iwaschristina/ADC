        Case LCase$(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER): EditableLookupTableFieldDescriptionShort = FIELD_DESC_SHORT_EDITABLE_LOOKUP_TABLE_SORTORDER
