            rows.Add Array("Dependencies", "=ChatGPT_AddInReviewShowModuleDependencies(" & SQL_FIELD_MODULE_IDENTITY & ")", "Show dependency evidence for the selected procedure's module.")
        Case DEFAULT_LIST_ACTION_PROFILE_ADD_IN_REVIEW_CONFLICTS
            rows.Add Array("All Exposures", "=ChatGPT_AddInReviewShowProcedureConflicts(" & SQL_FIELD_PROCEDURE_NAME_KEY & ")", "Show every loaded External project and module exposing this conflicting procedure name.")
    End Select
    If AddInReviewListActionProfile(profileText) Then
        rows.Add Array("Filter By Selection", "=ChatGPT_FilterCurrentSelection()", "Filter this read-only Add-In Review page by the value in the selected field.")
        rows.Add Array("Clear Filter", "=ChatGPT_ClearCurrentFormFilter()", "Clear this page's filter and sort without changing stored scan data.")
    End If
    Set GeneratedListActionDefinitions = rows
End Function

Private Function AddInReviewListActionProfile(ByVal profileText As String) As Boolean
    Select Case Trim$(profileText)
        Case DEFAULT_LIST_ACTION_PROFILE_ADD_IN_REVIEW_FILTER_ONLY, DEFAULT_LIST_ACTION_PROFILE_ADD_IN_REVIEW_SUMMARY, DEFAULT_LIST_ACTION_PROFILE_ADD_IN_REVIEW_PROJECTS, DEFAULT_LIST_ACTION_PROFILE_ADD_IN_REVIEW_MODULES, DEFAULT_LIST_ACTION_PROFILE_ADD_IN_REVIEW_PROCEDURES, DEFAULT_LIST_ACTION_PROFILE_ADD_IN_REVIEW_CONFLICTS
            AddInReviewListActionProfile = True
    End Select
End Function

' Purpose: Adds in review expected action expressions for form name.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   formName (Input; String): Physical Access form name identifying the form to create, open, configure, validate, or inspect.
' Returns: Collection: Returns the add in review expected action expressions object/collection resolved by this routine for direct use by the caller; the routine's documented absence/error path applies when no
'   such object can be resolved.
Public Function AddInReviewExpectedActionExpressions(ByVal formName As String) As Collection
    ' INTENTIONAL FILTERED PARTITION: result is a consumer-required subset/projection derived from the source enumerated by AddInReviewExpectedActionExpressions; its membership is not independently authoritative.
    Dim result As New Collection
    Dim actionDefinitions As Collection
    Dim actionData As Variant
    If AddInReviewChildFormIsDefinedDefault(formName) = False Then Err.Raise vbObjectError + 7376, "AddInReviewExpectedActionExpressions", "No Add-In Review action definition exists." & vbCrLf & "Form: " & formName
    Set actionDefinitions = GeneratedListActionDefinitions(GeneratedFormListActionProfile(formName))
    For Each actionData In actionDefinitions
        result.Add CStr(actionData(1))
    Next actionData
    Set AddInReviewExpectedActionExpressions = result
End Function

