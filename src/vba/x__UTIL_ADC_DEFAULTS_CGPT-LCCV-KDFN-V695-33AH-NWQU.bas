' Purpose: Resolves and returns ribbon managed group label from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   defaultKey (Input; String): Canonical key identifying the default definition, setting, or managed item to use.
'   resolvedSortOrder (Output Optional; Long): Receives the resolved sort order returned by `CLng` after this procedure completes its validation/resolution work. Default: 0.
' Returns: String: Returns the canonical display text for ribbon managed group label after applying the title/caption/label rules owned by this module; vbNullString represents no applicable display text where
'   supported.
Public Function RibbonManagedGroupLabel(ByVal defaultKey As String, Optional ByRef resolvedSortOrder As Long = 0) As String
    Dim rowData As Variant
    resolvedSortOrder = 0
    defaultKey = UCase$(Trim$(defaultKey))
    For Each rowData In ManagedRibbonGroupDefaults()
        If StrComp(CStr(rowData(0)), defaultKey, vbBinaryCompare) = 0 Then
            RibbonManagedGroupLabel = CStr(rowData(1))
            resolvedSortOrder = CLng(rowData(2))
            Exit Function
        End If
    Next rowData
    Err.Raise vbObjectError + 6881, "RibbonManagedGroupLabel", "No current " & DEFAULT_UTILITY_SHORT_NAME & " managed Ribbon-group default exists for the requested semantic key." & vbCrLf & "Key: " & defaultKey
End Function

Private Function RibbonManagedGroupSortOrder(ByVal defaultKey As String) As Long
    Dim rowData As Variant
    defaultKey = UCase$(Trim$(defaultKey))
    For Each rowData In ManagedRibbonGroupDefaults()
        If StrComp(CStr(rowData(0)), defaultKey, vbBinaryCompare) = 0 Then
            RibbonManagedGroupSortOrder = CLng(rowData(2))
            Exit Function
        End If
    Next rowData
    Err.Raise vbObjectError + 6882, "RibbonManagedGroupSortOrder", "No current " & DEFAULT_UTILITY_SHORT_NAME & " managed Ribbon-group sort default exists for the requested semantic key." & vbCrLf & "Key: " & defaultKey
End Function

' Purpose: Returns only explicitly authored permanent group tags. New split segments require a new authored tag instead of a calculated suffix.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   ribbonTabKey (Input; String): Canonical key identifying the ribbon tab definition, setting, or managed item to use.
'   ribbonGroupLabel (Input; String): Display or grouping label used as the ribbon group label for the UI, Ribbon, progress, or definition item being processed.
'   ribbonGroupSortOrder (Input; Long): Numeric sort position that determines the generated Ribbon group’s ordering relative to sibling groups.
'   groupSegmentNumber (Input; Long): Numeric identifier or ordinal for the group segment item processed or reported by this operation.
'   systemGroupDefinitions (Input Optional; Variant): Caller-supplied system group definitions data used as the authoritative definition input for this call, avoiding an unnecessary reload when already
'   available.
' Returns: String: Returns the resolved ribbon static group tag default text in the canonical representation consumed by this module's caller; vbNullString represents no applicable value where the existing
'   contract permits it.
Public Function RibbonStaticGroupTagDefault(ByVal ribbonTabKey As String, ByVal ribbonGroupLabel As String, ByVal ribbonGroupSortOrder As Long, ByVal groupSegmentNumber As Long, Optional ByVal systemGroupDefinitions As Variant) As String
    'Returns only explicitly authored permanent group tags. New split segments require a new authored tag instead of a calculated suffix.
    Dim rowData As Variant
    Dim candidateTag As String
    Dim matchedTag As String
    Dim systemDefinitions As Collection
    ribbonTabKey = Trim$(ribbonTabKey)
    ribbonGroupLabel = Trim$(ribbonGroupLabel)
    If groupSegmentNumber <> 1 Then Err.Raise vbObjectError + 6885, "RibbonStaticGroupTagDefault", "A Ribbon group split reached a segment with no explicitly assigned permanent tag. Add the segment to Defaults instead of deriving a tag." & vbCrLf & "Tab: " & ribbonTabKey & vbCrLf & "Group: " & ribbonGroupLabel & vbCrLf & "Segment: " & CStr(groupSegmentNumber)
    For Each rowData In ManagedRibbonGroupDefaults()
        If StrComp(Trim$(CStr(rowData(3))), ribbonTabKey, vbTextCompare) = 0 And StrComp(Trim$(CStr(rowData(1))), ribbonGroupLabel, vbTextCompare) = 0 Then
            candidateTag = Trim$(CStr(rowData(4)))
            If Len(matchedTag) > 0 And StrComp(matchedTag, candidateTag, vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 6886, "RibbonStaticGroupTagDefault", "Conflicting permanent Ribbon group tags are assigned to the same tab/group placement." & vbCrLf & "Tab: " & ribbonTabKey & vbCrLf & "Group: " & ribbonGroupLabel
            matchedTag = candidateTag
        End If
    Next rowData
    If IsObject(systemGroupDefinitions) Then Set systemDefinitions = systemGroupDefinitions
    If systemDefinitions Is Nothing Then Set systemDefinitions = GetSystemRibbonGroupDefinitions()
    For Each rowData In systemDefinitions
        If StrComp(Trim$(CStr(rowData(3))), ribbonTabKey, vbTextCompare) = 0 And StrComp(Trim$(CStr(rowData(1))), ribbonGroupLabel, vbTextCompare) = 0 Then
            candidateTag = Trim$(CStr(rowData(4)))
            If Len(matchedTag) > 0 And StrComp(matchedTag, candidateTag, vbBinaryCompare) <> 0 Then Err.Raise vbObjectError + 6886, "RibbonStaticGroupTagDefault", "Conflicting permanent Ribbon group tags are assigned to the same tab/group placement." & vbCrLf & "Tab: " & ribbonTabKey & vbCrLf & "Group: " & ribbonGroupLabel
            matchedTag = candidateTag
        End If
    Next rowData
    If Len(matchedTag) = 0 Then Err.Raise vbObjectError + 6887, "RibbonStaticGroupTagDefault", "No explicitly assigned permanent Ribbon group tag exists for this placement." & vbCrLf & "Tab: " & ribbonTabKey & vbCrLf & "Group: " & ribbonGroupLabel & vbCrLf & "Group sort order: " & CStr(ribbonGroupSortOrder)
    RibbonStaticGroupTagDefault = matchedTag
End Function

' Purpose: Resolves and returns ribbon tab label default from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   ribbonTabKey (Input; String): Canonical key identifying the ribbon tab definition, setting, or managed item to use.
'   tabRecognized (Output Optional; Boolean): Set True when the procedure determines that tab recognized applies; set False when that condition is not met. Default: False.
' Returns: String: Returns the canonical display text for ribbon tab label default after applying the title/caption/label rules owned by this module; vbNullString represents no applicable display text where
'   supported.
Public Function GetRibbonTabLabelDefault(ByVal ribbonTabKey As String, Optional ByRef tabRecognized As Boolean = False) As String
    'Single Defaults-owned fallback resolver for Ribbon tab labels.
    Dim rowData As Variant
    Dim normalizedTabKey As String
    tabRecognized = False
    normalizedTabKey = UCase$(Trim$(ribbonTabKey))
    For Each rowData In RibbonTabDefaultDefinitions()
        If StrComp(UCase$(CStr(rowData(0))), normalizedTabKey, vbBinaryCompare) = 0 Then
            GetRibbonTabLabelDefault = CStr(rowData(1))
            tabRecognized = True
            Exit Function
        End If
    Next rowData
    GetRibbonTabLabelDefault = Replace(ribbonTabKey, "_", " ")
    If Len(GetRibbonTabLabelDefault) = 0 Then GetRibbonTabLabelDefault = DEFAULT_RIBBON_TAB_LABEL_OBJECTS
End Function

' Purpose: Resolves ribbon static tab tag default from the supplied/current ADC state, using `RibbonTabDefaultDefinitions` and `StrComp` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   ribbonTabKey (Input; String): Stable identity/key used to select the ribbon tab key definition, row, workflow part, or managed object without relying on display text.
' Returns: String: Returns the ribbon static tab tag default text value. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not
'   resolved.
Public Function RibbonStaticTabTagDefault(ByVal ribbonTabKey As String) As String
    'Returns the explicitly authored permanent tag assigned to this Ribbon tab. Never calculate or renumber this value.
    Dim rowData As Variant
    ribbonTabKey = UCase$(Trim$(ribbonTabKey))
    For Each rowData In RibbonTabDefaultDefinitions()
        If StrComp(UCase$(CStr(rowData(0))), ribbonTabKey, vbBinaryCompare) = 0 Then
            RibbonStaticTabTagDefault = Trim$(CStr(rowData(4)))
            If Len(RibbonStaticTabTagDefault) = 0 Then Err.Raise vbObjectError + 6883, "RibbonStaticTabTagDefault", "The Ribbon tab definition has no explicitly assigned permanent tag." & vbCrLf & "RibbonTabKey: " & ribbonTabKey
            Exit Function
        End If
    Next rowData
    Err.Raise vbObjectError + 6884, "RibbonStaticTabTagDefault", "No Defaults-owned Ribbon tab definition exists for a requested permanent tag." & vbCrLf & "RibbonTabKey: " & ribbonTabKey
End Function

