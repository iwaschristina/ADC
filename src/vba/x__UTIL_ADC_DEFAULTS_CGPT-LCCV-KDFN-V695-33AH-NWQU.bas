    Dim rows As New Collection
    Dim profileText As String
    profileText = Trim$(actionProfile)
    Select Case profileText
        Case DEFAULT_LIST_ACTION_PROFILE_ACTIVE_REFERENCES
            rows.Add Array("Scan Active", "=RunSystemCommand(""" & SYS_MACRO_KEY_SCAN_DB_INVENTORY_ACTIVE_REFERENCES & """)", "Refresh the active-reference inventory.")
            rows.Add Array("Open Location", "=ChatGPT_OpenReferenceLocationFromCurrentRow()", "Open the selected reference file location.")
