        Case UCase$("ADC_ProcedureKind_Lookup"): EditableLookupTableImplementationDefinition = Array(tableName, FIELD_PROCEDURE_KIND, 16, "create/verify Procedure Kind editable lookup table", 50)
        Case UCase$("ADC_ProcedureScope_Lookup"): EditableLookupTableImplementationDefinition = Array(tableName, FIELD_PROCEDURE_SCOPE, 17, "create/verify Procedure Scope editable lookup table", 40)
