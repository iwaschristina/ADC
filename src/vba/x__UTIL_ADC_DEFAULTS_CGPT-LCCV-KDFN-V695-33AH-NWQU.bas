        Case LCase$(FIELD_CANDIDATE_OWNER_DATABASE_ROLE): HealthReviewFieldDescription = FIELD_DESC_LONG_HEALTH_REVIEW_FIELD_CANDIDATE_OWNER_DATABASE_ROLE
        Case LCase$(FIELD_TARGET_PROCEDURE_NAME): HealthReviewFieldDescription = BuildHealthReviewTargetprocedurenameLongFieldDescription()
        Case LCase$(FIELD_TARGET_PROCEDURE_MODULE_NAME): HealthReviewFieldDescription = FIELD_DESC_LONG_HEALTH_REVIEW_TARGETPROCEDUREMODULENAME
