End Function

' Purpose: Resolves navigation pane group ribbon group label from the supplied/current ADC state, using `NavigationPaneGroupUsesConfiguredAffixes` and `NavigationPaneLogicalGroupName` where required by the lookup
'     path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   navPaneGroupName (Input; String): Canonical or physical name identifying the nav pane group targeted by this operation.
'   navPaneGroupKey (Input Optional; String): Stable identity/key used to select the nav pane group key definition, row, workflow part, or managed object without relying on display text. Default:
'   vbNullString.
' Returns: String: Returns the formatted text produced by this routine. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not
'   resolved.
Public Function NavigationPaneGroupRibbonGroupLabel(ByVal navPaneGroupName As String, Optional ByVal navPaneGroupKey As String = vbNullString) As String
    If NavigationPaneGroupUsesConfiguredAffixes(navPaneGroupName, True) Then
        NavigationPaneGroupRibbonGroupLabel = Trim$(NavigationPaneLogicalGroupName(navPaneGroupName, True))
    ElseIf NavigationPaneGroupUsesConfiguredAffixes(navPaneGroupName, False) Then
        NavigationPaneGroupRibbonGroupLabel = Trim$(NavigationPaneLogicalGroupName(navPaneGroupName, False))
    Else
        navPaneGroupName = Trim$(navPaneGroupName)
        If StrComp(Left$(navPaneGroupName, Len("Access Development Console -")), "Access Development Console -", vbTextCompare) = 0 Then
            NavigationPaneGroupRibbonGroupLabel = Trim$(Mid$(navPaneGroupName, Len("Access Development Console -") + 1))
        Else
            NavigationPaneGroupRibbonGroupLabel = navPaneGroupName
        End If
    End If
    If Len(NavigationPaneGroupRibbonGroupLabel) = 0 Then NavigationPaneGroupRibbonGroupLabel = navPaneGroupName
    Select Case UCase$(Trim$(navPaneGroupKey))
        Case "CONFIG": NavigationPaneGroupRibbonGroupLabel = DEFAULT_NAVIGATION_RIBBON_GROUP_LABEL_CONFIG
        Case "ADC_SETTINGS": NavigationPaneGroupRibbonGroupLabel = DEFAULT_NAVIGATION_RIBBON_GROUP_LABEL_SETTINGS
    End Select
End Function

Private Function NavigationPaneLogicalGroupKeyByApplicability(ByVal applicabilityValue As String, ByVal applicabilityIndex As Long) As String
