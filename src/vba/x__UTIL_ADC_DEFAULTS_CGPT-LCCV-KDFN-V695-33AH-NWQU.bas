        Case DEFAULT_LIST_ACTION_PROFILE_REFERENCE_MANAGER
            rows.Add Array("Open Location", "=ChatGPT_OpenReferenceLocationFromCurrentRow()", "Open the selected reference file location.")
            rows.Add Array("Refresh", "=ChatGPT_RunProcedure(""RefreshReferenceManager"")", "Rescan and refresh the reference manager.")
