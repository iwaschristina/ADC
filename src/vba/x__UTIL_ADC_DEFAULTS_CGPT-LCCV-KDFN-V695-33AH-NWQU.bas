' Purpose: Resolves and returns default object edit policy from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   catalogOwner (Input; String): Canonical catalog-owner identifier used to select/validate which module/domain owns the managed definition.
'   objectName (Input Optional; String): Physical Access object name identifying the database object targeted by the operation. Default: vbNullString.
' Returns: String: Returns the canonical default object edit policy value used by downstream policy/dispatch logic; vbNullString indicates that no managed value applies where the API permits absence.
Public Function DefaultObjectEditPolicy(ByVal catalogOwner As String, Optional ByVal objectName As String = vbNullString) As String
    If StrComp(objectName, ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_Terminology_Review"), vbTextCompare) = 0 Then
        DefaultObjectEditPolicy = "Editable Help_Terms view; direct adds, edits, and deletes update Help_Terms wherever Access permits."
    ElseIf StrComp(Trim$(catalogOwner), DEFAULT_CATALOG_OWNER_USER, vbTextCompare) = 0 Then
        DefaultObjectEditPolicy = "User-maintained through the appropriate " & DEFAULT_UTILITY_LONG_NAME & " form or workflow."
    ElseIf StrComp(Trim$(catalogOwner), DEFAULT_CATALOG_OWNER_PERSISTENT_GENERATED, vbTextCompare) = 0 Then
        DefaultObjectEditPolicy = "Persistent generated shell: the physical form design may be customized. Setup preserves an existing design and recreates the shell only when it is missing."
    Else
        DefaultObjectEditPolicy = "Use the owning " & DEFAULT_UTILITY_SHORT_NAME & " form or command; avoid direct table, query, or design edits."
    End If
End Function

