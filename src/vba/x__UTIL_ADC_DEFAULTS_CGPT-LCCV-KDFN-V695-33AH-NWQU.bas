Private Sub AddGeneratedFormImplementationDefinition(ByRef rows As Collection, ByVal canonicalDefinition As Variant, ByVal displayName As String, ByVal formType As String, ByVal ribbonGroupLabel As String, Optional ByVal openAfterSetup As Boolean = False, Optional ByVal sourceCandidates As Variant, Optional ByVal sourceUsesFirstExisting As Boolean = False, Optional ByVal listFields As Variant, Optional ByVal orderFields As Variant, Optional ByVal actionProfile As String = vbNullString, Optional ByVal allowEdits As Boolean = True, Optional ByVal includeOpenButton As Boolean = False, Optional ByVal splitPopupDescription As String = vbNullString, Optional ByVal isAddInReviewForm As Boolean = False, Optional ByVal addInReviewChildOrder As Long = 0, Optional ByVal expectedSourceTypeOverride As String = vbNullString, Optional ByVal onCurrentExpression As String = vbNullString, Optional ByVal addInReviewHostMetadata As Variant)
    Dim formName As String
    Dim descriptionText As String
    Dim NavigationPaneGroupKey As String
    Dim SortOrder As Long
    Dim resolvedSourceCandidates As Variant
    Dim resolvedListFields As Variant
    Dim resolvedOrderFields As Variant
    Dim resolvedAddInReviewHostMetadata As Variant
    formName = CStr(canonicalDefinition(MANAGED_DEF_OBJECT_NAME))
    descriptionText = CStr(canonicalDefinition(MANAGED_DEF_DESCRIPTION))
    NavigationPaneGroupKey = NavigationPaneLogicalGroupKeyByApplicability(CStr(canonicalDefinition(MANAGED_DEF_PLACEMENT_SCOPE)), 8)
    If Len(Trim$(NavigationPaneGroupKey)) = 0 Then Err.Raise vbObjectError + 7802, "AddGeneratedFormImplementationDefinition", "The canonical generated form does not resolve to a Navigation Pane group through its managed-object placement scope." & vbCrLf & "Form: " & formName & vbCrLf & "PlacementScope: " & CStr(canonicalDefinition(MANAGED_DEF_PLACEMENT_SCOPE))
    SortOrder = CLng(canonicalDefinition(MANAGED_DEF_SORT_ORDER))
    If isMissing(sourceCandidates) Then resolvedSourceCandidates = Empty Else resolvedSourceCandidates = sourceCandidates
    If isMissing(listFields) Then resolvedListFields = Empty Else resolvedListFields = listFields
    If isMissing(orderFields) Then resolvedOrderFields = Empty Else resolvedOrderFields = orderFields
    If isMissing(addInReviewHostMetadata) Then resolvedAddInReviewHostMetadata = Empty Else resolvedAddInReviewHostMetadata = addInReviewHostMetadata
    rows.Add Array(formName, displayName, descriptionText, formType, NavigationPaneGroupKey, SortOrder, ribbonGroupLabel, openAfterSetup, resolvedSourceCandidates, sourceUsesFirstExisting, resolvedListFields, resolvedOrderFields, actionProfile, allowEdits, includeOpenButton, splitPopupDescription, isAddInReviewForm, addInReviewChildOrder, expectedSourceTypeOverride, onCurrentExpression, resolvedAddInReviewHostMetadata)
End Sub

Private Function GetGeneratedFormDefinition(ByVal formName As String) As Variant
    Dim definitionData As Variant
    For Each definitionData In GeneratedFormDefinitions()
        If StrComp(CStr(definitionData(GENERATED_FORM_DEF_FORM_NAME)), formName, vbTextCompare) = 0 Then
            GetGeneratedFormDefinition = definitionData
            Exit Function
        End If
    Next definitionData
End Function

' Purpose: Resolves and returns generated form names from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
' Returns: Variant: Returns the generated form names list/array in the exact order and representation expected by the generated-form/setup caller; Empty/zero-length output represents no applicable items where
'   supported.
Public Function GeneratedFormNames() As Variant
    Dim definitions As Collection
    Dim definitionData As Variant
    Dim formNames() As Variant
    Dim indexValue As Long
    Set definitions = GeneratedFormDefinitions()
    If definitions.count = 0 Then
        GeneratedFormNames = Empty
        Exit Function
    End If
    ReDim formNames(0 To definitions.count - 1)
    For indexValue = 1 To definitions.count
        definitionData = definitions(indexValue)
        formNames(indexValue - 1) = CStr(definitionData(GENERATED_FORM_DEF_FORM_NAME))
    Next indexValue
    GeneratedFormNames = formNames
End Function

' Purpose: Resolves and returns generated split popup description from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   formName (Input; String): Physical Access form name identifying the form to create, open, configure, validate, or inspect.
' Returns: String: Returns the canonical description text for generated split popup description, suitable for the managed catalog/field/object metadata destination; vbNullString indicates that no description
'   applies where allowed.
Public Function GeneratedSplitPopupDescription(ByVal formName As String) As String
    Dim definitionData As Variant
    definitionData = GetGeneratedFormDefinition(formName)
    If IsArray(definitionData) Then GeneratedSplitPopupDescription = CStr(definitionData(GENERATED_FORM_DEF_SPLIT_POPUP_DESCRIPTION))
End Function

' Purpose: Resolves and returns generated form catalog definition from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Public dynamic/form expression API. The name is referenced as text outside this module, so Public visibility is required for Access or generated-expression resolution.
' Parameters:
'   formName (Input; String): Physical Access form name identifying the form to create, open, configure, validate, or inspect.
' Returns: Variant: Returns the canonical generated form catalog definition definition payload consumed by the generated-form builder; the function's empty/Null representation indicates that no definition
'   applies.
Public Function GeneratedFormCatalogDefinition(ByVal formName As String) As Variant
    Dim definitionData As Variant
    definitionData = GetGeneratedFormDefinition(formName)
    If IsArray(definitionData) Then GeneratedFormCatalogDefinition = Array(definitionData(GENERATED_FORM_DEF_FORM_NAME), definitionData(GENERATED_FORM_DEF_DISPLAY_NAME), definitionData(GENERATED_FORM_DEF_DESCRIPTION), definitionData(GENERATED_FORM_DEF_FORM_TYPE), definitionData(GENERATED_FORM_DEF_NAV_GROUP_KEY), definitionData(GENERATED_FORM_DEF_SORT_ORDER))
End Function


'===============================================================================
' ADD-IN REVIEW GENERATED-FORM DEFAULTS
'===============================================================================

' Purpose: Returns the Add-In Review child-form names ordered by their canonical child-order metadata; returns Empty when no child-form definitions are configured.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
' Returns: Variant: Returns the add in review child form names list/array in the exact order and representation expected by the generated-form/setup caller; Empty/zero-length output represents no applicable
'   items where supported.
Public Function AddInReviewChildFormNames() As Variant
    Dim definitions As Collection
    Dim definitionData As Variant
    Dim formNames() As Variant
    Dim childCount As Long
    Dim childOrder As Long
    Set definitions = GeneratedFormDefinitions()
    For Each definitionData In definitions
        If CLng(definitionData(GENERATED_FORM_DEF_ADD_IN_REVIEW_CHILD_ORDER)) > 0 Then childCount = childCount + 1
    Next definitionData
    If childCount = 0 Then
        AddInReviewChildFormNames = Empty
        Exit Function
    End If
    ReDim formNames(0 To childCount - 1)
    For Each definitionData In definitions
        childOrder = CLng(definitionData(GENERATED_FORM_DEF_ADD_IN_REVIEW_CHILD_ORDER))
        If childOrder > 0 Then
            If childOrder > childCount Then Err.Raise vbObjectError + 7377, "AddInReviewChildFormNames", "An Add-In Review child-form order is outside the authoritative child count." & vbCrLf & "Form: " & CStr(definitionData(GENERATED_FORM_DEF_FORM_NAME)) & vbCrLf & "Order: " & CStr(childOrder) & vbCrLf & "Count: " & CStr(childCount)
            If Len(Trim$(CStr(formNames(childOrder - 1)))) > 0 Then Err.Raise vbObjectError + 7378, "AddInReviewChildFormNames", "The generated-form authority contains a duplicate Add-In Review child-form order." & vbCrLf & "Order: " & CStr(childOrder)
            formNames(childOrder - 1) = CStr(definitionData(GENERATED_FORM_DEF_FORM_NAME))
        End If
    Next definitionData
    AddInReviewChildFormNames = formNames
End Function

