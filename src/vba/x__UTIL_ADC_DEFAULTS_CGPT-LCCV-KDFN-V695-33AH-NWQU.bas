' Purpose: Resolves converted value lookup table for field from the supplied/current ADC state, using `ConvertedLookupSourceMatches` and `End` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   tableName (Input; String): Canonical or physical name identifying the table targeted by this operation.
'   fieldName (Input; String): Canonical or physical name identifying the field targeted by this operation.
' Returns: String: Returns the converted value lookup table for field text value. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or
'   not resolved.
Public Function ConvertedValueLookupTableForField(ByVal tableName As String, ByVal fieldName As String) As String
    Dim sourceName As String
    sourceName = tableName
    Select Case LCase$(Trim$(fieldName))
        Case LCase$(FIELD_MANAGED_OBJECT_FIELD_DATA_TYPE): ConvertedValueLookupTableForField = "ADC_SettingDataType_Lookup"
        Case LCase$(FIELD_SETTING_GROUP): ConvertedValueLookupTableForField = "ADC_SettingGroup_Lookup"
        Case LCase$(FIELD_TARGET_PROCEDURE_KIND): ConvertedValueLookupTableForField = "ADC_TargetProcedureKind_Lookup"
        Case LCase$(FIELD_RESULT_HANDLING): ConvertedValueLookupTableForField = "ADC_ResultHandling_Lookup"
        Case LCase$(FIELD_EXPECTED_RETURN_TYPE): ConvertedValueLookupTableForField = "ADC_ExpectedReturnType_Lookup"
        Case LCase$(FIELD_CONFIRMATION_MODE): ConvertedValueLookupTableForField = "ADC_ConfirmationMode_Lookup"
        Case LCase$(FIELD_ENTRY_POINT_MATCH_CONFIDENCE): ConvertedValueLookupTableForField = "ADC_EntryPointMatchConfidence_Lookup"
        Case LCase$(FIELD_TERM_CATEGORY): ConvertedValueLookupTableForField = "ADC_TermCategory_Lookup"
        Case LCase$(FIELD_TERM_STATUS): ConvertedValueLookupTableForField = "ADC_TermStatus_Lookup"
        Case LCase$(FIELD_DECISION_SCOPE): ConvertedValueLookupTableForField = "ADC_DecisionScope_Lookup"
        Case LCase$(FIELD_DECISION_STATUS): ConvertedValueLookupTableForField = "ADC_DecisionStatus_Lookup"
        Case LCase$(FIELD_ISSUE_TYPE): ConvertedValueLookupTableForField = "ADC_LauncherIssueType_Lookup"
        Case LCase$(FIELD_SYSTEM_MACRO_GROUP_KEY): ConvertedValueLookupTableForField = "ADC_SystemMacroGroup_Lookup"
        Case LCase$(FIELD_TRACE_LEVEL): ConvertedValueLookupTableForField = "ADC_TraceLevel_Lookup"
        Case LCase$(FIELD_OBJECT_NAMING_CATEGORY): ConvertedValueLookupTableForField = "ADC_ObjectNamingCategory_Lookup"
        Case LCase$(FIELD_GROUP_PURPOSE): ConvertedValueLookupTableForField = "ADC_NavigationPaneGroupPurpose_Lookup"
        Case LCase$(FIELD_COMPONENT_TYPE)
            If ConvertedLookupSourceMatches(sourceName, "ADC_ModuleUpdates_Current", NAMING_CATEGORY_QUERY) Or ConvertedLookupSourceMatches(sourceName, "ADC_ModuleUpdates_History", NAMING_CATEGORY_QUERY) Or ConvertedLookupSourceMatches(sourceName, "ADC_ModuleVersionManifest", NAMING_CATEGORY_TABLE) Or ConvertedLookupSourceMatches(sourceName, "ADC_ModuleUpdateHistory", NAMING_CATEGORY_TABLE) Or ConvertedLookupSourceMatches(sourceName, "ADC_ModuleVersionVerification", NAMING_CATEGORY_TABLE) Then ConvertedValueLookupTableForField = "ADC_VBAComponentType_Lookup"
        Case LCase$(FIELD_RECORDED_BY)
            If ConvertedLookupSourceMatches(sourceName, "ADC_ModuleUpdates_History", NAMING_CATEGORY_QUERY) Or ConvertedLookupSourceMatches(sourceName, "ADC_ModuleUpdateHistory", NAMING_CATEGORY_TABLE) Then ConvertedValueLookupTableForField = "ADC_ModuleUpdateRecordedBy_Lookup"
        Case LCase$(FIELD_LAST_VERIFICATION_RESULT)
            If ConvertedLookupSourceMatches(sourceName, "ADC_ModuleUpdates_Current", NAMING_CATEGORY_QUERY) Or ConvertedLookupSourceMatches(sourceName, "ADC_ModuleVersionManifest", NAMING_CATEGORY_TABLE) Then ConvertedValueLookupTableForField = "ADC_ModuleVerificationResult_Lookup"
        Case LCase$(FIELD_VERIFICATION_RESULT)
            If ConvertedLookupSourceMatches(sourceName, "ADC_ModuleVersionVerification", NAMING_CATEGORY_TABLE) Then ConvertedValueLookupTableForField = "ADC_ModuleVerificationResult_Lookup"
        Case LCase$(FIELD_EDITOR_MODE): ConvertedValueLookupTableForField = "ADC_LookupEditorMode_Lookup"
    End Select
End Function

Private Function ConvertedLookupSourceMatches(ByVal sourceName As String, ByVal logicalID As String, ByVal namingCategory As String) As Boolean
    If Len(sourceName) = 0 Then Exit Function
    ConvertedLookupSourceMatches = (StrComp(sourceName, ManagedObjectPhysicalName(namingCategory, logicalID), vbTextCompare) = 0)
End Function

' Purpose: Resolves and returns generated form display name from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   formName (Input; String): Physical Access form name identifying the form to create, open, configure, validate, or inspect.
' Returns: String: Returns the physical/logical name resolved for generated form display name under the module's naming/definition rules; vbNullString indicates that no applicable name can be resolved where
'   supported.
Public Function GeneratedFormDisplayName(ByVal formName As String) As String
    Dim definitionData As Variant
    If StrComp(formName, ManagedObjectPhysicalName(NAMING_CATEGORY_GENERATED_FORM, CANON_GENERATED_FORM_LOGICAL_ID_DELETE_OBJECTS), vbTextCompare) = 0 Then
        GeneratedFormDisplayName = CANON_GENERATED_FORM_TITLE_DELETE_OBJECTS
        Exit Function
    End If
    definitionData = GeneratedFormCatalogDefinition(formName)
    If IsArray(definitionData) Then GeneratedFormDisplayName = CStr(definitionData(1))
End Function

