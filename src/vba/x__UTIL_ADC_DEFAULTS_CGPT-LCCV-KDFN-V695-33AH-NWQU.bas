' Purpose: Resolves B2 shared field metadata definitions from the supplied/current ADC state, using `CatalogFieldLookupDefinitions` and `ManagedObjectPhysicalName` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   tableName (Input; String): Canonical or physical name identifying the table targeted by this operation.
' Returns: Collection: Returns the ordered Collection assembled by the routine; callers receive the object reference and should treat its membership/order according to the routine contract.
Public Function B2SharedFieldMetadataDefinitions(ByVal tableName As String) As Collection
    'One authoritative projection consumed by both B2 mutation and B2 proof generation.
    Dim rows As Collection
    Dim fieldName As Variant
    Set rows = CatalogFieldLookupDefinitions(tableName)
    Select Case UCase$(tableName)
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_SETTINGS_TABLE_LOGICAL_ID))
            AddB2DefinedLookupMetadataDefinition rows, tableName, FIELD_MANAGED_OBJECT_FIELD_DATA_TYPE
            AddB2DefinedLookupMetadataDefinition rows, tableName, FIELD_SETTING_GROUP
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Config"))
            For Each fieldName In Array(FIELD_TARGET_PROCEDURE_KIND, FIELD_RESULT_HANDLING, FIELD_EXPECTED_RETURN_TYPE, FIELD_CONFIRMATION_MODE)
                AddB2DefinedLookupMetadataDefinition rows, tableName, CStr(fieldName)
            Next fieldName
            For Each fieldName In Array(FIELD_CONFIGURATION_STATUS, FIELD_MACRO_ACTION, FIELD_MANUAL_REVIEW_STATUS, FIELD_LAST_VALIDATION_RESULT, FIELD_LAST_GENERATED_RESULT, FIELD_CONFIG_OWNER_DATABASE_ROLE, FIELD_MACRO_CATEGORY_KEY, FIELD_MACRO_SUBCATEGORY_KEY, FIELD_NAVIGATION_PANE_GROUP, FIELD_TARGET_OBJECT_NAME)
                AddB2DefinedLookupMetadataDefinition rows, tableName, CStr(fieldName)
            Next fieldName
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Candidates"))
            For Each fieldName In Array(FIELD_TARGET_PROCEDURE_KIND, FIELD_RESULT_HANDLING, FIELD_EXPECTED_RETURN_TYPE, FIELD_CONFIRMATION_MODE, FIELD_ENTRY_POINT_MATCH_CONFIDENCE)
                AddB2DefinedLookupMetadataDefinition rows, tableName, CStr(fieldName)
            Next fieldName
            For Each fieldName In Array(FIELD_CANDIDATE_STATUS, FIELD_MACRO_ACTION, FIELD_ACCEPTANCE_STATUS, FIELD_MANUAL_REVIEW_STATUS, FIELD_CONFIG_OWNER_DATABASE_ROLE, FIELD_CANDIDATE_OWNER_DATABASE_ROLE, FIELD_MACRO_CATEGORY_KEY, FIELD_MACRO_SUBCATEGORY_KEY, FIELD_NAVIGATION_PANE_GROUP, FIELD_TARGET_OBJECT_NAME, FIELD_ACCEPTED_CONFIGURATION_ID)
                AddB2DefinedLookupMetadataDefinition rows, tableName, CStr(fieldName)
            Next fieldName
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_HealthReview"))
            For Each fieldName In Array(FIELD_SEVERITY, FIELD_REVIEW_AREA, FIELD_CONFIGURATION_STATUS, FIELD_CANDIDATE_STATUS, FIELD_OBJECT_TYPE, FIELD_CONFIG_ID, FIELD_SETTING_KEY, FIELD_CONFIG_OWNER_DATABASE_ROLE, FIELD_CANDIDATE_OWNER_DATABASE_ROLE)
                AddB2DefinedLookupMetadataDefinition rows, tableName, CStr(fieldName)
            Next fieldName
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_TERMINOLOGY_TABLE_LOGICAL_ID))
            For Each fieldName In Array(FIELD_TERM_STATUS, FIELD_TERM_CATEGORY, FIELD_DECISION_SCOPE, FIELD_DECISION_STATUS)
                AddB2DefinedLookupMetadataDefinition rows, tableName, CStr(fieldName)
            Next fieldName
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_LauncherControlsReview"))
            For Each fieldName In Array(FIELD_CONFIG_ID, FIELD_SEVERITY, FIELD_ISSUE_TYPE)
                AddB2DefinedLookupMetadataDefinition rows, tableName, CStr(fieldName)
            Next fieldName
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ModuleUpdateHistory"))
            AddB2DefinedLookupMetadataDefinition rows, tableName, FIELD_COMPONENT_TYPE
            AddB2DefinedLookupMetadataDefinition rows, tableName, FIELD_RECORDED_BY
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ModuleVersionManifest"))
            AddB2DefinedLookupMetadataDefinition rows, tableName, FIELD_COMPONENT_TYPE
            AddB2DefinedLookupMetadataDefinition rows, tableName, FIELD_LAST_VERIFICATION_RESULT
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_ModuleVersionVerification"))
            AddB2DefinedLookupMetadataDefinition rows, tableName, FIELD_COMPONENT_TYPE
            AddB2DefinedLookupMetadataDefinition rows, tableName, FIELD_VERIFICATION_RESULT
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_LookupDefinitions"))
            AddB2DefinedLookupMetadataDefinition rows, tableName, FIELD_EDITOR_MODE
    End Select
    If StrComp(tableName, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_MANAGED_OBJECTS_TABLE_LOGICAL_ID), vbTextCompare) = 0 Then
        AddB2CaptionMetadataDefinition rows, FIELD_RIBBON_TITLE, "Ribbon Title"
        AddB2CaptionMetadataDefinition rows, FIELD_RIBBON_STATIC_TAG, "Ribbon Static Tag"
        AddB2CaptionMetadataDefinition rows, FIELD_RIBBON_TAB_KEY, "Ribbon Tab Key"
        AddB2CaptionMetadataDefinition rows, FIELD_RIBBON_TAB_LABEL, "Ribbon Tab"
        AddB2CaptionMetadataDefinition rows, FIELD_RIBBON_GROUP_LABEL, "Ribbon Group"
        AddB2CaptionMetadataDefinition rows, FIELD_RIBBON_GROUP_SORT_ORDER, "Ribbon Group Sort Order"
    End If
    Set B2SharedFieldMetadataDefinitions = rows
End Function

' Purpose: Resolves field table lookup definition from the supplied/current ADC state, using `ConvertedValueLookupTableForField` and `ManagedObjectPhysicalName` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   tableName (Input; String): Canonical or physical name identifying the table targeted by this operation.
'   fieldName (Input; String): Canonical or physical name identifying the field targeted by this operation.
' Returns: Variant: Returns the field table lookup definition value in the scalar, array, object, Empty, or Null form produced by the routine's existing contract.
Public Function FieldTableLookupDefinition(ByVal tableName As String, ByVal fieldName As String) As Variant
    Dim tableKey As String
    Dim fieldKey As String
    Dim convertedTable As String
    tableKey = UCase$(tableName)
    fieldKey = LCase$(Trim$(fieldName))
    convertedTable = ConvertedValueLookupTableForField(tableName, fieldName)
    If Len(convertedTable) > 0 Then FieldTableLookupDefinition = Array(FIELD_LOOKUP_DEFINITION_KIND_TABLE, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, convertedTable), FIELD_VALUE_TEXT, FIELD_VALUE_TEXT, True, "0;2", 2, 1): Exit Function
    Select Case tableKey
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Config"))
            Select Case fieldKey
                Case LCase$(FIELD_CONFIGURATION_STATUS)
                    FieldTableLookupDefinition = Array(FIELD_LOOKUP_DEFINITION_KIND_TABLE, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, CANON_TABLE_LOGICAL_ID_CONFIGURATIONSTATUS_LOOKUP), FIELD_VALUE_TEXT, FIELD_VALUE_TEXT, True, "0;2", 2, 1)
                Case LCase$(FIELD_MACRO_ACTION)
                    FieldTableLookupDefinition = Array(FIELD_LOOKUP_DEFINITION_KIND_TABLE, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, CANON_TABLE_LOGICAL_ID_MACROACTION_LOOKUP), FIELD_VALUE_TEXT, FIELD_VALUE_TEXT, True, "0;2", 2, 1)
                Case LCase$(FIELD_MANUAL_REVIEW_STATUS)
                    FieldTableLookupDefinition = Array(FIELD_LOOKUP_DEFINITION_KIND_TABLE, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, CANON_TABLE_LOGICAL_ID_MANUALREVIEWSTATUS_LOOKUP), FIELD_VALUE_TEXT, FIELD_VALUE_TEXT, True, "0;2", 2, 1)
                Case LCase$(FIELD_LAST_VALIDATION_RESULT)
                    FieldTableLookupDefinition = Array(FIELD_LOOKUP_DEFINITION_KIND_TABLE, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, CANON_TABLE_LOGICAL_ID_VALIDATIONRESULT_LOOKUP), FIELD_VALUE_TEXT, FIELD_VALUE_TEXT, True, "0;2", 2, 1)
                Case LCase$(FIELD_LAST_GENERATED_RESULT)
                    FieldTableLookupDefinition = Array(FIELD_LOOKUP_DEFINITION_KIND_TABLE, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, CANON_TABLE_LOGICAL_ID_GENERATEDRESULT_LOOKUP), FIELD_VALUE_TEXT, FIELD_VALUE_TEXT, True, "0;2", 2, 1)
                Case LCase$(FIELD_CONFIG_OWNER_DATABASE_ROLE)
                    FieldTableLookupDefinition = Array(FIELD_LOOKUP_DEFINITION_KIND_TABLE, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_DatabaseRoles"), FIELD_DATABASE_ROLE_CODE, FIELD_DATABASE_ROLE_NAME, True, "0;2", 2, 1)
                Case LCase$(FIELD_MACRO_CATEGORY_KEY)
                    FieldTableLookupDefinition = Array(FIELD_LOOKUP_DEFINITION_KIND_TABLE, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_MacroCategories"), FIELD_MACRO_CATEGORY_KEY, FIELD_MACRO_CATEGORY_NAME, True, "0;2", 2, 1)
                Case LCase$(FIELD_MACRO_SUBCATEGORY_KEY)
                    FieldTableLookupDefinition = Array(FIELD_LOOKUP_DEFINITION_KIND_TABLE, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_MacroSubcategories"), FIELD_MACRO_SUBCATEGORY_KEY, FIELD_MACRO_SUBCATEGORY_NAME, True, "0;2", 2, 1)
                Case LCase$(FIELD_NAVIGATION_PANE_GROUP)
                    FieldTableLookupDefinition = Array(FIELD_LOOKUP_DEFINITION_KIND_TABLE, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_NavigationPaneGroups"), FIELD_NAVIGATION_PANE_GROUP_NAME, FIELD_NAVIGATION_PANE_GROUP_NAME, True, "0;2", 2, 1)
                Case LCase$(FIELD_TARGET_OBJECT_NAME)
                    FieldTableLookupDefinition = Array(FIELD_LOOKUP_DEFINITION_KIND_LIVE_TARGET, vbNullString, vbNullString, vbNullString, False, "2.5;4", 2, 1)
            End Select
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Candidates"))
            Select Case fieldKey
                Case LCase$(FIELD_CANDIDATE_STATUS)
