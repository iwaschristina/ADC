Private Sub AddSettingGroupFromDefinitions(ByVal definitions As Collection, ByVal seen As Object, ByRef valueListText As String)
    Dim rowData As Variant
    Dim groupName As String
    If definitions Is Nothing Then Exit Sub
    For Each rowData In definitions
        groupName = Trim$(CStr(rowData(4)))
        If Len(groupName) > 0 Then
            If seen.Exists(groupName) = False Then
                seen.Add groupName, True
                If Len(valueListText) > 0 Then valueListText = valueListText & ";"
                valueListText = valueListText & groupName
            End If
        End If
    Next rowData
End Sub

Private Function SettingGroupValueList() As String
    'Derives legal SettingGroup choices from the same setting-definition rows that setup can insert.
    Dim seen As Object
    Dim valueListText As String
    ' INTENTIONAL KEYED LOOKUP: seen provides keyed membership/lookup over source rows or state already read by SettingGroupValueList; it is a derived access path, not a second authority.
    Set seen = CreateObject("Scripting.Dictionary")
    seen.CompareMode = vbTextCompare
    AddSettingGroupFromDefinitions GetCoreSettingDefinitions(), seen, valueListText
    AddSettingGroupFromDefinitions LauncherSettingDefinitions(), seen, valueListText
    SettingGroupValueList = valueListText
End Function

