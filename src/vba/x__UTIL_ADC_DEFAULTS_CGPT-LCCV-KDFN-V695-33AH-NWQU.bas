' Purpose: Resolves system macro counts by ribbon group identity from the supplied/current ADC state, using `isMissing` and `IsObject` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   suppliedSystemMacroDefinitions (Input Optional; Variant): Variant input representing supplied system macro definitions; the routine accepts the caller-provided value in the form required by its
'   existing validation and conversion logic.
' Returns: Object: Returns the resolved object reference. `Nothing` remains the no-object result where the existing routine permits an unresolved or unavailable object.
Public Function SystemMacroCountsByRibbonGroupIdentity(Optional ByVal suppliedSystemMacroDefinitions As Variant) As Object
    Dim counts As Object
    Dim definitions As Collection
    Dim Definition As Variant
    Dim groupIdentity As String
    If isMissing(suppliedSystemMacroDefinitions) = False Then
        If IsObject(suppliedSystemMacroDefinitions) Then Set definitions = suppliedSystemMacroDefinitions
    End If
    If definitions Is Nothing Then Set definitions = GetSystemMacroDefinitions()
    ' INTENTIONAL KEYED LOOKUP: counts provides keyed membership/lookup over source rows or state already read by SystemMacroCountsByRibbonGroupIdentity; it is a derived access path, not a second authority.
    Set counts = CreateObject("Scripting.Dictionary")
    counts.CompareMode = vbTextCompare
    For Each Definition In definitions
        If UBound(Definition) < SYSTEM_MACRO_DEF_RIBBON_GROUP_IDENTITY Then Err.Raise vbObjectError + 6867, "SystemMacroCountsByRibbonGroupIdentity", "The canonical System Macro definition is missing Ribbon placement metadata." & vbCrLf & "SystemMacroKey: " & CStr(Definition(0))
        groupIdentity = Trim$(CStr(Definition(SYSTEM_MACRO_DEF_RIBBON_GROUP_IDENTITY)))
        If Len(groupIdentity) > 0 Then
            If counts.Exists(groupIdentity) Then
                counts(groupIdentity) = CLng(counts(groupIdentity)) + 1
            Else
                counts.Add groupIdentity, CLng(1)
            End If
        End If
    Next Definition
    Set SystemMacroCountsByRibbonGroupIdentity = counts
End Function

' Purpose: Resolves system macro ribbon group identity from the supplied/current ADC state, using `isMissing` and `SystemMacroDefinitionByKey` where required by the lookup path.
' Public role: Public dynamic/form expression API. The name is referenced as text outside this module, so Public visibility is required for Access or generated-expression resolution.
' Parameters:
'   systemMacroKey (Input; String): Stable identity/key used to select the system macro key definition, row, workflow part, or managed object without relying on display text.
'   suppliedDefinition (Input Optional; Variant): Variant input representing supplied definition; the routine accepts the caller-provided value in the form required by its existing validation and
'   conversion logic.
' Returns: String: Returns the system macro ribbon group identity text value. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not
'   resolved.
Public Function SystemMacroRibbonGroupIdentity(ByVal systemMacroKey As String, Optional ByVal suppliedDefinition As Variant) As String
    Dim Definition As Variant
    If isMissing(suppliedDefinition) Then
        Definition = SystemMacroDefinitionByKey(systemMacroKey)
    ElseIf IsArray(suppliedDefinition) Then
        Definition = suppliedDefinition
    Else
        Definition = SystemMacroDefinitionByKey(systemMacroKey)
    End If
    If IsEmpty(Definition) Then Exit Function
    If UBound(Definition) < SYSTEM_MACRO_DEF_RIBBON_GROUP_IDENTITY Then Err.Raise vbObjectError + 6862, "SystemMacroRibbonGroupIdentity", "The canonical System Macro definition is missing Ribbon placement metadata." & vbCrLf & "SystemMacroKey: " & systemMacroKey
    SystemMacroRibbonGroupIdentity = Trim$(CStr(Definition(SYSTEM_MACRO_DEF_RIBBON_GROUP_IDENTITY)))
End Function

' Purpose: Resolves and returns system macro keys for ribbon placement from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   ribbonGroupLabel (Input; String): Display or grouping label used as the ribbon group label for the UI, Ribbon, progress, or definition item being processed.
'   ribbonGroupSortOrder (Input; Long): Numeric sort position that determines the generated Ribbon group’s ordering relative to sibling groups.
'   ribbonTabKey (Input Optional; String): Canonical key identifying the ribbon tab definition, setting, or managed item to use. Default: vbNullString.
'   groupDefinitionIndex (Input Optional; Variant): Caller-supplied group definition index data used as the authoritative definition input for this call, avoiding an unnecessary reload when already available.
'   suppliedSystemMacroDefinitions (Input Optional; Variant): Caller-supplied supplied system macro definitions data used as the authoritative definition input for this call, avoiding an unnecessary reload when
'   already available.
' Returns: Collection: Returns the system macro keys for ribbon placement object/collection resolved by this routine for direct use by the caller; the routine's documented absence/error path applies when no
'   such object can be resolved.
Public Function SystemMacroKeysForRibbonPlacement(ByVal ribbonGroupLabel As String, ByVal ribbonGroupSortOrder As Long, Optional ByVal ribbonTabKey As String = vbNullString, Optional ByVal groupDefinitionIndex As Variant, Optional ByVal suppliedSystemMacroDefinitions As Variant) As Collection
    ' INTENTIONAL FILTERED PARTITION: rows is a consumer-required subset/projection derived from the source enumerated by SystemMacroKeysForRibbonPlacement; its membership is not independently authoritative.
    Dim rows As New Collection
    Dim definitions As Collection
    Dim Definition As Variant
    Dim systemMacroKey As String
    Dim resolvedGroupLabel As String
    Dim resolvedGroupSortOrder As Long
    Dim resolvedTabKey As String
    Dim resolvedTabLabel As String
    Dim resolvedGroupDefinitionIndex As Object
    If isMissing(groupDefinitionIndex) Then
        Set resolvedGroupDefinitionIndex = SystemRibbonGroupDefinitionIndex()
    ElseIf IsObject(groupDefinitionIndex) Then
        Set resolvedGroupDefinitionIndex = groupDefinitionIndex
    End If
    If resolvedGroupDefinitionIndex Is Nothing Then Set resolvedGroupDefinitionIndex = SystemRibbonGroupDefinitionIndex()
    If isMissing(suppliedSystemMacroDefinitions) = False Then
        If IsObject(suppliedSystemMacroDefinitions) Then Set definitions = suppliedSystemMacroDefinitions
    End If
    If definitions Is Nothing Then Set definitions = GetSystemMacroDefinitions()
    For Each Definition In definitions
        systemMacroKey = Trim$(CStr(Definition(0)))
        SystemRibbonPlacementForKey systemMacroKey, resolvedTabKey, resolvedTabLabel, resolvedGroupLabel, resolvedGroupSortOrder, resolvedGroupDefinitionIndex, Definition
        If StrComp(Trim$(resolvedGroupLabel), Trim$(ribbonGroupLabel), vbTextCompare) = 0 And resolvedGroupSortOrder = ribbonGroupSortOrder Then
            If Len(Trim$(ribbonTabKey)) = 0 Or StrComp(Trim$(resolvedTabKey), Trim$(ribbonTabKey), vbTextCompare) = 0 Then rows.Add systemMacroKey
        End If
    Next Definition
    Set SystemMacroKeysForRibbonPlacement = rows
End Function

