' ===============================================================================================================================================================================
' CANONICAL ADC NAMING DATA - DEFINITION PROJECTIONS
' ===============================================================================================================================================================================
' These projections contain no physical table/query naming literals. They consume x__UTIL_ADC_DB_DEFINITIONS and expose the resulting definitions to existing resolver owners
' without creating a second naming authority.

' Purpose: Resolves canonical table query naming definitions from the supplied/current ADC state, using `Static` and `ConvertedValueLookupDefinitions` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
' Returns: Collection: Returns the ordered Collection assembled by the routine; callers receive the object reference and should treat its membership/order according to the routine contract.
' Shared VBA module-header derivation limits used by candidate discovery and configured-target validation.
Private Const MODULE_HEADER_SCAN_LIMIT As Long = 500
Private Const MODULE_HEADER_OWNERSHIP_LOOKAHEAD As Long = 5

Public Function CanonicalTableQueryNamingDefinitions() As Collection
    Static rows As Collection
    Dim convertedLookupDefinition As Variant
    If rows Is Nothing Then
        Set rows = New Collection
        rows.Add Array(FIELD_LOOKUP_DEFINITION_KIND_TABLE, CANON_TABLE_LOGICAL_ID_CONFIG, CANON_TABLE_PHYSICAL_CONFIG)
        rows.Add Array(FIELD_LOOKUP_DEFINITION_KIND_TABLE, CANON_TABLE_LOGICAL_ID_CANDIDATES, CANON_TABLE_PHYSICAL_CANDIDATES)
        rows.Add Array(FIELD_LOOKUP_DEFINITION_KIND_TABLE, CANON_TABLE_LOGICAL_ID_MACROCATEGORIES, CANON_TABLE_PHYSICAL_MACROCATEGORIES)
        rows.Add Array(FIELD_LOOKUP_DEFINITION_KIND_TABLE, CANON_TABLE_LOGICAL_ID_MACROSUBCATEGORIES, CANON_TABLE_PHYSICAL_MACROSUBCATEGORIES)
        rows.Add Array(FIELD_LOOKUP_DEFINITION_KIND_TABLE, CANON_TABLE_LOGICAL_ID_SYSTEMMACROS, CANON_TABLE_PHYSICAL_SYSTEMMACROS)
        rows.Add Array(FIELD_LOOKUP_DEFINITION_KIND_TABLE, CANON_TABLE_LOGICAL_ID_LAUNCHERCONTROLSREVIEW, CANON_TABLE_PHYSICAL_LAUNCHERCONTROLSREVIEW)
        rows.Add Array(FIELD_LOOKUP_DEFINITION_KIND_TABLE, CANON_TABLE_LOGICAL_ID_MODULEUPDATEHISTORY, CANON_TABLE_PHYSICAL_MODULEUPDATEHISTORY)
        rows.Add Array(FIELD_LOOKUP_DEFINITION_KIND_TABLE, CANON_TABLE_LOGICAL_ID_MODULEVERSIONMANIFEST, CANON_TABLE_PHYSICAL_MODULEVERSIONMANIFEST)
        rows.Add Array(FIELD_LOOKUP_DEFINITION_KIND_TABLE, CANON_TABLE_LOGICAL_ID_MODULEVERSIONVERIFICATION, CANON_TABLE_PHYSICAL_MODULEVERSIONVERIFICATION)
        rows.Add Array(FIELD_LOOKUP_DEFINITION_KIND_TABLE, CANON_TABLE_LOGICAL_ID_ACTIVEREFERENCES, CANON_TABLE_PHYSICAL_ACTIVEREFERENCES)
        rows.Add Array(FIELD_LOOKUP_DEFINITION_KIND_TABLE, CANON_TABLE_LOGICAL_ID_AVAILABLEREFERENCES, CANON_TABLE_PHYSICAL_AVAILABLEREFERENCES)
        rows.Add Array(FIELD_LOOKUP_DEFINITION_KIND_TABLE, CANON_TABLE_LOGICAL_ID_LOADEDVBAPROJECTS, CANON_TABLE_PHYSICAL_LOADEDVBAPROJECTS)
        rows.Add Array(FIELD_LOOKUP_DEFINITION_KIND_TABLE, CANON_TABLE_LOGICAL_ID_ACTIVEREFERENCEPROJECTLINKS, CANON_TABLE_PHYSICAL_ACTIVEREFERENCEPROJECTLINKS)
        rows.Add Array(FIELD_LOOKUP_DEFINITION_KIND_TABLE, CANON_TABLE_LOGICAL_ID_REFERENCEMANAGER, CANON_TABLE_PHYSICAL_REFERENCEMANAGER)
