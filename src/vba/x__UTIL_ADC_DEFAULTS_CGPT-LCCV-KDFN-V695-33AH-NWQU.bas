Public Function NavigationPaneGroupRibbonTabLabel(ByVal ribbonTabKey As String) As String
    Select Case UCase$(Trim$(ribbonTabKey))
        Case UCase$(DEFAULT_RIBBON_TAB_KEY_SYSTEM_LOGICAL): NavigationPaneGroupRibbonTabLabel = DEFAULT_RIBBON_TAB_LABEL_SYSTEM_LOGICAL
        Case UCase$(DEFAULT_RIBBON_TAB_KEY_OBJECTS): NavigationPaneGroupRibbonTabLabel = DEFAULT_RIBBON_TAB_LABEL_OBJECTS
