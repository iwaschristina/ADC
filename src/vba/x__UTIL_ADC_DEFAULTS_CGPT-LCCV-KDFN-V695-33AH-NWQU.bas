' Purpose: Resolves managed object type code for name from the supplied/current ADC state, using `ManagedObjectDefinitionRowsForRead` and `StrComp` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   objectName (Input; String): Canonical or physical name identifying the object targeted by this operation.
' Returns: String: Returns the resolved name produced by this routine. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not resolved.
Public Function ManagedObjectTypeCodeForName(ByVal objectName As String) As String
    'Returns the unique canonical managed-object type for one exact name; blank means the name is not registry-owned.
    Dim rowData As Variant
    Dim foundType As String
    If Len(objectName) = 0 Then Exit Function
    For Each rowData In ManagedObjectDefinitionRowsForRead()
        If StrComp(CStr(rowData(MANAGED_DEF_OBJECT_NAME)), objectName, vbTextCompare) = 0 Then
            If Len(foundType) = 0 Then
                foundType = CStr(rowData(MANAGED_DEF_OBJECT_TYPE))
            ElseIf StrComp(foundType, CStr(rowData(MANAGED_DEF_OBJECT_TYPE)), vbTextCompare) <> 0 Then
                Err.Raise vbObjectError + 7812, "ManagedObjectTypeCodeForName", "The canonical managed-object registry contains the same name under more than one object type." & vbCrLf & "Object: " & objectName & vbCrLf & "First type: " & foundType & vbCrLf & "Other type: " & CStr(rowData(MANAGED_DEF_OBJECT_TYPE))
            End If
        End If
    Next rowData
    ManagedObjectTypeCodeForName = foundType
End Function

Private Sub AddB2DefinedLookupMetadataDefinition(ByRef rows As Collection, ByVal tableName As String, ByVal fieldName As String)
    Dim Definition As Variant
    Dim definitionKind As String
    Definition = FieldTableLookupDefinition(tableName, fieldName)
    If IsEmpty(Definition) Then Err.Raise vbObjectError + 7810, "AddB2DefinedLookupMetadataDefinition", "No authoritative B2 lookup definition exists." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName
    definitionKind = UCase$(CStr(Definition(0)))
    Select Case definitionKind
        Case UCase$(FIELD_LOOKUP_DEFINITION_KIND_TABLE)
            rows.Add Array(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_TABLE, fieldName, CStr(Definition(1)), CStr(Definition(2)), CStr(Definition(3)), CBool(Definition(4)), CLng(Definition(6)), CLng(Definition(7)), CStr(Definition(5)))
        Case UCase$(FIELD_LOOKUP_DEFINITION_KIND_LIVE_TARGET)
            rows.Add Array(CATALOG_FIELD_LOOKUP_DEFINITION_KIND_LIVE, fieldName, LiveTargetObjectsLookupRowSource(), vbNullString, vbNullString, CBool(Definition(4)), CLng(Definition(6)), CLng(Definition(7)), CStr(Definition(5)))
        Case Else
            Err.Raise vbObjectError + 7811, "AddB2DefinedLookupMetadataDefinition", "Unsupported authoritative B2 lookup definition kind." & vbCrLf & "Table: " & tableName & vbCrLf & "Field: " & fieldName & vbCrLf & "Kind: " & definitionKind
    End Select
End Sub

Private Sub AddB2CaptionMetadataDefinition(ByRef rows As Collection, ByVal fieldName As String, ByVal captionText As String)
    rows.Add Array("Caption", fieldName, captionText, vbNullString, vbNullString, False, 0, 0, vbNullString)
End Sub

