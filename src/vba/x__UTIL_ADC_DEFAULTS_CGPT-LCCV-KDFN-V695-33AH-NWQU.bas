Private Sub AddCatalogLookupDefinition(ByRef rows As Collection, ByVal fieldName As String, ByVal lookupTableName As String, ByVal codeFieldName As String, ByVal displayFieldName As String, Optional ByVal LimitToList As Boolean = True, Optional ByVal columnWidthsText As String = "0;2")
