' Purpose: Resolves and returns managed form catalog owner rank from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   catalogOwner (Input; String): Canonical catalog-owner identifier used to select/validate which module/domain owns the managed definition.
' Returns: Long: Returns the numeric ordering/rank value for managed form catalog owner rank, used by callers to sort or place the managed item deterministically.
Public Function ManagedFormCatalogOwnerRank(ByVal catalogOwner As String) As Long
    catalogOwner = Trim$(catalogOwner)
    If StrComp(catalogOwner, ADCAT_OWNER_SYSTEM_DEFAULT, vbTextCompare) = 0 Then
        ManagedFormCatalogOwnerRank = 3
    ElseIf StrComp(catalogOwner, DEFAULT_CATALOG_OWNER_GENERATED, vbTextCompare) = 0 Or StrComp(catalogOwner, DEFAULT_CATALOG_OWNER_PERSISTENT_GENERATED, vbTextCompare) = 0 Then
        ManagedFormCatalogOwnerRank = 2
    Else
        ManagedFormCatalogOwnerRank = 1
    End If
End Function

' Purpose: Resolves foundation required non form query names from the supplied/current ADC state, using `isMissing` and `IsObject` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   suppliedFamilyRows (Input Optional; Variant): Variant input representing supplied family rows; the routine accepts the caller-provided value in the form required by its existing validation and
'   conversion logic.
' Returns: Collection: Returns the ordered Collection assembled by the routine; callers receive the object reference and should treat its membership/order according to the routine contract.
Public Function FoundationRequiredNonFormQueryNames(Optional ByVal suppliedFamilyRows As Variant) As Collection
    'Name-only projection of the canonical A3 required non-form query classification rows.
    ' INTENTIONAL FILTERED PARTITION: rows is a consumer-required subset/projection derived from the source enumerated by FoundationRequiredNonFormQueryNames; its membership is not independently authoritative.
    Dim rows As New Collection
    Dim familyRows As Collection
    Dim rowData As Variant
    If isMissing(suppliedFamilyRows) = False Then
        If IsObject(suppliedFamilyRows) Then Set familyRows = suppliedFamilyRows
    End If
    If familyRows Is Nothing Then Set familyRows = FoundationRequiredNonFormQueryFamilyRows()
    For Each rowData In familyRows
        rows.Add CStr(rowData(0))
    Next rowData
    Set FoundationRequiredNonFormQueryNames = rows
End Function

' Purpose: Resolves foundation required non form query family rows from the supplied/current ADC state, using `ManagedObjectDefinitionRowsForRead` and `StrComp` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
' Returns: Collection: Returns the ordered Collection assembled by the routine; callers receive the object reference and should treat its membership/order according to the routine contract.
Public Function FoundationRequiredNonFormQueryFamilyRows() As Collection
    'Returns each A3 required non-form query plus each retained canonical FormDesign source query once. The existing FormDesign family value is retained at element 1; elements 2-3 are canonical classification flags
    'so consumers do not recreate name, suffix, group, or family tests.
    ' INTENTIONAL FILTERED PARTITION: rows is a consumer-required subset/projection derived from the source enumerated by FoundationRequiredNonFormQueryFamilyRows; its membership is not independently authoritative.
    Dim rows As New Collection
    Dim rowData As Variant
    Dim definitionGroup As String
    Dim formDesignFamily As String
    Dim isFormDesignSource As Boolean
    For Each rowData In ManagedObjectDefinitionRowsForRead()
        definitionGroup = CStr(rowData(MANAGED_DEF_GROUP))
        If CBool(rowData(MANAGED_DEF_FOUNDATION_NONFORM_QUERY)) Or StrComp(definitionGroup, MANAGED_GROUP_FORM_DESIGN_QUERY, vbBinaryCompare) = 0 Then
            formDesignFamily = CStr(rowData(MANAGED_DEF_FORMDESIGN_BUILD_FAMILY))
            isFormDesignSource = (StrComp(formDesignFamily, MANAGED_FORMDESIGN_FAMILY_SOURCE, vbBinaryCompare) = 0)
            If StrComp(definitionGroup, MANAGED_GROUP_FORM_DESIGN_QUERY, vbBinaryCompare) = 0 Then
                If isFormDesignSource = False Then Err.Raise vbObjectError + 7816, "FoundationRequiredNonFormQueryFamilyRows", "A canonical FormDesign query has an unsupported retained build family." & vbCrLf & "Query: " & CStr(rowData(MANAGED_DEF_OBJECT_NAME)) & vbCrLf & "Family: " & formDesignFamily
            End If
            rows.Add Array(CStr(rowData(MANAGED_DEF_OBJECT_NAME)), formDesignFamily, False, isFormDesignSource)
        End If
    Next rowData
    Set FoundationRequiredNonFormQueryFamilyRows = rows
End Function

