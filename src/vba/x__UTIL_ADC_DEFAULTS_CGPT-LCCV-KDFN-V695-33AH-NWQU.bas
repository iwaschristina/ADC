' Purpose: Returns an explicitly authored permanent tag for canonical managed objects and System Macros. Dynamic discovered user forms intentionally return False; CATALOG derives their persisted Ribbon key from
'   canonical
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   objectTypeCode (Input; String): Access object-type code identifying the class of database object targeted by the operation.
'   objectName (Input; String): Physical Access object name identifying the database object targeted by the operation.
'   ribbonStaticTag (Output; String): Receives the resolved ribbon static tag produced from this procedure's validated inputs and current ADC state.
' Returns: Boolean: True when the attempt to ribbon static button tag default completes successfully; False for the routine's defined normal unsuccessful/not-applicable outcome.
Public Function TryRibbonStaticButtonTagDefault(ByVal objectTypeCode As String, ByVal objectName As String, ByRef ribbonStaticTag As String) As Boolean
    'Returns an explicitly authored permanent tag for canonical managed objects and System Macros. Dynamic discovered user forms intentionally return False; CATALOG derives their persisted Ribbon key from canonical
    'ObjectDisplayName.
    Dim definitionData As Variant
    Dim systemMacroKey As String
    ribbonStaticTag = vbNullString
    objectTypeCode = Trim$(objectTypeCode)
    If StrComp(objectTypeCode, ADCAT_OBJECT_TYPE_MACRO, vbTextCompare) = 0 Then
        systemMacroKey = RibbonSystemMacroKeyForObjectDesignatorDefault(objectName, definitionData)
        If Len(systemMacroKey) > 0 Then
            If IsEmpty(definitionData) = False Then ribbonStaticTag = SystemMacroRibbonStaticTag(systemMacroKey, definitionData)
        End If
    End If
    If Len(ribbonStaticTag) = 0 Then
        If TryGetManagedObjectDefinition(objectName, objectTypeCode, definitionData) Then ribbonStaticTag = CStr(definitionData(MANAGED_DEF_RIBBON_STATIC_TAG))
    End If
    TryRibbonStaticButtonTagDefault = (Len(ribbonStaticTag) > 0)
End Function

Private Function ManagedObjectNamesByGroup(ByVal definitionGroup As String) As Collection
    ' INTENTIONAL FILTERED PARTITION: rows is a consumer-required subset/projection derived from the source enumerated by ManagedObjectNamesByGroup; its membership is not independently authoritative.
    Dim rows As New Collection
    Dim rowData As Variant
    For Each rowData In ManagedObjectDefinitionRowsForRead()
        If StrComp(CStr(rowData(MANAGED_DEF_GROUP)), definitionGroup, vbTextCompare) = 0 Then rows.Add CStr(rowData(MANAGED_DEF_OBJECT_NAME))
    Next rowData
    Set ManagedObjectNamesByGroup = rows
End Function

