' Purpose: Resolves system macro utility action definitions from the supplied/current ADC state, using `isMissing` and `IsObject` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   suppliedSystemMacroDefinitions (Input Optional; Variant): Variant input representing supplied system macro definitions; the routine accepts the caller-provided value in the form required by its
'   existing validation and conversion logic.
' Returns: Collection: Returns the ordered Collection assembled by the routine; callers receive the object reference and should treat its membership/order according to the routine contract.
Public Function SystemMacroUtilityActionDefinitions(Optional ByVal suppliedSystemMacroDefinitions As Variant) As Collection
    ' INTENTIONAL SORTED PROJECTION: rows selects SystemMacro definitions carrying utility-action metadata and emits them in authoritative utility-action order;
    ' GetSystemMacroDefinitions remains the source authority.
    Dim rows As New Collection
    Dim definitions As Collection
    Dim actionMap As Object
    Dim Definition As Variant
    Dim actionOrder As Long
    Dim maxActionOrder As Long
    Dim mapKey As String
    If isMissing(suppliedSystemMacroDefinitions) = False Then
        If IsObject(suppliedSystemMacroDefinitions) Then Set definitions = suppliedSystemMacroDefinitions
    End If
    If definitions Is Nothing Then Set definitions = GetSystemMacroDefinitions()
    ' INTENTIONAL KEYED LOOKUP: actionMap provides keyed membership/lookup over source rows or state already read by SystemMacroUtilityActionDefinitions; it is a derived access path, not a second authority.
    Set actionMap = CreateObject("Scripting.Dictionary")
    actionMap.CompareMode = vbTextCompare
    For Each Definition In definitions
        If UBound(Definition) >= SYSTEM_MACRO_DEF_UTILITY_ACTION_TOOLTIP Then
            actionOrder = CLng(Definition(SYSTEM_MACRO_DEF_UTILITY_ACTION_ORDER))
            If actionOrder > 0 Then
                mapKey = CStr(actionOrder)
                If actionMap.Exists(mapKey) Then Err.Raise vbObjectError + 8800, "SystemMacroUtilityActionDefinitions", "Duplicate utility-action order exists in SystemMacroDefinitions: " & mapKey
                actionMap.Add mapKey, Definition
                If actionOrder > maxActionOrder Then maxActionOrder = actionOrder
            End If
        End If
    Next Definition
    For actionOrder = 1 To maxActionOrder
        mapKey = CStr(actionOrder)
        If actionMap.Exists(mapKey) = False Then Err.Raise vbObjectError + 8801, "SystemMacroUtilityActionDefinitions", "Missing utility-action order in SystemMacroDefinitions: " & mapKey
        rows.Add actionMap(mapKey)
    Next actionOrder
    Set SystemMacroUtilityActionDefinitions = rows
End Function

