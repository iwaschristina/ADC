            rows.Add "=ChatGPT_HelpBack()"
            rows.Add "=ChatGPT_HelpForward()"
            rows.Add "=ChatGPT_HelpPrevious()"
            rows.Add "=ChatGPT_HelpNext()"
            rows.Add "=ChatGPT_HelpOpenRelated()"
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_GENERATED_FORM, CANON_GENERATED_FORM_LOGICAL_ID_REPORT_ERROR_DIALOG))
            rows.Add "=ReportErrorDialogSubmit()"
            rows.Add "=ReportErrorDialogCancel()"
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_GENERATED_FORM, CANON_GENERATED_FORM_LOGICAL_ID_ADD_IN_REVIEW))
            rows.Add "=ChatGPT_AddInReviewRefreshDisplay()"
            rows.Add "=AddInReviewScanInventory_ChatGptUI()"
            rows.Add "=AddInReviewScanLoadedVBAAnalysis_ChatGptUI()"
            rows.Add "=ChatGPT_AddInReviewOpenRawData()"
            rows.Add "=ChatGPT_AddInReviewClearFilters()"
    End Select
    Set GeneratedFormContractCallbackExpressions = rows
End Function

' Purpose: Resolves and returns generated form contract callback expression from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   formName (Input; String): Physical Access form name identifying the form to create, open, configure, validate, or inspect.
'   oneBasedIndex (Input; Long): Index selecting the one based index item or position within the caller-supplied definition/source sequence.
'   suppliedExpressions (Input Optional; Variant): Expression text representing the supplieds calculation, RunCode target, SQL fragment, or UI binding interpreted by this routine.
' Returns: String: Returns the exact Access/VBA expression text for generated form contract callback expression, including the quoting/callback syntax required by its generated UI or query consumer.
Public Function GeneratedFormContractCallbackExpression(ByVal formName As String, ByVal oneBasedIndex As Long, Optional ByVal suppliedExpressions As Variant) As String
    Dim expressions As Collection
    If isMissing(suppliedExpressions) = False Then
        If IsObject(suppliedExpressions) Then Set expressions = suppliedExpressions
    End If
    If expressions Is Nothing Then Set expressions = GeneratedFormContractCallbackExpressions(formName)
    If oneBasedIndex < 1 Or oneBasedIndex > expressions.count Then Err.Raise vbObjectError + 7395, "GeneratedFormContractCallbackExpression", "The generated-form callback-contract index is outside the authoritative contract." & vbCrLf & "Form: " & formName & vbCrLf & "Index: " & CStr(oneBasedIndex) & vbCrLf & "Count: " & CStr(expressions.count)
    GeneratedFormContractCallbackExpression = CStr(expressions(oneBasedIndex))
