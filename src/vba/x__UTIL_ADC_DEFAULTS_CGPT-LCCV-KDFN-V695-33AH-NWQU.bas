        Case LCase$(FIELD_ISSUE_HASH): HealthReviewFieldDescription = FIELD_DESC_LONG_HEALTH_REVIEW_ISSUEHASH
        Case LCase$(FIELD_IS_CURRENT_RUN): HealthReviewFieldDescription = FIELD_DESC_LONG_HEALTH_REVIEW_ISCURRENTRUN
