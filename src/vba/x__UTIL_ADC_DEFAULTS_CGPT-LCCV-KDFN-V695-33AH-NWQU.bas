' Purpose: Resolves managed object names by B1 family from the supplied/current ADC state, using `ManagedObjectDefinitionRowsForRead` and `StrComp` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   familyCode (Input; String): Canonical code used to classify or select the family code behavior.
' Returns: Collection: Returns the ordered Collection assembled by the routine; callers receive the object reference and should treat its membership/order according to the routine contract.
Public Function ManagedObjectNamesByB1Family(ByVal familyCode As String) As Collection
    ' INTENTIONAL FILTERED PARTITION: rows is a consumer-required subset/projection derived from the source enumerated by ManagedObjectNamesByB1Family; its membership is not independently authoritative.
    ' INTENTIONAL ORDERED VIEW: repairOrders preserves the deterministic sequence required by ManagedObjectNamesByB1Family; keyed-only or unordered storage would not preserve the consumer semantics.
    Dim rows As New Collection
    Dim repairOrders As New Collection
    Dim rowData As Variant
    Dim insertIndex As Long
    Dim repairOrder As Long
    Dim inserted As Boolean
    For Each rowData In ManagedObjectDefinitionRowsForRead()
        If StrComp(CStr(rowData(MANAGED_DEF_B1_FAMILY)), familyCode, vbTextCompare) = 0 Then
            repairOrder = CLng(rowData(MANAGED_DEF_B1_REPAIR_ORDER))
            If repairOrder <= 0 Then Err.Raise vbObjectError + 7792, "ManagedObjectNamesByB1Family", "A B1 managed object is missing its canonical repair order." & vbCrLf & "Family: " & familyCode & vbCrLf & "Object: " & CStr(rowData(MANAGED_DEF_OBJECT_NAME))
            inserted = False
            For insertIndex = 1 To repairOrders.count
                If repairOrder < CLng(repairOrders(insertIndex)) Then
                    rows.Add CStr(rowData(MANAGED_DEF_OBJECT_NAME)), Before:=insertIndex
                    repairOrders.Add repairOrder, Before:=insertIndex
                    inserted = True
                    Exit For
                End If
                If repairOrder = CLng(repairOrders(insertIndex)) Then Err.Raise vbObjectError + 7793, "ManagedObjectNamesByB1Family", "A B1 family contains a duplicate canonical repair order." & vbCrLf & "Family: " & familyCode & vbCrLf & "RepairOrder: " & CStr(repairOrder)
            Next insertIndex
            If inserted = False Then
                rows.Add CStr(rowData(MANAGED_DEF_OBJECT_NAME))
                repairOrders.Add repairOrder
            End If
        End If
    Next rowData
    Set ManagedObjectNamesByB1Family = rows
End Function

