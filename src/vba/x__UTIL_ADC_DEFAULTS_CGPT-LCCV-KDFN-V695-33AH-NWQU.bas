' Purpose: Resolves and returns generated form ribbon group sort order from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   groupLabel (Input; String): Display or grouping label used as the group label for the UI, Ribbon, progress, or definition item being processed.
' Returns: Long: Returns the numeric ordering/rank value for generated form ribbon group sort order, used by callers to sort or place the managed item deterministically.
Public Function GeneratedFormRibbonGroupSortOrder(ByVal groupLabel As String) As Long
    Dim rowData As Variant
    groupLabel = Trim$(groupLabel)
    For Each rowData In ManagedRibbonGroupDefaults()
        If Left$(CStr(rowData(0)), Len("GENERATED_")) = "GENERATED_" Then
            If StrComp(CStr(rowData(1)), groupLabel, vbTextCompare) = 0 Then
                GeneratedFormRibbonGroupSortOrder = CLng(rowData(2))
                Exit Function
            End If
        End If
    Next rowData
    GeneratedFormRibbonGroupSortOrder = DEFAULT_GENERATED_FORM_RIBBON_SORT_FALLBACK
End Function


' Purpose: Attempts to perform resolve user form ribbon group placement for candidate group label.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   candidateGroupLabel (Input; String): Display or grouping label used as the candidate group label for the UI, Ribbon, progress, or definition item being processed.
'   resolvedGroupLabel (Output; String): Receives the resolved group label returned by `CStr` after this procedure completes its validation/resolution work.
'   resolvedGroupSortOrder (Output; Long): Receives the resolved group sort order returned by `CLng` after this procedure completes its validation/resolution work.
' Returns: Boolean: True when the attempt to resolve user form ribbon group placement completes successfully; False for the routine's defined normal unsuccessful/not-applicable outcome.
Public Function TryResolveUserFormRibbonGroupPlacement(ByVal candidateGroupLabel As String, ByRef resolvedGroupLabel As String, ByRef resolvedGroupSortOrder As Long) As Boolean
    'Accepts only explicitly authored permanent user-Form Ribbon groups and returns their canonical label/order. Arbitrary persisted X-prefixed labels are not Ribbon-placement authority.
    Dim rowData As Variant
    Dim groupKey As String
    candidateGroupLabel = Trim$(candidateGroupLabel)
    resolvedGroupLabel = vbNullString
    resolvedGroupSortOrder = 0
    If Len(candidateGroupLabel) = 0 Then Exit Function
    For Each rowData In ManagedRibbonGroupDefaults()
        groupKey = UCase$(Trim$(CStr(rowData(0))))
        If Left$(groupKey, Len("USER_")) = "USER_" Then
            If StrComp(Trim$(CStr(rowData(3))), DEFAULT_RIBBON_TAB_KEY_FORMS, vbTextCompare) = 0 And StrComp(Trim$(CStr(rowData(1))), candidateGroupLabel, vbTextCompare) = 0 Then
                resolvedGroupLabel = CStr(rowData(1))
                resolvedGroupSortOrder = CLng(rowData(2))
                If Len(Trim$(CStr(rowData(4)))) = 0 Then Err.Raise vbObjectError + 6866, "TryResolveUserFormRibbonGroupPlacement", "An explicitly authored user-Form Ribbon group has no permanent group tag." & vbCrLf & "Group: " & resolvedGroupLabel
                TryResolveUserFormRibbonGroupPlacement = True
                Exit Function
            End If
        End If
    Next rowData
End Function

