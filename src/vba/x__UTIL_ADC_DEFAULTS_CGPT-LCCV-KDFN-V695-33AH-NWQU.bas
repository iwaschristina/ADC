'   sourceName (Input Optional; String): Name of the source object/query/table/control from which this operation reads or to which the generated definition is bound. Default: vbNullString.
' Returns: Variant: Returns the canonical generated form lookup definition definition payload consumed by the generated-form builder; the function's empty/Null representation indicates that no definition
'   applies.
Public Function GeneratedFormLookupDefinition(ByVal fieldName As String, Optional ByVal sourceName As String = vbNullString) As Variant
    Dim physicalValueListText As String
    Dim limitToListValue As Boolean
    Dim convertedTable As String
    convertedTable = ConvertedValueLookupTableForField(sourceName, fieldName)
    If Len(convertedTable) > 0 Then GeneratedFormLookupDefinition = Array(GENERATED_FORM_LOOKUP_KIND_TWO_COLUMN, ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, convertedTable), FIELD_VALUE_TEXT, FIELD_VALUE_TEXT, vbNullString, Split(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER & "|" & FIELD_VALUE_TEXT, "|"), "0;2", True): Exit Function
    limitToListValue = True
    Select Case UCase$(sourceName)
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Config")), _
             UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, CONFIG_MANAGEMENT_QUERY_LOGICAL_ID))
            Select Case LCase$(Trim$(fieldName))
                Case LCase$(FIELD_TARGET_PROCEDURE_KIND), LCase$(FIELD_RESULT_HANDLING), LCase$(FIELD_EXPECTED_RETURN_TYPE), LCase$(FIELD_CONFIRMATION_MODE)
                    physicalValueListText = TableFieldLookupValueList(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Config"), fieldName)
            End Select
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Candidates")), _
             UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_Config_CandidateReview")), _
             UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_Config_Candidates"))
            Select Case LCase$(Trim$(fieldName))
                Case LCase$(FIELD_TARGET_PROCEDURE_KIND), LCase$(FIELD_RESULT_HANDLING), LCase$(FIELD_EXPECTED_RETURN_TYPE), LCase$(FIELD_CONFIRMATION_MODE), LCase$(FIELD_ENTRY_POINT_MATCH_CONFIDENCE)
                    physicalValueListText = TableFieldLookupValueList(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_Candidates"), fieldName)
            End Select
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_SETTINGS_TABLE_LOGICAL_ID)), _
             UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_Settings_Resolved"))
            Select Case LCase$(Trim$(fieldName))
                Case LCase$(FIELD_MANAGED_OBJECT_FIELD_DATA_TYPE), LCase$(FIELD_SETTING_GROUP)
                    physicalValueListText = TableFieldLookupValueList(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, DEFAULT_SETTINGS_TABLE_LOGICAL_ID), fieldName)
            End Select
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_LauncherControlsReview")), _
             UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_LauncherControls_Review"))
            Select Case LCase$(Trim$(fieldName))
                Case LCase$(FIELD_ISSUE_TYPE)
                    physicalValueListText = TableFieldLookupValueList(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_LauncherControlsReview"), fieldName)
            End Select
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_NavigationPaneGroups"))
            If StrComp(Trim$(fieldName), FIELD_GROUP_PURPOSE, vbTextCompare) = 0 Or StrComp(Trim$(fieldName), FIELD_SETTING_KEY, vbTextCompare) = 0 Then
                physicalValueListText = TableFieldLookupValueList(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_NavigationPaneGroups"), fieldName)
                If StrComp(Trim$(fieldName), FIELD_SETTING_KEY, vbTextCompare) = 0 Then limitToListValue = False
            End If
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros"))
            If StrComp(Trim$(fieldName), FIELD_SYSTEM_MACRO_GROUP_KEY, vbTextCompare) = 0 Then physicalValueListText = TableFieldLookupValueList(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, "ADC_SystemMacros"), fieldName)
            Select Case LCase$(Trim$(fieldName))
                Case LCase$(FIELD_OBJECT_TYPE), "itemtype", "auditresult", "applicationresult"
            End Select
    End Select
    If Len(physicalValueListText) > 0 Then
        GeneratedFormLookupDefinition = Array(GENERATED_FORM_LOOKUP_KIND_VALUE_LIST, physicalValueListText, vbNullString, vbNullString, vbNullString, Empty, vbNullString, limitToListValue)
        Exit Function
    End If
