Public Function ProcedureDeclarationText(ByVal codeModule As Object, ByVal startLine As Long) As String
    On Error GoTo ErrHandler
    Dim lineIndex As Long
    Dim maxLine As Long
    Dim lineText As String
    Dim declarationText As String
    maxLine = startLine + 25
    If maxLine > codeModule.CountOfLines Then maxLine = codeModule.CountOfLines
    For lineIndex = startLine To maxLine
        PumpSetupResponsiveness
        lineText = Trim$(codeModule.lines(lineIndex, 1))
        If Len(lineText) = 0 Then
            'Skip blank lines before the declaration.
        ElseIf Left$(lineText, 1) = "'" Then
            'Skip comments before the declaration.
        ElseIf (StrComp(Left$(lineText, Len("Attribute ")), "Attribute ", vbTextCompare) = 0) Then
            'Skip hidden attribute lines.
        Else
            declarationText = CodeLineWithoutTrailingComment(lineText)
            Do While VbaLineContinues(declarationText) And lineIndex < maxLine
                PumpSetupResponsiveness
                declarationText = RemoveVbaLineContinuation(declarationText)
                lineIndex = lineIndex + 1
                declarationText = declarationText & " " & CodeLineWithoutTrailingComment(codeModule.lines(lineIndex, 1))
            Loop
            ProcedureDeclarationText = declarationText
            Exit Function
        End If
    Next lineIndex
    Exit Function
ErrHandler:
    ProcedureDeclarationText = vbNullString
End Function

Private Sub CountProcedureArguments(ByVal argumentSignature As String, ByRef RequiredArgumentCount As Long, ByRef OptionalArgumentCount As Long)
    Dim args As Collection
    Dim item As Variant
    Dim argText As String
    RequiredArgumentCount = 0
    OptionalArgumentCount = 0
    Set args = SplitTopLevelCommaText(argumentSignature)
    For Each item In args
        PumpSetupResponsiveness
        argText = Trim$(CStr(item))
        If Len(argText) > 0 Then
            If ProcedureArgumentIsOptional(argText) Then
                OptionalArgumentCount = OptionalArgumentCount + 1
            Else
                RequiredArgumentCount = RequiredArgumentCount + 1
            End If
        End If
    Next item
End Sub

Public Sub ReadModuleHeaderMetadata(ByVal moduleTopText As String, ByRef headerFound As Boolean, ByRef headerMalformed As Boolean, ByRef headerTitle As String, ByRef headerPurpose As String, ByRef headerEntryPointsRaw As String, ByRef headerScanNotes As String)
    On Error GoTo ErrHandler
    Dim codeLines As Variant
    Dim maxScanIndex As Long
    Dim headerStartIndex As Long
    Dim headerEndIndex As Long
    headerFound = False
    headerMalformed = False
    headerTitle = vbNullString
    headerPurpose = vbNullString
    headerEntryPointsRaw = vbNullString
    headerScanNotes = vbNullString
    codeLines = Split(moduleTopText, vbLf)
    maxScanIndex = UBound(codeLines)
    headerStartIndex = FirstNonBlankLineIndex(codeLines, maxScanIndex)
    If headerStartIndex < 0 Then
        headerScanNotes = "No code lines were available for header scanning."
        Exit Sub
    End If
    If HasRecognizedHeaderStart(codeLines, maxScanIndex, headerStartIndex) = False Then
        headerScanNotes = "No recognized managed top header was found."
        Exit Sub
    End If
    headerFound = True
    headerTitle = HeaderTitleFromLines(codeLines, headerStartIndex, maxScanIndex)
    headerEndIndex = ManagedHeaderEndIndex(codeLines, headerStartIndex, maxScanIndex)
    If headerEndIndex < 0 Then
        headerMalformed = True
        headerEndIndex = maxScanIndex
        headerScanNotes = "Recognized managed header is missing its closing separator line."
    Else
        headerScanNotes = "Recognized managed header found."
    End If
    headerPurpose = HeaderValueByPrefix(codeLines, headerStartIndex, headerEndIndex, "' Purpose:")
    headerEntryPointsRaw = HeaderValueByPrefix(codeLines, headerStartIndex, headerEndIndex, "' Entry Points:")
    Exit Sub
ErrHandler:
    headerScanNotes = "Header scan failed. Err.Number " & CStr(Err.Number) & "; Err.Source " & Err.Source & "; Err.Description " & Err.Description
End Sub

Public Function CodeModuleTopText(ByVal codeModule As Object) As String
    On Error GoTo ErrHandler
    Dim lineCount As Long
    lineCount = codeModule.CountOfLines
    If lineCount > MODULE_HEADER_SCAN_LIMIT Then lineCount = MODULE_HEADER_SCAN_LIMIT
    If lineCount <= 0 Then Exit Function
    CodeModuleTopText = Replace(codeModule.lines(1, lineCount), vbCrLf, vbLf)
    CodeModuleTopText = Replace(CodeModuleTopText, vbCr, vbLf)
    Exit Function
ErrHandler:
    CodeModuleTopText = vbNullString
End Function

Public Function ModuleHasOptionPrivateModule(ByVal codeModule As Object) As Boolean
    On Error GoTo ErrHandler
    Dim lineIndex As Long
    Dim maxLine As Long
    Dim lineText As String
    maxLine = codeModule.CountOfLines
    If maxLine > 100 Then maxLine = 100
    For lineIndex = 1 To maxLine
        PumpSetupResponsiveness
        lineText = Shared_String_CompactSpaces(CodeLineWithoutTrailingComment(codeModule.lines(lineIndex, 1)))
        If Len(lineText) = 0 Then
            'Skip blank/comment/attribute lines.
        ElseIf (StrComp(Left$(lineText, Len("Attribute ")), "Attribute ", vbTextCompare) = 0) Then
            'Skip hidden attribute lines.
        ElseIf (StrComp(Left$(lineText, Len("Option Private Module")), "Option Private Module", vbTextCompare) = 0) Then
            ModuleHasOptionPrivateModule = True
            Exit Function
        ElseIf (StrComp(Left$(lineText, Len("Public ")), "Public ", vbTextCompare) = 0) Or (StrComp(Left$(lineText, Len("Private ")), "Private ", vbTextCompare) = 0) Or (StrComp(Left$(lineText, Len("Friend ")), "Friend ", vbTextCompare) = 0) Or (StrComp(Left$(lineText, Len("Sub ")), "Sub ", vbTextCompare) = 0) Or (StrComp(Left$(lineText, Len("Function ")), "Function ", vbTextCompare) = 0) Then
            Exit Function
        End If
    Next lineIndex
    Exit Function
ErrHandler:
    ModuleHasOptionPrivateModule = False
End Function

Private Function HasRecognizedHeaderStart(ByVal codeLines As Variant, ByVal maxScanIndex As Long, ByVal headerStartIndex As Long) As Boolean
    Dim firstLineText As String
    Dim i As Long
    Dim endLookaheadIndex As Long
    Dim lineText As String
    firstLineText = Trim$(CStr(codeLines(headerStartIndex)))
    If IsComponentHeaderLine(firstLineText) Then
        HasRecognizedHeaderStart = True
        Exit Function
    End If
    If Not IsHeaderSeparatorLine(firstLineText) Then Exit Function
    endLookaheadIndex = headerStartIndex + MODULE_HEADER_OWNERSHIP_LOOKAHEAD
    If endLookaheadIndex > maxScanIndex Then endLookaheadIndex = maxScanIndex
    For i = headerStartIndex + 1 To endLookaheadIndex
        PumpSetupResponsiveness
        lineText = Trim$(CStr(codeLines(i)))
        If Len(lineText) = 0 Then
            'Allow blank lines between opening separator and component header.
        ElseIf IsComponentHeaderLine(lineText) Then
            HasRecognizedHeaderStart = True
            Exit Function
        Else
            Exit Function
        End If
    Next i
End Function

Public Sub BuildEntryPointNameDictionaries(ByVal headerEntryPointsRaw As String, ByRef exactEntryPointNames As Object, ByRef allEntryPointIdentifiers As Object)
    Dim normalizedText As String
    Dim lines() As String
    Dim i As Long
    Dim lineText As String
    Dim firstToken As String
    ' INTENTIONAL KEYED LOOKUP: exactEntryPointNames, allEntryPointIdentifiers provides keyed membership/lookup over source rows or state already read by BuildEntryPointNameDictionaries; it is a derived access path,
    ' not a second authority.
    Set exactEntryPointNames = CreateObject("Scripting.Dictionary")
    exactEntryPointNames.CompareMode = 1
    Set allEntryPointIdentifiers = CreateObject("Scripting.Dictionary")
    allEntryPointIdentifiers.CompareMode = 1
    normalizedText = Replace(headerEntryPointsRaw, vbCrLf, vbLf)
    normalizedText = Replace(normalizedText, vbCr, vbLf)
    lines = Split(normalizedText, vbLf)
    For i = LBound(lines) To UBound(lines)
        PumpSetupResponsiveness
        lineText = Trim$(CStr(lines(i)))
        If Left$(lineText, 1) = "-" Or Left$(lineText, 1) = "*" Then lineText = Trim$(Mid$(lineText, 2))
        If Len(lineText) > 0 Then
            firstToken = LCase$(FirstIdentifierToken(lineText))
            If Len(firstToken) > 0 Then
                If exactEntryPointNames.Exists(firstToken) = False Then exactEntryPointNames.Add firstToken, True
            End If
            AddIdentifierTokensToDictionary lineText, allEntryPointIdentifiers
        End If
    Next i
End Sub
