    SystemMacroCalculatedTitleFromResolvedValues = TargetManagedObjectPhysicalName(NAMING_CATEGORY_SYSTEM_MACRO, logicalTitle)
End Function

' Intended use: Close the first-build Setup Part roster boundary to the trace file without allowing diagnostic failures to affect definition authority.
Private Sub LogSetupPartDefinitionCacheBoundary(ByVal messageText As String, Optional ByVal detailText As String = vbNullString, Optional ByVal traceLevel As String = "Info")
    On Error Resume Next
    LogTraceMessage traceLevel, "SetupTiming", "SetupPartDefinitionCache", messageText, detailText, "Setup Part roster cache", 0, vbNullString, vbNullString, "GetSystemMacroDefinitions", "DefinitionCache", "CodeDb", "Performance"
    FlushTraceLogFile
    On Error GoTo 0
End Sub

' Intended use: Build the canonical Setup Part sequence once from only the authoritative setup-part source blocks without exposing the cached collection to callers.
Private Function SetupPartDefinitionCache() As Collection
    ' INTENTIONAL STATIC CANONICAL CACHE: cachedRows holds the ordered Setup-Part identity roster derived from immutable authoritative SystemMacro source blocks. It is valid for the loaded-code lifetime, has no
    ' invalidation path because the source is code-defined, and private callers treat the shared Collection as read-only.
    Static cachedRows As Collection
    Dim sourceRows As Collection
    Dim rows As Collection
    Dim definitionData As Variant
    Dim setupPartIdentity As String
    Dim startTimer As Single
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    On Error GoTo ErrHandler
    If cachedRows Is Nothing Then
        startTimer = Timer
        LogSetupPartDefinitionCacheBoundary "Setup Part roster cache initialization starting.", _
            "Source authority: AddSystemMacroDefinitionsPart3SetupParts plus AddSystemMacroDefinitionsPart4. Unrelated System Macro definition rows are not materialized."
        ' CANONICAL AUTHORITY: sourceRows materializes only the authoritative Setup-Part SystemMacro source blocks used by this private roster builder.
        ' INTENTIONAL FILTERED PARTITION + ORDERED ITERATION: rows extracts only Setup-Part identities and preserves their canonical source order before assignment to cachedRows.
        Set sourceRows = New Collection
        AddSystemMacroDefinitionsPart3SetupParts sourceRows, vbNullString, vbNullString
        AddSystemMacroDefinitionsPart4 sourceRows, vbNullString, vbNullString, vbNullString
        Set rows = New Collection
        For Each definitionData In sourceRows
            If UBound(definitionData) >= SYSTEM_MACRO_DEF_EXECUTION_TARGET_IDENTITY Then
                If StrComp(Trim$(CStr(definitionData(SYSTEM_MACRO_DEF_EXECUTION_KIND))), SYSTEM_MACRO_EXECUTION_SETUP_PART, vbTextCompare) = 0 Then
                    setupPartIdentity = Trim$(CStr(definitionData(SYSTEM_MACRO_DEF_EXECUTION_TARGET_IDENTITY)))
                    If Len(setupPartIdentity) = 0 Then Err.Raise vbObjectError + 9586, "SetupPartDefinitionCache", "A canonical Setup Part SystemMacro definition has a blank execution-target identity."
                    rows.Add setupPartIdentity
                End If
            End If
        Next definitionData
        If rows.count = 0 Then Err.Raise vbObjectError + 9586, "SetupPartDefinitionCache", "No canonical Setup Part identities were found in the authoritative setup-part System Macro source blocks."
        Set cachedRows = rows
        LogSetupPartDefinitionCacheBoundary "Setup Part roster cache initialization completed.", _
            "Setup Part identities cached: " & CStr(cachedRows.count) & " | Source rows inspected: " & CStr(sourceRows.count) & " | Elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(startTimer))
    End If
    Set SetupPartDefinitionCache = cachedRows
    Exit Function
ErrHandler:
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    LogSetupPartDefinitionCacheBoundary "Setup Part roster cache initialization failed.", _
        "Elapsed: " & FormattedElapsedSeconds(ElapsedSecondsFromTimer(startTimer)) & " | Err.Number: " & CStr(savedErrNumber) & " | Err.Source: " & savedErrSource & " | Err.Description: " & savedErrDescription, "Error"
    Err.Raise savedErrNumber, savedErrSource, savedErrDescription
End Function

' Purpose: Resolves implemented setup part identity from the supplied/current ADC state, using `SetupPartDefinitionCache` and `StrComp` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   partIdentity (Input; String): Stable identity/key used to select the part identity definition, row, workflow part, or managed object without relying on display text.
' Returns: String: Returns the implemented setup part identity text value. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not
'   resolved.
Public Function ImplementedSetupPartIdentity(ByVal partIdentity As String) As String
    Dim definitions As Collection
    Dim partItem As Variant
    partIdentity = UCase$(Trim$(partIdentity))
    If Len(partIdentity) = 0 Then Exit Function
    Set definitions = SetupPartDefinitionCache()
    For Each partItem In definitions
        If StrComp(CStr(partItem), partIdentity, vbBinaryCompare) = 0 Then
            ImplementedSetupPartIdentity = CStr(partItem)
            Exit Function
        End If
    Next partItem
End Function

' Purpose: Resolves implemented setup part identities from the supplied/current ADC state, using `partIdentities` and `SetupPartDefinitionCache` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
' Returns: Variant: Returns the implemented setup part identities value in the scalar, array, object, Empty, or Null form produced by the routine's existing contract.
Public Function ImplementedSetupPartIdentities() As Variant
    Dim definitions As Collection
    Dim partIdentities() As String
    Dim partIndex As Long
    Set definitions = SetupPartDefinitionCache()
    ReDim partIdentities(0 To definitions.count - 1)
    For partIndex = 1 To definitions.count
        partIdentities(partIndex - 1) = CStr(definitions(partIndex))
    Next partIndex
    ImplementedSetupPartIdentities = partIdentities
End Function

' Purpose: Resolves implemented setup part count from the supplied/current ADC state, using `SetupPartDefinitionCache` and `End` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
' Returns: Long: Returns the count calculated by the routine; zero and other sentinel values retain the meanings established by the routine's existing implementation.
Public Function ImplementedSetupPartCount() As Long
    ImplementedSetupPartCount = SetupPartDefinitionCache().count
End Function

' Purpose: Resolves implemented setup part rank from the supplied/current ADC state, using `ImplementedSetupPartIdentity` and `SetupPartDefinitionCache` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   partIdentity (Input; String): Stable identity/key used to select the part identity definition, row, workflow part, or managed object without relying on display text.
' Returns: Long: Returns the numeric implemented setup part rank result; zero and other sentinel values retain the meanings established by the routine's existing implementation.
Public Function ImplementedSetupPartRank(ByVal partIdentity As String) As Long
    Dim definitions As Collection
    Dim partIndex As Long
    partIdentity = ImplementedSetupPartIdentity(partIdentity)
    If Len(partIdentity) = 0 Then Err.Raise vbObjectError + 9586, "ImplementedSetupPartRank", "Canonical Setup Part rank could not be resolved."
    Set definitions = SetupPartDefinitionCache()
    For partIndex = 1 To definitions.count
        If StrComp(CStr(definitions(partIndex)), partIdentity, vbBinaryCompare) = 0 Then
            ImplementedSetupPartRank = partIndex
            Exit Function
        End If
    Next partIndex
    Err.Raise vbObjectError + 9586, "ImplementedSetupPartRank", "Canonical Setup Part rank could not be resolved: " & partIdentity
End Function

