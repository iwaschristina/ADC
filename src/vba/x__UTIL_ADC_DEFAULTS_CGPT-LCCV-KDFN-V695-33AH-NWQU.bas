Public Sub SystemRibbonPlacementForKey(ByVal systemMacroKey As String, ByRef ribbonTabKey As String, ByRef ribbonTabLabel As String, ByRef ribbonGroupLabel As String, ByRef ribbonGroupSortOrder As Long, Optional ByVal groupDefinitionIndex As Variant, Optional ByVal suppliedSystemMacroDefinition As Variant)
    Dim groupIdentity As String
    Dim groupDefinition As Variant
    If isMissing(suppliedSystemMacroDefinition) Then
        groupIdentity = SystemMacroRibbonGroupIdentity(systemMacroKey)
