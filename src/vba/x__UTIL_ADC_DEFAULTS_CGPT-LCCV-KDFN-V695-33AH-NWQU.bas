'   resolved.
Public Function RibbonVisibleSeparatorDefault(ByVal valueText As String) As String
    'Owns the visible Ribbon ampersand-separator substitution; callers retain their context-specific spacing policy.
    RibbonVisibleSeparatorDefault = Replace(valueText, " & ", "/", 1, -1, vbBinaryCompare)
