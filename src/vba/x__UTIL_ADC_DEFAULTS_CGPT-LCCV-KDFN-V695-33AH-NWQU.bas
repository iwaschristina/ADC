' Purpose: Resolves form design action payload definitions from the supplied/current ADC state, using `isMissing` and `IsObject` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   suppliedDefinitions (Input Optional; Variant): Variant input representing supplied definitions; the routine accepts the caller-provided value in the form required by its existing validation and
'   conversion logic.
' Returns: Collection: Returns the ordered Collection assembled by the routine; callers receive the object reference and should treat its membership/order according to the routine contract.
Public Function FormDesignActionPayloadDefinitions(Optional ByVal suppliedDefinitions As Variant) As Collection
    ' Wrapper purpose: Form-design action-payload facade that supplies canonical form-design definitions when omitted and binds the generic payload builder to form-design repair metadata.
    ' Why retained: Retained so callers cannot drift the repair procedure, description, payload version, or domain defaults for form-design support queries.
    Dim definitions As Collection
    If isMissing(suppliedDefinitions) = False Then
        If IsObject(suppliedDefinitions) Then Set definitions = suppliedDefinitions
    End If
    If definitions Is Nothing Then Set definitions = FormDesignManagedObjectDefinitions()
    Set FormDesignActionPayloadDefinitions = CanonicalQueryActionPayloadDefinitions(definitions, "RepairNonFormQueryFoundationForSetup", "Managed form-design support/source query.", DEFAULT_ACTION_PAYLOAD_VERSION)
