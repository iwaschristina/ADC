' Purpose: Resolves managed object review action payload definitions from the supplied/current ADC state, using `isMissing` and `IsObject` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   suppliedDefinitions (Input Optional; Variant): Variant input representing supplied definitions; the routine accepts the caller-provided value in the form required by its existing validation and
'   conversion logic.
' Returns: Collection: Returns the ordered Collection assembled by the routine; callers receive the object reference and should treat its membership/order according to the routine contract.
Public Function ManagedObjectReviewActionPayloadDefinitions(Optional ByVal suppliedDefinitions As Variant) As Collection
    ' Wrapper purpose: Review-query action-payload facade that supplies canonical review definitions when omitted and binds the generic payload builder to review repair metadata.
    ' Why retained: Retained so callers cannot drift the repair procedure, description, payload version, or domain defaults when constructing review-query actions.
    Dim definitions As Collection
    If isMissing(suppliedDefinitions) = False Then
        If IsObject(suppliedDefinitions) Then Set definitions = suppliedDefinitions
    End If
    If definitions Is Nothing Then Set definitions = ManagedObjectReviewQueryDefinitions()
    Set ManagedObjectReviewActionPayloadDefinitions = CanonicalQueryActionPayloadDefinitions(definitions, "RepairNonFormQueryFoundationForSetup", "Generated or repaired review query.", DEFAULT_ACTION_PAYLOAD_VERSION)
End Function

' Purpose: Resolves managed object ribbon title object type label from the supplied/current ADC state, using `End` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   objectTypeCode (Input; String): Canonical code used to classify or select the object type code behavior.
' Returns: String: Returns the formatted text produced by this routine. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not
'   resolved.
Public Function ManagedObjectRibbonTitleObjectTypeLabel(ByVal objectTypeCode As String) As String
    'Intended use: Returns the human-readable object-type label used by Ribbon tooltip fallback text; it does not generate Ribbon button titles.
    Select Case UCase$(Trim$(objectTypeCode))
        Case UCase$(ADCAT_OBJECT_TYPE_MACRO)
            ManagedObjectRibbonTitleObjectTypeLabel = "Macro"
        Case UCase$(ADCAT_OBJECT_TYPE_TABLE)
            ManagedObjectRibbonTitleObjectTypeLabel = "Table"
        Case UCase$(ADCAT_OBJECT_TYPE_QUERY)
            ManagedObjectRibbonTitleObjectTypeLabel = "Query"
        Case UCase$(ADCAT_OBJECT_TYPE_FORM)
            ManagedObjectRibbonTitleObjectTypeLabel = "Form"
        Case UCase$(ADCAT_OBJECT_TYPE_REPORT)
            ManagedObjectRibbonTitleObjectTypeLabel = "Report"
        Case Else
            ManagedObjectRibbonTitleObjectTypeLabel = "Object"
    End Select
End Function

' Purpose: Resolves managed object authoritative ribbon title from the supplied/current ADC state, using `ManagedObjectDefinitionRowsForRead` and `StrComp` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   objectName (Input; String): Canonical or physical name identifying the object targeted by this operation.
' Returns: String: Returns the managed object authoritative ribbon title text value. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or
'   not resolved.
Public Function ManagedObjectAuthoritativeRibbonTitle(ByVal objectName As String) As String
    Dim rowData As Variant
    If Len(objectName) = 0 Then Exit Function
    For Each rowData In ManagedObjectDefinitionRowsForRead()
        If StrComp(CStr(rowData(MANAGED_DEF_OBJECT_NAME)), objectName, vbTextCompare) = 0 Then
            ManagedObjectAuthoritativeRibbonTitle = CStr(rowData(MANAGED_DEF_RIBBON_TITLE_OVERRIDE))
            Exit Function
        End If
    Next rowData
End Function

' Purpose: Performs managed object is ribbon excluded by policy by coordinating `TryGetManagedObjectDefinition` and `End` while preserving this module's existing validation and error semantics.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   objectName (Input; String): Physical Access object name identifying the database object targeted by the operation.
'   objectTypeCode (Input; String): Access object-type code identifying the class of database object targeted by the operation.
' Returns: Boolean: True when the condition represented by ManagedObjectNavigationPaneSettingKey is present under the routine's documented inputs/current state; False when that condition is absent.
Public Function ManagedObjectIsRibbonExcludedByPolicy(ByVal objectName As String, ByVal objectTypeCode As String) As Boolean
    'Direct Ribbon exposure is an explicit property of the canonical managed-object definition; blank placement values never imply exclusion.
    Dim definitionData As Variant
    If TryGetManagedObjectDefinition(objectName, objectTypeCode, definitionData) = False Then Exit Function
    ManagedObjectIsRibbonExcludedByPolicy = Not CBool(definitionData(MANAGED_DEF_DIRECT_RIBBON_EXPOSURE))
End Function

