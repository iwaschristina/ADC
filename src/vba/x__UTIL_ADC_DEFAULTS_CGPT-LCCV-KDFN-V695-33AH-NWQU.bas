            rows.Add Array("Current Manifest", "=ChatGPT_OpenFormByName(""" & ManagedObjectPhysicalName(NAMING_CATEGORY_GENERATED_FORM, CANON_GENERATED_FORM_LOGICAL_ID_MODULE_UPDATES_CURRENT) & """)", "Open the expected-current manifest.")
