' Returns: String: Returns the canonical description text for editable lookup table field description, suitable for the managed catalog/field/object metadata destination; vbNullString indicates that no
'   description applies where allowed.
Public Function EditableLookupTableFieldDescription(ByVal fieldName As String) As String
    Select Case LCase$(Trim$(fieldName))
        Case LCase$(FIELD_VALUE_TEXT): EditableLookupTableFieldDescription = FIELD_DESC_LONG_EDITABLE_LOOKUP_TABLE_VALUETEXT
        Case LCase$(FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER): EditableLookupTableFieldDescription = FIELD_DESC_LONG_EDITABLE_LOOKUP_TABLE_SORTORDER
        Case LCase$(FIELD_DESCRIPTION): EditableLookupTableFieldDescription = FIELD_DESC_LONG_EDITABLE_LOOKUP_TABLE_DESCRIPTION
    End Select
End Function

Private Function EditableLookupTableFieldDescriptionShort(ByVal fieldName As String) As String
    Select Case LCase$(Trim$(fieldName))
