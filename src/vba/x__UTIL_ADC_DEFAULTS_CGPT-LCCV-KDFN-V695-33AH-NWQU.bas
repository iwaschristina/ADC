' Purpose: Resolves and returns managed placement navigation pane setting key from index from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   scopeCode (Input; String): Scope value limiting which scope code items or operations are included in this call.
'   definitionIndex (Input; Object): Caller-supplied definition index data used as the authoritative definition input for this call, avoiding an unnecessary reload when already available.
' Returns: String: Returns the canonical key resolved for managed placement navigation pane setting key from index; vbNullString indicates that the supplied definition/index has no applicable managed key.
Public Function ManagedPlacementNavigationPaneSettingKeyFromIndex(ByVal scopeCode As String, ByVal definitionIndex As Object) As String
    'Consumes the operation-scoped managed-placement applicability index; it does not reconstruct canonical Navigation Pane definitions.
    Dim rowData As Variant
    scopeCode = Trim$(scopeCode)
    If Len(scopeCode) = 0 Then Exit Function
    If definitionIndex Is Nothing Then Err.Raise vbObjectError + 7800, "ManagedPlacementNavigationPaneSettingKeyFromIndex", "The managed-placement Navigation Pane definition index is unavailable."
    If definitionIndex.Exists(scopeCode) = False Then Exit Function
    rowData = definitionIndex(scopeCode)
    ManagedPlacementNavigationPaneSettingKeyFromIndex = CStr(rowData(3))
End Function

