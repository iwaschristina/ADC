    If IsEmpty(Definition) Then Exit Function
    If UBound(Definition) < SYSTEM_MACRO_DEF_RIBBON_TITLE Then Err.Raise vbObjectError + 6870, "SystemRibbonTitleForKey", "The canonical System Macro definition is missing its Ribbon title." & vbCrLf & "SystemMacroKey: " & normalizedKey
