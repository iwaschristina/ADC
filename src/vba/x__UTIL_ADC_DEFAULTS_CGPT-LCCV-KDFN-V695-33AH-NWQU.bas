' Purpose: Performs navigation pane group show on ribbon by coordinating `StrComp` and `End` while preserving this module's existing validation and error semantics.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   navPaneGroupName (Input; String): Exact Navigation Pane group name identifying the group whose placement, shortcut, rollback, or display state is being processed.
'   groupPurpose (Input; String): Canonical group-purpose text used to choose the Ribbon/Navigation grouping policy associated with the definition.
' Returns: Boolean: True when the condition represented by NavigationPaneGroupRibbonGroupLabel is present under the routine's documented inputs/current state; False when that condition is absent.
Public Function NavigationPaneGroupShowOnRibbon(ByVal navPaneGroupName As String, ByVal groupPurpose As String) As Boolean
    Select Case UCase$(Trim$(groupPurpose))
        Case UCase$(NAVIGATION_PANE_GROUP_PURPOSE_BACKUP)
            NavigationPaneGroupShowOnRibbon = False
        Case UCase$(NAVIGATION_PANE_GROUP_PURPOSE_SYSTEM_MACROS)
            NavigationPaneGroupShowOnRibbon = True
        Case Else
            NavigationPaneGroupShowOnRibbon = (StrComp(Trim$(navPaneGroupName), BuildNavigationPaneGroupName(DEFAULT_BACKUP_NAVIGATION_PANE_GROUP_LOGICAL_NAME, False), vbTextCompare) <> 0)
    End Select
End Function

' Purpose: Resolves and returns navigation pane group ribbon tab key from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   navPaneGroupName (Input; String): Exact Navigation Pane group name identifying the group whose placement, shortcut, rollback, or display state is being processed.
'   groupPurpose (Input; String): Canonical group-purpose text used to choose the Ribbon/Navigation grouping policy associated with the definition.
' Returns: String: Returns the canonical key resolved for navigation pane group ribbon tab key; vbNullString indicates that the supplied definition/index has no applicable managed key.
Public Function NavigationPaneGroupRibbonTabKey(ByVal navPaneGroupName As String, ByVal groupPurpose As String) As String
    If StrComp(Trim$(groupPurpose), NAVIGATION_PANE_GROUP_PURPOSE_SYSTEM_MACROS, vbTextCompare) = 0 Then
