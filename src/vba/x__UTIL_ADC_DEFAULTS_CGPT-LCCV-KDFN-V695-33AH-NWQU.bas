' Purpose: Resolves readable display name from the supplied/current ADC state, using `DisplayNameApplyTitleCase` and `End` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   valueText (Input; String): Input value text for readable display name; is passed to `DisplayNameApplyTitleCase`.
' Returns: String: Returns the resolved name produced by this routine. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not resolved.
Public Function ReadableDisplayName(ByVal valueText As String) As String
    'Returns a readable display name by splitting identifier capitalization while preserving common database acronyms and system prefixes.
    'This helper is for display/caption/description text, not Ribbon button titles.
    ReadableDisplayName = DisplayNameApplyTitleCase(ReadableDisplayNameCore(valueText))
End Function

Private Function ReadableDisplayNameCore(ByVal valueText As String) As String
    Dim protectedText As String
    Dim resultText As String
    Dim index As Long
    Dim currentChar As String
    Dim previousChar As String
    Dim nextChar As String
    protectedText = valueText
    protectedText = Replace(protectedText, "ChatGPT", " [[01]] ", 1, -1, vbTextCompare)
    protectedText = Replace(protectedText, "MSys", " [[02]] ", 1, -1, vbBinaryCompare)
    protectedText = Replace(protectedText, "USys", " [[03]] ", 1, -1, vbBinaryCompare)
    protectedText = Replace(protectedText, "CodeDb", " [[12]] ", 1, -1, vbTextCompare)
    protectedText = Replace(protectedText, "HostDb", " [[13]] ", 1, -1, vbTextCompare)
    protectedText = Replace(protectedText, "RunCode", " [[14]] ", 1, -1, vbTextCompare)
    protectedText = Replace(protectedText, "AutoExec", " [[15]] ", 1, -1, vbTextCompare)
    protectedText = Replace(protectedText, "IDs", " [[04]] ", 1, -1, vbBinaryCompare)
    protectedText = Replace(protectedText, "ID", " [[05]] ", 1, -1, vbBinaryCompare)
    protectedText = Replace(protectedText, "SQL", " [[06]] ", 1, -1, vbBinaryCompare)
    protectedText = Replace(protectedText, "DAO", " [[07]] ", 1, -1, vbBinaryCompare)
    protectedText = Replace(protectedText, "VBA", " [[08]] ", 1, -1, vbBinaryCompare)
    protectedText = Replace(protectedText, "XML", " [[09]] ", 1, -1, vbBinaryCompare)
    protectedText = Replace(protectedText, "UI", " [[10]] ", 1, -1, vbBinaryCompare)
    protectedText = Replace(protectedText, "DB", " [[11]] ", 1, -1, vbBinaryCompare)
    protectedText = Replace(protectedText, "_", " ")
    protectedText = Replace(protectedText, "-", " ")
    For index = 1 To Len(protectedText)
        currentChar = Mid$(protectedText, index, 1)
        previousChar = vbNullString
        nextChar = vbNullString
        If index > 1 Then previousChar = Mid$(protectedText, index - 1, 1)
        If index < Len(protectedText) Then nextChar = Mid$(protectedText, index + 1, 1)
        If DisplayNameIsAsciiUpper(currentChar) Then
            If DisplayNameIsAsciiLower(previousChar) Or DisplayNameIsAsciiDigit(previousChar) Then
                If Len(resultText) > 0 And Right$(resultText, 1) <> " " Then resultText = resultText & " "
            ElseIf DisplayNameIsAsciiUpper(previousChar) And DisplayNameIsAsciiLower(nextChar) Then
                If Len(resultText) > 0 And Right$(resultText, 1) <> " " Then resultText = resultText & " "
            End If
        End If
        resultText = resultText & currentChar
    Next index
    resultText = Replace(resultText, "[[01]]", "ChatGPT")
    resultText = Replace(resultText, "[[02]]", "MSys")
    resultText = Replace(resultText, "[[03]]", "USys")
    resultText = Replace(resultText, "[[04]]", "IDs")
    resultText = Replace(resultText, "[[05]]", "ID")
    resultText = Replace(resultText, "[[06]]", "SQL")
    resultText = Replace(resultText, "[[07]]", "DAO")
    resultText = Replace(resultText, "[[08]]", "VBA")
    resultText = Replace(resultText, "[[09]]", "XML")
    resultText = Replace(resultText, "[[10]]", "UI")
    resultText = Replace(resultText, "[[11]]", "DB")
    resultText = Replace(resultText, "[[12]]", "CodeDb")
    resultText = Replace(resultText, "[[13]]", "HostDb")
    resultText = Replace(resultText, "[[14]]", "RunCode")
    resultText = Replace(resultText, "[[15]]", "AutoExec")
    ReadableDisplayNameCore = resultText
End Function

Private Function DisplayNameApplyTitleCase(ByVal valueText As String) As String
    Dim words As Variant
    Dim index As Long
    Dim wordText As String
    Dim resultText As String
    If Len(valueText) = 0 Then Exit Function
    words = Split(valueText, " ")
    For index = LBound(words) To UBound(words)
        wordText = CStr(words(index))
        Select Case UCase$(wordText)
            Case "CHATGPT": wordText = "ChatGPT"
            Case "MSYS": wordText = "MSys"
            Case "USYS": wordText = "USys"
            Case "CODEDB": wordText = "CodeDb"
            Case "HOSTDB": wordText = "HostDb"
            Case "RUNCODE": wordText = "RunCode"
            Case "AUTOEXEC": wordText = "AutoExec"
            Case "ID": wordText = "ID"
            Case "IDS": wordText = "IDs"
            Case "SQL": wordText = "SQL"
            Case "DAO": wordText = "DAO"
            Case "VBA": wordText = "VBA"
            Case "XML": wordText = "XML"
            Case "UI": wordText = "UI"
            Case "DB": wordText = "DB"
            Case Else
                If Len(wordText) <= 4 And StrComp(wordText, UCase$(wordText), vbBinaryCompare) = 0 Then
                Else
                    wordText = UCase$(Left$(wordText, 1)) & LCase$(Mid$(wordText, 2))
                End If
        End Select
        If Len(resultText) > 0 Then resultText = resultText & " "
        resultText = resultText & wordText
    Next index
    DisplayNameApplyTitleCase = resultText
End Function

Private Function DisplayNameIsAsciiUpper(ByVal valueText As String) As Boolean
    If Len(valueText) <> 1 Then Exit Function
    DisplayNameIsAsciiUpper = (AscW(valueText) >= AscW("A") And AscW(valueText) <= AscW("Z"))
End Function

Private Function DisplayNameIsAsciiLower(ByVal valueText As String) As Boolean
    If Len(valueText) <> 1 Then Exit Function
    DisplayNameIsAsciiLower = (AscW(valueText) >= AscW("a") And AscW(valueText) <= AscW("z"))
End Function

Private Function DisplayNameIsAsciiDigit(ByVal valueText As String) As Boolean
    If Len(valueText) <> 1 Then Exit Function
    DisplayNameIsAsciiDigit = (AscW(valueText) >= AscW("0") And AscW(valueText) <= AscW("9"))
End Function


