' Purpose: Resolves system macro definitions from the supplied/current ADC state, using `BuildSystemMacroDefinitions` and `End` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
' Returns: Collection: Returns the ordered Collection assembled by the routine; callers receive the object reference and should treat its membership/order according to the routine contract.
Public Function GetSystemMacroDefinitions() As Collection
    ' INTENTIONAL DEFENSIVE COPY: rows is created only when the module-owned System Macro operation snapshot is active so callers cannot mutate shared snapshot membership; a fresh unsnapshotted build is
    ' caller-owned.
    Dim rows As New Collection
    Dim definitionData As Variant
    EnsureSystemMacroDefinitionSnapshotBuilt
    If mSystemMacroDefinitionSnapshotRows Is Nothing Then
        Set GetSystemMacroDefinitions = BuildSystemMacroDefinitions()
        Exit Function
    End If
    ' INTENTIONAL DEFENSIVE COPY: Do not return the mutable module-owned snapshot directly; callers could alter cached snapshot membership. Fresh builds are caller-owned and may be returned directly.
    For Each definitionData In mSystemMacroDefinitionSnapshotRows
        rows.Add definitionData
    Next definitionData
    Set GetSystemMacroDefinitions = rows
End Function

' Intended use: Returns the one authoritative built-in SystemMacro definition row from GetSystemMacroDefinitions; unknown keys return Empty.
' Purpose: Resolves system macro definition by key from the supplied/current ADC state, using `End` and `BuildSystemMacroDefinitions` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   systemMacroKey (Input; String): Stable identity/key used to select the system macro key definition, row, workflow part, or managed object without relying on display text.
' Returns: Variant: Returns the system macro definition by key value in the scalar, array, object, Empty, or Null form produced by the routine's existing contract.
Public Function SystemMacroDefinitionByKey(ByVal systemMacroKey As String) As Variant
    Dim Definition As Variant
    systemMacroKey = Trim$(systemMacroKey)
    If Len(systemMacroKey) = 0 Then Exit Function
    EnsureSystemMacroDefinitionSnapshotBuilt
    If Not mSystemMacroDefinitionSnapshotIndex Is Nothing Then
        If mSystemMacroDefinitionSnapshotIndex.Exists(systemMacroKey) Then SystemMacroDefinitionByKey = mSystemMacroDefinitionSnapshotIndex.item(systemMacroKey)
        Exit Function
    End If
    For Each Definition In BuildSystemMacroDefinitions()
        If StrComp(Trim$(CStr(Definition(0))), systemMacroKey, vbTextCompare) = 0 Then
            SystemMacroDefinitionByKey = Definition
            Exit Function
        End If
    Next Definition
End Function

' Intended use: Returns the authored permanent Ribbon tag for a built-in System Macro by stable SystemMacroKey; unknown keys return blank.
' Purpose: Resolves system macro ribbon static tag from the supplied/current ADC state, using `isMissing` and `SystemMacroDefinitionByKey` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   systemMacroKey (Input; String): Stable identity/key used to select the system macro key definition, row, workflow part, or managed object without relying on display text.
'   suppliedSystemMacroDefinition (Input Optional; Variant): Variant input representing supplied system macro definition; the routine accepts the caller-provided value in the form required by its existing
'   validation and conversion logic.
' Returns: String: Returns the system macro ribbon static tag text value. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not
'   resolved.
Public Function SystemMacroRibbonStaticTag(ByVal systemMacroKey As String, Optional ByVal suppliedSystemMacroDefinition As Variant) As String
    'Returns the explicitly authored permanent Ribbon tag by stable SystemMacroKey; visible/editable designator text is never used for identity.
    Dim Definition As Variant
    If isMissing(suppliedSystemMacroDefinition) Then
        Definition = SystemMacroDefinitionByKey(systemMacroKey)
    Else
        Definition = suppliedSystemMacroDefinition
    End If
    If IsEmpty(Definition) Then Exit Function
    If UBound(Definition) < SYSTEM_MACRO_DEF_RIBBON_STATIC_TAG Then Err.Raise vbObjectError + 6888, "SystemMacroRibbonStaticTag", "The System Macro definition has no permanent Ribbon tag field." & vbCrLf & "SystemMacroKey: " & systemMacroKey
    SystemMacroRibbonStaticTag = Trim$(CStr(Definition(SYSTEM_MACRO_DEF_RIBBON_STATIC_TAG)))
    If Len(SystemMacroRibbonStaticTag) = 0 Then Err.Raise vbObjectError + 6890, "SystemMacroRibbonStaticTag", "The System Macro definition has a blank permanent Ribbon tag." & vbCrLf & "SystemMacroKey: " & systemMacroKey
End Function

