' Purpose: Initializes managed object definition snapshot, coordinating `End` as the implementation requires.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
' Returns: None (Sub). The procedure communicates its result through its database, UI, trace, or module-state side effects and raises errors where its implementation requires it.
Public Sub BeginManagedObjectDefinitionSnapshot()
    'Acquires one nested operation-scoped claim; construction remains lazy until the first canonical definition read.
    mManagedObjectDefinitionSnapshotDepth = mManagedObjectDefinitionSnapshotDepth + 1
End Sub

Private Sub EnsureManagedObjectDefinitionSnapshot()
    'Builds the one operation-scoped index from the sole canonical code authority at first use.
    ' INTENTIONAL ROW + INDEX PAIR: Rows preserve canonical enumeration; the identity index provides keyed lookup over the same operation snapshot, not a second authority.
    If Not mManagedObjectDefinitionSnapshotRows Is Nothing Then Exit Sub
    If mManagedObjectDefinitionSnapshotDepth <= 0 Then Exit Sub
    On Error GoTo ErrHandler
    Dim rows As Collection
    Dim indexByIdentity As Object
    Dim rowData As Variant
    Dim identityKey As String
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "EnsureManagedObjectDefinitionSnapshot", "Canonical managed-object definition snapshot build starting.", "Acquisition depth=" & CStr(mManagedObjectDefinitionSnapshotDepth), "Managed-object definition snapshot", 0, vbNullString, vbNullString, vbNullString, "ManagedObjectDefinitions", "CodeDb", "Performance"
    Dim buildTimer As Single
    buildTimer = Timer
    Set rows = BuildManagedObjectDefinitions()
    ' INTENTIONAL KEYED LOOKUP: indexByIdentity provides keyed membership/lookup over source rows or state already read by EnsureManagedObjectDefinitionSnapshot; it is a derived access path, not a second authority.
    Set indexByIdentity = CreateObject("Scripting.Dictionary")
    indexByIdentity.CompareMode = vbBinaryCompare
    For Each rowData In rows
        identityKey = ManagedObjectDefinitionIdentityKey(CStr(rowData(MANAGED_DEF_OBJECT_NAME)), CStr(rowData(MANAGED_DEF_OBJECT_TYPE)))
        If indexByIdentity.Exists(identityKey) Then Err.Raise vbObjectError + 7807, "EnsureManagedObjectDefinitionSnapshot", "The canonical managed-object snapshot contains a duplicate identity." & vbCrLf & "Identity: " & identityKey
        indexByIdentity.Add identityKey, rowData
    Next rowData
    Set mManagedObjectDefinitionSnapshotRows = rows
    Set mManagedObjectDefinitionSnapshotIndex = indexByIdentity
    LogTraceMessage TRACE_LEVEL_INFO, "SetupTiming", "EnsureManagedObjectDefinitionSnapshot", "Canonical managed-object definition snapshot build completed.", "Definitions=" & CStr(rows.count) & vbCrLf & "Elapsed=" & FormattedElapsedSeconds(ElapsedSecondsFromTimer(buildTimer)) & vbCrLf & "Acquisition depth=" & CStr(mManagedObjectDefinitionSnapshotDepth), "Managed-object definition snapshot", 0, vbNullString, vbNullString, vbNullString, "ManagedObjectDefinitions", "CodeDb", "Performance"
    Exit Sub
ErrHandler:
    Dim savedErrNumber As Long
    Dim savedErrSource As String
    Dim savedErrDescription As String
    savedErrNumber = Err.Number
    savedErrSource = Err.Source
    savedErrDescription = Err.Description
    Set mManagedObjectDefinitionSnapshotIndex = Nothing
    Set mManagedObjectDefinitionSnapshotRows = Nothing
    Set mReferenceInventorySnapshotNames = Nothing
    Set mReferenceLoadedVBAAnalysisSnapshotNames = Nothing
    Set mReferenceCrosswalkSnapshotNames = Nothing
    Set mReferenceQuerySnapshotNames = Nothing
    Err.Raise savedErrNumber, "EnsureManagedObjectDefinitionSnapshot", "Could not build the operation-scoped canonical managed-object definition index." & vbCrLf & "Err.Source: " & savedErrSource & vbCrLf & "Err.Description: " & savedErrDescription
End Sub

' Purpose: Closes managed object definition snapshot, coordinating `End` as the implementation requires.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters: None.
' Returns: None (Sub). The procedure communicates its result through its database, UI, trace, or module-state side effects and raises errors where its implementation requires it.
Public Sub EndManagedObjectDefinitionSnapshot()
    If mManagedObjectDefinitionSnapshotDepth <= 0 Then Exit Sub
    mManagedObjectDefinitionSnapshotDepth = mManagedObjectDefinitionSnapshotDepth - 1
    If mManagedObjectDefinitionSnapshotDepth > 0 Then Exit Sub
    Set mManagedObjectDefinitionSnapshotIndex = Nothing
    Set mManagedObjectDefinitionSnapshotRows = Nothing
    Set mReferenceInventorySnapshotNames = Nothing
    Set mReferenceLoadedVBAAnalysisSnapshotNames = Nothing
    Set mReferenceCrosswalkSnapshotNames = Nothing
    Set mReferenceQuerySnapshotNames = Nothing
End Sub

' Purpose: Resolves managed object definition identity key from the supplied/current ADC state, using `End` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   objectName (Input; String): Canonical or physical name identifying the object targeted by this operation.
'   objectTypeCode (Input; String): Canonical code used to classify or select the object type code behavior.
' Returns: String: Returns the managed object definition identity key text value. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or
'   not resolved.
Public Function ManagedObjectDefinitionIdentityKey(ByVal objectName As String, ByVal objectTypeCode As String) As String
    ManagedObjectDefinitionIdentityKey = UCase$(Trim$(objectTypeCode)) & "|" & UCase$(objectName)
End Function

Private Function ManagedObjectDefinitionRowsForRead() As Collection
    If mManagedObjectDefinitionSnapshotDepth > 0 Then EnsureManagedObjectDefinitionSnapshot
    If Not mManagedObjectDefinitionSnapshotRows Is Nothing Then
        Set ManagedObjectDefinitionRowsForRead = mManagedObjectDefinitionSnapshotRows
    Else
        Set ManagedObjectDefinitionRowsForRead = BuildManagedObjectDefinitions()
    End If
End Function

