    If IsEmpty(groupDefinition) Then Err.Raise vbObjectError + 6864, "SystemRibbonPlacementForKey", "The canonical System Macro references an unknown Ribbon group identity." & vbCrLf & "SystemMacroKey: " & systemMacroKey & vbCrLf & "RibbonGroupIdentity: " & groupIdentity
