            rows.Add Array("lstHelpFields", False, True, False)
            rows.Add Array("txtHelpTitle", False, False, True)
            rows.Add Array("txtHelpBreadcrumb", False, False, True)
            rows.Add Array("txtHelpContent", False, False, True)
            rows.Add Array("txtHelpCurrentKey", False, False, False)
            rows.Add Array("txtHelpRelatedTarget", False, False, False)
            rows.Add Array("txtHelpHistoryState", False, False, False)
            rows.Add Array("txtHelpHistoryIndex", False, False, False)
            rows.Add Array("txtHelpNavigatingHistory", False, False, False)
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_GENERATED_FORM, CANON_GENERATED_FORM_LOGICAL_ID_REPORT_ERROR_DIALOG))
            rows.Add Array("txtErrorDescription", True, False, False)
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_GENERATED_FORM, CANON_GENERATED_FORM_LOGICAL_ID_ADD_IN_REVIEW))
            rows.Add Array("txtSelectedProjectIdentity", True, False, False)
            rows.Add Array("txtSelectedProjectName", True, False, False)
            rows.Add Array("txtSelectionStatus", True, False, False)
            rows.Add Array("tabAddInReview", False, False, False)
    End Select
    Set GeneratedFormContractControlDefinitions = rows
End Function

' Purpose: Resolves and returns generated form contract control name from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   formName (Input; String): Physical Access form name identifying the form to create, open, configure, validate, or inspect.
'   oneBasedIndex (Input; Long): Index selecting the one based index item or position within the caller-supplied definition/source sequence.
'   suppliedDefinitions (Input Optional; Variant): Caller-supplied supplied definitions data used as the authoritative definition input for this call, avoiding an unnecessary reload when already available.
' Returns: String: Returns the physical/logical name resolved for generated form contract control name under the module's naming/definition rules; vbNullString indicates that no applicable name can be resolved
'   where supported.
Public Function GeneratedFormContractControlName(ByVal formName As String, ByVal oneBasedIndex As Long, Optional ByVal suppliedDefinitions As Variant) As String
    Dim definitions As Collection
    Dim definitionData As Variant
    If isMissing(suppliedDefinitions) = False Then
        If IsObject(suppliedDefinitions) Then Set definitions = suppliedDefinitions
    End If
    If definitions Is Nothing Then Set definitions = GeneratedFormContractControlDefinitions(formName)
    If oneBasedIndex < 1 Or oneBasedIndex > definitions.count Then Err.Raise vbObjectError + 7393, "GeneratedFormContractControlName", "The generated-form control-contract index is outside the authoritative contract." & vbCrLf & "Form: " & formName & vbCrLf & "Index: " & CStr(oneBasedIndex) & vbCrLf & "Count: " & CStr(definitions.count)
    definitionData = definitions(oneBasedIndex)
    GeneratedFormContractControlName = CStr(definitionData(0))
End Function

' Purpose: Resolves and returns generated form contract callback expressions from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   formName (Input; String): Physical Access form name identifying the form to create, open, configure, validate, or inspect.
' Returns: Collection: Returns the generated form contract callback expressions object/collection resolved by this routine for direct use by the caller; the routine's documented absence/error path applies when
'   no such object can be resolved.
Public Function GeneratedFormContractCallbackExpressions(ByVal formName As String) As Collection
    ' INTENTIONAL FILTERED PARTITION: rows is a consumer-required subset/projection derived from the source enumerated by GeneratedFormContractCallbackExpressions; its membership is not independently authoritative.
    Dim rows As New Collection
    Dim definitionData As Variant
    If StrComp(formName, ManagedObjectPhysicalName(NAMING_CATEGORY_GENERATED_FORM, CANON_GENERATED_FORM_LOGICAL_ID_DELETE_OBJECTS), vbTextCompare) = 0 Then
        rows.Add "=SelectDeleteObjectScope(" & CStr(CLng(DELETE_SCOPE_TABLES)) & ")"
        rows.Add "=SelectDeleteObjectScope(" & CStr(CLng(DELETE_SCOPE_QUERIES)) & ")"
        rows.Add "=SelectDeleteObjectScope(" & CStr(CLng(DELETE_SCOPE_GENERATED_FORMS)) & ")"
        rows.Add "=SelectDeleteObjectScope(" & CStr(CLng(DELETE_SCOPE_MACROS)) & ")"
        rows.Add "=SelectDeleteObjectScope(" & CStr(CLng(DELETE_SCOPE_REPORTS)) & ")"
        rows.Add "=SelectDeleteObjectScope(" & CStr(CLng(DELETE_SCOPE_ALL)) & ")"
        rows.Add "=SelectDeleteObjectScope(" & CStr(CLng(DELETE_SCOPE_CANCEL)) & ")"
        Set GeneratedFormContractCallbackExpressions = rows
        Exit Function
    End If
    definitionData = GetGeneratedFormDefinition(formName)
    If IsArray(definitionData) = False Then Err.Raise vbObjectError + 7394, "GeneratedFormContractCallbackExpressions", "No canonical generated-form definition exists." & vbCrLf & "Form: " & formName
    Select Case UCase$(formName)
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_GENERATED_FORM, CANON_GENERATED_FORM_LOGICAL_ID_HELP))
            rows.Add "=ChatGPT_HelpSearch()"
            rows.Add "=ChatGPT_HelpClearSearch()"
