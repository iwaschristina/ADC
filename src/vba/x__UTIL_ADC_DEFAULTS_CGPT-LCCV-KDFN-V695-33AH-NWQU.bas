Private Function RibbonTabDefaultDefinitions() As Collection
    'Derived registry for current Ribbon-tab keys, labels, sort ranks, and placement eligibility. Individual default values remain owned by the public DEFAULTS constants declared above.
    ' INTENTIONAL STATIC CANONICAL PROJECTION: rows materializes the reusable Ribbon-tab registry from Defaults-owned tab values. It is valid for the loaded-code lifetime, has no invalidation path because those
    ' defaults are code-defined, and private callers treat the shared Collection as read-only.
    Static rows As Collection
    If rows Is Nothing Then
        Set rows = New Collection
        rows.Add Array(DEFAULT_RIBBON_TAB_KEY_SYSTEM_LOGICAL, DEFAULT_RIBBON_TAB_LABEL_SYSTEM_LOGICAL, DEFAULT_RIBBON_TAB_SORT_OTHER, True, "T001")
    rows.Add Array(DEFAULT_RIBBON_TAB_KEY_SYSTEM_1, DEFAULT_RIBBON_TAB_LABEL_SYSTEM_1, DEFAULT_RIBBON_TAB_SORT_SYSTEM_1, False, "T002")
    rows.Add Array(DEFAULT_RIBBON_TAB_KEY_SYSTEM_2, DEFAULT_RIBBON_TAB_LABEL_SYSTEM_2, DEFAULT_RIBBON_TAB_SORT_SYSTEM_2, False, "T003")
    rows.Add Array(DEFAULT_RIBBON_TAB_KEY_OBJECTS, DEFAULT_RIBBON_TAB_LABEL_OBJECTS, DEFAULT_RIBBON_TAB_SORT_OBJECTS, True, "T004")
    rows.Add Array(DEFAULT_RIBBON_TAB_KEY_DATA, DEFAULT_RIBBON_TAB_LABEL_DATA, DEFAULT_RIBBON_TAB_SORT_DATA, True, "T005")
    rows.Add Array(DEFAULT_RIBBON_TAB_KEY_ADMINISTRATION, DEFAULT_RIBBON_TAB_LABEL_ADMINISTRATION, DEFAULT_RIBBON_TAB_SORT_ADMINISTRATION, True, "T006")
    rows.Add Array(DEFAULT_RIBBON_TAB_KEY_UI, DEFAULT_RIBBON_TAB_LABEL_UI, DEFAULT_RIBBON_TAB_SORT_UI, True, "T007")
    rows.Add Array(DEFAULT_RIBBON_TAB_KEY_FORMS, DEFAULT_RIBBON_TAB_LABEL_FORMS, DEFAULT_RIBBON_TAB_SORT_FORMS, True, "T008")
        rows.Add Array(DEFAULT_RIBBON_TAB_KEY_DESIGN, DEFAULT_RIBBON_TAB_LABEL_DESIGN, DEFAULT_RIBBON_TAB_SORT_DESIGN, True, "T009")
    End If
    Set RibbonTabDefaultDefinitions = rows
End Function

Private Function RibbonTabSortRank(ByVal tabKey As String) As Long
    Dim rowData As Variant
    tabKey = UCase$(Trim$(tabKey))
    For Each rowData In RibbonTabDefaultDefinitions()
        If StrComp(UCase$(CStr(rowData(0))), tabKey, vbBinaryCompare) = 0 Then
            RibbonTabSortRank = CLng(rowData(2))
            Exit Function
        End If
    Next rowData
    RibbonTabSortRank = DEFAULT_RIBBON_TAB_SORT_OTHER
End Function

' Purpose: Performs ribbon configured group sort bucket expression by coordinating `End` while preserving this module's existing validation and error semantics.
