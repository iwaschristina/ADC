        AddLookupEditorPolicyDefinition rows, CStr(d(0)), LOOKUP_EDITOR_POLICY_GENERATED, CStr(d(1)) & " Lookup List", FIELD_VALUE_TEXT, FIELD_VALUE_TEXT & "|" & FIELD_DESCRIPTION & "|" & FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER, FIELD_MANAGED_OBJECT_DEPENDENCY_SORT_ORDER & "|" & FIELD_VALUE_TEXT, True, True, False, generatedPhysicalName:=CStr(d(6)), ribbonTitle:=CStr(d(CONVERTED_VALUE_LOOKUP_DEF_EDITOR_RIBBON_TITLE))
    Next d
End Sub

Private Function LookupEditorPolicyForSourceLogicalID(ByVal sourceLogicalID As String) As Variant
    Dim definitionData As Variant
    sourceLogicalID = Trim$(sourceLogicalID)
    For Each definitionData In LookupEditorPolicyDefinitions()
        If StrComp(CStr(definitionData(LOOKUP_EDITOR_DEF_SOURCE_LOGICAL_ID)), sourceLogicalID, vbTextCompare) = 0 Then
            LookupEditorPolicyForSourceLogicalID = definitionData
            Exit Function
        End If
    Next definitionData
    LookupEditorPolicyForSourceLogicalID = Array(sourceLogicalID, LOOKUP_EDITOR_POLICY_NONE, vbNullString, vbNullString, vbNullString, vbNullString, vbNullString, False, False, False, vbNullString, vbNullString)
End Function

' Purpose: Resolves lookup editor policy for physical source from the supplied/current ADC state, using `LookupEditorPolicyForSourceLogicalID` and `End` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   sourcePhysicalName (Input; String): Canonical or physical name identifying the source physical targeted by this operation.
' Returns: Variant: Returns the lookup editor policy for physical source value in the scalar, array, object, Empty, or Null form produced by the routine's existing contract.
Public Function LookupEditorPolicyForPhysicalSource(ByVal sourcePhysicalName As String) As Variant
    LookupEditorPolicyForPhysicalSource = LookupEditorPolicyForSourceLogicalID(LogicalObjectNameFromPhysicalName(NAMING_CATEGORY_TABLE, sourcePhysicalName))
End Function

' Purpose: Resolves lookup editor policy fingerprint for physical source from the supplied/current ADC state, using `LookupEditorPolicyForPhysicalSource` and `IsArray` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   sourcePhysicalName (Input; String): Canonical or physical name identifying the source physical targeted by this operation.
' Returns: String: Returns the lookup editor policy fingerprint for physical source text value. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not
'   applicable, or not resolved.
Public Function LookupEditorPolicyFingerprintForPhysicalSource(ByVal sourcePhysicalName As String) As String
    Dim definitionData As Variant
    Dim itemIndex As Long
    definitionData = LookupEditorPolicyForPhysicalSource(sourcePhysicalName)
    If IsArray(definitionData) = False Then Exit Function
    For itemIndex = LBound(definitionData) To UBound(definitionData)
        LookupEditorPolicyFingerprintForPhysicalSource = LookupEditorPolicyFingerprintForPhysicalSource & "|" & CStr(definitionData(itemIndex))
    Next itemIndex
End Function

' Purpose: Resolves lookup editor physical form name for source from the supplied/current ADC state, using `LookupEditorPolicyForPhysicalSource` and `StrComp` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   sourcePhysicalName (Input; String): Canonical or physical name identifying the source physical targeted by this operation.
'   policyCode (Output; String): Receives the canonical lookup-editor policy code resolved for sourcePhysicalName, including LOOKUP_EDITOR_POLICY_NONE when no editor form should be used.
' Returns: String: Returns the resolved name produced by this routine. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not applicable, or not resolved.
Public Function LookupEditorPhysicalFormNameForSource(ByVal sourcePhysicalName As String, ByRef policyCode As String) As String
    Dim definitionData As Variant
    definitionData = LookupEditorPolicyForPhysicalSource(sourcePhysicalName)
    policyCode = CStr(definitionData(LOOKUP_EDITOR_DEF_POLICY))
    If StrComp(policyCode, LOOKUP_EDITOR_POLICY_NONE, vbTextCompare) = 0 Then Exit Function
    If Len(CStr(definitionData(LOOKUP_EDITOR_DEF_EDITOR_LOGICAL_ID))) = 0 Then Exit Function
    LookupEditorPhysicalFormNameForSource = ManagedObjectPhysicalName(NAMING_CATEGORY_GENERATED_FORM, CStr(definitionData(LOOKUP_EDITOR_DEF_EDITOR_LOGICAL_ID)))
End Function

' Purpose: Resolves lookup editor generated form definition from the supplied/current ADC state, using `LookupEditorPolicyDefinitions` and `StrComp` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   formName (Input; String): Canonical or physical name identifying the form targeted by this operation.
' Returns: Variant: Returns the lookup editor generated form definition value in the scalar, array, object, Empty, or Null form produced by the routine's existing contract.
Public Function LookupEditorGeneratedFormDefinition(ByVal formName As String) As Variant
    Dim definitionData As Variant
    Dim editorPhysicalName As String
    For Each definitionData In LookupEditorPolicyDefinitions()
        If StrComp(CStr(definitionData(LOOKUP_EDITOR_DEF_POLICY)), LOOKUP_EDITOR_POLICY_GENERATED, vbTextCompare) = 0 Then
            editorPhysicalName = ManagedObjectPhysicalName(NAMING_CATEGORY_GENERATED_FORM, CStr(definitionData(LOOKUP_EDITOR_DEF_EDITOR_LOGICAL_ID)))
            If StrComp(editorPhysicalName, formName, vbTextCompare) = 0 Then
                LookupEditorGeneratedFormDefinition = definitionData
                Exit Function
            End If
        End If
    Next definitionData
End Function

' Purpose: Checks whether lookup editor generated form has a canonical managed definition in Defaults for the supplied identity.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   formName (Input; String): Physical Access form name identifying the form to create, open, configure, validate, or inspect.
' Returns: Boolean: True when lookup editor generated form has a canonical managed definition for the supplied identity; False when no such definition exists.
Public Function LookupEditorGeneratedFormIsDefined(ByVal formName As String) As Boolean
    LookupEditorGeneratedFormIsDefined = IsArray(LookupEditorGeneratedFormDefinition(formName))
End Function

' Purpose: Performs lookup editor allow additions by coordinating `LookupEditorGeneratedFormDefinition` and `IsArray` while preserving this module's existing validation and error semantics.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   formName (Input; String): Physical Access form name identifying the form to create, open, configure, validate, or inspect.
' Returns: Boolean: True when effective lookup-editor policy permits adding records on the generated form; False when additions must be disabled.
Public Function LookupEditorAllowAdditions(ByVal formName As String) As Boolean
    Dim definitionData As Variant
    definitionData = LookupEditorGeneratedFormDefinition(formName)
    If IsArray(definitionData) Then LookupEditorAllowAdditions = CBool(definitionData(LOOKUP_EDITOR_DEF_ALLOW_ADDITIONS))
End Function

