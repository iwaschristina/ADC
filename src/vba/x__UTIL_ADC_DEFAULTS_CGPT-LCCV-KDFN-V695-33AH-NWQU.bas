Public Function CandidateProcedureDeclarationInfo(ByVal declarationText As String, ByVal procName As String, ByRef procedureKind As String, ByRef visibilityText As String, ByRef argumentSignature As String, ByRef RequiredArgumentCount As Long, ByRef OptionalArgumentCount As Long, ByRef ExpectedReturnType As String) As Boolean
    Dim lineText As String
    Dim parseText As String
    Dim parsedName As String
    lineText = CodeLineWithoutTrailingComment(declarationText)
    parseText = Shared_String_CompactSpaces(lineText)
    If Len(parseText) = 0 Then Exit Function
    If (StrComp(Left$(parseText, Len("Private ")), "Private ", vbTextCompare) = 0) Then Exit Function
    If (StrComp(Left$(parseText, Len("Friend ")), "Friend ", vbTextCompare) = 0) Then Exit Function
    visibilityText = "ImplicitPublic"
    If (StrComp(Left$(parseText, Len("Public ")), "Public ", vbTextCompare) = 0) Then
        visibilityText = "Public"
        parseText = Trim$(Mid$(parseText, Len("Public ") + 1))
    End If
    If (StrComp(Left$(parseText, Len("Static ")), "Static ", vbTextCompare) = 0) Then
        parseText = Trim$(Mid$(parseText, Len("Static ") + 1))
    End If
    If (StrComp(Left$(parseText, Len("Function ")), "Function ", vbTextCompare) = 0) Then
        procedureKind = TARGET_PROCEDURE_KIND_FUNCTION
        parsedName = ProcedureNameFromDeclarationRemainder(Mid$(parseText, Len("Function ") + 1))
    ElseIf (StrComp(Left$(parseText, Len("Sub ")), "Sub ", vbTextCompare) = 0) Then
        procedureKind = TARGET_PROCEDURE_KIND_SUB
        parsedName = ProcedureNameFromDeclarationRemainder(Mid$(parseText, Len("Sub ") + 1))
    Else
        Exit Function
    End If
    If Len(Trim$(procName)) > 0 Then
        If StrComp(parsedName, procName, vbTextCompare) <> 0 Then Exit Function
    End If
    argumentSignature = TextInsideFirstParentheses(lineText)
    CountProcedureArguments argumentSignature, RequiredArgumentCount, OptionalArgumentCount
    If StrComp(procedureKind, TARGET_PROCEDURE_KIND_FUNCTION, vbTextCompare) = 0 Then
        ExpectedReturnType = FunctionReturnTypeFromDeclaration(parseText)
    Else
        ExpectedReturnType = vbNullString
    End If
    CandidateProcedureDeclarationInfo = True
End Function

' Purpose: Checks whether current state and policy permit the caller to didate macro key.
' Public role: Form-code/event-expression public entry point. Access form code or an event property can invoke this routine by name; its Public visibility is part of that UI contract.
' Parameters:
'   CandidateOwnerDatabaseRole (Input; String): Identifies the database role in which the candidate procedure or object is being evaluated.
'   ModuleName (Input; String): VBA module/component name identifying where the target procedure/version metadata is expected.
'   procName (Input; String): VBA procedure name identifying the target callable/source block being searched or documented.
' Returns: String: Returns the canonical key resolved for candidate macro key; vbNullString indicates that the supplied definition/index has no applicable managed key.
Public Function CandidateMacroKey(ByVal CandidateOwnerDatabaseRole As String, ByVal ModuleName As String, ByVal procName As String) As String
    'The hash suffix is based on source/module/procedure, not on line number.
    Dim keyText As String
    Dim hashSuffix As String
    Dim maxBaseLength As Long
    keyText = "Candidate_" & SharedName_SafeAccessObjectName(CandidateOwnerDatabaseRole, 0, "DB_", vbNullString) & "_" & SharedName_SafeAccessObjectName(ModuleName, 0, "DB_", vbNullString) & "_" & SharedName_SafeAccessObjectName(procName, 0, "DB_", vbNullString)
    If Len(keyText) <= 100 Then
        CandidateMacroKey = keyText
    Else
        hashSuffix = "_H" & StableTextHashHex(CandidateOwnerDatabaseRole & MODULE_TAG_DELIMITER & ModuleName & MODULE_TAG_DELIMITER & procName)
        maxBaseLength = 100 - Len(hashSuffix)
        If maxBaseLength < 1 Then maxBaseLength = 1
        CandidateMacroKey = Left$(keyText, maxBaseLength) & hashSuffix
    End If
End Function

Public Function CandidateSortOrder(ByVal procedureKind As String, ByVal RequiredArgumentCount As Long, ByVal OptionalArgumentCount As Long) As Long
    If RequiredArgumentCount = 0 Then
        CandidateSortOrder = 1000
    Else
        CandidateSortOrder = 2000
    End If
    If StrComp(procedureKind, TARGET_PROCEDURE_KIND_SUB, vbTextCompare) = 0 Then
        CandidateSortOrder = CandidateSortOrder + 100
    End If
    CandidateSortOrder = CandidateSortOrder + (OptionalArgumentCount * 10)
End Function

Private Sub AddIdentifierTokensToDictionary(ByVal valueText As String, ByVal identifierNames As Object)
    Dim i As Long
    Dim ch As String
    Dim tokenText As String
    If identifierNames Is Nothing Then Exit Sub
    For i = 1 To Len(valueText) + 1
        If (i And 255) = 0 Then PumpSetupResponsiveness
        If i <= Len(valueText) Then
            ch = Mid$(valueText, i, 1)
        Else
            ch = vbNullString
        End If
        If Len(tokenText) = 0 Then
            If IsIdentifierStartCharacter(ch) Then tokenText = ch
        ElseIf SharedVba_IsIdentifierChar(ch) Then
            tokenText = tokenText & ch
        Else
            tokenText = LCase$(tokenText)
            If identifierNames.Exists(tokenText) = False Then identifierNames.Add tokenText, True
            tokenText = vbNullString
        End If
    Next i
End Sub

Public Function EntryPointMatchConfidenceForProcedure(ByVal procName As String, ByVal headerEntryPointsRaw As String, ByVal headerFound As Boolean, ByVal headerMalformed As Boolean, ByVal exactEntryPointNames As Object, ByVal allEntryPointIdentifiers As Object) As String
    Dim procKey As String
    If headerFound = False Then
        EntryPointMatchConfidenceForProcedure = "NoHeader"
    ElseIf headerMalformed Then
        EntryPointMatchConfidenceForProcedure = "MalformedHeader"
    ElseIf Len(Trim$(headerEntryPointsRaw)) = 0 Then
        EntryPointMatchConfidenceForProcedure = "NoEntryPoints"
    Else
        procKey = LCase$(Trim$(procName))
        If Not exactEntryPointNames Is Nothing Then
            If exactEntryPointNames.Exists(procKey) Then
                EntryPointMatchConfidenceForProcedure = "Exact"
                Exit Function
            End If
        End If
        If Not allEntryPointIdentifiers Is Nothing Then
            If allEntryPointIdentifiers.Exists(procKey) Then
                EntryPointMatchConfidenceForProcedure = "NameOnly"
                Exit Function
            End If
        End If
        EntryPointMatchConfidenceForProcedure = "NoMatch"
    End If
End Function

