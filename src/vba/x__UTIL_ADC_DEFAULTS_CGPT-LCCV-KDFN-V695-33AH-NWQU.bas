' Purpose: Resolves and returns ribbon system macro displayed title default from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   baseRibbonTitle (Input; String): Title text used as the base ribbon title shown, stored, compared, or resolved by this operation.
'   objectName (Input; String): Physical Access object name identifying the database object targeted by the operation.
'   suppliedSystemMacroDefinitions (Input Optional; Variant): Caller-supplied supplied system macro definitions data used as the authoritative definition input for this call, avoiding an unnecessary reload when
'   already available.
' Returns: String: Returns the canonical display text for ribbon system macro displayed title default after applying the title/caption/label rules owned by this module; vbNullString represents no applicable
'   display text where supported.
Public Function RibbonSystemMacroDisplayedTitleDefault(ByVal baseRibbonTitle As String, ByVal objectName As String, Optional ByVal suppliedSystemMacroDefinitions As Variant) As String
    'The configured System Macro designator is the only permitted post-default modification of an explicitly stored Ribbon title.
    Dim systemMacroKey As String
    Dim systemMacroDesignator As String
    Dim definitionData As Variant
    RibbonSystemMacroDisplayedTitleDefault = baseRibbonTitle
    If Len(baseRibbonTitle) = 0 Then Exit Function
    If isMissing(suppliedSystemMacroDefinitions) Then
        systemMacroKey = RibbonSystemMacroKeyForObjectDesignatorDefault(objectName, definitionData)
    Else
        systemMacroKey = RibbonSystemMacroKeyForObjectDesignatorDefault(objectName, definitionData, suppliedSystemMacroDefinitions)
    End If
    If Len(systemMacroKey) = 0 Then Exit Function
    If Len(SystemMacroSetupPartIdentity(systemMacroKey, definitionData)) > 0 Then Exit Function
    If IncludeSystemMacroDesignatorInRibbonTitle() = False Then Exit Function
    systemMacroDesignator = CStr(definitionData(1))
    If Len(systemMacroDesignator) = 0 Then Err.Raise vbObjectError + 7822, "RibbonSystemMacroDisplayedTitleDefault", "The canonical System Macro definition has a blank SystemMacroDesignator." & vbCrLf & "SystemMacroKey: " & systemMacroKey
    RibbonSystemMacroDisplayedTitleDefault = systemMacroDesignator & " " & baseRibbonTitle
End Function

Private Function RibbonSystemMacroKeyForObjectDesignatorDefault(ByVal objectName As String, Optional ByRef matchedDefinition As Variant, Optional ByVal suppliedSystemMacroDefinitions As Variant) As String
    'Identifies a built-in System Macro by its visible designator (text designator or Setup Part identity); descriptive title text is never part of identity. SystemMacroKey remains the stable programmatic identity.
    Dim definitions As Collection
    Dim Definition As Variant
    Dim systemMacroKey As String
    Dim setupPartIdentity As String
    Dim logicalObjectName As String
    Dim designatorText As String
    Dim separatorPosition As Long
    If Len(objectName) = 0 Then Exit Function
    logicalObjectName = LogicalObjectNameFromPhysicalName(NAMING_CATEGORY_SYSTEM_MACRO, objectName)
    If Len(logicalObjectName) = 0 Then Exit Function
    separatorPosition = InStr(1, logicalObjectName, "|", vbBinaryCompare)
    If separatorPosition > 1 Then
        designatorText = Left$(logicalObjectName, separatorPosition - 1)
    Else
        separatorPosition = InStr(1, logicalObjectName, " ", vbBinaryCompare)
        If separatorPosition > 1 Then designatorText = Left$(logicalObjectName, separatorPosition - 1) Else designatorText = logicalObjectName
    End If
    If Len(designatorText) = 0 Then Exit Function
    If isMissing(suppliedSystemMacroDefinitions) = False Then
        If IsObject(suppliedSystemMacroDefinitions) Then Set definitions = suppliedSystemMacroDefinitions
    End If
    If definitions Is Nothing Then Set definitions = GetSystemMacroDefinitions()
    For Each Definition In definitions
        PumpSetupResponsiveness
        systemMacroKey = Trim$(CStr(Definition(0)))
        setupPartIdentity = SystemMacroSetupPartIdentity(systemMacroKey, Definition)
        If Len(setupPartIdentity) > 0 Then
            If StrComp(setupPartIdentity, designatorText, vbTextCompare) = 0 Then
                If isMissing(matchedDefinition) = False Then matchedDefinition = Definition
                RibbonSystemMacroKeyForObjectDesignatorDefault = systemMacroKey
                Exit Function
            End If
        ElseIf StrComp(CStr(Definition(1)), designatorText, vbTextCompare) = 0 Then
            If isMissing(matchedDefinition) = False Then matchedDefinition = Definition
            RibbonSystemMacroKeyForObjectDesignatorDefault = systemMacroKey
            Exit Function
        End If
    Next Definition
End Function

