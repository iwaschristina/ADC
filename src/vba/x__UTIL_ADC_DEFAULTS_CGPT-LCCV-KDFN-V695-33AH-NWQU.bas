Public Function SystemRibbonTitleForKey(ByVal systemMacroKey As String, Optional ByVal suppliedSystemMacroDefinition As Variant) As String
    Dim Definition As Variant
    Dim normalizedKey As String
    normalizedKey = Trim$(systemMacroKey)
    If Len(normalizedKey) = 0 Then Exit Function
    If isMissing(suppliedSystemMacroDefinition) Then
        Definition = SystemMacroDefinitionByKey(normalizedKey)
    Else
