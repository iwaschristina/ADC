Private Sub AddReferenceResolvedFamilyName(ByRef familyNames As Collection, ByRef repairOrders As Collection, ByVal familyCode As String, ByVal objectName As String, ByVal repairOrder As Long)
    Dim insertIndex As Long
    If repairOrder <= 0 Then Err.Raise vbObjectError + 7794, "AddReferenceResolvedFamilyName", "A Reference managed object is missing its canonical repair order." & vbCrLf & "Family: " & familyCode & vbCrLf & "Object: " & objectName
    For insertIndex = 1 To repairOrders.count
        If repairOrder < CLng(repairOrders(insertIndex)) Then
            familyNames.Add objectName, Before:=insertIndex
            repairOrders.Add repairOrder, Before:=insertIndex
            Exit Sub
        End If
        If repairOrder = CLng(repairOrders(insertIndex)) Then Err.Raise vbObjectError + 7795, "AddReferenceResolvedFamilyName", "A Reference family contains a duplicate canonical repair order." & vbCrLf & "Family: " & familyCode & vbCrLf & "RepairOrder: " & CStr(repairOrder)
    Next insertIndex
    familyNames.Add objectName
    repairOrders.Add repairOrder
End Sub

' Purpose: Resolves the ordered Reference Inventory, Loaded VBA Analysis, crosswalk, and query families from one canonical managed-object definition snapshot, reusing cached snapshot projections when available.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   inventoryNames (Output; Collection): Receives the collection of inventory names assembled by this procedure; callers own the returned collection reference.
'   loadedVbaAnalysisNames (Output; Collection): Receives the collection of loaded VBA analysis names assembled by this procedure; callers own the returned collection reference.
'   crosswalkNames (Output; Collection): Receives the collection of crosswalk names assembled by this procedure; callers own the returned collection reference.
'   queryNames (Output; Collection): Receives the collection of query names assembled by this procedure; callers own the returned collection reference.
' Returns: None (Sub). Results are returned through the documented ByRef parameters and/or the routine's database, UI, or module-state side effects.
Public Sub ResolveReferenceFamilies(ByRef inventoryNames As Collection, ByRef loadedVbaAnalysisNames As Collection, ByRef crosswalkNames As Collection, ByRef queryNames As Collection)
    ' INTENTIONAL OPERATION SNAPSHOT: Resolve all related Reference families from one canonical definition state so one operation cannot mix family generations.
    Dim definitions As Collection
    Dim resolvedInventoryNames As Collection
    Dim resolvedLoadedVbaAnalysisNames As Collection
    Dim resolvedCrosswalkNames As Collection
    Dim resolvedQueryNames As Collection
    If mManagedObjectDefinitionSnapshotDepth > 0 Then EnsureManagedObjectDefinitionSnapshot
    If Not mReferenceInventorySnapshotNames Is Nothing And Not mReferenceLoadedVBAAnalysisSnapshotNames Is Nothing And Not mReferenceCrosswalkSnapshotNames Is Nothing And Not mReferenceQuerySnapshotNames Is Nothing Then
        Set inventoryNames = CloneTextCollection(mReferenceInventorySnapshotNames)
        Set loadedVbaAnalysisNames = CloneTextCollection(mReferenceLoadedVBAAnalysisSnapshotNames)
        Set crosswalkNames = CloneTextCollection(mReferenceCrosswalkSnapshotNames)
        Set queryNames = CloneTextCollection(mReferenceQuerySnapshotNames)
        Exit Sub
    End If
    Set definitions = ManagedObjectDefinitionRowsForRead()
    ResolveReferenceFamiliesFromDefinitions definitions, resolvedInventoryNames, resolvedLoadedVbaAnalysisNames, resolvedCrosswalkNames, resolvedQueryNames
    If mManagedObjectDefinitionSnapshotDepth > 0 Then
        Set mReferenceInventorySnapshotNames = resolvedInventoryNames
        Set mReferenceLoadedVBAAnalysisSnapshotNames = resolvedLoadedVbaAnalysisNames
        Set mReferenceCrosswalkSnapshotNames = resolvedCrosswalkNames
        Set mReferenceQuerySnapshotNames = resolvedQueryNames
        Set inventoryNames = CloneTextCollection(mReferenceInventorySnapshotNames)
        Set loadedVbaAnalysisNames = CloneTextCollection(mReferenceLoadedVBAAnalysisSnapshotNames)
        Set crosswalkNames = CloneTextCollection(mReferenceCrosswalkSnapshotNames)
        Set queryNames = CloneTextCollection(mReferenceQuerySnapshotNames)
    Else
        Set inventoryNames = resolvedInventoryNames
        Set loadedVbaAnalysisNames = resolvedLoadedVbaAnalysisNames
        Set crosswalkNames = resolvedCrosswalkNames
        Set queryNames = resolvedQueryNames
    End If
End Sub

Private Sub ResolveReferenceFamiliesFromDefinitions(ByVal definitions As Collection, ByRef inventoryNames As Collection, ByRef loadedVbaAnalysisNames As Collection, ByRef crosswalkNames As Collection, ByRef queryNames As Collection)
    ' INTENTIONAL ORDERED VIEW: inventoryOrders, loadedVbaAnalysisOrders, crosswalkOrders, queryOrders preserves the deterministic sequence required by ResolveReferenceFamiliesFromDefinitions; keyed-only or
    ' unordered storage would not preserve the consumer semantics.
    ' INTENTIONAL FILTERED PARTITION: inventoryNames, loadedVbaAnalysisNames, crosswalkNames, queryNames is a consumer-required subset/projection derived from the source enumerated by
    ' ResolveReferenceFamiliesFromDefinitions; its membership is not independently authoritative.
    Dim inventoryOrders As New Collection
    Dim loadedVbaAnalysisOrders As New Collection
    Dim crosswalkOrders As New Collection
    Dim queryOrders As New Collection
    Dim rowData As Variant
    Dim familyCode As String
    Dim objectName As String
    Dim repairOrder As Long
    Set inventoryNames = New Collection
    Set loadedVbaAnalysisNames = New Collection
    Set crosswalkNames = New Collection
    Set queryNames = New Collection
    For Each rowData In definitions
        familyCode = Trim$(CStr(rowData(MANAGED_DEF_REFERENCE_FAMILY)))
        If Len(familyCode) > 0 Then
            objectName = CStr(rowData(MANAGED_DEF_OBJECT_NAME))
            repairOrder = CLng(rowData(MANAGED_DEF_REFERENCE_REPAIR_ORDER))
            Select Case familyCode
                Case MANAGED_REFERENCE_FAMILY_INVENTORY: AddReferenceResolvedFamilyName inventoryNames, inventoryOrders, familyCode, objectName, repairOrder
                Case MANAGED_REFERENCE_FAMILY_LOADED_VBA_ANALYSIS: AddReferenceResolvedFamilyName loadedVbaAnalysisNames, loadedVbaAnalysisOrders, familyCode, objectName, repairOrder
                Case MANAGED_REFERENCE_FAMILY_CROSSWALK: AddReferenceResolvedFamilyName crosswalkNames, crosswalkOrders, familyCode, objectName, repairOrder
                Case MANAGED_REFERENCE_FAMILY_QUERY: AddReferenceResolvedFamilyName queryNames, queryOrders, familyCode, objectName, repairOrder
                Case Else: Err.Raise vbObjectError + 7810, "ResolveReferenceFamiliesFromDefinitions", "Unsupported canonical Reference family." & vbCrLf & "Family: " & familyCode & vbCrLf & "Object: " & objectName
            End Select
        End If
    Next rowData
End Sub

' Purpose: Resolves reference action payload definitions from the supplied/current ADC state, using `Const` and `isMissing` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   suppliedDefinitions (Input Optional; Variant): Variant input representing supplied definitions; the routine accepts the caller-provided value in the form required by its existing validation and
'   conversion logic.
' Returns: Collection: Returns the ordered Collection assembled by the routine; callers receive the object reference and should treat its membership/order according to the routine contract.
Public Function ReferenceActionPayloadDefinitions(Optional ByVal suppliedDefinitions As Variant) As Collection
    ' Payload membership, description context, and sort order are derived from the canonical managed-object registry; payload-specific behavior is added here.
    Const REFERENCE_PAYLOAD_DEF_FAMILY As Long = 5
    Const REFERENCE_PAYLOAD_DEF_REPAIR_ORDER As Long = 6
    ' INTENTIONAL SEPARATE CANONICAL PROJECTION: rows derives Reference action-payload rows from canonical managed-object/query definitions while adding payload-specific behavior; it is authoritative only for the
    ' payload view, not managed-object membership.
    ' INTENTIONAL FILTERED PARTITION: queryDefinitions is a consumer-required subset/projection derived from the source enumerated by ReferenceActionPayloadDefinitions; its membership is not independently
    ' authoritative.
    ' INTENTIONAL ORDERED VIEW: queryRepairOrders preserves the deterministic sequence required by ReferenceActionPayloadDefinitions; keyed-only or unordered storage would not preserve the consumer semantics.
    Dim rows As New Collection
    Dim definitions As Collection
    Dim queryDefinitions As New Collection
    Dim queryRepairOrders As New Collection
    Dim Definition As Variant
    Dim repairOrder As Long
    Dim insertIndex As Long
    Dim inserted As Boolean
    If isMissing(suppliedDefinitions) = False Then
        If IsObject(suppliedDefinitions) Then Set definitions = suppliedDefinitions
    End If
    If definitions Is Nothing Then Set definitions = ReferenceManagedObjectDefinitions(True)
    For Each Definition In definitions
        If StrComp(Trim$(CStr(Definition(REFERENCE_PAYLOAD_DEF_FAMILY))), MANAGED_REFERENCE_FAMILY_QUERY, vbTextCompare) = 0 Then
            If StrComp(CStr(Definition(MANAGED_DEF_OBJECT_TYPE)), ADCAT_OBJECT_TYPE_QUERY, vbTextCompare) <> 0 Then Err.Raise vbObjectError + 7811, "ReferenceActionPayloadDefinitions", "A canonical Reference Query family member is not a query." & vbCrLf & "Object: " & CStr(Definition(MANAGED_DEF_OBJECT_NAME)) & vbCrLf & "ObjectType: " & CStr(Definition(MANAGED_DEF_OBJECT_TYPE))
            repairOrder = CLng(Definition(REFERENCE_PAYLOAD_DEF_REPAIR_ORDER))
            If repairOrder <= 0 Then Err.Raise vbObjectError + 7812, "ReferenceActionPayloadDefinitions", "A Reference Query family member is missing its canonical repair order." & vbCrLf & "Object: " & CStr(Definition(MANAGED_DEF_OBJECT_NAME))
            inserted = False
            For insertIndex = 1 To queryRepairOrders.count
                If repairOrder < CLng(queryRepairOrders(insertIndex)) Then
                    queryDefinitions.Add Definition, Before:=insertIndex
                    queryRepairOrders.Add repairOrder, Before:=insertIndex
                    inserted = True
                    Exit For
                End If
                If repairOrder = CLng(queryRepairOrders(insertIndex)) Then Err.Raise vbObjectError + 7813, "ReferenceActionPayloadDefinitions", "The Reference Query family contains a duplicate canonical repair order." & vbCrLf & "RepairOrder: " & CStr(repairOrder)
            Next insertIndex
            If inserted = False Then
                queryDefinitions.Add Definition
                queryRepairOrders.Add repairOrder
            End If
        End If
    Next Definition
    For Each Definition In queryDefinitions
        rows.Add Array(CStr(Definition(MANAGED_DEF_OBJECT_NAME)), ADCAT_PAYLOAD_QUERY_SQL_BUILDER, "RepairReferenceInventoryFoundationForSetup", vbNullString, "Creates or repairs this canonical Reference query. " & CStr(Definition(MANAGED_DEF_DESCRIPTION)), ReferenceActionPayloadVersion(CStr(Definition(MANAGED_DEF_OBJECT_NAME))), CLng(Definition(MANAGED_DEF_SORT_ORDER)))
    Next Definition
    Set ReferenceActionPayloadDefinitions = rows
End Function

Private Function ReferenceActionPayloadVersion(ByVal queryName As String) As String
    ' Version 1.0 is the Reference query-payload default. Only canonical queries with a distinct current payload contract override it here.
    Select Case UCase$(queryName)
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_References_Active")), UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_References_Available")), UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_QUERY, "ADC_References_Manager"))
            ReferenceActionPayloadVersion = "3.0"
        Case Else
            ReferenceActionPayloadVersion = "1.0"
    End Select
End Function

Private Sub AddFormDesignResolvedFamilyName(ByRef familyNames As Collection, ByRef buildOrders As Collection, ByVal familyCode As String, ByVal objectName As String, ByVal buildOrder As Long)
    Dim insertIndex As Long
    If buildOrder <= 0 Then Err.Raise vbObjectError + 7796, "AddFormDesignResolvedFamilyName", "A FormDesign managed query is missing its canonical build order." & vbCrLf & "Family: " & familyCode & vbCrLf & "Object: " & objectName
    For insertIndex = 1 To buildOrders.count
        If buildOrder < CLng(buildOrders(insertIndex)) Then
            familyNames.Add objectName, Before:=insertIndex
            buildOrders.Add buildOrder, Before:=insertIndex
            Exit Sub
        End If
        If buildOrder = CLng(buildOrders(insertIndex)) Then Err.Raise vbObjectError + 7797, "AddFormDesignResolvedFamilyName", "A FormDesign build family contains a duplicate canonical build order." & vbCrLf & "Family: " & familyCode & vbCrLf & "BuildOrder: " & CStr(buildOrder)
    Next insertIndex
    familyNames.Add objectName
    buildOrders.Add buildOrder
End Sub

' Purpose: Resolves form design build families.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   sourceNames (Output; Collection): Receives the collection of source names assembled by this procedure; callers own the returned collection reference.
' Returns: None (Sub). Results are returned through the documented ByRef parameters and/or the routine's database, UI, or module-state side effects.
Public Sub ResolveFormDesignBuildFamilies(ByRef sourceNames As Collection)
    Dim definitions As Collection
    ' INTENTIONAL ORDERED VIEW: sourceOrders preserves the deterministic sequence required by ResolveFormDesignBuildFamilies; keyed-only or unordered storage would not preserve the consumer semantics.
    ' INTENTIONAL FILTERED PARTITION: sourceNames is a consumer-required subset/projection derived from the source enumerated by ResolveFormDesignBuildFamilies; its membership is not independently authoritative.
    Dim sourceOrders As New Collection
