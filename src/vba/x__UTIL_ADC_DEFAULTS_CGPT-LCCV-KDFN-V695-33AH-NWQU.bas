Private Function GeneratedFormDefinitions() As Collection
    ' INTENTIONAL STATIC IMPLEMENTATION PROJECTION CACHE: cachedRows maps canonical generated-form membership to builder-specific implementation metadata. It is valid for the loaded-code lifetime, has no
    ' invalidation path because the code definitions are immutable, and private callers treat the shared Collection as read-only.
    Static cachedRows As Collection
    Dim rows As Collection
    Dim canonicalDefinition As Variant
    Dim canonicalGeneratedFormCount As Long
    If cachedRows Is Nothing Then
        ' INTENTIONAL FILTERED/TRANSFORMED PROJECTION: rows maps canonical generated-form managed-object rows to builder-specific implementation metadata before assigning the completed projection to cachedRows.
        Set rows = New Collection
        For Each canonicalDefinition In ManagedObjectDefinitionRowsForRead()
            If StrComp(CStr(canonicalDefinition(MANAGED_DEF_GROUP)), MANAGED_GROUP_GENERATED_FORM, vbTextCompare) = 0 Then
                canonicalGeneratedFormCount = canonicalGeneratedFormCount + 1
                AddGeneratedFormImplementationDefinitionForCanonical rows, canonicalDefinition
            End If
        Next canonicalDefinition
        If rows.count <> canonicalGeneratedFormCount Then Err.Raise vbObjectError + 7386, "GeneratedFormDefinitions", "Generated-form implementation coverage does not match the canonical managed-form registry." & vbCrLf & "Canonical forms: " & CStr(canonicalGeneratedFormCount) & vbCrLf & "Implementation definitions: " & CStr(rows.count)
        Set cachedRows = rows
    End If
    Set GeneratedFormDefinitions = cachedRows
End Function

Private Sub AddGeneratedFormImplementationDefinitionForCanonical(ByRef rows As Collection, ByVal canonicalDefinition As Variant)
    Dim formName As String
    Dim lookupEditorDefinition As Variant
    Dim lookupListFields As Variant
    Dim lookupOrderFields As Variant
    formName = CStr(canonicalDefinition(0))
    If StrComp(CStr(canonicalDefinition(1)), ADCAT_CATEGORY_MANAGED_FORM, vbTextCompare) <> 0 Then Err.Raise vbObjectError + 7387, "AddGeneratedFormImplementationDefinitionForCanonical", "A canonical generated-form definition has the wrong managed-object category." & vbCrLf & "Form: " & formName & vbCrLf & "Category: " & CStr(canonicalDefinition(1))
    If StrComp(CStr(canonicalDefinition(2)), ADCAT_OBJECT_TYPE_FORM, vbTextCompare) <> 0 Then Err.Raise vbObjectError + 7388, "AddGeneratedFormImplementationDefinitionForCanonical", "A canonical generated-form definition has the wrong managed-object type." & vbCrLf & "Form: " & formName & vbCrLf & "ObjectType: " & CStr(canonicalDefinition(2))
    lookupEditorDefinition = LookupEditorGeneratedFormDefinition(formName)
    If IsArray(lookupEditorDefinition) Then
        lookupListFields = Split(CStr(lookupEditorDefinition(LOOKUP_EDITOR_DEF_LIST_FIELDS)), "|")
        lookupOrderFields = Split(CStr(lookupEditorDefinition(LOOKUP_EDITOR_DEF_ORDER_FIELDS)), "|")
        AddGeneratedFormImplementationDefinition rows, canonicalDefinition, _
            CStr(lookupEditorDefinition(LOOKUP_EDITOR_DEF_DISPLAY_NAME)), _
            DEFAULT_FORM_TYPE_CONTINUOUS, _
            GeneratedFormCanonicalRibbonGroupLabel(canonicalDefinition), _
            sourceCandidates:=Array(ManagedObjectPhysicalName(NAMING_CATEGORY_TABLE, CStr(lookupEditorDefinition(LOOKUP_EDITOR_DEF_SOURCE_LOGICAL_ID)))), _
            sourceUsesFirstExisting:=True, _
            listFields:=lookupListFields, _
            orderFields:=lookupOrderFields, _
            allowEdits:=True
        Exit Sub
    End If
    Select Case UCase$(formName)
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_GENERATED_FORM, CANON_GENERATED_FORM_LOGICAL_ID_MANAGER))
            AddGeneratedFormImplementationDefinition rows, canonicalDefinition, _
                CANON_GENERATED_FORM_TITLE_MANAGER, _
                DEFAULT_FORM_TYPE_SINGLE, _
                GeneratedFormCanonicalRibbonGroupLabel(canonicalDefinition), _
                openAfterSetup:=True
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_GENERATED_FORM, CANON_GENERATED_FORM_LOGICAL_ID_HELP))
            AddGeneratedFormImplementationDefinition rows, canonicalDefinition, _
                CANON_GENERATED_FORM_TITLE_HELP, _
                DEFAULT_FORM_TYPE_SINGLE, _
                GeneratedFormCanonicalRibbonGroupLabel(canonicalDefinition)
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_GENERATED_FORM, CANON_GENERATED_FORM_LOGICAL_ID_REPORT_ERROR_DIALOG))
            AddGeneratedFormImplementationDefinition rows, canonicalDefinition, _
                CANON_GENERATED_FORM_TITLE_REPORT_ERROR_DIALOG, _
                DEFAULT_FORM_TYPE_SINGLE, _
                GeneratedFormCanonicalRibbonGroupLabel(canonicalDefinition)
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_GENERATED_FORM, CANON_GENERATED_FORM_LOGICAL_ID_DELETE_OBJECTS))
            AddGeneratedFormImplementationDefinition rows, canonicalDefinition, _
                CANON_GENERATED_FORM_TITLE_DELETE_OBJECTS, _
                DEFAULT_FORM_TYPE_SINGLE, _
                GeneratedFormCanonicalRibbonGroupLabel(canonicalDefinition)
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_GENERATED_FORM, CANON_GENERATED_FORM_LOGICAL_ID_SETUP_CONTROL_RUNNING))
            AddGeneratedFormImplementationDefinition rows, canonicalDefinition, CANON_GENERATED_FORM_TITLE_SETUP_CONTROL_RUNNING, DEFAULT_FORM_TYPE_SINGLE, GeneratedFormCanonicalRibbonGroupLabel(canonicalDefinition)
        Case UCase$(ManagedObjectPhysicalName(NAMING_CATEGORY_GENERATED_FORM, CANON_GENERATED_FORM_LOGICAL_ID_SETUP_CONTROL_PAUSED))
