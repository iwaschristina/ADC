' Purpose: Resolves non form reference documentation workflow for category from the supplied/current ADC state, using `End` where required by the lookup path.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   categoryCode (Input; String): Canonical code used to classify or select the category code behavior.
' Returns: String: Returns the non form reference documentation workflow for category text value. `vbNullString` remains available where the existing routine uses an empty result to mean unavailable, not
'   applicable, or not resolved.
Public Function NonFormReferenceDocumentationWorkflowForCategory(ByVal categoryCode As String) As String
    Select Case UCase$(Trim$(categoryCode))
        Case "RUNTIMETABLE", "CONFIGTABLE": NonFormReferenceDocumentationWorkflowForCategory = "Configuration and runtime data"
        Case "CATALOGTABLE": NonFormReferenceDocumentationWorkflowForCategory = "Setup and catalog maintenance"
        Case "REVIEWQUERY", "REVIEWTABLE": NonFormReferenceDocumentationWorkflowForCategory = "Review and diagnostics"
        Case "FORM", "GENERATEDFORM": NonFormReferenceDocumentationWorkflowForCategory = "Generated forms"
        Case Else: NonFormReferenceDocumentationWorkflowForCategory = DEFAULT_UTILITY_LONG_NAME & " utility"
    End Select
End Function

' Purpose: Resolves and returns system macro fallback description from the supplied inputs and the authoritative ADC definitions/state used by this module.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   systemMacroKey (Input; String): Canonical system-macro key that identifies the system macro definition or Ribbon command being resolved.
'   MacroTitle (Input; String): Title text used as the macro title shown, stored, compared, or resolved by this operation.
'   runCodeExpression (Input; String): Expression text representing the run code calculation, RunCode target, SQL fragment, or UI binding interpreted by this routine.
' Returns: String: Returns the canonical description text for system macro fallback description, suitable for the managed catalog/field/object metadata destination; vbNullString indicates that no description
'   applies where allowed.
Public Function SystemMacroFallbackDescription(ByVal systemMacroKey As String, ByVal MacroTitle As String, ByVal runCodeExpression As String) As String
    Dim TitleText As String
    TitleText = Trim$(MacroTitle)
    If Len(TitleText) = 0 Then TitleText = Trim$(systemMacroKey)
    If Len(TitleText) = 0 Then TitleText = "unnamed system macro"
    SystemMacroFallbackDescription = "CodeDb-owned " & DEFAULT_UTILITY_LONG_NAME & " system shortcut for " & TitleText & ". RunCode target: " & Trim$(runCodeExpression) & ". SystemMacroKey: " & Trim$(systemMacroKey) & ". This description is used for the generated Access macro object and Navigation Pane details view; replace MacroDescription with a more specific workflow note when this catalog row becomes permanent."
End Function

