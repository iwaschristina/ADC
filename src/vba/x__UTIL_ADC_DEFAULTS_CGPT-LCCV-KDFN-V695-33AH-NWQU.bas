' Purpose: Performs editable lookup table name by coordinating `EditableLookupTableNames` and `StrComp` while preserving this module's existing validation and error semantics.
' Public role: Inter-module public API. Other ADC modules call this routine directly; its Public visibility is part of the module-to-module contract.
' Parameters:
'   tableName (Input; String): Physical Access table name identifying the table whose schema, data, or metadata the routine processes.
' Returns: Boolean: True when the condition represented by FoundationTableFieldDescription is present under the routine's documented inputs/current state; False when that condition is absent.
Public Function EditableLookupTableName(ByVal tableName As String) As Boolean
    Dim item As Variant
    For Each item In EditableLookupTableNames()
        If StrComp(CStr(item), tableName, vbTextCompare) = 0 Then
            EditableLookupTableName = True
            Exit Function
        End If
    Next item
End Function

