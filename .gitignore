# Transient OS/application state; do not blanket-ignore database backups,
# diagnostics, import/export manifests, or required resources.
tmp/
temp/
.cache/

# IMPORTANT: Do not ignore source exports, .accdb/.mdb, .bas/.cls/.frm,
# .frx, schema/SQL, resources, manifests, or historical ZIP files.
# archive/legacy-baselines/ must remain eligible for Git tracking.
